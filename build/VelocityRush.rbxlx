		local arrow = Components.Label({
			Name = "Arrow",
			Text = Theme.Icons.Right,
			Font = Theme.Fonts.Title,
			TextSize = 15,
			TextColor3 = Theme.Colors.Accent2:Lerp(Theme.Colors.White, 0.35),
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			RichText = false,
			Size = UDim2.fromScale(1, 1),
			Parent = bubble,
		})
		local tag = new("Frame", {
			Name = "Tag",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 36),
			Size = UDim2.fromOffset(126, 18),
			BackgroundColor3 = Theme.Colors.Shadow,
			BackgroundTransparency = 0.35,
			BorderSizePixel = 0,
			Parent = indicator,
		})
		Components.Corner(9).Parent = tag
		local label = Components.Label({
			Name = "Name",
			Text = "",
			TextSize = 11,
			Font = Theme.Fonts.Bold,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			RichText = false,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.fromOffset(4, 0),
			Size = UDim2.new(1, -8, 1, 0),
			Parent = tag,
		})
		self.Indicators[i] = { Frame = indicator, Arrow = arrow, Label = label }
	end
end

------------------------------------------------------------------------
-- Ereignisse
------------------------------------------------------------------------

function RaceHud:Start()
	local state = self.Ctx.ClientState
	state:On("RacerEliminated", function(payload)
		if payload.UserId == player.UserId then
			if payload.Reason ~= "Left" then
				self.EliminatedInfo.Text = string.format("Platz %d · %s", payload.Placement or 0, REASON_TEXT[payload.Reason] or "")
				self.EliminatedPanel.Visible = true
				Components.Pop(self.EliminatedPanel, 0.75, 0.45)
			end
		else
			self:_feed(
				string.format("<b>%s</b> ist raus (Platz %d) – %s", payload.Name or "?", payload.Placement or 0, REASON_TEXT[payload.Reason] or "ausgeschieden"),
				Theme.Colors.Danger,
				"💀"
			)
		end
	end)
	state:On("RacerFinished", function(payload)
		self:_feed(string.format("<b>%s</b> hat das Ziel erreicht! (%s)", payload.Name or "?", Util.FormatTime(payload.Time or 0)), Theme.Colors.Gold, Theme.Icons.Flag)
	end)
	state:On("PowerUpUsed", function(payload)
		local item = ItemDefinitions.Get(payload.ItemId)
		local who = Players:GetPlayerByUserId(payload.UserId)
		if item and who and who ~= player and item.Offensive then
			self:_feed(string.format("<b>%s</b> setzt %s ein", who.DisplayName, item.Name), item.Color, ITEM_GLYPHS[item.Id])
		end
	end)
	state:On("StatusApplied", function(payload)
		if payload.UserId == player.UserId then
			local slowed = payload.Kind == "Slowed"
			self:_feed(if slowed then "Du wurdest eingefroren!" else "Du bist in eine Falle getappt!", Theme.Colors.Warning, if slowed then "❄️" else "💣")
		end
	end)
	state:On("ShieldBlocked", function(payload)
		if payload.UserId == player.UserId then
			self:_feed("Dein Schild hat einen Angriff geblockt!", Theme.Colors.Accent, "🛡️")
		end
	end)
	state:On("ItemPickup", function()
		self.SlotScale.Scale = 1.25
		Components.Tween(self.SlotScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
	state:On("MatchStarted", function()
		self.EliminatedPanel.Visible = false
		self.FinalTime = nil
		self:_clearFeed()
		self:_buildTicks()
	end)
	state:On("MatchResults", function(payload)
		self.EliminatedPanel.Visible = false
		self.FinalTime = payload.Duration
	end)

	RunService.RenderStepped:Connect(function(dt)
		local ok, err = pcall(self._update, self, dt)
		if not ok then
			warn("[RaceHud] " .. tostring(err))
		end
	end)
end

--- Neuer Eintrag im Ereignis-Feed (gleitet ein, blendet nach 6 s aus).
function RaceHud:_feed(text: string, color: Color3, icon: string?)
	self.FeedCount += 1
	local entry = new("Frame", {
		Name = "FeedEntry",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 30),
		LayoutOrder = self.FeedCount,
		Parent = self.Feed,
	})
	local bubble = new("Frame", {
		Name = "Bubble",
		AutomaticSize = Enum.AutomaticSize.X,
		Position = UDim2.fromOffset(-24, 0),
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Theme.Colors.PanelDark,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = entry,
	})
	Components.Corner(10).Parent = bubble
	local stroke = Components.Stroke(color, 1.5, 1)
	stroke.Parent = bubble
	Components.Padding(0, 12, 0, 6).Parent = bubble
	Components.List(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center).Parent = bubble
	local bar = new("Frame", {
		Name = "Bar",
		Size = UDim2.fromOffset(4, 18),
		BackgroundColor3 = color,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = 1,
		Parent = bubble,
	})
	Components.Corner(2).Parent = bar
	local glyph = Components.Label({
		Text = icon or Theme.Icons.Info,
		Font = Theme.Fonts.Title,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		RichText = false,
		TextTransparency = 1,
		Size = UDim2.fromOffset(20, 20),
		LayoutOrder = 2,
		Parent = bubble,
	})
	local label = Components.Label({
		Text = text,
		Font = Theme.Fonts.Medium,
		TextSize = 14,
		TextColor3 = color:Lerp(Theme.Colors.White, 0.55),
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 0, 20),
		LayoutOrder = 3,
		Parent = bubble,
	})
	new("UISizeConstraint", { MaxSize = Vector2.new(360, 20), Parent = label })

	-- Einblenden (von links hereingleiten)
	Components.Tween(bubble, 0.3, { Position = UDim2.new(), BackgroundTransparency = 0.15 }, Enum.EasingStyle.Back)
	Components.Tween(stroke, 0.3, { Transparency = 0.35 })
	Components.Tween(bar, 0.3, { BackgroundTransparency = 0 })
	Components.Tween(glyph, 0.3, { TextTransparency = 0 })
	Components.Tween(label, 0.3, { TextTransparency = 0 })

	local entries = {}
	for _, child in self.Feed:GetChildren() do
		if child.Name == "FeedEntry" then
			table.insert(entries, child)
		end
	end
	if #entries > 6 then
		table.sort(entries, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		entries[1]:Destroy()
	end
	task.delay(6, function()
		if entry.Parent then
			Components.Tween(bubble, 0.4, { BackgroundTransparency = 1, Position = UDim2.fromOffset(-16, 0) })
			Components.Tween(stroke, 0.4, { Transparency = 1 })
			Components.Tween(bar, 0.4, { BackgroundTransparency = 1 })
			Components.Tween(glyph, 0.4, { TextTransparency = 1 })
			Components.Tween(label, 0.4, { TextTransparency = 1 })
			task.wait(0.45)
			entry:Destroy()
		end
	end)
end

function RaceHud:_clearFeed()
	for _, child in self.Feed:GetChildren() do
		if child.Name == "FeedEntry" then
			child:Destroy()
		end
	end
end

-- Checkpoint-Rauten auf der Fortschrittsleiste
function RaceHud:_buildTicks()
	self.TickHolder:ClearAllChildren()
	self.Ticks = {}
	local gameState = self.Ctx.ClientState.GameState
	local startX = gameState:GetAttribute("StartX") or 0
	local finishX = gameState:GetAttribute("FinishX") or 0
	local list = gameState:GetAttribute("CheckpointXs") or ""
	if finishX <= startX then
		return
	end
	for value in string.gmatch(list, "[^,]+") do
		local x = tonumber(value)
		if x then
			local alpha = math.clamp((x - startX) / (finishX - startX), 0, 1)
			local tick = new("Frame", {
				Name = "Checkpoint",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(alpha, 0.5),
				Size = UDim2.fromOffset(10, 10),
				Rotation = 45,
				BackgroundColor3 = Theme.Colors.TextDim,
				BorderSizePixel = 0,
				Parent = self.TickHolder,
			})
			Components.Corner(2).Parent = tick
			Components.Stroke(Theme.Colors.Shadow, 1.5, 0.1).Parent = tick
			table.insert(self.Ticks, { Frame = tick, Alpha = alpha, Passed = nil })
		end
	end
end

------------------------------------------------------------------------
-- Zuschauen
------------------------------------------------------------------------

function RaceHud:_aliveRacers()
	local list = {}
	for _, folder in self.Ctx.ClientState.Racers:GetChildren() do
		if folder:GetAttribute("Status") == "Racing" then
			local other = Players:GetPlayerByUserId(folder:GetAttribute("UserId") or 0)
			if other and other ~= player then
				table.insert(list, { Player = other, Placement = folder:GetAttribute("Placement") or 99 })
			end
		end
	end
	table.sort(list, function(a, b)
		return a.Placement < b.Placement
	end)
	return list
end

function RaceHud:StartSpectating()
	local alive = self:_aliveRacers()
	if #alive > 0 then
		self.Ctx.CameraController:SetSpectate(alive[1].Player)
	else
		self.UI:Notify("Gerade gibt es niemanden zum Zuschauen.", "Info")
	end
end

function RaceHud:_cycleSpectate(direction: number)
	local alive = self:_aliveRacers()
	if #alive == 0 then
		return
	end
	local current = self.Ctx.CameraController:GetSpectate()
	local index = 0
	for i, entry in alive do
		if entry.Player == current then
			index = i
		end
	end
	index = ((index - 1 + direction) % #alive) + 1
	self.Ctx.CameraController:SetSpectate(alive[index].Player)
end

------------------------------------------------------------------------
-- Pro Frame
------------------------------------------------------------------------

-- Verlaufspaar einer Platzierung (Gold/Silber/Bronze, sonst neutral)
local function placeGradient(placement: number?, active: boolean)
	if active and placement and MEDALS[placement] then
		return MEDALS[placement]
	end
	return Theme.Gradients.Neutral
end

function RaceHud:_rowFor(folder)
	local row = self.Rows[folder]
	if row and row.Frame.Parent then
		return row
	end
	local isLocal = folder:GetAttribute("UserId") == player.UserId
	local frame = new("Frame", { Name = "Row", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28), Parent = self.StandingsList })
	if isLocal then
		-- Eigene Zeile: Akzent-Schimmer von links
		local highlight = new("Frame", {
			Name = "Highlight",
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Theme.Colors.Accent,
			BackgroundTransparency = 0.5,
			BorderSizePixel = 0,
			Parent = frame,
		})
		Components.Corner(8).Parent = highlight
		Components.Gradient(Theme.Colors.White, 0, { 0.1, 1 }).Parent = highlight
	end
	local badge = new("Frame", {
		Name = "Badge",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 2, 0.5, 0),
		Size = UDim2.fromOffset(24, 24),
		BackgroundColor3 = Theme.Colors.White,
		BorderSizePixel = 0,
		Parent = frame,
	})
	new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = badge })
	local badgeGradient = Components.Gradient(Theme.Gradients.Neutral, 90)
	badgeGradient.Parent = badge
	Components.Stroke(Theme.Colors.Shadow, 1.5, 0.3).Parent = badge
	local placement = Components.Label({
		Text = "",
		Font = Theme.Fonts.Title,
		TextSize = 14,
		TextColor3 = Theme.Colors.White,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		RichText = false,
		TextStrokeTransparency = 0.35,
		TextStrokeColor3 = Theme.Colors.Shadow,
		Size = UDim2.fromScale(1, 1),
		Parent = badge,
	})
	local name = Components.Label({
		Text = "",
		Font = Theme.Fonts.Bold,
		TextSize = 15,
		RichText = false,
		TextStrokeTransparency = 0.7,
		TextStrokeColor3 = Theme.Colors.Shadow,
		Position = UDim2.fromOffset(34, 0),
		Size = UDim2.new(1, -96, 1, 0),
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextWrapped = false,
		Parent = frame,
	})
	local chip, chipLabel = Components.Pill({
		Text = "",
		Color = Theme.Colors.Danger,
		Size = UDim2.fromOffset(58, 20),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -2, 0.5, 0),
		TextSize = 11,
		Parent = frame,
	})
	chip.Visible = false
	row = {
		Frame = frame,
		Badge = badge,
		BadgeGradient = badgeGradient,
		Placement = placement,
		Name = name,
		Chip = chip,
		ChipLabel = chipLabel,
		IsLocal = isLocal,
		LastPlacement = nil,
		LastStyle = nil,
		LastChip = nil,
	}
	self.Rows[folder] = row
	return row
end

-- Status-Chip einer Zeile setzen (nur bei Änderung)
local function setChip(row, text: string?, color: Color3?)
	if row.LastChip == text then
		return
	end
	row.LastChip = text
	row.Chip.Visible = text ~= nil
	if text and color then
		row.ChipLabel.Text = text
		row.ChipLabel.TextColor3 = color:Lerp(Theme.Colors.White, 0.35)
		row.Chip.BackgroundColor3 = color
		row.Chip.BackgroundTransparency = 0.78
		local border = row.Chip:FindFirstChild("Border")
		if border then
			border.Color = color
		end
	end
end

function RaceHud:_dotFor(folder)
	local dot = self.Dots[folder]
	if dot and dot.Frame.Parent then
		return dot
	end
	local isLocal = folder:GetAttribute("UserId") == player.UserId
	local size = if isLocal then 20 else 12
	local frame = new("Frame", {
		Name = if isLocal then "LocalDot" else "Dot",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = Theme.Colors.White,
		BorderSizePixel = 0,
		ZIndex = if isLocal then 7 else 6,
		Parent = self.DotHolder,
	})
	new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = frame })
	Components.Stroke(if isLocal then Theme.Colors.White else Theme.Colors.Shadow, if isLocal then 2.5 else 2, 0).Parent = frame
	if isLocal then
		Components.Gradient(Theme.Gradients.Accent, 90).Parent = frame
		-- Markierung über dem eigenen Punkt
		Components.Label({
			Text = Theme.Icons.Down,
			Font = Theme.Fonts.Title,
			TextSize = 12,
			TextColor3 = Theme.Colors.Accent,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			RichText = false,
			Outline = 1.5,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 0, -3),
			Size = UDim2.fromOffset(16, 12),
			ZIndex = 7,
			Parent = frame,
		})
	end
	dot = { Frame = frame, IsLocal = isLocal, Leader = nil }
	self.Dots[folder] = dot
	return dot
end

function RaceHud:_update(_dt: number)
	local ctx = self.Ctx
	local state = ctx.ClientState
	local gameState = state.GameState
	local serverNow = workspace:GetServerTimeNow()
	local phase = gameState:GetAttribute("Phase") or "Waiting"
	local inRace = state:IsInRace()
	local spectateTarget = ctx.CameraController:GetSpectate()
	local practice = state:GetPracticeCourse() ~= ""
	local matchActive = phase == "Countdown" or phase == "Racing" or phase == "Results"

	-- Zuschauen beenden, wenn das Rennen vorbei ist oder das Ziel weg ist
	if spectateTarget and (not matchActive or not spectateTarget.Parent or inRace) then
		ctx.CameraController:SetSpectate(nil)
		spectateTarget = nil
	end
	local watching = (inRace or spectateTarget ~= nil) and matchActive

	self.Top.Visible = watching
	self.Standings.Visible = watching
	self.SpectatePanel.Visible = spectateTarget ~= nil
	if spectateTarget then
		self:_updateSpectate(spectateTarget)
	end
	if not matchActive then
		self.EliminatedPanel.Visible = false
	end

	-- Kopfbereich
	if watching then
		local definition = MapDefinitions.Get(gameState:GetAttribute("MapId") or "")
		local ranked = gameState:GetAttribute("Mode") == "Ranked"
		local modeText = string.format("%s  %s · %s", Theme.Icons.Flag, if definition then string.upper(definition.Name) else "", if ranked then "RANKED" else "SCHNELLES SPIEL")
		if self.MapLabel.Text ~= modeText then
			self.MapLabel.Text = modeText
			local color = if ranked then Theme.Colors.Gold else Theme.Colors.Accent
			self.MapLabel.TextColor3 = color:Lerp(Theme.Colors.White, 0.35)
			local border = self.ModePill:FindFirstChild("Border")
			if border then
				border.Color = color
			end
		end
		local startedAt = gameState:GetAttribute("RaceStartedAt") or 0
		if phase == "Racing" and startedAt > 0 then
			self.TimerLabel.Text = Util.FormatTime(serverNow - startedAt)
		elseif phase == "Results" and self.FinalTime then
			self.TimerLabel.Text = Util.FormatTime(self.FinalTime)
		elseif phase == "Countdown" then
			self.TimerLabel.Text = "0:00.00"
		end
		-- Endzeit golden, sonst weiß-cyan
		local timerStyle = if phase == "Results" then "Final" else "Race"
		if timerStyle ~= self.TimerStyle then
			self.TimerStyle = timerStyle
			self.TimerGradient.Color = if timerStyle == "Final" then pairSequence(Theme.Gradients.Gold) else ColorSequence.new(Theme.Colors.White, rgb(178, 228, 255))
			Components.Pop(self.TimerLabel, 1.2, 0.35)
		end
		self:_updateTrack(gameState, spectateTarget)
		self:_updateStandings(spectateTarget)
	end

	-- Countdown
	self:_updateCountdown(phase, gameState, serverNow, watching)

	-- Gefahrenzone
	self:_updateZone(gameState, serverNow, inRace and phase == "Racing", watching)

	-- Item und Fähigkeiten
	local showControls = (inRace and phase ~= "Results") or practice
	self.Slot.Visible = showControls
	self.Abilities.Visible = showControls
	if showControls then
		self:_updateControls()
	end

	self:_updateIndicators(watching)
end

function RaceHud:_updateSpectate(target: Player)
	if self.SpectateLabel.Text ~= target.DisplayName then
		self.SpectateLabel.Text = target.DisplayName
	end
	local folder = self.Ctx.ClientState.Racers:FindFirstChild(tostring(target.UserId))
	local placement = folder and folder:GetAttribute("Placement")
	self.SpectatePlacePill.Visible = placement ~= nil
	if placement then
		local text = "PLATZ " .. tostring(placement)
		if self.SpectatePlace.Text ~= text then
			self.SpectatePlace.Text = text
		end
	end
end

function RaceHud:_updateTrack(gameState, spectateTarget: Player?)
	local startX = gameState:GetAttribute("StartX") or 0
	local finishX = gameState:GetAttribute("FinishX") or 0
	local length = math.max(1, finishX - startX)
	if #self.Ticks == 0 and (gameState:GetAttribute("CheckpointXs") or "") ~= "" then
		self:_buildTicks()
	end
	local zoneState = gameState:GetAttribute("ZoneState") or "Inactive"
	local zoneX = gameState:GetAttribute("ZoneX") or -1e6
	local zoneAlpha = if zoneState == "Shrinking" or zoneState == "Final" then math.clamp((zoneX - startX) / length, 0, 1) else 0
	self.ZoneFill.Size = UDim2.fromScale(zoneAlpha, 1)
	self.ZoneEdge.Visible = zoneAlpha > 0
	if zoneAlpha > 0 then
		-- Zone pulsiert leicht, die Kante glüht
		local pulse = 0.5 + 0.5 * math.sin(os.clock() * 6)
		self.ZoneFill.BackgroundTransparency = 0.05 + 0.2 * pulse
		self.ZoneEdge.Position = UDim2.fromScale(zoneAlpha, 0.5)
		self.ZoneEdgeStroke.Transparency = 0.6 * pulse
	end

	local focusId = if spectateTarget then spectateTarget.UserId else player.UserId
	local focusAlpha = nil
	local seen = {}
	for _, folder in self.Ctx.ClientState.Racers:GetChildren() do
		seen[folder] = true
		local dot = self:_dotFor(folder)
		local progress = folder:GetAttribute("Progress") or 0
		local status = folder:GetAttribute("Status")
		local alpha = math.clamp(progress / length, 0, 1)
		dot.Frame.Position = UDim2.fromScale(alpha, 0.5)
		dot.Frame.Visible = status == "Racing" or status == "Finished" or status == "Survived"
		if folder:GetAttribute("UserId") == focusId then
			focusAlpha = alpha
		end
		if not dot.IsLocal then
			local leader = folder:GetAttribute("Placement") == 1
			if leader ~= dot.Leader then
				dot.Leader = leader
				dot.Frame.BackgroundColor3 = if leader then Theme.Colors.Gold else Theme.Colors.White
			end
		end
	end
	for folder, dot in self.Dots do
		if not seen[folder] then
			dot.Frame:Destroy()
			self.Dots[folder] = nil
		end
	end

	-- Fortschritt des eigenen (bzw. beobachteten) Spielers + erreichte Checkpoints
	self.ProgressFill.Visible = focusAlpha ~= nil
	local reached = focusAlpha or 0
	self.ProgressFill.Size = UDim2.fromScale(reached, 1)
	for _, tick in self.Ticks do
		local passed = reached >= tick.Alpha
		if passed ~= tick.Passed then
			tick.Passed = passed
			tick.Frame.BackgroundColor3 = if passed then Theme.Colors.Accent else Theme.Colors.TextDim
			if passed then
				Components.Pop(tick.Frame, 1.8, 0.35)
			end
		end
	end
end

function RaceHud:_updateStandings(spectateTarget: Player?)
	local folders = self.Ctx.ClientState.Racers:GetChildren()
	table.sort(folders, function(a, b)
		return (a:GetAttribute("Placement") or 99) < (b:GetAttribute("Placement") or 99)
	end)
	local focusId = if spectateTarget then spectateTarget.UserId else player.UserId
	local focusPlacement = nil
	local alive = 0
	local pulse = 0.5 + 0.5 * math.sin(os.clock() * 12)
	local seen = {}
	for index, folder in folders do
		seen[folder] = true
		local row = self:_rowFor(folder)
		row.Frame.LayoutOrder = index
		local status = folder:GetAttribute("Status") or "Racing"
		local placement = folder:GetAttribute("Placement") or index
		local active = status == "Racing" or status == "Finished" or status == "Survived"
		if status == "Racing" then
			alive += 1
		end
		if folder:GetAttribute("UserId") == focusId then
			focusPlacement = placement
		end

		local name = folder:GetAttribute("Name") or "?"
		if row.Name.Text ~= name then
			row.Name.Text = name
		end
		local style = tostring(placement) .. (if active then "+" else "-")
		if style ~= row.LastStyle then
			row.LastStyle = style
			row.Placement.Text = tostring(placement)
			row.BadgeGradient.Color = pairSequence(placeGradient(placement, active))
			local color = if row.IsLocal then Theme.Colors.Accent:Lerp(Theme.Colors.White, 0.25) else Theme.Colors.Text
			row.Name.TextColor3 = if active then color else Theme.Colors.TextDim
			-- Überholt? Plakette hüpft
			if row.LastPlacement and active and placement < row.LastPlacement then
				Components.Pop(row.Badge, 1.35, 0.35)
			end
			row.LastPlacement = placement
		end

		local danger = folder:GetAttribute("DangerTime") or 0
		if danger > 0 and status == "Racing" then
			setChip(row, "GEFAHR", Theme.Colors.Danger)
			row.Chip.BackgroundTransparency = 0.25 + 0.5 * pulse
		else
			local chip = STATUS_CHIPS[status]
			setChip(row, chip and chip.Text, chip and chip.Color)
		end
	end
	for folder, row in self.Rows do
		if not seen[folder] then
			row.Frame:Destroy()
			self.Rows[folder] = nil
		end
	end
	self.Standings.Size = UDim2.fromOffset(264, 50 + #folders * 32)
	local aliveText = string.format("%s %d/%d", Theme.Icons.Players, alive, #folders)
	if self.AliveLabel.Text ~= aliveText then
		self.AliveLabel.Text = aliveText
	end

	-- Platz-Plakette neben dem Timer
	self.PlaceBadge.Visible = focusPlacement ~= nil
	if focusPlacement and focusPlacement ~= self.LastPlace then
		local improved = self.LastPlace ~= nil and focusPlacement < self.LastPlace
		self.LastPlace = focusPlacement
		self.PlaceLabel.Text = tostring(focusPlacement)
		self.PlaceGradient.Color = pairSequence(placeGradient(focusPlacement, true))
		if improved then
			Components.Pop(self.PlaceBadge, 1.3, 0.4)
		end
	end
	local ofText = "VON " .. tostring(#folders)
	if self.PlaceOf.Text ~= ofText then
		self.PlaceOf.Text = ofText
	end
end

-- Countdown-Zahl/-Wort mit Pop, Drehung und Schockwelle anzeigen
function RaceHud:_popCountdown(text: string, style: number, scale: number)
	local pair = COUNTDOWN_STYLE[style] or Theme.Gradients.Accent
	local countdown = self.Countdown
	countdown.Text = text
	countdown.TextSize = if style >= 1 and style <= 3 then 160 else 120
	countdown.TextTransparency = 0
	countdown.Rotation = -14
	self.CountdownStroke.Transparency = 0
	self.CountdownGradient.Color = pairSequence(pair)
	self.CountdownScale.Scale = scale
	Components.Tween(self.CountdownScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	Components.Tween(countdown, 0.45, { Rotation = 0 }, Enum.EasingStyle.Back)
	local shock = self.Shock
	shock.Size = UDim2.fromOffset(140, 140)
	shock.Visible = true
	self.ShockStroke.Color = pair[1]
	self.ShockStroke.Transparency = 0.1
	Components.Tween(shock, 0.6, { Size = UDim2.fromOffset(580, 580) }, Enum.EasingStyle.Quart)
	Components.Tween(self.ShockStroke, 0.6, { Transparency = 1 })
end

function RaceHud:_updateCountdown(phase: string, gameState, serverNow: number, watching: boolean)
	local audio = self.Ctx.AudioController
	if phase == "Countdown" and watching then
		local remaining = (gameState:GetAttribute("PhaseEndsAt") or 0) - serverNow
		local number = math.ceil(remaining)
		if number >= 1 and number <= 3 then
			self.Countdown.Visible = true
			if self.LastCountdown ~= number then
				self.LastCountdown = number
				self:_popCountdown(tostring(number), number, 2.2)
				audio:Play("Countdown")
			end
		else
			self.Countdown.Visible = number > 3
			self.Shock.Visible = false
			if number > 3 and self.LastCountdown ~= 4 then
				self.LastCountdown = 4
				self:_popCountdown("BEREIT?", 4, 1.4)
			end
		end
		return
	end
	if phase == "Racing" and watching then
		local startedAt = gameState:GetAttribute("RaceStartedAt") or 0
		local elapsed = serverNow - startedAt
		if elapsed < 0.9 then
			if self.LastCountdown ~= 0 then
				self.LastCountdown = 0
				self:_popCountdown("LOS!", 0, 2.4)
				audio:Play("Go")
			end
			-- Zum Ende hin ausblenden
			local fade = math.clamp((elapsed - 0.55) / 0.35, 0, 1)
			self.Countdown.TextTransparency = fade
			self.CountdownStroke.Transparency = fade
			self.Countdown.Visible = true
			return
		end
	end
	self.Countdown.Visible = false
	self.Shock.Visible = false
	if phase ~= "Countdown" and phase ~= "Racing" then
		self.LastCountdown = nil
	end
end

-- Banner-Band setzen (nil = ausblenden); pair = Verlaufspaar der Farbe
function RaceHud:_setBanner(text: string?, pair)
	if not text then
		self.Banner.Visible = false
		self.BannerPair = nil
		return
	end
	local changed = self.BannerLabel.Text ~= text
	if changed then
		self.BannerLabel.Text = text
	end
	if not self.Banner.Visible or self.BannerPair ~= pair then
		self.BannerPair = pair
		self.BannerGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, pair[2]),
			ColorSequenceKeypoint.new(0.5, pair[1]),
			ColorSequenceKeypoint.new(1, pair[2]),
		})
		local stroke = self.BannerLabel:FindFirstChild("TextStroke")
		if stroke then
			stroke.Color = pair[2]:Lerp(Theme.Colors.Black, 0.65)
		end
		self.Banner.Visible = true
		Components.Pop(self.Banner, 1.25, 0.4)
	elseif changed then
		Components.Pop(self.Banner, 1.06, 0.2)
	end
end

function RaceHud:_updateZone(gameState, serverNow: number, localRacing: boolean, watching: boolean)
	local zoneState = gameState:GetAttribute("ZoneState") or "Inactive"
	if zoneState ~= self.LastZoneState then
		if zoneState == "Shrinking" then
			self.BannerText = "⚠  DIE GEFAHRENZONE SCHRUMPFT!  ⚠"
			self.BannerUntil = os.clock() + 2.5
			self.Ctx.AudioController:Play("Warning")
		elseif zoneState == "Final" then
			self.BannerText = "⚠  FINALE ZONE – NUR DIE SCHNELLSTEN ÜBERLEBEN!  ⚠"
			self.BannerUntil = os.clock() + 2.5
			self.Ctx.AudioController:Play("Warning")
		end
		self.LastZoneState = zoneState
	end
	if watching and zoneState == "Warning" then
		local remaining = math.max(0, math.ceil((gameState:GetAttribute("ZoneShrinkAt") or 0) - serverNow))
		self:_setBanner(string.format("GEFAHRENZONE AKTIV IN %d", remaining), Theme.Gradients.Warning)
	elseif watching and os.clock() < self.BannerUntil then
		self:_setBanner(self.BannerText or "", Theme.Gradients.Danger)
	else
		self:_setBanner(nil)
	end

	-- Eigene Gefahr
	local intensity = 0
	local remainingDanger = nil
	local delay = Config.HazardZone.EliminationDelay
	if localRacing then
		local folder = self.Ctx.ClientState.Racers:FindFirstChild(tostring(player.UserId))
		local danger = folder and folder:GetAttribute("DangerTime") or 0
		if danger > 0 then
			intensity = 0.45 + 0.5 * math.clamp(danger / delay, 0, 1)
			remainingDanger = math.max(0, delay - danger)
		elseif zoneState == "Shrinking" or zoneState == "Final" then
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root then
				local gap = root.Position.X - (gameState:GetAttribute("ZoneX") or -1e6)
				if gap < 30 then
					intensity = 0.35 * (1 - math.clamp(gap / 30, 0, 1))
				end
			end
		end
	end
	local clock = os.clock()
	local pulse = if intensity > 0.4 then (0.85 + math.sin(clock * 10) * 0.15) else 1
	for _, frame in self.Vignette do
		frame.BackgroundTransparency = 1 - intensity * pulse
	end
	self.DangerTint.BackgroundTransparency = 1 - math.max(0, intensity - 0.4) * 0.22 * pulse

	-- Warnkarte mit Restzeit
	self.DangerPanel.Visible = remainingDanger ~= nil
	if remainingDanger then
		local text = string.format("%.1f s", remainingDanger)
		if self.DangerTime.Text ~= text then
			self.DangerTime.Text = text
		end
		self.SetDangerBar(remainingDanger / math.max(0.01, delay))
		self.DangerScale.Scale = 1 + 0.035 * math.sin(clock * 12)
	end
end

function RaceHud:_updateControls()
	local ctx = self.Ctx
	local device = ctx.InputController:GetDevice()
	local hints = KEY_HINTS[device] or KEY_HINTS.Keyboard
	local itemId = player:GetAttribute("HeldItem") or ""
	local item = ItemDefinitions.Get(itemId)
	setKeyCap(self.SlotKeyCap, self.SlotKeyLabel, if item then hints.Item else "")
	if itemId ~= self.LastItem then
		self.LastItem = itemId
		if item then
			Components.SetIconColor(self.SlotIcon, item.Color)
			self.SlotGlyph.Text = ITEM_GLYPHS[item.Id] or Theme.Icons.Star
			self.SlotGlyph.TextStrokeTransparency = 1
			self.SlotGlyph.TextTransparency = 0
			self.SlotName.Text = item.Short
			self.SlotName.TextColor3 = item.Color:Lerp(Theme.Colors.White, 0.35)
			self.SlotKey.Text = "EINSETZEN"
			self.SlotKey.TextColor3 = Theme.Colors.Text
			self.SlotGlow.Visible = true
			self.SlotGlow.BackgroundColor3 = item.Color
			self.SlotGlowStroke.Color = item.Color
			if self.SlotStroke then
				self.SlotStroke.Color = item.Color
			end
			Components.Pop(self.SlotIcon, 1.4, 0.4)
		else
			Components.SetIconColor(self.SlotIcon, Theme.Colors.PanelLight)
			self.SlotGlyph.Text = "?"
			self.SlotGlyph.TextStrokeTransparency = 0.5
			self.SlotGlyph.TextTransparency = 0.45
			self.SlotName.Text = "KEIN ITEM"
			self.SlotName.TextColor3 = Theme.Colors.TextDim
			self.SlotKey.Text = "Box einsammeln"
			self.SlotKey.TextColor3 = Theme.Colors.TextDim
			self.SlotGlow.Visible = false
			if self.SlotStroke then
				self.SlotStroke.Color = Theme.Colors.Stroke
			end
		end
	end

	local cooldowns = ctx.MovementController:GetCooldowns()
	local clock = os.clock()
	local function render(key: string, remaining: number, max: number, active: boolean, ready: boolean)
		local entry = self.AbilityBoxes[key]
		setKeyCap(entry.Cap, entry.CapLabel, hints[key] or "")
		local cooling = remaining > 0 and max > 0
		entry.SetRing(if cooling then 1 - math.clamp(remaining / max, 0, 1) else 1)
		if cooling then
			local text = string.format("%.1f", remaining)
			if entry.Timer.Text ~= text then
				entry.Timer.Text = text
			end
		end
		local state = if active then "Active" elseif cooling then "Cooling" elseif ready then "Ready" else "Blocked"
		if state ~= entry.State then
			local previous = entry.State
			entry.State = state
			local ringColor = if state == "Cooling" then Theme.Colors.Stroke elseif state == "Blocked" then Theme.Colors.PanelLight else entry.Color
			for _, disc in entry.Discs do
				disc.BackgroundColor3 = ringColor
			end
			entry.Glyph.Visible = not cooling
			entry.Timer.Visible = cooling
			entry.Glyph.TextTransparency = if state == "Blocked" then 0.55 else 0
			entry.Name.Text = if state == "Active" then "AKTIV" else entry.Label
			entry.Name.TextColor3 = if state == "Active"
				then entry.Color:Lerp(Theme.Colors.White, 0.3)
				elseif state == "Ready" then Theme.Colors.Text
				else Theme.Colors.TextDim
			if entry.Stroke then
				entry.Stroke.Color = if state == "Active" or state == "Ready" then entry.Color:Lerp(Theme.Colors.Stroke, 0.3) else Theme.Colors.Stroke
				entry.Stroke.Thickness = if state == "Active" then 3 else 1.5
				entry.Stroke.Transparency = 0.1
			end
			-- Wieder bereit: Ring hüpft kurz
			if (state == "Ready" or state == "Active") and previous == "Cooling" then
				Components.Pop(entry.Ring, 1.2, 0.3)
			end
		end
		if state == "Active" and entry.Stroke then
			entry.Stroke.Transparency = 0.1 + 0.35 * (0.5 + 0.5 * math.sin(clock * 14))
		end
	end
	render("Grapple", cooldowns.Grapple, cooldowns.GrappleMax, cooldowns.Grappling, cooldowns.Grapple <= 0 and cooldowns.HasTarget)
	render("Dash", cooldowns.Dash, cooldowns.DashMax, false, cooldowns.Dash <= 0 and cooldowns.DashAvailable)
	render("Slide", cooldowns.Slide, cooldowns.SlideMax, ctx.MovementController:GetState() == "Slide", cooldowns.Slide <= 0)
end

function RaceHud:_updateIndicators(watching: boolean)
	local camera = workspace.CurrentCamera
	local index = 0
	if watching and camera then
		local viewport = camera.ViewportSize
		local focusPlayer = self.Ctx.CameraController:GetSpectate() or player
		for _, folder in self.Ctx.ClientState.Racers:GetChildren() do
			if folder:GetAttribute("Status") == "Racing" then
				local other = Players:GetPlayerByUserId(folder:GetAttribute("UserId") or 0)
				local character = other and other ~= focusPlayer and other.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				if root and index < #self.Indicators then
					local screen, onScreen = camera:WorldToViewportPoint(root.Position)
					local inside = onScreen and screen.X > 0 and screen.X < viewport.X and screen.Y > 0 and screen.Y < viewport.Y
					if not inside then
						index += 1
						local indicator = self.Indicators[index]
						local margin = 70
						local x = math.clamp(screen.X, margin, viewport.X - margin)
						local y = math.clamp(screen.Y, margin, viewport.Y - margin)
						if not onScreen then
							-- Hinter der Kamera: horizontal spiegeln
							x = viewport.X - x
						end
						local logical = self.UI:ToLogical(Vector2.new(x, y))
						indicator.Frame.Position = UDim2.fromOffset(logical.X, logical.Y)
						indicator.Frame.Visible = true
						local center = viewport / 2
						local direction = Vector2.new(screen.X, screen.Y) - center
						indicator.Arrow.Rotation = math.deg(math.atan2(direction.Y, direction.X))
						local focusCharacter = focusPlayer.Character
						local focusRoot = focusCharacter and focusCharacter:FindFirstChild("HumanoidRootPart")
						local distance = if focusRoot then math.floor(math.abs(root.Position.X - focusRoot.Position.X)) else 0
						indicator.Label.Text = string.format("%s · %dm", other.DisplayName, distance)
					end
				end
			end
		end
	end
	for i = index + 1, #self.Indicators do
		self.Indicators[i].Frame.Visible = false
	end
end

return RaceHud
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="73">
              <Properties>
                <string name="Name">Results</string>
                <string name="Source"><![CDATA[--[[
	Results  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/UI/Screens/Results

	Ergebnisbildschirm nach jedem Rennen:
		- Schlagzeile (SIEG! / PLATZ n / „X GEWINNT“) in Display-Schrift mit
		  Farbverlauf und Info-Chips (Map, Modus, Grund des Rennendes, Dauer)
		- Siegerpodest für die Plätze 1–3 (Gold/Silber/Bronze, Krone für den
		  Sieger; die Blöcke wachsen beim Öffnen nacheinander hoch)
		- Tabelle aller Teilnehmer (Plakette, Name, Status, Zeit/Strecke, Rating)
		- Belohnungskarten: Coins und XP zählen beim Öffnen hoch, Level-Up als
		  goldenes Banner mit Glanz, dazu Rating, Bestzeit, Aufgaben und Erfolge
		- Option "Automatisch erneut anstellen"
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local MapDefinitions = require(Shared.MapDefinitions)

local UI = script.Parent.Parent
local Components = require(UI.Components)
local Theme = require(UI.Theme)

local player = Players.LocalPlayer
local new = Components.new
local rgb = Color3.fromRGB

local Results = {}
Results.__index = Results

local REASONS = {
	Finish = "Ziellinie überquert",
	LastStanding = "Letzter Überlebender",
	Timeout = "Zeit abgelaufen – der Führende gewinnt",
	NoRacers = "Keine Teilnehmer mehr im Rennen",
}

local STATUS = {
	Finished = "Im Ziel",
	Survived = "Überlebt",
	Eliminated = "Ausgeschieden",
	Left = "Verlassen",
	Racing = "Im Rennen",
}

local STATUS_ICONS = {
	Finished = Theme.Icons.Flag,
	Survived = Theme.Icons.Check,
	Eliminated = "💀",
	Left = "🚪",
	Racing = "🏃",
}

-- Plaketten-Verläufe für die Plätze 1–3 (Gold, Silber, Bronze)
local MEDALS = {
	{ rgb(255, 234, 100), rgb(255, 154, 18) },
	{ rgb(242, 246, 255), rgb(146, 158, 186) },
	{ rgb(255, 196, 140), rgb(184, 96, 38) },
}

-- Podest: Platz, horizontale Lage (Anteil), Blockhöhe
local PODIUM = {
	{ Place = 1, X = 0.5, Height = 70 },
	{ Place = 2, X = 0.19, Height = 54 },
	{ Place = 3, X = 0.81, Height = 40 },
}

local LEFT_WIDTH = 540 -- Breite von Podest und Tabelle
local TOP = 92 -- Beginn von Podest/Belohnungen unter der Kopfzeile
local FOOTER = 60

local function initial(name: string): string
	return string.upper(string.match(name, utf8.charpattern) or "?")
end

local function textWidth(text: string, perChar: number): number
	return (utf8.len(text) or #text) * perChar
end

function Results.new(ui)
	local self = setmetatable({}, Results)
	self.UI = ui
	self.Counters = {}
	local modal = Components.Modal({
		Name = "Results",
		Title = "ERGEBNIS",
		Icon = Theme.Icons.Flag,
		Accent = Theme.Colors.Gold,
		Size = UDim2.fromOffset(960, 580),
		Parent = ui.Root,
	})
	self.Modal = modal
	ui:RegisterModal("Results", modal)
	local content = modal.Content

	-- Kopf: Schlagzeile + Info-Chips
	self.Headline = Components.Heading({
		Text = "",
		Font = Theme.Fonts.Display,
		TextSize = 46,
		TextScaled = true,
		MaxTextSize = 46,
		Outline = 3,
		OutlineTransparency = 0,
		RichText = false,
		Size = UDim2.new(1, 0, 0, 50),
		Parent = content,
	})
	self.HeadlineGradient = Components.Gradient(Theme.Gradients.Gold, 90)
	self.HeadlineGradient.Parent = self.Headline
	self.Chips = new("Frame", {
		Name = "Chips",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 56),
		Size = UDim2.new(1, 0, 0, 26),
		Parent = content,
	}, { Components.List(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center) })

	self:_buildPodium(content)

	-- Tabelle aller Teilnehmer
	local list = new("ScrollingFrame", {
		Name = "Table",
		Position = UDim2.fromOffset(0, TOP + 178),
		Size = UDim2.new(0, LEFT_WIDTH, 1, -(TOP + 178 + FOOTER)),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Colors.Stroke,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = content,
	}, { Components.List(Enum.FillDirection.Vertical, 5), Components.Padding(2, 4, 2, 2) })
	self.List = list

	self:_buildRewards(content)

	-- Fußzeile
	local footer = new("Frame", {
		Name = "Footer",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 52),
		Parent = content,
	})
	local _, setToggle = Components.Toggle({
		Text = "Automatisch erneut anstellen",
		Size = UDim2.new(0.5, 0, 1, 0),
		Parent = footer,
		OnChanged = function(value)
			ui.Ctx.ClientState:SaveSettings({ AutoRequeue = value })
		end,
	})
	self.SetAutoRequeue = setToggle
	local continueButton = Components.Button({
		Text = "WEITER",
		Icon = Theme.Icons.Play,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(210, 52),
		Color = Theme.Colors.Success,
		Gradient = Theme.Gradients.Play,
		TextColor = Theme.Colors.White,
		TextSize = 22,
		Font = Theme.Fonts.Title,
		CornerRadius = 14,
		OnClick = function()
			modal.Close()
		end,
	})
	continueButton.Parent = footer
	Components.Shine(continueButton, { Interval = 4 })

	modal.OnOpen = function()
		self:_playIntro()
	end
	return self
end

-- Siegerpodest (drei feste Plätze, werden pro Rennen befüllt)
function Results:_buildPodium(content: Frame)
	local podium = new("Frame", {
		Name = "Podium",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, TOP),
		Size = UDim2.fromOffset(LEFT_WIDTH, 170),
		Parent = content,
	})
	-- Bodenlinie unter dem Podest
	Components.Divider({
		Name = "Floor",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 3),
		Colors = { Theme.Colors.Gold, Theme.Colors.Accent },
		Parent = podium,
	})
	self.Podium = podium
	self.PodiumSlots = {}
	for _, info in PODIUM do
		local place, height = info.Place, info.Height
		local medal = MEDALS[place]
		local slot = new("Frame", {
			Name = "Place" .. place,
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(info.X, 0, 1, -3),
			Size = UDim2.fromOffset(160, 167),
			Parent = podium,
		})
		local block = new("Frame", {
			Name = "Block",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromScale(0.5, 1),
			Size = UDim2.new(1, -16, 0, height),
			BackgroundColor3 = Theme.Colors.White,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			Parent = slot,
		})
		Components.Corner(12).Parent = block
		Components.Gradient(medal, 90).Parent = block
		Components.Stroke(medal[2]:Lerp(Theme.Colors.Black, 0.45), 2, 0).Parent = block
		Components.Heading({
			Text = tostring(place),
			Font = Theme.Fonts.Display,
			TextSize = 34,
			TextXAlignment = Enum.TextXAlignment.Center,
			Outline = 2.5,
			OutlineColor = medal[2]:Lerp(Theme.Colors.Black, 0.6),
			OutlineTransparency = 0,
			RichText = false,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 3),
			Size = UDim2.new(1, 0, 0, 36),
			Parent = block,
		})
		local detail = Components.Label({
			Name = "Detail",
			Text = "",
			Font = Theme.Fonts.Bold,
			TextSize = 12,
			TextColor3 = Theme.Colors.TextDim,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			RichText = false,
			TextTruncate = Enum.TextTruncate.AtEnd,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -(height + 3)),
			Size = UDim2.new(1, 0, 0, 15),
			Parent = slot,
		})
		local name = Components.Heading({
			Name = "PlayerName",
			Text = "",
			TextSize = 16,
			TextXAlignment = Enum.TextXAlignment.Center,
			Outline = 1.5,
			RichText = false,
			TextTruncate = Enum.TextTruncate.AtEnd,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -(height + 18)),
			Size = UDim2.new(1, 0, 0, 20),
			Parent = slot,
		})
		local avatar = new("Frame", {
			Name = "Avatar",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -(height + 40)),
			Size = UDim2.fromOffset(44, 44),
			BackgroundColor3 = Theme.Colors.White,
			BorderSizePixel = 0,
			Parent = slot,
		})
		new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = avatar })
		Components.Gradient(medal, 135).Parent = avatar
		local avatarStroke = Components.Stroke(Theme.Colors.White, 3, 0.15)
		avatarStroke.Parent = avatar
		local letter = Components.Label({
			Text = "",
			Font = Theme.Fonts.Title,
			TextSize = 22,
			TextColor3 = Theme.Colors.White,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			RichText = false,
			TextStrokeTransparency = 0.3,
			TextStrokeColor3 = medal[2]:Lerp(Theme.Colors.Black, 0.6),
			Size = UDim2.fromScale(1, 1),
			Parent = avatar,
		})
		if place == 1 then
			Components.Label({
				Name = "Crown",
				Text = Theme.Icons.Ranked,
				TextSize = 24,
				TextXAlignment = Enum.TextXAlignment.Center,
				TextWrapped = false,
				RichText = false,
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.new(0.5, 0, 0, 8),
				Rotation = -12,
				Size = UDim2.fromOffset(40, 28),
				Parent = avatar,
			})
		end
		self.PodiumSlots[place] = {
			Slot = slot,
			Block = block,
			Height = height,
			Name = name,
			Detail = detail,
			Avatar = avatar,
			AvatarStroke = avatarStroke,
			Letter = letter,
		}
	end
end

-- Belohnungs-Karte: Coins/XP-Kacheln, Level-Up-Banner, weitere Zeilen
function Results:_buildRewards(content: Frame)
	local _, panel = Components.Card({
		Name = "Rewards",
		Position = UDim2.fromOffset(LEFT_WIDTH + 16, TOP),
		Size = UDim2.new(1, -(LEFT_WIDTH + 16), 1, -(TOP + FOOTER)),
		BackgroundColor3 = Theme.Colors.PanelDark,
		CornerRadius = 16,
		ShadowOffset = 4,
		ShadowSpread = 5,
		Parent = content,
	})
	local _, gift = Components.Icon({ Glyph = Theme.Icons.Gift, Color = Theme.Colors.Gold, Size = 32, TextSize = 17, Position = UDim2.fromOffset(12, 9), Parent = panel })
	gift.TextStrokeTransparency = 1
	Components.Heading({
		Text = "BELOHNUNGEN",
		TextSize = 19,
		Outline = 1.5,
		RichText = false,
		Position = UDim2.fromOffset(52, 11),
		Size = UDim2.new(1, -64, 0, 28),
		Parent = panel,
	})
	Components.Divider({ Position = UDim2.fromOffset(12, 48), Size = UDim2.new(1, -24, 0, 2), Colors = { Theme.Colors.Gold, Theme.Colors.Accent2 }, Parent = panel })
	local body = new("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 58),
		Size = UDim2.new(1, -24, 1, -66),
		Parent = panel,
	})
	self.RewardsBody = body

	-- Coins- und XP-Kachel
	local function tile(position: UDim2, color: Color3, caption: string)
		local frame = new("Frame", {
			Name = caption,
			Position = position,
			Size = UDim2.new(0.5, -4, 0, 74),
			BackgroundColor3 = Theme.Colors.White,
			BorderSizePixel = 0,
			Parent = body,
		})
		Components.Corner(12).Parent = frame
		Components.Gradient({ color:Lerp(Theme.Colors.Panel, 0.55), color:Lerp(Theme.Colors.PanelDark, 0.82) }, 90).Parent = frame
		Components.Stroke(color, 1.5, 0.3).Parent = frame
		local value = Components.Heading({
			Text = "+0",
			TextSize = 28,
			TextScaled = true,
			MaxTextSize = 28,
			TextColor3 = color:Lerp(Theme.Colors.White, 0.25),
			Outline = 2,
			RichText = false,
			Position = UDim2.fromOffset(52, 8),
			Size = UDim2.new(1, -58, 0, 34),
			Parent = frame,
		})
		Components.Label({
			Text = caption,
			Font = Theme.Fonts.Title,
			TextSize = 13,
			TextColor3 = Theme.Colors.TextDim,
			TextWrapped = false,
			RichText = false,
			Position = UDim2.fromOffset(53, 44),
			Size = UDim2.new(1, -58, 0, 18),
			Parent = frame,
		})
		return frame, value
	end
	local coinTile, coinValue = tile(UDim2.new(), Theme.Colors.Gold, "COINS")
	Components.CoinIcon(34, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), Parent = coinTile })
	local xpTile, xpValue = tile(UDim2.new(0.5, 4, 0, 0), Theme.Colors.XP, "XP")
	Components.Icon({ Glyph = "✦", Color = Theme.Colors.XP, Size = 36, TextSize = 20, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 9, 0.5, 0), Parent = xpTile })
	self.CoinTile, self.CoinValue = coinTile, coinValue
	self.XPTile, self.XPValue = xpTile, xpValue

	-- Level-Up-Banner (gold, mit Glanz)
	local banner = new("Frame", {
		Name = "LevelUp",
		Position = UDim2.fromOffset(0, 82),
		Size = UDim2.new(1, 0, 0, 58),
		BackgroundColor3 = Theme.Colors.White,
		BorderSizePixel = 0,
		Visible = false,
		Parent = body,
	})
	Components.Corner(12).Parent = banner
	Components.Gradient(Theme.Gradients.Gold, 90).Parent = banner
	Components.Stroke(rgb(150, 80, 0), 2, 0.1).Parent = banner
	Components.Label({
		Text = "⭐",
		TextSize = 30,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		RichText = false,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 8, 0.5, 0),
		Size = UDim2.fromOffset(40, 40),
		Parent = banner,
	})
	Components.Heading({
		Text = "LEVEL UP!",
		Font = Theme.Fonts.Display,
		TextSize = 26,
		Outline = 2.5,
		OutlineColor = rgb(120, 56, 0),
		OutlineTransparency = 0,
		RichText = false,
		Position = UDim2.fromOffset(54, 4),
		Size = UDim2.new(1, -62, 0, 30),
		Parent = banner,
	})
	self.LevelInfo = Components.Label({
		Text = "",
		Font = Theme.Fonts.Bold,
		TextSize = 14,
		TextScaled = true,
		MaxTextSize = 14,
		TextColor3 = rgb(92, 44, 0),
		TextWrapped = false,
		Position = UDim2.fromOffset(55, 34),
		Size = UDim2.new(1, -64, 0, 18),
		Parent = banner,
	})
	Components.Shine(banner, { Interval = 3 })
	self.LevelBanner = banner

	-- Weitere Zeilen (Rating, Bestzeit, Aufgaben, Erfolge, Hinweise)
	self.Rewards = new("ScrollingFrame", {
		Name = "Lines",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 82),
		Size = UDim2.new(1, 0, 1, -82),
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = Theme.Colors.Stroke,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = body,
	}, { Components.List(Enum.FillDirection.Vertical, 6) })
	self.LineCount = 0
end

function Results:Start()
	local state = self.UI.Ctx.ClientState
	state:On("MatchResults", function(payload)
		self:Show(payload)
	end)
end

--- Zeile im Belohnungsbereich (Symbol + Text, bricht bei Bedarf um).
function Results:_rewardLine(text: string, color: Color3?, icon: string?)
	local tint = color or Theme.Colors.Text
	self.LineCount += 1
	local row = new("Frame", {
		Name = "Line",
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, -6, 0, 0),
		BackgroundColor3 = tint,
		BackgroundTransparency = 0.86,
		BorderSizePixel = 0,
		LayoutOrder = self.LineCount,
		Parent = self.Rewards,
	})
	Components.Corner(8).Parent = row
	Components.Padding(5, 8, 5, 6).Parent = row
	Components.Label({
		Text = icon or Theme.Icons.Star,
		Font = Theme.Fonts.Title,
		TextSize = 15,
		TextColor3 = tint:Lerp(Theme.Colors.White, 0.3),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		RichText = false,
		Size = UDim2.fromOffset(20, 20),
		Parent = row,
	})
	Components.Label({
		Text = text,
		Font = Theme.Fonts.Bold,
		TextSize = 14,
		TextColor3 = tint:Lerp(Theme.Colors.White, 0.3),
		AutomaticSize = Enum.AutomaticSize.Y,
		Position = UDim2.fromOffset(26, 1),
		Size = UDim2.new(1, -26, 0, 18),
		Parent = row,
	})
end

-- Info-Chip in der Kopfzeile (Breite grob aus der Textlänge geschätzt)
function Results:_chip(order: number, text: string, color: Color3)
	Components.Pill({
		Text = text,
		Color = color,
		Size = UDim2.fromOffset(math.min(300, 26 + textWidth(text, 8)), 24),
		TextSize = 13,
		LayoutOrder = order,
		Parent = self.Chips,
	})
end

function Results:Show(payload)
	local participated = false
	local myResult = nil
	for _, entry in payload.Results or {} do
		if entry.UserId == player.UserId then
			participated = true
			myResult = entry
		end
	end

	local definition = MapDefinitions.Get(payload.MapId or "")
	local mapName = if definition then definition.Name else ""
	local winnerName = "—"
	for _, entry in payload.Results or {} do
		if entry.Placement == 1 then
			winnerName = entry.Name
		end
	end

	-- Schlagzeile
	local headlinePair
	if payload.WinnerUserId == player.UserId then
		self.Headline.Text = "SIEG!"
		headlinePair = Theme.Gradients.Gold
	elseif myResult then
		self.Headline.Text = string.format("PLATZ %d", myResult.Placement)
		headlinePair = if myResult.Placement <= 3 then Theme.Gradients.Accent else { Theme.Colors.White, Theme.Colors.TextDim }
	else
		self.Headline.Text = string.upper(winnerName) .. " GEWINNT"
		headlinePair = { Theme.Colors.White, rgb(200, 212, 245) }
	end
	self.HeadlineGradient.Color = ColorSequence.new(headlinePair[1], headlinePair[2])
	local stroke = self.Headline:FindFirstChild("TextStroke")
	if stroke then
		stroke.Color = headlinePair[2]:Lerp(Theme.Colors.Black, 0.7)
	end

	-- Info-Chips
	for _, child in self.Chips:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local ranked = payload.Mode == "Ranked"
	if mapName ~= "" then
		self:_chip(1, string.upper(mapName), Theme.Colors.Accent)
	end
	self:_chip(2, if ranked then Theme.Icons.Ranked .. " RANKED" else Theme.Icons.Quick .. " SCHNELLES SPIEL", if ranked then Theme.Colors.Gold else Theme.Colors.Accent2)
	if REASONS[payload.Reason] then
		self:_chip(3, REASONS[payload.Reason], Theme.Colors.PanelLight:Lerp(Theme.Colors.White, 0.3))
	end
	self:_chip(4, "⏱ " .. Util.FormatTime(payload.Duration or 0), Theme.Colors.Success)

	-- Podest
	local byPlace = {}
	for _, entry in payload.Results or {} do
		if entry.Placement and entry.Placement <= 3 and not byPlace[entry.Placement] then
			byPlace[entry.Placement] = entry
		end
	end
	for place, slot in self.PodiumSlots do
		local entry = byPlace[place]
		slot.Slot.Visible = entry ~= nil
		if entry then
			local isMe = entry.UserId == player.UserId
			slot.Name.Text = entry.Name or "?"
			slot.Name.TextColor3 = if isMe then Theme.Colors.Accent:Lerp(Theme.Colors.White, 0.3) else Theme.Colors.White
			slot.Letter.Text = initial(entry.Name or "?")
			slot.AvatarStroke.Color = if isMe then Theme.Colors.Accent else Theme.Colors.White
			slot.AvatarStroke.Thickness = if isMe then 4 else 3
			if entry.Time then
				slot.Detail.Text = Util.FormatTime(entry.Time)
			elseif entry.Progress then
				slot.Detail.Text = string.format("%d m", math.max(0, entry.Progress))
			else
				slot.Detail.Text = STATUS[entry.Status] or ""
			end
		end
	end

	-- Tabelle
	for _, child in self.List:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	for index, entry in payload.Results or {} do
		self:_tableRow(index, entry)
	end

	-- Belohnungen
	for _, child in self.Rewards:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	self.LineCount = 0
	self.Counters = {}
	local rewards = payload.Rewards
	local leveled = rewards ~= nil and (rewards.LevelsGained or 0) > 0
	self.CoinTile.Visible = rewards ~= nil
	self.XPTile.Visible = rewards ~= nil
	self.LevelBanner.Visible = leveled
	local linesTop = if leveled then 148 elseif rewards then 82 else 0
	self.Rewards.Position = UDim2.fromOffset(0, linesTop)
	self.Rewards.Size = UDim2.new(1, 0, 1, -linesTop)
	if rewards then
		self.CoinValue.Text = "+" .. Util.FormatNumber(rewards.Coins or 0)
		self.XPValue.Text = "+" .. Util.FormatNumber(rewards.XP or 0)
		self.Counters = {
			{ Label = self.CoinValue, Target = rewards.Coins or 0, Tile = self.CoinTile },
			{ Label = self.XPValue, Target = rewards.XP or 0, Tile = self.XPTile },
		}
		if leveled then
			self.LevelInfo.Text = string.format("Level %d erreicht · +%s Coins Bonus", rewards.NewLevel or 0, Util.FormatNumber(rewards.LevelBonusCoins or 0))
		end
		if rewards.RatingChange then
			self:_rewardLine(
				string.format("Rating %+d → %d (%s)", rewards.RatingChange, rewards.NewRating or 0, rewards.Tier or ""),
				if rewards.RatingChange >= 0 then Theme.Colors.Success else Theme.Colors.Danger,
				if rewards.RatingChange >= 0 then Theme.Icons.Up else Theme.Icons.Down
			)
		end
		if rewards.NewBestTime then
			self:_rewardLine("Neue Bestzeit: " .. Util.FormatTime(rewards.NewBestTime), Theme.Colors.Accent, "⏱")
		end
		for _, quest in rewards.Quests or {} do
			self:_rewardLine("Aufgabe erledigt: " .. quest, Theme.Colors.Success, Theme.Icons.Check)
		end
		for _, achievement in rewards.Achievements or {} do
			self:_rewardLine("Erfolg: " .. achievement, Theme.Colors.Gold, Theme.Icons.Leaderboard)
		end
	elseif participated then
		self:_rewardLine("Keine Belohnung (Rennen verlassen).", Theme.Colors.TextDim, Theme.Icons.Info)
	else
		self:_rewardLine("Du hast zugeschaut.", Theme.Colors.TextDim, Theme.Icons.Spectate)
		self:_rewardLine("Tritt der Warteschlange bei, um in der nächsten Runde mitzufahren!", Theme.Colors.Accent, Theme.Icons.Queue)
	end

	self.SetAutoRequeue(self.UI.Ctx.ClientState:GetSetting("AutoRequeue") ~= false)

	-- Nur Teilnehmer und Zuschauer bekommen das Fenster automatisch
	local spectating = self.UI.Ctx.CameraController:GetSpectate() ~= nil
	if participated or spectating then
		task.delay(Config.Round.ReturnToLobbyDelay * 0.6, function()
			self.UI:OpenModal("Results")
		end)
		local token = {}
		self.Token = token
		task.delay(Config.Round.ResultsDuration + 4, function()
			if self.Token == token then
				self.Modal.Close()
			end
		end)
	end
end

-- Eine Tabellenzeile: Plakette, Name, Status/Zeit, Rating-Änderung
function Results:_tableRow(index: number, entry)
	local isMe = entry.UserId == player.UserId
	local place = entry.Placement or index
	local medal = MEDALS[place]
	local row = Components.Panel({
		Name = "Row",
		Size = UDim2.new(1, -8, 0, 38),
		BackgroundColor3 = if isMe then Theme.Colors.PanelLight else Theme.Colors.PanelDark,
		BackgroundTransparency = 0.08,
		StrokeColor = if isMe then Theme.Colors.Accent elseif medal then medal[2] else Theme.Colors.Stroke,
		StrokeTransparency = if isMe or medal then 0.1 else 0.5,
		CornerRadius = 10,
		LayoutOrder = index,
		Parent = self.List,
	})
	local badge = new("Frame", {
		Name = "Badge",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 8, 0.5, 0),
		Size = UDim2.fromOffset(28, 28),
		BackgroundColor3 = Theme.Colors.White,
		BorderSizePixel = 0,
		Parent = row,
	})
	new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = badge })
	Components.Gradient(medal or Theme.Gradients.Neutral, 90).Parent = badge
	Components.Stroke(Theme.Colors.Shadow, 1.5, 0.3).Parent = badge
	Components.Label({
		Text = tostring(place),
		Font = Theme.Fonts.Title,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		RichText = false,
		TextStrokeTransparency = 0.35,
		TextStrokeColor3 = Theme.Colors.Shadow,
		Size = UDim2.fromScale(1, 1),
		Parent = badge,
	})
	Components.Label({
		Text = entry.Name or "?",
		Font = Theme.Fonts.Title,
		TextSize = 16,
		TextColor3 = if isMe then Theme.Colors.Accent:Lerp(Theme.Colors.White, 0.25) else Theme.Colors.Text,
		RichText = false,
		Position = UDim2.fromOffset(46, 0),
		Size = UDim2.new(0.42, -46, 1, 0),
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextWrapped = false,
		Parent = row,
	})
	local detail = STATUS[entry.Status] or entry.Status or ""
	if entry.Time then
		detail = "Ziel " .. Util.FormatTime(entry.Time)
	elseif entry.Progress then
		detail = string.format("%s · %d m", detail, math.max(0, entry.Progress))
	end
	Components.Label({
		Text = (STATUS_ICONS[entry.Status] or "") .. "  " .. detail,
		Font = Theme.Fonts.Medium,
		TextSize = Theme.TextSize.Small - 1,
		TextColor3 = if entry.Status == "Finished" then Theme.Colors.Gold:Lerp(Theme.Colors.White, 0.4) else Theme.Colors.TextDim,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		RichText = false,
		Position = UDim2.new(0.42, 0, 0, 0),
		Size = UDim2.new(0.4, 0, 1, 0),
		Parent = row,
	})
	if entry.RatingChange then
		local positive = entry.RatingChange >= 0
		Components.Pill({
			Text = string.format("%+d", entry.RatingChange),
			Color = if positive then Theme.Colors.Success else Theme.Colors.Danger,
			Size = UDim2.fromOffset(58, 24),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			TextSize = 14,
			Parent = row,
		})
	end
end

-- Auftritt beim Öffnen: Schlagzeile hüpft, Podest wächst, Belohnungen zählen hoch
function Results:_playIntro()
	Components.Pop(self.Headline, 1.35, 0.5)
	local order = { 3, 2, 1 }
	for step, place in order do
		local slot = self.PodiumSlots[place]
		if slot and slot.Slot.Visible then
			slot.Block.Size = UDim2.new(1, -16, 0, 0)
			slot.Avatar.Visible = false
			task.delay(0.12 + step * 0.16, function()
				Components.Tween(slot.Block, 0.45, { Size = UDim2.new(1, -16, 0, slot.Height) }, Enum.EasingStyle.Back)
				slot.Avatar.Visible = true
				Components.Pop(slot.Avatar, 0.3, 0.5)
			end)
		end
	end
	for index, counter in self.Counters do
		local label = counter.Label
		local target = counter.Target
		label.Text = "+0"
		local value = new("NumberValue", { Value = 0 })
		value:GetPropertyChangedSignal("Value"):Connect(function()
			label.Text = "+" .. Util.FormatNumber(math.floor(value.Value + 0.5))
		end)
		task.delay(0.35 + index * 0.15, function()
			local tween = Components.Tween(value, 1.2, { Value = target }, Enum.EasingStyle.Quart)
			tween.Completed:Connect(function()
				label.Text = "+" .. Util.FormatNumber(target)
				value:Destroy()
				Components.Pop(counter.Tile, 1.08, 0.3)
			end)
		end)
	end
	if self.LevelBanner.Visible then
		task.delay(1.7, function()
			Components.Pop(self.LevelBanner, 1.15, 0.45)
		end)
	end
end

return Results
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="74">
              <Properties>
                <string name="Name">Settings</string>
                <string name="Source"><![CDATA[--[[
	Settings  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/UI/Screens/Settings

	Einstellungen (werden im Profil gespeichert), gruppiert in Glas-Karten mit
	Symbol-Kopf:
		Audio: Musik, Soundeffekte
		Steuerung: Gamepad-Empfindlichkeit, Touch-Buttons anzeigen
		Grafik: Kamerawackeln, reduzierte Effekte
		Spiel: Automatisch erneut anstellen
	Rechts eine Übersicht aller Tastenbelegungen mit Tastenkappen, umschaltbar
	zwischen PC, Gamepad und Touch (beim Öffnen ist das aktuelle Gerät gewählt).
]]

local UI = script.Parent.Parent
local Components = require(UI.Components)
local Theme = require(UI.Theme)

local new = Components.new
local rgb = Color3.fromRGB

local Settings = {}
Settings.__index = Settings

-- Tastenbelegung je Gerät: { Aktion, { Tasten … }, Hinweis? }
local CONTROLS = {
	Keyboard = {
		{ "Laufen", { "A", "D", "←", "→" } },
		{ "Springen", { "LEERTASTE", "W", "↑" }, "halten = höher" },
		{ "Greifhaken (halten)", { "E", "J", "MAUS L" } },
		{ "Slide · Air-Dash", { "SHIFT", "S", "↓" } },
		{ "Power-up", { "Q", "F" } },
		{ "Emote", { "G" } },
		{ "Respawn", { "R" } },
		{ "Menü", { "M" } },
	},
	Gamepad = {
		{ "Laufen", { "L-STICK", "D-PAD" } },
		{ "Springen", { "A" } },
		{ "Greifhaken", { "X", "R2" } },
		{ "Slide · Dash", { "B", "L2" } },
		{ "Power-up", { "Y", "R1" } },
		{ "Emote", { "L1" } },
		{ "Menü", { "SELECT" } },
	},
	Touch = {
		{ "Laufen", { "◀", "▶" }, "links unten" },
		{ "Springen", { "SPRUNG" } },
		{ "Greifhaken", { "HAKEN" } },
		{ "Slide · Dash", { "SLIDE" } },
		{ "Power-up", { "ITEM" } },
		{ "Menü", { "MENÜ" }, "oben" },
	},
}

-- Tastenkappe mit „Tiefe“ (dunklere Unterkante)
local function keyCap(parent: Instance, text: string, order: number)
	local width = math.max(30, 16 + 8 * (utf8.len(text) or #text))
	local cap = new("Frame", {
		Name = "Key",
		BackgroundColor3 = rgb(22, 26, 54),
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(width, 28),
		LayoutOrder = order,
		Parent = parent,
	})
	Components.Corner(7).Parent = cap
	local face = new("Frame", {
		Name = "Face",
		BackgroundColor3 = Theme.Colors.White,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, -4),
		Parent = cap,
	})
	Components.Corner(7).Parent = face
	Components.Gradient({ rgb(104, 118, 190), rgb(58, 68, 128) }, 90).Parent = face
	Components.Stroke(Theme.Colors.Black, 1.5, 0.35).Parent = face
	Components.Label({
		Text = text,
		Font = Theme.Fonts.Black,
		TextSize = 12,
		TextColor3 = Theme.Colors.White,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		RichText = false,
		Size = UDim2.fromScale(1, 1),
		Parent = face,
	})
end

function Settings.new(ui)
	local self = setmetatable({}, Settings)
	self.UI = ui
	local modal = Components.Modal({
		Name = "Settings",
		Title = "EINSTELLUNGEN",
		Icon = Theme.Icons.Settings,
		Accent = Theme.Colors.Purple,
		Size = UDim2.fromOffset(900, 580),
		Parent = ui.Root,
	})
	self.Modal = modal
	ui:RegisterModal("Settings", modal)

	local left = new("ScrollingFrame", {
		Name = "Options",
		Size = UDim2.new(0.5, -8, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = Theme.Colors.Stroke,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = modal.Content,
	}, { Components.List(Enum.FillDirection.Vertical, 12) })
	Components.Padding(4, 14, 10, 4).Parent = left

	local state = ui.Ctx.ClientState
	local function save(key, value)
		state:SaveSettings({ [key] = value })
	end
	-- Abschnitts-Karte; contentHeight = Summe der Elementhöhen + Abstände
	local function section(order: number, title: string, icon: string, color: Color3, contentHeight: number)
		local _, panel = Components.Card({
			Name = title,
			Size = UDim2.new(1, 0, 0, 58 + contentHeight + 12),
			BackgroundColor3 = Theme.Colors.PanelDark,
			CornerRadius = 14,
			ShadowOffset = 3,
			ShadowSpread = 4,
			LayoutOrder = order,
			Parent = left,
		})
		local _, glyph = Components.Icon({ Glyph = icon, Color = color, Size = 30, TextSize = 16, Position = UDim2.fromOffset(12, 10), Parent = panel })
		glyph.TextStrokeTransparency = 1
		Components.Heading({
			Text = title,
			TextSize = 17,
			Outline = 1.5,
			RichText = false,
			Position = UDim2.fromOffset(50, 12),
			Size = UDim2.new(1, -62, 0, 26),
			Parent = panel,
		})
		Components.Divider({ Position = UDim2.fromOffset(12, 46), Size = UDim2.new(1, -24, 0, 2), Colors = { color, Theme.Colors.Accent }, Parent = panel })
		local body = new("Frame", {
			Name = "Body",
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(14, 56),
			Size = UDim2.new(1, -28, 0, contentHeight),
			Parent = panel,
		}, { Components.List(Enum.FillDirection.Vertical, 6) })
		return body
	end

	self.Setters = {}
	local audio = section(1, "AUDIO", "🔊", Theme.Colors.Accent, 54 + 6 + 54)
	local _, setMusic = Components.Slider({ Text = "Musik", LayoutOrder = 1, Parent = audio, OnChanged = function(v)
		save("MusicVolume", v)
	end })
	local _, setSfx = Components.Slider({ Text = "Soundeffekte", LayoutOrder = 2, Parent = audio, OnChanged = function(v)
		save("SfxVolume", v)
	end })
	local controls = section(2, "STEUERUNG", "🎮", Theme.Colors.Orange, 54 + 6 + 44)
	local _, setSensitivity = Components.Slider({
		Text = "Gamepad-Empfindlichkeit",
		Min = 0.3,
		Max = 2.5,
		Step = 0.1,
		Value = 1,
		Format = function(v)
			return string.format("%.1f×", v)
		end,
		LayoutOrder = 1,
		Parent = controls,
		OnChanged = function(v)
			save("GamepadSensitivity", v)
		end,
	})
	local _, setTouch = Components.Toggle({ Text = "Touch-Buttons anzeigen", LayoutOrder = 2, Parent = controls, OnChanged = function(v)
		save("TouchControls", v)
	end })
	local graphics = section(3, "GRAFIK & KOMFORT", "✨", Theme.Colors.Accent2, 44 + 6 + 44)
	local _, setShake = Components.Toggle({ Text = "Kamerawackeln", LayoutOrder = 1, Parent = graphics, OnChanged = function(v)
		save("CameraShake", v)
	end })
	local _, setReduced = Components.Toggle({ Text = "Reduzierte Effekte (bessere Leistung)", LayoutOrder = 2, Parent = graphics, OnChanged = function(v)
		save("ReducedEffects", v)
	end })
	local gameplay = section(4, "SPIEL", Theme.Icons.Flag, Theme.Colors.Success, 44)
	local _, setRequeue = Components.Toggle({ Text = "Nach dem Rennen automatisch erneut anstellen", LayoutOrder = 1, Parent = gameplay, OnChanged = function(v)
		save("AutoRequeue", v)
	end })

	self.Apply = function(settings)
		setMusic(settings.MusicVolume or 0.5)
		setSfx(settings.SfxVolume or 0.8)
		setSensitivity(settings.GamepadSensitivity or 1)
		setTouch(settings.TouchControls ~= false)
		setShake(settings.CameraShake ~= false)
		setReduced(settings.ReducedEffects == true)
		setRequeue(settings.AutoRequeue ~= false)
	end

	self:_buildControls(modal.Content)

	modal.OnOpen = function()
		self.Apply(state:GetSettings())
		local device = ui.Ctx.InputController and ui.Ctx.InputController:GetDevice()
		self.SelectControls(if CONTROLS[device] then device else "Keyboard")
	end
	return self
end

-- Tastenübersicht rechts (Tabs PC / Gamepad / Touch)
function Settings:_buildControls(content: Frame)
	local _, panel = Components.Card({
		Name = "Controls",
		Position = UDim2.new(0.5, 8, 0, 0),
		Size = UDim2.new(0.5, -8, 1, -6),
		BackgroundColor3 = Theme.Colors.PanelDark,
		CornerRadius = 16,
		ShadowOffset = 4,
		ShadowSpread = 5,
		Parent = content,
	})
	local _, glyph = Components.Icon({ Glyph = "⌨", Color = Theme.Colors.Accent, Size = 30, TextSize = 16, Position = UDim2.fromOffset(12, 10), Parent = panel })
	glyph.TextStrokeTransparency = 1
	Components.Heading({
		Text = "TASTENBELEGUNG",
		TextSize = 17,
		Outline = 1.5,
		RichText = false,
		Position = UDim2.fromOffset(50, 12),
		Size = UDim2.new(1, -62, 0, 26),
		Parent = panel,
	})
	local pages = {}
	local _, selectTab = Components.Tabs({
		Tabs = {
			{ Name = "Keyboard", Label = "PC", Width = 100 },
			{ Name = "Gamepad", Label = "GAMEPAD", Width = 120 },
			{ Name = "Touch", Label = "TOUCH", Width = 100 },
		},
		Position = UDim2.fromOffset(14, 50),
		Size = UDim2.new(1, -28, 0, 34),
		Parent = panel,
		OnSelect = function(name)
			for pageName, page in pages do
				page.Visible = pageName == name
			end
		end,
	})
	self.SelectControls = selectTab
	for device, rows in CONTROLS do
		local page = new("Frame", {
			Name = device,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(14, 96),
			Size = UDim2.new(1, -28, 1, -104),
			Visible = false,
			Parent = panel,
		}, { Components.List(Enum.FillDirection.Vertical, 6) })
		for index, info in rows do
			local row = new("Frame", {
				BackgroundColor3 = Theme.Colors.White,
				BackgroundTransparency = if index % 2 == 0 then 0.95 else 1,
				BorderSizePixel = 0,
				Size = UDim2.new(1, 0, 0, 38),
				LayoutOrder = index,
				Parent = page,
			})
			Components.Corner(8).Parent = row
			Components.Label({
				Text = info[1],
				Font = Theme.Fonts.Bold,
				TextSize = 14,
				TextWrapped = false,
				RichText = false,
				Position = UDim2.fromOffset(8, if info[3] then 3 else 0),
				Size = UDim2.new(0.42, -8, if info[3] then 0 else 1, if info[3] then 20 else 0),
				Parent = row,
			})
			if info[3] then
				Components.Label({
					Text = info[3],
					Font = Theme.Fonts.Medium,
					TextSize = 11,
					TextColor3 = Theme.Colors.TextDim,
					TextWrapped = false,
					RichText = false,
					Position = UDim2.fromOffset(8, 21),
					Size = UDim2.new(0.42, -8, 0, 14),
					Parent = row,
				})
			end
			local keys = new("Frame", {
				Name = "Keys",
				BackgroundTransparency = 1,
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -6, 0.5, 0),
				Size = UDim2.new(0.58, -6, 0, 28),
				Parent = row,
			}, { Components.List(Enum.FillDirection.Horizontal, 5, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center) })
			for keyIndex, key in info[2] do
				keyCap(keys, key, keyIndex)
			end
		end
		pages[device] = page
	end
	selectTab("Keyboard")
end

function Settings:Start()
	self.Apply(self.UI.Ctx.ClientState:GetSettings())
end

return Settings
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="75">
              <Properties>
                <string name="Name">Stats</string>
                <string name="Source"><![CDATA[--[[
	Stats  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/UI/Screens/Stats

	Spielerstatistiken, Ranked-Saison, tägliche Aufgaben und Erfolge in drei
	Glas-Spalten (Kopf mit Symbol-Blase, Verlaufslinie und Zähler-Chip):
		STATISTIK   Kacheln (Level, Siege, Siegquote), Werte-Zeilen,
		            Ranked-Saison mit Rang-Chip, Bestzeiten je Map
		AUFGABEN    Karten mit Symbol, Belohnungs-Chips (Münze/XP) und
		            Verlaufs-Fortschrittsbalken
		ERFOLGE     Karten mit Pokal (freigeschaltet) bzw. Schloss
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Progression = require(Shared.Progression)
local MapDefinitions = require(Shared.MapDefinitions)
local QuestDefinitions = require(Shared.QuestDefinitions)

local UI = script.Parent.Parent
local Components = require(UI.Components)
local Theme = require(UI.Theme)

local new = Components.new

local Stats = {}
Stats.__index = Stats

function Stats.new(ui)
	local self = setmetatable({}, Stats)
	self.UI = ui
	local modal = Components.Modal({
		Name = "Stats",
		Title = "STATISTIK & AUFGABEN",
		Icon = Theme.Icons.Stats,
		Accent = Theme.Colors.Accent,
		Size = UDim2.fromOffset(1000, 600),
		Parent = ui.Root,
	})
	self.Modal = modal
	ui:RegisterModal("Stats", modal)

	-- Spalte: Glas-Karte mit Kopf (Symbol, Titel, Zähler-Chip) und Scrollbereich
	local function column(index: number, title: string, icon: string, color: Color3)
		local _, panel = Components.Card({
			Name = title,
			Position = UDim2.new((index - 1) / 3, (index - 1) * 4, 0, 0),
			Size = UDim2.new(1 / 3, -8, 1, -6),
			BackgroundColor3 = Theme.Colors.PanelDark,
			CornerRadius = 16,
			ShadowOffset = 4,
			ShadowSpread = 5,
			Parent = modal.Content,
		})
		local _, glyph = Components.Icon({ Glyph = icon, Color = color, Size = 32, TextSize = 17, Position = UDim2.fromOffset(12, 9), Parent = panel })
		glyph.TextStrokeTransparency = 1
		Components.Heading({
			Text = title,
			TextSize = 18,
			TextScaled = true,
			MaxTextSize = 18,
			Outline = 1.5,
			RichText = false,
			Position = UDim2.fromOffset(52, 11),
			Size = UDim2.new(1, -140, 0, 28),
			Parent = panel,
		})
		local pill, pillLabel = Components.Pill({
			Text = "",
			Color = color,
			Size = UDim2.fromOffset(70, 22),
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12, 0, 14),
			TextSize = 12,
			Parent = panel,
		})
		pill.Visible = false
		Components.Divider({ Position = UDim2.fromOffset(12, 48), Size = UDim2.new(1, -24, 0, 2), Colors = { color, Theme.Colors.Accent2 }, Parent = panel })
		local scroll = new("ScrollingFrame", {
			Position = UDim2.fromOffset(10, 58),
			Size = UDim2.new(1, -16, 1, -66),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 5,
			ScrollBarImageColor3 = Theme.Colors.Stroke,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			Parent = panel,
		}, { Components.List(Enum.FillDirection.Vertical, 6) })
		return scroll, pill, pillLabel
	end
	self.StatsList = column(1, "STATISTIK", Theme.Icons.Stats, Theme.Colors.Accent)
	self.QuestList, self.QuestPill, self.QuestCount = column(2, "TÄGLICHE AUFGABEN", Theme.Icons.Training, Theme.Colors.Success)
	self.AchievementList, self.AchievementPill, self.AchievementCount = column(3, "ERFOLGE", Theme.Icons.Leaderboard, Theme.Colors.Gold)

	modal.OnOpen = function()
		self:_render()
	end
	return self
end

function Stats:Start()
	self.UI.Ctx.ClientState.ProfileChanged:Connect(function()
		if self.Modal.IsOpen() then
			self:_render()
		end
	end)
end

local function clear(container: Instance)
	for _, child in container:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

-- Werte-Zeile (Beschriftung links, Wert rechts; jede zweite leicht hinterlegt).
-- indent: zusätzlicher Abstand links (Platz für einen Farbpunkt)
function Stats:_statRow(order: number, label: string, value: string, color: Color3?, indent: number?)
	local row = new("Frame", {
		BackgroundColor3 = Theme.Colors.White,
		BackgroundTransparency = if order % 2 == 0 then 0.95 else 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, -6, 0, 26),
		LayoutOrder = order,
		Parent = self.StatsList,
	})
	Components.Corner(6).Parent = row
	Components.Label({
		Text = label,
		Font = Theme.Fonts.Medium,
		TextColor3 = Theme.Colors.TextDim,
		TextSize = Theme.TextSize.Small - 1,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		RichText = false,
		Position = UDim2.fromOffset(8 + (indent or 0), 0),
		Size = UDim2.new(0.62, -8 - (indent or 0), 1, 0),
		Parent = row,
	})
	Components.Label({
		Text = value,
		Font = Theme.Fonts.Title,
		TextSize = 16,
		TextColor3 = color or Theme.Colors.Text,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextWrapped = false,
		RichText = false,
		Position = UDim2.fromScale(0.62, 0),
		Size = UDim2.new(0.38, -8, 1, 0),
		Parent = row,
	})
	return row
end

-- Abschnittsüberschrift mit Verlaufslinie und optionalem Chip
function Stats:_section(order: number, text: string, color: Color3, chipText: string?, chipColor: Color3?)
	local frame = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -6, 0, 36), LayoutOrder = order, Parent = self.StatsList })
	Components.Label({
		Text = text,
		Font = Theme.Fonts.Title,
		TextSize = 15,
		TextColor3 = color,
		TextWrapped = false,
		RichText = false,
		TextStrokeTransparency = 0.6,
		TextStrokeColor3 = Theme.Colors.Shadow,
		Position = UDim2.fromOffset(4, 10),
		Size = UDim2.new(1, -100, 0, 20),
		Parent = frame,
	})
	if chipText then
		Components.Pill({
			Text = chipText,
			Color = chipColor or color,
			Size = UDim2.fromOffset(96, 22),
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -4, 0, 9),
			TextSize = 12,
			Parent = frame,
		})
	end
	Components.Divider({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 2), Colors = { color, color }, Parent = frame })
end

-- Drei Kacheln oben in der Statistik-Spalte
function Stats:_heroTiles(tiles)
	local frame = new("Frame", { Name = "Tiles", BackgroundTransparency = 1, Size = UDim2.new(1, -6, 0, 74), LayoutOrder = 0, Parent = self.StatsList }, {
		Components.List(Enum.FillDirection.Horizontal, 6),
	})
	for index, tile in tiles do
		local box = new("Frame", {
			Size = UDim2.new(1 / 3, -4, 1, 0),
			BackgroundColor3 = Theme.Colors.White,
			BorderSizePixel = 0,
			LayoutOrder = index,
			Parent = frame,
		})
		Components.Corner(12).Parent = box
		Components.Gradient({ tile.Color:Lerp(Theme.Colors.Panel, 0.55), tile.Color:Lerp(Theme.Colors.PanelDark, 0.85) }, 90).Parent = box
		Components.Stroke(tile.Color, 1.5, 0.35).Parent = box
		Components.Heading({
			Text = tile.Value,
			TextSize = 24,
			TextScaled = true,
			MaxTextSize = 24,
			TextColor3 = tile.Color:Lerp(Theme.Colors.White, 0.3),
			TextXAlignment = Enum.TextXAlignment.Center,
			Outline = 2,
			RichText = false,
			Position = UDim2.fromOffset(4, 10),
			Size = UDim2.new(1, -8, 0, 30),
			Parent = box,
		})
		Components.Label({
			Text = tile.Label,
			Font = Theme.Fonts.Title,
			TextSize = 11,
			TextColor3 = Theme.Colors.TextDim,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			RichText = false,
			Position = UDim2.fromOffset(2, 46),
			Size = UDim2.new(1, -4, 0, 16),
			Parent = box,
		})
	end
end

-- Kleiner Belohnungs-Chip: Münze + Zahl
local function coinChip(parent: Instance, coins: number, position: UDim2, anchor: Vector2?)
	local chip = new("Frame", {
		Name = "CoinChip",
		BackgroundTransparency = 1,
		AnchorPoint = anchor or Vector2.zero,
		Position = position,
		Size = UDim2.fromOffset(70, 18),
		Parent = parent,
	}, { Components.List(Enum.FillDirection.Horizontal, 4, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center) })
	Components.CoinIcon(16, { Parent = chip })
	Components.Label({
		Text = "+" .. Util.FormatNumber(coins),
		Font = Theme.Fonts.Title,
		TextSize = 14,
		TextColor3 = Theme.Colors.Gold,
		TextWrapped = false,
		RichText = false,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 18),
		Parent = chip,
	})
	return chip
end

function Stats:_render()
	local profile = self.UI.Ctx.ClientState.Profile
	if not profile then
		return
	end
	clear(self.StatsList)
	clear(self.QuestList)
	clear(self.AchievementList)

	local s = profile.Stats
	self:_heroTiles({
		{ Label = "LEVEL", Value = tostring(profile.Level), Color = Theme.Colors.Accent },
		{ Label = "SIEGE", Value = Util.FormatNumber(s.Wins), Color = Theme.Colors.Gold },
		{ Label = "SIEGQUOTE", Value = if s.Races > 0 then string.format("%d%%", math.floor(s.Wins / s.Races * 100 + 0.5)) else "–", Color = Theme.Colors.Accent2 },
	})
	local order = 0
	local function add(label, value, color)
		order += 1
		self:_statRow(order, label, value, color)
	end
	local function section(text, color, chipText, chipColor)
		order += 1
		self:_section(order, text, color, chipText, chipColor)
	end
	add("Gesamt-XP", Util.FormatNumber(profile.TotalXP), Theme.Colors.XP:Lerp(Theme.Colors.White, 0.3))
	add("Coins", Util.FormatNumber(profile.Coins), Theme.Colors.Gold)
	add("Rennen", Util.FormatNumber(s.Races))
	add("Top 3", Util.FormatNumber(s.Top3))
	add("Ziel erreicht", Util.FormatNumber(s.Finishes))
	add("Ausgeschieden", Util.FormatNumber(s.Eliminated))
	add("Greifhaken (Rennen)", Util.FormatNumber(s.Grapples))
	add("Power-ups (Rennen)", Util.FormatNumber(s.PowerUps))
	add("Strecke gesamt", Util.FormatNumber(s.Distance) .. " m")
	local ranked = profile.Ranked
	local tier = Progression.GetTier(ranked.Rating)
	section(Theme.Icons.Ranked .. " RANKED · SAISON " .. tostring(ranked.Season or Config.Ranked.Season), Theme.Colors.Gold, string.upper(tier.Name), tier.Color)
	add("Rang", tier.Name, tier.Color)
	add("Rating", tostring(ranked.Rating), tier.Color)
	add("Höchstwert", tostring(ranked.Peak))
	add("Ranked-Spiele / Siege", string.format("%d / %d", ranked.Games, ranked.Wins))
	section("⏱ BESTZEITEN", Theme.Colors.Accent)
	for _, mapId in MapDefinitions.Order do
		local definition = MapDefinitions.Maps[mapId]
		local best = s.BestTimes and s.BestTimes[mapId]
		local accent = definition.Theme and definition.Theme.Accent or Theme.Colors.Accent
		order += 1
		local row = self:_statRow(order, definition.Name, if best then Util.FormatTime(best) else "–", if best then Theme.Colors.Text else Theme.Colors.TextDim, 20)
		-- Farbpunkt der Map vor dem Namen
		local dot = new("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 8, 0.5, 0),
			Size = UDim2.fromOffset(12, 12),
			BackgroundColor3 = accent,
			BorderSizePixel = 0,
			Parent = row,
		})
		new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = dot })
		Components.Stroke(Theme.Colors.White, 1.5, 0.4).Parent = dot
	end
	if profile.Persistent == false then
		add("Speichern", "Studio: aus", Theme.Colors.Warning)
	end

	-- Aufgaben
	local done, total = 0, 0
	for index, entry in profile.Quests and profile.Quests.List or {} do
		local quest = QuestDefinitions.DailyLookup[entry.Id]
		if quest then
			total += 1
			if entry.Done then
				done += 1
			end
			self:_questCard(index, quest, entry)
		end
	end
	self.QuestPill.Visible = total > 0
	self.QuestCount.Text = string.format("%d / %d", done, total)
	Components.Label({
		Text = Theme.Icons.Info .. "  Neue Aufgaben gibt es jeden Tag (UTC). Belohnungen werden automatisch gutgeschrieben.",
		Font = Theme.Fonts.Medium,
		TextSize = Theme.TextSize.Tiny,
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, -6, 0, 34),
		LayoutOrder = 99,
		Parent = self.QuestList,
	})

	-- Erfolge
	local unlockedCount = 0
	for index, achievement in QuestDefinitions.Achievements do
		local unlocked = profile.Achievements and profile.Achievements[achievement.Id] == true
		if unlocked then
			unlockedCount += 1
		end
		self:_achievementCard(index, achievement, unlocked)
	end
	self.AchievementPill.Visible = true
	self.AchievementCount.Text = string.format("%d / %d", unlockedCount, #QuestDefinitions.Achievements)
end

function Stats:_questCard(index: number, quest, entry)
	local done = entry.Done == true
	local color = if done then Theme.Colors.Success else Theme.Colors.Accent
	local card = Components.Panel({
		Size = UDim2.new(1, -6, 0, 96),
		BackgroundColor3 = if done then Theme.Colors.Success:Lerp(Theme.Colors.Panel, 0.8) else Theme.Colors.Panel,
		StrokeColor = if done then Theme.Colors.Success else Theme.Colors.Stroke,
		StrokeTransparency = if done then 0.05 else 0.4,
		CornerRadius = 12,
		LayoutOrder = index,
		Parent = self.QuestList,
	})
	local _, glyph = Components.Icon({
		Glyph = if done then Theme.Icons.Check else Theme.Icons.Training,
		Color = color,
		Size = 38,
		TextSize = if done then 18 else 20,
		Position = UDim2.fromOffset(10, 10),
		Parent = card,
	})
	if not done then
		glyph.TextStrokeTransparency = 1
	end
	Components.Label({
		Text = quest.Name,
		Font = Theme.Fonts.Bold,
		TextSize = Theme.TextSize.Small,
		TextScaled = true,
		MaxTextSize = Theme.TextSize.Small,
		RichText = false,
		Position = UDim2.fromOffset(56, 8),
		Size = UDim2.new(1, -64, 0, 20),
		Parent = card,
	})
	-- Belohnungs-Chips
	local rewards = new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(56, 32),
		Size = UDim2.new(1, -64, 0, 20),
		Parent = card,
	}, { Components.List(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center) })
	coinChip(rewards, quest.Coins, UDim2.new())
	Components.Pill({ Text = string.format("+%d XP", quest.XP), Color = Theme.Colors.XP, Size = UDim2.fromOffset(64, 20), TextSize = 12, Parent = rewards })
	local _, set = Components.ProgressBar({
		Position = UDim2.fromOffset(10, 64),
		Size = UDim2.new(1, -110, 0, 14),
		BackgroundColor = Theme.Colors.Shadow,
		BackgroundTransparency = 0.3,
		Color = color,
		Gradient = if done then Theme.Gradients.Success else Theme.Gradients.Play,
		CornerRadius = 7,
		Parent = card,
	})
	set(entry.Progress / quest.Goal)
	Components.Label({
		Text = if done then Theme.Icons.Check .. " ERLEDIGT" else string.format("%s / %s", Util.FormatNumber(entry.Progress), Util.FormatNumber(quest.Goal)),
		Font = Theme.Fonts.Title,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextWrapped = false,
		RichText = false,
		TextColor3 = if done then Theme.Colors.Success else Theme.Colors.Text,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 61),
		Size = UDim2.fromOffset(92, 20),
		Parent = card,
	})
end

function Stats:_achievementCard(index: number, achievement, unlocked: boolean)
	local card = Components.Panel({
		Size = UDim2.new(1, -6, 0, 68),
		BackgroundColor3 = if unlocked then Theme.Colors.Gold:Lerp(Theme.Colors.Panel, 0.82) else Theme.Colors.Panel,
		StrokeColor = if unlocked then Theme.Colors.Gold else Theme.Colors.Stroke,
		StrokeTransparency = if unlocked then 0.05 else 0.45,
		CornerRadius = 12,
		LayoutOrder = index,
		Parent = self.AchievementList,
	})
	local _, glyph = Components.Icon({
		Glyph = if unlocked then Theme.Icons.Leaderboard else Theme.Icons.Lock,
		Color = if unlocked then Theme.Colors.Gold else Theme.Colors.PanelLight,
		Size = 42,
		TextSize = 21,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		Parent = card,
	})
	glyph.TextStrokeTransparency = 1
	glyph.TextTransparency = if unlocked then 0 else 0.35
	Components.Label({
		Text = achievement.Name,
		Font = Theme.Fonts.Bold,
		TextSize = Theme.TextSize.Small,
		TextScaled = true,
		MaxTextSize = Theme.TextSize.Small,
		TextColor3 = if unlocked then Theme.Colors.Gold:Lerp(Theme.Colors.White, 0.25) else Theme.Colors.Text,
		RichText = false,
		Position = UDim2.fromOffset(62, 8),
		Size = UDim2.new(1, -140, 0, 20),
		Parent = card,
	})
	coinChip(card, achievement.Coins, UDim2.new(1, -10, 0, 9), Vector2.new(1, 0))
	Components.Label({
		Text = achievement.Description,
		Font = Theme.Fonts.Medium,
		TextSize = Theme.TextSize.Tiny,
		TextColor3 = Theme.Colors.TextDim,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(62, 30),
		Size = UDim2.new(1, -72, 0, 32),
		Parent = card,
	})
end

return Stats
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="76">
              <Properties>
                <string name="Name">TopBar</string>
                <string name="Source"><![CDATA[--[[
	TopBar  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/UI/Screens/TopBar

	Statusleiste oben links (außerhalb von Rennen sichtbar):
		- Level-Plakette mit XP-Ring (kreisförmiger Fortschritt)
		- Spielername, Ranked-Chip (Stufe + Punkte in Stufenfarbe)
		- XP-Balken mit Farbverlauf und Zahlen
		- Coin-Anzeige mit Münz-Symbol, hochzählender Animation,
		  schwebendem „+N“ und Shop-Abkürzung (+)
	Liegt unterhalb der Roblox-Topbar (y ≥ 56). Im Rennen ausgeblendet –
	dort gehört der Platz Timer und Fortschrittsbalken.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Progression = require(Shared.Progression)
local Util = require(Shared.Util)

local UI = script.Parent.Parent
local Components = require(UI.Components)
local Theme = require(UI.Theme)

local new = Components.new
local player = Players.LocalPlayer

local COIN_COUNT_TIME = 0.8 -- Sekunden für das Hochzählen der Coins

local TopBar = {}
TopBar.__index = TopBar

function TopBar.new(ui)
	local self = setmetatable({}, TopBar)
	self.UI = ui
	self.DisplayedCoins = nil
	self.DisplayedLevel = nil
	self.CoinAnim = nil

	local frame = Components.Panel({
		Name = "TopBar",
		Position = UDim2.fromOffset(16, 60),
		Size = UDim2.fromOffset(392, 76),
		BackgroundColor3 = Theme.Colors.Panel,
		BackgroundTransparency = 0.08,
		StrokeColor = Theme.Colors.Stroke,
		CornerRadius = 18,
		ZIndex = 2,
		Shadow = true,
		Parent = ui.Root,
	})
	self.Frame = frame

	-- Level-Plakette mit XP-Ring
	local ring, setRing, inner = Components.Ring({
		Name = "LevelRing",
		Size = 64,
		Thickness = 5,
		Color = Theme.Colors.XP,
		TrackColor = Theme.Colors.Shadow,
		InnerColor = Theme.Colors.White,
		Position = UDim2.fromOffset(8, 6),
		ZIndex = 3,
		Parent = frame,
	})
	self.Ring = ring
	self.SetRing = setRing
	Components.Gradient(Theme.Gradients.Accent, 135).Parent = inner
	Components.Stroke(Theme.Colors.Shadow, 1.5, 0.3).Parent = inner
	Components.Label({
		Text = "LV",
		Font = Theme.Fonts.Title,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = Theme.Colors.White,
		TextTransparency = 0.15,
		Size = UDim2.new(1, 0, 0, 12),
		Position = UDim2.fromOffset(0, 7),
		ZIndex = 3,
		Parent = inner,
	})
	self.LevelLabel = Components.Label({
		Text = "1",
		Font = Theme.Fonts.Title,
		TextSize = 24,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = Theme.Colors.White,
		TextWrapped = false,
		Outline = 1.5,
		OutlineColor = Color3.fromRGB(0, 60, 130),
		Size = UDim2.new(1, 0, 0, 26),
		Position = UDim2.fromOffset(0, 17),
		ZIndex = 3,
		Parent = inner,
	})

	self.NameLabel = Components.Label({
		Text = player.DisplayName,
		Font = Theme.Fonts.Title,
		Position = UDim2.fromOffset(82, 8),
		Size = UDim2.fromOffset(176, 24),
		TextSize = 19,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextWrapped = false,
		RichText = false,
		Outline = 1.5,
		OutlineTransparency = 0.4,
		ZIndex = 3,
		Parent = frame,
	})

	-- Ranked-Chip (Stufe · Punkte)
	local tierPill, tierLabel = Components.Pill({
		Name = "Tier",
		Text = "",
		Color = Theme.Colors.Accent,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 9),
		Size = UDim2.fromOffset(118, 22),
		TextSize = 13,
		ZIndex = 3,
		Parent = frame,
	})
	self.TierPill = tierPill
	self.TierLabel = tierLabel

	local _, setXP = Components.ProgressBar({
		Name = "XPBar",
		Position = UDim2.fromOffset(82, 37),
		Size = UDim2.fromOffset(298, 14),
		BackgroundColor = Theme.Colors.Shadow,
		BackgroundTransparency = 0.2,
		Color = Theme.Colors.XP,
		Gradient = { Theme.Gradients.XP[2], Theme.Colors.Accent },
		CornerRadius = 7,
		Parent = frame,
	})
	self.SetXP = setXP
	self.XPLabel = Components.Label({
		Text = "0 / 100 XP",
		Position = UDim2.fromOffset(82, 53),
		Size = UDim2.fromOffset(298, 16),
		TextSize = Theme.TextSize.Tiny - 1,
		Font = Theme.Fonts.Bold,
		TextColor3 = Theme.Colors.TextDim,
		TextWrapped = false,
		ZIndex = 3,
		Parent = frame,
	})

	-- Coins
	local coins = Components.Panel({
		Name = "Coins",
		Position = UDim2.fromOffset(420, 72),
		Size = UDim2.fromOffset(164, 52),
		BackgroundColor3 = Theme.Colors.PanelDark,
		BackgroundTransparency = 0.08,
		StrokeColor = Theme.Colors.Gold,
		StrokeThickness = 2,
		CornerRadius = 26,
		ZIndex = 2,
		Shadow = true,
		Parent = ui.Root,
	})
	self.CoinPanel = coins
	self.CoinIcon = Components.CoinIcon(36, { Position = UDim2.fromOffset(8, 8), ZIndex = 3, Parent = coins })
	self.CoinLabel = Components.Label({
		Text = "0",
		Position = UDim2.fromOffset(50, 0),
		Size = UDim2.new(1, -94, 1, 0),
		TextSize = 24,
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.Gold,
		TextWrapped = false,
		TextScaled = true,
		MaxTextSize = 24,
		Outline = 1.5,
		OutlineColor = Color3.fromRGB(90, 46, 0),
		OutlineTransparency = 0.2,
		ZIndex = 3,
		Parent = coins,
	})
	new("UIPadding", { PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12), Parent = self.CoinLabel })
	local shopButton = Components.Button({
		Name = "ShopShortcut",
		Text = "+",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -9, 0.5, 0),
		Size = UDim2.fromOffset(34, 34),
		Color = Theme.Colors.Success,
		TextColor = Theme.Colors.White,
		TextSize = 24,
		CornerRadius = 17,
		ZIndex = 3,
		OnClick = function()
			local catalog = ui.Screens.Catalog
			if catalog then
				catalog:Open("Shop")
			end
		end,
	})
	shopButton.Parent = coins
	return self
end

function TopBar:Start()
	local state = self.UI.Ctx.ClientState
	state.ProfileChanged:Connect(function(profile)
		self:_render(profile)
	end)
	if state.Profile then
		self:_render(state.Profile)
	end
	RunService.Heartbeat:Connect(function()
		-- Im Rennen ausblenden: dort gehört der Platz Timer und Fortschrittsbalken
		local inRace = state:IsInRace() or self.UI.Ctx.CameraController:GetSpectate() ~= nil
		self.Frame.Visible = not inRace
		self.CoinPanel.Visible = not inRace
		self:_stepCoins()
	end)
end

-- Coins hochzählen (nur während einer laufenden Animation, sonst nichts zu tun)
function TopBar:_stepCoins()
	local anim = self.CoinAnim
	if not anim then
		return
	end
	local t = math.clamp((os.clock() - anim.Start) / COIN_COUNT_TIME, 0, 1)
	local eased = 1 - (1 - t) ^ 3
	local value = anim.From + (anim.To - anim.From) * eased
	self.CoinLabel.Text = Util.FormatNumber(math.floor(value + 0.5))
	if t >= 1 then
		self.CoinAnim = nil
	end
end

function TopBar:_floatText(text: string, color: Color3)
	local label = Components.Label({
		Text = text,
		Font = Theme.Fonts.Title,
		TextSize = 22,
		TextColor3 = color,
		TextWrapped = false,
		Outline = 1.5,
		OutlineTransparency = 0.2,
		Position = UDim2.new(0, 46, 1, 0),
		Size = UDim2.fromOffset(120, 26),
		ZIndex = 4,
		Parent = self.CoinPanel,
	})
	local stroke = label:FindFirstChild("TextStroke")
	Components.Tween(label, 1.3, { Position = UDim2.new(0, 46, 1, 34), TextTransparency = 1 })
	if stroke then
		Components.Tween(stroke, 1.3, { Transparency = 1 })
	end
	task.delay(1.4, function()
		label:Destroy()
	end)
end

function TopBar:_render(profile)
	local level, into, needed = Progression.FromTotalXP(profile.TotalXP or 0)
	self.LevelLabel.Text = tostring(level)
	if self.DisplayedLevel and level > self.DisplayedLevel then
		Components.Pop(self.Ring, 1.3, 0.5)
	end
	self.DisplayedLevel = level
	if needed > 0 then
		self.SetXP(into / needed, 0.4)
		self.SetRing(into / needed, 0.5)
		self.XPLabel.Text = string.format("%s / %s XP  ·  nächstes Level %d", Util.FormatNumber(into), Util.FormatNumber(needed), level + 1)
	else
		self.SetXP(1, 0.4)
		self.SetRing(1, 0.5)
		self.XPLabel.Text = "Maximales Level erreicht"
	end

	local coins = profile.Coins or 0
	if self.DisplayedCoins and coins ~= self.DisplayedCoins then
		local diff = coins - self.DisplayedCoins
		self:_floatText((if diff > 0 then "+" else "") .. Util.FormatNumber(diff), if diff > 0 then Theme.Colors.Gold else Theme.Colors.Danger)
		self.CoinAnim = { From = self.DisplayedCoins, To = coins, Start = os.clock() }
		Components.Pop(self.CoinIcon, 1.25, 0.4)
	else
		self.CoinLabel.Text = Util.FormatNumber(coins)
	end
	self.DisplayedCoins = coins

	local rating = profile.Ranked and profile.Ranked.Rating or 1000
	local tier = Progression.GetTier(rating)
	self.TierLabel.Text = string.format("%s · %d", string.upper(tier.Name), rating)
	self.TierLabel.TextColor3 = tier.Color:Lerp(Theme.Colors.White, 0.35)
	self.TierPill.BackgroundColor3 = tier.Color
	local border = self.TierPill:FindFirstChild("Border")
	if border then
		border.Color = tier.Color
	end
end

return TopBar
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="77">
              <Properties>
                <string name="Name">TouchControls</string>
                <string name="Source"><![CDATA[--[[
	TouchControls  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/UI/Screens/TouchControls

	Virtuelle Steuerung für Smartphones und Tablets (Multi-Touch):
		links:  ◀  ▶   (Bewegung)
		rechts: SPRUNG (groß), HAKEN, SLIDE, ITEM – im Bogen um den Daumen
	Runde Verlaufs-Buttons mit Symbol + Beschriftung; beim Drücken werden
	sie kleiner und kräftiger. Die rechte Gruppe lässt den Item-Slot des
	RaceHud (rechts, y 410–520 auf Touch-Geräten) frei.
	Die Buttons speisen den zentralen InputController (SetVirtualAxis /
	SetVirtualButton). Abschaltbar in den Einstellungen.
]]

local UserInputService = game:GetService("UserInputService")

local UI = script.Parent.Parent
local Components = require(UI.Components)
local Theme = require(UI.Theme)

local new = Components.new

local IDLE_TRANSPARENCY = 0.35
local PRESSED_TRANSPARENCY = 0.05

local TouchControls = {}
TouchControls.__index = TouchControls

function TouchControls.new(ui)
	local self = setmetatable({}, TouchControls)
	self.UI = ui
	self.Active = {} -- [InputObject] = action
	self.AxisState = { Left = false, Right = false }
	self.Pressed = {} -- [action] = true, wenn optisch gedrückt
	self.Visuals = {} -- [action] = { Scale, Stroke, Glyph }

	local root = new("Frame", {
		Name = "TouchControls",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		Parent = ui.Root,
	})
	self.Root = root

	local function touchButton(action: string, glyph: string, caption: string?, size: number, position: UDim2, color: Color3)
		local top, bottom = Theme.GradientFor(color)
		local button = new("TextButton", {
			Name = action,
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = Theme.Colors.White,
			BackgroundTransparency = IDLE_TRANSPARENCY,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = position,
			Size = UDim2.fromOffset(size, size),
			Parent = root,
		})
		new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = button })
		Components.Gradient({ top, bottom }, 90).Parent = button
		local stroke = Components.Stroke(Theme.Colors.White, 3, 0.45)
		stroke.Parent = button
		local scale = new("UIScale", { Parent = button })
		-- Innerer Glanzring
		local ring = new("Frame", {
			Name = "InnerRing",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(1, -14, 1, -14),
			BackgroundTransparency = 1,
			Parent = button,
		})
		new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = ring })
		Components.Stroke(Theme.Colors.White, 1.5, 0.8).Parent = ring

		local glyphLabel = Components.Label({
			Name = "Glyph",
			Text = glyph,
			Font = Theme.Fonts.Title,
			TextSize = math.floor(size * (if caption then 0.34 else 0.42)),
			TextColor3 = Theme.Colors.White,
			TextStrokeTransparency = 0.45,
			TextStrokeColor3 = bottom:Lerp(Theme.Colors.Black, 0.6),
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Center,
			TextWrapped = false,
			RichText = false,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, if caption then 0.42 else 0.5),
			Size = UDim2.fromScale(0.8, 0.5),
			Parent = button,
		})
		if caption then
			Components.Label({
				Name = "Caption",
				Text = caption,
				Font = Theme.Fonts.Title,
				TextSize = if size > 120 then 17 else 13,
				TextColor3 = Theme.Colors.White,
				TextStrokeTransparency = 0.4,
				TextStrokeColor3 = bottom:Lerp(Theme.Colors.Black, 0.6),
				TextXAlignment = Enum.TextXAlignment.Center,
				TextWrapped = false,
				RichText = false,
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.fromScale(0.5, 0.66),
				Size = UDim2.new(1, -16, 0, 18),
				Parent = button,
			})
		end
		self.Visuals[action] = { Scale = scale, Stroke = stroke, Glyph = glyphLabel }

		button.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				self.Active[input] = action
				self:_apply()
			end
		end)
		return button
	end

	-- Positionen relativ zu den unteren Ecken (logische Referenzpixel)
	self.Buttons = {
		touchButton("Left", Theme.Icons.Left, nil, 120, UDim2.new(0, 110, 1, -130), Theme.Colors.PanelLight),
		touchButton("Right", Theme.Icons.Right, nil, 120, UDim2.new(0, 250, 1, -130), Theme.Colors.PanelLight),
		touchButton("Jump", Theme.Icons.Up, "SPRUNG", 150, UDim2.new(1, -130, 1, -130), Theme.Colors.Accent),
		touchButton("Grapple", Theme.Icons.Hook, "HAKEN", 110, UDim2.new(1, -295, 1, -105), Theme.Colors.Accent2),
		touchButton("Slide", Theme.Icons.Down, "SLIDE", 100, UDim2.new(1, -185, 1, -305), Theme.Colors.Purple),
		touchButton("Item", Theme.Icons.Star, "ITEM", 96, UDim2.new(1, -305, 1, -255), Theme.Colors.Gold),
	}
	return self
end

-- Optischer Zustand eines Buttons (nur bei Änderung tweenen)
function TouchControls:_setPressed(button: TextButton, pressed: boolean)
	local action = button.Name
	if (self.Pressed[action] == true) == pressed then
		return
	end
	self.Pressed[action] = pressed or nil
	local visual = self.Visuals[action]
	Components.Tween(button, 0.08, { BackgroundTransparency = if pressed then PRESSED_TRANSPARENCY else IDLE_TRANSPARENCY })
	if visual then
		Components.Tween(visual.Scale, if pressed then 0.07 else 0.2, { Scale = if pressed then 0.88 else 1 }, if pressed then Enum.EasingStyle.Quad else Enum.EasingStyle.Back)
		Components.Tween(visual.Stroke, 0.08, { Transparency = if pressed then 0 else 0.45 })
	end
end

function TouchControls:_apply()
	local input = self.UI.Ctx.InputController
	local held = {}
	for _, action in self.Active do
		held[action] = true
	end
	local axis = (if held.Right then 1 else 0) - (if held.Left then 1 else 0)
	input:SetVirtualAxis(axis)
	for _, action in { "Jump", "Grapple", "Slide", "Item" } do
		input:SetVirtualButton(action, held[action] == true)
	end
	for _, button in self.Buttons do
		self:_setPressed(button, held[button.Name] == true)
	end
end

function TouchControls:Start()
	UserInputService.InputEnded:Connect(function(input)
		if self.Active[input] then
			self.Active[input] = nil
			self:_apply()
		end
	end)
	local state = self.UI.Ctx.ClientState
	local function refresh()
		local enabled = UserInputService.TouchEnabled and state:GetSetting("TouchControls") ~= false
		local lobbyMenu = self.UI.Screens.LobbyMenu
		local menuOpen = lobbyMenu ~= nil and lobbyMenu:IsOpen()
		self.Root.Visible = enabled and not menuOpen and not self.UI:AnyModalOpen()
		if not self.Root.Visible and next(self.Active) then
			table.clear(self.Active)
			self:_apply()
		end
	end
	state.SettingsChanged:Connect(refresh)
	game:GetService("RunService").Heartbeat:Connect(refresh)
	refresh()
end

return TouchControls
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="78">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--[[
	Theme  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/UI/Theme

	Designsystem der Benutzeroberfläche: Farben, Verläufe, Schriften,
	Abstände und Symbole. Alle Screens verwenden ausschließlich diese Werte.

	Stil: verspielt-modernes Racing-Design – dunkle „Glas“-Panels mit leichtem
	Verlauf und hellem Rand, kräftige Verlaufs-Buttons, runde Überschriften
	(FredokaOne) mit Textkontur, klare Fließtexte (Gotham).

	Layout-Prinzip: Die gesamte UI ist für eine Referenzauflösung von
	1280 × 720 entworfen und wird über ein UIScale am Wurzel-Frame auf jede
	Bildschirmgröße (PC, Tablet, Smartphone) skaliert.

	Tabellen:
		Colors      Grundfarben (Schlüssel bleiben stabil, Werte = Stil)
		Gradients   { hell, dunkel } – Verlaufspaare je Farbname
		Fonts       Title/Display/Button (verspielt), Bold/Medium/Body/Black (Gotham)
		TextSize    Huge … Tiny
		Icons       Unicode-/Emoji-Symbole für Buttons, Karten und Hinweise
		Corner, SmallCorner, Padding, ReferenceSize
	Funktion:
		Theme.GradientFor(color) -> hell, dunkel   (bekannte Farbe -> Verlaufspaar,
		                                           sonst automatisch aufgehellt/abgedunkelt)
]]

local rgb = Color3.fromRGB

local Theme = {}

Theme.ReferenceSize = Vector2.new(1280, 720)

Theme.Colors = {
	Background = rgb(9, 11, 26),
	Panel = rgb(30, 36, 72),
	PanelLight = rgb(54, 64, 116),
	PanelDark = rgb(16, 19, 40),
	Stroke = rgb(96, 114, 196),
	Accent = rgb(0, 208, 255),
	Accent2 = rgb(255, 61, 154),
	Success = rgb(38, 222, 118),
	Warning = rgb(255, 186, 18),
	Danger = rgb(255, 64, 94),
	Text = rgb(246, 248, 255),
	TextDim = rgb(166, 178, 222),
	Gold = rgb(255, 204, 46),
	XP = rgb(152, 102, 255),
	Black = rgb(0, 0, 0),
	White = rgb(255, 255, 255),
	-- Ergänzungen des Designsystems
	Purple = rgb(160, 92, 255),
	Orange = rgb(255, 136, 36),
	Shadow = rgb(3, 4, 14),
	TextDark = rgb(14, 18, 40),
}

-- Verlaufspaare { oben/links (hell), unten/rechts (dunkel) }
Theme.Gradients = {
	Accent = { rgb(70, 234, 255), rgb(0, 128, 255) },
	Accent2 = { rgb(255, 116, 198), rgb(224, 22, 118) },
	Success = { rgb(116, 248, 140), rgb(14, 184, 96) },
	Warning = { rgb(255, 224, 76), rgb(255, 146, 0) },
	Danger = { rgb(255, 116, 122), rgb(220, 26, 70) },
	Gold = { rgb(255, 234, 100), rgb(255, 154, 18) },
	XP = { rgb(198, 136, 255), rgb(104, 66, 255) },
	Purple = { rgb(190, 124, 255), rgb(118, 56, 238) },
	Orange = { rgb(255, 186, 76), rgb(255, 92, 28) },
	Neutral = { rgb(76, 88, 152), rgb(40, 47, 94) },
	Dark = { rgb(36, 43, 84), rgb(15, 18, 38) },
	-- Sonderverläufe
	Play = { rgb(84, 255, 168), rgb(0, 176, 255) },
	Line = { rgb(0, 208, 255), rgb(255, 61, 154) },
	Sheen = { rgb(255, 255, 255), rgb(176, 182, 214) },
}

Theme.Fonts = {
	Title = Enum.Font.FredokaOne, -- runde, kräftige Überschriften und Zahlen
	Display = Enum.Font.LuckiestGuy, -- große Banner (SIEG!, Countdown)
	Button = Enum.Font.FredokaOne, -- Button-Beschriftungen
	Bold = Enum.Font.GothamBold,
	Medium = Enum.Font.GothamMedium,
	Body = Enum.Font.Gotham,
	Black = Enum.Font.GothamBlack,
}

Theme.Corner = 14
Theme.SmallCorner = 10
Theme.Padding = 12

Theme.TextSize = {
	Huge = 64,
	Title = 30,
	Large = 22,
	Body = 18,
	Small = 15,
	Tiny = 13,
}

-- Symbole (nur Unicode/Emoji, keine Bild-Assets)
Theme.Icons = {
	Play = "▶",
	Quick = "⚡",
	Ranked = "👑",
	Training = "🎯",
	Shop = "🛒",
	Inventory = "🎒",
	Stats = "📊",
	Leaderboard = "🏆",
	Settings = "⚙️",
	Close = "✕",
	Check = "✔",
	Star = "★",
	Info = "i",
	Warning = "!",
	Error = "✕",
	Reward = "★",
	Flag = "🏁",
	Queue = "⏳",
	Spectate = "👀",
	Fire = "🔥",
	Gift = "🎁",
	Players = "👥",
	Lock = "🔒",
	Medal = "🥇",
	Left = "◀",
	Right = "▶",
	Up = "▲",
	Down = "▼",
	Hook = "⚓",
}

-- Nachschlagetabelle: Grundfarbe (Hex) -> Verlaufspaar
local byHex = {}
for name, pair in Theme.Gradients do
	local color = Theme.Colors[name]
	if color then
		byHex[color:ToHex()] = pair
	end
end
byHex[Theme.Colors.PanelLight:ToHex()] = Theme.Gradients.Neutral
byHex[Theme.Colors.Panel:ToHex()] = Theme.Gradients.Dark
byHex[Theme.Colors.PanelDark:ToHex()] = Theme.Gradients.Dark

--- Liefert das Verlaufspaar (hell, dunkel) zu einer Grundfarbe.
function Theme.GradientFor(color: Color3): (Color3, Color3)
	local pair = byHex[color:ToHex()]
	if pair then
		return pair[1], pair[2]
	end
	return color:Lerp(Theme.Colors.White, 0.22), color:Lerp(Theme.Colors.Black, 0.22)
end

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">UIController</string>
              <string name="Source"><![CDATA[--[[
	UIController  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/UI/UIController

	Erstellt die komplette Benutzeroberfläche per Script (keine manuell
	angelegten GUI-Instanzen nötig) und verwaltet Screens und Modale.

	Struktur (zur Laufzeit in PlayerGui):
		VelocityRushUI (ScreenGui)
		└── Root (Frame, UIScale auf Referenz 1280×720)
		    ├── TopBar          Level-Ring, XP, Rang-Chip (+ Coins-Anzeige mit Shop-Abkürzung)
		    ├── LobbyMenu       Spielen-Karte (Modus + Warteschlange), Kachel-Menü, Status-Karte
		    ├── RaceHud         Countdown, Timer, Platzierungen, Gefahr, Items, Cooldowns
		    ├── TouchControls   Mobile Buttons
		    ├── Notifications   Hinweise (Toasts mit Symbol)
		    └── Modale: Results, Shop/Inventar (Catalog), Stats, Leaderboard,
		                Settings, Practice

	Stil und Bausteine kommen aus Theme und Components (Verlaufs-Buttons,
	Glas-Panels, Schatten, Symbole). Klick- und Hover-Sounds werden hier
	über Components.ClickCallback / HoverCallback angebunden.

	API:
		:RegisterModal(name, modal)
		:OpenModal(name) / :CloseModals() / :AnyModalOpen()
		:Notify(text, kind)
		.Root, .Gui, .Ctx, .Screens
]]

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local Components = require(script.Parent.Components)
local Theme = require(script.Parent.Theme)

local player = Players.LocalPlayer

local UIController = {}

local SCREEN_ORDER = {
	"Notifications",
	"TopBar",
	"LobbyMenu",
	"RaceHud",
	"TouchControls",
	"Results",
	"Catalog",
	"Stats",
	"Leaderboard",
	"Settings",
	"Practice",
}

function UIController:Init(ctx)
	self.Ctx = ctx
	self.Modals = {}
	self.Screens = {}

	local playerGui = player:WaitForChild("PlayerGui")
	self.Gui = Components.new("ScreenGui", {
		Name = "VelocityRushUI",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 5,
		Parent = playerGui,
	})
	self.Root = Components.new("Frame", {
		Name = "Root",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = self.Gui,
	})
	self.Scale = Components.new("UIScale", { Parent = self.Root })
	self:_rescale()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
		self:_rescale()
	end)

	Components.ClickCallback = function()
		local audio = ctx.AudioController
		if audio then
			audio:Play("Click")
		end
	end
	-- Leises, hohes Ticken beim Überfahren von Buttons (nur Maus, nicht bei Touch-Taps)
	Components.HoverCallback = function()
		local audio = ctx.AudioController
		if audio and UserInputService:GetLastInputType() == Enum.UserInputType.MouseMovement then
			audio:Play("Click", { Volume = 0.08, Pitch = 4 })
		end
	end

	local screensFolder = script.Parent:WaitForChild("Screens")
	for _, name in SCREEN_ORDER do
		local module = require(screensFolder:WaitForChild(name))
		self.Screens[name] = module.new(self)
	end
end

function UIController:Start()
	for _, name in SCREEN_ORDER do
		local screen = self.Screens[name]
		if screen.Start then
			local ok, err = pcall(screen.Start, screen)
			if not ok then
				warn("[UIController] " .. name .. ":Start fehlgeschlagen: " .. tostring(err))
			end
		end
	end

	self.Ctx.InputController.ActionPressed:Connect(function(action)
		if action == "Menu" then
			if self:AnyModalOpen() then
				self:CloseModals()
			else
				self.Screens.LobbyMenu:ToggleCollapsed()
			end
		end
	end)

	-- Standard-Rucksack ausblenden und Reset-Button auf unseren Respawn umleiten
	task.spawn(function()
		local resetEvent = Instance.new("BindableEvent")
		resetEvent.Event:Connect(function()
			local Remotes = require(game:GetService("ReplicatedStorage").Shared.Remotes)
			Remotes.RequestRespawn:FireServer()
		end)
		for _ = 1, 20 do
			local ok = pcall(function()
				StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
				StarterGui:SetCore("ResetButtonCallback", resetEvent)
			end)
			if ok then
				break
			end
			task.wait(0.5)
		end
	end)
end

function UIController:_rescale()
	local viewport = workspace.CurrentCamera.ViewportSize
	local reference = Theme.ReferenceSize
	local scale = math.clamp(math.min(viewport.X / reference.X, viewport.Y / reference.Y), 0.45, 1.6)
	self.ScaleValue = scale
	self.Scale.Scale = scale
	self.Root.Size = UDim2.fromScale(1 / scale, 1 / scale)
end

--- Umrechnung Bildschirmpixel -> logische UI-Koordinaten.
function UIController:ToLogical(pixels: Vector2): Vector2
	return pixels / (self.ScaleValue or 1)
end

function UIController:RegisterModal(name: string, modal)
	self.Modals[name] = modal
end

function UIController:OpenModal(name: string)
	for otherName, modal in self.Modals do
		if otherName ~= name then
			modal.Close()
		end
	end
	local modal = self.Modals[name]
	if modal then
		modal.Open()
	end
end

function UIController:CloseModals()
	for _, modal in self.Modals do
		modal.Close()
	end
end

function UIController:AnyModalOpen(): boolean
	for _, modal in self.Modals do
		if modal.IsOpen() then
			return true
		end
	end
	return false
end

function UIController:Notify(text: string, kind: string?)
	local notifications = self.Screens.Notifications
	if notifications then
		notifications:Push(text, kind)
	end
end

return UIController
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="80">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">200</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
