            <Item class="ModuleScript" referent="67">
              <Properties>
                <string name="Name">Catalog</string>
                <string name="Source"><![CDATA[--[[
	Catalog  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/UI/Screens/Catalog

	Shop und Inventar in einem Fenster (zwei Modi):
		Shop:      alle Items, Kaufen (Preis, Seltenheit, Levelvoraussetzung)
		Inventar:  nur eigene Items, Ausrüsten/Ablegen
	Links: Vorschau-Bühne – Verlaufs-Hintergrund in der Seltenheitsfarbe,
	Lichtkegel, Podest (zwei Zylinder-Parts im ViewportFrame) mit RunnerRig +
	Kosmetik (Emote-/Siegesposen werden animiert), Name, Seltenheits- und
	Kategorie-Chips, Beschreibung, Aktions-Button mit klaren Zuständen
	(Kaufen / Gratis / zu wenig Coins / Level gesperrt / Ausrüsten / Ablegen /
	Ausgerüstet) und Meldungen mit Symbol.
	Rechts: Raster aller Items der gewählten Kategorie als Karten in der
	Seltenheitsfarbe (Farbfelder, Trail-Streifen oder Symbol, Preis mit
	Münze bzw. Status-Chip); legendäre Items haben einen umlaufenden Glanzrand.

	Alle Aktionen gehen über die RemoteFunction "ShopRequest" – der Server
	prüft Guthaben, Besitz und Doppelkäufe.

	API:
		:Open(mode)   mode = "Shop" | "Inventory"
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)
local RunnerRig = require(Shared.RunnerRig)
local CosmeticApplier = require(Shared.CosmeticApplier)
local CosmeticDefinitions = require(Shared.CosmeticDefinitions)

local UI = script.Parent.Parent
local Components = require(UI.Components)
local Theme = require(UI.Theme)

local new = Components.new
local rgb = Color3.fromRGB

local Catalog = {}
Catalog.__index = Catalog

local CARD_SIZE = UDim2.fromOffset(152, 164)
local PREVIEW_WIDTH = 330

-- Symbole je Kategorie (für Karten ohne Farbfelder und für die Tabs)
local CATEGORY_GLYPHS = {
	Skins = "👕",
	Trails = "💫",
	Effects = "✨",
	Emotes = "💃",
	Victory = Theme.Icons.Leaderboard,
	Colors = "🎨",
}

local MODES = {
	Shop = { Title = "SHOP", Icon = Theme.Icons.Shop, Color = Theme.Colors.Gold },
	Inventory = { Title = "INVENTAR", Icon = Theme.Icons.Inventory, Color = Theme.Colors.Purple },
}

local RAINBOW = { rgb(255, 60, 60), rgb(255, 200, 40), rgb(80, 255, 80), rgb(60, 160, 255), rgb(190, 90, 255) }

function Catalog.new(ui)
	local self = setmetatable({}, Catalog)
	self.UI = ui
	self.Mode = "Shop"
	self.Category = "Skins"
	self.Selected = nil
	self.Busy = false
	self.Cards = {}
	self.Glows = {}
	self.MessageToken = 0

	local modal = Components.Modal({
		Name = "Catalog",
		Title = "SHOP",
		Icon = Theme.Icons.Shop,
		Accent = Theme.Colors.Gold,
		Size = UDim2.fromOffset(1060, 620),
		Parent = ui.Root,
	})
	self.Modal = modal
	ui:RegisterModal("Catalog", modal)
	self.HeaderIcon = modal.Window:FindFirstChild("Icon")
	local content = modal.Content

	-- Coins-Anzeige oben rechts (neben dem Schließen-Button)
	local coins = new("Frame", {
		Name = "Coins",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -70, 0, 16),
		Size = UDim2.fromOffset(170, 38),
		BackgroundColor3 = Theme.Colors.Shadow,
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		ZIndex = 23,
		Parent = modal.Window,
	})
	new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = coins })
	Components.Stroke(Theme.Colors.Gold, 1.5, 0.3).Parent = coins
	Components.CoinIcon(26, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 7, 0.5, 0), ZIndex = 23, Parent = coins })
	self.CoinLabel = Components.Heading({
		Text = "",
		TextSize = 20,
		TextScaled = true,
		MaxTextSize = 20,
		TextColor3 = Theme.Colors.Gold:Lerp(Theme.Colors.White, 0.2),
		TextXAlignment = Enum.TextXAlignment.Right,
		Outline = 1.5,
		RichText = false,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.new(1, -50, 0, 24),
		ZIndex = 23,
		Parent = coins,
	})

	local tabs = {}
	for _, category in CosmeticDefinitions.Categories do
		table.insert(tabs, { Name = category, Label = string.upper(CosmeticDefinitions.CategoryNames[category]), Width = if category == "Victory" then 200 else 130 })
	end
	local _, selectTab = Components.Tabs({
		Tabs = tabs,
		Size = UDim2.new(1, 0, 0, 38),
		Parent = content,
		OnSelect = function(name)
			self.Category = name
			self.Selected = nil
			self:_render()
		end,
	})
	self.SelectTab = selectTab

	self:_buildPreview(content)

	-- Raster
	local grid = new("ScrollingFrame", {
		Name = "Grid",
		Position = UDim2.fromOffset(PREVIEW_WIDTH + 16, 50),
		Size = UDim2.new(1, -(PREVIEW_WIDTH + 16), 1, -50),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Colors.Stroke,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = content,
	})
	Components.Grid(CARD_SIZE, 12).Parent = grid
	Components.Padding(6).Parent = grid
	self.Grid = grid
	self.EmptyLabel = Components.Label({
		Text = Theme.Icons.Inventory .. "  Noch keine Items in dieser Kategorie. Schau im Shop vorbei!",
		Font = Theme.Fonts.Title,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = Theme.Colors.TextDim,
		Position = UDim2.fromOffset(PREVIEW_WIDTH + 16, 140),
		Size = UDim2.new(1, -(PREVIEW_WIDTH + 16), 0, 50),
		Visible = false,
		Parent = content,
	})

	modal.OnClose = function()
		self:_destroyPreview()
	end
	return self
end

-- Vorschau-Panel links: Bühne mit ViewportFrame, Details, Aktion
function Catalog:_buildPreview(content: Frame)
	local _, panel = Components.Card({
		Name = "Preview",
		Position = UDim2.fromOffset(0, 50),
		Size = UDim2.new(0, PREVIEW_WIDTH, 1, -50),
		BackgroundColor3 = Theme.Colors.PanelDark,
		CornerRadius = 16,
		ShadowOffset = 4,
		ShadowSpread = 5,
		Parent = content,
	})
	self.PreviewPanel = panel

	-- Bühne: Verlaufs-Hintergrund, Lichtkegel, Bodenschein
	local stage = new("Frame", {
		Name = "Stage",
		Position = UDim2.fromOffset(10, 10),
		Size = UDim2.new(1, -20, 0, 250),
		BackgroundColor3 = Theme.Colors.White,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = panel,
	})
	Components.Corner(12).Parent = stage
	self.StageGradient = Components.Gradient({ Theme.Colors.Accent, Theme.Colors.PanelDark }, 90)
	self.StageGradient.Parent = stage
	self.StageStroke = Components.Stroke(Theme.Colors.Accent, 2, 0.35)
	self.StageStroke.Parent = stage
	for index, beam in { { X = 0.3, Rotation = 18 }, { X = 0.7, Rotation = -18 } } do
		local light = new("Frame", {
			Name = "Beam" .. index,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(beam.X, 0, 0, -40),
			Size = UDim2.new(0, 70, 1, 40),
			Rotation = beam.Rotation,
			BackgroundColor3 = Theme.Colors.White,
			BackgroundTransparency = 0.82,
			BorderSizePixel = 0,
			Parent = stage,
		})
		Components.Gradient(Theme.Colors.White, 90, { 0.2, 1 }).Parent = light
	end
	self.FloorGlow = new("Frame", {
		Name = "FloorGlow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 1, -34),
		Size = UDim2.fromOffset(230, 56),
		BackgroundColor3 = Theme.Colors.Accent,
		BackgroundTransparency = 0.55,
		BorderSizePixel = 0,
		Parent = stage,
	})
	new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = self.FloorGlow })
	Components.Gradient(Theme.Colors.White, 90, { 1, 0.2, 1 }).Parent = self.FloorGlow

	local viewport = new("ViewportFrame", {
		Name = "Viewport",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Ambient = rgb(150, 156, 190),
		LightColor = rgb(255, 246, 232),
		-- Licht fällt von vorne-oben (Kameraseite) auf die Figur
		LightDirection = Vector3.new(-0.45, -1, 0.7),
		Parent = stage,
	})
	local worldModel = new("WorldModel", { Parent = viewport })
	local camera = new("Camera", { FieldOfView = 40, Parent = viewport })
	camera.CFrame = CFrame.lookAt(Vector3.new(0, 1.8, -11.5), Vector3.new(0, 0.15, 0))
	viewport.CurrentCamera = camera
	self.Viewport = viewport
	self.WorldModel = worldModel

	-- Podest: dunkler Sockel mit leuchtendem Rand in der Seltenheitsfarbe
	local upright = CFrame.Angles(0, 0, math.rad(90))
	self.Pedestal = new("Part", {
		Name = "Pedestal",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.5, 5.6, 5.6),
		CFrame = CFrame.new(0, -2.97, 0) * upright,
		Color = rgb(40, 46, 86),
		Material = Enum.Material.SmoothPlastic,
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Parent = worldModel,
	})
	self.PedestalRim = new("Part", {
		Name = "PedestalRim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.14, 6, 6),
		CFrame = CFrame.new(0, -2.82, 0) * upright,
		Color = Theme.Colors.Accent,
		Material = Enum.Material.Neon,
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Parent = worldModel,
	})

	-- Chips auf der Bühne
	local rarityPill, rarityLabel = Components.Pill({
		Text = "",
		Size = UDim2.fromOffset(112, 22),
		Position = UDim2.fromOffset(10, 10),
		TextSize = 12,
		ZIndex = 2,
		Parent = stage,
	})
	rarityPill.BackgroundTransparency = 0.45
	self.RarityPill, self.ItemRarity = rarityPill, rarityLabel
	local equippedPill = Components.Pill({
		Text = Theme.Icons.Check .. " AUSGERÜSTET",
		Color = Theme.Colors.Success,
		Size = UDim2.fromOffset(118, 22),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 10),
		TextSize = 12,
		ZIndex = 2,
		Parent = stage,
	})
	equippedPill.BackgroundTransparency = 0.45
	equippedPill.Visible = false
	self.EquippedPill = equippedPill

	-- Details
	self.ItemName = Components.Heading({
		Text = "",
		TextSize = 24,
		TextScaled = true,
		MaxTextSize = 24,
		RichText = false,
		Position = UDim2.fromOffset(14, 268),
		Size = UDim2.new(1, -28, 0, 30),
		Parent = panel,
	})
	local categoryPill, categoryLabel = Components.Pill({
		Text = "",
		Color = Theme.Colors.PanelLight:Lerp(Theme.Colors.White, 0.3),
		Size = UDim2.fromOffset(170, 22),
		Position = UDim2.fromOffset(14, 302),
		TextSize = 12,
		Parent = panel,
	})
	self.CategoryPill, self.CategoryLabel = categoryPill, categoryLabel
	self.ItemDescription = Components.Label({
		Text = "",
		Font = Theme.Fonts.Medium,
		TextSize = Theme.TextSize.Small - 1,
		TextColor3 = Theme.Colors.TextDim,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(14, 332),
		Size = UDim2.new(1, -28, 0, 62),
		Parent = panel,
	})
	self.ActionButton = Components.Button({
		Text = "",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -40),
		Size = UDim2.new(1, -28, 0, 52),
		Color = Theme.Colors.Accent,
		TextColor = Theme.Colors.White,
		TextSize = 20,
		TextScaled = true,
		Font = Theme.Fonts.Title,
		CornerRadius = 14,
		OnClick = function()
			self:_action()
		end,
	})
	self.ActionButton.Parent = panel
	self.ActionCoin = Components.CoinIcon(26, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 14, 0.5, 0), Parent = self.ActionButton })
	self.ActionCoin.Visible = false
	Components.Shine(self.ActionButton, { Interval = 4.5 })
	self.Message = Components.Label({
		Text = "",
		Font = Theme.Fonts.Bold,
		TextSize = Theme.TextSize.Small - 1,
		TextScaled = true,
		MaxTextSize = Theme.TextSize.Small - 1,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.6,
		TextStrokeColor3 = Theme.Colors.Shadow,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.new(1, -20, 0, 24),
		Parent = panel,
	})
end

function Catalog:Start()
	local state = self.UI.Ctx.ClientState
	state.ProfileChanged:Connect(function()
		if self.Modal.IsOpen() then
			self:_render()
		end
	end)
	RunService.RenderStepped:Connect(function()
		if self.Preview and self.Preview.Parent then
			self.Preview:PivotTo(CFrame.Angles(0, math.sin(os.clock() * 0.6) * 0.9, 0))
		end
		-- Umlaufender Glanzrand der legendären Karten (nur bei offenem Fenster)
		if #self.Glows > 0 and self.Modal.IsOpen() then
			local rotation = (os.clock() * 120) % 360
			for _, gradient in self.Glows do
				gradient.Rotation = rotation
			end
		end
	end)
end

--- Öffnet das Fenster im Modus "Shop" oder "Inventory".
function Catalog:Open(mode: string)
	self.Mode = mode
	local info = MODES[mode] or MODES.Shop
	self.Modal.Title.Text = info.Title
	if self.HeaderIcon then
		Components.SetIconColor(self.HeaderIcon, info.Color)
		local glyph = self.HeaderIcon:FindFirstChild("Glyph")
		if glyph then
			glyph.Text = info.Icon
		end
	end
	self.Selected = nil
	self.Message.Text = ""
	self.UI:OpenModal("Catalog")
	self.SelectTab(self.Category)
end

function Catalog:_profile()
	return self.UI.Ctx.ClientState.Profile
end

function Catalog:_owns(category: string, id: string): boolean
	local profile = self:_profile()
	return profile ~= nil and profile.Owned[category] ~= nil and profile.Owned[category][id] == true
end

function Catalog:_equipped(category: string): string
	local profile = self:_profile()
	return profile and profile.Equipped[category] or ""
end

function Catalog:_items()
	local list = {}
	for _, item in CosmeticDefinitions.Items[self.Category] do
		if self.Mode == "Shop" or self:_owns(self.Category, item.Id) then
			table.insert(list, item)
		end
	end
	table.sort(list, function(a, b)
		local ra = CosmeticDefinitions.Rarities[a.Rarity].Order
		local rb = CosmeticDefinitions.Rarities[b.Rarity].Order
		if ra ~= rb then
			return ra < rb
		end
		return a.Price < b.Price
	end)
	return list
end

-- Gesperrt durch Level? (nur für nicht besessene Items relevant)
function Catalog:_levelLocked(item): boolean
	local profile = self:_profile()
	return item.LevelRequired ~= nil and profile ~= nil and profile.Level < item.LevelRequired
end

------------------------------------------------------------------------
-- Karten
------------------------------------------------------------------------

-- Farbkreis mit weißem Rand und Glanzpunkt
local function colorDot(parent: Instance, size: number, color: Color3, position: UDim2, zIndex: number?)
	local dot = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = position,
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		ZIndex = zIndex or 1,
		Parent = parent,
	})
	new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = dot })
	Components.Stroke(Theme.Colors.White, 2, 0.2).Parent = dot
	local shine = new("Frame", {
		Position = UDim2.fromScale(0.2, 0.14),
		Size = UDim2.fromScale(0.3, 0.2),
		Rotation = -35,
		BackgroundColor3 = Theme.Colors.White,
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		ZIndex = zIndex or 1,
		Parent = dot,
	})
	new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = shine })
	return dot
end

-- Vorschau-Grafik einer Karte je Kategorie (Farbfelder, Trail-Streifen, Symbol)
local function buildArt(card: Instance, item, rarityColor: Color3)
	local art = new("Frame", {
		Name = "Art",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(8, 26),
		Size = UDim2.new(1, -16, 0, 52),
		Parent = card,
	})
	if item.Category == "Skins" then
		colorDot(art, 34, item.Secondary, UDim2.new(0.5, -26, 0.5, 4), 1)
		colorDot(art, 34, item.Accent, UDim2.new(0.5, 26, 0.5, 4), 1)
		colorDot(art, 46, item.Primary, UDim2.fromScale(0.5, 0.5), 2)
	elseif item.Category == "Trails" then
		local streak = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, -10, 0.5, 0),
			Size = UDim2.fromOffset(104, 16),
			BackgroundColor3 = Theme.Colors.White,
			BorderSizePixel = 0,
			Parent = art,
		})
		new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = streak })
		local colors = if item.Rainbow then RAINBOW else { item.ColorA, item.ColorB }
		Components.Gradient(colors, 0, { 1, 0.3, 0 }).Parent = streak
		colorDot(art, 30, if item.Rainbow then RAINBOW[#RAINBOW] else item.ColorB, UDim2.new(0.5, 44, 0.5, 0), 2)
	elseif item.Category == "Effects" or item.Category == "Colors" then
		local dot = colorDot(art, 48, item.Color, UDim2.fromScale(0.5, 0.5), 1)
		if item.Category == "Effects" then
			Components.Label({
				Text = CATEGORY_GLYPHS.Effects,
				TextSize = 22,
				TextXAlignment = Enum.TextXAlignment.Center,
				TextWrapped = false,
				RichText = false,
				Size = UDim2.fromScale(1, 1),
				Parent = dot,
			})
		end
	else
		local _, glyph = Components.Icon({
			Glyph = CATEGORY_GLYPHS[item.Category] or Theme.Icons.Star,
			Color = rarityColor,
			Size = 50,
			TextSize = 26,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Parent = art,
		})
		glyph.TextStrokeTransparency = 1
	end
end

-- Status unten auf der Karte: Preis mit Münze oder Status-Chip
function Catalog:_buildCardStatus(card: Instance, item, owned: boolean, equipped: boolean)
	local holder = new("Frame", {
		Name = "Status",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -9),
		Size = UDim2.new(1, -16, 0, 24),
		Parent = card,
	}, { Components.List(Enum.FillDirection.Horizontal, 5, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
	local chipText, chipColor
	if equipped then
		chipText, chipColor = Theme.Icons.Check .. " AUSGERÜSTET", Theme.Colors.Success
	elseif owned then
		chipText, chipColor = "IM BESITZ", Theme.Colors.Accent
	elseif self:_levelLocked(item) then
		chipText, chipColor = Theme.Icons.Lock .. " LEVEL " .. tostring(item.LevelRequired), Theme.Colors.Danger
	elseif item.Price == 0 then
		chipText, chipColor = "GRATIS", Theme.Colors.Success
	end
	if chipText then
		Components.Pill({ Text = chipText, Color = chipColor, Size = UDim2.fromOffset(128, 22), TextSize = 12, Parent = holder })
		return
	end
	local profile = self:_profile()
	local affordable = profile == nil or profile.Coins >= item.Price
	Components.CoinIcon(20, { Parent = holder })
	Components.Label({
		Text = Util.FormatNumber(item.Price),
		Font = Theme.Fonts.Title,
		TextSize = 17,
		TextColor3 = if affordable then Theme.Colors.Gold:Lerp(Theme.Colors.White, 0.15) else Theme.Colors.TextDim,
		TextWrapped = false,
		RichText = false,
		TextStrokeTransparency = 0.5,
		TextStrokeColor3 = Theme.Colors.Shadow,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 22),
		Parent = holder,
	})
end

function Catalog:_buildCard(index: number, item)
	local rarity = CosmeticDefinitions.Rarities[item.Rarity]
	local owned = self:_owns(item.Category, item.Id)
	local equipped = self:_equipped(item.Category) == item.Id
	local card = Components.Button({
		Name = item.Id,
		Text = "",
		Size = CARD_SIZE,
		Color = rarity.Color:Lerp(Theme.Colors.PanelDark, 0.74),
		StrokeColor = rarity.Color,
		CornerRadius = 14,
		LayoutOrder = index,
		OnClick = function()
			self:_select(item)
		end,
	})
	card.Parent = self.Grid
	-- Schimmer der Seltenheitsfarbe im oberen Bereich
	local glow = new("Frame", {
		Name = "RarityGlow",
		Position = UDim2.fromOffset(2, 2),
		Size = UDim2.new(1, -4, 0, 70),
		BackgroundColor3 = rarity.Color,
		BorderSizePixel = 0,
		Parent = card,
	})
	Components.Corner(12).Parent = glow
	Components.Gradient(rarity.Color, 90, { 0.55, 1 }).Parent = glow
	Components.Label({
		Text = string.upper(rarity.Name),
		Font = Theme.Fonts.Title,
		TextSize = 11,
		TextColor3 = rarity.Color:Lerp(Theme.Colors.White, 0.45),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		RichText = false,
		TextStrokeTransparency = 0.5,
		TextStrokeColor3 = Theme.Colors.Shadow,
		Position = UDim2.fromOffset(0, 6),
		Size = UDim2.new(1, 0, 0, 14),
		Parent = card,
	})
	buildArt(card, item, rarity.Color)
	Components.Label({
		Text = item.Name,
		Font = Theme.Fonts.Title,
		TextSize = 15,
		TextScaled = true,
		MaxTextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Center,
		RichText = false,
		TextStrokeTransparency = 0.5,
		TextStrokeColor3 = Theme.Colors.Shadow,
		Position = UDim2.fromOffset(6, 86),
		Size = UDim2.new(1, -12, 0, 36),
		Parent = card,
	})
	self:_buildCardStatus(card, item, owned, equipped)
	if equipped then
		local _, check = Components.Icon({
			Name = "EquippedBadge",
			Glyph = Theme.Icons.Check,
			Color = Theme.Colors.Success,
			Size = 24,
			TextSize = 13,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -8, 0, 8),
			Parent = card,
		})
		check.TextStrokeTransparency = 0.4
	end
	local border = card:FindFirstChild("Border")
	if border and item.Rarity == "Legendary" then
		-- Umlaufender Glanz (Rotation wird in Start() animiert)
		local shimmer = Components.Gradient({ rarity.Color, Theme.Colors.White, rarity.Color, rgb(255, 120, 40), rarity.Color }, 0)
		shimmer.Parent = border
		table.insert(self.Glows, shimmer)
	elseif border and item.Rarity == "Epic" then
		Components.Gradient({ rarity.Color, Theme.Colors.Accent2, rarity.Color }, 45).Parent = border
	end
	self.Cards[item] = card
end

function Catalog:_render()
	local profile = self:_profile()
	self.CoinLabel.Text = if profile then Util.FormatNumber(profile.Coins) else ""
	for _, child in self.Grid:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	self.Cards = {}
	self.Glows = {}
	local items = self:_items()
	self.EmptyLabel.Visible = #items == 0
	if not self.Selected or self.Selected.Category ~= self.Category then
		self.Selected = nil
		local equippedId = self:_equipped(self.Category)
		for _, item in items do
			if item.Id == equippedId then
				self.Selected = item
			end
		end
		self.Selected = self.Selected or items[1]
	end
	for index, item in items do
		self:_buildCard(index, item)
	end
	self:_highlightCards()
	self:_renderDetail()
end

-- Auswahl wechseln, ohne das Raster neu aufzubauen
function Catalog:_select(item)
	if self.Selected == item then
		return
	end
	self.Selected = item
	self.Message.Text = ""
	self:_highlightCards()
	local card = self.Cards[item]
	if card then
		Components.Pop(card, 1.08, 0.25)
	end
	self:_renderDetail()
end

function Catalog:_highlightCards()
	for item, card in self.Cards do
		local selected = item == self.Selected
		local border = card:FindFirstChild("Border")
		if border then
			border.Color = if selected then Theme.Colors.White else CosmeticDefinitions.Rarities[item.Rarity].Color
			border.Thickness = if selected then 3.5 else 2
		end
	end
end

------------------------------------------------------------------------
-- Details und Aktion
------------------------------------------------------------------------

-- Aktions-Button einfärben/beschriften (Grundfarbe, optional Verlaufspaar)
function Catalog:_setAction(text: string, color: Color3, gradient, showCoin: boolean)
	self.ActionButton.Text = text
	Components.SetButtonColor(self.ActionButton, color, gradient)
	self.ActionButton.TextColor3 = Theme.Colors.White
	self.ActionCoin.Visible = showCoin
end

function Catalog:_renderDetail()
	local item = self.Selected
	if not item then
		self.ItemName.Text = ""
		self.ItemRarity.Text = ""
		self.RarityPill.Visible = false
		self.CategoryPill.Visible = false
		self.EquippedPill.Visible = false
		self.ItemDescription.Text = ""
		self.ActionButton.Visible = false
		self:_destroyPreview()
		return
	end
	local rarity = CosmeticDefinitions.Rarities[item.Rarity]
	self.ItemName.Text = item.Name
	-- Seltenheit: Chip, Bühnenfarbe, Podest-Rand, Bodenschein
	self.RarityPill.Visible = true
	self.ItemRarity.Text = string.upper(rarity.Name)
	self.ItemRarity.TextColor3 = rarity.Color:Lerp(Theme.Colors.White, 0.4)
	self.RarityPill.BackgroundColor3 = rarity.Color
	local rarityBorder = self.RarityPill:FindFirstChild("Border")
	if rarityBorder then
		rarityBorder.Color = rarity.Color
	end
	self.CategoryPill.Visible = true
	self.CategoryLabel.Text = (CATEGORY_GLYPHS[item.Category] or "") .. " " .. string.upper(CosmeticDefinitions.CategoryNames[item.Category])
	self.StageGradient.Color = ColorSequence.new(rarity.Color:Lerp(Theme.Colors.Panel, 0.45), Theme.Colors.PanelDark:Lerp(Theme.Colors.Shadow, 0.4))
	self.StageStroke.Color = rarity.Color
	self.FloorGlow.BackgroundColor3 = rarity.Color
	self.PedestalRim.Color = rarity.Color

	local description = item.Description or ""
	if item.Category == "Trails" or item.Category == "Effects" then
		description ..= "\n(Trails und Partikel sind im Spiel sichtbar, nicht in der Vorschau.)"
	end
	self.ItemDescription.Text = description

	local owned = self:_owns(item.Category, item.Id)
	local equipped = self:_equipped(item.Category) == item.Id
	local profile = self:_profile()
	self.EquippedPill.Visible = equipped
	self.ActionButton.Visible = true
	if equipped then
		if CosmeticDefinitions.Unequippable[item.Category] then
			self:_setAction(Theme.Icons.Close .. "  ABLEGEN", Theme.Colors.PanelLight, nil, false)
		else
			self:_setAction(Theme.Icons.Check .. "  AUSGERÜSTET", Theme.Colors.Success, nil, false)
		end
	elseif owned then
		self:_setAction("AUSRÜSTEN", Theme.Colors.Accent, nil, false)
	elseif self:_levelLocked(item) then
		self:_setAction(Theme.Icons.Lock .. "  AB LEVEL " .. tostring(item.LevelRequired), Theme.Colors.PanelLight, nil, false)
	elseif item.Price == 0 then
		self:_setAction(Theme.Icons.Gift .. "  GRATIS HOLEN", Theme.Colors.Success, Theme.Gradients.Play, false)
	elseif profile and profile.Coins < item.Price then
		self:_setAction("ZU WENIG COINS · " .. Util.FormatNumber(item.Price), Theme.Colors.PanelLight, nil, true)
	else
		self:_setAction("KAUFEN · " .. Util.FormatNumber(item.Price), Theme.Colors.Gold, Theme.Gradients.Gold, true)
	end
	self:_updatePreview(item)
end

function Catalog:_destroyPreview()
	if self.Preview then
		self.UI.Ctx.AnimationController:UnregisterPreview(self.Preview)
		self.Preview:Destroy()
		self.Preview = nil
	end
end

function Catalog:_updatePreview(item)
	local profile = self:_profile()
	local equipped = if profile then table.clone(profile.Equipped) else table.clone(CosmeticDefinitions.DefaultEquipped)
	equipped[item.Category] = item.Id
	if not self.Preview then
		local rig = RunnerRig.Build({ ForCharacter = false })
		for _, part in rig:GetDescendants() do
			if part:IsA("BasePart") then
				part.Anchored = part.Name == "HumanoidRootPart"
			end
		end
		rig.Parent = self.WorldModel
		self.Preview = rig
		self.UI.Ctx.AnimationController:RegisterPreview(rig, function()
			return self.PreviewPose
		end)
	end
	CosmeticApplier.Apply(self.Preview, equipped)
	if item.Category == "Emotes" then
		self.PreviewPose = item.Id
	elseif item.Category == "Victory" then
		self.PreviewPose = "Victory"
	else
		self.PreviewPose = "Idle"
	end
end

-- Meldung unter dem Button (Symbol + Farbe, verschwindet nach 4 s)
function Catalog:_setMessage(text: string, kind: string?)
	self.MessageToken += 1
	local token = self.MessageToken
	if kind == "Success" then
		self.Message.Text = Theme.Icons.Check .. "  " .. text
		self.Message.TextColor3 = Theme.Colors.Success
	elseif kind == "Error" then
		self.Message.Text = Theme.Icons.Error .. "  " .. text
		self.Message.TextColor3 = Theme.Colors.Danger
	else
		self.Message.Text = text
		self.Message.TextColor3 = Theme.Colors.TextDim
	end
	if kind then
		Components.Pop(self.Message, 1.15, 0.3)
		task.delay(4, function()
			if self.MessageToken == token then
				self.Message.Text = ""
			end
		end)
	end
end

function Catalog:_action()
	local item = self.Selected
	if not item or self.Busy then
		return
	end
	local owned = self:_owns(item.Category, item.Id)
	local equipped = self:_equipped(item.Category) == item.Id
	local action
	if equipped then
		if not CosmeticDefinitions.Unequippable[item.Category] then
			return
		end
		action = "Unequip"
	elseif owned then
		action = "Equip"
	else
		action = "Buy"
	end
	self.Busy = true
	self:_setMessage("…", nil)
	local ok, result = pcall(function()
		return Remotes.ShopRequest:InvokeServer(action, item.Category, item.Id)
	end)
	self.Busy = false
	if not ok or type(result) ~= "table" then
		self:_setMessage("Verbindungsfehler – bitte erneut versuchen.", "Error")
		return
	end
	self:_setMessage(result.Message or "", if result.Ok then "Success" else "Error")
	if result.Ok then
		Components.Pop(self.ActionButton, 1.08, 0.3)
	end
	if result.Ok and action == "Buy" then
		-- Direkt nach dem Kauf ausrüsten (bequemer)
		pcall(function()
			Remotes.ShopRequest:InvokeServer("Equip", item.Category, item.Id)
		end)
	end
end

return Catalog
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="68">
              <Properties>
                <string name="Name">Leaderboard</string>
                <string name="Source"><![CDATA[--[[
	Leaderboard  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/UI/Screens/Leaderboard

	Bestenlisten: Siege (global), Rating der Saison (global) und dieser Server.
	Daten kommen gecacht vom Server (RemoteFunction "GetLeaderboard").

	Darstellung: Zeilen als Glas-Karten; die Plätze 1–3 mit Gold-/Silber-/
	Bronze-Plakette (Krone für Platz 1) und getöntem Hintergrund, jeder
	Spieler mit Initialen-Avatar (Farbe aus dem Namen), der eigene Eintrag
	mit Akzentrand und „DU“-Chip, der Wert groß rechts.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local UI = script.Parent.Parent
local Components = require(UI.Components)
local Theme = require(UI.Theme)

local player = Players.LocalPlayer
local new = Components.new
local rgb = Color3.fromRGB

local Leaderboard = {}
Leaderboard.__index = Leaderboard

-- Plaketten-Verläufe für die Plätze 1–3 (Gold, Silber, Bronze)
local MEDALS = {
	{ rgb(255, 234, 100), rgb(255, 154, 18) },
	{ rgb(242, 246, 255), rgb(146, 158, 186) },
	{ rgb(255, 196, 140), rgb(184, 96, 38) },
}

local AVATAR_COLORS = {
	Theme.Colors.Accent,
	Theme.Colors.Accent2,
	Theme.Colors.Success,
	Theme.Colors.Warning,
	Theme.Colors.Purple,
	Theme.Colors.Orange,
}

-- Stabile Avatar-Farbe aus dem Namen
local function avatarColor(name: string): Color3
	local hash = 0
	for index = 1, #name do
		hash = (hash * 31 + string.byte(name, index)) % 1000003
	end
	return AVATAR_COLORS[hash % #AVATAR_COLORS + 1]
end

local function toHex(color: Color3): string
	return "#" .. color:ToHex()
end

function Leaderboard.new(ui)
	local self = setmetatable({}, Leaderboard)
	self.UI = ui
	self.Tab = "Server"
	self.Data = nil
	local modal = Components.Modal({
		Name = "Leaderboard",
		Title = "BESTENLISTE",
		Icon = Theme.Icons.Leaderboard,
		Accent = Theme.Colors.Orange,
		Size = UDim2.fromOffset(760, 600),
		Parent = ui.Root,
	})
	self.Modal = modal
	ui:RegisterModal("Leaderboard", modal)

	local _, select = Components.Tabs({
		Tabs = {
			{ Name = "Server", Label = Theme.Icons.Players .. " DIESER SERVER", Width = 220 },
			{ Name = "Wins", Label = Theme.Icons.Leaderboard .. " SIEGE (GLOBAL)", Width = 220 },
			{ Name = "Rating", Label = Theme.Icons.Ranked .. " RATING (SAISON)", Width = 220 },
		},
		Parent = modal.Content,
		OnSelect = function(name)
			self.Tab = name
			self:_render()
		end,
	})
	self.Select = select
	self.Status = Components.Label({
		Text = "",
		TextColor3 = Theme.Colors.TextDim,
		Font = Theme.Fonts.Medium,
		TextSize = Theme.TextSize.Small,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(4, 50),
		Size = UDim2.new(1, -8, 0, 22),
		Parent = modal.Content,
	})
	Components.Divider({ Position = UDim2.fromOffset(0, 76), Size = UDim2.new(1, 0, 0, 2), Colors = { Theme.Colors.Orange, Theme.Colors.Accent2 }, Parent = modal.Content })
	self.List = new("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 86),
		Size = UDim2.new(1, 0, 1, -86),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Colors.Stroke,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = modal.Content,
	}, { Components.List(Enum.FillDirection.Vertical, 6), Components.Padding(2, 4, 4, 2) })

	modal.OnOpen = function()
		self:_fetch()
		self.Select(self.Tab)
	end
	return self
end

function Leaderboard:Start() end

function Leaderboard:_fetch()
	self.Status.Text = Theme.Icons.Queue .. "  Lädt …"
	task.spawn(function()
		local ok, data = pcall(function()
			return Remotes.GetLeaderboard:InvokeServer()
		end)
		if ok and type(data) == "table" then
			self.Data = data
		end
		if self.Modal.IsOpen() then
			self:_render()
		end
	end)
end

function Leaderboard:_render()
	for _, child in self.List:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local data = self.Data
	if not data then
		self.Status.Text = Theme.Icons.Queue .. "  Bestenliste wird geladen …"
		return
	end
	local entries = data[self.Tab] or {}
	if self.Tab ~= "Server" and not data.Available then
		self.Status.Text = Theme.Icons.Warning .. "  Globale Bestenlisten benötigen DataStore-Zugriff (in Studio: API-Zugriff aktivieren)."
	elseif #entries == 0 then
		self.Status.Text = "Noch keine Einträge."
	else
		self.Status.Text = if self.Tab == "Server" then "Spieler auf diesem Server (nach Siegen)" else "Top " .. #entries
	end
	for index, entry in entries do
		self:_row(index, entry)
	end
end

function Leaderboard:_row(index: number, entry)
	local isMe = entry.UserId == player.UserId
	local rank = entry.Rank or index
	local medal = MEDALS[rank]
	local name = entry.Name or "?"
	local row = Components.Panel({
		Name = "Row",
		Size = UDim2.new(1, -10, 0, 54),
		BackgroundColor3 = if isMe then Theme.Colors.PanelLight else Theme.Colors.PanelDark,
		BackgroundTransparency = 0.06,
		StrokeColor = if isMe then Theme.Colors.Accent elseif medal then medal[2] else Theme.Colors.Stroke,
		StrokeThickness = if isMe or rank == 1 then 2 else 1.5,
		StrokeTransparency = if isMe or medal then 0.05 else 0.5,
		CornerRadius = 12,
		LayoutOrder = index,
		Parent = self.List,
	})
	if medal then
		-- Getönter Schimmer der Medaillenfarbe von links
		local tint = new("Frame", {
			Name = "Tint",
			Size = UDim2.fromScale(0.7, 1),
			BackgroundColor3 = medal[2],
			BackgroundTransparency = 0.6,
			BorderSizePixel = 0,
			Parent = row,
		})
		Components.Corner(12).Parent = tint
		Components.Gradient(Theme.Colors.White, 0, { 0.2, 1 }).Parent = tint
	end

	-- Platz-Plakette
	local badge = new("Frame", {
		Name = "Badge",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		Size = UDim2.fromOffset(38, 38),
		BackgroundColor3 = Theme.Colors.White,
		BorderSizePixel = 0,
		Parent = row,
	})
	new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = badge })
	Components.Gradient(medal or Theme.Gradients.Neutral, 90).Parent = badge
	Components.Stroke(if medal then Theme.Colors.White else Theme.Colors.Shadow, 2, if medal then 0.25 else 0.4).Parent = badge
	Components.Label({
		Text = if medal then tostring(rank) else "#" .. tostring(rank),
		Font = Theme.Fonts.Title,
		TextSize = if medal then 20 else 14,
		TextScaled = true,
		MaxTextSize = if medal then 20 else 14,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		RichText = false,
		TextStrokeTransparency = 0.3,
		TextStrokeColor3 = if medal then medal[2]:Lerp(Theme.Colors.Black, 0.6) else Theme.Colors.Shadow,
		Position = UDim2.fromOffset(3, 3),
		Size = UDim2.new(1, -6, 1, -6),
		Parent = badge,
	})
	if rank == 1 then
		Components.Label({
			Text = Theme.Icons.Ranked,
			TextSize = 18,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			RichText = false,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 0, 7),
			Rotation = -14,
			Size = UDim2.fromOffset(30, 22),
			Parent = badge,
		})
	end

	-- Initialen-Avatar
	local color = avatarColor(name)
	local _, letter = Components.Icon({
		Glyph = string.upper(string.match(name, utf8.charpattern) or "?"),
		Color = color,
		Size = 36,
		TextSize = 18,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 58, 0.5, 0),
		Parent = row,
	})
	letter.RichText = false

	-- Name (+ "DU"-Chip) und bei "Server" eine Unterzeile
	local server = self.Tab == "Server"
	local nameWidth = -104 - 230 - (if isMe then 48 else 0)
	Components.Label({
		Text = name,
		Font = Theme.Fonts.Title,
		TextSize = 18,
		TextColor3 = if isMe then Theme.Colors.Accent:Lerp(Theme.Colors.White, 0.25) else Theme.Colors.Text,
		TextStrokeTransparency = 0.6,
		TextStrokeColor3 = Theme.Colors.Shadow,
		RichText = false,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(104, if server then 6 else 0),
		Size = UDim2.new(1, nameWidth, 0, if server then 24 else 54),
		Parent = row,
	})
	if isMe then
		Components.Pill({
			Text = "DU",
			Color = Theme.Colors.Accent,
			Size = UDim2.fromOffset(40, 20),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -236, 0.5, 0),
			TextSize = 12,
			Parent = row,
		})
	end

	local value, unit
	if server then
		value, unit = Util.FormatNumber(entry.Wins or 0), "Siege"
		Components.Label({
			Text = string.format("Lv. %d  ·  %s RP", entry.Level or 1, Util.FormatNumber(entry.Rating or 0)),
			Font = Theme.Fonts.Medium,
			TextSize = 13,
			TextColor3 = Theme.Colors.TextDim,
			RichText = false,
			TextWrapped = false,
			Position = UDim2.fromOffset(104, 30),
			Size = UDim2.new(1, -104 - 230, 0, 18),
			Parent = row,
		})
	elseif self.Tab == "Wins" then
		value, unit = Util.FormatNumber(entry.Value or 0), "Siege"
	else
		value, unit = Util.FormatNumber(entry.Value or 0), "RP"
	end
	local valueColor = if medal then medal[1] else Theme.Colors.Text
	Components.Label({
		Text = string.format('<font color="%s">%s</font>  <font size="14" color="%s">%s</font>', toHex(valueColor), value, toHex(Theme.Colors.TextDim), unit),
		Font = Theme.Fonts.Title,
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextWrapped = false,
		TextStrokeTransparency = 0.6,
		TextStrokeColor3 = Theme.Colors.Shadow,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 0),
		Size = UDim2.fromOffset(200, 54),
		Parent = row,
	})
end

return Leaderboard
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="69">
              <Properties>
                <string name="Name">LobbyMenu</string>
                <string name="Source"><![CDATA[--[[
	LobbyMenu  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/UI/Screens/LobbyMenu

	Hauptmenü in der Lobby (links) und Status-Karte (unten mittig):
		- Spielen-Karte: Modus-Wahl (Schnelles Spiel / Ranked), großer
		  SPIELEN-Button (beitreten bzw. Warteschlange verlassen) und
		  Warteschlangenstatus mit Füllstandsbalken
		- Kachel-Menü: Training, Shop, Inventar, Statistik & Aufgaben,
		  Bestenliste, Einstellungen
		- Status-Karte: Warteschlange mit Countdown und nächster Map,
		  laufendes Rennen + Zuschauen/Anstellen, Trainingsleiste
		  (Checkpoint, Verlassen), Bereit-Hinweis
	Mit M (Gamepad: Select) oder dem MENÜ-Button (wichtig für Touch)
	einklappbar; auf reinen Touch-Geräten startet das Menü eingeklappt.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local MapDefinitions = require(Shared.MapDefinitions)

local UI = script.Parent.Parent
local Components = require(UI.Components)
local Theme = require(UI.Theme)

local new = Components.new
local player = Players.LocalPlayer

local MENU_WIDTH = 304
local MENU_OPEN = UDim2.fromOffset(16, 150)
local MENU_CLOSED = UDim2.fromOffset(-MENU_WIDTH - 40, 150)

-- Darstellung der beiden Spielmodi
local MODES = {
	QuickPlay = {
		Label = "SCHNELLES SPIEL",
		Icon = Theme.Icons.Quick,
		Color = Theme.Colors.Accent,
		PlayColor = Theme.Colors.Success,
		PlayGradient = Theme.Gradients.Play,
		Sub = "Schnelles Spiel · ohne Wertung",
		Leave = "QUEUE VERLASSEN",
		Attribute = "QueueQuickPlay",
	},
	Ranked = {
		Label = "RANKED",
		Icon = Theme.Icons.Ranked,
		Color = Theme.Colors.Gold,
		PlayColor = Theme.Colors.Gold,
		PlayGradient = Theme.Gradients.Gold,
		Sub = "Ranked · Punkte für deinen Rang",
		Leave = "RANKED VERLASSEN",
		Attribute = "QueueRanked",
	},
}
local MODE_ORDER = { "QuickPlay", "Ranked" }

-- Kacheln des Menüs: Symbol, Beschriftung, Farbe der Symbol-Blase, Aktion
local TILES = {
	{
		Icon = Theme.Icons.Training,
		Text = "TRAINING",
		Color = Theme.Colors.Success,
		Action = function(ui)
			ui:OpenModal("Practice")
		end,
	},
	{
		Icon = Theme.Icons.Shop,
		Text = "SHOP",
		Color = Theme.Colors.Gold,
		Action = function(ui)
			ui.Screens.Catalog:Open("Shop")
		end,
	},
	{
		Icon = Theme.Icons.Inventory,
		Text = "INVENTAR",
		Color = Theme.Colors.Purple,
		Action = function(ui)
			ui.Screens.Catalog:Open("Inventory")
		end,
	},
	{
		Icon = Theme.Icons.Stats,
		Text = "STATISTIK",
		Color = Theme.Colors.Accent,
		Action = function(ui)
			ui:OpenModal("Stats")
		end,
	},
	{
		Icon = Theme.Icons.Leaderboard,
		Text = "BESTENLISTE",
		Color = Theme.Colors.Orange,
		Action = function(ui)
			ui:OpenModal("Leaderboard")
		end,
	},
	{
		Icon = Theme.Icons.Settings,
		Text = "EINSTELLUNGEN",
		Color = Theme.Colors.PanelLight,
		Action = function(ui)
			ui:OpenModal("Settings")
		end,
	},
}

local LobbyMenu = {}
LobbyMenu.__index = LobbyMenu

local function mapName(id: string?): string
	local definition = id and MapDefinitions.GetAny(id)
	return if definition then definition.Name else "—"
end

function LobbyMenu.new(ui)
	local self = setmetatable({}, LobbyMenu)
	self.UI = ui
	self.Collapsed = false
	self.SelectedMode = "QuickPlay"
	self.LastQueue = ""
	self.PlayKey = nil
	self.CardKey = nil

	local menu = new("Frame", {
		Name = "LobbyMenu",
		BackgroundTransparency = 1,
		Position = MENU_OPEN,
		Size = UDim2.fromOffset(MENU_WIDTH, 440),
		Parent = ui.Root,
	})
	self.Menu = menu

	self:_buildPlayCard(menu)
	self:_buildTiles(menu)
	Components.Label({
		Text = "M: Menü ein/aus · G: Emote",
		TextSize = Theme.TextSize.Tiny - 1,
		Font = Theme.Fonts.Medium,
		TextColor3 = Theme.Colors.TextDim,
		TextStrokeTransparency = 0.7,
		TextStrokeColor3 = Theme.Colors.Shadow,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 420),
		Size = UDim2.fromOffset(MENU_WIDTH, 18),
		Parent = menu,
	})

	self:_buildToggle(ui)
	self:_buildStatusCard(ui)
	return self
end

-- Spielen-Karte: Modus-Wahl, SPIELEN-Button, Warteschlangenstatus
function LobbyMenu:_buildPlayCard(menu: Frame)
	local _, card = Components.Card({
		Name = "PlayCard",
		Size = UDim2.fromOffset(MENU_WIDTH, 218),
		BackgroundColor3 = Theme.Colors.Panel,
		BackgroundTransparency = 0.05,
		StrokeColor = Theme.Colors.Accent:Lerp(Theme.Colors.Stroke, 0.5),
		StrokeThickness = 2,
		CornerRadius = 18,
		Parent = menu,
	})
	-- Akzent-Schimmer im oberen Bereich
	local glow = new("Frame", {
		Name = "Glow",
		Position = UDim2.fromOffset(2, 2),
		Size = UDim2.new(1, -4, 0, 90),
		BackgroundColor3 = Theme.Colors.Accent,
		BorderSizePixel = 0,
		Parent = card,
	})
	Components.Corner(16).Parent = glow
	Components.Gradient(Theme.Colors.Accent, 90, { 0.78, 1 }).Parent = glow

	Components.Label({
		Text = "SPIELMODUS",
		Font = Theme.Fonts.Title,
		TextSize = 13,
		TextColor3 = Theme.Colors.TextDim,
		TextWrapped = false,
		Position = UDim2.fromOffset(16, 8),
		Size = UDim2.new(1, -32, 0, 18),
		Parent = card,
	})

	-- Modus-Wahl als Segment-Schalter
	local segments = new("Frame", {
		Name = "Modes",
		Position = UDim2.fromOffset(12, 30),
		Size = UDim2.new(1, -24, 0, 44),
		BackgroundColor3 = Theme.Colors.Shadow,
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		Parent = card,
	})
	Components.Corner(12).Parent = segments
	Components.Stroke(Theme.Colors.Black, 1, 0.6).Parent = segments
	Components.Padding(4).Parent = segments
	self.ModeButtons = {}
	for index, mode in MODE_ORDER do
		local info = MODES[mode]
		local button = Components.Button({
			Name = mode,
			Text = info.Icon .. " " .. info.Label,
			Size = UDim2.new(0.5, -3, 1, 0),
			Position = if index == 1 then UDim2.new() else UDim2.new(0.5, 3, 0, 0),
			Color = info.Color,
			TextColor = Theme.Colors.White,
			TextSize = 15,
			TextScaled = true,
			CornerRadius = 10,
			OnClick = function()
				self:_selectMode(mode)
			end,
		})
		button.Parent = segments
		self.ModeButtons[mode] = button
	end
	self.QuickButton = self.ModeButtons.QuickPlay
	self.RankedButton = self.ModeButtons.Ranked

	-- Großer SPIELEN-Button
	local play = Components.Button({
		Name = "Play",
		Text = "",
		Position = UDim2.fromOffset(12, 84),
		Size = UDim2.new(1, -24, 0, 76),
		Color = Theme.Colors.Success,
		Gradient = Theme.Gradients.Play,
		CornerRadius = 16,
		OnClick = function()
			self:_toggleQueue(self.SelectedMode)
		end,
	})
	play.Parent = card
	self.PlayButton = play
	local bubble = new("Frame", {
		Name = "Bubble",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(50, 50),
		BackgroundColor3 = Theme.Colors.White,
		BackgroundTransparency = 0.72,
		BorderSizePixel = 0,
		Parent = play,
	})
	new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = bubble })
	Components.Stroke(Theme.Colors.White, 2, 0.35).Parent = bubble
	self.PlayGlyph = Components.Label({
		Text = Theme.Icons.Play,
		Font = Theme.Fonts.Title,
		TextSize = 24,
		TextColor3 = Theme.Colors.White,
		TextStrokeTransparency = 0.6,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		RichText = false,
		Size = UDim2.fromScale(1, 1),
		Parent = bubble,
	})
	self.PlayTitle = Components.Heading({
		Text = "SPIELEN",
		TextSize = 30,
		TextScaled = true,
		MaxTextSize = 30,
		Position = UDim2.fromOffset(74, 9),
		Size = UDim2.new(1, -84, 0, 34),
		Outline = 2,
		OutlineTransparency = 0.1,
		Parent = play,
	})
	self.PlaySub = Components.Label({
		Text = "",
		Font = Theme.Fonts.Bold,
		TextSize = 13,
		TextColor3 = Theme.Colors.White,
		TextStrokeTransparency = 0.65,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(75, 46),
		Size = UDim2.new(1, -86, 0, 18),
		Parent = play,
	})
	Components.Shine(play, { Interval = 4 })

	-- Warteschlangenstatus
	local status = new("Frame", {
		Name = "QueueStatus",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(16, 168),
		Size = UDim2.new(1, -32, 0, 20),
		Parent = card,
	})
	self.QueueDot = new("Frame", {
		Name = "Dot",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(10, 10),
		BackgroundColor3 = Theme.Colors.TextDim,
		BorderSizePixel = 0,
		Parent = status,
	})
	new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = self.QueueDot })
	Components.Loop(self.QueueDot, 0.7, { BackgroundTransparency = 0.75 })
	self.QueueLabel = Components.Label({
		Text = "",
		Font = Theme.Fonts.Bold,
		TextSize = 14,
		TextColor3 = Theme.Colors.TextDim,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(18, 0),
		Size = UDim2.new(1, -18, 1, 0),
		Parent = status,
	})
	local bar, setBar = Components.ProgressBar({
		Name = "QueueBar",
		Position = UDim2.fromOffset(16, 196),
		Size = UDim2.new(1, -32, 0, 8),
		BackgroundColor = Theme.Colors.Shadow,
		BackgroundTransparency = 0.3,
		Color = Theme.Colors.Accent,
		Gradient = Theme.Gradients.Play,
		CornerRadius = 4,
		Parent = card,
	})
	self.QueueBar = bar
	self.SetQueueBar = setBar
end

-- Kachel-Menü (3 × 2)
function LobbyMenu:_buildTiles(menu: Frame)
	local grid = new("Frame", {
		Name = "Tiles",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 230),
		Size = UDim2.fromOffset(MENU_WIDTH, 180),
		Parent = menu,
	}, { Components.Grid(UDim2.fromOffset(96, 86), 8) })
	self.Tiles = {}
	for index, tile in TILES do
		local button = Components.IconButton({
			Name = tile.Text,
			Icon = tile.Icon,
			IconColor = tile.Color,
			IconSize = 28,
			Text = tile.Text,
			TextSize = 13,
			Color = Theme.Colors.PanelLight,
			LayoutOrder = index,
			OnClick = function()
				tile.Action(self.UI)
			end,
		})
		button.Parent = grid
		self.Tiles[tile.Text] = button
	end
end

-- Menü-Schalter (wichtig für Touch-Geräte ohne M-Taste) mit animiertem ☰/✕-Symbol
function LobbyMenu:_buildToggle(ui)
	local toggle = Components.Button({
		Name = "MenuToggle",
		Text = "SCHLIESSEN",
		Position = UDim2.fromOffset(596, 74),
		Size = UDim2.fromOffset(150, 48),
		TextSize = 16,
		CornerRadius = 14,
		ZIndex = 2,
		OnClick = function()
			self:ToggleCollapsed()
		end,
	})
	-- Beschriftung rechts neben dem Symbol
	local label = toggle:FindFirstChild("Label")
	if label then
		label.AnchorPoint = Vector2.new(0, 0.5)
		label.Position = UDim2.new(0, 38, 0.5, 0)
		label.Size = UDim2.new(1, -46, 1, 0)
	end
	toggle.Parent = ui.Root
	Components.Shadow(toggle, { Offset = 4, Spread = 4 })
	self.ToggleButton = toggle
	-- Drei Balken (☰), die sich beim Öffnen zu einem ✕ drehen
	local icon = new("Frame", {
		Name = "Hamburger",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(20, 20),
		ZIndex = 2,
		Parent = toggle,
	})
	self.MenuBars = {}
	for index = 1, 3 do
		local bar = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, (index - 2) * 6),
			Size = UDim2.fromOffset(20, 3),
			BackgroundColor3 = Theme.Colors.White,
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = icon,
		})
		Components.Corner(2).Parent = bar
		self.MenuBars[index] = bar
	end
	self:_renderToggleIcon(false)
end

function LobbyMenu:_renderToggleIcon(animate: boolean)
	local time = if animate then 0.22 else 0
	local open = not self.Collapsed
	local bars = self.MenuBars
	Components.Tween(bars[1], time, {
		Position = UDim2.new(0.5, 0, 0.5, if open then 0 else -6),
		Rotation = if open then 45 else 0,
	}, Enum.EasingStyle.Back)
	Components.Tween(bars[3], time, {
		Position = UDim2.new(0.5, 0, 0.5, if open then 0 else 6),
		Rotation = if open then -45 else 0,
	}, Enum.EasingStyle.Back)
	Components.Tween(bars[2], time, { BackgroundTransparency = if open then 1 else 0 })
end

-- Status-Karte unten mittig
function LobbyMenu:_buildStatusCard(ui)
	local holder, card = Components.Card({
		Name = "StatusCard",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -20),
		Size = UDim2.fromOffset(580, 104),
		BackgroundColor3 = Theme.Colors.PanelDark,
		BackgroundTransparency = 0.06,
		StrokeThickness = 2,
		CornerRadius = 18,
		Parent = ui.Root,
	})
	self.Card = holder
	self.CardPanel = card
	self.CardStroke = card:FindFirstChild("Border")
	self.CardTint = new("Frame", {
		Name = "Tint",
		Size = UDim2.fromScale(0.55, 1),
		BackgroundColor3 = Theme.Colors.Accent,
		BackgroundTransparency = 0.84,
		BorderSizePixel = 0,
		Parent = card,
	})
	Components.Corner(18).Parent = self.CardTint
	Components.Gradient(Theme.Colors.White, 0, { 0, 1 }).Parent = self.CardTint
	self.CardBar = new("Frame", {
		Name = "SideBar",
		Position = UDim2.fromOffset(7, 12),
		Size = UDim2.new(0, 5, 1, -24),
		BackgroundColor3 = Theme.Colors.Accent,
		BorderSizePixel = 0,
		Parent = card,
	})
	Components.Corner(3).Parent = self.CardBar
	local icon, glyph = Components.Icon({
		Glyph = Theme.Icons.Flag,
		Color = Theme.Colors.Accent,
		Size = 48,
		TextSize = 24,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 22, 0.5, 0),
		Parent = card,
	})
	glyph.TextStrokeTransparency = 1
	self.CardIcon = icon
	self.CardGlyph = glyph

	local textWidth = -(80 + 178)
	self.CardTitle = Components.Heading({
		Text = "",
		TextSize = Theme.TextSize.Large,
		TextScaled = true,
		MaxTextSize = Theme.TextSize.Large,
		TextColor3 = Theme.Colors.Accent,
		Outline = 1.5,
		OutlineTransparency = 0.2,
		Position = UDim2.fromOffset(80, 10),
		Size = UDim2.new(1, textWidth, 0, 28),
		Parent = card,
	})
	self.CardLine1 = Components.Label({
		Text = "",
		Font = Theme.Fonts.Medium,
		TextSize = 16,
		TextScaled = true,
		MaxTextSize = 16,
		Position = UDim2.fromOffset(80, 40),
		Size = UDim2.new(1, textWidth, 0, 22),
		Parent = card,
	})
	self.CardLine2 = Components.Label({
		Text = "",
		Font = Theme.Fonts.Medium,
		TextSize = Theme.TextSize.Tiny,
		TextScaled = true,
		MaxTextSize = Theme.TextSize.Tiny + 1,
		TextColor3 = Theme.Colors.TextDim,
		Position = UDim2.fromOffset(80, 63),
		Size = UDim2.new(1, textWidth, 0, 20),
		Parent = card,
	})
	local progress, setProgress = Components.ProgressBar({
		Name = "CardProgress",
		Position = UDim2.fromOffset(80, 88),
		Size = UDim2.new(1, textWidth, 0, 6),
		BackgroundColor = Theme.Colors.Shadow,
		BackgroundTransparency = 0.2,
		Color = Theme.Colors.Accent,
		Gradient = Theme.Gradients.Play,
		CornerRadius = 3,
		Parent = card,
	})
	self.CardProgress = progress
	self.SetCardProgress = setProgress

	self.CardButton = Components.Button({
		Name = "Primary",
		Text = "",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(160, 56),
		Color = Theme.Colors.Accent,
		TextColor = Theme.Colors.White,
		TextSize = Theme.TextSize.Large - 2,
		Font = Theme.Fonts.Title,
		CornerRadius = 14,
		OnClick = function()
			if self.CardAction then
				self.CardAction()
			end
		end,
	})
	self.CardButton.Parent = card
	self.CardButton2 = Components.Button({
		Name = "Secondary",
		Text = "",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 10),
		Size = UDim2.fromOffset(160, 38),
		TextSize = Theme.TextSize.Small,
		Visible = false,
		OnClick = function()
			if self.CardAction2 then
				self.CardAction2()
			end
		end,
	})
	self.CardButton2.Parent = card
end

function LobbyMenu:Start()
	-- Auf reinen Touch-Geräten startet das Menü eingeklappt (Platz für die Steuerung)
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		self:ToggleCollapsed()
	end
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator >= 0.15 then
			accumulator = 0
			self:_refresh()
		end
	end)
	self:_refresh()
end

--- True, wenn das Menü gerade sichtbar und ausgeklappt ist.
function LobbyMenu:IsOpen(): boolean
	return self.Menu.Visible and not self.Collapsed
end

function LobbyMenu:ToggleCollapsed()
	self.Collapsed = not self.Collapsed
	self.ToggleButton.Text = if self.Collapsed then "MENÜ" else "SCHLIESSEN"
	self:_renderToggleIcon(true)
	Components.Tween(
		self.Menu,
		if self.Collapsed then 0.25 else 0.35,
		{ Position = if self.Collapsed then MENU_CLOSED else MENU_OPEN },
		if self.Collapsed then Enum.EasingStyle.Quad else Enum.EasingStyle.Back,
		if self.Collapsed then Enum.EasingDirection.In else Enum.EasingDirection.Out
	)
end

function LobbyMenu:_toggleQueue(mode: string)
	local queued = player:GetAttribute("Queue") or ""
	if queued == mode then
		Remotes.QueueRequest:FireServer("Leave", mode)
	else
		Remotes.QueueRequest:FireServer("Join", mode)
	end
end

function LobbyMenu:_selectMode(mode: string)
	if self.SelectedMode ~= mode then
		self.SelectedMode = mode
		Components.Pop(self.PlayButton, 1.05, 0.3)
	end
	self:_refreshPlay(player:GetAttribute("Queue") or "")
end

-- Spielen-Karte an Modus-Wahl und Warteschlange anpassen
function LobbyMenu:_refreshPlay(queue: string)
	local gameState = self.UI.Ctx.ClientState.GameState
	local selected = MODES[self.SelectedMode] or MODES.QuickPlay
	for mode, button in self.ModeButtons do
		local active = mode == self.SelectedMode
		local border = button:FindFirstChild("Border")
		button.BackgroundTransparency = if active then 0 else 1
		button.TextColor3 = if active then Theme.Colors.White else Theme.Colors.TextDim
		if border then
			border.Transparency = if active then 0.05 else 1
		end
	end

	local maxPlayers = gameState:GetAttribute("MaxPlayers") or 8
	local minPlayers = gameState:GetAttribute("MinPlayers") or 2
	local queuedHere = queue == self.SelectedMode
	local key
	if queuedHere then
		key = "Leave" .. self.SelectedMode
		self.PlayTitle.Text = selected.Leave
		self.PlayGlyph.Text = Theme.Icons.Close
		self.PlaySub.Text = "Du wartest auf das nächste Rennen …"
	else
		key = "Join" .. self.SelectedMode
		self.PlayTitle.Text = "SPIELEN"
		self.PlayGlyph.Text = Theme.Icons.Play
		self.PlaySub.Text = if queue ~= "" then "Wechselt in diese Warteschlange" else selected.Sub
	end
	if key ~= self.PlayKey then
		self.PlayKey = key
		if queuedHere then
			Components.SetButtonColor(self.PlayButton, Theme.Colors.Danger)
		else
			Components.SetButtonColor(self.PlayButton, selected.PlayColor, selected.PlayGradient)
		end
		local stroke = self.PlayTitle:FindFirstChild("TextStroke")
		if stroke then
			local _, bottom = Theme.GradientFor(if queuedHere then Theme.Colors.Danger else selected.PlayColor)
			stroke.Color = bottom:Lerp(Theme.Colors.Black, 0.55)
		end
	end

	if queue ~= "" then
		local info = MODES[queue] or MODES.QuickPlay
		local count = gameState:GetAttribute(info.Attribute) or 0
		self.QueueDot.BackgroundColor3 = Theme.Colors.Success
		self.QueueLabel.TextColor3 = Theme.Colors.Text
		self.QueueLabel.Text = string.format("%s %s · %d / %d Spieler", Theme.Icons.Queue, info.Label, count, maxPlayers)
		self.QueueBar.Visible = true
		self.SetQueueBar(count / math.max(1, maxPlayers), 0.3)
	else
		self.QueueDot.BackgroundColor3 = Theme.Colors.TextDim
		self.QueueLabel.TextColor3 = Theme.Colors.TextDim
		self.QueueLabel.Text = string.format("Nächste Map: %s · ab %d Spielern", mapName(gameState:GetAttribute("NextMapId")), minPlayers)
		self.QueueBar.Visible = false
	end
end

function LobbyMenu:_setCard(title: string, line1: string, line2: string, buttonText: string?, action, color: Color3?, icon: string?, accent: Color3?, progress: number?)
	local accentColor = accent or Theme.Colors.Accent
	self.CardTitle.Text = title
	self.CardTitle.TextColor3 = accentColor:Lerp(Theme.Colors.White, 0.2)
	self.CardLine1.Text = line1
	self.CardLine2.Text = line2
	self.CardButton.Visible = buttonText ~= nil
	self.CardButton.Text = buttonText or ""
	self.CardAction = action
	self.CardProgress.Visible = progress ~= nil
	if progress then
		self.SetCardProgress(progress, 0.3)
	end
	-- Farben/Symbol nur bei Zustandswechsel neu setzen (mit kleinem Hüpfer)
	local key = title .. "|" .. tostring(buttonText) .. "|" .. tostring(icon)
	if key ~= self.CardKey then
		self.CardKey = key
		Components.SetButtonColor(self.CardButton, color or Theme.Colors.Accent)
		Components.SetIconColor(self.CardIcon, accentColor)
		self.CardGlyph.Text = icon or Theme.Icons.Flag
		self.CardBar.BackgroundColor3 = accentColor
		self.CardTint.BackgroundColor3 = accentColor
		if self.CardStroke then
			self.CardStroke.Color = accentColor:Lerp(Theme.Colors.Stroke, 0.5)
		end
		Components.Pop(self.CardIcon, 1.2, 0.4)
	end
end

function LobbyMenu:_setSecond(text: string?, action)
	self.CardButton2.Visible = text ~= nil
	self.CardButton2.Text = text or ""
	self.CardAction2 = action
	if text then
		self.CardButton.Position = UDim2.new(1, -14, 1, -10)
		self.CardButton.AnchorPoint = Vector2.new(1, 1)
		self.CardButton.Size = UDim2.fromOffset(160, 40)
	else
		self.CardButton.Position = UDim2.new(1, -14, 0.5, 0)
		self.CardButton.AnchorPoint = Vector2.new(1, 0.5)
		self.CardButton.Size = UDim2.fromOffset(160, 56)
	end
end

function LobbyMenu:_refresh()
	local ctx = self.UI.Ctx
	local state = ctx.ClientState
	local gameState = state.GameState
	local spectating = ctx.CameraController:GetSpectate() ~= nil
	local inRace = state:IsInRace()
	local visible = not inRace and not spectating
	self.Menu.Visible = visible
	self.Card.Visible = visible
	self.ToggleButton.Visible = visible
	if not visible then
		return
	end

	local queue = player:GetAttribute("Queue") or ""
	local course = state:GetPracticeCourse()
	local phase = gameState:GetAttribute("Phase") or "Waiting"
	local nextMap = mapName(gameState:GetAttribute("NextMapId"))
	local minPlayers = gameState:GetAttribute("MinPlayers") or 2
	local maxPlayers = gameState:GetAttribute("MaxPlayers") or 8

	-- Beim Beitritt (egal über welchen Button) den passenden Modus vorwählen
	if queue ~= self.LastQueue then
		self.LastQueue = queue
		if queue ~= "" and MODES[queue] then
			self.SelectedMode = queue
		end
	end
	self:_refreshPlay(queue)

	self:_setSecond(nil)
	if course ~= "" then
		local queueInfo = if queue ~= "" then "  ·  In Warteschlange" else ""
		self:_setCard(
			"TRAINING: " .. string.upper(mapName(course)),
			"Keine Wertung, keine Belohnungen – übe in Ruhe." .. queueInfo,
			"R = zum Checkpoint  ·  Das Rennen holt dich automatisch ab.",
			"VERLASSEN",
			function()
				Remotes.PracticeRequest:FireServer("Leave")
			end,
			Theme.Colors.Danger,
			Theme.Icons.Training,
			Theme.Colors.Success
		)
		self:_setSecond("CHECKPOINT", function()
			Remotes.PracticeRequest:FireServer("Reset")
		end)
	elseif queue ~= "" then
		local info = MODES[queue] or MODES.QuickPlay
		local count = gameState:GetAttribute(info.Attribute) or 0
		local modeName = if queue == "Ranked" then "RANKED" else "SCHNELLES SPIEL"
		local line2 = "Nächste Map: " .. nextMap
		if phase == "Starting" and gameState:GetAttribute("Mode") == queue then
			local remaining = math.max(0, math.ceil((gameState:GetAttribute("PhaseEndsAt") or 0) - workspace:GetServerTimeNow()))
			line2 = string.format("Rennen startet in %d s  ·  Map: %s", remaining, nextMap)
		elseif phase ~= "Waiting" and phase ~= "Starting" then
			line2 = "Ein Rennen läuft – du bist in der nächsten Runde dabei."
		end
		self:_setCard(
			"WARTESCHLANGE · " .. modeName,
			string.format("%d / %d Spieler (mindestens %d)", count, maxPlayers, minPlayers),
			line2,
			"VERLASSEN",
			function()
				Remotes.QueueRequest:FireServer("Leave", queue)
			end,
			Theme.Colors.Danger,
			Theme.Icons.Queue,
			info.Color,
			math.clamp(count / math.max(1, minPlayers), 0, 1)
		)
	elseif (phase == "Countdown" or phase == "Racing" or phase == "Loading") and (gameState:GetAttribute("MapId") or "") ~= "" then
		local alive = gameState:GetAttribute("Alive") or 0
		local participants = gameState:GetAttribute("Participants") or 0
		self:_setCard(
			"RENNEN LÄUFT · " .. string.upper(mapName(gameState:GetAttribute("MapId"))),
			string.format("%d von %d Spielern noch im Rennen", alive, participants),
			"Stell dich an, um in der nächsten Runde dabei zu sein.",
			"ZUSCHAUEN",
			function()
				self.UI.Screens.RaceHud:StartSpectating()
			end,
			Theme.Colors.Accent2,
			Theme.Icons.Spectate,
			Theme.Colors.Accent2
		)
		self:_setSecond("ANSTELLEN", function()
			Remotes.QueueRequest:FireServer("Join", "QuickPlay")
		end)
	else
		self:_setCard(
			"BEREIT FÜR DAS NÄCHSTE RENNEN?",
			"Nächste Map: " .. nextMap,
			string.format("Mindestens %d Spieler · bis zu %d pro Rennen", minPlayers, maxPlayers),
			"SPIELEN",
			function()
				Remotes.QueueRequest:FireServer("Join", "QuickPlay")
			end,
			Theme.Colors.Success,
			Theme.Icons.Flag,
			Theme.Colors.Accent
		)
	end
end

return LobbyMenu
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="70">
              <Properties>
                <string name="Name">Notifications</string>
                <string name="Source"><![CDATA[--[[
	Notifications  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/UI/Screens/Notifications

	Kurze Hinweise („Toasts“) oben in der Bildschirmmitte (Info, Erfolg,
	Warnung, Fehler, Belohnung) sowie Meldungen zu Aufgaben, Erfolgen und
	Level-Ups. Jeder Toast hat ein Symbol, einen farbigen Seitenbalken und
	einen Schatten; er gleitet von oben herein und wieder hinaus.
	Höchstens 4 Toasts gleichzeitig, Anzeigedauer 3,6 s.

	API: :Push(text, kind)   kind = "Info" | "Success" | "Warning" | "Error" | "Reward"
]]

local UI = script.Parent.Parent
local Components = require(UI.Components)
local Theme = require(UI.Theme)

local new = Components.new

local TOAST_WIDTH = 540
local TOAST_HEIGHT = 52
local LIFETIME = 3.6
local MAX_TOASTS = 4

local Notifications = {}
Notifications.__index = Notifications

local KINDS = {
	Info = { Color = Theme.Colors.Accent, Icon = Theme.Icons.Info },
	Success = { Color = Theme.Colors.Success, Icon = Theme.Icons.Check },
	Warning = { Color = Theme.Colors.Warning, Icon = Theme.Icons.Warning },
	Error = { Color = Theme.Colors.Danger, Icon = Theme.Icons.Error },
	Reward = { Color = Theme.Colors.Gold, Icon = Theme.Icons.Reward },
}

function Notifications.new(ui)
	local self = setmetatable({}, Notifications)
	self.UI = ui
	self.Container = new("Frame", {
		Name = "Notifications",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 176),
		Size = UDim2.fromOffset(TOAST_WIDTH + 30, 300),
		ZIndex = 50,
		Parent = ui.Root,
	}, { Components.List(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center) })
	self.Count = 0
	return self
end

function Notifications:Start()
	local state = self.UI.Ctx.ClientState
	state:On("Notify", function(payload)
		self:Push(payload.Text or "", payload.Kind)
	end)
	state:On("QuestCompleted", function(payload)
		self:Push(string.format("Aufgabe erledigt: %s  (+%d Coins, +%d XP)", payload.Name, payload.Coins, payload.XP), "Reward")
	end)
	state:On("AchievementUnlocked", function(payload)
		self:Push(string.format("Erfolg freigeschaltet: %s  (+%d Coins)", payload.Name, payload.Coins), "Reward")
	end)
	state:On("LevelUp", function(payload)
		self:Push(string.format("LEVEL UP! Du bist jetzt Level %d  (+%d Coins)", payload.Level, payload.Coins), "Reward")
	end)
end

-- Baut einen Toast; Rückgabe: holder (Listeneintrag), body (gleitender Inhalt), fades
-- fades = { { Instanz, Eigenschaft, sichtbarer Wert } } für Ein-/Ausblenden
local function buildToast(text: string, kind)
	local fades = {}
	local function fade(instance: Instance, property: string, value: number)
		table.insert(fades, { instance, property, value })
	end

	local holder = new("Frame", {
		Name = "Toast",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(TOAST_WIDTH, TOAST_HEIGHT),
		ZIndex = 50,
	})
	-- Inhalt gleitet innerhalb des Halters (die Liste selbst bleibt ruhig)
	local body = new("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 50,
		Parent = holder,
	})
	for _, layer in { { 8, 0.8 }, { 3, 0.62 } } do
		local shadow = new("Frame", {
			Name = "ShadowLayer",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 5),
			Size = UDim2.new(1, layer[1] * 2, 1, layer[1] * 2),
			BackgroundColor3 = Theme.Colors.Shadow,
			BorderSizePixel = 0,
			ZIndex = 50,
			Parent = body,
		})
		Components.Corner(Theme.Corner + layer[1]).Parent = shadow
		fade(shadow, "BackgroundTransparency", layer[2])
	end

	local panel = Components.Panel({
		Name = "Panel",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Colors.PanelDark,
		StrokeColor = kind.Color,
		StrokeThickness = 2,
		ZIndex = 51,
		Parent = body,
	})
	fade(panel, "BackgroundTransparency", 0.06)
	local border = panel:FindFirstChild("Border")
	if border then
		fade(border, "Transparency", 0.15)
	end
	-- Farbiger Schimmer von links
	local tint = new("Frame", {
		Name = "Tint",
		Size = UDim2.fromScale(0.6, 1),
		BackgroundColor3 = kind.Color,
		BorderSizePixel = 0,
		ZIndex = 51,
		Parent = panel,
	})
	Components.Corner(Theme.Corner).Parent = tint
	Components.Gradient(kind.Color, 0, { 0, 1 }).Parent = tint
	fade(tint, "BackgroundTransparency", 0.82)
	-- Seitenbalken
	local bar = new("Frame", {
		Name = "SideBar",
		Position = UDim2.fromOffset(6, 7),
		Size = UDim2.new(0, 5, 1, -14),
		BackgroundColor3 = kind.Color,
		BorderSizePixel = 0,
		ZIndex = 52,
		Parent = panel,
	})
	Components.Corner(3).Parent = bar
	fade(bar, "BackgroundTransparency", 0)

	local icon, glyph = Components.Icon({
		Glyph = kind.Icon,
		Color = kind.Color,
		Size = 34,
		TextSize = 18,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 20, 0.5, 0),
		ZIndex = 52,
		Parent = panel,
	})
	fade(icon, "BackgroundTransparency", 0)
	fade(glyph, "TextTransparency", 0)
	fade(glyph, "TextStrokeTransparency", 0.5)
	local iconStroke = icon:FindFirstChildOfClass("UIStroke")
	if iconStroke then
		fade(iconStroke, "Transparency", 0.55)
	end

	local label = Components.Label({
		Text = text,
		Font = Theme.Fonts.Bold,
		Position = UDim2.fromOffset(66, 0),
		Size = UDim2.new(1, -80, 1, 0),
		TextScaled = true,
		MaxTextSize = Theme.TextSize.Body,
		TextColor3 = Theme.Colors.Text,
		ZIndex = 52,
		Parent = panel,
	})
	new("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), Parent = label })
	fade(label, "TextTransparency", 0)
	return holder, body, fades
end

local function setFaded(fades, alpha: number, time: number)
	-- alpha 0 = sichtbar, 1 = ausgeblendet
	for _, entry in fades do
		local instance, property, visible = entry[1], entry[2], entry[3]
		local value = visible + (1 - visible) * alpha
		if time > 0 then
			Components.Tween(instance, time, { [property] = value })
		else
			instance[property] = value
		end
	end
end

function Notifications:Push(text: string, kind: string?)
	if text == "" then
		return
	end
	local style = KINDS[kind or "Info"] or KINDS.Info
	self.Count += 1
	local holder, body, fades = buildToast(text, style)
	holder.LayoutOrder = self.Count
	setFaded(fades, 1, 0)
	body.Position = UDim2.fromOffset(0, -18)
	holder.Parent = self.Container

	-- Hereingleiten + Aufblenden
	setFaded(fades, 0, 0.22)
	Components.Tween(body, 0.35, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back)
	if kind == "Reward" then
		Components.Pop(body, 1.08, 0.4)
	end

	local toasts = {}
	for _, child in self.Container:GetChildren() do
		if child.Name == "Toast" then
			table.insert(toasts, child)
		end
	end
	if #toasts > MAX_TOASTS then
		table.sort(toasts, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		toasts[1]:Destroy()
	end

	task.delay(LIFETIME, function()
		if holder.Parent then
			-- Hinausgleiten nach rechts + Ausblenden
			setFaded(fades, 1, 0.3)
			Components.Tween(body, 0.3, { Position = UDim2.fromOffset(40, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.wait(0.32)
			holder:Destroy()
		end
	end)
end

return Notifications
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="71">
              <Properties>
                <string name="Name">Practice</string>
                <string name="Source"><![CDATA[--[[
	Practice  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/UI/Screens/Practice

	Auswahl des Trainingsmodus: Bewegungs-Tutorial oder freies Training auf
	einer der Rennstrecken (ohne Gefahrenzone, ohne Belohnungen).

	Darstellung: Hinweis-Leiste oben, darunter je Strecke eine Glas-Karte mit
	Vorschaubild (Verlauf in den Theme-Farben der Map + Symbol), Name,
	Schwierigkeits-Chip mit Sternen, Beschreibung und START-Button.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local MapDefinitions = require(Shared.MapDefinitions)

local UI = script.Parent.Parent
local Components = require(UI.Components)
local Theme = require(UI.Theme)

local new = Components.new

local Practice = {}
Practice.__index = Practice

-- Symbol je Strecke (Unicode/Emoji)
local MAP_GLYPHS = {
	Tutorial = "🎓",
	NeonMetropolis = "🌃",
	MagmaWorks = "🌋",
	SkywayRuins = "☁️",
	GlacierCircuit = "🏔️",
	JungleVelocity = "🌴",
}

local DIFFICULTY = {
	{ Text = "LEICHT", Color = Theme.Colors.Success },
	{ Text = "MITTEL", Color = Theme.Colors.Warning },
	{ Text = "SCHWER", Color = Theme.Colors.Danger },
}

function Practice.new(ui)
	local self = setmetatable({}, Practice)
	self.UI = ui
	local modal = Components.Modal({
		Name = "Practice",
		Title = "TRAINING",
		Icon = Theme.Icons.Training,
		Accent = Theme.Colors.Success,
		Size = UDim2.fromOffset(900, 580),
		Parent = ui.Root,
	})
	self.Modal = modal
	ui:RegisterModal("Practice", modal)

	-- Hinweis-Leiste
	local info = new("Frame", {
		Name = "Info",
		BackgroundColor3 = Theme.Colors.Accent,
		BackgroundTransparency = 0.88,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 52),
		Parent = modal.Content,
	})
	Components.Corner(12).Parent = info
	Components.Stroke(Theme.Colors.Accent, 1.5, 0.5).Parent = info
	Components.Icon({
		Glyph = Theme.Icons.Info,
		Color = Theme.Colors.Accent,
		Size = 32,
		TextSize = 18,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		Parent = info,
	})
	Components.Label({
		Text = "Übe Bewegung, Greifhaken und Abkürzungen ohne Druck. Im Training gibt es keine Gefahrenzone, keine Coins, keine XP und keine Statistiken. Startet ein Rennen, wirst du automatisch abgeholt.",
		Font = Theme.Fonts.Medium,
		TextSize = Theme.TextSize.Small - 1,
		TextScaled = true,
		MaxTextSize = Theme.TextSize.Small - 1,
		TextColor3 = Theme.Colors.Text,
		Position = UDim2.fromOffset(52, 5),
		Size = UDim2.new(1, -64, 1, -10),
		Parent = info,
	})

	local list = new("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 62),
		Size = UDim2.new(1, 0, 1, -62),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Colors.Stroke,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = modal.Content,
	}, { Components.List(Enum.FillDirection.Vertical, 10), Components.Padding(4, 8, 8, 2) })

	local courses = { MapDefinitions.Tutorial }
	for _, id in MapDefinitions.Order do
		table.insert(courses, MapDefinitions.Maps[id])
	end
	for index, definition in courses do
		self:_courseCard(list, index, definition)
	end
	return self
end

function Practice:_courseCard(list: Instance, index: number, definition)
	local theme = definition.Theme or {}
	local accent = theme.Accent or Theme.Colors.Accent
	local accent2 = theme.Accent2 or Theme.Colors.Accent2
	local difficulty = math.clamp(definition.Difficulty or 1, 1, 3)
	local isTutorial = definition.Id == MapDefinitions.Tutorial.Id
	local _, card = Components.Card({
		Name = definition.Id,
		Size = UDim2.new(1, -6, 0, 96),
		BackgroundColor3 = Theme.Colors.PanelDark,
		StrokeColor = accent,
		StrokeTransparency = 0.3,
		CornerRadius = 14,
		ShadowOffset = 3,
		ShadowSpread = 4,
		LayoutOrder = index,
		Parent = list,
	})
	-- Schimmer in der Map-Farbe von links
	local tint = new("Frame", {
		Name = "Tint",
		Size = UDim2.fromScale(0.6, 1),
		BackgroundColor3 = accent,
		BackgroundTransparency = 0.7,
		BorderSizePixel = 0,
		Parent = card,
	})
	Components.Corner(14).Parent = tint
	Components.Gradient(Theme.Colors.White, 0, { 0.3, 1 }).Parent = tint

	-- Vorschaubild: Verlauf aus den Theme-Farben + Symbol
	local thumb = new("Frame", {
		Name = "Thumbnail",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(76, 76),
		BackgroundColor3 = Theme.Colors.White,
		BorderSizePixel = 0,
		Parent = card,
	})
	Components.Corner(14).Parent = thumb
	Components.Gradient({ accent, accent2:Lerp(Theme.Colors.PanelDark, 0.35) }, 135).Parent = thumb
	Components.Stroke(Theme.Colors.White, 2, 0.45).Parent = thumb
	Components.Label({
		Text = MAP_GLYPHS[definition.Id] or Theme.Icons.Flag,
		TextSize = 38,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		RichText = false,
		Size = UDim2.fromScale(1, 1),
		Parent = thumb,
	})

	Components.Heading({
		Text = definition.Name,
		TextSize = 21,
		TextScaled = true,
		MaxTextSize = 21,
		Outline = 1.5,
		RichText = false,
		Position = UDim2.fromOffset(102, 10),
		Size = UDim2.new(1, -102 - 190 - 200, 0, 28),
		Parent = card,
	})
	-- Chips: Schwierigkeit (+ Empfehlung beim Tutorial)
	local chips = new("Frame", {
		Name = "Chips",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -190, 0, 13),
		Size = UDim2.fromOffset(196, 22),
		Parent = card,
	}, { Components.List(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center) })
	local level = DIFFICULTY[difficulty]
	if isTutorial then
		Components.Pill({ Text = Theme.Icons.Star .. " EMPFOHLEN", Color = Theme.Colors.Accent, Size = UDim2.fromOffset(98, 22), TextSize = 12, LayoutOrder = 1, Parent = chips })
	end
	Components.Pill({
		Text = string.rep("★", difficulty) .. string.rep("☆", 3 - difficulty) .. " " .. level.Text,
		Color = level.Color,
		Size = UDim2.fromOffset(92, 22),
		TextSize = 12,
		LayoutOrder = 2,
		Parent = chips,
	})
	Components.Label({
		Text = definition.Description or "",
		Font = Theme.Fonts.Medium,
		TextSize = Theme.TextSize.Small - 1,
		TextColor3 = Theme.Colors.TextDim,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(102, 44),
		Size = UDim2.new(1, -102 - 190, 0, 40),
		Parent = card,
	})
	local button = Components.Button({
		Text = "STARTEN",
		Icon = Theme.Icons.Play,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.5, 0),
		Size = UDim2.fromOffset(160, 52),
		Color = Theme.Colors.Success,
		Gradient = Theme.Gradients.Play,
		TextColor = Theme.Colors.White,
		TextSize = 20,
		Font = Theme.Fonts.Title,
		CornerRadius = 14,
		OnClick = function()
			Remotes.PracticeRequest:FireServer("Enter", definition.Id)
			self.Modal.Close()
		end,
	})
	button.Parent = card
	if isTutorial then
		Components.Shine(button, { Interval = 4 })
	end
end

function Practice:Start()
	self.UI.Ctx.ClientState:On("OpenScreen", function(payload)
		if payload.Screen == "Practice" then
			self.UI:OpenModal("Practice")
		end
	end)
end

return Practice
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="72">
              <Properties>
                <string name="Name">RaceHud</string>
                <string name="Source"><![CDATA[--[[
	RaceHud  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/UI/Screens/RaceHud

	Renn-Oberfläche im Stil des Designsystems (Theme/Components):
		- Countdown 3-2-1-LOS! in großer Display-Schrift mit dicker Kontur,
		  Farbverlauf je Zahl, Dreh-/Skalier-Pop und Schockwellen-Ring
		- Kopfbereich: Map/Modus-Chip, eigene Platzierung als Plakette,
		  Renn-Timer (Glas-Karte mit Kontur), Streckenfortschritt (Verlauf,
		  Checkpoint-Rauten, pulsierende Gefahrenzone mit Kante, Spielerpunkte –
		  eigener Punkt hervorgehoben, Führender golden)
		- Live-Platzierungen mit Gold-/Silber-/Bronze-Plaketten und Status-Chips
		- Gefahrenzone: Banner-Band, roter Bildschirmrand (Vignette + leichte
		  Tönung) und Warnkarte mit Restzeit-Balken
		- Power-up-Slot (leuchtender, pulsierender Ring + Symbol je Item,
		  Tastenkappe) und Cooldown-Ringe für Haken, Dash und Slide
		- Ereignis-Feed mit Symbolen (gleitet ein und blendet aus),
		  Ausgeschieden-Karte, Zuschauerleiste
		- Pfeile für Spieler außerhalb des Bildschirms
	Im Training werden nur Item-Slot und Cooldowns angezeigt.

	Pro Frame werden nur vorhandene Objekte aktualisiert (Farben/Texte nur
	bei Zustandswechsel), neue Instanzen entstehen nur bei Ereignissen.

	API:
		:StartSpectating()
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local MapDefinitions = require(Shared.MapDefinitions)
local ItemDefinitions = require(Shared.ItemDefinitions)

local UI = script.Parent.Parent
local Components = require(UI.Components)
local Theme = require(UI.Theme)

local player = Players.LocalPlayer
local new = Components.new
local rgb = Color3.fromRGB

local RaceHud = {}
RaceHud.__index = RaceHud

local KEY_HINTS = {
	Keyboard = { Grapple = "E", Dash = "SHIFT", Slide = "SHIFT", Item = "Q" },
	Gamepad = { Grapple = "X", Dash = "B", Slide = "B", Item = "Y" },
	Touch = { Grapple = "", Dash = "", Slide = "", Item = "" },
}

-- Status-Chips in der Platzierungsliste
local STATUS_CHIPS = {
	Eliminated = { Text = "RAUS", Color = Theme.Colors.Danger },
	Left = { Text = "WEG", Color = Theme.Colors.TextDim },
	Finished = { Text = "ZIEL", Color = Theme.Colors.Gold },
}

local REASON_TEXT = {
	Zone = "von der Gefahrenzone erwischt",
	Left = "hat das Spiel verlassen",
}

-- Symbole der Power-ups (Unicode/Emoji, keine Bild-Assets)
local ITEM_GLYPHS = {
	SpeedBoost = "⚡",
	Shield = "🛡️",
	FreezeBurst = "❄️",
	GrappleUpgrade = Theme.Icons.Hook,
	TeleportBeacon = "🌀",
	Trap = "💣",
}

-- Fähigkeiten: Schlüssel, Beschriftung, Symbol, Farbe des Cooldown-Rings
local ABILITIES = {
	{ Key = "Grapple", Label = "HAKEN", Glyph = Theme.Icons.Hook, Color = Theme.Colors.Accent },
	{ Key = "Dash", Label = "DASH", Glyph = "💨", Color = Theme.Colors.Orange },
	{ Key = "Slide", Label = "SLIDE", Glyph = "🏂", Color = Theme.Colors.Purple },
}

-- Plaketten-Verläufe für die Plätze 1–3 (Gold, Silber, Bronze)
local MEDALS = {
	{ rgb(255, 234, 100), rgb(255, 154, 18) },
	{ rgb(242, 246, 255), rgb(146, 158, 186) },
	{ rgb(255, 196, 140), rgb(184, 96, 38) },
}

-- Countdown-Farben: 3 rot, 2 orange, 1 gelb, LOS! grün-cyan, BEREIT? cyan
local COUNTDOWN_STYLE = {
	[3] = Theme.Gradients.Danger,
	[2] = Theme.Gradients.Orange,
	[1] = Theme.Gradients.Warning,
	[0] = Theme.Gradients.Play,
	[4] = Theme.Gradients.Accent,
}

local function pairSequence(pair)
	return ColorSequence.new(pair[1], pair[2])
end

-- Kleine Tastenkappe (z. B. "E", "SHIFT"); Rückgabe: frame, label
local function keyCap(props)
	local cap = new("Frame", {
		Name = "KeyCap",
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		Position = props.Position or UDim2.new(),
		Size = UDim2.fromOffset(22, 20),
		BackgroundColor3 = Theme.Colors.White,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 3,
		Parent = props.Parent,
	})
	Components.Corner(6).Parent = cap
	Components.Gradient({ rgb(92, 104, 170), rgb(38, 44, 90) }, 90).Parent = cap
	Components.Stroke(Theme.Colors.Black, 1.5, 0.25).Parent = cap
	local label = Components.Label({
		Name = "Key",
		Text = "",
		Font = Theme.Fonts.Black,
		TextSize = 11,
		TextColor3 = Theme.Colors.White,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		RichText = false,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 3,
		Parent = cap,
	})
	return cap, label
end

-- Tastenkappe beschriften (leerer Text = ausblenden, z. B. auf Touch-Geräten)
local function setKeyCap(cap: Frame, label: TextLabel, text: string)
	cap.Visible = text ~= ""
	if label.Text ~= text then
		label.Text = text
		cap.Size = UDim2.fromOffset(math.max(22, 10 + 8 * (utf8.len(text) or #text)), 20)
	end
end

function RaceHud.new(ui)
	local self = setmetatable({}, RaceHud)
	self.UI = ui
	self.Ctx = ui.Ctx
	self.LastCountdown = nil
	self.LastZoneState = "Inactive"
	self.BannerUntil = 0
	self.FinalTime = nil
	self.Rows = {}
	self.Dots = {}
	self.Ticks = {}
	self.LastItem = nil

	local root = new("Frame", { Name = "RaceHud", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = ui.Root })
	self.Root = root

	self:_buildDanger(root)
	self:_buildTop(root)
	self:_buildCountdown(root)
	self:_buildStandings(root)
	self:_buildItemSlot(root)
	self:_buildAbilities(root)

	-- Ereignis-Feed (links; auf Touch-Geräten höher, über den Lauf-Buttons)
	self.Feed = new("Frame", {
		Name = "Feed",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = if UserInputService.TouchEnabled then UDim2.new(0, 16, 0.5, -30) else UDim2.new(0, 16, 0.62, 0),
		Size = UDim2.fromOffset(420, 230),
		Parent = root,
	}, { Components.List(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Bottom) })
	self.FeedCount = 0

	self:_buildEliminated(root)
	self:_buildSpectate(root)
	self:_buildIndicators(root)
	return self
end

------------------------------------------------------------------------
-- Aufbau
------------------------------------------------------------------------

-- Gefahren-Vignette, Tönung, Banner-Band und Warnkarte
function RaceHud:_buildDanger(root: Frame)
	-- Vier Ränder mit Farbverlauf (dunkelrot am Rand -> transparent zur Mitte)
	self.Vignette = {}
	local edges = {
		{ Size = UDim2.new(0, 300, 1, 0), Position = UDim2.fromScale(0, 0), Rotation = 0 },
		{ Size = UDim2.new(0, 300, 1, 0), Position = UDim2.new(1, -300, 0, 0), Rotation = 180 },
		{ Size = UDim2.new(1, 0, 0, 210), Position = UDim2.fromScale(0, 0), Rotation = 90 },
		{ Size = UDim2.new(1, 0, 0, 210), Position = UDim2.new(0, 0, 1, -210), Rotation = 270 },
	}
	for _, edge in edges do
		local frame = new("Frame", {
			Name = "Vignette",
			Size = edge.Size,
			Position = edge.Position,
			BackgroundColor3 = Theme.Colors.White,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Parent = root,
		})
		new("UIGradient", {
			Rotation = edge.Rotation,
			Color = ColorSequence.new(rgb(140, 0, 26), Theme.Colors.Danger),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(0.45, 0.6),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = frame,
		})
		table.insert(self.Vignette, frame)
	end
	-- Sehr leichte rote Tönung des ganzen Bildes bei akuter Gefahr
	self.DangerTint = new("Frame", {
		Name = "DangerTint",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Colors.Danger,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = root,
	})

	-- Banner-Band (Zonen-Meldungen)
	local banner = new("Frame", {
		Name = "Banner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 142),
		Size = UDim2.fromOffset(760, 50),
		BackgroundColor3 = Theme.Colors.White,
		BorderSizePixel = 0,
		Visible = false,
		Parent = root,
	})
	self.Banner = banner
	self.BannerGradient = Components.Gradient({ Theme.Colors.Danger, Theme.Colors.Danger }, 0, { 1, 0.12, 0.12, 1 })
	self.BannerGradient.Parent = banner
	for _, y in { 0, 1 } do
		Components.Divider({
			Name = "Edge",
			AnchorPoint = Vector2.new(0, y),
			Position = UDim2.fromScale(0, y),
			Size = UDim2.new(1, 0, 0, 2),
			Colors = { Theme.Colors.White, Theme.Colors.White },
			Parent = banner,
		})
	end
	self.BannerLabel = Components.Heading({
		Name = "Text",
		Text = "",
		Font = Theme.Fonts.Display,
		TextSize = 30,
		TextScaled = true,
		MaxTextSize = 30,
		TextXAlignment = Enum.TextXAlignment.Center,
		Outline = 2.5,
		OutlineTransparency = 0,
		RichText = false,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -60, 1, -10),
		Parent = banner,
	})

	-- Warnkarte "ZURÜCK NACH VORNE!" mit Restzeit-Balken
	local card = new("Frame", {
		Name = "DangerCard",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 112),
		Size = UDim2.fromOffset(470, 74),
		BackgroundColor3 = Theme.Colors.White,
		BorderSizePixel = 0,
		Visible = false,
		Parent = root,
	})
	Components.Corner(18).Parent = card
	Components.Gradient(Theme.Gradients.Danger, 90).Parent = card
	Components.Stroke(Theme.Colors.White, 2.5, 0.2).Parent = card
	self.DangerPanel = card
	self.DangerScale = new("UIScale", { Parent = card })
	local _, warnGlyph = Components.Icon({
		Glyph = Theme.Icons.Warning,
		Color = Theme.Colors.Warning,
		Size = 50,
		TextSize = 30,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Parent = card,
	})
	warnGlyph.TextStrokeTransparency = 0.3
	local darkRed = rgb(86, 0, 20)
	self.DangerLabel = Components.Heading({
		Text = "ZURÜCK NACH VORNE!",
		Font = Theme.Fonts.Display,
		TextSize = 28,
		TextScaled = true,
		MaxTextSize = 28,
		Outline = 2.5,
		OutlineColor = darkRed,
		OutlineTransparency = 0,
		RichText = false,
		Position = UDim2.fromOffset(74, 8),
		Size = UDim2.new(1, -176, 0, 32),
		Parent = card,
	})
	self.DangerTime = Components.Heading({
		Text = "",
		TextSize = 30,
		TextXAlignment = Enum.TextXAlignment.Right,
		Outline = 2.5,
		OutlineColor = darkRed,
		OutlineTransparency = 0,
		RichText = false,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 6),
		Size = UDim2.fromOffset(96, 36),
		Parent = card,
	})
	local _, setBar = Components.ProgressBar({
		Name = "DangerBar",
		Position = UDim2.fromOffset(74, 50),
		Size = UDim2.new(1, -92, 0, 10),
		BackgroundColor = darkRed,
		BackgroundTransparency = 0.25,
		Color = Theme.Colors.White,
		CornerRadius = 5,
		Parent = card,
	})
	self.SetDangerBar = setBar
end

-- Kopfbereich: Modus-Chip, Platz-Plakette, Timer, Streckenfortschritt
function RaceHud:_buildTop(root: Frame)
	local top = new("Frame", {
		Name = "Top",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(680, 126),
		Parent = root,
	})
	self.Top = top

	local modePill, modeLabel = Components.Pill({
		Name = "Mode",
		Text = "",
		Color = Theme.Colors.Accent,
		Size = UDim2.fromOffset(380, 24),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		TextSize = 13,
		Parent = top,
	})
	modePill.BackgroundColor3 = Theme.Colors.PanelDark
	modePill.BackgroundTransparency = 0.2
	modeLabel.TextStrokeTransparency = 0.6
	modeLabel.TextStrokeColor3 = Theme.Colors.Shadow
	self.ModePill = modePill
	self.MapLabel = modeLabel

	-- Timer als Glas-Karte
	local _, timerPanel = Components.Card({
		Name = "TimerCard",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 30),
		Size = UDim2.fromOffset(236, 58),
		BackgroundColor3 = Theme.Colors.PanelDark,
		BackgroundTransparency = 0.12,
		CornerRadius = 16,
		ShadowOffset = 4,
		ShadowSpread = 5,
		Parent = top,
	})
	self.TimerLabel = Components.Heading({
		Text = "0:00.00",
		TextSize = 40,
		TextXAlignment = Enum.TextXAlignment.Center,
		Outline = 2.5,
		OutlineTransparency = 0,
		RichText = false,
		Size = UDim2.fromScale(1, 1),
		Parent = timerPanel,
	})
	self.TimerGradient = Components.Gradient({ Theme.Colors.White, rgb(178, 228, 255) }, 90)
	self.TimerGradient.Parent = self.TimerLabel
	self.TimerStyle = "Race"

	-- Eigene Platzierung (bzw. die des beobachteten Spielers)
	local badge = new("Frame", {
		Name = "PlaceBadge",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(0.5, -130, 0, 31),
		Size = UDim2.fromOffset(56, 56),
		BackgroundColor3 = Theme.Colors.White,
		BorderSizePixel = 0,
		Visible = false,
		Parent = top,
	})
	new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = badge })
	self.PlaceGradient = Components.Gradient(Theme.Gradients.Neutral, 90)
	self.PlaceGradient.Parent = badge
	Components.Stroke(Theme.Colors.White, 2.5, 0.15).Parent = badge
	self.PlaceBadge = badge
	self.PlaceLabel = Components.Heading({
		Text = "",
		TextSize = 26,
		TextXAlignment = Enum.TextXAlignment.Center,
		Outline = 2,
		RichText = false,
		Position = UDim2.fromOffset(0, 4),
		Size = UDim2.new(1, 0, 0, 30),
		Parent = badge,
	})
	self.PlaceOf = Components.Label({
		Text = "",
		Font = Theme.Fonts.Title,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		RichText = false,
		TextStrokeTransparency = 0.4,
		TextStrokeColor3 = Theme.Colors.Shadow,
		Position = UDim2.fromOffset(0, 33),
		Size = UDim2.new(1, 0, 0, 14),
		Parent = badge,
	})
	self.LastPlace = nil

	-- Streckenfortschritt
	local track = new("Frame", {
		Name = "Track",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 102),
		Size = UDim2.fromOffset(560, 14),
		BackgroundColor3 = Theme.Colors.Shadow,
		BackgroundTransparency = 0.3,
		BorderSizePixel = 0,
		Parent = top,
	})
	Components.Corner(7).Parent = track
	Components.Stroke(Theme.Colors.White, 1.5, 0.55).Parent = track
	self.Track = track
	self.ProgressFill = new("Frame", {
		Name = "Progress",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Colors.White,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		Parent = track,
	})
	Components.Corner(7).Parent = self.ProgressFill
	Components.Gradient({ Theme.Gradients.Accent[2], Theme.Gradients.Accent[1] }, 0).Parent = self.ProgressFill
	self.ZoneFill = new("Frame", {
		Name = "Zone",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Colors.White,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = track,
	})
	Components.Corner(7).Parent = self.ZoneFill
	Components.Gradient({ rgb(110, 0, 22), Theme.Colors.Danger }, 0).Parent = self.ZoneFill
	self.ZoneEdge = new("Frame", {
		Name = "ZoneEdge",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(6, 24),
		BackgroundColor3 = rgb(255, 214, 214),
		BorderSizePixel = 0,
		ZIndex = 3,
		Visible = false,
		Parent = track,
	})
	Components.Corner(3).Parent = self.ZoneEdge
	self.ZoneEdgeStroke = Components.Stroke(Theme.Colors.Danger, 3, 0.1)
	self.ZoneEdgeStroke.Parent = self.ZoneEdge
	Components.Icon({
		Name = "Start",
		Glyph = Theme.Icons.Play,
		Color = Theme.Colors.Success,
		Size = 24,
		TextSize = 11,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(0, -8, 0.5, 0),
		Parent = track,
	})
	local _, finishGlyph = Components.Icon({
		Name = "Finish",
		Glyph = Theme.Icons.Flag,
		Color = Theme.Colors.Gold,
		Size = 32,
		TextSize = 17,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(1, 8, 0.5, 0),
		Parent = track,
	})
	finishGlyph.TextStrokeTransparency = 1
	self.TickHolder = new("Frame", { Name = "Ticks", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 4, Parent = track })
	self.DotHolder = new("Frame", { Name = "Dots", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 5, Parent = track })
end

-- Countdown mit Schockwellen-Ring
function RaceHud:_buildCountdown(root: Frame)
	self.Shock = new("Frame", {
		Name = "Shockwave",
