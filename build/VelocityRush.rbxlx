      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Progression</string>
          <string name="Source"><![CDATA[--[[
	Progression  (ModuleScript)
	Pfad: ReplicatedStorage/Shared/Progression

	Levelkurve (XP) und Ranked-Stufen. Wird vom Server zur Berechnung und vom
	Client zur Anzeige verwendet.
]]

local Progression = {}

Progression.MaxLevel = 100

--- XP, die benötigt werden, um von `level` auf `level + 1` zu steigen.
function Progression.XPForLevel(level: number): number
	return 100 + (level - 1) * 40
end

--- Berechnet Level, XP im aktuellen Level und XP bis zum nächsten Level aus Gesamt-XP.
function Progression.FromTotalXP(totalXP: number): (number, number, number)
	local level = 1
	local remaining = math.max(0, math.floor(totalXP))
	while level < Progression.MaxLevel do
		local needed = Progression.XPForLevel(level)
		if remaining < needed then
			return level, remaining, needed
		end
		remaining -= needed
		level += 1
	end
	return Progression.MaxLevel, 0, 0
end

Progression.Tiers = {
	{ Name = "Bronze", MinRating = 0, Color = Color3.fromRGB(205, 127, 50) },
	{ Name = "Silber", MinRating = 1100, Color = Color3.fromRGB(192, 200, 215) },
	{ Name = "Gold", MinRating = 1300, Color = Color3.fromRGB(255, 200, 40) },
	{ Name = "Platin", MinRating = 1500, Color = Color3.fromRGB(80, 230, 210) },
	{ Name = "Diamant", MinRating = 1700, Color = Color3.fromRGB(120, 170, 255) },
	{ Name = "Velocity-Elite", MinRating = 1900, Color = Color3.fromRGB(255, 70, 160) },
}

--- Liefert die Stufe (Tabelle mit Name, MinRating, Color) für ein Rating.
function Progression.GetTier(rating: number)
	local result = Progression.Tiers[1]
	for _, tier in Progression.Tiers do
		if rating >= tier.MinRating then
			result = tier
		end
	end
	return result
end

--- Elo-artige Mehrspieler-Wertung.
--- `entries` = { {Key=any, Rating=number, Placement=number}, ... }
--- Rückgabe: { [Key] = Delta }
function Progression.ComputeRatingDeltas(entries: { any }, kFactor: number): { [any]: number }
	local deltas = {}
	local n = #entries
	if n < 2 then
		for _, entry in entries do
			deltas[entry.Key] = 0
		end
		return deltas
	end
	for i, a in entries do
		local sum = 0
		for j, b in entries do
			if i ~= j then
				local expected = 1 / (1 + 10 ^ ((b.Rating - a.Rating) / 400))
				local actual
				if a.Placement < b.Placement then
					actual = 1
				elseif a.Placement > b.Placement then
					actual = 0
				else
					actual = 0.5
				end
				sum += actual - expected
			end
		end
		deltas[a.Key] = math.floor(kFactor * sum / (n - 1) + 0.5)
	end
	return deltas
end

return Progression
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">QuestDefinitions</string>
          <string name="Source"><![CDATA[--[[
	QuestDefinitions  (ModuleScript)
	Pfad: ReplicatedStorage/Shared/QuestDefinitions

	Tägliche Aufgaben und Erfolge. Der Fortschritt wird ausschließlich auf dem
	Server gezählt (RewardService). Belohnungen werden genau einmal vergeben.

	Zähler (Stat-Schlüssel), die der Server erhöht:
		Races, Wins, Top3, Finishes, Grapples, PowerUps, Distance
]]

local QuestDefinitions = {}

QuestDefinitions.DailyCount = 3

QuestDefinitions.Daily = {
	{ Id = "PlayRaces", Name = "Spiele 3 Rennen", Stat = "Races", Goal = 3, Coins = 80, XP = 60 },
	{ Id = "PlayRacesLong", Name = "Spiele 6 Rennen", Stat = "Races", Goal = 6, Coins = 150, XP = 120 },
	{ Id = "Top3", Name = "Erreiche 2× die Top 3", Stat = "Top3", Goal = 2, Coins = 120, XP = 90 },
	{ Id = "WinOne", Name = "Gewinne ein Rennen", Stat = "Wins", Goal = 1, Coins = 150, XP = 120 },
	{ Id = "Grapples", Name = "Nutze den Greifhaken 25× im Rennen", Stat = "Grapples", Goal = 25, Coins = 90, XP = 70 },
	{ Id = "PowerUps", Name = "Setze 5 Power-ups im Rennen ein", Stat = "PowerUps", Goal = 5, Coins = 90, XP = 70 },
	{ Id = "Distance", Name = "Lege 5.000 Studs im Rennen zurück", Stat = "Distance", Goal = 5000, Coins = 100, XP = 80 },
	{ Id = "Finish", Name = "Überquere 1× die Ziellinie", Stat = "Finishes", Goal = 1, Coins = 110, XP = 90 },
}

QuestDefinitions.Achievements = {
	{ Id = "FirstRace", Name = "Startschuss", Description = "Spiele dein erstes Rennen.", Stat = "Races", Goal = 1, Coins = 50 },
	{ Id = "FirstWin", Name = "Erster Sieg", Description = "Gewinne ein Rennen.", Stat = "Wins", Goal = 1, Coins = 150 },
	{ Id = "TenWins", Name = "Seriensieger", Description = "Gewinne 10 Rennen.", Stat = "Wins", Goal = 10, Coins = 500 },
	{ Id = "FiftyRaces", Name = "Marathon", Description = "Spiele 50 Rennen.", Stat = "Races", Goal = 50, Coins = 400 },
	{ Id = "GrappleMaster", Name = "Hakenmeister", Description = "Nutze den Greifhaken 500× im Rennen.", Stat = "Grapples", Goal = 500, Coins = 400 },
	{ Id = "ItemFan", Name = "Taktiker", Description = "Setze 100 Power-ups ein.", Stat = "PowerUps", Goal = 100, Coins = 300 },
	{ Id = "Level10", Name = "Aufsteiger", Description = "Erreiche Level 10.", Stat = "Level", Goal = 10, Coins = 300 },
	{ Id = "Level25", Name = "Veteran", Description = "Erreiche Level 25.", Stat = "Level", Goal = 25, Coins = 800 },
	{ Id = "Collector", Name = "Sammler", Description = "Besitze 10 kosmetische Gegenstände.", Stat = "Owned", Goal = 10, Coins = 400 },
	{ Id = "Flawless", Name = "Makellos", Description = "Gewinne ein Rennen ohne Respawn.", Stat = "FlawlessWins", Goal = 1, Coins = 300 },
}

QuestDefinitions.DailyLookup = {}
for _, quest in QuestDefinitions.Daily do
	QuestDefinitions.DailyLookup[quest.Id] = quest
end

QuestDefinitions.AchievementLookup = {}
for _, achievement in QuestDefinitions.Achievements do
	QuestDefinitions.AchievementLookup[achievement.Id] = achievement
end

--- Wählt deterministisch die Tagesaufgaben für einen Spieler und Tag.
function QuestDefinitions.RollDaily(userId: number, day: number): { string }
	local rng = Random.new(userId * 31 + day * 7919)
	local pool = {}
	for _, quest in QuestDefinitions.Daily do
		table.insert(pool, quest.Id)
	end
	local result = {}
	for _ = 1, math.min(QuestDefinitions.DailyCount, #pool) do
		local index = rng:NextInteger(1, #pool)
		local id = table.remove(pool, index)
		-- Keine zwei Aufgaben mit derselben Statistik am selben Tag.
		local stat = QuestDefinitions.DailyLookup[id].Stat
		for i = #pool, 1, -1 do
			if QuestDefinitions.DailyLookup[pool[i]].Stat == stat then
				table.remove(pool, i)
			end
		end
		table.insert(result, id)
		if #pool == 0 then
			break
		end
	end
	return result
end

return QuestDefinitions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--[[
	Remotes  (ModuleScript)
	Pfad: ReplicatedStorage/Shared/Remotes

	Definiert die komplette Server-Client-Kommunikation an einer Stelle.
	Der Server erzeugt beim ersten require() den Ordner ReplicatedStorage/Remotes
	mit allen RemoteEvents/RemoteFunctions. Der Client wartet auf diese Instanzen.

	Client -> Server (RemoteEvent):
		QueueRequest(action: "Join"|"Leave", mode: "QuickPlay"|"Ranked")
		PracticeRequest(action: "Enter"|"Leave"|"Reset", courseId: string?)
		MoveState(state: string, facing: number)
		GrappleRequest(action: "Attach"|"Release", anchorId: number?)
		UsePowerUp()
		PlayEmote()
		SaveSettings(settings: table)
		RequestRespawn()
	Server -> Client (RemoteEvent):
		GameEvent(name: string, payload: table)
		ProfileUpdate(snapshot: table)
	Client -> Server (RemoteFunction):
		GetProfile() -> snapshot
		ShopRequest(action: "Buy"|"Equip"|"Unequip", category: string, itemId: string?) -> result
		GetLeaderboard() -> boards
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	"QueueRequest",
	"PracticeRequest",
	"MoveState",
	"GrappleRequest",
	"UsePowerUp",
	"PlayEmote",
	"SaveSettings",
	"RequestRespawn",
	"GameEvent",
	"ProfileUpdate",
}

local FUNCTIONS = {
	"GetProfile",
	"ShopRequest",
	"GetLeaderboard",
}

local Remotes = {}

local folder: Instance
if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
	end
	for _, name in EVENTS do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
	for _, name in FUNCTIONS do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = folder
		end
	end
	folder.Parent = ReplicatedStorage
else
	folder = ReplicatedStorage:WaitForChild("Remotes")
end

for _, name in EVENTS do
	Remotes[name] = folder:WaitForChild(name)
end
for _, name in FUNCTIONS do
	Remotes[name] = folder:WaitForChild(name)
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">RunnerRig</string>
          <string name="Source"><![CDATA[--[[
	RunnerRig  (ModuleScript)
	Pfad: ReplicatedStorage/Shared/RunnerRig

	Baut die einheitliche Spielfigur ("Runner") komplett aus Parts und Motor6Ds.
	Alle Spieler haben dadurch identische Proportionen und Hitboxen – Avatare
	und Skins können keinen Vorteil verschaffen.

	Der Server legt beim Start ein Exemplar als StarterPlayer/StarterCharacter ab
	(siehe CharacterService). Der Client nutzt dieselbe Funktion für die
	Skin-Vorschau im Shop.

	Aufbau:
		Skelett   Die 15 Körperteile mit R15-Namen sind unsichtbare "Knochen",
		          verbunden über 15 Motor6D-Gelenke (AnimationController setzt
		          deren Transform). Namen und Gelenkpositionen sind fest.
		Hülle     Sichtbar ist eine stilisierte Figur aus Standardformen
		          (Kugelhelm mit Ohrkapseln, abgerundeter Brustkorb mit
		          V-Silhouette, Brustplatte und Emblem, Gürtel mit Schnalle,
		          zylindrische Arme/Beine mit Kugelgelenken, Handschuhe mit
		          Stulpen, Stiefel mit runder Kappe, Sohle und Zierstreifen).
		          Jedes Hüllenteil ist per Weld an seinen Knochen geschweißt und
		          folgt so der prozeduralen Animation. Die Teile liegen im Ordner
		          "VR_Body" und tragen die Attribute
		              VR_Paint  Farbslot (Körpergruppe Head/Torso/Hips/Arms/Hands/
		                        Legs/Feet oder Trim/Ears/Joint/Collar/Belt/Sole/
		                        Glow/Visor)
		              VR_Tag    optionale Gruppe, die ein Skin per HideBase
		                        ausblenden kann (Ears, Plate, Emblem, Back, Belt,
		                        Stripes)
		          CosmeticApplier färbt sie passend zum Skin ein.
		Blickrichtung des Rigs ist lokal -Z, Rücken +Z, rechte Seite +X. Die
		Spielkamera sieht die Figur im Profil (entlang X), der Shop von vorn –
		deshalb haben Seiten (Ohrkapseln, Streifen, Stiefel) eigene Details.

	Kollision:
		Nur der unsichtbare Part "VR_Collider" kollidiert mit der Welt
		(CollisionGroup "Runner"). Knochen und Hülle sind Massless,
		CanCollide/CanQuery/CanTouch = false und (als Spielfigur) in der Gruppe
		"RunnerBody". So bleibt die Hitbox exakt definiert.

	API:
		RunnerRig.Build({ ForCharacter = boolean }) -> Model
		RunnerRig.Joints     (Liste der Gelenknamen)
		RunnerRig.PartNames  (Liste der Körperteil-/Knochennamen)
		RunnerRig.BodyFolder (Name des Hüllen-Ordners, "VR_Body")
]]

local Config = require(script.Parent.Config)

local RunnerRig = {}

RunnerRig.BodyFolder = "VR_Body"

-- Mittelpunkte der Körperteile relativ zur Mitte des HumanoidRootPart (Ruhepose).
local PARTS = {
	{ Name = "LowerTorso", Size = Vector3.new(1.9, 0.6, 1.0), Center = Vector3.new(0, 0, 0) },
	{ Name = "UpperTorso", Size = Vector3.new(2.0, 1.4, 1.0), Center = Vector3.new(0, 1.0, 0) },
	{ Name = "Head", Size = Vector3.new(1.3, 1.3, 1.3), Center = Vector3.new(0, 2.325, 0) },
	{ Name = "LeftUpperArm", Size = Vector3.new(0.7, 1.1, 0.7), Center = Vector3.new(-1.4, 1.15, 0) },
	{ Name = "LeftLowerArm", Size = Vector3.new(0.6, 0.9, 0.6), Center = Vector3.new(-1.4, 0.15, 0) },
	{ Name = "LeftHand", Size = Vector3.new(0.62, 0.35, 0.62), Center = Vector3.new(-1.4, -0.475, 0) },
	{ Name = "RightUpperArm", Size = Vector3.new(0.7, 1.1, 0.7), Center = Vector3.new(1.4, 1.15, 0) },
	{ Name = "RightLowerArm", Size = Vector3.new(0.6, 0.9, 0.6), Center = Vector3.new(1.4, 0.15, 0) },
	{ Name = "RightHand", Size = Vector3.new(0.62, 0.35, 0.62), Center = Vector3.new(1.4, -0.475, 0) },
	{ Name = "LeftUpperLeg", Size = Vector3.new(0.78, 1.1, 0.78), Center = Vector3.new(-0.5, -0.85, 0) },
	{ Name = "LeftLowerLeg", Size = Vector3.new(0.7, 0.95, 0.7), Center = Vector3.new(-0.5, -1.875, 0) },
	{ Name = "LeftFoot", Size = Vector3.new(0.8, 0.35, 1.1), Center = Vector3.new(-0.5, -2.525, -0.1) },
	{ Name = "RightUpperLeg", Size = Vector3.new(0.78, 1.1, 0.78), Center = Vector3.new(0.5, -0.85, 0) },
	{ Name = "RightLowerLeg", Size = Vector3.new(0.7, 0.95, 0.7), Center = Vector3.new(0.5, -1.875, 0) },
	{ Name = "RightFoot", Size = Vector3.new(0.8, 0.35, 1.1), Center = Vector3.new(0.5, -2.525, -0.1) },
}

-- Gelenke: Name, Part0 (Elternteil), Part1 (Kind), Gelenkposition (Ruhepose)
local JOINTS = {
	{ Name = "Root", Part0 = "HumanoidRootPart", Part1 = "LowerTorso", At = Vector3.new(0, 0, 0) },
	{ Name = "Waist", Part0 = "LowerTorso", Part1 = "UpperTorso", At = Vector3.new(0, 0.3, 0) },
	{ Name = "Neck", Part0 = "UpperTorso", Part1 = "Head", At = Vector3.new(0, 1.7, 0) },
	{ Name = "LeftShoulder", Part0 = "UpperTorso", Part1 = "LeftUpperArm", At = Vector3.new(-1.4, 1.55, 0) },
	{ Name = "LeftElbow", Part0 = "LeftUpperArm", Part1 = "LeftLowerArm", At = Vector3.new(-1.4, 0.6, 0) },
	{ Name = "LeftWrist", Part0 = "LeftLowerArm", Part1 = "LeftHand", At = Vector3.new(-1.4, -0.3, 0) },
	{ Name = "RightShoulder", Part0 = "UpperTorso", Part1 = "RightUpperArm", At = Vector3.new(1.4, 1.55, 0) },
	{ Name = "RightElbow", Part0 = "RightUpperArm", Part1 = "RightLowerArm", At = Vector3.new(1.4, 0.6, 0) },
	{ Name = "RightWrist", Part0 = "RightLowerArm", Part1 = "RightHand", At = Vector3.new(1.4, -0.3, 0) },
	{ Name = "LeftHip", Part0 = "LowerTorso", Part1 = "LeftUpperLeg", At = Vector3.new(-0.5, -0.35, 0) },
	{ Name = "LeftKnee", Part0 = "LeftUpperLeg", Part1 = "LeftLowerLeg", At = Vector3.new(-0.5, -1.4, 0) },
	{ Name = "LeftAnkle", Part0 = "LeftLowerLeg", Part1 = "LeftFoot", At = Vector3.new(-0.5, -2.35, 0) },
	{ Name = "RightHip", Part0 = "LowerTorso", Part1 = "RightUpperLeg", At = Vector3.new(0.5, -0.35, 0) },
	{ Name = "RightKnee", Part0 = "RightUpperLeg", Part1 = "RightLowerLeg", At = Vector3.new(0.5, -1.4, 0) },
	{ Name = "RightAnkle", Part0 = "RightLowerLeg", Part1 = "RightFoot", At = Vector3.new(0.5, -2.35, 0) },
}

RunnerRig.Joints = {}
for _, joint in JOINTS do
	table.insert(RunnerRig.Joints, joint.Name)
end

RunnerRig.PartNames = {}
for _, info in PARTS do
	table.insert(RunnerRig.PartNames, info.Name)
end

------------------------------------------------------------------------
-- Sichtbare Hülle
------------------------------------------------------------------------

local rad = math.rad
local V = Vector3.new
local CF = CFrame.new
local CYL_Y = CFrame.Angles(0, 0, rad(90)) -- Zylinderachse senkrecht (Y)
local CYL_Z = CFrame.Angles(0, rad(90), 0) -- Zylinderachse nach vorn (Z)

-- Startfarben (= Rookie-Skin), bis CosmeticApplier den echten Skin setzt.
local DEFAULT_PAINT = {
	Head = Color3.fromRGB(242, 245, 252),
	Torso = Color3.fromRGB(36, 120, 255),
	Hips = Color3.fromRGB(28, 36, 62),
	Arms = Color3.fromRGB(36, 120, 255),
	Hands = Color3.fromRGB(242, 245, 252),
	Legs = Color3.fromRGB(34, 46, 82),
	Feet = Color3.fromRGB(242, 245, 252),
	Trim = Color3.fromRGB(242, 245, 252),
	Ears = Color3.fromRGB(36, 120, 255),
	Joint = Color3.fromRGB(22, 26, 40),
	Collar = Color3.fromRGB(22, 26, 40),
	Belt = Color3.fromRGB(22, 26, 40),
	Sole = Color3.fromRGB(255, 186, 40),
	Glow = Color3.fromRGB(0, 214, 255),
	Visor = Color3.fromRGB(70, 230, 255),
}
local GLOW_PAINT = { Glow = true, Visor = true }
local FALLBACK_COLOR = Color3.fromRGB(200, 205, 215)

-- Hüllenteile: Bone = Knochen, Shape = Block|Ball|Cylinder, Size, Offset
-- (relativ zur Knochenmitte), Paint = Farbslot, Tag = per Skin ausblendbar,
-- Shadow = wirft Schatten (nur die großen Volumen).
local SHELLS = {
	-- Kopf: Kugelhelm, eine durchgehende Walze bildet beide Ohrkapseln (Kopfhörer-Look)
	{ Name = "Helmet", Bone = "Head", Shape = "Ball", Size = V(1.36, 1.36, 1.36), Offset = CF(0, 0.02, 0), Paint = "Head", Shadow = true },
	{ Name = "EarCaps", Bone = "Head", Shape = "Cylinder", Size = V(1.52, 0.52, 0.52), Offset = CF(0, -0.04, 0.08), Paint = "Ears", Tag = "Ears" },

	-- Oberkörper: Walze (im Profil runde Brust/Schultern) + schmalere Taille
	{ Name = "Chest", Bone = "UpperTorso", Shape = "Cylinder", Size = V(1.96, 1.24, 1.24), Offset = CF(0, 0.1, 0), Paint = "Torso", Shadow = true },
	{ Name = "Waist", Bone = "UpperTorso", Shape = "Block", Size = V(1.5, 0.9, 1.06), Offset = CF(0, -0.27, 0), Paint = "Torso", Shadow = true },
	{ Name = "Collar", Bone = "UpperTorso", Shape = "Cylinder", Size = V(0.24, 0.98, 0.98), Offset = CF(0, 0.7, 0) * CYL_Y, Paint = "Collar" },
	{ Name = "ChestPlate", Bone = "UpperTorso", Shape = "Block", Size = V(1.2, 0.62, 0.14), Offset = CF(0, 0.05, -0.58), Paint = "Trim", Tag = "Plate" },
	{ Name = "Emblem", Bone = "UpperTorso", Shape = "Cylinder", Size = V(0.06, 0.36, 0.36), Offset = CF(0, 0.07, -0.66) * CYL_Z, Paint = "Glow", Tag = "Emblem" },
	{ Name = "BackPlate", Bone = "UpperTorso", Shape = "Block", Size = V(1.1, 0.8, 0.22), Offset = CF(0, 0, 0.6), Paint = "Trim", Tag = "Back" },

	-- Hüfte mit rundem Sitz, Gürtel, Schnalle und seitlichen Gürtellichtern
	{ Name = "Hips", Bone = "LowerTorso", Shape = "Block", Size = V(1.5, 0.5, 1.04), Offset = CF(0, 0.02, 0), Paint = "Hips", Shadow = true },
	{ Name = "Seat", Bone = "LowerTorso", Shape = "Cylinder", Size = V(1.46, 0.96, 0.96), Offset = CF(0, -0.12, 0), Paint = "Hips", Shadow = true },
	{ Name = "Belt", Bone = "LowerTorso", Shape = "Block", Size = V(1.6, 0.2, 1.12), Offset = CF(0, 0.22, 0), Paint = "Belt" },
	{ Name = "Buckle", Bone = "LowerTorso", Shape = "Block", Size = V(0.42, 0.26, 0.08), Offset = CF(0, 0.22, -0.59), Paint = "Glow", Tag = "Belt" },
	{ Name = "BeltLights", Bone = "LowerTorso", Shape = "Cylinder", Size = V(1.66, 0.13, 0.13), Offset = CF(0, 0.22, 0.18), Paint = "Glow", Tag = "Belt" },
}

-- Arme und Beine sind symmetrisch (Offsets liegen mittig im Knochen).
for _, side in { "Left", "Right" } do
	local limbShells = {
		-- Arm: Schulterkugel, Ärmel mit Leuchtstreifen, Ellbogen, Unterarm, Stulpe, Handschuh
		{ Name = "Shoulder", Bone = "UpperArm", Shape = "Ball", Size = V(0.76, 0.76, 0.76), Offset = CF(0, 0.26, 0), Paint = "Arms", Shadow = true },
		{ Name = "Sleeve", Bone = "UpperArm", Shape = "Cylinder", Size = V(0.9, 0.58, 0.58), Offset = CF(0, -0.15, 0) * CYL_Y, Paint = "Arms", Shadow = true },
		{ Name = "ArmStripe", Bone = "UpperArm", Shape = "Block", Size = V(0.62, 0.62, 0.1), Offset = CF(0, -0.12, 0), Paint = "Glow", Tag = "Stripes" },
		{ Name = "Elbow", Bone = "LowerArm", Shape = "Ball", Size = V(0.56, 0.56, 0.56), Offset = CF(0, 0.45, 0), Paint = "Joint" },
		{ Name = "Forearm", Bone = "LowerArm", Shape = "Cylinder", Size = V(0.62, 0.52, 0.52), Offset = CF(0, 0.12, 0) * CYL_Y, Paint = "Arms", Shadow = true },
		{ Name = "Cuff", Bone = "LowerArm", Shape = "Cylinder", Size = V(0.3, 0.64, 0.64), Offset = CF(0, -0.3, 0) * CYL_Y, Paint = "Hands" },
		{ Name = "Glove", Bone = "Hand", Shape = "Ball", Size = V(0.62, 0.62, 0.62), Offset = CF(0, -0.07, 0), Paint = "Hands", Shadow = true },
		-- Bein: Oberschenkel mit Streifen, Knie, Schienbein, Stiefelschaft
		{ Name = "Thigh", Bone = "UpperLeg", Shape = "Cylinder", Size = V(1.05, 0.74, 0.74), Offset = CF(0, 0.02, 0) * CYL_Y, Paint = "Legs", Shadow = true },
		{ Name = "LegStripe", Bone = "UpperLeg", Shape = "Block", Size = V(0.78, 0.8, 0.12), Offset = CF(0, 0, 0), Paint = "Glow", Tag = "Stripes" },
		{ Name = "Knee", Bone = "LowerLeg", Shape = "Ball", Size = V(0.66, 0.66, 0.66), Offset = CF(0, 0.475, 0), Paint = "Joint" },
		{ Name = "Shin", Bone = "LowerLeg", Shape = "Cylinder", Size = V(0.62, 0.64, 0.64), Offset = CF(0, 0.17, 0) * CYL_Y, Paint = "Legs", Shadow = true },
		{ Name = "BootShaft", Bone = "LowerLeg", Shape = "Cylinder", Size = V(0.5, 0.74, 0.74), Offset = CF(0, -0.27, 0) * CYL_Y, Paint = "Feet", Shadow = true },
		-- Fuß: Stiefel mit runder Kappe, Sohle bis exakt Fußsohlenhöhe (-2.7), Seitenstreifen
		{ Name = "Boot", Bone = "Foot", Shape = "Block", Size = V(0.76, 0.34, 0.9), Offset = CF(0, 0.03, 0.1), Paint = "Feet", Shadow = true },
		{ Name = "Toe", Bone = "Foot", Shape = "Cylinder", Size = V(0.76, 0.34, 0.34), Offset = CF(0, 0, -0.4), Paint = "Feet" },
		{ Name = "Sole", Bone = "Foot", Shape = "Block", Size = V(0.82, 0.12, 1.16), Offset = CF(0, -0.115, -0.03), Paint = "Sole" },
		{ Name = "BootStripe", Bone = "Foot", Shape = "Block", Size = V(0.8, 0.08, 0.6), Offset = CF(0, 0.06, 0.08) * CFrame.Angles(rad(-14), 0, 0), Paint = "Glow", Tag = "Stripes" },
	}
	for _, shell in limbShells do
		shell.Name = side .. shell.Name
		shell.Bone = side .. shell.Bone
		table.insert(SHELLS, shell)
	end
end

local function makePart(name: string, size: Vector3, center: Vector3): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = CFrame.new(center)
	part.Color = FALLBACK_COLOR
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Anchored = false
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.CastShadow = false
	return part
end

--- Erstellt ein sichtbares Hüllenteil und schweißt es an seinen Knochen.
local function makeShell(info, bone: BasePart, folder: Folder, forCharacter: boolean)
	local part = Instance.new("Part")
	part.Name = info.Name
	-- Form zuerst setzen: Ball erzwingt sonst eine gleichseitige Größe.
	if info.Shape == "Ball" then
		part.Shape = Enum.PartType.Ball
	elseif info.Shape == "Cylinder" then
		part.Shape = Enum.PartType.Cylinder
	else
		part.Shape = Enum.PartType.Block
	end
	part.Size = info.Size
	part.CFrame = bone.CFrame * info.Offset
	part.Color = DEFAULT_PAINT[info.Paint] or FALLBACK_COLOR
	part.Material = if GLOW_PAINT[info.Paint] then Enum.Material.Neon else Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Anchored = false
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.CastShadow = info.Shadow == true
	if forCharacter then
		part.CollisionGroup = "RunnerBody"
	end
	part:SetAttribute("VR_Paint", info.Paint)
	if info.Tag then
		part:SetAttribute("VR_Tag", info.Tag)
	end

	local weld = Instance.new("Weld")
	weld.Name = "VR_ShellWeld"
	weld.Part0 = bone
	weld.Part1 = part
	weld.C0 = info.Offset
	weld.Parent = part

	part.Parent = folder
	return part
end

--- Erstellt das Rig. Mit ForCharacter=true inklusive Humanoid, Kollider und Ausrichtung.
function RunnerRig.Build(options: { ForCharacter: boolean? }?): Model
	local forCharacter = options ~= nil and options.ForCharacter == true
	local model = Instance.new("Model")
	model.Name = "Runner"

	local parts = {}

	local root = makePart("HumanoidRootPart", Vector3.new(2, 2, 1), Vector3.zero)
	root.Transparency = 1
	root.Massless = false
	root.Parent = model
	parts.HumanoidRootPart = root

	-- Knochen: unsichtbar, tragen Gelenke, Attachments und das Namensschild
	for _, info in PARTS do
		local part = makePart(info.Name, info.Size, info.Center)
		part.Transparency = 1
		part.Parent = model
		parts[info.Name] = part
	end

	for _, joint in JOINTS do
		local part0 = parts[joint.Part0]
		local part1 = parts[joint.Part1]
		local motor = Instance.new("Motor6D")
		motor.Name = joint.Name
		motor.Part0 = part0
		motor.Part1 = part1
		-- Ruhepose: alle Teile achsparallel, daher reichen Positionen.
		motor.C0 = CFrame.new(joint.At - part0.Position)
		motor.C1 = CFrame.new(joint.At - part1.Position)
		motor.Parent = part1
	end

	-- Sichtbare Hülle (nur Welds, keine Motor6Ds – die Animation findet Gelenke per Name)
	local body = Instance.new("Folder")
	body.Name = RunnerRig.BodyFolder
	for _, info in SHELLS do
		local bone = parts[info.Bone]
		if bone then
			makeShell(info, bone, body, forCharacter)
		end
	end
	body.Parent = model

	-- Befestigungspunkte für Seil, Trails und Effekte
	local grip = Instance.new("Attachment")
	grip.Name = "VR_GrappleGrip"
	grip.Position = Vector3.new(0, -0.15, 0)
	grip.Parent = parts.RightHand

	if forCharacter then
		for _, part in parts do
			part.CollisionGroup = "RunnerBody"
		end

		local character = Config.Character
		local centerOffset = character.FeetOffset + character.StandHeight / 2
		local collider = Instance.new("Part")
		collider.Name = "VR_Collider"
		collider.Size = Vector3.new(character.ColliderWidth, character.StandHeight, character.ColliderDepth)
		collider.CFrame = CFrame.new(0, centerOffset, 0)
		collider.Transparency = 1
		collider.CanCollide = true
		collider.CanTouch = false
		collider.CanQuery = false
		collider.CastShadow = false
		collider.Massless = false
		collider.CollisionGroup = "Runner"
		collider.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0, 0, 100, 100)
		collider.Parent = model

		local weld = Instance.new("Weld")
		weld.Name = "VR_ColliderWeld"
		weld.Part0 = root
		weld.Part1 = collider
		weld.C0 = CFrame.new(0, centerOffset, 0)
		weld.Parent = collider

		local alignAttachment = Instance.new("Attachment")
		alignAttachment.Name = "VR_AlignAttachment"
		alignAttachment.Parent = root

		local align = Instance.new("AlignOrientation")
		align.Name = "VR_Align"
		align.Mode = Enum.OrientationAlignmentMode.OneAttachment
		align.Attachment0 = alignAttachment
		align.RigidityEnabled = true
		align.CFrame = CFrame.lookAt(Vector3.zero, Vector3.new(1, 0, 0))
		align.Parent = root

		local humanoid = Instance.new("Humanoid")
		humanoid.RigType = Enum.HumanoidRigType.R15
		humanoid.HipHeight = 1.7
		humanoid.AutomaticScalingEnabled = false
		humanoid.BreakJointsOnDeath = false
		humanoid.RequiresNeck = false
		humanoid.AutoRotate = false
		humanoid.WalkSpeed = 0
		humanoid.UseJumpPower = true
		humanoid.JumpPower = 0
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		pcall(function()
			-- Neuere API: schaltet die Humanoid-Zustandsmaschine komplett ab.
			humanoid.EvaluateStateMachine = false
		end)
		humanoid.Parent = model

		-- Rückenpunkt für Trails/Effekte (wird von CosmeticApplier genutzt)
		local back = Instance.new("Attachment")
		back.Name = "VR_BackAttachment"
		back.Position = Vector3.new(0, 0, 0.5)
		back.Parent = parts.UpperTorso
	end

	model.PrimaryPart = root
	return model
end

return RunnerRig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[--[[
	Signal  (ModuleScript)
	Pfad: ReplicatedStorage/Shared/Signal

	Minimale Event-Implementierung für die Kommunikation zwischen Modulen
	auf derselben Seite (Server-Server oder Client-Client).

	API:
		Signal.new() -> Signal
		signal:Connect(fn) -> Connection (mit :Disconnect())
		signal:Once(fn) -> Connection
		signal:Fire(...)
		signal:Wait() -> ...
		signal:DisconnectAll()
]]

local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(fn: (...any) -> ())
	local handler = { Fn = fn, Connected = true }
	table.insert(self._handlers, handler)
	local signal = self
	return {
		Disconnect = function()
			if not handler.Connected then
				return
			end
			handler.Connected = false
			local index = table.find(signal._handlers, handler)
			if index then
				table.remove(signal._handlers, index)
			end
		end,
	}
end

function Signal:Once(fn: (...any) -> ())
	local connection
	connection = self:Connect(function(...)
		connection.Disconnect()
		fn(...)
	end)
	return connection
end

function Signal:Fire(...)
	for _, handler in table.clone(self._handlers) do
		if handler.Connected then
			task.spawn(handler.Fn, ...)
		end
	end
end

function Signal:Wait()
	local thread = coroutine.running()
	self:Once(function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function Signal:DisconnectAll()
	for _, handler in self._handlers do
		handler.Connected = false
	end
	table.clear(self._handlers)
end

return Signal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[--[[
	Util  (ModuleScript)
	Pfad: ReplicatedStorage/Shared/Util

	Kleine, zustandslose Hilfsfunktionen für Mathematik, Tabellen und Formatierung.
]]

local Util = {}

--- Bewegt `current` um höchstens `maxDelta` in Richtung `target`.
function Util.MoveToward(current: number, target: number, maxDelta: number): number
	if current < target then
		return math.min(current + maxDelta, target)
	end
	return math.max(current - maxDelta, target)
end

--- Lineare Interpolation.
function Util.Lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

--- Bildratenunabhängiges Glätten: nähert `a` mit Schärfe `sharpness` an `b` an.
function Util.Damp(a: number, b: number, sharpness: number, dt: number): number
	return a + (b - a) * (1 - math.exp(-sharpness * dt))
end

--- Vorzeichen, wobei 0 als 0 zurückgegeben wird.
function Util.Sign(x: number): number
	if x > 0 then
		return 1
	elseif x < 0 then
		return -1
	end
	return 0
end

--- Rundet auf ein Vielfaches von `step`.
function Util.Round(x: number, step: number?): number
	local s = step or 1
	return math.floor(x / s + 0.5) * s
end

--- Tiefe Kopie einer Tabelle (ohne Metatabellen, ohne Zyklen).
function Util.DeepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[Util.DeepCopy(k)] = Util.DeepCopy(v)
	end
	return copy
end

--- Ergänzt fehlende Schlüssel in `target` rekursiv aus `template`.
function Util.Reconcile(target: { [any]: any }, template: { [any]: any })
	for key, value in template do
		if target[key] == nil then
			target[key] = Util.DeepCopy(value)
		elseif type(value) == "table" and type(target[key]) == "table" then
			-- Nur echte "Struktur"-Tabellen rekursiv abgleichen (keine Listen).
			if #value == 0 then
				Util.Reconcile(target[key], value)
			end
		end
	end
end

--- Formatiert eine Zahl mit Tausenderpunkten (12345 -> "12.345").
function Util.FormatNumber(n: number): string
	local negative = n < 0
	local s = tostring(math.floor(math.abs(n)))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1."):reverse()
	if formatted:sub(1, 1) == "." then
		formatted = formatted:sub(2)
	end
	return (negative and "-" or "") .. formatted
end

--- Formatiert Sekunden als m:ss.hh
function Util.FormatTime(seconds: number): string
	seconds = math.max(0, seconds)
	local minutes = math.floor(seconds / 60)
	local rest = seconds - minutes * 60
	return string.format("%d:%05.2f", minutes, rest)
end

--- Mischt eine Liste in-place (Fisher-Yates).
function Util.Shuffle(list: { any }, rng: Random?)
	local random = rng or Random.new()
	for i = #list, 2, -1 do
		local j = random:NextInteger(1, i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

--- Gewichtete Zufallsauswahl. `entries` = { {Value=..., Weight=number}, ... }
function Util.WeightedPick(entries: { any }, rng: Random?): any
	local random = rng or Random.new()
	local total = 0
	for _, entry in entries do
		total += math.max(0, entry.Weight)
	end
	if total <= 0 then
		return nil
	end
	local roll = random:NextNumber() * total
	for _, entry in entries do
		roll -= math.max(0, entry.Weight)
		if roll <= 0 then
			return entry.Value
		end
	end
	return entries[#entries].Value
end

--- Zählt die Schlüssel einer Tabelle.
function Util.Count(t: { [any]: any }): number
	local n = 0
	for _ in t do
		n += 1
	end
	return n
end

--- Liefert die aktuelle "Tagesnummer" (UTC) für tägliche Aufgaben.
function Util.DayNumber(): number
	return math.floor(os.time() / 86400)
end

return Util
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="15">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="16">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="17">
        <Properties>
          <string name="Name">Bootstrap</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Bootstrap  (Script)
	Pfad: ServerScriptService/Server/Bootstrap

	Einstiegspunkt des Servers:
		1. Kollisionsgruppen und Physik konfigurieren
		2. Alle Services laden, :Init(services) aufrufen (keine Querverweise nötig)
		3. :Start() in definierter Reihenfolge (Lobby zuerst, Datenservice zuletzt)
		4. Gemeinsamer 10-Hz-Tick für Character-, Training-, Power-up- und
		   Anti-Exploit-Logik
		5. Geordnetes Aufräumen beim Verlassen (Profil wird zuletzt gespeichert)
]]

local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

------------------------------------------------------------------------
-- Physik & Kollisionsgruppen
------------------------------------------------------------------------

workspace.Gravity = Config.World.Gravity

local function registerGroup(name: string)
	if not PhysicsService:IsCollisionGroupRegistered(name) then
		PhysicsService:RegisterCollisionGroup(name)
	end
end

registerGroup("Runner") -- unsichtbarer Kollider der Spielfigur
registerGroup("RunnerBody") -- sichtbare Körperteile und Kosmetik (keine Kollision)

PhysicsService:CollisionGroupSetCollidable("Runner", "Runner", false) -- Spieler gehen durcheinander
PhysicsService:CollisionGroupSetCollidable("RunnerBody", "Default", false)
PhysicsService:CollisionGroupSetCollidable("RunnerBody", "Runner", false)
PhysicsService:CollisionGroupSetCollidable("RunnerBody", "RunnerBody", false)

------------------------------------------------------------------------
-- Services
------------------------------------------------------------------------

local servicesFolder = script.Parent:WaitForChild("Services")

local INIT_ORDER = {
	"PlayerDataService",
	"EconomyService",
	"InventoryService",
	"ShopService",
	"GrappleService",
	"PowerUpService",
	"MapService",
	"HazardRingService",
	"CharacterService",
	"MatchmakingService",
	"RoundService",
	"PracticeService",
	"RewardService",
	"RankedService",
	"LeaderboardService",
	"AntiExploitService",
}

local START_ORDER = {
	"MapService",
	"HazardRingService",
	"GrappleService",
	"PowerUpService",
	"EconomyService",
	"InventoryService",
	"ShopService",
	"CharacterService",
	"MatchmakingService",
	"RoundService",
	"PracticeService",
	"RewardService",
	"RankedService",
	"LeaderboardService",
	"AntiExploitService",
	"PlayerDataService", -- zuletzt: Profile laden löst das Spawnen aus
}

local services = {}
for _, name in INIT_ORDER do
	services[name] = require(servicesFolder:WaitForChild(name))
end
for _, name in INIT_ORDER do
	services[name]:Init(services)
end
for _, name in START_ORDER do
	local ok, err = pcall(function()
		services[name]:Start()
	end)
	if not ok then
		warn(string.format("[Bootstrap] %s:Start() fehlgeschlagen: %s", name, tostring(err)))
	end
end

------------------------------------------------------------------------
-- Gemeinsamer Server-Tick (10 Hz)
------------------------------------------------------------------------

local TICKED = { "CharacterService", "PracticeService", "PowerUpService", "AntiExploitService" }
local tickInterval = 1 / Config.Round.TickRate
local accumulator = 0

RunService.Heartbeat:Connect(function(dt)
	accumulator += dt
	if accumulator < tickInterval then
		return
	end
	local step = accumulator
	accumulator = 0
	for _, name in TICKED do
		local service = services[name]
		local ok, err = pcall(service.Tick, service, step)
		if not ok then
			warn(string.format("[Bootstrap] %s:Tick fehlgeschlagen: %s", name, tostring(err)))
		end
	end
end)

------------------------------------------------------------------------
-- Verlassen: geordnetes Aufräumen, Profil zuletzt speichern
------------------------------------------------------------------------

local REMOVE_ORDER = {
	"MatchmakingService",
	"RoundService",
	"PracticeService",
	"PowerUpService",
	"GrappleService",
	"CharacterService",
	"ShopService",
	"EconomyService",
	"AntiExploitService",
}

Players.PlayerRemoving:Connect(function(player)
	for _, name in REMOVE_ORDER do
		local service = services[name]
		if service.OnPlayerRemoving then
			local ok, err = pcall(service.OnPlayerRemoving, service, player)
			if not ok then
				warn(string.format("[Bootstrap] %s:OnPlayerRemoving fehlgeschlagen: %s", name, tostring(err)))
			end
		end
	end
	services.PlayerDataService:Release(player)
end)

print(string.format("[%s] Server gestartet (Version %s)", Config.GameName, Config.Version))
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="18">
        <Properties>
          <string name="Name">Modules</string>
        </Properties>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[--[[
	MapBuilder  (ModuleScript)
	Pfad: ServerScriptService/Server/Modules/MapBuilder

	Erzeugt Rennstrecken vollständig per Script aus Parts. Eine Map-Vorlage
	(ServerStorage/MapTemplates/*) ist eine Funktion, die einen MapBuilder erhält
	und mit "Bausteinen" die Strecke von links nach rechts aufbaut.

	Koordinaten:
		Lokale 2D-Koordinaten (x, y) relativ zum Ursprung der Map.
		x = Rennrichtung (Fortschritt), y = Höhe, z = Tiefe (Spielebene z = 0).
		Der "Cursor" (self.X, self.Y) zeigt immer auf das Ende des aktuellen Bodens.

	Physik-Richtwerte (siehe Config.Movement):
		Sprunghöhe ≈ 9,6 Studs, Sprungweite bei Maximaltempo ≈ 25 Studs.
		Normale Lücken ≤ 18, Stufen ≤ 6, Greifhaken-Lücken 40–80 Studs.

	Wichtige Bausteine (Cursor-basiert):
		Start(len)                 Startbereich mit 8 Spawnpunkten und Startbogen
		Flat(len, opts)            gerader Boden (opts.Ice = true für Eis)
		Gap(width, dy, landing)    Sprunglücke mit Gefahr am Boden
		Steps(count, rise, run)    Treppe (rise negativ = abwärts)
		Drop(height, landing)      Absatz nach unten
		Climb(height, landing)     Absatz nach oben (≤ 8 springbar)
		Ramp(length, rise)         Rampe
		SlideTunnel(len, opts)     niedrige Decke, nur rutschend passierbar
		WallClimb(height, width)   Schacht für Wall-Jumps (+ Hilfsanker)
		JumpPadUp(height, landing) Sprungpad zu höherer Ebene
		GrappleGap(width, opts)    breite Lücke mit Greifhaken-Ankern
		Pit(width, opts)           Gefahrengrube, optional mit Säulen
		TimedBarrier(len, opts)    zeitgesteuerte Gefahrenwand
		BoostStrip(len, power)     Boden mit Boost-Pad
		IceRun(len)                Eisfläche
		PickupRow(count, len)      Item-Boxen
		Split(opts)                zwei Routen (oben schnell/schwer, unten sicher)
		Finish(len)                Ziellinie mit Zielbogen
		Decorate()                 Bodenverzierung + Hintergrund passend zum Theme

	Freie Bausteine: Box, Ground, RampPart, Anchor, Hazard, BoostPad, JumpPad,
	Checkpoint, SpawnPoint, PickupSpot, Sign, Portal.

	Optik (rein dekorativ – keine Kollision, keine Abfragen, alles im Ordner "Decor"):
		Decorate() verziert alle Böden automatisch: Vorderkanten-Lippe, Leuchtkante,
		Zierbänder, Rippen/Fugen/Wurzeln, Eckleisten, Unterseiten (Eiszapfen, hängende
		Felsen, Lianen), Stützen bis in den Abgrund und Requisiten auf der hinteren
		Spurhälfte (z ≈ -3.5 … -4.8). Gesteuert über Theme-Felder (siehe
		MapDefinitions) sowie B.AutoDress / B.AutoSupports / B.AutoProps (false = aus).
		Dekoration liegt nie zwischen Kamera und Spielebene oberhalb der Lauffläche:
		vor z = +5 nur flache Blenden direkt auf Vorderseiten unterhalb der Oberkante.

	Öffentliche Deko-Bausteine (lokale Koordinaten, y = Oberkante des Bodens):
		Deco(size, cframe, color, material?, extra?) -> BasePart
			extra: Name, Transparency, Shape, Wedge, Mesh (Enum.MeshType), Light ({Range, Brightness, Color})
		Prop(kind, x, y, z?, opts?) -> {BasePart}
			kind: Crate, Barrel, Lamp, Torch, Bush, Rock, Crystal, Pine, SnowMound, IceBlock,
			      Column, Urn, Flower, Fern, Mushroom, Log, Vent, Barrier, HoloSign, Antenna,
			      Pipe, Girder, WarningLamp, Bench, Planter, Cone, Hurdle, Banner, Tree,
			      Temple, RuinArch, Tower  (die letzten drei sind große Wahrzeichen, opts.Scale)
			opts: Scale, Color (je nach Art)
		Lamp(x, y, z?, color?) -> {BasePart}               Laterne im Stil des Themes
		Pillar(x, yTop, yBottom, opts?) -> {BasePart}      Stütze (opts: Z, Width, Color, Material,
		                                                   Style "Girder"|"Pillar"|"Column"|"Ice"|"Stilt")
		Arch(x, y, width, height, color?, opts?) -> {BasePart}
		                                                   Torbogen hinter der Spur (opts: Label, Checker, Z, Depth)
		Banner(x, y, color?, opts?) -> {BasePart}          Fahne am Mast (opts: Height, Width, Z, Color2)
		Tree(x, y, z?, opts?) -> {BasePart}                Baum (opts: Kind "Round"|"Pine"|"Palm"|"Jungle",
		                                                   Scale, Height, Leaf)
		Cloud(x, y, z, scale?, opts?) -> {BasePart}        Wolke (opts: Color, Transparency, Puffs)
		Building(x, z, baseY, width, height, depth, opts?) -> {BasePart}
		                                                   Hochhaus (opts: Color, Material, Lights, WindowStyle 1–3, Roof)
		Waterfall(x, yTop, z, width, height)               Wasserfall mit Gischt
		Gates(count, color?, opts?)                        Torbögen über geraden Abschnitten, gleichmäßig
		                                                   über die Strecke verteilt (vor Decorate() aufrufen)
		Reserve(x1, x2)                                    Bereich ohne automatische Requisiten
		FloorAt(x) -> number?                              Oberkante des höchsten Bodens bei x

	Terrain-Bausteine (lokale Koordinaten). Terrain ist nur HINTER der Spur erlaubt:
	die Ausdehnung darf höchstens bis z = -12 reichen (sonst wird die Füllung mit
	Warnung übersprungen) – Boden-Raycasts der Spielfigur treffen so nie Terrain.
	Alle Füllungen werden aufgezeichnet (Result().TerrainFills) und von MapService
	beim Entladen der Region wieder gelöscht:
		TerrainBlock(x, y, z, size, material?, rotation?)
		TerrainBall(x, y, z, radius, material?)
		TerrainCylinder(x, y, z, height, radius, material?, rotation?)
		TerrainWedge(x, y, z, size, material?, rotation?)
		Mountain(x, z, baseY, height, width, opts?)        Berg (opts: Style "Round"|"Peak", Material, Cap,
		                                                   CapRatio, Depth)
		Island(x, y, z, radius, opts?) -> number           schwebende Insel (opts: Top, Rock, Cliff), liefert Oberkante
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local MapBuilder = {}
MapBuilder.__index = MapBuilder

local DEPTH = Config.World.TrackDepth
local FACE_Z = DEPTH / 2 -- Vorderseite der Spur (zur Kamera)
local BACK_Z = -4.2 -- Standardtiefe für Requisiten (hintere Spurhälfte)
local TERRAIN_MAX_Z = -12 -- Terrain darf höchstens bis hierher nach vorn reichen
local ROOT_HEIGHT = -Config.Character.FeetOffset + 0.3
local GRAVITY = Config.World.Gravity
local M = Enum.Material
local NEON = M.Neon
local BALL = Enum.PartType.Ball
local CYL = Enum.PartType.Cylinder
local SPHERE = Enum.MeshType.Sphere
local rgb = Color3.fromRGB

local VERTICAL = CFrame.Angles(0, 0, math.rad(90)) -- Zylinderachse (X) senkrecht stellen
local FACING = CFrame.Angles(0, math.rad(90), 0) -- Zylinderachse zur Kamera (Scheibe)
local WHITE = rgb(255, 255, 255)
local BLACK = rgb(22, 22, 28)
local STRIPE_YELLOW = rgb(250, 200, 40)
local ICE_TRIM = rgb(214, 244, 255)
local ICICLE = rgb(200, 238, 255)

local HAZARD_STYLE = {
	Lava = { Color = rgb(255, 92, 18), Material = NEON, Transparency = 0 },
	Laser = { Color = rgb(255, 45, 120), Material = NEON, Transparency = 0.2 },
	Flame = { Color = rgb(255, 120, 30), Material = NEON, Transparency = 0.15 },
	Arcane = { Color = rgb(175, 95, 255), Material = NEON, Transparency = 0.3 },
	Void = { Color = rgb(125, 80, 230), Material = NEON, Transparency = 0.7 },
	Icicle = { Color = rgb(185, 235, 255), Material = M.Glass, Transparency = 0.1 },
	IceWater = { Color = rgb(70, 160, 220), Material = M.Glass, Transparency = 0.3 },
	River = { Color = rgb(60, 150, 170), Material = M.Glass, Transparency = 0.3 },
	Thorns = { Color = rgb(110, 30, 50), Material = M.Slate, Transparency = 0 },
	Spikes = { Color = rgb(160, 162, 176), Material = M.Metal, Transparency = 0 },
}

local TEETH_KINDS = { Thorns = true, Spikes = true, Icicle = true }

-- Nur diese Materialien sind für Terrain gültig
local TERRAIN_MATERIALS = {}
for _, name in {
	"Water", "CrackedLava", "Grass", "LeafyGrass", "Rock", "Snow", "Glacier", "Sand", "Mud", "Basalt",
	"Ground", "Salt", "Limestone", "Sandstone", "Asphalt", "Slate", "Concrete",
} do
	TERRAIN_MATERIALS[M[name]] = true
end

-- Standardwerte für optionale Theme-Felder
local THEME_DEFAULTS = {
	Trim = rgb(176, 180, 196),
	TrimMaterial = M.Metal,
	Detail = rgb(62, 64, 80),
	DetailMaterial = M.Metal,
	Support = rgb(92, 94, 108),
	SupportMaterial = M.Metal,
	RibStyle = "Panel",
	SupportStyle = "Pillar",
	PropSpacing = 18,
	Leaf = rgb(70, 150, 60),
}

-- Höhe der Requisiten (für niedrige Decken)
local PROP_HEIGHT = {
	Lamp = 11, Torch = 6.5, Antenna = 9.5, Tree = 9, Banner = 9.8, Pine = 9.5, Column = 9.8, Girder = 6,
	HoloSign = 5, WarningLamp = 3.2, Crate = 4.4, Barrel = 3.2,
}

local RIB_SPACING = { Panel = 12, Joint = 10, Root = 8, Pipe = 12, Strata = 0 }

------------------------------------------------------------------------
-- Hilfsfunktionen
------------------------------------------------------------------------

--- Abdunkeln (factor < 1) oder Richtung Weiß aufhellen (factor > 1).
local function shade(color: Color3, factor: number): Color3
	if factor <= 1 then
		return Color3.new(color.R * factor, color.G * factor, color.B * factor)
	end
	return color:Lerp(WHITE, math.clamp(factor - 1, 0, 1))
end

--- Leichte zufällige Helligkeitsvariation.
local function jitter(rng, color: Color3, amount: number): Color3
	return shade(color, 1 + rng:NextNumber(-amount, amount))
end

local function emitter(parent: Instance, props)
	local e = Instance.new("ParticleEmitter")
	for key, value in props do
		e[key] = value
	end
	e.Parent = parent
	return e
end

--- Flammen-Partikel (Fackeln, Feuerschalen).
local function fireEmitter(parent: Instance, color: Color3, size: number)
	return emitter(parent, {
		Rate = 9,
		Lifetime = NumberRange.new(0.4, 0.8),
		Speed = NumberRange.new(2, 4),
		EmissionDirection = Enum.NormalId.Top,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) }),
		Color = ColorSequence.new(rgb(255, 236, 150), color),
		LightEmission = 1,
		SpreadAngle = Vector2.new(12, 12),
	})
end

--- Deko-Teil erzeugen und in eine Liste eintragen.
local function piece(builder, list, size: Vector3, cframe: CFrame, color: Color3, material, extra)
	local part = builder:Deco(size, cframe, color, material, extra)
	table.insert(list, part)
	return part
end

--- Erstellt einen neuen Builder.
--- params: Name, RegionId, MapId, Origin (Vector3), Theme, Difficulty (1–3), Seed
function MapBuilder.new(params)
	local self = setmetatable({}, MapBuilder)
	self.RegionId = params.RegionId
	self.MapId = params.MapId
	self.Origin = params.Origin or Vector3.zero
	self.Theme = params.Theme
	self.Difficulty = params.Difficulty or 2
	self.Rng = Random.new(params.Seed or 1)

	self.Model = Instance.new("Model")
	self.Model.Name = params.Name or params.MapId or "Map"
	self.Model:SetAttribute("RegionId", self.RegionId)
	self.Model:SetAttribute("MapId", self.MapId)

	self.Folders = {}
	for _, name in { "Geometry", "Hazards", "Anchors", "Pads", "Decor", "Pickups", "Runtime" } do
		local folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = self.Model
		self.Folders[name] = folder
	end

	self.X = 0
	self.Y = 0
	self.Thickness = 8
	self.NoPitHazard = false
	self.AutoCheckpoints = true
	self.CheckpointSpacing = 140
	self.LastCheckpointX = -math.huge

	self.MinX, self.MaxX, self.MinY, self.MaxY = 0, 0, 0, 0
	self.Spawns = {}
	self.Checkpoints = {}
	self.TeleportNodes = {}
	self.PickupSpawns = {}
	self.Anchors = {}
	self.Portals = {}
	self.StartLocalX = 0
	self.FinishLocalX = nil

	-- Optik: Aufzeichnungen für die automatische Verzierung in Decorate()
	self.Platforms = {} -- { X1, X2, Y, Bottom, Ice, Upper, NoDress }
	self.Ramps = {} -- { X1, Y1, X2, Y2, Bottom }
	self.Ceilings = {} -- { X1, X2, Y } Unterkanten von Decken (Tunnel, Kletterwand)
	self.Solids = {} -- { X1, X2, Y1, Y2 } Wände und Blöcke
	self.Reserved = {} -- { x1, x2 } Bereiche ohne automatische Requisiten
	self.TerrainFills = {} -- aufgezeichnete Terrain-Füllungen (Weltkoordinaten)
	self.AutoDress = true
	self.AutoSupports = true
	self.AutoProps = true
	self.LastLampX = -math.huge
	self.LightCount = 0
	self.MaxLights = 48
	return self
end

--- Lokale Koordinate -> Weltposition.
function MapBuilder:W(x: number, y: number, z: number?): Vector3
	return self.Origin + Vector3.new(x, y, z or 0)
end

--- Schwierigkeitsfaktor (0.9 / 1.0 / 1.1) für Lückenbreiten.
function MapBuilder:D(value: number): number
	return value * (0.8 + 0.1 * self.Difficulty)
end

function MapBuilder:_track(x1, y1, x2, y2)
	self.MinX = math.min(self.MinX, x1, x2)
	self.MaxX = math.max(self.MaxX, x1, x2)
	self.MinY = math.min(self.MinY, y1, y2)
	self.MaxY = math.max(self.MaxY, y1, y2)
end

--- Theme-Feld mit Standardwert.
function MapBuilder:_t(key: string)
	local value = self.Theme[key]
	if value == nil then
		return THEME_DEFAULTS[key]
	end
	return value
end

--- Material für Wände, Tunneldecken und Kletterblöcke.
function MapBuilder:_wallMaterial()
	return self.Theme.WallMaterial or self.Theme.GroundMaterial
end

------------------------------------------------------------------------
-- Primitive
------------------------------------------------------------------------

--- Erstellt einen verankerten Part. props: Size, CFrame, Color, Material, Transparency,
--- CanCollide, CanQuery, CastShadow, Parent, Shape, Wedge, Name
function MapBuilder:Part(props): BasePart
	local part: BasePart
	if props.Wedge then
		part = Instance.new("WedgePart")
	else
		local p = Instance.new("Part")
		if props.Shape then
			p.Shape = props.Shape
		end
		part = p
	end
	part.Name = props.Name or "Part"
	part.Anchored = true
	part.Size = props.Size
	part.CFrame = props.CFrame
	part.Color = props.Color or self.Theme.Ground
	part.Material = props.Material or self.Theme.GroundMaterial
	part.Transparency = props.Transparency or 0
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	local collide = props.CanCollide ~= false
	part.CanCollide = collide
	if props.CanQuery ~= nil then
		part.CanQuery = props.CanQuery
	else
		part.CanQuery = collide
	end
	part.CanTouch = false
	if props.CastShadow ~= nil then
		part.CastShadow = props.CastShadow
	else
		part.CastShadow = collide
	end
	part.Parent = props.Parent or self.Folders.Geometry
	return part
end

--- Dekorations-Part (keine Kollision, keine Abfragen, kein Schatten).
--- extra: Name, Transparency, Shape, Wedge, Mesh (Enum.MeshType), Light ({Range, Brightness, Color})
function MapBuilder:Deco(size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?, extra)
	local props = {
		Name = extra and extra.Name or "Deco",
		Size = size,
		CFrame = cframe,
		Color = color,
		Material = material or M.SmoothPlastic,
		Transparency = extra and extra.Transparency or 0,
		Shape = extra and extra.Shape or nil,
		Wedge = extra and extra.Wedge or nil,
		CanCollide = false,
		CanQuery = false,
		CastShadow = false,
		Parent = self.Folders.Decor,
	}
	local part = self:Part(props)
	if extra then
		if extra.Mesh then
			-- Eingebautes Mesh (z.B. Kugel) passt sich der Part-Größe an -> Ellipsoide
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = extra.Mesh
			mesh.Parent = part
		end
		if extra.Light and self.LightCount < self.MaxLights then
			self.LightCount += 1
			local light = Instance.new("PointLight")
			light.Range = extra.Light.Range or 12
			light.Brightness = extra.Light.Brightness or 1
			light.Color = extra.Light.Color or color
			light.Shadows = false
			light.Parent = part
		end
	end
	return part
end

--- Achsparalleler Block zwischen zwei lokalen Ecken (volle Spurtiefe).
function MapBuilder:Box(x1: number, y1: number, x2: number, y2: number, opts)
	opts = opts or {}
	if x2 < x1 then
		x1, x2 = x2, x1
	end
	if y2 < y1 then
		y1, y2 = y2, y1
	end
	local depth = opts.Depth or DEPTH
	local size = Vector3.new(math.max(x2 - x1, 0.05), math.max(y2 - y1, 0.05), depth)
	local cframe = CFrame.new(self:W((x1 + x2) / 2, (y1 + y2) / 2, opts.Z or 0))
	if opts.Track ~= false and opts.CanCollide ~= false then
		self:_track(x1, y1, x2, y2)
	end
	return self:Part({
		Name = opts.Name,
		Size = size,
		CFrame = cframe,
		Color = opts.Color,
		Material = opts.Material,
		Transparency = opts.Transparency,
		CanCollide = opts.CanCollide,
		CanQuery = opts.CanQuery,
		CastShadow = opts.CastShadow,
		Parent = opts.Parent,
		Shape = opts.Shape,
	})
end

--- Plattform mit Oberkante y. opts: Thickness, Ice, TopColor, TopMaterial, NoDress
--- (NoDress = true: keine automatische Verzierung in Decorate()).
function MapBuilder:Ground(x1: number, x2: number, y: number, opts)
	opts = opts or {}
	local theme = self.Theme
	local thickness = opts.Thickness or self.Thickness
	local topThickness = math.min(1, thickness)
	if thickness > topThickness then
		self:Box(x1, y - thickness, x2, y - topThickness, {
			Name = "Ground",
			Color = theme.Ground,
			Material = theme.GroundMaterial,
		})
	end
	local top = self:Box(x1, y - topThickness, x2, y, {
		Name = "Floor",
		Color = opts.TopColor or theme.Top,
		Material = opts.TopMaterial or theme.TopMaterial,
	})
	if opts.Ice then
		top:SetAttribute("Ice", true)
		top.Material = M.Ice
		top.Color = rgb(200, 238, 255)
	end
	table.insert(self.Platforms, {
		X1 = math.min(x1, x2),
		X2 = math.max(x1, x2),
		Y = y,
		Bottom = y - thickness,
		Ice = opts.Ice == true,
		Upper = self.NoPitHazard,
		NoDress = opts.NoDress == true,
	})
	return top
end

--- Rampe von (x1, y1) nach (x2, y2) inklusive Unterbau.
function MapBuilder:RampPart(x1: number, y1: number, x2: number, y2: number, opts)
	opts = opts or {}
	local theme = self.Theme
	local thickness = opts.Thickness or self.Thickness
	local low, high = math.min(y1, y2), math.max(y1, y2)
	local length = x2 - x1
	local rise = high - low
	if rise > 0.05 then
		-- Keil: hohe Seite liegt lokal bei +Z; Drehung um Y richtet sie entlang ±X aus.
		local angle = if y2 > y1 then math.rad(90) else math.rad(-90)
		self:Part({
			Wedge = true,
			Name = "Ramp",
			Size = Vector3.new(DEPTH, rise, length),
			CFrame = CFrame.new(self:W((x1 + x2) / 2, (low + high) / 2, 0)) * CFrame.Angles(0, angle, 0),
			Color = theme.Top,
			Material = theme.TopMaterial,
		})
	end
	self:Box(x1, low - thickness, x2, low, { Name = "RampBase", Color = theme.Ground, Material = theme.GroundMaterial })
	self:_track(x1, low - thickness, x2, high)
	table.insert(self.Ramps, { X1 = x1, Y1 = y1, X2 = x2, Y2 = y2, Bottom = low - thickness })
end

--- Greifhaken-Anker an lokaler Position.
function MapBuilder:Anchor(x: number, y: number)
	local theme = self.Theme
	local color = theme.Anchor or theme.Accent
	local position = self:W(x, y, 0)
	local part = self:Part({
		Name = "GrappleAnchor",
		Shape = BALL,
		Size = Vector3.new(1.8, 1.8, 1.8),
		CFrame = CFrame.new(position),
		Color = color,
		Material = NEON,
		CanCollide = false,
		CanQuery = false,
		CastShadow = false,
		Parent = self.Folders.Anchors,
	})
	self:Deco(Vector3.new(0.25, 3.4, 3.4), CFrame.new(position) * FACING, color, NEON, {
		Name = "AnchorRing",
		Shape = CYL,
		Transparency = 0.45,
		Light = { Range = 14, Brightness = 1.2, Color = color },
	})
	-- Weicher Halo direkt hinter dem Anker
	self:Deco(Vector3.new(0.1, 5.4, 5.4), CFrame.new(position + Vector3.new(0, 0, -0.9)) * FACING, color, NEON, {
		Name = "AnchorHalo",
		Shape = CYL,
		Transparency = 0.82,
	})
	table.insert(self.Anchors, part)
	return part
end

--- Dreieck in der Seitenansicht aus zwei Keilen (Spitze oben oder unten).
--- yBase = Grundlinie (bei pointDown die Oberkante).
function MapBuilder:_triangle(cx, yBase, width, height, depth, z, color, material, pointDown, name, list)
	local half = width / 2
	local yCenter = if pointDown then yBase - height / 2 else yBase + height / 2
	local flip = if pointDown then CFrame.Angles(0, 0, math.rad(180)) else CFrame.identity
	local size = Vector3.new(depth, height, half)
	local a = self:Deco(size, CFrame.new(self:W(cx - half / 2, yCenter, z)) * flip * CFrame.Angles(0, math.rad(if pointDown then -90 else 90), 0), color, material, { Name = name, Wedge = true })
	local b = self:Deco(size, CFrame.new(self:W(cx + half / 2, yCenter, z)) * flip * CFrame.Angles(0, math.rad(if pointDown then 90 else -90), 0), color, material, { Name = name, Wedge = true })
	if list then
		table.insert(list, a)
		table.insert(list, b)
	end
end

--- Leuchtpfeil aus zwei Balken: dir "Up" (^) oder "Right" (>).
function MapBuilder:_chevron(cx, cy, z, size, color, dir, name, transparency)
	local len = size * 0.72
	local thick = size * 0.24
	local extra = { Name = name or "Chevron", Transparency = transparency or 0 }
	local bar = Vector3.new(len, thick, 0.14)
	if dir == "Up" then
		local a = math.atan2(0.6, 0.4)
		self:Deco(bar, CFrame.new(self:W(cx - size * 0.2, cy, z)) * CFrame.Angles(0, 0, a), color, NEON, extra)
		self:Deco(bar, CFrame.new(self:W(cx + size * 0.2, cy, z)) * CFrame.Angles(0, 0, -a), color, NEON, extra)
	else
		local a = math.atan2(0.4, 0.6)
		self:Deco(bar, CFrame.new(self:W(cx, cy + size * 0.2, z)) * CFrame.Angles(0, 0, -a), color, NEON, extra)
		self:Deco(bar, CFrame.new(self:W(cx, cy - size * 0.2, z)) * CFrame.Angles(0, 0, a), color, NEON, extra)
	end
end

--- Zacken-Dekoration (Dornen/Stacheln/Eiszapfen) entlang einer Kante.
function MapBuilder:_teeth(x1: number, x2: number, y: number, height: number, color: Color3, material, pointDown: boolean?)
	local width = x2 - x1
	local count = math.clamp(math.floor(width / 2.5), 1, 24)
	local toothWidth = width / count
	for i = 0, count - 1 do
		local cx = x1 + toothWidth * (i + 0.5)
		self:_triangle(cx, y, toothWidth, height, DEPTH * 0.8, 0, color, material, pointDown == true, "Tooth")
	end
end

--- Tödlicher Bereich. opts: Period, OnTime, Offset (zeitgesteuert), Depth, Color, Teeth
function MapBuilder:Hazard(x1: number, y1: number, x2: number, y2: number, kind: string, opts)
	opts = opts or {}
	local style = HAZARD_STYLE[kind] or HAZARD_STYLE.Laser
	local part = self:Box(x1, y1, x2, y2, {
		Name = "Hazard_" .. kind,
		Color = opts.Color or style.Color,
		Material = style.Material,
		Transparency = style.Transparency,
		CanCollide = false,
		CanQuery = true,
		CastShadow = false,
		Depth = opts.Depth,
		Parent = self.Folders.Hazards,
		Track = false,
	})
	part:SetAttribute("HazardKind", kind)
	if opts.Period then
		part:SetAttribute("HazardPeriod", opts.Period)
		part:SetAttribute("HazardOnTime", opts.OnTime or opts.Period / 2)
		part:SetAttribute("HazardOffset", opts.Offset or 0)
		CollectionService:AddTag(part, "TimedHazard")
	end
	if opts.Teeth ~= false and TEETH_KINDS[kind] and not opts.Period then
		self:_teeth(math.min(x1, x2), math.max(x1, x2), math.max(y1, y2), 1.6, style.Color, style.Material, false)
	end
	return part
end

--- Boost-Pad (beschleunigt in +X-Richtung).
function MapBuilder:BoostPad(x1: number, x2: number, y: number, power: number?)
	local pad = self:Box(x1, y - 0.1, x2, y + 0.06, {
		Name = "BoostPad",
		Color = rgb(255, 176, 20),
		Material = NEON,
		Depth = DEPTH - 1,
		Parent = self.Folders.Pads,
		Track = false,
	})
	pad:SetAttribute("BoostPad", power or 80)
	local lo, hi = math.min(x1, x2), math.max(x1, x2)
	self:Reserve(lo - 1, hi + 1)
	-- Pfeile (">") auf der Vorderseite des Bodens – gut sichtbar, verdecken nichts
	local count = math.clamp(math.floor((hi - lo) / 5), 1, 8)
	for i = 1, count do
		local cx = lo + (hi - lo) * i / (count + 1)
		self:_chevron(cx, y - 0.55, FACE_Z + 0.1, 0.95, rgb(255, 226, 120), "Right", "BoostArrow")
	end
	-- Leuchtschiene hinter dem Pad
	self:Deco(Vector3.new(hi - lo, 0.22, 0.22), CFrame.new(self:W((lo + hi) / 2, y + 1.1, -4.75)), rgb(255, 196, 60), NEON, { Name = "BoostRail" })
	for _, px in { lo + 0.3, hi - 0.3 } do
		self:Deco(Vector3.new(0.3, 1.1, 0.3), CFrame.new(self:W(px, y + 0.55, -4.75)), rgb(60, 62, 72), M.Metal, { Name = "BoostRailPost" })
	end
	return pad
end

--- Sprungpad mit vertikaler Startgeschwindigkeit `power`.
function MapBuilder:JumpPad(x: number, y: number, power: number)
	local pad = self:Box(x - 2.5, y - 0.1, x + 2.5, y + 0.3, {
		Name = "JumpPad",
		Color = rgb(80, 255, 140),
		Material = NEON,
		Depth = DEPTH - 2,
		Parent = self.Folders.Pads,
		Track = false,
	})
	pad:SetAttribute("JumpPad", power)
	self:Reserve(x - 4, x + 4)
	local glow = rgb(150, 255, 190)
	-- Gehäuserahmen (unterhalb der Pad-Oberkante)
	self:Deco(Vector3.new(6.2, 0.3, DEPTH - 1.2), CFrame.new(self:W(x, y + 0.05, 0)), rgb(48, 54, 66), M.Metal, { Name = "JumpPadFrame" })
	-- Pfeile nach oben: auf der Vorderseite des Bodens und gestaffelt hinter dem Pad
	self:_chevron(x - 1.1, y - 0.55, FACE_Z + 0.1, 0.9, glow, "Up", "JumpPadArrow")
	self:_chevron(x + 1.1, y - 0.55, FACE_Z + 0.1, 0.9, glow, "Up", "JumpPadArrow")
	for i = 1, 3 do
		self:_chevron(x, y + 0.6 + i * 1.4, -4.6, 1.6, glow, "Up", "JumpPadArrow", 0.1 + i * 0.2)
	end
	-- Aufsteigende Funken
	local holder = self:Deco(Vector3.new(4, 0.2, DEPTH - 3), CFrame.new(self:W(x, y + 0.4, 0)), glow, nil, { Name = "JumpPadSparks", Transparency = 1 })
	emitter(holder, {
		Rate = 6,
		Lifetime = NumberRange.new(0.6, 1.1),
		Speed = NumberRange.new(6, 11),
		EmissionDirection = Enum.NormalId.Top,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) }),
		Color = ColorSequence.new(glow),
		LightEmission = 1,
		SpreadAngle = Vector2.new(6, 6),
	})
	return pad
end

--- Spawnpunkt (Root-Position über dem Boden y, Blick nach +X).
function MapBuilder:SpawnPoint(x: number, y: number, z: number?)
	local position = self:W(x, y + ROOT_HEIGHT, z or 0)
	table.insert(self.Spawns, CFrame.lookAt(position, position + Vector3.new(1, 0, 0)))
end

--- Checkpoint für Respawns (inkl. Fahne mit Leuchtkugel).
function MapBuilder:Checkpoint(x: number?, y: number?)
	local cx = x or self.X
	local cy = y or self.Y
	local position = self:W(cx, cy + ROOT_HEIGHT, 0)
	table.insert(self.Checkpoints, {
		X = position.X,
		CFrame = CFrame.lookAt(position, position + Vector3.new(1, 0, 0)),
	})
	self.LastCheckpointX = cx
	self:Reserve(cx - 2.5, cx + 4.5)
	local theme = self.Theme
	local accent = theme.Accent
	local z = -DEPTH / 2 + 0.4
	self:Deco(Vector3.new(0.4, 2.2, 2.2), CFrame.new(self:W(cx, cy + 0.2, z)) * VERTICAL, rgb(52, 56, 70), M.Metal, { Name = "CheckpointBase", Shape = CYL })
	self:Deco(Vector3.new(9.4, 0.32, 0.32), CFrame.new(self:W(cx, cy + 4.9, z)) * VERTICAL, rgb(236, 238, 246), M.Metal, { Name = "CheckpointPole", Shape = CYL })
	self:Deco(Vector3.new(0.18, 0.56, 0.56), CFrame.new(self:W(cx, cy + 6.4, z)) * VERTICAL, theme.Accent2 or accent, NEON, { Name = "CheckpointRing", Shape = CYL })
	self:Deco(Vector3.new(0.9, 0.9, 0.9), CFrame.new(self:W(cx, cy + 9.85, z)), accent, NEON, {
		Name = "CheckpointOrb",
		Shape = BALL,
		Light = { Range = 12, Brightness = 1.3, Color = accent },
	})
	-- Wimpel: ein Keil, rechter Winkel oben am Mast, Spitze zeigt in Laufrichtung
	self:Deco(
		Vector3.new(0.14, 2.4, 3.4),
		CFrame.new(self:W(cx + 1.85, cy + 8.2, z)) * CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(math.rad(180), 0, 0),
		accent,
		NEON,
		{ Name = "CheckpointFlag", Wedge = true }
	)
end

function MapBuilder:_autoCheckpoint(x: number, y: number)
	if self.AutoCheckpoints and x - self.LastCheckpointX >= self.CheckpointSpacing then
		self:Checkpoint(x, y)
	end
end

function MapBuilder:_node(x: number, y: number)
	table.insert(self.TeleportNodes, self:W(x, y + ROOT_HEIGHT, 0))
end

--- Spawnpunkt für eine Item-Box (Box schwebt auf Brusthöhe).
function MapBuilder:PickupSpot(x: number, y: number)
	table.insert(self.PickupSpawns, self:W(x, y + 3, 0))
end

--- Schild (BillboardGui) an lokaler Position.
--- opts: Width, Height, Color, Transparent, Z, Style ("Banner" = nur große Schrift mit Kontur)
function MapBuilder:Sign(x: number, y: number, title: string, text: string?, opts)
	opts = opts or {}
	local accent = opts.Color or self.Theme.Accent
	local hasBody = text ~= nil and text ~= ""
	local banner = opts.Style == "Banner"
	local plain = banner or opts.Transparent == true
	local holder = self:Deco(Vector3.new(0.2, 0.2, 0.2), CFrame.new(self:W(x, y, opts.Z or -2)), Color3.new(), nil, { Name = "Sign", Transparency = 1 })
	local gui = Instance.new("BillboardGui")
	gui.Name = "SignGui"
	gui.Size = UDim2.new(opts.Width or 26, 0, opts.Height or (if hasBody then 7 else 4), 0)
	gui.LightInfluence = 0
	gui.MaxDistance = 260
	gui.Adornee = holder

	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = rgb(20, 24, 46)
	frame.BackgroundTransparency = if plain then 1 else 0.1
	frame.BorderSizePixel = 0
	frame.Parent = gui
	if not plain then
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.16, 0)
		corner.Parent = frame
		local gradient = Instance.new("UIGradient")
		gradient.Color = ColorSequence.new(rgb(255, 255, 255), rgb(150, 158, 200))
		gradient.Rotation = 90
		gradient.Parent = frame
		local stroke = Instance.new("UIStroke")
		stroke.Color = accent
		stroke.Thickness = 3
		stroke.Parent = frame
		-- Akzent-Reiter an der Oberkante
		local tab = Instance.new("Frame")
		tab.AnchorPoint = Vector2.new(0.5, 0.5)
		tab.Position = UDim2.fromScale(0.5, 0)
		tab.Size = UDim2.fromScale(0.36, 0.09)
		tab.BackgroundColor3 = accent
		tab.BorderSizePixel = 0
		tab.Parent = frame
		local tabCorner = Instance.new("UICorner")
		tabCorner.CornerRadius = UDim.new(1, 0)
		tabCorner.Parent = tab
	end

	local titleLabel = Instance.new("TextLabel")
	titleLabel.BackgroundTransparency = 1
	titleLabel.Size = if hasBody then UDim2.fromScale(0.92, 0.46) else UDim2.fromScale(0.92, 0.8)
	titleLabel.Position = UDim2.fromScale(0.04, 0.1)
	titleLabel.Font = Enum.Font.FredokaOne
	titleLabel.TextScaled = true
	titleLabel.TextColor3 = if banner then WHITE else accent
	titleLabel.TextStrokeColor3 = rgb(10, 12, 24)
	titleLabel.TextStrokeTransparency = if banner then 1 else 0.5
	titleLabel.Text = title
	titleLabel.Parent = frame
	if banner then
		local outline = Instance.new("UIStroke")
		outline.Color = rgb(12, 14, 26)
		outline.Thickness = 4
		outline.Parent = titleLabel
		local tint = Instance.new("UIGradient")
		tint.Color = ColorSequence.new(WHITE, accent)
		tint.Rotation = 90
		tint.Parent = titleLabel
	end

	if hasBody then
		local body = Instance.new("TextLabel")
		body.BackgroundTransparency = 1
		body.Size = UDim2.fromScale(0.92, 0.36)
		body.Position = UDim2.fromScale(0.04, 0.58)
		body.Font = Enum.Font.GothamBold
		body.TextScaled = true
		body.TextColor3 = rgb(236, 240, 255)
		body.TextStrokeColor3 = rgb(10, 12, 24)
		body.TextStrokeTransparency = 0.7
		body.Text = text
		body.Parent = frame
	end
	gui.Parent = holder
	return holder
end

--- Portal in der Lobby (Stehenbleiben löst eine Aktion aus).
function MapBuilder:Portal(x: number, y: number, action: string, label: string, color: Color3)
	local z = -3
	local frame = rgb(40, 44, 62)
	self:Reserve(x - 7.5, x + 7.5)
	self:Deco(Vector3.new(14, 0.4, 3.4), CFrame.new(self:W(x, y + 0.2, z)), frame, M.Metal, { Name = "PortalBase" })
	for _, side in { -1, 1 } do
		self:Deco(Vector3.new(1.4, 13, 2.4), CFrame.new(self:W(x + side * 5.6, y + 6.5, z)), frame, M.Metal, { Name = "PortalPost" })
		self:Deco(Vector3.new(0.35, 12.4, 2.5), CFrame.new(self:W(x + side * 4.95, y + 6.5, z)), color, NEON, { Name = "PortalPostGlow" })
	end
	self:Deco(Vector3.new(12.6, 1.4, 2.4), CFrame.new(self:W(x, y + 13.6, z)), frame, M.Metal, { Name = "PortalTop" })
	self:Deco(Vector3.new(10, 0.35, 2.5), CFrame.new(self:W(x, y + 12.95, z)), color, NEON, { Name = "PortalTopGlow" })
	local field = self:Deco(Vector3.new(9.6, 12.4, 0.4), CFrame.new(self:W(x, y + 6.5, z - 0.5)), color, M.ForceField, {
		Name = "PortalField",
		Transparency = 0.2,
		Light = { Range = 16, Brightness = 2, Color = color },
	})
	emitter(field, {
		Rate = 6,
		Lifetime = NumberRange.new(1.5, 2.5),
		Speed = NumberRange.new(1, 3),
		EmissionDirection = Enum.NormalId.Top,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0) }),
		Color = ColorSequence.new(color),
		LightEmission = 1,
		SpreadAngle = Vector2.new(30, 30),
	})
	self:Sign(x, y + 17, label, "Hier stehen bleiben", { Width = 16, Height = 5, Color = color })
	local minCorner = self:W(x - 5, y, 0)
	local maxCorner = self:W(x + 5, y + 12, 0)
	table.insert(self.Portals, {
		Action = action,
		MinX = minCorner.X,
		MaxX = maxCorner.X,
		MinY = minCorner.Y,
		MaxY = maxCorner.Y,
	})
end

--- Markiert einen Bereich, in dem Decorate() keine Requisiten aufstellt.
function MapBuilder:Reserve(x1: number, x2: number)
	table.insert(self.Reserved, { math.min(x1, x2), math.max(x1, x2) })
end

function MapBuilder:_isReserved(x1: number, x2: number): boolean
	for _, r in self.Reserved do
		if x2 >= r[1] and x1 <= r[2] then
			return true
		end
	end
	return false
end

--- Höchste Oberkante bei x (Böden, Rampen; optional auch Wände/Blöcke).
--- maxY: nur Oberkanten unterhalb dieser Höhe berücksichtigen.
function MapBuilder:_topAt(x: number, maxY: number?, withSolids: boolean?): number?
	local best = nil
	local function consider(y)
		if (maxY == nil or y < maxY) and (best == nil or y > best) then
			best = y
		end
	end
	for _, p in self.Platforms do
		if x >= p.X1 - 0.01 and x <= p.X2 + 0.01 then
			consider(p.Y)
		end
	end
	for _, r in self.Ramps do
		if x >= r.X1 and x <= r.X2 then
			local t = (x - r.X1) / math.max(r.X2 - r.X1, 0.01)
			consider(r.Y1 + (r.Y2 - r.Y1) * t)
		end
	end
	if withSolids then
		for _, s in self.Solids do
			if x >= s.X1 - 0.01 and x <= s.X2 + 0.01 then
				consider(s.Y2)
			end
		end
	end
	return best
end

--- Oberkante des höchsten Bodens (oder der höchsten Rampe) bei x.
function MapBuilder:FloorAt(x: number): number?
	return self:_topAt(x)
end

------------------------------------------------------------------------
-- Cursor-Bausteine
------------------------------------------------------------------------

--- Zierleisten auf der Vorderseite einer Wand bzw. eines Blocks (x1..x2, y1..y2).
--- opts.NoCenter: keine Mittellinie/Bänder (z.B. wenn Pfeile darauf sitzen).
function MapBuilder:_wallFace(x1: number, x2: number, y1: number, y2: number, opts)
	opts = opts or {}
	local theme = self.Theme
	local trim, trimMat = self:_t("Trim"), self:_t("TrimMaterial")
	local w, h = x2 - x1, y2 - y1
	local cx, cy = (x1 + x2) / 2, (y1 + y2) / 2
	if w >= 3 then
		for _, ex in { x1 + 0.35, x2 - 0.35 } do
			self:Deco(Vector3.new(0.7, h - 0.5, 0.3), CFrame.new(self:W(ex, cy - 0.25, FACE_Z + 0.15)), trim, trimMat, { Name = "WallTrim" })
		end
	end
	self:Deco(Vector3.new(w + 0.3, 0.5, 0.7), CFrame.new(self:W(cx, y2 - 0.2, FACE_Z)), trim, trimMat, { Name = "Lip" })
	if opts.NoCenter then
		return
	end
	if theme.EdgeGlow then
		self:Deco(Vector3.new(0.22, math.max(h - 3, 0.5), 0.1), CFrame.new(self:W(cx, cy, FACE_Z + 0.06)), theme.Accent, NEON, { Name = "WallGlow" })
	elseif w >= 3 then
		local detail, detailMat = self:_t("Detail"), self:_t("DetailMaterial")
		local by = y2 - 4
		while by > y1 + 2 do
			self:Deco(Vector3.new(w - 1.6, 0.4, 0.12), CFrame.new(self:W(cx, by, FACE_Z + 0.06)), detail, detailMat, { Name = "WallBand" })
			by -= 14
		end
	end
end

--- Startbereich: Rückwand, Boden, 8 Spawnpunkte (gleiche X-Position, gestaffelte Tiefe), Startlinie.
function MapBuilder:Start(length: number?)
	local len = length or 60
	local theme = self.Theme
	local y = self.Y
	self:Box(-48, y - self.Thickness, -40, y + 70, { Name = "StartWall", Color = theme.Wall, Material = self:_wallMaterial() })
	table.insert(self.Solids, { X1 = -48, X2 = -40, Y1 = y - self.Thickness, Y2 = y + 70 })
	self:Ground(-40, len, y)
	for i = 0, 7 do
		self:SpawnPoint(22, y, -3.5 + i)
	end
	self:Checkpoint(22, y)
	self.StartLocalX = 34
	self:Deco(Vector3.new(0.6, 0.12, DEPTH), CFrame.new(self:W(34, y + 0.07, 0)), rgb(255, 255, 255), NEON, { Name = "StartLine" })
	self:_node(10, y)
	self.X = len

	-- Optik: Startbogen (mit Schriftzug), verzierte Startwand, Fahnen
	self:Reserve(-40, 50)
	self:Arch(34, y, 18, 16, theme.Accent, { Label = "START" })
	self:_wallFace(-48, -40, y - self.Thickness, y + 70)
	self:Banner(-30, y, theme.Accent, { Height = 12, Width = 3.4, Color2 = theme.Accent2 })
	self:Banner(-8, y, theme.Accent2 or theme.Accent, { Height = 12, Width = 3.4, Color2 = theme.Accent })
	self:Lamp(6, y)
	-- Startraster: Leuchtmarken auf der Vorderseite des Bodens
	for i = 0, 3 do
		self:Deco(Vector3.new(1.6, 0.35, 0.1), CFrame.new(self:W(22 + i * 3.2 - 4.8, y - 0.9, FACE_Z + 0.12)), WHITE, NEON, { Name = "GridMark", Transparency = 0.25 })
	end
end

--- Gerader Boden.
function MapBuilder:Flat(length: number, opts)
	local x1, x2 = self.X, self.X + length
	self:Ground(x1, x2, self.Y, opts)
	self:_node(x1 + length * 0.5, self.Y)
	self:_autoCheckpoint(x1 + math.min(8, length / 2), self.Y)
	self.X = x2
end

--- Gefahr am Grund einer Lücke (abhängig vom Theme).
function MapBuilder:_pitHazard(x1: number, x2: number, refY: number)
	if self.NoPitHazard then
		return
	end
	local kind = self.Theme.PitKind
	local bottom = refY - 24
	if kind == "Lava" then
		self:Hazard(x1 - 2, bottom - 4, x2 + 2, bottom, "Lava")
	elseif kind == "IceWater" or kind == "River" then
		self:Hazard(x1 - 2, bottom - 6, x2 + 2, bottom, kind)
	elseif kind == "Thorns" then
		self:Hazard(x1 - 2, bottom - 2, x2 + 2, bottom, "Thorns")
	elseif kind == "Void" then
		self:Hazard(x1 - 2, bottom - 12, x2 + 2, bottom - 11, "Void")
	else
		self:Hazard(x1 - 2, bottom - 0.6, x2 + 2, bottom, "Laser")
	end
	self:_track(x1, bottom - 6, x2, bottom - 6)
	self:_pitDecor(kind, x1 - 2, x2 + 2, bottom)
end

--- Optik der Grubengefahren (Kruste, Laser-Netz, Schaum, Nebel …).
function MapBuilder:_pitDecor(kind: string, x1: number, x2: number, surface: number)
	local rng = self.Rng
	local w = x2 - x1
	local cx = (x1 + x2) / 2
	if kind == "Lava" then
		for _ = 1, math.clamp(math.floor(w / 9), 1, 5) do
			self:Deco(
				Vector3.new(rng:NextNumber(2.5, 5), 0.5, rng:NextNumber(1.5, 3.5)),
				CFrame.new(self:W(rng:NextNumber(x1 + 2, x2 - 2), surface + 0.12, rng:NextNumber(-3.5, 3.5))) * CFrame.Angles(0, math.rad(rng:NextNumber(0, 180)), 0),
				rgb(58, 40, 34),
				M.CrackedLava,
				{ Name = "LavaCrust" }
			)
		end
		local glow = self:Deco(Vector3.new(w, 0.4, DEPTH - 2), CFrame.new(self:W(cx, surface + 0.6, 0)), HAZARD_STYLE.Lava.Color, nil, {
			Name = "LavaGlow",
			Transparency = 1,
			Light = { Range = 26, Brightness = 2, Color = rgb(255, 120, 40) },
		})
		emitter(glow, {
			Rate = 5,
			Lifetime = NumberRange.new(1.5, 2.5),
			Speed = NumberRange.new(5, 10),
			EmissionDirection = Enum.NormalId.Top,
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) }),
			Color = ColorSequence.new(rgb(255, 170, 60)),
			LightEmission = 1,
			SpreadAngle = Vector2.new(20, 20),
		})
	elseif kind == "IceWater" or kind == "River" then
		local deep = if kind == "River" then rgb(18, 70, 80) else rgb(20, 60, 120)
		local surfaceColor = if kind == "River" then rgb(150, 220, 210) else rgb(180, 232, 255)
		self:Deco(Vector3.new(w, 0.2, DEPTH - 0.4), CFrame.new(self:W(cx, surface - 0.08, 0)), surfaceColor, M.Glass, { Name = "WaterSurface", Transparency = 0.55 })
		self:Deco(Vector3.new(w, 2.4, DEPTH - 0.4), CFrame.new(self:W(cx, surface - 4.6, 0)), deep, M.SmoothPlastic, { Name = "WaterDeep", Transparency = 0.1 })
		for _ = 1, math.clamp(math.floor(w / 12), 1, 3) do
			local fx = rng:NextNumber(x1 + 2, x2 - 2)
			local fz = rng:NextNumber(-3, 3)
			if kind == "IceWater" then
				self:Deco(Vector3.new(rng:NextNumber(2.5, 4.5), 0.6, rng:NextNumber(2, 3.5)), CFrame.new(self:W(fx, surface + 0.05, fz)) * CFrame.Angles(0, math.rad(rng:NextNumber(0, 180)), 0), rgb(226, 244, 255), M.Ice, { Name = "IceFloe" })
			else
				self:Deco(Vector3.new(0.15, 2.2, 2.2), CFrame.new(self:W(fx, surface + 0.08, fz)) * VERTICAL, rgb(80, 160, 70), M.Grass, { Name = "LilyPad", Shape = CYL })
			end
		end
	elseif kind == "Thorns" then
		for _ = 1, math.clamp(math.floor(w / 8), 1, 4) do
			local d = rng:NextNumber(2.2, 3.4)
			self:Deco(Vector3.new(d, d, d), CFrame.new(self:W(rng:NextNumber(x1 + 1, x2 - 1), surface + 0.4, rng:NextNumber(-4, -2.5))), rgb(46, 74, 40), M.Grass, { Name = "Bramble", Shape = BALL })
		end
	elseif kind == "Void" then
		local color = HAZARD_STYLE.Void.Color
		local mist = self:Deco(Vector3.new(w, 0.5, DEPTH - 2), CFrame.new(self:W(cx, surface - 11, 0)), color, nil, { Name = "VoidMist", Transparency = 1 })
		emitter(mist, {
			Rate = 4,
			Lifetime = NumberRange.new(2, 3.5),
			Speed = NumberRange.new(2, 5),
			EmissionDirection = Enum.NormalId.Top,
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) }),
			Color = ColorSequence.new(color),
			LightEmission = 1,
			SpreadAngle = Vector2.new(25, 25),
		})
		for _ = 1, math.clamp(math.floor(w / 20), 1, 2) do
			local rx = rng:NextNumber(x1 + 3, x2 - 3)
			local ry = surface + rng:NextNumber(-6, 4)
			self:Deco(Vector3.new(0.15, 4.2, 4.2), CFrame.new(self:W(rx, ry, -4.6)) * FACING, color, NEON, { Name = "RuneRing", Shape = CYL, Transparency = 0.55 })
			self:Deco(Vector3.new(0.9, 0.9, 0.9), CFrame.new(self:W(rx, ry, -4.5)) * CFrame.Angles(0, 0, math.rad(45)), rgb(220, 190, 255), NEON, { Name = "RuneCrystal" })
		end
	else
		-- Laser-Netz mit Emitter-Gehäusen an beiden Enden
		local color = HAZARD_STYLE.Laser.Color
		for _, lz in { -3, 0, 3 } do
			self:Deco(Vector3.new(w, 0.12, 0.12), CFrame.new(self:W(cx, surface + 0.05, lz)), rgb(255, 150, 200), NEON, { Name = "LaserBeam" })
		end
		for _, ex in { x1 - 0.6, x2 + 0.6 } do
			self:Deco(Vector3.new(1.2, 1.6, DEPTH), CFrame.new(self:W(ex, surface - 0.3, 0)), rgb(44, 46, 60), M.Metal, { Name = "LaserHousing" })
		end
		self:Deco(Vector3.new(w, 0.3, DEPTH - 2), CFrame.new(self:W(cx, surface + 1.5, 0)), color, nil, {
			Name = "LaserGlow",
			Transparency = 1,
			Light = { Range = 18, Brightness = 1.4, Color = color },
		})
	end
end

--- Sprunglücke mit Landeplattform.
function MapBuilder:Gap(width: number, dy: number?, landing: number?)
	local rise = dy or 0
	self:_pitHazard(self.X, self.X + width, self.Y + math.min(0, rise))
	self.X += width
	self.Y += rise
	self:Flat(landing or 30)
end

--- Treppe mit `count` Stufen.
function MapBuilder:Steps(count: number, rise: number, run: number)
	local startY = self.Y
	local finalY = startY + rise * count
	local baseY = math.min(startY, finalY) - self.Thickness
	for i = 1, count do
		local top = startY + rise * i
		self:Ground(self.X, self.X + run, top, { Thickness = top - baseY })
		self.X += run
	end
	self.Y = finalY
	self:_node(self.X - run / 2, self.Y)
end

--- Absatz nach unten.
function MapBuilder:Drop(height: number, landing: number?)
	self.Y -= height
	self:Flat(landing or 40)
end

--- Absatz nach oben (Wand der Höhe `height`).
function MapBuilder:Climb(height: number, landing: number?)
	self.Y += height
	local len = landing or 30
	self:Ground(self.X, self.X + len, self.Y, { Thickness = height + self.Thickness })
	self:_node(self.X + len / 2, self.Y)
	self.X += len
end

--- Rampe über `length` Studs mit Höhenänderung `rise`.
function MapBuilder:Ramp(length: number, rise: number)
	self:RampPart(self.X, self.Y, self.X + length, self.Y + rise)
	self.X += length
	self.Y += rise
end

--- Tunnel mit niedriger Decke: nur rutschend passierbar.
--- opts.Lethal = true: Gefahrenstreifen an der Deckenunterkante.
function MapBuilder:SlideTunnel(length: number, opts)
	opts = opts or {}
	local theme = self.Theme
	local x1 = self.X
	local y = self.Y
	self:Flat(length + 8)
	local ceilingBottom = if opts.Lethal then y + 4.4 else y + 3.6
	self:Box(x1 + 4, ceilingBottom, x1 + 4 + length, y + 15.6, { Name = "TunnelCeiling", Color = theme.Wall, Material = self:_wallMaterial() })
	if opts.Lethal then
		self:Hazard(x1 + 4, y + 3.6, x1 + 4 + length, y + 4.4, theme.HazardKind, { Teeth = false })
		if TEETH_KINDS[theme.HazardKind] then
			local style = HAZARD_STYLE[theme.HazardKind]
			self:_teeth(x1 + 4, x1 + 4 + length, y + 4.4, 0.8, style.Color, style.Material, true)
		end
	else
		self:Deco(
			Vector3.new(length, 0.2, 0.2),
			CFrame.new(self:W(x1 + 4 + length / 2, y + 3.7, DEPTH / 2 + 0.1)),
			theme.Accent2 or theme.Accent,
			NEON,
			{ Name = "TunnelGlow" }
		)
	end
	table.insert(self.Ceilings, { X1 = x1 + 4, X2 = x1 + 4 + length, Y = y + 3.6 })
	table.insert(self.Solids, { X1 = x1 + 4, X2 = x1 + 4 + length, Y1 = ceilingBottom, Y2 = y + 15.6 })
	self:_tunnelDecor(x1 + 4, x1 + 4 + length, y, ceilingBottom, y + 15.6, opts.Lethal == true)
end

--- Optik der Tunneldecke: Portalrahmen, Warnstreifen, Lippe, Innenlicht.
function MapBuilder:_tunnelDecor(x1: number, x2: number, floorY: number, bottomY: number, topY: number, lethal: boolean)
	local theme = self.Theme
	local trim, trimMat = self:_t("Trim"), self:_t("TrimMaterial")
	local len = x2 - x1
	local cx = (x1 + x2) / 2
	for _, ex in { x1 + 0.5, x2 - 0.5 } do
		self:Deco(Vector3.new(1, topY - bottomY, 0.3), CFrame.new(self:W(ex, (topY + bottomY) / 2, FACE_Z + 0.15)), trim, trimMat, { Name = "TunnelFrame" })
	end
	self:Deco(Vector3.new(len + 0.3, 0.5, 0.7), CFrame.new(self:W(cx, topY - 0.2, FACE_Z)), trim, trimMat, { Name = "Lip" })
	-- Warnstreifen (gelb/schwarz) knapp über der Deckenunterkante
	local sy = bottomY + (if lethal then 0.55 else 0.75)
	if len > 3 then
		self:Deco(Vector3.new(len - 2, 0.8, 0.1), CFrame.new(self:W(cx, sy, FACE_Z + 0.05)), STRIPE_YELLOW, M.SmoothPlastic, { Name = "TunnelStripe" })
		local sx = x1 + 1.7
		while sx < x2 - 1.7 do
			self:Deco(Vector3.new(1.4, 0.8, 0.12), CFrame.new(self:W(sx, sy, FACE_Z + 0.07)), BLACK, M.SmoothPlastic, { Name = "TunnelStripe" })
			sx += 2.8
		end
	end
	-- Lichtleiste an der hinteren Deckenkante
	local lightColor = if lethal then theme.Hazard or theme.Accent else theme.Accent2 or theme.Accent
	self:Deco(Vector3.new(len, 0.18, 0.3), CFrame.new(self:W(cx, floorY + 3.45, -4.7)), lightColor, NEON, { Name = "TunnelLight" })
end

--- Schacht für Wall-Jumps. Rechts wartet die höhere Ebene.
function MapBuilder:WallClimb(height: number, width: number?, opts)
	opts = opts or {}
	local theme = self.Theme
	local shaft = width or 14
	local x0, y0 = self.X, self.Y
	local wallX = x0 + 4 + shaft
	local wallMat = self:_wallMaterial()
	self:Ground(x0, wallX, y0)
	-- Hängende linke Wand (unten offen, damit man hineinläuft)
	self:Box(x0 + 2, y0 + 7, x0 + 4, y0 + height + 12, { Name = "ClimbWall", Color = theme.Wall, Material = wallMat })
	-- Rechte Wand = Block bis zur oberen Ebene
	self:Box(wallX, y0 - self.Thickness, wallX + 8, y0 + height - 1, { Name = "ClimbBlock", Color = theme.Wall, Material = wallMat })
	self:Ground(wallX, wallX + 8, y0 + height, { Thickness = 1 })
	if opts.Anchor ~= false then
		self:Anchor(x0 + 4 + shaft * 0.5, y0 + height + 12)
	end
	self.X = wallX + 8
	self.Y = y0 + height
	self:_node(wallX + 4, self.Y)

	-- Optik
	table.insert(self.Ceilings, { X1 = x0 + 2, X2 = x0 + 4, Y = y0 + 7 })
	table.insert(self.Solids, { X1 = x0 + 2, X2 = x0 + 4, Y1 = y0 + 7, Y2 = y0 + height + 12 })
	table.insert(self.Solids, { X1 = wallX, X2 = wallX + 8, Y1 = y0 - self.Thickness, Y2 = y0 + height - 1 })
	self:_wallFace(x0 + 2, x0 + 4, y0 + 7, y0 + height + 12)
	self:_wallFace(wallX, wallX + 8, y0 - self.Thickness, y0 + height - 1, { NoCenter = true })
	local arrow = theme.Accent2 or theme.Accent
	for i = 1, 3 do
		self:_chevron(wallX + 4, y0 + height * i / 4, FACE_Z + 0.1, 2, arrow, "Up", "ClimbArrow", 0.4 - i * 0.12)
	end
end

--- Sprungpad, das auf eine höhere Ebene katapultiert.
function MapBuilder:JumpPadUp(height: number, landing: number?)
	local x0, y0 = self.X, self.Y
	local wallX = x0 + 18
	self:Ground(x0, wallX, y0)
	self:JumpPad(x0 + 5, y0, math.sqrt(2 * GRAVITY * (height + 7)))
	self.Y = y0 + height
	local len = landing or 30
	self:Ground(wallX, wallX + len, self.Y, { Thickness = height + self.Thickness })
	self:_node(wallX + len / 2, self.Y)
	self.X = wallX + len
end

--- Breite Lücke, die nur mit dem Greifhaken überwindbar ist.
--- opts: Anchors (Anzahl), AnchorHeight, Rise, Landing
function MapBuilder:GrappleGap(width: number, opts)
	opts = opts or {}
	local x0, y0 = self.X, self.Y
	local count = opts.Anchors or math.max(1, math.floor(width / 45 + 0.5))
	local anchorHeight = opts.AnchorHeight or 24
	for i = 1, count do
		self:Anchor(x0 + width * i / (count + 1), y0 + anchorHeight)
	end
	local rise = opts.Rise or 0
	self:_pitHazard(x0, x0 + width, y0 + math.min(0, rise))
	self.X = x0 + width
	self.Y = y0 + rise
	self:Flat(opts.Landing or 30)
end

--- Gefahrengrube, optional mit Säulen zum Hüpfen. opts: Pillars, PillarRise, Landing
function MapBuilder:Pit(width: number, opts)
	opts = opts or {}
	local x0, y0 = self.X, self.Y
	local pillars = opts.Pillars or 0
	self:_pitHazard(x0, x0 + width, y0)
	if pillars > 0 then
		local spacing = width / (pillars + 1)
		for i = 1, pillars do
			local cx = x0 + spacing * i
			local py = y0 + (if i % 2 == 0 then (opts.PillarRise or 0) else 0)
			local thickness = if self.NoPitHazard then self.Thickness else 24 + (py - y0)
			self:Ground(cx - 2.5, cx + 2.5, py, { Thickness = thickness })
		end
	end
	self.X = x0 + width
	self:Flat(opts.Landing or 30)
end

--- Zeitgesteuerte Gefahrenwand in der Mitte eines Bodenstücks.
function MapBuilder:TimedBarrier(length: number, opts)
	opts = opts or {}
	local theme = self.Theme
	local x0 = self.X
	self:Flat(length)
	local bx = x0 + length / 2
	self:Hazard(bx - 0.8, self.Y, bx + 0.8, self.Y + 16, theme.HazardKind, {
		Period = opts.Period or 2.4,
		OnTime = opts.OnTime or 1.1,
		Offset = opts.Offset or 0,
	})
	self:_barrierDecor(bx, self.Y, theme.HazardKind)
end

--- Optik der Barriere: Emitter-Gehäuse oben und unten, Pylon hinter der Spur.
function MapBuilder:_barrierDecor(bx: number, y: number, kind: string)
	local theme = self.Theme
	local style = HAZARD_STYLE[kind]
	local color = if style then style.Color else theme.Hazard or theme.Accent
	local housing = rgb(44, 46, 58)
	self:Reserve(bx - 4, bx + 4)
	self:Deco(Vector3.new(3, 1.6, DEPTH), CFrame.new(self:W(bx, y + 16.8, 0)), housing, M.Metal, { Name = "BarrierEmitter" })
	self:Deco(Vector3.new(1.9, 0.22, DEPTH - 0.6), CFrame.new(self:W(bx, y + 15.95, 0)), color, NEON, { Name = "BarrierLens" })
	self:Deco(Vector3.new(3.02, 0.35, 0.1), CFrame.new(self:W(bx, y + 17.25, FACE_Z + 0.05)), STRIPE_YELLOW, M.SmoothPlastic, { Name = "BarrierStripe" })
	self:Deco(Vector3.new(3, 0.24, DEPTH), CFrame.new(self:W(bx, y + 0.12, 0)), housing, M.Metal, { Name = "BarrierBase" })
	self:Deco(Vector3.new(1.9, 0.08, DEPTH - 0.6), CFrame.new(self:W(bx, y + 0.27, 0)), color, NEON, { Name = "BarrierLens" })
	self:Deco(Vector3.new(1.1, 17.6, 1.1), CFrame.new(self:W(bx, y + 8.8, -5.7)), housing, M.Metal, { Name = "BarrierPylon" })
	self:Deco(Vector3.new(0.25, 15, 0.12), CFrame.new(self:W(bx, y + 8.4, -5.12)), color, NEON, { Name = "BarrierPylonGlow", Transparency = 0.2 })
	if kind == "Flame" then
		for _, nz in { -3, 0, 3 } do
			self:Deco(Vector3.new(0.7, 0.7, 0.7), CFrame.new(self:W(bx, y + 15.7, nz)) * VERTICAL, rgb(70, 64, 60), M.Metal, { Name = "FlameNozzle", Shape = CYL })
		end
	elseif kind == "Arcane" then
		self:Deco(Vector3.new(1.2, 1.2, 1.2), CFrame.new(self:W(bx, y + 18.4, 0)) * CFrame.Angles(0, 0, math.rad(45)), color, NEON, { Name = "RuneCrystal" })
	elseif kind == "Icicle" then
		self:Deco(Vector3.new(3.4, 0.5, DEPTH + 0.2), CFrame.new(self:W(bx, y + 17.85, 0)), rgb(244, 250, 255), M.Snow, { Name = "SnowCap" })
	elseif kind == "Thorns" then
		for i = 1, 3 do
			self:Deco(Vector3.new(0.5, 1.5, 1.5), CFrame.new(self:W(bx, y + 3 + i * 4, -5.7)) * VERTICAL, rgb(60, 120, 50), M.Grass, { Name = "Vine", Shape = CYL })
		end
	end
end

--- Boden mit Boost-Pad.
function MapBuilder:BoostStrip(length: number, power: number?)
	local x0 = self.X
	self:Flat(length)
	self:BoostPad(x0 + length * 0.2, x0 + length * 0.7, self.Y, power or 80)
end

--- Eisfläche (wenig Reibung, Momentum bleibt erhalten).
function MapBuilder:IceRun(length: number)
	self:Flat(length, { Ice = true })
end

--- Bodenstück mit Item-Boxen.
function MapBuilder:PickupRow(count: number?, length: number?)
	local len = length or 24
	local n = count or 3
	local x0 = self.X
	self:Flat(len)
	for i = 1, n do
		self:PickupSpot(x0 + len * i / (n + 1), self.Y)
	end
end

--- Zwei Routen: oben (schneller, Skill) und unten (sicherer, länger).
--- opts: Length, Depth, Upper = function(builder), Lower = function(builder)
--- Wer oben scheitert, fällt in die untere Route (kein Tod). Am Ende bringt ein
--- Sprungpad die untere Route wieder nach oben.
function MapBuilder:Split(opts)
	local x0, y0 = self.X, self.Y
	local depth = opts.Depth or 28
	local length = opts.Length or 240
	local wasAuto = self.AutoCheckpoints
	self.AutoCheckpoints = false

	-- Untere Route
	self.X = x0
	self.Y = y0 - depth
	self:Ground(x0 - 12, x0, self.Y)
	if opts.Lower then
		opts.Lower(self)
	end
	local lowerEndX, lowerY = self.X, self.Y

	-- Obere Route (dünne Plattformen, keine Grubengefahren)
	local oldThickness, oldNoPit = self.Thickness, self.NoPitHazard
	self.X = x0
	self.Y = y0
	self.Thickness = 3
	self.NoPitHazard = true
	if opts.Upper then
		opts.Upper(self)
	end
	local upperEndX, upperY = self.X, self.Y

	local mergeX = math.max(lowerEndX + 16, upperEndX + 18, x0 + length)
	if upperEndX < mergeX - 18 then
		self:Ground(upperEndX, mergeX - 18, upperY)
	end
	self.Thickness = oldThickness
	self.NoPitHazard = oldNoPit

	-- Untere Route bis zum Sprungpad verlängern
	if lowerEndX < mergeX then
		self:Ground(lowerEndX, mergeX, lowerY)
	end
	local climb = y0 - lowerY
	self:JumpPad(mergeX - 10, lowerY, math.sqrt(2 * GRAVITY * (climb + 9)))

	-- Zusammenführung
	self:Ground(mergeX, mergeX + 40, y0, { Thickness = climb + self.Thickness })
	self.X = mergeX + 40
	self.Y = y0
	self.AutoCheckpoints = wasAuto
	self:Checkpoint(mergeX + 8, y0)
	self:_node(mergeX + 20, y0)
end

--- Ziellinie mit Auslaufzone, Zielbogen, Siegerpodest und Endwand.
function MapBuilder:Finish(length: number?)
	local len = length or 70
	local theme = self.Theme
	local x0 = self.X
	local y = self.Y
	self:Ground(x0, x0 + len, y)
	local fx = x0 + 14
	self.FinishLocalX = fx
	self:Deco(Vector3.new(0.8, 0.14, DEPTH), CFrame.new(self:W(fx, y + 0.08, 0)), rgb(255, 255, 255), NEON, { Name = "FinishLine" })
	self:Box(x0 + len, y - self.Thickness, x0 + len + 8, y + 70, { Name = "EndWall", Color = theme.Wall, Material = self:_wallMaterial() })
	table.insert(self.Solids, { X1 = x0 + len, X2 = x0 + len + 8, Y1 = y - self.Thickness, Y2 = y + 70 })
	self.X = x0 + len

	-- Optik: Zielbogen mit Schachbrett, Schachbrett auf der Bodenkante, Konfetti, Podest
	local gold = rgb(255, 220, 80)
	self:Reserve(fx - 12, fx + 12)
	self:Arch(fx, y, 18, 18, gold, { Label = "ZIEL", Checker = true })
	for row = 0, 1 do
		for col = -3, 2 do
			local white = (row + col) % 2 == 0
			self:Deco(Vector3.new(0.7, 0.7, 0.1), CFrame.new(self:W(fx + col * 0.7 + 0.35, y - 1.25 - row * 0.7, FACE_Z + 0.12)), if white then WHITE else BLACK, M.SmoothPlastic, { Name = "FinishChecker" })
		end
	end
	local confetti = self:Deco(Vector3.new(18, 1, 1.5), CFrame.new(self:W(fx, y + 21, -6.4)), WHITE, nil, { Name = "Confetti", Transparency = 1 })
	emitter(confetti, {
		Rate = 10,
		Lifetime = NumberRange.new(3, 5),
		Speed = NumberRange.new(2, 5),
		EmissionDirection = Enum.NormalId.Bottom,
		Size = NumberSequence.new(0.35),
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, rgb(255, 80, 80)),
			ColorSequenceKeypoint.new(0.25, rgb(255, 220, 60)),
			ColorSequenceKeypoint.new(0.5, rgb(80, 230, 120)),
			ColorSequenceKeypoint.new(0.75, rgb(60, 200, 255)),
			ColorSequenceKeypoint.new(1, rgb(240, 90, 255)),
		}),
		LightEmission = 0.4,
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-180, 180),
		Acceleration = Vector3.new(0, -4, 0),
		SpreadAngle = Vector2.new(35, 35),
	})
	-- Siegerpodest im Auslauf
	local px = x0 + len - 18
	self:Reserve(px - 6, px + 6)
	for _, step in { { -3, 1.6, rgb(200, 206, 220), "2" }, { 0, 2.6, gold, "1" }, { 3, 1.0, rgb(214, 140, 80), "3" } } do
		local block = self:Deco(Vector3.new(3, step[2], 2.6), CFrame.new(self:W(px + step[1], y + step[2] / 2, -3.6)), step[3], M.Metal, { Name = "Podium" })
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Back
		gui.LightInfluence = 0
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = rgb(30, 30, 40)
		label.Text = step[4]
		label.Parent = gui
		gui.Parent = block
	end
	self:_wallFace(x0 + len, x0 + len + 8, y - self.Thickness, y + 70)
	self:Banner(x0 + len - 4, y, theme.Accent, { Height = 12, Width = 3.4, Color2 = theme.Accent2 })
end

------------------------------------------------------------------------
-- Öffentliche Deko-Bausteine
------------------------------------------------------------------------

--- Laterne im Stil des Themes (Straßenlampe, Arbeitslampe, Feuerschale, Laterne, Fackel).
function MapBuilder:Lamp(x: number, y: number, z: number?, color: Color3?)
	local decor = self.Theme.Decor
	local style = "Street"
	if decor == "Industrial" then
		style = "Work"
	elseif decor == "Sky" then
		style = "Brazier"
	elseif decor == "Glacier" then
		style = "Lantern"
	elseif decor == "Jungle" then
		style = "Torch"
	end
	return self:_lamp(style, x, y, z or -4.4, color)
end

function MapBuilder:_lamp(style: string, x: number, y: number, z: number, color: Color3?)
	local theme = self.Theme
	local list = {}
	local warm = rgb(255, 214, 150)
	if style == "Work" then
		local glow = color or theme.Accent
		piece(self, list, Vector3.new(8, 0.4, 0.4), CFrame.new(self:W(x, y + 4, z)) * VERTICAL, rgb(74, 70, 66), M.Metal, { Name = "LampPole", Shape = CYL })
		piece(self, list, Vector3.new(0.9, 1.1, 0.9), CFrame.new(self:W(x, y + 8.4, z)), glow, NEON, { Name = "LampHead", Light = { Range = 16, Brightness = 1.4, Color = glow } })
		piece(self, list, Vector3.new(1.4, 0.3, 1.4), CFrame.new(self:W(x, y + 9.1, z)), rgb(50, 46, 44), M.Metal, { Name = "LampCap" })
	elseif style == "Brazier" then
		local glow = color or rgb(255, 170, 60)
		piece(self, list, Vector3.new(3.2, 1.3, 1.3), CFrame.new(self:W(x, y + 1.6, z)) * VERTICAL, self:_t("Trim"), M.Marble, { Name = "BrazierStand", Shape = CYL })
		piece(self, list, Vector3.new(0.6, 2.2, 2.2), CFrame.new(self:W(x, y + 3.5, z)) * VERTICAL, rgb(150, 120, 90), M.Sandstone, { Name = "BrazierBowl", Shape = CYL })
		local flame = piece(self, list, Vector3.new(1.1, 1.1, 1.1), CFrame.new(self:W(x, y + 4.2, z)), glow, NEON, { Name = "Flame", Shape = BALL, Light = { Range = 14, Brightness = 1.3, Color = glow } })
		fireEmitter(flame, glow, 0.8)
	elseif style == "Lantern" then
		local glow = color or warm
		piece(self, list, Vector3.new(6.5, 0.3, 0.3), CFrame.new(self:W(x, y + 3.25, z)) * VERTICAL, rgb(70, 52, 42), M.Wood, { Name = "LampPole", Shape = CYL })
		piece(self, list, Vector3.new(0.25, 0.25, 1.4), CFrame.new(self:W(x, y + 6.3, z + 0.6)), rgb(70, 52, 42), M.Wood, { Name = "LampArm" })
		piece(self, list, Vector3.new(0.8, 1.1, 0.8), CFrame.new(self:W(x, y + 5.5, z + 1.2)), glow, NEON, { Name = "Lantern", Light = { Range = 13, Brightness = 1.3, Color = glow } })
		piece(self, list, Vector3.new(1.1, 0.25, 1.1), CFrame.new(self:W(x, y + 6.15, z + 1.2)), rgb(40, 40, 48), M.Metal, { Name = "LanternRoof" })
	elseif style == "Torch" then
		local glow = color or rgb(255, 150, 50)
		piece(self, list, Vector3.new(5.6, 0.4, 0.4), CFrame.new(self:W(x, y + 2.8, z)) * VERTICAL, rgb(184, 150, 92), M.Wood, { Name = "TorchPole", Shape = CYL })
		piece(self, list, Vector3.new(0.6, 1.1, 1.1), CFrame.new(self:W(x, y + 5.7, z)) * VERTICAL, rgb(70, 50, 36), M.Wood, { Name = "TorchBowl", Shape = CYL })
		local flame = piece(self, list, Vector3.new(0.85, 0.85, 0.85), CFrame.new(self:W(x, y + 6.3, z)), glow, NEON, { Name = "Flame", Shape = BALL, Light = { Range = 13, Brightness = 1.3, Color = glow } })
		fireEmitter(flame, glow, 0.7)
	else
		-- Moderne Straßenlampe mit Ausleger Richtung Spur (bleibt hinter der Spielebene)
		local glow = color or (if theme.Decor == "City" then theme.Accent else warm)
		local poleColor = if theme.Decor == "Academy" then rgb(236, 238, 244) else rgb(60, 64, 82)
		piece(self, list, Vector3.new(0.6, 1, 1), CFrame.new(self:W(x, y + 0.3, z)) * VERTICAL, poleColor, M.Metal, { Name = "LampBase", Shape = CYL })
		piece(self, list, Vector3.new(10.5, 0.45, 0.45), CFrame.new(self:W(x, y + 5.25, z)) * VERTICAL, poleColor, M.Metal, { Name = "LampPole", Shape = CYL })
		piece(self, list, Vector3.new(0.3, 0.3, 2.6), CFrame.new(self:W(x, y + 10.35, z + 1.2)), poleColor, M.Metal, { Name = "LampArm" })
		piece(self, list, Vector3.new(1.5, 0.45, 1), CFrame.new(self:W(x, y + 10.3, z + 2.4)), rgb(36, 38, 48), M.Metal, { Name = "LampHead" })
		piece(self, list, Vector3.new(1.3, 0.12, 0.8), CFrame.new(self:W(x, y + 10.02, z + 2.4)), glow, NEON, { Name = "LampGlow", Light = { Range = 16, Brightness = 1.5, Color = glow } })
	end
	return list
end

--- Stütze von yTop bis yBottom. opts: Z, Width, Color, Material,
--- Style ("Girder" | "Pillar" | "Column" | "Ice" | "Stilt"; Standard: Theme.SupportStyle)
function MapBuilder:Pillar(x: number, yTop: number, yBottom: number, opts)
	opts = opts or {}
	local theme = self.Theme
	local style = opts.Style or self:_t("SupportStyle")
	local z = opts.Z or -2.4
	local color = opts.Color or self:_t("Support")
	local material = opts.Material or self:_t("SupportMaterial")
	local trim, trimMat = self:_t("Trim"), self:_t("TrimMaterial")
	local list = {}
	local h = yTop - yBottom
	if h <= 0.2 then
		return list
	end
	local cy = (yTop + yBottom) / 2
	if style == "Stilt" then
		local w = opts.Width or 1.5
		piece(self, list, Vector3.new(h, w, w), CFrame.new(self:W(x, cy, z)) * VERTICAL, color, material, { Name = "Stilt", Shape = CYL })
		if h > 3 then
			piece(self, list, Vector3.new(0.5, w + 0.25, w + 0.25), CFrame.new(self:W(x, yTop - 1.2, z)) * VERTICAL, rgb(196, 160, 100), M.Fabric, { Name = "StiltRope", Shape = CYL })
		end
	elseif style == "Column" then
		local w = opts.Width or 1.8
		piece(self, list, Vector3.new(h, w, w), CFrame.new(self:W(x, cy, z)) * VERTICAL, color, material, { Name = "Column", Shape = CYL })
		piece(self, list, Vector3.new(w + 0.8, 0.6, w + 0.8), CFrame.new(self:W(x, yTop - 0.3, z)), trim, trimMat, { Name = "Capital" })
		piece(self, list, Vector3.new(w + 0.8, 0.6, w + 0.8), CFrame.new(self:W(x, yBottom + 0.3, z)), trim, trimMat, { Name = "Plinth" })
	elseif style == "Girder" then
		local w = opts.Width or 1.3
		piece(self, list, Vector3.new(w, h, w), CFrame.new(self:W(x, cy, z)), color, material, { Name = "Girder" })
		piece(self, list, Vector3.new(w + 1.1, 0.4, w + 1.1), CFrame.new(self:W(x, yTop - 0.2, z)), trim, trimMat, { Name = "GirderCap" })
		if theme.EdgeGlow then
			local glowLen = math.min(h - 1, 10)
			if glowLen > 0.5 then
				piece(self, list, Vector3.new(0.14, glowLen, 0.06), CFrame.new(self:W(x, yTop - 0.6 - glowLen / 2, z + w / 2 + 0.03)), theme.Accent, NEON, { Name = "GirderGlow" })
			end
		end
	elseif style == "Ice" then
		local w = opts.Width or 2.2
		piece(self, list, Vector3.new(w, h, w), CFrame.new(self:W(x, cy, z)), color, material, { Name = "RockPillar" })
		if h > 2.5 then
			piece(self, list, Vector3.new(w + 0.5, 1.2, w + 0.5), CFrame.new(self:W(x, yTop - 1.4, z)), ICICLE, M.Ice, { Name = "IceCollar", Transparency = 0.15 })
		end
	else
		local w = opts.Width or 1.8
		piece(self, list, Vector3.new(w, h, w), CFrame.new(self:W(x, cy, z)), color, material, { Name = "Pillar" })
		piece(self, list, Vector3.new(w + 1, 0.5, w + 1), CFrame.new(self:W(x, yTop - 0.25, z)), trim, trimMat, { Name = "PillarCap" })
		if h > 4 then
			piece(self, list, Vector3.new(w + 0.12, 0.8, w + 0.12), CFrame.new(self:W(x, yTop - 2.2, z)), theme.Accent2 or STRIPE_YELLOW, M.SmoothPlastic, { Name = "PillarBand" })
		end
	end
	return list
end

--- Torbogen hinter der Spur (Läufer laufen davor hindurch).
--- opts: Label (Schriftzug), Checker (Schachbrett-Balken), Z, Depth, FrameColor, Material, LabelWidth
function MapBuilder:Arch(x: number, y: number, width: number, height: number, color: Color3?, opts)
	opts = opts or {}
	local accent = color or self.Theme.Accent
	local z = opts.Z or -6.4
	local depth = opts.Depth or 1.8
	local frame = opts.FrameColor or rgb(46, 50, 66)
	local frameMat = opts.Material or M.Metal
	local list = {}
	local half = width / 2
	for _, side in { -1, 1 } do
		local px = x + side * half
		piece(self, list, Vector3.new(1.8, height, depth), CFrame.new(self:W(px, y + height / 2, z)), frame, frameMat, { Name = "ArchPost" })
		piece(self, list, Vector3.new(0.35, height - 1.2, 0.12), CFrame.new(self:W(px - side * 0.55, y + height / 2, z + depth / 2 + 0.05)), accent, NEON, { Name = "ArchGlow" })
		piece(self, list, Vector3.new(2.8, 0.6, depth + 0.8), CFrame.new(self:W(px, y + 0.3, z)), frame, frameMat, { Name = "ArchFoot" })
	end
	local beamY = y + height + 1.2
	piece(self, list, Vector3.new(width + 1.8, 2.4, depth), CFrame.new(self:W(x, beamY, z)), frame, frameMat, {
		Name = "ArchBeam",
		Light = { Range = 20, Brightness = 1.5, Color = accent },
	})
	if opts.Checker then
		local cell = 1.2
		local cols = math.floor((width + 1.4) / cell)
		local startX = x - cols * cell / 2 + cell / 2
		for row = 0, 1 do
			for col = 0, cols - 1 do
				local white = (row + col) % 2 == 0
				piece(self, list, Vector3.new(cell, 1.05, 0.12), CFrame.new(self:W(startX + col * cell, beamY + 0.55 - row * 1.1, z + depth / 2 + 0.06)), if white then WHITE else BLACK, M.SmoothPlastic, { Name = "ArchChecker" })
			end
		end
	else
		piece(self, list, Vector3.new(width + 1, 0.3, 0.12), CFrame.new(self:W(x, beamY - 0.8, z + depth / 2 + 0.06)), accent, NEON, { Name = "ArchGlow" })
	end
	if opts.Label then
		self:Sign(x, beamY + 4.4, opts.Label, nil, { Width = opts.LabelWidth or 14, Height = 4.4, Color = accent, Style = "Banner", Z = z })
	end
	return list
end

--- Fahne an einem Mast (Tuch hängt rechts am Querbalken).
--- opts: Height, Width, Z, Color2 (Zierstreifen), PoleColor
function MapBuilder:Banner(x: number, y: number, color: Color3?, opts)
	opts = opts or {}
	local theme = self.Theme
	local cloth = color or theme.Accent
	local h = opts.Height or 9
	local w = opts.Width or 2.6
	local z = opts.Z or -4.4
	local decor = theme.Decor
	local poleColor = opts.PoleColor or (if decor == "Jungle" or decor == "Sky" then rgb(120, 92, 62) else rgb(70, 72, 86))
	local list = {}
	piece(self, list, Vector3.new(h, 0.3, 0.3), CFrame.new(self:W(x, y + h / 2, z)) * VERTICAL, poleColor, M.Metal, { Name = "BannerPole", Shape = CYL })
	piece(self, list, Vector3.new(0.55, 0.55, 0.55), CFrame.new(self:W(x, y + h + 0.2, z)), rgb(255, 206, 90), M.Metal, { Name = "BannerFinial", Shape = BALL })
	piece(self, list, Vector3.new(w + 0.5, 0.2, 0.2), CFrame.new(self:W(x + w / 2, y + h - 0.35, z)), poleColor, M.Metal, { Name = "BannerBar" })
	local clothH = h * 0.5
	local clothY = y + h - 0.45 - clothH / 2
	piece(self, list, Vector3.new(w, clothH, 0.12), CFrame.new(self:W(x + w / 2 + 0.15, clothY, z)), cloth, M.Fabric, { Name = "BannerCloth" })
	piece(self, list, Vector3.new(w, clothH * 0.14, 0.14), CFrame.new(self:W(x + w / 2 + 0.15, clothY - clothH * 0.22, z)), opts.Color2 or WHITE, M.Fabric, { Name = "BannerStripe" })
	return list
end

--- Baum. opts: Kind ("Round" | "Pine" | "Palm" | "Jungle"), Scale, Height (Stammhöhe), Leaf (Farbe)
function MapBuilder:Tree(x: number, y: number, z: number?, opts)
	opts = opts or {}
	local decor = self.Theme.Decor
	local kind = opts.Kind
	if not kind then
		kind = if decor == "Glacier" then "Pine" elseif decor == "Jungle" then "Jungle" else "Round"
	end
	local s = opts.Scale or 1
	local leaf = opts.Leaf or self:_t("Leaf")
	local rng = self.Rng
	local tz = z or BACK_Z
	local list = {}
	local bark = rgb(104, 74, 50)
	if kind == "Pine" then
		piece(self, list, Vector3.new(1.8 * s, 0.7 * s, 0.7 * s), CFrame.new(self:W(x, y + 0.9 * s, tz)) * VERTICAL, bark, M.Wood, { Name = "Trunk", Shape = CYL })
		local widths = { 5.2, 4, 2.8 }
		local heights = { 3.2, 3, 2.8 }
		for i = 1, 3 do
			local w, h = widths[i] * s, heights[i] * s
			local color = if decor == "Glacier" and i == 3 then leaf:Lerp(WHITE, 0.55) else jitter(rng, leaf, 0.08)
			self:_triangle(x, y + (1.3 + (i - 1) * 2.1) * s, w, h, w * 0.85, tz, color, M.Grass, false, "PineTier", list)
		end
	elseif kind == "Jungle" then
		local trunkH = opts.Height or 10 * s
		local d = 1.1 * s
		piece(self, list, Vector3.new(trunkH, d, d), CFrame.new(self:W(x, y + trunkH / 2, tz)) * VERTICAL, rgb(96, 70, 48), M.Wood, { Name = "Trunk", Shape = CYL })
		local top = y + trunkH
		piece(self, list, Vector3.new(7 * s, 3.4 * s, 6 * s), CFrame.new(self:W(x, top + 0.8 * s, tz)), jitter(rng, leaf, 0.12), M.Grass, { Name = "Crown", Mesh = SPHERE })
		piece(self, list, Vector3.new(5 * s, 2.6 * s, 4.5 * s), CFrame.new(self:W(x + 2.6 * s, top - 1.2 * s, tz + 0.4 * s)), jitter(rng, leaf, 0.14), M.Grass, { Name = "Crown", Mesh = SPHERE })
		if rng:NextNumber() < 0.6 then
			piece(self, list, Vector3.new(4.4 * s, 2.2 * s, 4 * s), CFrame.new(self:W(x - 2.4 * s, top - 0.4 * s, tz - 0.4 * s)), jitter(rng, leaf, 0.14), M.Grass, { Name = "Crown", Mesh = SPHERE })
		end
		if rng:NextNumber() < 0.6 then
			local vl = rng:NextNumber(3, 7) * s
			piece(self, list, Vector3.new(vl, 0.18 * s, 0.18 * s), CFrame.new(self:W(x + 1.8 * s, top - 1.4 * s - vl / 2, tz + 1.2 * s)) * VERTICAL, shade(leaf, 0.75), M.Grass, { Name = "Vine", Shape = CYL })
		end
	elseif kind == "Palm" then
		local segH = 3 * s
		local px, py = x, y
		for i = 1, 3 do
			local tilt = math.rad(7 * i)
			piece(self, list, Vector3.new(segH + 0.2 * s, 0.8 * s, 0.8 * s), CFrame.new(self:W(px + math.sin(tilt) * segH / 2, py + math.cos(tilt) * segH / 2, tz)) * CFrame.Angles(0, 0, math.rad(90) - tilt), rgb(150, 120, 80), M.Wood, { Name = "PalmTrunk", Shape = CYL })
			px += math.sin(tilt) * segH
			py += math.cos(tilt) * segH
		end
		for _, angle in { 205, 145, 90, 35, -25 } do
			local leafLen = 4.2 * s
			piece(self, list, Vector3.new(leafLen, 0.2 * s, 1.1 * s), CFrame.new(self:W(px, py, tz)) * CFrame.Angles(0, 0, math.rad(angle)) * CFrame.new(leafLen / 2, 0, 0), jitter(rng, leaf, 0.1), M.Grass, { Name = "PalmLeaf" })
		end
	else
		piece(self, list, Vector3.new(4 * s, 0.75 * s, 0.75 * s), CFrame.new(self:W(x, y + 2 * s, tz)) * VERTICAL, bark, M.Wood, { Name = "Trunk", Shape = CYL })
		local main = 4.6 * s
		piece(self, list, Vector3.new(main, main, main), CFrame.new(self:W(x, y + 5.4 * s, tz)), jitter(rng, leaf, 0.1), M.Grass, { Name = "Crown", Shape = BALL })
		for _, side in { -1, 1 } do
			local d = 3.4 * s
			piece(self, list, Vector3.new(d, d, d), CFrame.new(self:W(x + side * 1.7 * s, y + 4.5 * s, tz + 0.2 * side * s)), jitter(rng, leaf, 0.12), M.Grass, { Name = "Crown", Shape = BALL })
		end
	end
	return list
end

--- Wolke aus Kugeln mit flacher Unterseite. opts: Color, Transparency, Puffs
function MapBuilder:Cloud(x: number, y: number, z: number, scale: number?, opts)
	opts = opts or {}
	local s = scale or 1
	local rng = self.Rng
	local color = opts.Color or WHITE
	local transparency = opts.Transparency or 0
	local puffs = opts.Puffs or 3
	local list = {}
	for i = 1, puffs do
		local d = s * rng:NextNumber(7, 11) * (if i == 1 or i == puffs then 0.8 else 1.15)
		local ox = (i - (puffs + 1) / 2) * s * 5.5
		piece(self, list, Vector3.new(d, d, d), CFrame.new(self:W(x + ox, y + d * 0.18, z)), color, M.SmoothPlastic, { Name = "Cloud", Shape = BALL, Transparency = transparency })
	end
	piece(self, list, Vector3.new(puffs * 5.5 * s + 6 * s, 4 * s, 8 * s), CFrame.new(self:W(x, y, z)), color, M.SmoothPlastic, { Name = "Cloud", Mesh = SPHERE, Transparency = transparency })
	return list
end

--- Hochhaus mit Fenstern und Dachaufbau. z = Mitte des Gebäudes in der Tiefe.
--- opts: Color, Material, Lights ({Color3}), WindowStyle (1 Bänder, 2 Streifen, 3 Einzelfenster), Roof (false = ohne)
function MapBuilder:Building(x: number, z: number, baseY: number, width: number, height: number, depth: number, opts)
	opts = opts or {}
	local theme, rng = self.Theme, self.Rng
	local back = theme.Backdrop or {}
	local color = opts.Color or back.Near or rgb(40, 40, 60)
	local lights = opts.Lights or back.Lights or { theme.Accent }
	local list = {}
	local topY = baseY + height
	local front = z + depth / 2
	piece(self, list, Vector3.new(width, height, depth), CFrame.new(self:W(x, baseY + height / 2, z)), color, opts.Material or M.Concrete, { Name = "Building" })
	local warm = lights[1]
	local style = opts.WindowStyle or rng:NextInteger(1, 3)
	if style == 1 then
		local bands = math.clamp(math.floor(height / 22), 1, 4)
		local wy = topY - 6
		for _ = 1, bands do
			if wy < baseY + 4 then
				break
			end
			local lit = if rng:NextNumber() < 0.75 then warm else lights[rng:NextInteger(1, #lights)]
			piece(self, list, Vector3.new(width * 0.84, 0.8, 0.2), CFrame.new(self:W(x, wy, front + 0.05)), lit, NEON, { Name = "Window", Transparency = 0.15 })
			wy -= rng:NextNumber(8, 14)
		end
	elseif style == 2 then
		local strips = math.clamp(math.floor(width / 9), 1, 3)
		local lit = lights[rng:NextInteger(1, #lights)]
		local stripH = math.min(height * 0.5, 60)
		for i = 1, strips do
			local sx = x - width / 2 + width * i / (strips + 1)
			piece(self, list, Vector3.new(0.7, stripH, 0.2), CFrame.new(self:W(sx, topY - 4 - stripH / 2, front + 0.05)), lit, NEON, { Name = "Window", Transparency = 0.2 })
		end
	else
		local maxDrop = math.max(4.5, math.min(height - 4, 50))
		for _ = 1, rng:NextInteger(3, 6) do
			local lit = if rng:NextNumber() < 0.7 then warm else lights[rng:NextInteger(1, #lights)]
			piece(self, list, Vector3.new(rng:NextNumber(1.6, 3), 1.2, 0.2), CFrame.new(self:W(x + rng:NextNumber(-width * 0.38, width * 0.38), topY - rng:NextNumber(4, maxDrop), front + 0.05)), lit, NEON, { Name = "Window", Transparency = 0.1 })
		end
	end
	piece(self, list, Vector3.new(width + 0.8, 0.8, depth + 0.8), CFrame.new(self:W(x, topY - 0.4, z)), shade(color, 1.18), M.Metal, { Name = "Roof" })
	if opts.Roof ~= false then
		local roll = rng:NextNumber()
		if roll < 0.35 then
			local h = rng:NextNumber(8, 16)
			local ax = x + rng:NextNumber(-width / 4, width / 4)
			piece(self, list, Vector3.new(h, 0.4, 0.4), CFrame.new(self:W(ax, topY + h / 2, z)) * VERTICAL, rgb(130, 134, 150), M.Metal, { Name = "Antenna", Shape = CYL })
			piece(self, list, Vector3.new(0.8, 0.8, 0.8), CFrame.new(self:W(ax, topY + h + 0.3, z)), rgb(255, 60, 60), NEON, { Name = "AntennaLight", Shape = BALL })
		elseif roll < 0.55 then
			local bw = width * 0.7
			local bh = width * 0.32
			local by = topY + bh / 2 + 1.2
			piece(self, list, Vector3.new(bw + 0.8, bh + 0.8, 0.6), CFrame.new(self:W(x, by, front - 1)), rgb(28, 28, 40), M.Metal, { Name = "RoofSign" })
			piece(self, list, Vector3.new(bw, bh, 0.2), CFrame.new(self:W(x, by, front - 0.62)), lights[rng:NextInteger(1, #lights)], NEON, { Name = "RoofSignGlow", Transparency = 0.25 })
		elseif roll < 0.7 then
			piece(self, list, Vector3.new(width * 0.4, 3, depth * 0.4), CFrame.new(self:W(x + rng:NextNumber(-width / 5, width / 5), topY + 1.5, z)), shade(color, 0.9), M.Metal, { Name = "RoofBox" })
		end
	end
	return list
end

--- Torbögen über geraden Abschnitten (mind. 24 Studs eben, genug Kopffreiheit),
--- gleichmäßig zwischen Start und Ziel verteilt. Vor Decorate() aufrufen, damit dort
--- keine Requisiten in den Pfosten stehen. opts wie bei Arch.
function MapBuilder:Gates(count: number, color: Color3?, opts)
	local startX = self.StartLocalX + 60
	local endX = (self.FinishLocalX or self.MaxX) - 60
	if endX <= startX then
		return
	end
	local accent = color or self.Theme.Accent2 or self.Theme.Accent
	for i = 1, count do
		local target = startX + (endX - startX) * (i - 0.5) / count
		for offset = 0, 120, 4 do
			local x = target + offset
			local y = self:FloorAt(x)
			if
				y
				and self:FloorAt(x - 12) == y
				and self:FloorAt(x + 12) == y
				and not self:_isReserved(x - 11, x + 11)
				and self:_clearanceAt(x, y) > 24
			then
				self:Arch(x, y, 20, 17, accent, opts)
				self:Reserve(x - 11, x + 11)
				break
			end
		end
	end
end

--- Wasserfall (Glas + Gischt) von yTop um `height` nach unten.
function MapBuilder:Waterfall(x: number, yTop: number, z: number, width: number, height: number)
	local list = {}
	piece(self, list, Vector3.new(width, height, 0.6), CFrame.new(self:W(x, yTop - height / 2, z)), rgb(180, 226, 255), M.Glass, { Name = "Waterfall", Transparency = 0.35 })
	piece(self, list, Vector3.new(width * 0.5, height, 0.7), CFrame.new(self:W(x, yTop - height / 2, z + 0.1)), WHITE, M.SmoothPlastic, { Name = "WaterfallFoam", Transparency = 0.55 })
	local mist = piece(self, list, Vector3.new(width, 1, 2), CFrame.new(self:W(x, yTop - height, z)), WHITE, nil, { Name = "WaterfallMist", Transparency = 1 })
	emitter(mist, {
		Rate = 5,
		Lifetime = NumberRange.new(2, 3),
		Speed = NumberRange.new(2, 4),
		EmissionDirection = Enum.NormalId.Top,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 8) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) }),
		Color = ColorSequence.new(WHITE),
		SpreadAngle = Vector2.new(60, 60),
	})
	return list
end

------------------------------------------------------------------------
-- Requisiten (Prop)
------------------------------------------------------------------------

local PROPS = {}

PROPS.Crate = function(B, x, y, z, opts)
	local rng, decor = B.Rng, B.Theme.Decor
	local list = {}
	local color, material, band = rgb(158, 112, 66), M.WoodPlanks, rgb(104, 72, 42)
	if decor == "City" or decor == "Hub" then
		color, material, band = (B.Theme.Accent2 or B.Theme.Accent):Lerp(rgb(40, 40, 60), 0.55), M.Metal, rgb(30, 32, 44)
	elseif decor == "Industrial" then
		color, material, band = rgb(118, 92, 70), M.CorrodedMetal, rgb(240, 180, 46)
	end
	color = opts.Color or color
	local s = (opts.Scale or 1) * rng:NextNumber(2.2, 2.9)
	z = math.max(z, -4.9 + s / 2)
	local base = CFrame.new(B:W(x, y + s / 2, z)) * CFrame.Angles(0, math.rad(rng:NextNumber(-12, 12)), 0)
	piece(B, list, Vector3.new(s, s, s), base, color, material, { Name = "Crate" })
	piece(B, list, Vector3.new(s + 0.08, 0.32, s + 0.08), base, band, M.Metal, { Name = "CrateBand" })
	if rng:NextNumber() < 0.35 then
		local s2 = s * 0.7
		local top = CFrame.new(B:W(x + rng:NextNumber(-0.4, 0.4), y + s + s2 / 2, z)) * CFrame.Angles(0, math.rad(rng:NextNumber(-25, 25)), 0)
		piece(B, list, Vector3.new(s2, s2, s2), top, shade(color, 1.12), material, { Name = "Crate" })
	end
	return list
end

PROPS.Barrel = function(B, x, y, z, opts)
	local rng = B.Rng
	local list = {}
	local palette = { rgb(200, 62, 40), rgb(236, 172, 40), rgb(60, 112, 176), rgb(70, 140, 80) }
	z = math.max(z, -3.8)
	for i = 1, if rng:NextNumber() < 0.35 then 2 else 1 do
		local bx = x + (i - 1) * 2.4
		local color = opts.Color or palette[rng:NextInteger(1, #palette)]
		piece(B, list, Vector3.new(3, 2.2, 2.2), CFrame.new(B:W(bx, y + 1.5, z)) * VERTICAL, color, M.Metal, { Name = "Barrel", Shape = CYL })
		piece(B, list, Vector3.new(0.3, 2.34, 2.34), CFrame.new(B:W(bx, y + 2.1, z)) * VERTICAL, shade(color, 0.6), M.Metal, { Name = "BarrelRing", Shape = CYL })
		if B.Theme.Decor == "Industrial" and rng:NextNumber() < 0.4 then
			piece(B, list, Vector3.new(0.1, 1.7, 1.7), CFrame.new(B:W(bx, y + 3.02, z)) * VERTICAL, B.Theme.Accent, NEON, { Name = "BarrelGlow", Shape = CYL })
		end
	end
	return list
end

PROPS.Lamp = function(B, x, y, z, opts)
	return B:Lamp(x, y, math.max(z, -4.6), opts.Color)
end

PROPS.Torch = function(B, x, y, z, opts)
	return B:_lamp("Torch", x, y, z, opts.Color)
end

PROPS.Bush = function(B, x, y, z, opts)
	local rng = B.Rng
	local list = {}
	local leaf = opts.Color or B:_t("Leaf")
	local r = rng:NextNumber(2.2, 3.1) * (opts.Scale or 1)
	z = math.max(z, -4.9 + r / 2)
	for i = 1, 3 do
		local d = r * (if i == 2 then 1 else rng:NextNumber(0.6, 0.8))
		piece(B, list, Vector3.new(d, d, d), CFrame.new(B:W(x + (i - 2) * r * 0.55, y + d * 0.32, z + rng:NextNumber(-0.3, 0.3))), jitter(rng, leaf, 0.12), M.Grass, { Name = "Bush", Shape = BALL })
	end
	local decor = B.Theme.Decor
	if (decor == "Sky" or decor == "Jungle" or decor == "Academy") and rng:NextNumber() < 0.45 then
		local bloom = if rng:NextNumber() < 0.5 then rgb(255, 120, 170) else rgb(255, 225, 90)
		for _, ox in { -0.5, 0.6 } do
			piece(B, list, Vector3.new(0.55, 0.55, 0.55), CFrame.new(B:W(x + ox * r, y + r * 0.75, z + r * 0.3)), bloom, M.SmoothPlastic, { Name = "Blossom", Shape = BALL })
		end
	end
	return list
end

PROPS.Rock = function(B, x, y, z, opts)
	local rng, decor = B.Rng, B.Theme.Decor
	local list = {}
	local material, color = M.Rock, rgb(124, 120, 112)
	if decor == "Glacier" then
		material, color = M.Slate, rgb(96, 112, 136)
	elseif decor == "Sky" then
		material, color = M.Limestone, rgb(206, 194, 166)
	elseif decor == "Industrial" then
		material, color = M.Basalt, rgb(72, 62, 60)
	elseif decor == "Jungle" then
		color = rgb(112, 114, 100)
	end
	color = opts.Color or color
	local s = opts.Scale or 1
	local w, h, d = rng:NextNumber(2.2, 3.4) * s, rng:NextNumber(1.4, 2.3) * s, rng:NextNumber(1.6, 2.4) * s
	z = math.max(z, -4.9 + d / 2)
	local cf = CFrame.new(B:W(x, y + h * 0.35, z)) * CFrame.Angles(math.rad(rng:NextNumber(-8, 8)), math.rad(rng:NextNumber(-30, 30)), math.rad(rng:NextNumber(-12, 12)))
	piece(B, list, Vector3.new(w, h, d), cf, color, material, { Name = "Rock" })
	piece(B, list, Vector3.new(w * 0.5, h * 0.55, d * 0.6), CFrame.new(B:W(x + w * 0.6, y + h * 0.2, z + 0.3)) * CFrame.Angles(0, math.rad(rng:NextNumber(0, 90)), math.rad(rng:NextNumber(-20, 20))), shade(color, 0.9), material, { Name = "Rock" })
	if decor == "Glacier" then
		piece(B, list, Vector3.new(w * 0.9, 0.35, d * 0.9), cf * CFrame.new(0, h / 2, 0), rgb(246, 250, 255), M.Snow, { Name = "SnowCap" })
	elseif decor == "Jungle" then
		piece(B, list, Vector3.new(w * 0.8, 0.3, d * 0.8), cf * CFrame.new(0, h / 2, 0), rgb(80, 150, 60), M.Grass, { Name = "Moss" })
	end
	return list
end

PROPS.Crystal = function(B, x, y, z, opts)
	local rng, decor = B.Rng, B.Theme.Decor
	local list = {}
	local color = opts.Color or (if decor == "Glacier" then rgb(140, 230, 255) elseif decor == "Sky" then (B.Theme.Accent2 or B.Theme.Accent) else B.Theme.Accent)
	local s = opts.Scale or 1
	z = math.max(z, -4.9 + 0.8 * s)
	local shards = { { 0, 1, 0, 0.8 }, { -0.6, 0.7, -22, 0.6 }, { 0.65, 0.55, 25, 0.5 } }
	for i, shard in shards do
		local h = rng:NextNumber(2.6, 4.6) * shard[2] * s
		local w = shard[4] * s
		local material = if i == 1 then NEON else M.Glass
		piece(B, list, Vector3.new(w, h, w), CFrame.new(B:W(x + shard[1] * s, y + h * 0.4, z)) * CFrame.Angles(0, 0, math.rad(shard[3])) * CFrame.Angles(0, math.rad(45), 0), color, material, { Name = "Crystal", Transparency = if i == 1 then 0.1 else 0.2 })
	end
	return list
end

PROPS.Pine = function(B, x, y, z, opts)
	local s = (opts.Scale or 1) * B.Rng:NextNumber(0.75, 1)
	return B:Tree(x, y, math.max(z, -4.9 + 2.2 * s), { Kind = "Pine", Scale = s })
end

PROPS.Tree = function(B, x, y, z, opts)
	local s = (opts.Scale or 1) * B.Rng:NextNumber(0.55, 0.75)
	return B:Tree(x, y, math.max(z, -4.9 + 2.4 * s), { Scale = s })
end

PROPS.SnowMound = function(B, x, y, z, opts)
	local rng = B.Rng
	local list = {}
	local s = opts.Scale or 1
	local d = rng:NextNumber(2.6, 3.6) * s
	z = math.max(z, -4.9 + d / 2)
	piece(B, list, Vector3.new(d, d, d), CFrame.new(B:W(x, y + d * 0.1, z)), rgb(244, 248, 255), M.Snow, { Name = "SnowMound", Shape = BALL })
	local d2 = d * 0.65
	piece(B, list, Vector3.new(d2, d2, d2), CFrame.new(B:W(x + d * 0.55, y, z + 0.2)), rgb(236, 244, 255), M.Snow, { Name = "SnowMound", Shape = BALL })
	return list
end

PROPS.IceBlock = function(B, x, y, z, opts)
	local rng = B.Rng
	local list = {}
	local s = (opts.Scale or 1) * rng:NextNumber(2, 2.7)
	z = math.max(z, -4.9 + s * 0.7)
	piece(B, list, Vector3.new(s, s, s), CFrame.new(B:W(x, y + s * 0.4, z)) * CFrame.Angles(math.rad(rng:NextNumber(-10, 10)), math.rad(rng:NextNumber(0, 90)), math.rad(rng:NextNumber(-10, 10))), rgb(176, 224, 255), M.Ice, { Name = "IceBlock", Transparency = 0.15 })
	if rng:NextNumber() < 0.5 then
		local s2 = s * 0.6
		piece(B, list, Vector3.new(s2, s2, s2), CFrame.new(B:W(x + s * 0.7, y + s2 * 0.4, z + 0.3)) * CFrame.Angles(0, math.rad(rng:NextNumber(0, 90)), 0), rgb(200, 236, 255), M.Ice, { Name = "IceBlock", Transparency = 0.15 })
	end
	return list
end

PROPS.Column = function(B, x, y, z, _opts)
	local rng = B.Rng
	local list = {}
	local marble, trim = rgb(240, 236, 226), B:_t("Trim")
	z = math.max(z, -3.7)
	local broken = rng:NextNumber() < 0.45
	local h = if broken then rng:NextNumber(2.5, 4.5) else rng:NextNumber(6.5, 8.8)
	piece(B, list, Vector3.new(2.4, 0.7, 2.4), CFrame.new(B:W(x, y + 0.35, z)), trim, M.Marble, { Name = "Plinth" })
	piece(B, list, Vector3.new(h, 1.5, 1.5), CFrame.new(B:W(x, y + 0.7 + h / 2, z)) * VERTICAL, marble, M.Marble, { Name = "Column", Shape = CYL })
	if broken then
		piece(B, list, Vector3.new(1.8, 1.5, 1.5), CFrame.new(B:W(x + 2.3, y + 0.75, z + 0.4)) * CFrame.Angles(0, math.rad(rng:NextNumber(-25, 25)), 0), shade(marble, 0.92), M.Marble, { Name = "ColumnPiece", Shape = CYL })
	else
		piece(B, list, Vector3.new(2.3, 0.6, 2.3), CFrame.new(B:W(x, y + 1 + h, z)), trim, M.Marble, { Name = "Capital" })
	end
	return list
end

PROPS.Urn = function(B, x, y, z, _opts)
	local rng = B.Rng
	local list = {}
	local clay = rgb(196, 112, 76)
	z = math.max(z, -3.9)
	piece(B, list, Vector3.new(1.8, 1.8, 1.8), CFrame.new(B:W(x, y + 0.95, z)), clay, M.Sandstone, { Name = "Urn", Shape = BALL })
	piece(B, list, Vector3.new(0.6, 0.9, 0.9), CFrame.new(B:W(x, y + 2, z)) * VERTICAL, shade(clay, 0.9), M.Sandstone, { Name = "UrnNeck", Shape = CYL })
	piece(B, list, Vector3.new(0.16, 1.25, 1.25), CFrame.new(B:W(x, y + 2.33, z)) * VERTICAL, rgb(236, 220, 190), M.Marble, { Name = "UrnRim", Shape = CYL })
	if rng:NextNumber() < 0.45 then
		piece(B, list, Vector3.new(1.5, 1.5, 1.5), CFrame.new(B:W(x, y + 2.8, z)), jitter(rng, B:_t("Leaf"), 0.1), M.Grass, { Name = "UrnPlant", Shape = BALL })
	end
	return list
end

PROPS.Flower = function(B, x, y, z, _opts)
	local rng = B.Rng
	local list = {}
	z = math.max(z, -3.8)
	local colors = { rgb(255, 120, 170), rgb(255, 222, 80), rgb(255, 255, 255), rgb(190, 120, 255), rgb(255, 104, 80) }
	piece(B, list, Vector3.new(1.8, 1.8, 1.8), CFrame.new(B:W(x, y + 0.3, z)), jitter(rng, B:_t("Leaf"), 0.1), M.Grass, { Name = "FlowerLeaves", Shape = BALL })
	for _, offset in { { -0.55, 0.95 }, { 0.15, 1.25 }, { 0.65, 0.9 } } do
		local d = rng:NextNumber(0.55, 0.8)
		piece(B, list, Vector3.new(d, d, d), CFrame.new(B:W(x + offset[1], y + offset[2], z + 0.5)), colors[rng:NextInteger(1, #colors)], M.SmoothPlastic, { Name = "Blossom", Shape = BALL })
	end
	return list
end

PROPS.Fern = function(B, x, y, z, _opts)
	local rng = B.Rng
	local list = {}
	z = math.max(z, -4.2)
	for _, angle in { -52, -18, 18, 52 } do
		local len = rng:NextNumber(2.4, 3.4)
		piece(B, list, Vector3.new(0.7, len, 0.16), CFrame.new(B:W(x, y, z)) * CFrame.Angles(0, math.rad(rng:NextNumber(-25, 25)), math.rad(angle)) * CFrame.new(0, len / 2, 0), jitter(rng, B:_t("Leaf"), 0.15), M.Grass, { Name = "Fern" })
	end
	return list
end

PROPS.Mushroom = function(B, x, y, z, _opts)
	local rng = B.Rng
	local list = {}
	z = math.max(z, -3.6)
	local caps = { rgb(215, 50, 50), rgb(240, 130, 40), rgb(170, 90, 220) }
	for i = 1, if rng:NextNumber() < 0.5 then 2 else 1 do
		local s = if i == 1 then 1 else 0.6
		local mx = x + (i - 1) * 1.7
		local h = rng:NextNumber(1.3, 2.1) * s
		local cap = caps[rng:NextInteger(1, #caps)]
		piece(B, list, Vector3.new(h, 0.55 * s, 0.55 * s), CFrame.new(B:W(mx, y + h / 2, z)) * VERTICAL, rgb(236, 226, 200), M.SmoothPlastic, { Name = "MushroomStem", Shape = CYL })
		piece(B, list, Vector3.new(2.4 * s, 1.1 * s, 2.4 * s), CFrame.new(B:W(mx, y + h, z)), cap, M.SmoothPlastic, { Name = "MushroomCap", Mesh = SPHERE })
		if i == 1 then
			for _, ox in { -0.5, 0.45 } do
				piece(B, list, Vector3.new(0.35, 0.35, 0.35), CFrame.new(B:W(mx + ox, y + h + 0.2, z + 1)), WHITE, M.SmoothPlastic, { Name = "MushroomDot", Shape = BALL })
			end
		end
	end
	return list
end

PROPS.Log = function(B, x, y, z, _opts)
	local rng = B.Rng
	local list = {}
	z = math.max(z, -4.1)
	local len = rng:NextNumber(4, 6)
	local cf = CFrame.new(B:W(x, y + 0.65, z)) * CFrame.Angles(0, math.rad(rng:NextNumber(-10, 10)), 0)
	piece(B, list, Vector3.new(len, 1.3, 1.3), cf, rgb(110, 78, 50), M.Wood, { Name = "Log", Shape = CYL })
	piece(B, list, Vector3.new(len * 0.55, 0.25, 0.9), cf * CFrame.new(rng:NextNumber(-0.5, 0.5), 0.65, 0), rgb(80, 150, 60), M.Grass, { Name = "Moss" })
	return list
end

PROPS.Vent = function(B, x, y, z, _opts)
	local list = {}
	z = math.max(z, -3.7)
	piece(B, list, Vector3.new(3, 2, 2.2), CFrame.new(B:W(x, y + 1, z)), rgb(92, 98, 118), M.Metal, { Name = "Vent" })
	piece(B, list, Vector3.new(0.15, 1.5, 1.5), CFrame.new(B:W(x - 0.5, y + 1, z + 1.12)) * FACING, rgb(40, 42, 52), M.DiamondPlate, { Name = "VentFan", Shape = CYL })
	piece(B, list, Vector3.new(0.3, 0.3, 0.1), CFrame.new(B:W(x + 1.05, y + 1.55, z + 1.12)), B.Theme.Accent, NEON, { Name = "VentLight" })
	return list
end

PROPS.Barrier = function(B, x, y, z, _opts)
	local list = {}
	z = math.max(z, -4.2)
	local concrete = rgb(170, 172, 182)
	piece(B, list, Vector3.new(4, 0.9, 1.4), CFrame.new(B:W(x, y + 0.45, z)), concrete, M.Concrete, { Name = "Barrier" })
	piece(B, list, Vector3.new(4, 0.8, 0.8), CFrame.new(B:W(x, y + 1.3, z)), concrete, M.Concrete, { Name = "Barrier" })
	piece(B, list, Vector3.new(4.02, 0.14, 0.06), CFrame.new(B:W(x, y + 1.35, z + 0.42)), B.Theme.Accent2 or B.Theme.Accent, NEON, { Name = "BarrierStripe" })
	return list
end

PROPS.HoloSign = function(B, x, y, z, _opts)
	local rng, theme = B.Rng, B.Theme
	local list = {}
	z = math.max(z, -4.6)
	local color = if rng:NextNumber() < 0.5 then theme.Accent else theme.Accent2 or theme.Accent
	piece(B, list, Vector3.new(0.25, 3.2, 0.25), CFrame.new(B:W(x, y + 1.6, z)), rgb(54, 58, 72), M.Metal, { Name = "HoloPost" })
	piece(B, list, Vector3.new(3, 1.7, 0.1), CFrame.new(B:W(x, y + 3.9, z - 0.08)), rgb(24, 26, 36), M.Metal, { Name = "HoloFrame" })
	piece(B, list, Vector3.new(2.7, 1.4, 0.1), CFrame.new(B:W(x, y + 3.9, z + 0.02)), color, NEON, { Name = "HoloPanel", Transparency = 0.35 })
	return list
end

PROPS.Antenna = function(B, x, y, z, _opts)
	local rng = B.Rng
	local list = {}
	z = math.max(z, -4.3)
	local h = rng:NextNumber(6.5, 9)
	piece(B, list, Vector3.new(0.8, 0.4, 0.8), CFrame.new(B:W(x, y + 0.2, z)), rgb(60, 62, 74), M.Metal, { Name = "AntennaBase" })
	piece(B, list, Vector3.new(h, 0.24, 0.24), CFrame.new(B:W(x, y + h / 2, z)) * VERTICAL, rgb(150, 155, 170), M.Metal, { Name = "Antenna", Shape = CYL })
	piece(B, list, Vector3.new(0.2, 1.6, 1.6), CFrame.new(B:W(x + 0.6, y + h * 0.6, z)) * CFrame.Angles(0, 0, math.rad(-30)), rgb(200, 204, 214), M.Metal, { Name = "AntennaDish", Shape = CYL })
	piece(B, list, Vector3.new(0.45, 0.45, 0.45), CFrame.new(B:W(x, y + h + 0.2, z)), rgb(255, 60, 60), NEON, { Name = "AntennaLight", Shape = BALL })
	return list
end

PROPS.Pipe = function(B, x, y, z, _opts)
	local rng = B.Rng
	local list = {}
	z = math.max(z, -4.3)
	local len = rng:NextNumber(5, 8)
	piece(B, list, Vector3.new(len, 1, 1), CFrame.new(B:W(x, y + 1.7, z)), rgb(150, 132, 112), M.Metal, { Name = "Pipe", Shape = CYL })
	for _, side in { -1, 1 } do
		piece(B, list, Vector3.new(0.35, 1.4, 0.35), CFrame.new(B:W(x + side * (len / 2 - 0.6), y + 0.7, z)), rgb(70, 64, 60), M.Metal, { Name = "PipeSupport" })
	end
	piece(B, list, Vector3.new(0.3, 1.25, 1.25), CFrame.new(B:W(x - len * 0.25, y + 1.7, z)), rgb(110, 96, 82), M.Metal, { Name = "PipeFlange", Shape = CYL })
	piece(B, list, Vector3.new(0.15, 1.1, 1.1), CFrame.new(B:W(x + len * 0.15, y + 1.7, z + 0.62)) * FACING, rgb(200, 50, 40), M.Metal, { Name = "PipeValve", Shape = CYL })
	return list
end

PROPS.Girder = function(B, x, y, z, _opts)
	local list = {}
	z = math.max(z, -4.4)
	local steel = rgb(230, 175, 45)
	for _, side in { -1, 1 } do
		piece(B, list, Vector3.new(0.4, 5.5, 0.4), CFrame.new(B:W(x + side * 1.6, y + 2.75, z)), steel, M.Metal, { Name = "GirderPost" })
	end
	piece(B, list, Vector3.new(3.8, 0.4, 0.4), CFrame.new(B:W(x, y + 5.5, z)), steel, M.Metal, { Name = "GirderBeam" })
	piece(B, list, Vector3.new(0.25, 6, 0.25), CFrame.new(B:W(x, y + 2.75, z)) * CFrame.Angles(0, 0, -math.atan2(3.2, 5.1)), shade(steel, 0.8), M.Metal, { Name = "GirderBrace" })
	return list
end

PROPS.WarningLamp = function(B, x, y, z, _opts)
	local list = {}
	z = math.max(z, -4.5)
	local glow = B.Theme.Accent
	piece(B, list, Vector3.new(0.3, 2.4, 0.3), CFrame.new(B:W(x, y + 1.2, z)), rgb(50, 48, 50), M.Metal, { Name = "WarningPost" })
	piece(B, list, Vector3.new(0.75, 0.75, 0.75), CFrame.new(B:W(x, y + 2.7, z)), glow, NEON, { Name = "WarningLight", Shape = BALL, Light = { Range = 10, Brightness = 1.2, Color = glow } })
	piece(B, list, Vector3.new(0.6, 0.2, 0.6), CFrame.new(B:W(x, y + 3.15, z)), rgb(50, 48, 50), M.Metal, { Name = "WarningCap" })
	return list
end

PROPS.Bench = function(B, x, y, z, _opts)
	local list = {}
	z = math.max(z, -4.3)
	local hub = B.Theme.Decor == "Hub"
	local seat = if hub then rgb(70, 76, 100) else rgb(150, 105, 65)
	local seatMat = if hub then M.Metal else M.WoodPlanks
	piece(B, list, Vector3.new(3.4, 0.25, 1), CFrame.new(B:W(x, y + 0.95, z)), seat, seatMat, { Name = "BenchSeat" })
	piece(B, list, Vector3.new(3.4, 0.8, 0.16), CFrame.new(B:W(x, y + 1.55, z - 0.42)), seat, seatMat, { Name = "BenchBack" })
	for _, side in { -1, 1 } do
		piece(B, list, Vector3.new(0.25, 0.85, 0.9), CFrame.new(B:W(x + side * 1.4, y + 0.42, z)), rgb(44, 46, 56), M.Metal, { Name = "BenchLeg" })
	end
	return list
end

PROPS.Planter = function(B, x, y, z, _opts)
	local rng, theme = B.Rng, B.Theme
	local list = {}
	z = math.max(z, -3.8)
	local boxColor = if theme.Decor == "Academy" then rgb(236, 238, 244) else rgb(52, 56, 76)
	piece(B, list, Vector3.new(2.8, 1.2, 2), CFrame.new(B:W(x, y + 0.6, z)), boxColor, M.Concrete, { Name = "Planter" })
	if theme.EdgeGlow then
		piece(B, list, Vector3.new(2.9, 0.12, 0.1), CFrame.new(B:W(x, y + 1.1, z + 1.02)), theme.Accent, NEON, { Name = "PlanterGlow" })
	end
	piece(B, list, Vector3.new(2.4, 2.4, 2.4), CFrame.new(B:W(x, y + 1.8, z)), jitter(rng, B:_t("Leaf"), 0.1), M.Grass, { Name = "PlanterBush", Shape = BALL })
	return list
end

PROPS.Cone = function(B, x, y, z, _opts)
	local rng = B.Rng
	local list = {}
	z = math.max(z, -4.1)
	local orange = rgb(255, 120, 30)
	for i = 1, if rng:NextNumber() < 0.5 then 2 else 1 do
		local cx = x + (i - 1) * 2
		piece(B, list, Vector3.new(1.5, 0.15, 1.5), CFrame.new(B:W(cx, y + 0.075, z)), orange, M.SmoothPlastic, { Name = "ConeBase" })
		piece(B, list, Vector3.new(0.8, 1.05, 1.05), CFrame.new(B:W(cx, y + 0.55, z)) * VERTICAL, orange, M.SmoothPlastic, { Name = "Cone", Shape = CYL })
		piece(B, list, Vector3.new(0.35, 0.8, 0.8), CFrame.new(B:W(cx, y + 1.12, z)) * VERTICAL, WHITE, M.SmoothPlastic, { Name = "ConeBand", Shape = CYL })
		piece(B, list, Vector3.new(0.4, 0.55, 0.55), CFrame.new(B:W(cx, y + 1.48, z)) * VERTICAL, orange, M.SmoothPlastic, { Name = "Cone", Shape = CYL })
	end
	return list
end

PROPS.Hurdle = function(B, x, y, z, _opts)
	local list = {}
	z = math.max(z, -4.4)
	for _, side in { -1, 1 } do
		piece(B, list, Vector3.new(0.25, 1.7, 0.25), CFrame.new(B:W(x + side * 1.6, y + 0.85, z)), WHITE, M.SmoothPlastic, { Name = "HurdlePost" })
		piece(B, list, Vector3.new(0.25, 0.12, 1), CFrame.new(B:W(x + side * 1.6, y + 0.06, z)), rgb(40, 42, 52), M.Metal, { Name = "HurdleFoot" })
	end
	piece(B, list, Vector3.new(3.6, 0.32, 0.16), CFrame.new(B:W(x, y + 1.6, z)), WHITE, M.SmoothPlastic, { Name = "HurdleBar" })
	piece(B, list, Vector3.new(1.2, 0.34, 0.18), CFrame.new(B:W(x, y + 1.6, z)), rgb(230, 50, 60), M.SmoothPlastic, { Name = "HurdleStripe" })
	return list
end

PROPS.Banner = function(B, x, y, z, opts)
	local theme = B.Theme
	local color = opts.Color or (if B.Rng:NextNumber() < 0.5 then theme.Accent else theme.Accent2 or theme.Accent)
	return B:Banner(x, y, color, { Z = math.max(z, -4.6), Color2 = WHITE })
end

-- Große Wahrzeichen für den Hintergrund (y = Fußpunkt, opts.Scale)
PROPS.Temple = function(B, x, y, z, opts)
	local s = opts.Scale or 1
	local list = {}
	local stone = opts.Color or rgb(120, 126, 104)
	for i = 0, 4 do
		local w = (40 - i * 7) * s
		local h = 6 * s
		piece(B, list, Vector3.new(w, h, w * 0.7), CFrame.new(B:W(x, y + h * (i + 0.5), z)), shade(stone, 1 - i * 0.04), M.Cobblestone, { Name = "Temple" })
		piece(B, list, Vector3.new(w + 0.4, 0.8 * s, w * 0.7 + 0.4), CFrame.new(B:W(x, y + h * (i + 1) - 0.2 * s, z)), rgb(78, 140, 62), M.Grass, { Name = "TempleMoss" })
	end
	piece(B, list, Vector3.new(8 * s, 8 * s, 8 * s), CFrame.new(B:W(x, y + 34 * s, z)), shade(stone, 0.85), M.Cobblestone, { Name = "TempleShrine" })
	piece(B, list, Vector3.new(3 * s, 4 * s, 0.4), CFrame.new(B:W(x, y + 33 * s, z + 4 * s + 0.1)), B.Theme.Accent2 or B.Theme.Accent, NEON, { Name = "TempleDoor", Light = { Range = 30, Brightness = 2, Color = B.Theme.Accent2 or B.Theme.Accent } })
	return list
end

PROPS.RuinArch = function(B, x, y, z, opts)
	local s = opts.Scale or 1
	local list = {}
	local marble = opts.Color or rgb(238, 232, 220)
	local h = 34 * s
	for _, side in { -1, 1 } do
		local px = x + side * 12 * s
		piece(B, list, Vector3.new(h, 4.2 * s, 4.2 * s), CFrame.new(B:W(px, y + h / 2, z)) * VERTICAL, marble, M.Marble, { Name = "RuinColumn", Shape = CYL })
		piece(B, list, Vector3.new(6 * s, 2 * s, 6 * s), CFrame.new(B:W(px, y + h + s, z)), shade(marble, 0.95), M.Marble, { Name = "RuinCapital" })
	end
	piece(B, list, Vector3.new(26 * s, 4 * s, 5 * s), CFrame.new(B:W(x - 2 * s, y + h + 4 * s, z)) * CFrame.Angles(0, 0, math.rad(4)), marble, M.Marble, { Name = "RuinLintel" })
	piece(B, list, Vector3.new(8 * s, 2.5 * s, 4 * s), CFrame.new(B:W(x + 4 * s, y + h + 7.2 * s, z)) * CFrame.Angles(0, 0, math.rad(-10)), shade(marble, 0.9), M.Marble, { Name = "RuinBlock" })
	local vine = rgb(90, 160, 70)
	for i = 1, 3 do
		local vl = (6 + i * 3) * s
		piece(B, list, Vector3.new(vl, 0.6 * s, 0.6 * s), CFrame.new(B:W(x - 9 * s + i * 6 * s, y + h + 2 * s - vl / 2, z + 2.6 * s)) * VERTICAL, vine, M.Grass, { Name = "RuinVine", Shape = CYL })
	end
	return list
end

PROPS.Tower = function(B, x, y, z, opts)
	local s = opts.Scale or 1
	local theme = B.Theme
	local list = {}
	local body = opts.Color or rgb(30, 30, 52)
	local h = 260 * s
	local w = 40 * s
	piece(B, list, Vector3.new(w, h, w * 0.8), CFrame.new(B:W(x, y + h / 2, z)), body, M.Glass, { Name = "Tower" })
	piece(B, list, Vector3.new(w * 0.6, 60 * s, w * 0.5), CFrame.new(B:W(x, y + h + 30 * s, z)), shade(body, 1.15), M.Metal, { Name = "TowerTop" })
	piece(B, list, Vector3.new(50 * s, 1.2, 1.2), CFrame.new(B:W(x, y + h + 85 * s, z)) * VERTICAL, rgb(200, 204, 220), M.Metal, { Name = "TowerSpire", Shape = CYL })
	piece(B, list, Vector3.new(2.5, 2.5, 2.5), CFrame.new(B:W(x, y + h + 111 * s, z)), rgb(255, 60, 80), NEON, { Name = "TowerBeacon", Shape = BALL })
	for _, side in { -1, 1 } do
		piece(B, list, Vector3.new(1.2, h * 0.9, 0.4), CFrame.new(B:W(x + side * w * 0.42, y + h * 0.55, z + w * 0.4 + 0.2)), if side < 0 then theme.Accent else theme.Accent2 or theme.Accent, NEON, { Name = "TowerGlow" })
	end
	for i = 1, 6 do
		piece(B, list, Vector3.new(w * 0.7, 1, 0.3), CFrame.new(B:W(x, y + h - i * 18 * s, z + w * 0.4 + 0.15)), rgb(255, 214, 140), NEON, { Name = "TowerWindow", Transparency = 0.15 })
	end
	return list
end

--- Stellt eine Requisite auf (y = Bodenoberkante, z Standard -4.2).
function MapBuilder:Prop(kind: string, x: number, y: number, z: number?, opts)
	local build = PROPS[kind]
	if not build then
		warn("[MapBuilder] Unbekannte Requisite: " .. tostring(kind))
		return {}
	end
	return build(self, x, y, z or BACK_Z, opts or {})
end

------------------------------------------------------------------------
-- Terrain (nur hinter der Spur; wird aufgezeichnet und beim Entladen gelöscht)
------------------------------------------------------------------------

local function terrainMaterial(material)
	if material and TERRAIN_MATERIALS[material] then
		return material
	end
	return M.Rock
end

--- Prüft die vordere Grenze (lokales z) einer Terrain-Füllung.
function MapBuilder:_terrainOk(maxZ: number, what: string): boolean
	if maxZ > TERRAIN_MAX_Z then
		warn(string.format("[MapBuilder] Terrain '%s' reicht bis z = %.1f (erlaubt ≤ %d) – übersprungen", what, maxZ, TERRAIN_MAX_Z))
		return false
	end
	return true
end

function MapBuilder:_fill(record, write)
	table.insert(self.TerrainFills, record)
	local ok, err = pcall(write, workspace.Terrain)
	if not ok then
		warn("[MapBuilder] Terrain-Füllung fehlgeschlagen: " .. tostring(err))
	end
end

--- Terrain-Quader (Mittelpunkt x, y, z; optional gedreht).
function MapBuilder:TerrainBlock(x: number, y: number, z: number, size: Vector3, material: Enum.Material?, rotation: CFrame?)
	local extent = if rotation then size.Magnitude / 2 else size.Z / 2
	if not self:_terrainOk(z + extent, "Block") then
		return
	end
	local cframe = CFrame.new(self:W(x, y, z)) * (rotation or CFrame.identity)
	local mat = terrainMaterial(material)
	self:_fill({ Kind = "Block", CFrame = cframe, Size = size }, function(terrain)
		terrain:FillBlock(cframe, size, mat)
	end)
end

--- Terrain-Kugel.
function MapBuilder:TerrainBall(x: number, y: number, z: number, radius: number, material: Enum.Material?)
	if not self:_terrainOk(z + radius, "Ball") then
		return
	end
	local center = self:W(x, y, z)
	local mat = terrainMaterial(material)
	self:_fill({ Kind = "Ball", Center = center, Radius = radius }, function(terrain)
		terrain:FillBall(center, radius, mat)
	end)
end

--- Terrain-Zylinder (Achse senkrecht, optional gedreht).
function MapBuilder:TerrainCylinder(x: number, y: number, z: number, height: number, radius: number, material: Enum.Material?, rotation: CFrame?)
	local extent = if rotation then math.sqrt(radius * radius + height * height / 4) else radius
	if not self:_terrainOk(z + extent, "Cylinder") then
		return
	end
	local cframe = CFrame.new(self:W(x, y, z)) * (rotation or CFrame.identity)
	local mat = terrainMaterial(material)
	self:_fill({ Kind = "Cylinder", CFrame = cframe, Height = height, Radius = radius }, function(terrain)
		terrain:FillCylinder(cframe, height, radius, mat)
	end)
end

--- Terrain-Keil (Form wie WedgePart; hohe Seite lokal bei +Z).
function MapBuilder:TerrainWedge(x: number, y: number, z: number, size: Vector3, material: Enum.Material?, rotation: CFrame?)
	local extent = if rotation then size.Magnitude / 2 else size.Z / 2
	if not self:_terrainOk(z + extent, "Wedge") then
		return
	end
	local cframe = CFrame.new(self:W(x, y, z)) * (rotation or CFrame.identity)
	local mat = terrainMaterial(material)
	self:_fill({ Kind = "Wedge", CFrame = cframe, Size = size }, function(terrain)
		terrain:FillWedge(cframe, size, mat)
	end)
end

--- Berg aus Terrain mit Gipfel bei baseY + height.
--- opts: Style ("Round" = Kugeln, "Peak" = spitzer Grat aus Keilen), Material, Cap (Gipfelmaterial),
--- CapRatio (Anteil der Gipfelkappe, Standard 0.3), Depth (Tiefe beim Grat, Standard 40)
function MapBuilder:Mountain(x: number, z: number, baseY: number, height: number, width: number, opts)
	opts = opts or {}
	local terrain = self.Theme.Terrain or {}
	local material = opts.Material or terrain.Peak or M.Rock
	local cap = opts.Cap
	local topY = baseY + height
	if opts.Style == "Peak" then
		local depth = opts.Depth or 40
		local half = width / 2
		self:TerrainWedge(x - half / 2, baseY + height / 2, z, Vector3.new(depth, height, half), material, CFrame.Angles(0, math.rad(90), 0))
		self:TerrainWedge(x + half / 2, baseY + height / 2, z, Vector3.new(depth, height, half), material, CFrame.Angles(0, math.rad(-90), 0))
		if cap then
			local ch = height * (opts.CapRatio or 0.3)
			local cw = half * ch / height
			local cy = topY - ch / 2 + 0.8
			self:TerrainWedge(x - cw / 2, cy, z, Vector3.new(depth + 2, ch, cw), cap, CFrame.Angles(0, math.rad(90), 0))
			self:TerrainWedge(x + cw / 2, cy, z, Vector3.new(depth + 2, ch, cw), cap, CFrame.Angles(0, math.rad(-90), 0))
		end
	else
		-- Kuppe aus einer Kugel (Radius = halbe Breite), darunter gestapelte Kugeln bis zum Fuß
		local rng = self.Rng
		local r = width / 2
		local cy = topY - r
		self:TerrainBall(x, cy, z, r, material)
		local side = if rng:NextNumber() < 0.5 then -1 else 1
		self:TerrainBall(x + side * r * 0.75, cy - r * 0.3, z, r * 0.7, material)
		local guard = 0
		while cy - r > baseY and guard < 5 do
			guard += 1
			cy -= r * 1.1
			self:TerrainBall(x + rng:NextNumber(-r * 0.2, r * 0.2), cy, z, r * 1.05, material)
		end
		if cap then
			self:TerrainBall(x, topY - r * 0.26, z, r * 0.32, cap)
		end
	end
end

--- Schwebende Insel aus Terrain: flache Grasdecke, darunter spitz zulaufender Fels.
--- opts: Top, Rock, Cliff (Materialien). Liefert die Oberkante.
function MapBuilder:Island(x: number, y: number, z: number, radius: number, opts)
	opts = opts or {}
	local terrain = self.Theme.Terrain or {}
	local top = opts.Top or terrain.Top or M.Grass
	local rock = opts.Rock or terrain.Ground or M.Rock
	local cliff = opts.Cliff or terrain.Cliff or rock
	local r = radius
	self:TerrainCylinder(x, y - 2, z, 4, r, top)
	self:TerrainCylinder(x, y - 5.5, z, 4, r * 0.96, rock)
	self:TerrainBall(x, y - r * 0.85, z, r * 0.8, rock)
	self:TerrainBall(x + r * 0.12, y - r * 1.4, z, r * 0.5, cliff)
	self:TerrainBall(x - r * 0.08, y - r * 1.85, z, r * 0.26, cliff)
	return y
end

--- Terrain-Streifen über die gesamte sichtbare Breite (in Abschnitten ≤ 512 Studs).
function MapBuilder:_terrainStrip(zFront: number, zBack: number, yBottom: number, yTop: number, material)
	local x, xEnd = self:_span(zBack)
	local depth = math.abs(zFront - zBack)
	local zMid = (zFront + zBack) / 2
	while x < xEnd do
		local w = math.min(512, xEnd - x)
		self:TerrainBlock(x + w / 2, (yBottom + yTop) / 2, zMid, Vector3.new(w, yTop - yBottom, depth), material)
		x += w
	end
end

--- X-Bereich, der bei Tiefe z im Bild sein kann (inkl. Kamera-Zoom).
function MapBuilder:_span(z: number): (number, number)
	local pad = (80 + math.abs(z)) * 1.25
	return self.MinX - pad, self.MaxX + pad
end

--- Niedrigste und höchste Bodenoberkante der Strecke.
function MapBuilder:_floorRange(): (number, number)
	local lo, hi = math.huge, -math.huge
	for _, p in self.Platforms do
		lo = math.min(lo, p.Y)
		hi = math.max(hi, p.Y)
	end
	if lo > hi then
		return self.MinY, self.MaxY
	end
	return lo, hi
end

------------------------------------------------------------------------
-- Automatische Bodenverzierung
------------------------------------------------------------------------

--- Fasst angrenzende Böden gleicher Höhe zu "Läufen" zusammen.
function MapBuilder:_collectRuns()
	local list = {}
	for _, p in self.Platforms do
		if not p.NoDress and p.X2 - p.X1 > 0.05 then
			table.insert(list, p)
		end
	end
	table.sort(list, function(a, b)
		if a.X1 ~= b.X1 then
			return a.X1 < b.X1
		end
		return a.Y > b.Y
	end)
	local runs = {}
	for _, p in list do
		local merged = false
		for i = #runs, math.max(1, #runs - 8), -1 do
			local run = runs[i]
			if math.abs(run.Y - p.Y) < 0.01 and p.X1 <= run.X2 + 0.05 and run.Ice == p.Ice and run.Upper == p.Upper then
				run.X2 = math.max(run.X2, p.X2)
				table.insert(run.Parts, p)
				merged = true
				break
			end
		end
		if not merged then
			table.insert(runs, { X1 = p.X1, X2 = p.X2, Y = p.Y, Ice = p.Ice, Upper = p.Upper, Parts = { p } })
		end
	end
	return runs
end

--- Bodenteil eines Laufs an Position x (sonst das nächstgelegene).
function MapBuilder:_partAt(run, x: number)
	local best, bestDist = run.Parts[1], math.huge
	for _, p in run.Parts do
		if x >= p.X1 and x <= p.X2 then
			return p
		end
		local dist = math.min(math.abs(x - p.X1), math.abs(x - p.X2))
		if dist < bestDist then
			best, bestDist = p, dist
		end
	end
	return best
end

--- Wand/Block, der bei x direkt unter der Höhe y beginnt.
function MapBuilder:_solidAt(x: number, y: number)
	for _, s in self.Solids do
		if x >= s.X1 - 0.01 and x <= s.X2 + 0.01 and s.Y2 >= y - 0.5 and s.Y1 < y - 0.01 then
			return s
		end
	end
	return nil
end

--- Liegt unter (x, bottomY) mindestens `gap` Studs nichts?
function MapBuilder:_freeBelow(x: number, bottomY: number, gap: number): boolean
	local below = self:_topAt(x, bottomY - 0.05, true)
	return below == nil or below < bottomY - gap
end

--- Höchste begehbare Oberkante (Boden, Rampe, Wand/Block) unter bottomY im ganzen
--- Bereich x1..x2 – nil, wenn darunter nur Abgrund ist. Eine Rampe, die bis an
--- bottomY heranreicht, zählt mit bottomY (kein Platz für Deko).
function MapBuilder:_highestBelow(x1: number, x2: number, bottomY: number): number?
	local limit = bottomY - 0.05
	local best = nil
	local function consider(y)
		y = math.min(y, limit)
		if best == nil or y > best then
			best = y
		end
	end
	for _, p in self.Platforms do
		if p.X2 >= x1 and p.X1 <= x2 and p.Y < limit then
			consider(p.Y)
		end
	end
	for _, r in self.Ramps do
		if r.X2 >= x1 and r.X1 <= x2 then
			local span = math.max(r.X2 - r.X1, 0.01)
			local ya = r.Y1 + (r.Y2 - r.Y1) * (math.max(r.X1, x1) - r.X1) / span
			local yb = r.Y1 + (r.Y2 - r.Y1) * (math.min(r.X2, x2) - r.X1) / span
			if math.min(ya, yb) < limit then
				consider(math.max(ya, yb))
			end
		end
	end
	for _, s in self.Solids do
		if s.X2 >= x1 and s.X1 <= x2 and s.Y1 < limit then
			consider(s.Y2)
		end
	end
	return best
end

--- Freie Höhe über dem Boden (Decken, höhere Plattformen, Wände).
function MapBuilder:_clearanceAt(x: number, y: number): number
	local best = math.huge
	for _, c in self.Ceilings do
		if x >= c.X1 - 1.5 and x <= c.X2 + 1.5 and c.Y > y then
			best = math.min(best, c.Y - y)
		end
	end
	for _, p in self.Platforms do
		if x >= p.X1 - 1.5 and x <= p.X2 + 1.5 and p.Bottom > y + 0.1 then
			best = math.min(best, p.Bottom - y)
		end
	end
	for _, s in self.Solids do
		if x + 1.8 >= s.X1 and x - 1.8 <= s.X2 and s.Y2 > y + 0.2 then
			if s.Y1 <= y + 0.5 then
				return 0
			end
			best = math.min(best, s.Y1 - y)
		end
	end
	return best
end

--- Verzierung eines Laufs: Lippe, Leuchtkante, Bänder, Rippen, Ecken, Unterseite.
function MapBuilder:_dressRun(run)
	local theme, rng = self.Theme, self.Rng
	local len = run.X2 - run.X1
	if len < 0.5 then
		return
	end
	local cx = (run.X1 + run.X2) / 2
	local y = run.Y
	local style = self:_t("RibStyle")
	local trim = if run.Ice then ICE_TRIM else self:_t("Trim")
	local trimMat = if run.Ice then M.Ice else self:_t("TrimMaterial")
	local detail, detailMat = self:_t("Detail"), self:_t("DetailMaterial")
	local minThick = math.huge
	for _, p in run.Parts do
		minThick = math.min(minThick, p.Y - p.Bottom)
	end

	-- Lippe an der vorderen Oberkante (bei Gras etwas überhängend)
	local lipDepth = if style == "Root" then 1 else 0.7
	self:Deco(Vector3.new(len, 0.5, lipDepth), CFrame.new(self:W(cx, y - 0.2, FACE_Z + lipDepth / 2 - 0.35)), trim, trimMat, { Name = "Lip" })
	if theme.EdgeGlow and minThick >= 0.9 then
		self:Deco(Vector3.new(len, 0.16, 0.12), CFrame.new(self:W(cx, y - 0.62, FACE_Z + 0.36)), theme.Accent, NEON, { Name = "EdgeGlow" })
	end

	-- Zierbänder
	if style == "Strata" then
		if minThick >= 4 then
			self:Deco(Vector3.new(len, 0.6, 0.14), CFrame.new(self:W(cx, y - 2.4, FACE_Z + 0.07)), detail, detailMat, { Name = "Strata" })
		end
		if minThick >= 6.5 then
			self:Deco(Vector3.new(len, 0.4, 0.12), CFrame.new(self:W(cx, y - 4.9, FACE_Z + 0.06)), shade(theme.Ground, 1.25), M.Ice, { Name = "Strata" })
		end
	elseif style ~= "Root" and minThick >= 3.5 then
		self:Deco(Vector3.new(len, 0.34, 0.14), CFrame.new(self:W(cx, y - 1.75, FACE_Z + 0.07)), detail, detailMat, { Name = "Band" })
	end
	if style == "Pipe" and minThick >= 5.5 and len >= 6 then
		self:Deco(Vector3.new(len, 0.7, 0.7), CFrame.new(self:W(cx, y - 3.6, FACE_Z + 0.3)), rgb(150, 136, 120), M.Metal, { Name = "FacePipe", Shape = CYL })
	end

	-- Rippen / Fugen / Wurzeln auf der Vorderseite
	local spacing = RIB_SPACING[style] or 12
	if spacing > 0 and len >= spacing * 0.6 then
		local rx = run.X1 + spacing / 2
		while rx < run.X2 - 0.5 do
			local px = if style == "Root" then rx + rng:NextNumber(-2, 2) else rx
			px = math.clamp(px, run.X1 + 0.6, run.X2 - 0.6)
			local part = self:_partAt(run, px)
			if style == "Root" then
				local length = math.min(rng:NextNumber(1.6, 4.4), y - part.Bottom - 0.9)
				if length > 0.6 then
					local isRoot = rng:NextNumber() < 0.55
					self:Deco(
						Vector3.new(length, 0.3, 0.3),
						CFrame.new(self:W(px, y - 0.6 - length / 2, FACE_Z + 0.2)) * CFrame.Angles(0, 0, math.rad(90 + rng:NextNumber(-12, 12))),
						if isRoot then detail else shade(self:_t("Leaf"), 0.85),
						if isRoot then M.Wood else M.Grass,
						{ Name = "Root", Shape = CYL }
					)
				end
			else
				local thin = style == "Joint"
				local top = y - (if thin then 2 else 2.1)
				local bottom = math.max(part.Bottom + (if thin then 0.3 else 0.5), y - (if thin then 9 else 8))
				if top - bottom > 0.8 then
					if thin then
						self:Deco(Vector3.new(0.18, top - bottom, 0.1), CFrame.new(self:W(px, (top + bottom) / 2, FACE_Z + 0.05)), shade(theme.Ground, 0.78), M.SmoothPlastic, { Name = "Joint" })
					else
						self:Deco(Vector3.new(0.55, top - bottom, 0.14), CFrame.new(self:W(px, (top + bottom) / 2, FACE_Z + 0.07)), detail, detailMat, { Name = "Rib" })
					end
				end
			end
			rx += spacing
		end
	end

	-- Eckleisten an freiliegenden Enden
	for side = 1, 2 do
		local ex = if side == 1 then run.X1 else run.X2
		local neighbor = self:_topAt(if side == 1 then ex - 0.6 else ex + 0.6, nil, true)
		if neighbor == nil or neighbor < y - 0.4 then
			local part = self:_partAt(run, if side == 1 then ex + 0.1 else ex - 0.1)
			local low = math.max(part.Bottom, neighbor or -math.huge)
			local h = math.min(y - 0.45 - low, 14)
			if h >= 0.6 then
				self:Deco(Vector3.new(0.7, h, 0.75), CFrame.new(self:W(ex + (if side == 1 then 0.35 else -0.35), y - 0.45 - h / 2, FACE_Z)), trim, trimMat, { Name = "Corner" })
			end
		end
	end

	local supportStyle = self:_t("SupportStyle")
	if supportStyle == "Hanging" or supportStyle == "Ice" or supportStyle == "Stilt" then
		self:_underside(run, supportStyle)
	end
end

--- Platz, den eine tiefere Route unter hängender Deko braucht (Figur + Sprung).
local RUNNER_CLEARANCE = 12

--- Wie weit darf Deko unter bottomY im Bereich x1..x2 hängen? Liefert die maximale
--- Länge (math.huge über dem Abgrund) und ob darunter eine begehbare Fläche liegt.
function MapBuilder:_hangRoom(x1: number, x2: number, bottomY: number): (number, boolean)
	local below = self:_highestBelow(x1, x2, bottomY)
	if below == nil then
		return math.huge, false
	end
	return bottomY - below - RUNNER_CLEARANCE, true
end

--- Details unter freiliegenden Unterseiten (hängende Felsen, Eiszapfen, Wurzeln).
--- Liegt darunter eine tiefere Route, bleibt über ihr RUNNER_CLEARANCE frei und die
--- Felsen rücken hinter die Spielebene (Vorderkante z ≤ -1.7), damit sie niemanden verdecken.
function MapBuilder:_underside(run, style: string)
	local rng = self.Rng
	local len = run.X2 - run.X1
	if style == "Hanging" then
		local rock, rockMat = self:_t("Support"), self:_t("SupportMaterial")
		local segments = math.max(1, math.ceil(len / 36))
		local segLen = len / segments
		if segLen < 4 then
			return
		end
		for i = 1, segments do
			local sx = run.X1 + segLen * (i - 0.5)
			local part = self:_partAt(run, sx)
			local w = segLen * 0.9
			local room, routeBelow = self:_hangRoom(sx - w / 2, sx + w / 2, part.Bottom)
			if room >= 4 then
				local h = math.min(math.clamp(segLen * 0.55, 4, 24) * rng:NextNumber(0.8, 1.2), room)
				local z1, depth1, z2, depth2, vineZ = -0.6, DEPTH - 1.6, -1.2, DEPTH - 3, 3.2
				if routeBelow then
					z1, depth1, z2, depth2, vineZ = -3.2, 3, -3.4, 2.4, -2.2
				end
				self:_triangle(sx, part.Bottom + 0.2, w, h, depth1, z1, rock, rockMat, true, "HangingRock")
				if rng:NextNumber() < 0.55 then
					local h2 = math.min(h * rng:NextNumber(1.2, 1.6), room)
					self:_triangle(sx + w * rng:NextNumber(-0.25, 0.25), part.Bottom + 0.2, w * 0.45, h2, depth2, z2, shade(rock, 0.85), rockMat, true, "HangingRock")
				end
				if rng:NextNumber() < 0.6 then
					local vl = math.min(rng:NextNumber(3, 8), room)
					self:Deco(Vector3.new(vl, 0.3, 0.3), CFrame.new(self:W(sx + rng:NextNumber(-w * 0.3, w * 0.3), part.Bottom - vl / 2, vineZ)) * VERTICAL, shade(self:_t("Leaf"), 0.85), M.Grass, { Name = "Vine", Shape = CYL })
				end
			end
		end
	elseif style == "Ice" then
		local ix = run.X1 + rng:NextNumber(1, 4)
		local flip = false
		while ix < run.X2 - 1 do
			local part = self:_partAt(run, ix)
			local w = rng:NextNumber(0.8, 1.4)
			local h = rng:NextNumber(1.4, 4.2)
			local room = self:_hangRoom(ix - w, ix + w, part.Bottom)
			h = math.min(h, room)
			if h >= 1.2 then
				self:Deco(
					Vector3.new(w, h, w),
					CFrame.new(self:W(ix, part.Bottom - h / 2 + 0.05, FACE_Z - 0.8)) * CFrame.Angles(0, math.rad(if flip then -90 else 90), 0) * CFrame.Angles(math.rad(180), 0, 0),
					ICICLE,
					M.Ice,
					{ Name = "Icicle", Wedge = true, Transparency = 0.05 }
				)
				flip = not flip
			end
			ix += rng:NextNumber(4.5, 8)
		end
	elseif style == "Stilt" then
		local vx = run.X1 + rng:NextNumber(2, 6)
		while vx < run.X2 - 1 do
			local part = self:_partAt(run, vx)
			local vl = math.min(rng:NextNumber(2.5, 8), (self:_hangRoom(vx - 1, vx + 1, part.Bottom)))
			if vl >= 1.5 then
				local isRoot = rng:NextNumber() < 0.5
				local thick = if isRoot then 0.32 else 0.22
				self:Deco(
					Vector3.new(vl, thick, thick),
					CFrame.new(self:W(vx, part.Bottom - vl / 2 + 0.2, FACE_Z - 0.8)) * CFrame.Angles(0, 0, math.rad(90 + rng:NextNumber(-8, 8))),
					if isRoot then self:_t("Detail") else shade(self:_t("Leaf"), 0.8),
					if isRoot then M.Wood else M.Grass,
					{ Name = if isRoot then "HangingRoot" else "HangingVine", Shape = CYL }
				)
			end
			vx += rng:NextNumber(6, 11)
		end
	end
end

--- Lippe entlang der Vorderkante einer Rampe.
function MapBuilder:_dressRamp(ramp)
	local theme = self.Theme
	local dx = ramp.X2 - ramp.X1
	local dy = ramp.Y2 - ramp.Y1
	if math.abs(dy) < 0.05 or dx <= 0 then
		return
	end
	local len = math.sqrt(dx * dx + dy * dy)
	local slope = CFrame.new(self:W((ramp.X1 + ramp.X2) / 2, (ramp.Y1 + ramp.Y2) / 2, FACE_Z)) * CFrame.Angles(0, 0, math.atan2(dy, dx))
	self:Deco(Vector3.new(len, 0.5, 0.7), slope * CFrame.new(0, -0.2, 0), self:_t("Trim"), self:_t("TrimMaterial"), { Name = "RampLip" })
	if theme.EdgeGlow then
		self:Deco(Vector3.new(len, 0.16, 0.12), slope * CFrame.new(0, -0.62, 0.36), theme.Accent, NEON, { Name = "EdgeGlow" })
	end
end

--- Stützen unter einem Lauf: bis zum nächsten Boden darunter oder in den Abgrund.
function MapBuilder:_supportRun(run)
	local style = self:_t("SupportStyle")
	if style == "Hanging" then
		return -- schwebende Ruinen tragen sich selbst
	end
	local len = run.X2 - run.X1
	if len < 10 then
		return
	end
	local abyss = self.MinY - 45
	local n = math.clamp(math.floor(len / 34) + 1, 1, 5)
	for i = 1, n do
		local px = run.X1 + len * (i - 0.5) / n
		local top = self:_partAt(run, px).Bottom
		for _ = 1, 4 do
			local solid = self:_solidAt(px, top)
			if not solid then
				break
			end
			top = solid.Y1
		end
		local below = self:_topAt(px, top - 0.3, true)
		local bottomY = below or abyss
		if top - bottomY >= 2 then
			self:Pillar(px, top, bottomY, { Z = if below then -4 else -2.4 })
		end
	end
end

--- Requisiten auf der hinteren Spurhälfte eines Laufs.
function MapBuilder:_propsRun(run)
	local kinds = self.Theme.Props
	if type(kinds) ~= "table" or #kinds == 0 then
		return
	end
	if run.X2 - run.X1 < 10 then
		return
	end
	local rng = self.Rng
	local spacing = self:_t("PropSpacing")
	local x = run.X1 + rng:NextNumber(2.5, math.max(3, spacing * 0.6))
	while x < run.X2 - 2.5 do
		if not self:_isReserved(x - 2, x + 2) then
			local clearance = self:_clearanceAt(x, run.Y)
			local start = rng:NextInteger(1, #kinds)
			for k = 0, #kinds - 1 do
				local kind = kinds[(start + k - 1) % #kinds + 1]
				local tall = PROP_HEIGHT[kind] or 3
				local isLight = kind == "Lamp" or kind == "Torch"
				if tall + 0.5 <= clearance and not (isLight and x - self.LastLampX < 34) then
					if isLight then
						self.LastLampX = x
					end
					self:Prop(kind, x, run.Y, -rng:NextNumber(3.6, 4.5))
					break
				end
			end
		end
		x += spacing * rng:NextNumber(0.75, 1.3)
	end
end

--- Verziert alle aufgezeichneten Böden und Rampen.
function MapBuilder:_dressPlatforms()
	local runs = self:_collectRuns()
	for _, run in runs do
		self:_dressRun(run)
	end
	for _, ramp in self.Ramps do
		self:_dressRamp(ramp)
	end
	if self.AutoSupports ~= false then
		for _, run in runs do
			self:_supportRun(run)
		end
	end
	if self.AutoProps ~= false then
		for _, run in runs do
			self:_propsRun(run)
		end
	end
end

------------------------------------------------------------------------
-- Hintergründe (Parallax-Ebenen aus Parts + Terrain)
------------------------------------------------------------------------

local BILLBOARD_TEXTS = { "VELOCITY RUSH", "NEON NIGHTS", "GO FAST!", "SPEED CITY" }

function MapBuilder:_decorCity()
	local theme, rng = self.Theme, self.Rng
	local back = theme.Backdrop or {}
	local terrain = theme.Terrain or {}
	local lights = back.Lights or { theme.Accent, theme.Accent2 }
	local _, hi = self:_floorRange()
	local base = self.MinY - 60
	-- Terrain: Stadtboden, Bucht, gegenüberliegendes Ufer
	self:_terrainStrip(-24, -250, base - 8, base, terrain.Ground or M.Asphalt)
	self:_terrainStrip(-250, -320, base - 10, base - 3, terrain.Liquid or M.Water)
	self:_terrainStrip(-320, -390, base - 8, base + 2, terrain.Top or M.Concrete)
	-- Nahe Häuserzeile
	local x, xEnd = self:_span(-50)
	while x < xEnd do
		local w = rng:NextNumber(16, 30)
		local d = rng:NextNumber(14, 24)
		local front = -rng:NextNumber(24, 44)
		local top = hi + rng:NextNumber(-25, 75)
		self:Building(x + w / 2, front - d / 2, base, w, top - base, d, {
			Color = jitter(rng, back.Near or rgb(34, 34, 60), 0.18),
			Material = if rng:NextNumber() < 0.3 then M.Glass else M.Concrete,
			Lights = lights,
		})
		x += w + rng:NextNumber(3, 9)
	end
	-- Mittlere Ebene: Türme
	x, xEnd = self:_span(-160)
	while x < xEnd do
		local w = rng:NextNumber(28, 52)
		local top = hi + rng:NextNumber(10, 200)
		self:Building(x + w / 2, -rng:NextNumber(135, 175), base, w, top - base, 30, {
			Color = jitter(rng, back.Mid or rgb(50, 44, 90), 0.1),
			Lights = lights,
			WindowStyle = if rng:NextNumber() < 0.6 then 2 else 1,
			Roof = rng:NextNumber() < 0.5,
		})
		x += w + rng:NextNumber(6, 24)
	end
	-- Ferne Skyline (Silhouetten)
	x, xEnd = self:_span(-350)
	while x < xEnd do
		local w = rng:NextNumber(50, 100)
		local h = (hi - base) + rng:NextNumber(60, 330)
		self:Deco(Vector3.new(w, h, 40), CFrame.new(self:W(x + w / 2, base + h / 2, -355)), jitter(rng, back.Far or rgb(74, 58, 120), 0.08), M.SmoothPlastic, { Name = "Skyline" })
		if rng:NextNumber() < 0.45 then
			self:Deco(Vector3.new(w * 0.7, 1.2, 0.3), CFrame.new(self:W(x + w / 2, base + h * rng:NextNumber(0.55, 0.92), -334.8)), lights[rng:NextInteger(1, #lights)], NEON, { Name = "SkylineLight", Transparency = 0.3 })
		end
		x += w + rng:NextNumber(4, 20)
	end
	-- Flugverkehr: lange Lichtspuren zwischen den Ebenen
	local laneX0, laneX1 = self:_span(-110)
	for _, lane in { { -96, hi + 36, lights[2] or theme.Accent }, { -104, hi + 54, lights[3] or theme.Accent2 }, { -112, hi + 18, lights[1] or theme.Accent } } do
		local sx = laneX0
		while sx < laneX1 do
			local segLen = math.min(1600, laneX1 - sx)
			self:Deco(Vector3.new(segLen, 0.4, 0.4), CFrame.new(self:W(sx + segLen / 2, lane[2], lane[1])), lane[3], NEON, { Name = "SkyLane", Transparency = 0.25 })
			sx += segLen
		end
	end
	-- Holo-Werbetafeln
	for i = 1, 3 do
		local bx = self.MinX + (self.MaxX - self.MinX) * (i - 0.5) / 3 + rng:NextNumber(-60, 60)
		local by = hi + rng:NextNumber(30, 55)
		local color = if i % 2 == 0 then theme.Accent2 or theme.Accent else theme.Accent
		self:Deco(Vector3.new(48, 24, 1.5), CFrame.new(self:W(bx, by, -92)), rgb(24, 24, 36), M.Metal, { Name = "Billboard" })
		local holo = self:Deco(Vector3.new(45, 21, 0.4), CFrame.new(self:W(bx, by, -91.1)), color, M.ForceField, { Name = "BillboardHolo" })
		self:Deco(Vector3.new(48.6, 0.5, 0.5), CFrame.new(self:W(bx, by - 12.3, -91.2)), color, NEON, { Name = "BillboardGlow" })
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Back
		gui.LightInfluence = 0
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 12
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(0.9, 0.7)
		label.Position = UDim2.fromScale(0.05, 0.15)
		label.Font = Enum.Font.LuckiestGuy
		label.TextScaled = true
		label.TextColor3 = WHITE
		label.TextStrokeColor3 = color
		label.TextStrokeTransparency = 0.2
		label.Text = BILLBOARD_TEXTS[(i - 1) % #BILLBOARD_TEXTS + 1]
		label.Parent = gui
		gui.Parent = holo
	end
end

--- Fabrikteil (Schornstein, Tank oder Halle) mit Fußpunkt y.
function MapBuilder:_factoryPiece(x: number, y: number, z: number)
	local theme, rng = self.Theme, self.Rng
	local roll = rng:NextNumber()
	if roll < 0.4 then
		local h = rng:NextNumber(40, 90)
		local d = rng:NextNumber(5, 8)
		local stack = self:Deco(Vector3.new(h, d, d), CFrame.new(self:W(x, y + h / 2, z)) * VERTICAL, rgb(150, 74, 56), M.Brick, { Name = "Smokestack", Shape = CYL })
		self:Deco(Vector3.new(1.2, d + 0.3, d + 0.3), CFrame.new(self:W(x, y + h * 0.86, z)) * VERTICAL, WHITE, M.SmoothPlastic, { Name = "StackBand", Shape = CYL })
		self:Deco(Vector3.new(1.2, d + 0.3, d + 0.3), CFrame.new(self:W(x, y + h * 0.94, z)) * VERTICAL, rgb(200, 40, 40), M.SmoothPlastic, { Name = "StackBand", Shape = CYL })
		self:Deco(Vector3.new(0.4, d * 0.7, d * 0.7), CFrame.new(self:W(x, y + h + 0.1, z)) * VERTICAL, theme.Accent, NEON, { Name = "StackGlow", Shape = CYL })
		local top = Instance.new("Attachment")
		top.Position = Vector3.new(h / 2, 0, 0)
		top.Parent = stack
		emitter(top, {
			Rate = 3,
			Lifetime = NumberRange.new(5, 8),
			Speed = NumberRange.new(5, 8),
			EmissionDirection = Enum.NormalId.Right,
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 4), NumberSequenceKeypoint.new(1, 14) }),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) }),
			Color = ColorSequence.new(rgb(70, 62, 60)),
			SpreadAngle = Vector2.new(10, 10),
			Acceleration = Vector3.new(4, 2, 0),
		})
	elseif roll < 0.7 then
		local d = rng:NextNumber(12, 20)
		local h = rng:NextNumber(14, 26)
		self:Deco(Vector3.new(h, d, d), CFrame.new(self:W(x, y + h / 2, z)) * VERTICAL, rgb(140, 128, 116), M.CorrodedMetal, { Name = "Tank", Shape = CYL })
		self:Deco(Vector3.new(d, d * 0.35, d), CFrame.new(self:W(x, y + h, z)), rgb(150, 138, 126), M.Metal, { Name = "TankDome", Mesh = SPHERE })
		self:Deco(Vector3.new(0.6, h * 0.7, 0.3), CFrame.new(self:W(x, y + h * 0.45, z + d / 2 + 0.05)), theme.Accent2 or theme.Accent, NEON, { Name = "TankGauge" })
	else
		local w = rng:NextNumber(22, 40)
		local h = rng:NextNumber(14, 24)
		self:Deco(Vector3.new(w, h, 16), CFrame.new(self:W(x, y + h / 2, z)), rgb(78, 64, 58), M.CorrodedMetal, { Name = "Hall" })
		self:Deco(Vector3.new(w * 0.8, 2.2, 0.3), CFrame.new(self:W(x, y + h * 0.6, z + 8.1)), theme.Accent, NEON, { Name = "HallWindows", Transparency = 0.1 })
		self:_triangle(x, y + h, w + 1, 5, 16, z, rgb(96, 70, 58), M.CorrodedMetal, false, "HallRoof")
	end
end

function MapBuilder:_decorIndustrial()
	local theme, rng = self.Theme, self.Rng
	local terrain = theme.Terrain or {}
	local lo, hi = self:_floorRange()
	local base = self.MinY - 30
	local lava = terrain.Liquid or M.CrackedLava
	local rock = terrain.Cliff or M.Basalt
	-- Lavasee über die gesamte Länge (tödlich)
	self:Hazard(self.MinX - 120, base - 8, self.MaxX + 120, base, "Lava", { Depth = 220 })
	-- Erstarrte Schollen auf dem See
	local x, xEnd = self.MinX - 100, self.MaxX + 100
	while x < xEnd do
		self:Deco(
			Vector3.new(rng:NextNumber(6, 18), 0.8, rng:NextNumber(4, 12)),
			CFrame.new(self:W(x, base + 0.1, -rng:NextNumber(8, 90))) * CFrame.Angles(0, math.rad(rng:NextNumber(0, 180)), 0),
			rgb(54, 40, 36),
			M.CrackedLava,
			{ Name = "LavaCrust" }
		)
		x += rng:NextNumber(20, 45)
	end
	-- Terrain: Lava jenseits der Gefahrenfläche
	self:_terrainStrip(-112, -470, base - 6.5, base - 0.5, lava)
	-- Basaltfelsen, die aus der Lava ragen, teils mit Fabrikbauten
	x, xEnd = self:_span(-70)
	while x < xEnd do
		local r = rng:NextNumber(8, 15)
		local z = -(r * 1.2 + rng:NextNumber(24, 80))
		self:TerrainBall(x, base - r * 1.1, z, r * 1.2, lava)
		self:TerrainBall(x, base + r * 0.4, z, r, rock)
		self:TerrainBall(x + rng:NextNumber(-3, 3), base + r * 1.3, z, r * 0.7, rock)
		self:TerrainBall(x + rng:NextNumber(-2, 2), base + r * 1.9, z, r * 0.42, rock)
		if rng:NextNumber() < 0.5 then
			self:_factoryPiece(x, base + r * 2.2, z)
		end
		x += rng:NextNumber(60, 120)
	end
	-- Fabrikbauten im Lavasee
	x, xEnd = self:_span(-110)
	while x < xEnd do
		self:_factoryPiece(x, base, -rng:NextNumber(70, 130))
		x += rng:NextNumber(90, 150)
	end
	-- Rohrbrücken knapp hinter der Spur mit Stützen bis in die Lava
	x, xEnd = self.MinX - 60, self.MaxX + 60
	while x < xEnd do
		local len = rng:NextNumber(40, 80)
		local py = rng:NextNumber(lo - 10, hi + 25)
		local d = rng:NextNumber(2.2, 3.4)
		local pz = -rng:NextNumber(16, 26)
		self:Deco(Vector3.new(len, d, d), CFrame.new(self:W(x + len / 2, py, pz)), rgb(124, 108, 92), M.Metal, { Name = "Pipe", Shape = CYL })
		for _, fx in { x + 2, x + len - 2 } do
			self:Deco(Vector3.new(0.8, d + 0.6, d + 0.6), CFrame.new(self:W(fx, py, pz)), rgb(90, 76, 64), M.Metal, { Name = "PipeFlange", Shape = CYL })
			self:Deco(Vector3.new(1.2, py - base, 1.2), CFrame.new(self:W(fx, (py + base) / 2, pz - d / 2 - 0.8)), self:_t("Support"), self:_t("SupportMaterial"), { Name = "PipeLeg" })
		end
		x += rng:NextNumber(90, 150)
	end
	-- Vulkane am Horizont
	x, xEnd = self:_span(-440)
	x += rng:NextNumber(0, 150)
	while x < xEnd do
		local r = rng:NextNumber(55, 80)
		local z = -rng:NextNumber(420, 460)
		self:TerrainBall(x, base - r * 0.1, z, r, rock)
		self:TerrainBall(x + rng:NextNumber(-10, 10), base + r * 0.75, z, r * 0.55, terrain.Peak or rock)
		self:TerrainBall(x, base + r * 1.15, z, r * 0.22, lava)
		local smoke = self:Deco(Vector3.new(8, 2, 8), CFrame.new(self:W(x, base + r * 1.3, z)), WHITE, nil, { Name = "VolcanoSmoke", Transparency = 1 })
		emitter(smoke, {
			Rate = 2,
			Lifetime = NumberRange.new(10, 14),
			Speed = NumberRange.new(6, 10),
			EmissionDirection = Enum.NormalId.Top,
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 12), NumberSequenceKeypoint.new(1, 40) }),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) }),
			Color = ColorSequence.new(rgb(70, 60, 58)),
			SpreadAngle = Vector2.new(8, 8),
			Acceleration = Vector3.new(3, 1, 0),
		})
		x += rng:NextNumber(240, 360)
	end
	-- Glut über der Lava
	x = self.MinX
	while x < self.MaxX do
		local holder = self:Deco(Vector3.new(120, 1, 40), CFrame.new(self:W(x + 60, base + 1, -10)), Color3.new(), nil, { Name = "EmberField", Transparency = 1 })
		emitter(holder, {
			Rate = 8,
			Lifetime = NumberRange.new(2, 4),
			Speed = NumberRange.new(4, 9),
			EmissionDirection = Enum.NormalId.Top,
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0) }),
			Color = ColorSequence.new(theme.Accent),
			LightEmission = 1,
			SpreadAngle = Vector2.new(20, 20),
		})
		x += 140
	end
end

--- Ruinen, Bäume und Wasserfälle auf einer Hintergrund-Insel.
function MapBuilder:_islandRuins(x: number, top: number, z: number, r: number, treeScale)
	local rng = self.Rng
	local marble = rgb(238, 232, 220)
	if rng:NextNumber() < 0.5 then
		for _ = 1, rng:NextInteger(2, 3) do
			local cx = x + rng:NextNumber(-r * 0.55, r * 0.55)
			local h = rng:NextNumber(0.35, 0.9) * r
			self:Deco(Vector3.new(h, r * 0.14, r * 0.14), CFrame.new(self:W(cx, top + h / 2, z + rng:NextNumber(-r * 0.3, r * 0.3))) * VERTICAL, marble, M.Marble, { Name = "RuinColumn", Shape = CYL })
		end
	end
	if rng:NextNumber() < 0.55 then
		self:Tree(x + rng:NextNumber(-r * 0.4, r * 0.4), top - 0.5, z, { Kind = "Round", Scale = rng:NextNumber(treeScale[1], treeScale[2]) })
	end
	if rng:NextNumber() < 0.18 then
		self:Waterfall(x + r * 0.5, top - 1, z + r * 0.75, r * 0.2, r * 2.6)
	end
end

function MapBuilder:_decorSky()
	local theme, rng = self.Theme, self.Rng
	local back = theme.Backdrop or {}
	local terrain = theme.Terrain or {}
	local lo, hi = self:_floorRange()
	local seaY = self.MinY - 58
	-- Wolkenmeer in drei Tiefen (abgeflachte Ellipsoide)
	for _, row in {
		{ Z = -45, Step = { 40, 60 }, W = { 70, 110 }, H = { 22, 32 }, Color = back.Near or WHITE },
		{ Z = -140, Step = { 60, 90 }, W = { 110, 170 }, H = { 30, 44 }, Color = back.Mid or rgb(232, 240, 252) },
		{ Z = -300, Step = { 100, 140 }, W = { 180, 260 }, H = { 40, 60 }, Color = back.Far or rgb(214, 228, 248) },
	} do
		local x, xEnd = self:_span(row.Z)
		while x < xEnd do
			local w = rng:NextNumber(row.W[1], row.W[2])
			local h = rng:NextNumber(row.H[1], row.H[2])
			self:Deco(Vector3.new(w, h, w * 0.75), CFrame.new(self:W(x, seaY + rng:NextNumber(-4, 4), row.Z + rng:NextNumber(-8, 8))), row.Color, M.SmoothPlastic, { Name = "CloudSea", Mesh = SPHERE })
			x += rng:NextNumber(row.Step[1], row.Step[2])
		end
	end
	-- Schwebende Inseln (Terrain) in drei Tiefen
	for _, layer in {
		{ Z = { -80, -55 }, R = { 9, 16 }, Step = { 70, 120 }, Trees = { 1.1, 1.6 } },
		{ Z = { -180, -130 }, R = { 18, 30 }, Step = { 110, 170 }, Trees = { 1.8, 2.6 } },
		{ Z = { -380, -300 }, R = { 38, 60 }, Step = { 180, 280 } },
	} do
		local x, xEnd = self:_span(layer.Z[1])
		x += rng:NextNumber(0, layer.Step[1])
		while x < xEnd do
			local r = rng:NextNumber(layer.R[1], layer.R[2])
			local z = rng:NextNumber(layer.Z[1], layer.Z[2])
			local top = self:Island(x, rng:NextNumber(lo - 30, hi + 70), z, r)
			if layer.Trees then
				self:_islandRuins(x, top, z, r, layer.Trees)
			end
			x += rng:NextNumber(layer.Step[1], layer.Step[2])
		end
	end
	-- Felsnadeln am Horizont, die aus den Wolken ragen
	local x, xEnd = self:_span(-460)
	while x < xEnd do
		local w = rng:NextNumber(90, 150)
		self:Mountain(x, -rng:NextNumber(450, 480), seaY - 20, (hi - seaY) + rng:NextNumber(40, 160), w, { Style = "Peak", Material = terrain.Cliff or M.Limestone, Cap = terrain.Top, CapRatio = 0.12, Depth = 36 })
		x += w * rng:NextNumber(1.6, 2.8)
	end
	-- Vögel
	for _ = 1, 10 do
		local bx = rng:NextNumber(self.MinX, self.MaxX)
		local by = hi + rng:NextNumber(10, 70)
		local bz = -rng:NextNumber(40, 120)
		local s = rng:NextNumber(1.4, 2.4)
		for _, side in { -1, 1 } do
			self:Deco(Vector3.new(s, 0.18 * s, 0.18 * s), CFrame.new(self:W(bx + side * s * 0.42, by, bz)) * CFrame.Angles(0, 0, math.rad(22 * side)), rgb(60, 66, 80), M.SmoothPlastic, { Name = "Bird" })
		end
	end
end

function MapBuilder:_decorGlacier()
	local theme, rng = self.Theme, self.Rng
	local terrain = theme.Terrain or {}
	local lo, hi = self:_floorRange()
	local base = self.MinY - 40
	local snow = terrain.Top or M.Snow
	-- Eiswasser ganz unten (tödlich)
	self:Hazard(self.MinX - 120, base - 6, self.MaxX + 120, base, "IceWater", { Depth = 200 })
	-- Eisschollen auf dem Wasser
	local x, xEnd = self.MinX - 100, self.MaxX + 100
	while x < xEnd do
		self:Deco(
			Vector3.new(rng:NextNumber(5, 14), 0.8, rng:NextNumber(4, 10)),
			CFrame.new(self:W(x, base + 0.15, -rng:NextNumber(8, 90))) * CFrame.Angles(0, math.rad(rng:NextNumber(0, 180)), 0),
			rgb(232, 246, 255),
			M.Ice,
			{ Name = "IceFloe" }
		)
		x += rng:NextNumber(25, 50)
	end
	-- Terrain: Eisdecke hinter dem Wasser
	self:_terrainStrip(-102, -330, base - 8, base + 0.5, terrain.Cliff or M.Glacier)
	-- Nahe Schneehügel mit Tannen und Kristallen
	x, xEnd = self:_span(-60)
	while x < xEnd do
		local r = rng:NextNumber(16, 28)
		local z = -(r + rng:NextNumber(18, 46))
		local cy = base + rng:NextNumber(-8, 18)
		self:TerrainBall(x, cy, z, r, terrain.Ground or snow)
		local roll = rng:NextNumber()
		if roll < 0.5 then
			local dx = rng:NextNumber(-r * 0.3, r * 0.3)
			self:Tree(x + dx, cy + math.sqrt(r * r - dx * dx) - 1.5, z, { Kind = "Pine", Scale = rng:NextNumber(1.8, 2.8) })
		elseif roll < 0.7 then
			self:Prop("Crystal", x, cy + r - 1, z, { Scale = 2.2 })
		end
		x += rng:NextNumber(30, 55)
	end
	-- Gletscherkamm (Mitte) und hohe Gipfel am Horizont
	x, xEnd = self:_span(-200)
	while x < xEnd do
		local w = rng:NextNumber(90, 150)
		self:Mountain(x, -rng:NextNumber(175, 210), base - 10, (hi - base) + rng:NextNumber(10, 90), w, { Style = "Peak", Material = terrain.Cliff or M.Glacier, Cap = snow, Depth = 34, CapRatio = 0.35 })
		x += w * rng:NextNumber(0.5, 0.8)
	end
	x, xEnd = self:_span(-450)
	while x < xEnd do
		local w = rng:NextNumber(220, 340)
		self:Mountain(x, -rng:NextNumber(430, 470), base - 10, (hi - base) + rng:NextNumber(140, 320), w, { Style = "Peak", Material = terrain.Peak or M.Slate, Cap = snow, Depth = 30, CapRatio = 0.4 })
		x += w * rng:NextNumber(0.7, 1)
	end
	-- Schwebende Eiskristalle knapp hinter der Spur
	x = self.MinX
	while x < self.MaxX do
		local cy = rng:NextNumber(lo - 10, hi + 30)
		local cz = -rng:NextNumber(16, 40)
		local h = rng:NextNumber(5, 12)
		local tilt = CFrame.Angles(0, math.rad(45), math.rad(rng:NextNumber(-25, 25)))
		self:Deco(Vector3.new(1.4, h, 1.4), CFrame.new(self:W(x, cy, cz)) * tilt, rgb(150, 230, 255), M.Glass, { Name = "Crystal", Transparency = 0.25 })
		self:Deco(Vector3.new(0.5, h * 0.8, 0.5), CFrame.new(self:W(x, cy, cz)) * tilt, rgb(170, 240, 255), NEON, { Name = "CrystalCore", Transparency = 0.1 })
		x += rng:NextNumber(60, 110)
	end
	-- Schneefall
	x = self.MinX - 100
	while x < self.MaxX + 100 do
		local holder = self:Deco(Vector3.new(220, 1, 80), CFrame.new(self:W(x + 110, self.MaxY + 60, -20)), Color3.new(), nil, { Name = "SnowEmitter", Transparency = 1 })
		emitter(holder, {
			Rate = 30,
			Lifetime = NumberRange.new(6, 9),
			Speed = NumberRange.new(8, 12),
			EmissionDirection = Enum.NormalId.Bottom,
			Size = NumberSequence.new(0.35),
			Color = ColorSequence.new(rgb(255, 255, 255)),
			LightEmission = 0.3,
			SpreadAngle = Vector2.new(15, 15),
		})
		x += 220
	end
end

function MapBuilder:_decorJungle()
	local theme, rng = self.Theme, self.Rng
	local back = theme.Backdrop or {}
	local terrain = theme.Terrain or {}
	local lo, hi = self:_floorRange()
	local base = self.MinY - 36
	local leaf = self:_t("Leaf")
	local grass = terrain.Top or M.LeafyGrass
	-- Fluss ganz unten (tödlich)
	self:Hazard(self.MinX - 120, base - 6, self.MaxX + 120, base, "River", { Depth = 200 })
	-- Seerosen und Steine im Fluss
	local x, xEnd = self.MinX - 100, self.MaxX + 100
	while x < xEnd do
		if rng:NextNumber() < 0.6 then
			local pad = rng:NextNumber(2.5, 4.5)
			self:Deco(Vector3.new(0.2, pad, pad), CFrame.new(self:W(x, base + 0.1, -rng:NextNumber(8, 80))) * VERTICAL, rgb(78, 160, 70), M.Grass, { Name = "LilyPad", Shape = CYL })
		else
			local d = rng:NextNumber(3, 7)
			self:Deco(Vector3.new(d, d * 0.6, d * 0.8), CFrame.new(self:W(x, base, -rng:NextNumber(8, 80))) * CFrame.Angles(0, math.rad(rng:NextNumber(0, 90)), 0), rgb(110, 112, 100), M.Rock, { Name = "RiverRock" })
		end
		x += rng:NextNumber(24, 48)
	end
	-- Terrain: Fluss setzt sich fort, Ufer
	self:_terrainStrip(-102, -170, base - 8, base - 0.6, terrain.Liquid or M.Water)
	self:_terrainStrip(-170, -240, base - 8, base + 3, terrain.Ground or M.Mud)
	-- Nahe Hügel mit Urwaldriesen
	x, xEnd = self:_span(-70)
	while x < xEnd do
		local r = rng:NextNumber(14, 26)
		local z = -(r + rng:NextNumber(26, 56))
		local cy = base + rng:NextNumber(-6, 14)
		self:TerrainBall(x, cy, z, r, grass)
		if rng:NextNumber() < 0.55 then
			self:Tree(x, cy + r - 2, z, { Kind = "Jungle", Scale = rng:NextNumber(1.4, 2), Height = rng:NextNumber(14, 26) })
		end
		x += rng:NextNumber(34, 60)
	end
	-- Urwaldriesen direkt hinter der Spur (Kronendach)
	x, xEnd = self:_span(-25)
	while x < xEnd do
		local s = rng:NextNumber(2, 2.8)
		local crownY = hi + rng:NextNumber(-10, 30)
		self:Tree(x, base, -rng:NextNumber(18, 32), { Kind = "Jungle", Scale = s, Height = crownY - base, Leaf = jitter(rng, back.Near or leaf, 0.12) })
		x += rng:NextNumber(32, 52)
	end
	-- Felswände mit Wasserfällen (Mitte)
	x, xEnd = self:_span(-170)
	local falls = 0
	while x < xEnd do
		local w = rng:NextNumber(44, 70)
		local h = (hi - base) + rng:NextNumber(-10, 50)
		local z = -rng:NextNumber(150, 185)
		self:Mountain(x, z, base - 6, h, w, { Material = terrain.Cliff or M.Rock, Cap = grass })
		if falls < 4 and rng:NextNumber() < 0.3 then
			falls += 1
			self:Waterfall(x + w * 0.1, base - 6 + h * 0.85, z + w * 0.5, rng:NextNumber(4, 7), h * 0.85)
		end
		x += w * rng:NextNumber(1.1, 1.6)
	end
	-- Kalksteinberge am Horizont
	x, xEnd = self:_span(-430)
	while x < xEnd do
		local w = rng:NextNumber(120, 200)
		local h = (hi - base) + rng:NextNumber(80, 220)
		local z = -rng:NextNumber(420, 450)
		self:Mountain(x, z, base - 10, h, w, { Style = "Peak", Material = terrain.Peak or M.Ground, Cap = grass, CapRatio = 0.55, Depth = 34 })
		x += w * rng:NextNumber(0.6, 0.95)
	end
	-- Lianen zwischen den Bäumen
	x = self.MinX - 60
	while x < self.MaxX + 60 do
		local vineLen = rng:NextNumber(20, 50)
		local vy = self.MaxY + 40 - vineLen / 2
		self:Deco(Vector3.new(vineLen, 0.5, 0.5), CFrame.new(self:W(x + 4, vy, -8)) * VERTICAL, rgb(60, 120, 50), M.Grass, { Name = "Vine", Shape = CYL })
		for _ = 1, 2 do
			local d = rng:NextNumber(1, 1.8)
			self:Deco(Vector3.new(d, d, d), CFrame.new(self:W(x + 4 + rng:NextNumber(-0.6, 0.6), vy + rng:NextNumber(-vineLen / 2, vineLen / 2), -8)), jitter(rng, leaf, 0.15), M.Grass, { Name = "VineLeaf", Shape = BALL })
		end
		x += rng:NextNumber(60, 110)
	end
	-- Glühwürmchen
	x = self.MinX
	while x < self.MaxX do
		local holder = self:Deco(Vector3.new(150, 40, 30), CFrame.new(self:W(x + 75, lo + 20, -14)), Color3.new(), nil, { Name = "Fireflies", Transparency = 1 })
		emitter(holder, {
			Rate = 4,
			Lifetime = NumberRange.new(3, 5),
			Speed = NumberRange.new(0.5, 1.5),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.35), NumberSequenceKeypoint.new(1, 0) }),
			Color = ColorSequence.new(theme.Accent2 or theme.Accent),
			LightEmission = 1,
			SpreadAngle = Vector2.new(180, 180),
		})
		x += 160
	end
end

function MapBuilder:_decorHub()
	local theme, rng = self.Theme, self.Rng
	local back = theme.Backdrop or {}
	local terrain = theme.Terrain or {}
	local lights = back.Lights or { theme.Accent, theme.Accent2 }
	local _, hi = self:_floorRange()
	local base = self.MinY - 30
	-- Terrain: Platz, Bucht, ferne Hügel
	self:_terrainStrip(-24, -110, base - 6, base, terrain.Ground or M.Concrete)
	self:_terrainStrip(-110, -270, base - 10, base - 2, terrain.Liquid or M.Water)
	local x, xEnd = self:_span(-340)
	while x < xEnd do
		local w = rng:NextNumber(80, 140)
		self:Mountain(x, -rng:NextNumber(330, 360), base - 6, rng:NextNumber(40, 90), w, { Material = terrain.Cliff or M.Slate })
		x += w * 0.75
	end
	-- Nahe Türme mit Fenstern
	x, xEnd = self:_span(-60)
	while x < xEnd do
		local w = rng:NextNumber(16, 28)
		self:Building(x + w / 2, -rng:NextNumber(46, 80), base, w, (hi + rng:NextNumber(10, 110)) - base, 20, {
			Color = jitter(rng, back.Near or rgb(46, 46, 80), 0.15),
			Lights = lights,
		})
		x += w + rng:NextNumber(6, 16)
	end
	-- Ferne, helle Skyline am anderen Ufer
	x, xEnd = self:_span(-300)
	while x < xEnd do
		local w = rng:NextNumber(30, 60)
		local h = (hi - base) + rng:NextNumber(40, 200)
		self:Deco(Vector3.new(w, h, 24), CFrame.new(self:W(x + w / 2, base + h / 2, -295)), jitter(rng, back.Far or rgb(96, 84, 144), 0.08), M.SmoothPlastic, { Name = "Skyline" })
		if rng:NextNumber() < 0.4 then
			self:Deco(Vector3.new(0.8, h * 0.6, 0.3), CFrame.new(self:W(x + w / 2, base + h * 0.6, -282.8)), lights[rng:NextInteger(1, #lights)], NEON, { Name = "SkylineLight", Transparency = 0.3 })
		end
		x += w + rng:NextNumber(8, 24)
	end
	-- Holo-Ringe
	for i = 1, 6 do
		local color = if i % 2 == 0 then theme.Accent else theme.Accent2 or theme.Accent
		local pos = CFrame.new(self:W(-140 + i * 40, 60 + (i % 2) * 14, -30)) * FACING
		self:Deco(Vector3.new(0.4, 18, 18), pos, color, NEON, { Name = "HoloRing", Shape = CYL, Transparency = 0.55 })
		self:Deco(Vector3.new(0.3, 12, 12), pos * CFrame.new(-0.4, 0, 0), color, M.ForceField, { Name = "HoloRingCore", Shape = CYL, Transparency = 0.3 })
	end
	-- Lichtsäulen in den Himmel
	for i = 1, 4 do
		local lx = self.MinX + (self.MaxX - self.MinX) * (i - 0.5) / 4
		self:Deco(Vector3.new(2, 400, 2), CFrame.new(self:W(lx, base + 200, -140 - i * 20)), lights[(i - 1) % #lights + 1], NEON, { Name = "LightBeam", Transparency = 0.75 })
	end
end

--- Tribüne (Stufen mit bunten Sitzreihen, Dach, Flutlicht). z = vordere Kante.
function MapBuilder:_stand(x: number, z: number, baseY: number, width: number)
	local theme = self.Theme
	local seats = { theme.Accent, WHITE, theme.Accent2 or theme.Accent }
	for step = 0, 3 do
		local h = 3 + step * 3
		local sz = z - 2 - step * 4
		self:Deco(Vector3.new(width, h, 4), CFrame.new(self:W(x, baseY + h / 2, sz)), rgb(214, 218, 228), M.Concrete, { Name = "Stand" })
		self:Deco(Vector3.new(width - 1, 1, 0.8), CFrame.new(self:W(x, baseY + h + 0.5, sz + 1.2)), seats[step % 3 + 1], M.SmoothPlastic, { Name = "Seats" })
	end
	self:Deco(Vector3.new(width + 4, 1, 18), CFrame.new(self:W(x, baseY + 24, z - 9)), rgb(240, 242, 248), M.Metal, { Name = "StandRoof" })
	for _, side in { -1, 1 } do
		local mx = x + side * (width / 2 + 3)
		self:Deco(Vector3.new(34, 1, 1), CFrame.new(self:W(mx, baseY + 17, z - 16)) * VERTICAL, rgb(200, 204, 214), M.Metal, { Name = "FloodlightMast", Shape = CYL })
		self:Deco(Vector3.new(5, 3, 0.6), CFrame.new(self:W(mx, baseY + 35, z - 15.4)), rgb(255, 250, 230), NEON, { Name = "Floodlight" })
	end
end

function MapBuilder:_decorAcademy()
	local theme, rng = self.Theme, self.Rng
	local back = theme.Backdrop or {}
	local terrain = theme.Terrain or {}
	local _, hi = self:_floorRange()
	local base = self.MinY - 30
	local grass = terrain.Top or M.Grass
	-- Terrain: Wiese, See, Wiese, Hügel
	self:_terrainStrip(-22, -140, base - 6, base, grass)
	self:_terrainStrip(-140, -200, base - 8, base - 1, terrain.Liquid or M.Water)
	self:_terrainStrip(-200, -300, base - 6, base + 2, grass)
	local x, xEnd = self:_span(-80)
	while x < xEnd do
		local r = rng:NextNumber(14, 26)
		local z = -(r + rng:NextNumber(40, 80))
		local cy = base + rng:NextNumber(-12, 6)
		self:TerrainBall(x, cy, z, r, M.LeafyGrass)
		if rng:NextNumber() < 0.6 then
			self:Tree(x, cy + r - 1.5, z, { Kind = "Round", Scale = rng:NextNumber(1.6, 2.4) })
		end
		x += rng:NextNumber(40, 70)
	end
	x, xEnd = self:_span(-340)
	while x < xEnd do
		local w = rng:NextNumber(70, 120)
		self:Mountain(x, -rng:NextNumber(330, 360), base, rng:NextNumber(40, 90), w, { Material = M.LeafyGrass })
		x += w * 0.9
	end
	-- Tribünen und Bäume auf der Wiese
	for i = 1, 3 do
		self:_stand(self.MinX + (self.MaxX - self.MinX) * (i - 0.5) / 3, -40, base, rng:NextNumber(50, 70))
	end
	x = self.MinX - 40
	while x < self.MaxX + 40 do
		self:Tree(x, base, -rng:NextNumber(24, 34), { Kind = "Round", Scale = rng:NextNumber(1.6, 2.4) })
		x += rng:NextNumber(45, 80)
	end
	-- Fahnenreihe
	x = self.MinX
	local flip = false
	while x < self.MaxX do
		self:Banner(x, base, if flip then theme.Accent2 or theme.Accent else theme.Accent, { Height = 16, Width = 4, Z = -22, Color2 = WHITE })
		flip = not flip
		x += 90
	end
	-- Ferne, helle Skyline und Wolken
	x, xEnd = self:_span(-380)
	while x < xEnd do
		local w = rng:NextNumber(30, 70)
		local h = (hi - base) + rng:NextNumber(30, 180)
		self:Deco(Vector3.new(w, h, 30), CFrame.new(self:W(x + w / 2, base + h / 2, -385)), jitter(rng, back.Far or rgb(206, 222, 244), 0.06), M.SmoothPlastic, { Name = "Skyline" })
		x += w + rng:NextNumber(10, 40)
	end
	for _ = 1, 12 do
		self:Cloud(rng:NextNumber(self.MinX - 100, self.MaxX + 100), hi + rng:NextNumber(50, 120), -rng:NextNumber(160, 320), rng:NextNumber(2.5, 4.5), { Puffs = 4 })
	end
end

--- Erzeugt Bodenverzierung und Hintergrund passend zum Theme.
function MapBuilder:Decorate()
	if self.AutoDress ~= false then
		self:_dressPlatforms()
	end
	local kind = self.Theme.Decor
	if kind == "City" then
		self:_decorCity()
	elseif kind == "Industrial" then
		self:_decorIndustrial()
	elseif kind == "Sky" then
		self:_decorSky()
	elseif kind == "Glacier" then
		self:_decorGlacier()
	elseif kind == "Jungle" then
		self:_decorJungle()
	elseif kind == "Hub" then
		self:_decorHub()
	elseif kind == "Academy" then
		self:_decorAcademy()
	end
end

------------------------------------------------------------------------
-- Ergebnis
------------------------------------------------------------------------

--- Liefert die fertige MapInstance (Tabelle mit allen Laufzeitdaten).
--- TerrainFills: aufgezeichnete Terrain-Füllungen in Weltkoordinaten
--- ({Kind="Block"|"Wedge", CFrame, Size} | {Kind="Ball", Center, Radius} | {Kind="Cylinder", CFrame, Height, Radius}).
function MapBuilder:Result()
	local o = self.Origin
	return {
		RegionId = self.RegionId,
		MapId = self.MapId,
		Model = self.Model,
		Origin = o,
		StartX = o.X + self.StartLocalX,
		FinishX = if self.FinishLocalX then o.X + self.FinishLocalX else nil,
		KillY = o.Y + self.MinY - 20,
		Spawns = self.Spawns,
		Checkpoints = self.Checkpoints,
		TeleportNodes = self.TeleportNodes,
		PickupSpawns = self.PickupSpawns,
		Anchors = self.Anchors,
		Portals = self.Portals,
		HazardFolder = self.Folders.Hazards,
		PickupFolder = self.Folders.Pickups,
		RuntimeFolder = self.Folders.Runtime,
		TerrainFills = self.TerrainFills,
		Bounds = {
			MinX = o.X + self.MinX,
			MaxX = o.X + self.MaxX,
			MinY = o.Y + self.MinY,
			MaxY = o.Y + self.MaxY,
		},
	}
end

return MapBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[--[[
	RateLimiter  (ModuleScript)
	Pfad: ServerScriptService/Server/Modules/RateLimiter

	Token-Bucket pro Spieler. Begrenzt, wie oft ein Client ein Remote auslösen
	darf, ohne legitime Eingaben zu verwerfen.

	API:
		local limiter = RateLimiter.new(capacity, refillPerSecond)
		limiter:Check(player) -> boolean   (verbraucht ein Token)
		limiter:Remove(player)
		RateLimiter.ForRemote(name) -> limiter mit Werten aus Config.RateLimits
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local RateLimiter = {}
RateLimiter.__index = RateLimiter

local allLimiters = setmetatable({}, { __mode = "k" })

function RateLimiter.new(capacity: number, refillPerSecond: number)
	local self = setmetatable({
		Capacity = capacity,
		Refill = refillPerSecond,
		Buckets = {},
	}, RateLimiter)
	allLimiters[self] = true
	return self
end

function RateLimiter.ForRemote(name: string)
	local values = Config.RateLimits[name] or { 10, 5 }
	return RateLimiter.new(values[1], values[2])
end

function RateLimiter:Check(player: Player): boolean
	local now = os.clock()
	local bucket = self.Buckets[player]
	if not bucket then
		bucket = { Tokens = self.Capacity, Updated = now }
		self.Buckets[player] = bucket
	end
	bucket.Tokens = math.min(self.Capacity, bucket.Tokens + (now - bucket.Updated) * self.Refill)
	bucket.Updated = now
	if bucket.Tokens >= 1 then
		bucket.Tokens -= 1
		return true
	end
	if Config.Debug.LogRejections then
		warn(string.format("[RateLimiter] %s überschreitet das Limit", player.Name))
	end
	return false
end

function RateLimiter:Remove(player: Player)
	self.Buckets[player] = nil
end

Players.PlayerRemoving:Connect(function(player)
	for limiter in allLimiters do
		limiter:Remove(player)
	end
end)

return RateLimiter
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="21">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">AntiExploitService</string>
            <string name="Source"><![CDATA[--[[
	AntiExploitService  (ModuleScript)
	Pfad: ServerScriptService/Server/Services/AntiExploitService

	Serverseitige Plausibilitätsprüfungen der Bewegung. Spielfiguren werden vom
	Client simuliert (Network Ownership), daher prüft der Server:

		1. Geschwindigkeit über ein gleitendes Zeitfenster (Config.AntiExploit).
		   Das legitime Maximum (≈ 195 Studs/s: Greifhaken + Fall) liegt deutlich
		   unter dem Grenzwert, schnelle legitime Bewegungen werden nicht bestraft.
		   Bei Überschreitung: Rückversetzung an die letzte gültige Position.
		2. Tiefenachse: Spieler werden auf der Spielebene (Z = 0) gehalten.
		3. Eingefrorene Spieler (Countdown/Respawn) dürfen sich nicht entfernen.
		4. Wiederholte grobe Verstöße -> Kick (abschaltbar).

	Serverseitige Teleports (Respawn, Teleport Beacon, Rundenstart) gewähren
	eine kurze Toleranz über :GrantGrace().

	Weitere Schutzmaßnahmen liegen in den jeweiligen Services:
	Rate-Limits (RateLimiter), Greifhaken-Validierung (GrappleService),
	Item-Validierung (PowerUpService), Kauf-Validierung (ShopService),
	ausschließlich serverseitige Belohnungen (RewardService/EconomyService).

	Öffentliche API:
		:GrantGrace(player, seconds)
		:Tick(dt)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local AntiExploitService = {}

function AntiExploitService:Init(services)
	self.Services = services
	self.Tracks = {}
	self.Accumulator = 0
end

function AntiExploitService:Start() end

function AntiExploitService:OnPlayerRemoving(player: Player)
	self.Tracks[player] = nil
end

function AntiExploitService:_track(player: Player)
	local track = self.Tracks[player]
	if not track then
		track = { Samples = {}, Violations = 0, GraceUntil = 0, LastValid = nil, FrozenAt = nil }
		self.Tracks[player] = track
	end
	return track
end

function AntiExploitService:GrantGrace(player: Player, seconds: number)
	local track = self:_track(player)
	track.GraceUntil = math.max(track.GraceUntil, os.clock() + seconds)
	track.Samples = {}
	track.FrozenAt = nil
end

function AntiExploitService:_correct(player: Player, track, target: Vector3, reason: string, weight: number)
	track.Violations += weight
	warn(string.format("[AntiExploit] %s: %s (Verstöße: %.1f)", player.Name, reason, track.Violations))
	self.Services.CharacterService:Teleport(player, CFrame.lookAt(target, target + Vector3.new(1, 0, 0)))
	if Config.AntiExploit.KickEnabled and track.Violations >= Config.AntiExploit.KickThreshold then
		player:Kick("Ungewöhnliche Bewegungsdaten erkannt. Bitte trete erneut bei.")
	end
end

function AntiExploitService:Tick(dt: number)
	local settings = Config.AntiExploit
	self.Accumulator += dt
	if self.Accumulator < settings.SampleInterval then
		return
	end
	local elapsedTick = self.Accumulator
	self.Accumulator = 0
	local clock = os.clock()

	for _, player in Players:GetPlayers() do
		local root = self.Services.CharacterService:GetRoot(player)
		local track = self:_track(player)
		track.Violations = math.max(0, track.Violations - settings.ViolationDecayPerSecond * elapsedTick)
		if root then
			local position = root.Position
			local character = player.Character
			if clock < track.GraceUntil then
				track.Samples = { { T = clock, P = position } }
				track.LastValid = position
				track.FrozenAt = nil
			else
				local violated = false

				-- Eingefroren: Position muss stabil bleiben
				if character and character:GetAttribute("Frozen") then
					if not track.FrozenAt then
						track.FrozenAt = position
					elseif (position - track.FrozenAt).Magnitude > 6 then
						self:_correct(player, track, track.FrozenAt, "Bewegung trotz Einfrieren", 0.5)
						violated = true
					end
				else
					track.FrozenAt = nil
				end

				-- Geschwindigkeit über das Messfenster
				if not violated then
					table.insert(track.Samples, { T = clock, P = position })
					while #track.Samples > 2 and clock - track.Samples[2].T >= settings.Window do
						table.remove(track.Samples, 1)
					end
					local oldest = track.Samples[1]
					local elapsed = clock - oldest.T
					if elapsed >= 0.5 then
						local delta = position - oldest.P
						local distance = Vector2.new(delta.X, delta.Y).Magnitude
						if distance / elapsed > settings.MaxSpeed then
							local target = track.LastValid or oldest.P
							local weight = if distance / elapsed > settings.MaxSpeed * 3 then 3 else 1
							self:_correct(player, track, target, string.format("Geschwindigkeit %.0f Studs/s", distance / elapsed), weight)
							violated = true
						end
					end
				end

				if not violated then
					track.LastValid = position
					-- Tiefenachse korrigieren (keine Strafe, kann durch Physik passieren)
					if math.abs(position.Z - Config.World.PlaneZ) > settings.MaxZDrift then
						local fixed = Vector3.new(position.X, position.Y, Config.World.PlaneZ)
						self.Services.CharacterService:Teleport(player, CFrame.lookAt(fixed, fixed + Vector3.new(1, 0, 0)))
					end
				end
			end
		end
	end
end

return AntiExploitService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">CharacterService</string>
            <string name="Source"><![CDATA[--[[
	CharacterService  (ModuleScript)
	Pfad: ServerScriptService/Server/Services/CharacterService

	Verwaltet Spielfiguren:
		- legt beim Start StarterPlayer/StarterCharacter (RunnerRig) an
		- spawnt Spieler manuell (Players.CharacterAutoLoads = false)
		- setzt Spawn-/Respawnposition je nach Region (Lobby, Rennen, Training)
		- Teleports mit Anti-Exploit-Toleranz und Client-Benachrichtigung
		- Kosmetik und Namensschilder
		- Movement-Status (MoveState) aus Client-Meldungen übernehmen
		- Lobby-Portale und Absturzschutz in der Lobby

	Öffentliche API:
		:Spawn(player)
		:Teleport(player, cframe) -> boolean
		:SendToLobby(player)
		:GetRoot(player) -> BasePart?
		:GetRegion(player) -> string ("Lobby" | "Race" | Practice-RegionId)
		:GetSpawnCFrame(player) -> CFrame
		:SetFrozen(player, frozen)
		:ClearStatus(player)
		:ApplyCosmetics(player)
		.CharacterReady (Signal: player, character)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterPlayer = game:GetService("StarterPlayer")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Signal = require(Shared.Signal)
local Remotes = require(Shared.Remotes)
local RunnerRig = require(Shared.RunnerRig)
local CosmeticApplier = require(Shared.CosmeticApplier)
local CosmeticDefinitions = require(Shared.CosmeticDefinitions)
local Progression = require(Shared.Progression)

local RateLimiter = require(script.Parent.Parent.Modules.RateLimiter)

local CharacterService = {}
CharacterService.CharacterReady = Signal.new()

local VALID_STATES = {
	Idle = true,
	Run = true,
	Air = true,
	Slide = true,
	Wall = true,
	Grapple = true,
	Dash = true,
	Frozen = true,
	Stunned = true,
}

local STATUS_ATTRIBUTES = { "StunnedUntil", "SlowedUntil", "BoostUntil", "GrappleBoostUntil", "ShieldUntil" }

function CharacterService:Init(services)
	self.Services = services
	self.Spawning = {}
	self.PortalState = {} -- [player] = { Portal, Since, Fired }
	self.MoveLimiter = RateLimiter.ForRemote("MoveState")
	self.EmoteLimiter = RateLimiter.ForRemote("PlayEmote")
	self.RespawnLimiter = RateLimiter.ForRemote("RequestRespawn")

	Players.CharacterAutoLoads = false
	pcall(function()
		StarterPlayer.LoadCharacterAppearance = false
	end)
	local okStreaming, streaming = pcall(function()
		return workspace.StreamingEnabled
	end)
	self.Streaming = okStreaming and streaming == true
	if self.Streaming then
		warn("[CharacterService] Workspace.StreamingEnabled ist aktiv. Velocity Rush funktioniert, empfohlen ist aber StreamingEnabled = false (Workspace-Eigenschaften).")
	end

	local existing = StarterPlayer:FindFirstChild("StarterCharacter")
	if existing then
		existing:Destroy()
	end
	local rig = RunnerRig.Build({ ForCharacter = true })
	rig.Name = "StarterCharacter"
	rig.Parent = StarterPlayer
end

function CharacterService:Start()
	local data = self.Services.PlayerDataService

	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			self:_setupCharacter(player, character)
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end

	data.ProfileLoaded:Connect(function(player)
		self:Spawn(player)
	end)
	for _, player in Players:GetPlayers() do
		if data:GetProfile(player) and not player.Character then
			self:Spawn(player)
		end
	end

	Remotes.MoveState.OnServerEvent:Connect(function(player, state, facing)
		if not self.MoveLimiter:Check(player) then
			return
		end
		if type(state) ~= "string" or not VALID_STATES[state] then
			return
		end
		if facing ~= 1 and facing ~= -1 then
			facing = 1
		end
		local character = player.Character
		if character then
			character:SetAttribute("MoveState", state)
			character:SetAttribute("Facing", facing)
		end
	end)

	Remotes.PlayEmote.OnServerEvent:Connect(function(player)
		if not self.EmoteLimiter:Check(player) then
			return
		end
		self:_playEmote(player)
	end)

	Remotes.RequestRespawn.OnServerEvent:Connect(function(player)
		if not self.RespawnLimiter:Check(player) then
			return
		end
		local services = self.Services
		if services.RoundService:IsActiveRacer(player) then
			services.RoundService:RespawnRacer(player, "Manual")
		elseif services.PracticeService:GetCourse(player) then
			services.PracticeService:Reset(player)
		else
			self:SendToLobby(player)
		end
	end)
end

function CharacterService:OnPlayerRemoving(player: Player)
	self.Spawning[player] = nil
	self.PortalState[player] = nil
end

------------------------------------------------------------------------
-- Spawnen
------------------------------------------------------------------------

function CharacterService:Spawn(player: Player)
	if self.Spawning[player] or not player.Parent then
		return
	end
	self.Spawning[player] = true
	task.spawn(function()
		local ok, err = pcall(function()
			player:LoadCharacter()
		end)
		if not ok then
			warn("[CharacterService] LoadCharacter fehlgeschlagen: " .. tostring(err))
		end
		self.Spawning[player] = nil
	end)
end

function CharacterService:_setupCharacter(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not root then
		return
	end
	character:SetAttribute("MoveState", "Idle")
	character:SetAttribute("Facing", 1)
	character:SetAttribute("Frozen", false)
	character:SetAttribute("Grappling", false)
	character:SetAttribute("Emote", "")
	character:SetAttribute("Victory", "")
	for _, name in STATUS_ATTRIBUTES do
		character:SetAttribute(name, 0)
	end

	self:ApplyCosmetics(player)
	self:_nameTag(player, character)

	humanoid.Died:Connect(function()
		task.wait(1)
		if player.Parent and player.Character == character then
			self:Spawn(player)
		end
	end)

	local cframe = self:GetSpawnCFrame(player)
	self.Services.AntiExploitService:GrantGrace(player, 2.5)
	character:PivotTo(cframe)
	self.CharacterReady:Fire(player, character)
end

function CharacterService:_nameTag(player: Player, character: Model)
	local head = character:FindFirstChild("Head")
	if not head then
		return
	end
	local old = head:FindFirstChild("VR_NameTag")
	if old then
		old:Destroy()
	end
	local profile = self.Services.PlayerDataService:GetProfile(player)
	local gui = Instance.new("BillboardGui")
	gui.Name = "VR_NameTag"
	gui.Size = UDim2.fromOffset(160, 40)
	gui.StudsOffset = Vector3.new(0, 2.4, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 140
	gui.LightInfluence = 0
	gui.PlayerToHideFrom = player
	gui.ResetOnSpawn = false

	local name = Instance.new("TextLabel")
	name.Name = "PlayerName"
	name.BackgroundTransparency = 1
	name.Size = UDim2.fromScale(1, 0.6)
	name.Font = Enum.Font.GothamBlack
	name.TextScaled = true
	name.TextColor3 = Color3.fromRGB(255, 255, 255)
	name.TextStrokeTransparency = 0.4
	name.Text = player.DisplayName
	name.Parent = gui

	local info = Instance.new("TextLabel")
	info.Name = "Info"
	info.BackgroundTransparency = 1
	info.Position = UDim2.fromScale(0, 0.6)
	info.Size = UDim2.fromScale(1, 0.4)
	info.Font = Enum.Font.GothamBold
	info.TextScaled = true
	info.TextStrokeTransparency = 0.5
	if profile then
		local tier = Progression.GetTier(profile.Ranked.Rating)
		info.Text = string.format("Lv. %d · %s", profile.Level, tier.Name)
		info.TextColor3 = tier.Color
	else
		info.Text = ""
	end
	info.Parent = gui
	gui.Parent = head
end

------------------------------------------------------------------------
-- Positionen und Teleports
------------------------------------------------------------------------

function CharacterService:GetRoot(player: Player): BasePart?
	local character = player.Character
	if not character then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

function CharacterService:GetRegion(player: Player): string
	local services = self.Services
	if services.RoundService:IsActiveRacer(player) then
		return "Race"
	end
	local course = services.PracticeService:GetCourse(player)
	if course then
		return services.PracticeService:RegionIdFor(course)
	end
	return "Lobby"
end

function CharacterService:GetLobbySpawn(): CFrame
	local lobby = self.Services.MapService:GetRegion("Lobby")
	if lobby and #lobby.Spawns > 0 then
		return lobby.Spawns[math.random(1, #lobby.Spawns)]
	end
	return CFrame.new(Config.World.LobbyOrigin + Vector3.new(0, 5, 0))
end

function CharacterService:GetSpawnCFrame(player: Player): CFrame
	local services = self.Services
	local cframe = services.RoundService:GetRespawnCFrame(player)
	if cframe then
		return cframe
	end
	cframe = services.PracticeService:GetRespawnCFrame(player)
	if cframe then
		return cframe
	end
	return self:GetLobbySpawn()
end

--- Teleportiert die Spielfigur. Löst den Greifhaken und informiert den Client.
function CharacterService:Teleport(player: Player, cframe: CFrame): boolean
	local character = player.Character
	local root = self:GetRoot(player)
	if not character or not root then
		return false
	end
	self.Services.AntiExploitService:GrantGrace(player, Config.AntiExploit.TeleportGrace)
	self.Services.GrappleService:Release(player, true)
	character:SetAttribute("Emote", "")
	if self.Streaming then
		-- Zielbereich vorab zum Client streamen (blockiert den Aufrufer nicht)
		task.spawn(function()
			pcall(function()
				player:RequestStreamAroundAsync(cframe.Position, 3)
			end)
		end)
	end
	character:PivotTo(cframe)
	root.AssemblyLinearVelocity = Vector3.zero
	Remotes.GameEvent:FireClient(player, "Teleported", { Position = cframe.Position })
	return true
end

function CharacterService:SendToLobby(player: Player)
	if not self:Teleport(player, self:GetLobbySpawn()) then
		self:Spawn(player)
	end
end

function CharacterService:SetFrozen(player: Player, frozen: boolean)
	local character = player.Character
	if character then
		character:SetAttribute("Frozen", frozen)
	end
end

--- Setzt alle Power-up-Statuswerte zurück (z.B. nach Rundenende).
function CharacterService:ClearStatus(player: Player)
	local character = player.Character
	if not character then
		return
	end
	for _, name in STATUS_ATTRIBUTES do
		character:SetAttribute(name, 0)
	end
	character:SetAttribute("Victory", "")
	character:SetAttribute("Emote", "")
end

function CharacterService:ApplyCosmetics(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local equipped = self.Services.InventoryService:GetEquipped(player)
	CosmeticApplier.Apply(character, equipped)
	-- Kosmetik darf nie kollidieren (Sicherheitsnetz)
	for _, descendant in character:GetDescendants() do
		if descendant:IsA("BasePart") and descendant.Name ~= "VR_Collider" then
			descendant.CanCollide = false
			descendant.CanQuery = false
			descendant.CanTouch = false
			descendant.Massless = descendant.Name ~= "HumanoidRootPart"
			descendant.CollisionGroup = "RunnerBody"
		end
	end
end

function CharacterService:_playEmote(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local services = self.Services
	if services.RoundService:IsActiveRacer(player) and services.RoundService:GetPhase() == "Racing" then
		return
	end
	local equipped = services.InventoryService:GetEquipped(player)
	local emoteId = equipped.Emotes
	if not CosmeticDefinitions.Get("Emotes", emoteId) or not services.InventoryService:Owns(player, "Emotes", emoteId) then
		return
	end
	character:SetAttribute("Emote", emoteId)
	character:SetAttribute("EmoteAt", workspace:GetServerTimeNow())
end

------------------------------------------------------------------------
-- Tick (10 Hz, von Bootstrap aufgerufen)
------------------------------------------------------------------------

function CharacterService:Tick(_dt: number)
	local services = self.Services
	local lobby = services.MapService:GetRegion("Lobby")
	for _, player in Players:GetPlayers() do
		local profileLoaded = services.PlayerDataService:GetProfile(player) ~= nil
		local character = player.Character
		local root = self:GetRoot(player)
		if profileLoaded and (not character or not root or not character.Parent) then
			self:Spawn(player)
		elseif root and lobby and player:GetAttribute("InRace") ~= true and self:GetRegion(player) == "Lobby" then
			-- (Spieler mit InRace = true stehen noch auf der Strecke: Siegerehrung bzw.
			-- kurze Pause nach dem Ausscheiden – RoundService holt sie selbst zurück.)
			local position = root.Position
			if position.Y < lobby.KillY or math.abs(position.X - Config.World.LobbyOrigin.X) > 1500 then
				self:SendToLobby(player)
			else
				self:_checkPortals(player, lobby, position)
			end
		end
	end
end

function CharacterService:_checkPortals(player: Player, lobby, position: Vector3)
	local inside = nil
	for _, portal in lobby.Portals do
		if position.X >= portal.MinX and position.X <= portal.MaxX and position.Y >= portal.MinY and position.Y <= portal.MaxY then
			inside = portal
			break
		end
	end
	local state = self.PortalState[player]
	if not inside then
		self.PortalState[player] = nil
		return
	end
	if not state or state.Portal ~= inside then
		self.PortalState[player] = { Portal = inside, Since = os.clock(), Fired = false }
		return
	end
	if state.Fired or os.clock() - state.Since < 0.8 then
		return
	end
	state.Fired = true
	local services = self.Services
	if inside.Action == "QuickPlay" or inside.Action == "Ranked" then
		local ok, message = services.MatchmakingService:Join(player, inside.Action)
		Remotes.GameEvent:FireClient(player, "Notify", {
			Text = if ok then "Warteschlange beigetreten." else message,
			Kind = if ok then "Success" else "Warning",
		})
	elseif inside.Action == "Practice" then
		Remotes.GameEvent:FireClient(player, "OpenScreen", { Screen = "Practice" })
	end
end

return CharacterService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--[[
	EconomyService  (ModuleScript)
	Pfad: ServerScriptService/Server/Services/EconomyService

	Alle Coin- und XP-Transaktionen laufen ausschließlich hier über den Server.
	Clients können Guthaben weder setzen noch direkt verändern.

	Öffentliche API:
		:GetCoins(player) -> number
		:AddCoins(player, amount, reason) -> boolean
		:TrySpend(player, amount, reason) -> (boolean, string?)
		:AddXP(player, amount, reason) -> { LevelsGained, NewLevel, BonusCoins }
		:UpdateLeaderstats(player)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Progression = require(Shared.Progression)
local Remotes = require(Shared.Remotes)

local EconomyService = {}

local function validAmount(amount: any): boolean
	return type(amount) == "number"
		and amount == amount
		and amount >= 0
		and amount <= Config.Economy.MaxTransaction
		and math.floor(amount) == amount
end

function EconomyService:Init(services)
	self.Services = services
	self.Log = {} -- [player] = { {Time, Kind, Amount, Reason}, ... } (letzte 30)
end

function EconomyService:Start()
	self.Services.PlayerDataService.ProfileLoaded:Connect(function(player)
		self:UpdateLeaderstats(player)
	end)
end

function EconomyService:OnPlayerRemoving(player: Player)
	self.Log[player] = nil
end

function EconomyService:_log(player: Player, kind: string, amount: number, reason: string?)
	local log = self.Log[player]
	if not log then
		log = {}
		self.Log[player] = log
	end
	table.insert(log, { Time = os.time(), Kind = kind, Amount = amount, Reason = reason or "?" })
	if #log > 30 then
		table.remove(log, 1)
	end
end

function EconomyService:GetCoins(player: Player): number
	local profile = self.Services.PlayerDataService:GetProfile(player)
	return profile and profile.Coins or 0
end

function EconomyService:AddCoins(player: Player, amount: number, reason: string?): boolean
	if not validAmount(amount) then
		warn("[EconomyService] Ungültiger Betrag: " .. tostring(amount))
		return false
	end
	local data = self.Services.PlayerDataService
	local profile = data:GetProfile(player)
	if not profile then
		return false
	end
	profile.Coins = math.min(Config.Economy.MaxCoins, profile.Coins + amount)
	self:_log(player, "Add", amount, reason)
	data:MarkDirty(player)
	data:PushProfile(player)
	return true
end

function EconomyService:TrySpend(player: Player, amount: number, reason: string?): (boolean, string?)
	if not validAmount(amount) then
		return false, "Ungültiger Preis."
	end
	local data = self.Services.PlayerDataService
	local profile = data:GetProfile(player)
	if not profile then
		return false, "Profil noch nicht geladen."
	end
	if profile.Coins < amount then
		return false, string.format("Nicht genug Coins – dir fehlen %d.", amount - profile.Coins)
	end
	profile.Coins -= amount
	self:_log(player, "Spend", amount, reason)
	data:MarkDirty(player)
	data:PushProfile(player)
	return true
end

function EconomyService:AddXP(player: Player, amount: number, reason: string?)
	local result = { LevelsGained = 0, NewLevel = 1, BonusCoins = 0 }
	if not validAmount(amount) then
		return result
	end
	local data = self.Services.PlayerDataService
	local profile = data:GetProfile(player)
	if not profile then
		return result
	end
	local oldLevel = profile.Level
	profile.TotalXP += amount
	local newLevel = Progression.FromTotalXP(profile.TotalXP)
	profile.Level = newLevel
	result.NewLevel = newLevel
	if newLevel > oldLevel then
		result.LevelsGained = newLevel - oldLevel
		local bonus = 0
		for level = oldLevel + 1, newLevel do
			bonus += level * Config.Rewards.LevelUpCoinsPerLevel
		end
		result.BonusCoins = bonus
		profile.Coins = math.min(Config.Economy.MaxCoins, profile.Coins + bonus)
		self:_log(player, "LevelUp", bonus, "Level " .. newLevel)
		Remotes.GameEvent:FireClient(player, "LevelUp", { Level = newLevel, Coins = bonus })
		self:UpdateLeaderstats(player)
		local rewards = self.Services.RewardService
		if rewards then
			rewards:CheckAchievements(player)
		end
	end
	self:_log(player, "XP", amount, reason)
	data:MarkDirty(player)
	data:PushProfile(player)
	return result
end

--- Pflegt die Spielerliste (leaderstats: Level, Siege).
function EconomyService:UpdateLeaderstats(player: Player)
	local profile = self.Services.PlayerDataService:GetProfile(player)
	if not profile then
		return
	end
	local stats = player:FindFirstChild("leaderstats")
	if not stats then
		stats = Instance.new("Folder")
		stats.Name = "leaderstats"
		local level = Instance.new("IntValue")
		level.Name = "Level"
		level.Parent = stats
		local wins = Instance.new("IntValue")
		wins.Name = "Siege"
		wins.Parent = stats
		stats.Parent = player
	end
	stats.Level.Value = profile.Level
	stats.Siege.Value = profile.Stats.Wins
	player:SetAttribute("Level", profile.Level)
	player:SetAttribute("Rating", profile.Ranked.Rating)
	player:SetAttribute("Tier", Progression.GetTier(profile.Ranked.Rating).Name)
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">GrappleService</string>
            <string name="Source"><![CDATA[--[[
	GrappleService  (ModuleScript)
	Pfad: ServerScriptService/Server/Services/GrappleService

	Serverseitige Validierung des Greifhakens. Der Client simuliert das
	Schwingen sofort (Vorhersage, keine spürbare Latenz) und meldet das Ziel.
	Der Server prüft:
		- Anker existiert und gehört zur Region, in der sich der Spieler befindet
		- Distanz ≤ Reichweite (+ Upgrade) + Latenztoleranz
		- Spieler ist nicht eingefroren/betäubt
		- Mindestabstand zwischen zwei Ankoppelungen (Spam-Schutz)
	Bei Ablehnung erhält der Client "GrappleRejected" und löst sofort.
	Gültige Seile werden über Character-Attribute (Grappling, GrappleTarget)
	an alle Clients repliziert, damit jeder das Seil sieht.

	Öffentliche API:
		:RegisterAnchor(part, regionId) -> anchorId
		:UnregisterRegion(regionId)
		:Release(player, notifyClient)
		:IsGrappling(player) -> boolean
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local RateLimiter = require(script.Parent.Parent.Modules.RateLimiter)

local GrappleService = {}

function GrappleService:Init(services)
	self.Services = services
	self.Anchors = {} -- [id] = { Part, Region }
	self.NextId = 1
	self.Active = {} -- [player] = { AnchorId, Since }
	self.LastAttach = {}
	self.Limiter = RateLimiter.ForRemote("GrappleRequest")
end

function GrappleService:Start()
	Remotes.GrappleRequest.OnServerEvent:Connect(function(player, action, anchorId)
		if not self.Limiter:Check(player) then
			return
		end
		if action == "Release" then
			self:Release(player, false)
		elseif action == "Attach" then
			local ok, reason = self:_attach(player, anchorId)
			if not ok then
				if Config.Debug.LogRejections then
					warn(string.format("[GrappleService] %s abgelehnt: %s", player.Name, tostring(reason)))
				end
				Remotes.GameEvent:FireClient(player, "GrappleRejected", { Reason = reason })
			end
		end
	end)
end

function GrappleService:OnPlayerRemoving(player: Player)
	self.Active[player] = nil
	self.LastAttach[player] = nil
end

function GrappleService:RegisterAnchor(part: BasePart, regionId: string): number
	local id = self.NextId
	self.NextId += 1
	part:SetAttribute("AnchorId", id)
	part:SetAttribute("RegionId", regionId)
	CollectionService:AddTag(part, "GrappleAnchor")
	self.Anchors[id] = { Part = part, Region = regionId }
	return id
end

function GrappleService:UnregisterRegion(regionId: string)
	for id, anchor in self.Anchors do
		if anchor.Region == regionId then
			self.Anchors[id] = nil
			for player, active in self.Active do
				if active.AnchorId == id then
					self:Release(player, true)
				end
			end
		end
	end
end

function GrappleService:IsGrappling(player: Player): boolean
	return self.Active[player] ~= nil
end

function GrappleService:_attach(player: Player, anchorId: any): (boolean, string?)
	if type(anchorId) ~= "number" or anchorId ~= anchorId then
		return false, "InvalidId"
	end
	local anchor = self.Anchors[anchorId]
	if not anchor or not anchor.Part.Parent then
		return false, "UnknownAnchor"
	end
	local character = player.Character
	local root = self.Services.CharacterService:GetRoot(player)
	if not character or not root then
		return false, "NoCharacter"
	end
	if character:GetAttribute("Frozen") then
		return false, "Frozen"
	end
	local now = workspace:GetServerTimeNow()
	if (character:GetAttribute("StunnedUntil") or 0) > now then
		return false, "Stunned"
	end
	local region = self.Services.CharacterService:GetRegion(player)
	if anchor.Region ~= region then
		return false, "WrongRegion"
	end
	local last = self.LastAttach[player]
	if last and os.clock() - last < Config.Grapple.ServerMinInterval then
		return false, "TooFast"
	end
	local range = Config.Grapple.Range
	if (character:GetAttribute("GrappleBoostUntil") or 0) > now then
		range *= Config.Grapple.UpgradeRangeMultiplier
	end
	local distance = (root.Position - anchor.Part.Position).Magnitude
	if distance > range + Config.Grapple.ServerRangeTolerance then
		return false, "OutOfRange"
	end

	self.LastAttach[player] = os.clock()
	self.Active[player] = { AnchorId = anchorId, Since = os.clock() }
	character:SetAttribute("GrappleTarget", anchor.Part.Position)
	character:SetAttribute("Grappling", true)

	local inRace = region == "Race"
	self.Services.RewardService:OnGrapple(player, inRace)
	return true
end

--- Löst den Greifhaken. notifyClient=true erzwingt das Lösen auch auf dem Client.
function GrappleService:Release(player: Player, notifyClient: boolean?)
	local wasActive = self.Active[player] ~= nil
	self.Active[player] = nil
	local character = player.Character
	if character then
		character:SetAttribute("Grappling", false)
	end
	if notifyClient and (wasActive or character) and player.Parent then
		Remotes.GameEvent:FireClient(player, "GrappleForceRelease", {})
	end
end

return GrappleService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">HazardRingService</string>
            <string name="Source"><![CDATA[--[[
	HazardRingService  (ModuleScript)
	Pfad: ServerScriptService/Server/Services/HazardRingService

	Der "Gefahrenring" ist für das Side-Scrolling angepasst: eine Energiewand,
	die dem Führenden in einem festen Abstand folgt. Der Abstand ("Zonenlänge")
	schrumpft über die Zeit. Wer zu lange hinter der Wand ist, scheidet aus.

	Phasen (Zeit seit Rennstart, siehe Config.HazardZone):
		Safe       0 .. WarningStart         Wand inaktiv
		Warning    WarningStart .. ShrinkStart  Ankündigung, noch harmlos
		Shrinking  ShrinkStart .. +ShrinkDuration  Länge InitialLength -> FinalLength
		Final      danach                    Länge = FinalLength

	Fairness:
		- Die Wand bewegt sich nur vorwärts (nie zurück) und nie näher als
		  FinalLength an den Führenden heran -> der Führende ist nie in Gefahr.
		- Ausscheiden erst nach EliminationDelay Sekunden ununterbrochen hinter
		  der Wand; die Gefahrenzeit baut sich in Sicherheit wieder ab.
		- Serverautoritativ: nur der Server berechnet Position und Ausscheiden.

	Repliziert über ReplicatedStorage/GameState (Attribute):
		ZoneState, ZoneX, ZoneLength, ZoneWarnAt, ZoneShrinkAt
	und pro Rennfahrer DangerTime im Racer-Ordner.

	Öffentliche API:
		:Reset()
		:Begin(match)
		:Update(match, dt) -> { racer, ... }   (auszuscheidende Rennfahrer)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local HazardRingService = {}

function HazardRingService:Init(services)
	self.Services = services
	self.ZoneX = -math.huge
	self.Active = false
end

function HazardRingService:Start()
	self:Reset()
end

local function gameState()
	return ReplicatedStorage:FindFirstChild("GameState")
end

function HazardRingService:Reset()
	self.Active = false
	self.ZoneX = -math.huge
	local state = gameState()
	if state then
		state:SetAttribute("ZoneState", "Inactive")
		state:SetAttribute("ZoneX", -1e6)
		state:SetAttribute("ZoneLength", 0)
		state:SetAttribute("ZoneWarnAt", 0)
		state:SetAttribute("ZoneShrinkAt", 0)
	end
end

function HazardRingService:Begin(match)
	local zone = Config.HazardZone
	self.Active = true
	self.ZoneX = match.Map.StartX - 100
	local state = gameState()
	if state then
		state:SetAttribute("ZoneState", "Safe")
		state:SetAttribute("ZoneX", self.ZoneX)
		state:SetAttribute("ZoneLength", zone.InitialLength)
		state:SetAttribute("ZoneWarnAt", match.StartedAt + zone.WarningStart)
		state:SetAttribute("ZoneShrinkAt", match.StartedAt + zone.ShrinkStart)
	end
end

--- Aktualisiert die Wand und liefert alle Rennfahrer, die ausscheiden.
function HazardRingService:Update(match, dt: number)
	local eliminated = {}
	if not self.Active then
		return eliminated
	end
	local zone = Config.HazardZone
	local state = gameState()
	local elapsed = workspace:GetServerTimeNow() - match.StartedAt

	local phase
	local length
	if elapsed < zone.WarningStart then
		phase = "Safe"
		length = zone.InitialLength
	elseif elapsed < zone.ShrinkStart then
		phase = "Warning"
		length = zone.InitialLength
	else
		local t = math.clamp((elapsed - zone.ShrinkStart) / zone.ShrinkDuration, 0, 1)
		length = zone.InitialLength + (zone.FinalLength - zone.InitialLength) * t
		phase = if t >= 1 then "Final" else "Shrinking"
	end

	-- Führenden bestimmen (nur aktive Rennfahrer mit Spielfigur)
	local leaderX = nil
	for _, racer in match.RacerList do
		if racer.Status == "Racing" and racer.LastPosition then
			if not leaderX or racer.LastPosition.X > leaderX then
				leaderX = racer.LastPosition.X
			end
		end
	end

	if phase == "Shrinking" or phase == "Final" then
		if leaderX then
			local candidate = leaderX - length
			if match.Map.FinishX then
				candidate = math.min(candidate, match.Map.FinishX - 10)
			end
			self.ZoneX = math.max(self.ZoneX, candidate)
		end
		for _, racer in match.RacerList do
			if racer.Status == "Racing" then
				local position = racer.LastPosition
				if position and position.X < self.ZoneX then
					racer.DangerTime += dt
				else
					racer.DangerTime = math.max(0, racer.DangerTime - dt * zone.RecoveryRate)
				end
				if racer.DangerTime >= zone.EliminationDelay then
					table.insert(eliminated, racer)
				end
			end
		end
	end

	if state then
		state:SetAttribute("ZoneState", phase)
		state:SetAttribute("ZoneLength", math.floor(length))
		if phase == "Shrinking" or phase == "Final" then
			state:SetAttribute("ZoneX", math.floor(self.ZoneX * 10) / 10)
		end
	end
	return eliminated
end

return HazardRingService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">InventoryService</string>
            <string name="Source"><![CDATA[--[[
	InventoryService  (ModuleScript)
	Pfad: ServerScriptService/Server/Services/InventoryService

	Besitz und Ausrüstung kosmetischer Gegenstände. Jede Änderung wird
	serverseitig gegen CosmeticDefinitions validiert.

	Öffentliche API:
		:Owns(player, category, id) -> boolean
		:Grant(player, category, id) -> boolean        (nur intern, z.B. nach Kauf)
		:Equip(player, category, id) -> (boolean, string?)
		:Unequip(player, category) -> (boolean, string?)
		:GetEquipped(player) -> table
		:CountOwned(player) -> number
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local CosmeticDefinitions = require(Shared.CosmeticDefinitions)
local Util = require(Shared.Util)

local InventoryService = {}

function InventoryService:Init(services)
	self.Services = services
end

function InventoryService:Start() end

function InventoryService:Owns(player: Player, category: string, id: string): boolean
	local profile = self.Services.PlayerDataService:GetProfile(player)
	if not profile or not CosmeticDefinitions.IsCategory(category) then
		return false
	end
	local owned = profile.Owned[category]
	return owned ~= nil and owned[id] == true
end

function InventoryService:Grant(player: Player, category: string, id: string): boolean
	local data = self.Services.PlayerDataService
	local profile = data:GetProfile(player)
	if not profile or not CosmeticDefinitions.Get(category, id) then
		return false
	end
	profile.Owned[category][id] = true
	data:MarkDirty(player)
	data:PushProfile(player)
	return true
end

function InventoryService:Equip(player: Player, category: string, id: string): (boolean, string?)
	if not CosmeticDefinitions.IsCategory(category) or type(id) ~= "string" then
		return false, "Ungültige Anfrage."
	end
	if not CosmeticDefinitions.Get(category, id) then
		return false, "Dieses Item existiert nicht."
	end
	if not self:Owns(player, category, id) then
		return false, "Du besitzt dieses Item noch nicht."
	end
	local data = self.Services.PlayerDataService
	local profile = data:GetProfile(player)
	profile.Equipped[category] = id
	data:MarkDirty(player)
	data:PushProfile(player)
	self.Services.CharacterService:ApplyCosmetics(player)
	return true
end

function InventoryService:Unequip(player: Player, category: string): (boolean, string?)
	if not CosmeticDefinitions.IsCategory(category) then
		return false, "Ungültige Kategorie."
	end
	if not CosmeticDefinitions.Unequippable[category] then
		return false, "In dieser Kategorie muss immer etwas ausgerüstet sein."
	end
	local data = self.Services.PlayerDataService
	local profile = data:GetProfile(player)
	if not profile then
		return false, "Profil noch nicht geladen."
	end
	profile.Equipped[category] = ""
	data:MarkDirty(player)
	data:PushProfile(player)
	self.Services.CharacterService:ApplyCosmetics(player)
	return true
end

function InventoryService:GetEquipped(player: Player)
	local profile = self.Services.PlayerDataService:GetProfile(player)
	if not profile then
		return Util.DeepCopy(CosmeticDefinitions.DefaultEquipped)
	end
	return profile.Equipped
end

function InventoryService:CountOwned(player: Player): number
	local profile = self.Services.PlayerDataService:GetProfile(player)
	if not profile then
		return 0
	end
	local count = 0
	for _, owned in profile.Owned do
		count += Util.Count(owned)
	end
	return count
end

return InventoryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--[[
	LeaderboardService  (ModuleScript)
	Pfad: ServerScriptService/Server/Services/LeaderboardService

	Globale Bestenlisten mit OrderedDataStore:
		- Siege (gesamt)
		- Ranked-Rating der aktuellen Saison
	Schreibzugriffe nur nach Matchende (gebündelt, asynchron), Lesezugriffe
	alle Config.Leaderboard.RefreshInterval Sekunden mit Cache.

	RemoteFunction "GetLeaderboard" liefert:
		{ Wins = {...}, Rating = {...}, Server = {...}, Available = boolean }
		Einträge: { Rank, UserId, Name, Value }

	Öffentliche API:
		:OnMatchEnded(match)
		:GetBoards() -> table
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local RateLimiter = require(script.Parent.Parent.Modules.RateLimiter)

local LeaderboardService = {}

function LeaderboardService:Init(services)
	self.Services = services
	self.Cache = { Wins = {}, Rating = {} }
	self.NameCache = {}
	self.Available = false
	self.Limiter = RateLimiter.ForRemote("GetLeaderboard")
	self.PendingWrites = {}
end

function LeaderboardService:Start()
	local data = self.Services.PlayerDataService
	if data:IsPersistent() then
		local ok = pcall(function()
			self.WinsStore = DataStoreService:GetOrderedDataStore(Config.Leaderboard.WinsStore)
			self.RatingStore = DataStoreService:GetOrderedDataStore(Config.Leaderboard.RatingStorePrefix .. tostring(Config.Ranked.Season))
		end)
		self.Available = ok
	end

	Remotes.GetLeaderboard.OnServerInvoke = function(player)
		if not self.Limiter:Check(player) then
			return nil
		end
		return self:GetBoards()
	end

	if self.Available then
		task.spawn(function()
			while true do
				self:_flushWrites()
				self:_refresh()
				task.wait(Config.Leaderboard.RefreshInterval)
			end
		end)
	end
end

function LeaderboardService:_name(userId: number): string
	local cached = self.NameCache[userId]
	if cached then
		return cached
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		self.NameCache[userId] = player.DisplayName
		return player.DisplayName
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local result = if ok and name then name else ("#" .. tostring(userId))
	self.NameCache[userId] = result
	return result
end

function LeaderboardService:_readStore(store)
	local entries = {}
	local ok, pages = pcall(function()
		return store:GetSortedAsync(false, Config.Leaderboard.Size)
	end)
	if not ok or not pages then
		return nil
	end
	local page = pages:GetCurrentPage()
	for rank, item in page do
		local userId = tonumber(item.key)
		if userId then
			table.insert(entries, { Rank = rank, UserId = userId, Name = self:_name(userId), Value = item.value })
		end
	end
	return entries
end

function LeaderboardService:_refresh()
	local wins = self:_readStore(self.WinsStore)
	if wins then
		self.Cache.Wins = wins
	end
	local rating = self:_readStore(self.RatingStore)
	if rating then
		self.Cache.Rating = rating
	end
end

function LeaderboardService:_flushWrites()
	local pending = self.PendingWrites
	self.PendingWrites = {}
	for userId, values in pending do
		pcall(function()
			self.WinsStore:SetAsync(tostring(userId), values.Wins)
		end)
		if values.Rating then
			pcall(function()
				self.RatingStore:SetAsync(tostring(userId), values.Rating)
			end)
		end
	end
end

--- Merkt Werte zum Schreiben vor (kein Yield – sicher aus dem Rundenende aufrufbar).
function LeaderboardService:OnMatchEnded(match)
	if not self.Available then
		return
	end
	for _, racer in match.RacerList do
		local player = racer.Player
		if player then
			local profile = self.Services.PlayerDataService:GetProfile(player)
			if profile then
				self.PendingWrites[player.UserId] = {
					Wins = profile.Stats.Wins,
					Rating = if match.Mode == "Ranked" then profile.Ranked.Rating else nil,
				}
			end
		end
	end
	task.delay(5, function()
		self:_flushWrites()
	end)
end

function LeaderboardService:GetBoards()
	local server = {}
	for _, player in Players:GetPlayers() do
		local profile = self.Services.PlayerDataService:GetProfile(player)
		if profile then
			table.insert(server, {
				UserId = player.UserId,
				Name = player.DisplayName,
				Level = profile.Level,
				Wins = profile.Stats.Wins,
				Rating = profile.Ranked.Rating,
			})
		end
	end
	table.sort(server, function(a, b)
		if a.Wins ~= b.Wins then
			return a.Wins > b.Wins
		end
		return a.Level > b.Level
	end)
	for rank, entry in server do
		entry.Rank = rank
		entry.Value = entry.Wins
	end
	return {
		Available = self.Available,
		Wins = self.Cache.Wins,
		Rating = self.Cache.Rating,
		Server = server,
	}
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">MapService</string>
            <string name="Source"><![CDATA[--[[
	MapService  (ModuleScript)
	Pfad: ServerScriptService/Server/Services/MapService

	Lädt, aktiviert, setzt zurück und entlädt Maps ("Regionen").
	Regionen:
		"Lobby"                 – immer geladen (Workspace/Lobby)
		"Race"                  – aktuelle Rennstrecke (Workspace/ActiveMap)
		"Tutorial"              – Trainings-Tutorial (Workspace/Practice)
		"Practice_<MapId>"      – Trainingskopien der Rennstrecken (Workspace/Practice)

	Jede Region ist eine MapInstance (siehe MapBuilder:Result()). Beim Laden
	werden Greifhaken-Anker und Item-Boxen bei den zuständigen Services
	registriert, beim Entladen wieder entfernt. Das Hintergrund-Terrain einer
	Region (MapInstance.TerrainFills) wird beim Entladen gelöscht, indem jede
	aufgezeichnete Füllung leicht vergrößert mit Luft überschrieben wird.

	Öffentliche API:
		:GetRegion(regionId) -> MapInstance?
		:LoadRaceMap(mapId) -> MapInstance
		:UnloadRaceMap()
		:ResetRaceMap()
		:EnsurePracticeRegion(courseId) -> MapInstance?
		:PeekNextMap() -> mapId
		:AdvanceRotation() -> mapId
		:IsInHazard(region, position, previous?) -> (boolean, string?)
		:FindCheckpointIndex(region, x) -> number
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local MapDefinitions = require(Shared.MapDefinitions)

local MapBuilder = require(script.Parent.Parent.Modules.MapBuilder)

local MapService = {}

local TERRAIN_ERASE_MARGIN = 4 -- eine Voxelbreite Reserve beim Löschen

function MapService:Init(services)
	self.Services = services
	self.Regions = {}
	self.Rotation = {}
	self.RotationIndex = 0
	self.Rng = Random.new()

	self.Folders = {}
	for _, name in { "Lobby", "ActiveMap", "Practice" } do
		local folder = workspace:FindFirstChild(name)
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = name
			folder.Parent = workspace
		end
		self.Folders[name] = folder
	end

	self.OverlapParams = OverlapParams.new()
	self.OverlapParams.FilterType = Enum.RaycastFilterType.Include
	self.OverlapParams.FilterDescendantsInstances = {}
end

function MapService:Start()
	self:_buildRegion("Lobby", MapDefinitions.Lobby, Config.World.LobbyOrigin, self.Folders.Lobby, "Lobby")
	self:_refillRotation()
	self:_publishNextMap()
end

------------------------------------------------------------------------
-- Aufbau
------------------------------------------------------------------------

function MapService:_buildRegion(regionId: string, definition, origin: Vector3, parent: Instance, mapId: string)
	local templateModule = ServerStorage:WaitForChild("MapTemplates"):FindFirstChild(definition.Template)
	if not templateModule then
		error("[MapService] Map-Vorlage fehlt: " .. tostring(definition.Template))
	end
	local template = require(templateModule)
	local builder = MapBuilder.new({
		Name = regionId,
		RegionId = regionId,
		MapId = mapId,
		Origin = origin,
		Theme = definition.Theme,
		Difficulty = definition.Difficulty or 2,
		Seed = definition.Seed or 1,
	})
	template(builder)
	local instance = builder:Result()
	instance.Definition = definition
	instance.Model.Parent = parent
	self.Regions[regionId] = instance

	for _, anchor in instance.Anchors do
		self.Services.GrappleService:RegisterAnchor(anchor, regionId)
	end
	self.Services.PowerUpService:RegisterRegion(instance)
	self:_rebuildOverlap()
	return instance
end

function MapService:_destroyRegion(regionId: string)
	local instance = self.Regions[regionId]
	if not instance then
		return
	end
	self.Services.GrappleService:UnregisterRegion(regionId)
	self.Services.PowerUpService:UnregisterRegion(regionId)
	self.Regions[regionId] = nil
	self:_eraseTerrain(instance)
	instance.Model:Destroy()
	self:_rebuildOverlap()
end

--- Löscht das Terrain einer Region: jede aufgezeichnete Füllung wird leicht
--- vergrößert mit Luft gefüllt (Keile über ihren umschließenden Quader).
function MapService:_eraseTerrain(instance)
	local fills = instance.TerrainFills
	if not fills or #fills == 0 then
		return
	end
	local terrain = workspace.Terrain
	local air = Enum.Material.Air
	local margin = TERRAIN_ERASE_MARGIN
	local grow = Vector3.new(margin * 2, margin * 2, margin * 2)
	for _, fill in fills do
		local ok, err = pcall(function()
			if fill.Kind == "Ball" then
				terrain:FillBall(fill.Center, fill.Radius + margin, air)
			elseif fill.Kind == "Cylinder" then
				terrain:FillCylinder(fill.CFrame, fill.Height + margin * 2, fill.Radius + margin, air)
			else
				terrain:FillBlock(fill.CFrame, fill.Size + grow, air)
			end
		end)
		if not ok then
			warn("[MapService] Terrain konnte nicht gelöscht werden: " .. tostring(err))
		end
	end
	instance.TerrainFills = {}
end

function MapService:_rebuildOverlap()
	local list = {}
	for _, instance in self.Regions do
		table.insert(list, instance.HazardFolder)
	end
	self.OverlapParams.FilterDescendantsInstances = list
end

------------------------------------------------------------------------
-- Öffentliche API
------------------------------------------------------------------------

function MapService:GetRegion(regionId: string)
	return self.Regions[regionId]
end

function MapService:GetRaceMap()
	return self.Regions.Race
end

--- Baut die Rennstrecke `mapId` in Workspace/ActiveMap (ersetzt eine vorhandene).
function MapService:LoadRaceMap(mapId: string)
	local definition = MapDefinitions.Get(mapId)
	if not definition then
		error("[MapService] Unbekannte Map: " .. tostring(mapId))
	end
	self:UnloadRaceMap()
	local instance = self:_buildRegion("Race", definition, Config.World.RaceOrigin, self.Folders.ActiveMap, mapId)
	return instance
end

function MapService:UnloadRaceMap()
	self:_destroyRegion("Race")
end

--- Setzt Laufzeitobjekte der Rennstrecke zurück (Fallen, Item-Boxen).
function MapService:ResetRaceMap()
	local instance = self.Regions.Race
	if instance then
		instance.RuntimeFolder:ClearAllChildren()
		self.Services.PowerUpService:ResetRegion("Race")
	end
end

--- Baut (falls nötig) die Trainingsregion für "Tutorial" oder eine Map-Id.
function MapService:EnsurePracticeRegion(courseId: string)
	local regionId = self.Services.PracticeService:RegionIdFor(courseId)
	if self.Regions[regionId] then
		return self.Regions[regionId]
	end
	if courseId == "Tutorial" then
		return self:_buildRegion(regionId, MapDefinitions.Tutorial, Config.World.TutorialOrigin, self.Folders.Practice, "Tutorial")
	end
	local definition = MapDefinitions.Get(courseId)
	if not definition then
		return nil
	end
	local index = table.find(MapDefinitions.Order, courseId) or 1
	local origin = Config.World.PracticeOriginStart - Vector3.new((index - 1) * Config.World.PracticeOriginSpacing, 0, 0)
	return self:_buildRegion(regionId, definition, origin, self.Folders.Practice, courseId)
end

function MapService:_refillRotation()
	self.Rotation = Util.Shuffle(table.clone(MapDefinitions.Order), self.Rng)
	self.RotationIndex = 1
end

function MapService:PeekNextMap(): string
	if self.RotationIndex < 1 or self.RotationIndex > #self.Rotation then
		self:_refillRotation()
	end
	return self.Rotation[self.RotationIndex]
end

--- Liefert die nächste Map und rückt die Rotation weiter.
function MapService:AdvanceRotation(): string
	local mapId = self:PeekNextMap()
	self.RotationIndex += 1
	if self.RotationIndex > #self.Rotation then
		local last = mapId
		self:_refillRotation()
		-- Dieselbe Map nicht zweimal hintereinander
		if self.Rotation[1] == last and #self.Rotation > 1 then
			self.Rotation[1], self.Rotation[2] = self.Rotation[2], self.Rotation[1]
		end
	end
	self:_publishNextMap()
	return mapId
end

function MapService:_publishNextMap()
	local state = ReplicatedStorage:FindFirstChild("GameState")
	if state then
		state:SetAttribute("NextMapId", self:PeekNextMap())
	end
end

local HAZARD_BOX = Vector3.new(1.6, 4.6, 1.6)

local function hazardActive(part: BasePart, now: number): boolean
	local period = part:GetAttribute("HazardPeriod")
	if not period then
		return true
	end
	local onTime = part:GetAttribute("HazardOnTime") or period / 2
	local offset = part:GetAttribute("HazardOffset") or 0
	return (now + offset) % period < onTime
end

--- Prüft, ob die Spielfigur (Root-Position) eine Gefahr der Region berührt.
--- Mit `previous` wird die Strecke seit dem letzten Tick geprüft, damit
--- schnelle Spieler dünne Barrieren nicht "überspringen".
function MapService:IsInHazard(region, position: Vector3, previous: Vector3?): (boolean, string?)
	if position.Y < region.KillY then
		return true, "Fall"
	end
	local from = previous or position
	local delta = position - from
	if delta.Magnitude > 40 then
		-- Teleport oder Respawn seit dem letzten Tick: nur aktuelle Position prüfen.
		from = position
		delta = Vector3.zero
	end
	-- Schneller Vorabtest mit einer Box um die gesamte Bewegung
	local center = (from + position) / 2
	local size = HAZARD_BOX + Vector3.new(math.abs(delta.X), math.abs(delta.Y), 0)
	local parts = workspace:GetPartBoundsInBox(CFrame.new(center), size, self.OverlapParams)
	if #parts == 0 then
		return false
	end
	local now = workspace:GetServerTimeNow()
	local candidates = {}
	for _, part in parts do
		if part:IsDescendantOf(region.HazardFolder) and hazardActive(part, now) then
			table.insert(candidates, part)
		end
	end
	if #candidates == 0 then
		return false
	end
	-- Genaue Prüfung entlang der Bewegung
	local steps = math.clamp(math.ceil(delta.Magnitude / 1.2), 1, 16)
	for i = 0, steps do
		local point = from:Lerp(position, i / steps)
		local half = HAZARD_BOX / 2
		for _, part in candidates do
			local localPoint = part.CFrame:PointToObjectSpace(point)
			local partHalf = part.Size / 2
			if
				math.abs(localPoint.X) <= partHalf.X + half.X
				and math.abs(localPoint.Y) <= partHalf.Y + half.Y
				and math.abs(localPoint.Z) <= partHalf.Z + half.Z
			then
				return true, part:GetAttribute("HazardKind")
			end
		end
	end
	return false
end

--- Index des letzten erreichten Checkpoints für eine X-Position.
function MapService:FindCheckpointIndex(region, x: number): number
	local index = 1
	for i, checkpoint in region.Checkpoints do
		if x >= checkpoint.X - 1 then
			index = i
		end
	end
	return index
end

return MapService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">MatchmakingService</string>
            <string name="Source"><![CDATA[--[[
	MatchmakingService  (ModuleScript)
	Pfad: ServerScriptService/Server/Services/MatchmakingService

	Warteschlangen innerhalb EINES Roblox-Servers (Quick Play und Ranked).
	Der RoundService fragt regelmäßig, ob eine Warteschlange startbereit ist,
	und entnimmt dann bis zu 8 Spieler.

	Quick Play: Reihenfolge des Beitritts (FIFO).
	Ranked:     Spieler werden nach Rating sortiert; gewählt wird das Fenster
	            mit der geringsten Rating-Spanne, das den am längsten wartenden
	            Spieler enthält (Matchmaking nach Spielstärke).

	Serverübergreifendes Matchmaking (MemoryStoreService + TeleportService) ist
	bewusst noch nicht aktiv – siehe README, Abschnitt "Nächste Schritte".

	Öffentliche API:
		:Join(player, mode) -> (boolean, string)
		:Leave(player)
		:IsQueued(player) -> mode?
		:GetCount(mode) -> number
		:GetReadyMode(minPlayers) -> mode?
		:TakePlayers(mode, max) -> { Player }
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Remotes = require(Shared.Remotes)

local RateLimiter = require(script.Parent.Parent.Modules.RateLimiter)

local MatchmakingService = {}

local MODES = { QuickPlay = true, Ranked = true }

function MatchmakingService:Init(services)
	self.Services = services
	self.Queues = { QuickPlay = {}, Ranked = {} }
	self.Limiter = RateLimiter.ForRemote("QueueRequest")
end

function MatchmakingService:Start()
	Remotes.QueueRequest.OnServerEvent:Connect(function(player, action, mode)
		if not self.Limiter:Check(player) then
			return
		end
		if action == "Join" then
			local ok, message = self:Join(player, mode)
			Remotes.GameEvent:FireClient(player, "Notify", {
				Text = message,
				Kind = if ok then "Success" else "Warning",
			})
		elseif action == "Leave" then
			if self:IsQueued(player) then
				self:Leave(player)
				Remotes.GameEvent:FireClient(player, "Notify", { Text = "Warteschlange verlassen.", Kind = "Info" })
			end
		end
	end)
	self:_publish()
end

function MatchmakingService:OnPlayerRemoving(player: Player)
	self:Leave(player)
end

function MatchmakingService:Join(player: Player, mode: any): (boolean, string)
	if type(mode) ~= "string" or not MODES[mode] then
		return false, "Ungültiger Spielmodus."
	end
	local services = self.Services
	if not services.PlayerDataService:GetProfile(player) then
		return false, "Dein Profil wird noch geladen."
	end
	if services.RoundService:IsInMatch(player) then
		return false, "Du bist bereits in einem Rennen."
	end
	if self:IsQueued(player) == mode then
		return true, "Du bist bereits in der Warteschlange."
	end
	self:_remove(player)
	table.insert(self.Queues[mode], { Player = player, JoinedAt = os.clock() })
	player:SetAttribute("Queue", mode)
	self:_publish()
	local label = if mode == "Ranked" then "Ranked" else "Schnelles Spiel"
	return true, label .. ": Warteschlange beigetreten."
end

function MatchmakingService:_remove(player: Player): boolean
	local removed = false
	for _, queue in self.Queues do
		for i = #queue, 1, -1 do
			if queue[i].Player == player then
				table.remove(queue, i)
				removed = true
			end
		end
	end
	return removed
end

function MatchmakingService:Leave(player: Player)
	self:_remove(player)
	if player.Parent then
		player:SetAttribute("Queue", "")
	end
	self:_publish()
end

function MatchmakingService:IsQueued(player: Player): string?
	for mode, queue in self.Queues do
		for _, entry in queue do
			if entry.Player == player then
				return mode
			end
		end
	end
	return nil
end

function MatchmakingService:GetCount(mode: string): number
	local queue = self.Queues[mode]
	return if queue then #queue else 0
end

--- Liefert den Modus, der zuerst starten sollte (genug Spieler, längste Wartezeit).
function MatchmakingService:GetReadyMode(minPlayers: number): string?
	local best, bestTime = nil, math.huge
	for mode, queue in self.Queues do
		if #queue >= minPlayers and queue[1].JoinedAt < bestTime then
			best = mode
			bestTime = queue[1].JoinedAt
		end
	end
	return best
end

function MatchmakingService:_rating(player: Player): number
	local profile = self.Services.PlayerDataService:GetProfile(player)
	return profile and profile.Ranked.Rating or 1000
end

--- Entnimmt bis zu `max` Spieler aus der Warteschlange.
function MatchmakingService:TakePlayers(mode: string, max: number): { Player }
	local queue = self.Queues[mode]
	if not queue or #queue == 0 then
		return {}
	end
	local chosen = {}
	if mode == "Ranked" and #queue > max then
		local oldest = queue[1]
		local sorted = table.clone(queue)
		table.sort(sorted, function(a, b)
			return self:_rating(a.Player) < self:_rating(b.Player)
		end)
		local oldestIndex = table.find(sorted, oldest) or 1
		local bestStart, bestSpread = 1, math.huge
		for start = math.max(1, oldestIndex - max + 1), math.min(oldestIndex, #sorted - max + 1) do
			local spread = self:_rating(sorted[start + max - 1].Player) - self:_rating(sorted[start].Player)
			if spread < bestSpread then
				bestSpread = spread
				bestStart = start
			end
		end
		for i = bestStart, bestStart + max - 1 do
			table.insert(chosen, sorted[i].Player)
		end
	else
		for i = 1, math.min(max, #queue) do
			table.insert(chosen, queue[i].Player)
		end
	end
	for _, player in chosen do
		self:_remove(player)
		player:SetAttribute("Queue", "")
	end
	self:_publish()
	return chosen
end

function MatchmakingService:_publish()
	local state = ReplicatedStorage:FindFirstChild("GameState")
	if state then
		state:SetAttribute("QueueQuickPlay", #self.Queues.QuickPlay)
		state:SetAttribute("QueueRanked", #self.Queues.Ranked)
	end
end

return MatchmakingService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">PlayerDataService</string>
            <string name="Source"><![CDATA[--[[
	PlayerDataService  (ModuleScript)
	Pfad: ServerScriptService/Server/Services/PlayerDataService

	Lädt und speichert Spielerprofile mit DataStoreService.

	- UpdateAsync mit einfachem Session-Lock (verhindert, dass zwei Server
	  gleichzeitig dasselbe Profil überschreiben).
	- Wiederholungsversuche mit exponentiellem Backoff.
	- Autosave alle Config.Data.AutosaveInterval Sekunden (nur wenn geändert).
	- Speichern beim Verlassen und beim Herunterfahren (BindToClose).
	- In Studio ohne API-Zugriff: Profile nur im Speicher (Hinweis an Spieler).
	- Profile werden nie pro Frame gespeichert.

	Öffentliche API:
		:GetProfile(player) -> table?        Live-Profil (nur serverseitig ändern!)
		:WaitForProfile(player, timeout) -> table?
		:MarkDirty(player)                   Änderungen zum Speichern vormerken
		:PushProfile(player)                 Schnappschuss an den Client senden
		:IsPersistent() -> boolean           false = Studio-Speichermodus
		:Release(player)                     Speichern + Freigeben beim Verlassen
		.ProfileLoaded (Signal: player, profile)
		.ProfileReleasing (Signal: player, profile)
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Signal = require(Shared.Signal)
local Remotes = require(Shared.Remotes)
local CosmeticDefinitions = require(Shared.CosmeticDefinitions)

local RateLimiter = require(script.Parent.Parent.Modules.RateLimiter)

local PlayerDataService = {}
PlayerDataService.ProfileLoaded = Signal.new()
PlayerDataService.ProfileReleasing = Signal.new()

local SCHEMA_VERSION = 1

local function defaultOwned()
	local owned = {}
	for _, category in CosmeticDefinitions.Categories do
		owned[category] = {}
		for _, item in CosmeticDefinitions.Items[category] do
			if item.Default then
				owned[category][item.Id] = true
			end
		end
	end
	return owned
end

local function buildTemplate()
	return {
		Version = SCHEMA_VERSION,
		Coins = Config.Economy.StartingCoins,
		TotalXP = 0,
		Level = 1,
		Stats = {
			Races = 0,
			Wins = 0,
			Top3 = 0,
			Finishes = 0,
			Eliminated = 0,
			Grapples = 0,
			PowerUps = 0,
			Distance = 0,
			FlawlessWins = 0,
			BestTimes = {},
		},
		Ranked = {
			Rating = Config.Ranked.StartRating,
			Season = Config.Ranked.Season,
			Games = 0,
			Wins = 0,
			Peak = Config.Ranked.StartRating,
		},
		Owned = defaultOwned(),
		Equipped = Util.DeepCopy(CosmeticDefinitions.DefaultEquipped),
		Quests = { Day = 0, List = {} },
		Achievements = {},
		Settings = {
			MusicVolume = 0.5,
			SfxVolume = 0.8,
			CameraShake = true,
			GamepadSensitivity = 1,
			TouchControls = true,
			AutoRequeue = true,
			ReducedEffects = false,
		},
		RecentMatches = {},
		CreatedAt = os.time(),
		LastJoin = os.time(),
	}
end

PlayerDataService.Template = buildTemplate()

--- Migration älterer Profile (Platz für zukünftige Schema-Versionen).
local function migrate(data)
	data.Version = data.Version or 1
	-- Beispiel: if data.Version < 2 then ... data.Version = 2 end
	Util.Reconcile(data, PlayerDataService.Template)
	for _, category in CosmeticDefinitions.Categories do
		if type(data.Owned[category]) ~= "table" then
			data.Owned[category] = {}
		end
		if type(data.Equipped[category]) ~= "string" then
			data.Equipped[category] = CosmeticDefinitions.DefaultEquipped[category]
		end
		for _, item in CosmeticDefinitions.Items[category] do
			if item.Default then
				data.Owned[category][item.Id] = true
			end
		end
	end
	return data
end

function PlayerDataService:Init(services)
	self.Services = services
	self.Profiles = {} -- [player] = { Data, Dirty, Key, Loaded }
	self.Persistent = true
	self.Store = nil
	self.ShuttingDown = false
	self.PushQueued = {}
	self.SettingsLimiter = RateLimiter.ForRemote("SaveSettings")
	self.GetLimiter = RateLimiter.ForRemote("GetProfile")

	local ok, store = pcall(function()
		return DataStoreService:GetDataStore(Config.Data.StoreName)
	end)
	if ok then
		self.Store = store
		-- Studio ohne API-Zugriff erkennen
		local probeOk, probeErr = pcall(function()
			store:GetAsync("__probe")
		end)
		if not probeOk then
			local message = tostring(probeErr)
			if Config.IsStudio or message:find("403") or message:find("Studio") or message:find("API") then
				warn("[PlayerDataService] DataStore nicht verfügbar – Profile werden nur im Speicher gehalten: " .. message)
				self.Persistent = false
			end
		end
	else
		warn("[PlayerDataService] GetDataStore fehlgeschlagen: " .. tostring(store))
		self.Persistent = false
	end
end

function PlayerDataService:Start()
	Players.PlayerAdded:Connect(function(player)
		self:_load(player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(function()
			self:_load(player)
		end)
	end
	Remotes.GetProfile.OnServerInvoke = function(player)
		if not self.GetLimiter:Check(player) then
			return nil
		end
		local profile = self:WaitForProfile(player, 15)
		if not profile then
			return nil
		end
		return self:_snapshot(player, profile)
	end

	Remotes.SaveSettings.OnServerEvent:Connect(function(player, settings)
		if not self.SettingsLimiter:Check(player) then
			return
		end
		self:_saveSettings(player, settings)
	end)

	task.spawn(function()
		while true do
			task.wait(Config.Data.AutosaveInterval)
			for player, entry in self.Profiles do
				if entry.Loaded and player.Parent then
					task.spawn(function()
						self:_save(player, false)
					end)
				end
			end
		end
	end)

	game:BindToClose(function()
		self.ShuttingDown = true
		local pending = 0
		for player, entry in self.Profiles do
			if entry.Loaded then
				pending += 1
				task.spawn(function()
					self:_save(player, true)
					pending -= 1
				end)
			end
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.2)
		end
	end)
end

------------------------------------------------------------------------
-- Öffentliche API
------------------------------------------------------------------------

function PlayerDataService:GetProfile(player: Player)
	local entry = self.Profiles[player]
	if entry and entry.Loaded then
		return entry.Data
	end
	return nil
end

function PlayerDataService:WaitForProfile(player: Player, timeout: number?)
	local deadline = os.clock() + (timeout or 20)
	while player.Parent and os.clock() < deadline do
		local profile = self:GetProfile(player)
		if profile then
			return profile
		end
		task.wait(0.1)
	end
	return self:GetProfile(player)
end

function PlayerDataService:MarkDirty(player: Player)
	local entry = self.Profiles[player]
	if entry then
		entry.Dirty = true
	end
end

function PlayerDataService:IsPersistent(): boolean
	return self.Persistent
end

--- Sendet einen Profil-Schnappschuss an den Client (mehrere Aufrufe werden gebündelt).
function PlayerDataService:PushProfile(player: Player)
	if self.PushQueued[player] then
		return
	end
	self.PushQueued[player] = true
	task.delay(0.15, function()
		self.PushQueued[player] = nil
		local profile = self:GetProfile(player)
		if profile and player.Parent then
			Remotes.ProfileUpdate:FireClient(player, self:_snapshot(player, profile))
		end
	end)
end

------------------------------------------------------------------------
-- Intern
------------------------------------------------------------------------

function PlayerDataService:_snapshot(_player: Player, profile)
	local snapshot = Util.DeepCopy(profile)
	snapshot.RecentMatches = nil
	snapshot._Lock = nil
	snapshot.Persistent = self.Persistent
	return snapshot
end

function PlayerDataService:_key(player: Player): string
	return Config.Data.KeyPrefix .. tostring(player.UserId)
end

function PlayerDataService:_load(player: Player)
	if self.Profiles[player] then
		return
	end
	local entry = { Data = nil, Dirty = false, Loaded = false, Key = self:_key(player) }
	self.Profiles[player] = entry

	local data
	if self.Persistent then
		data = self:_loadFromStore(player, entry.Key)
		if data == nil then
			if player.Parent then
				player:Kick("Deine Spieldaten konnten nicht geladen werden. Bitte versuche es gleich noch einmal.")
			end
			self.Profiles[player] = nil
			return
		end
	else
		data = buildTemplate()
	end

	if not player.Parent then
		-- Spieler hat während des Ladens verlassen: Lock freigeben, nichts behalten.
		if self.Persistent then
			entry.Data = data
			entry.Loaded = true
			self:_save(player, true)
		end
		self.Profiles[player] = nil
		return
	end

	data = migrate(data)
	data.LastJoin = os.time()
	entry.Data = data
	entry.Loaded = true
	entry.Dirty = true
	self.ProfileLoaded:Fire(player, data)
	self:PushProfile(player)
	if not self.Persistent then
		task.delay(4, function()
			if player.Parent then
				Remotes.GameEvent:FireClient(player, "Notify", {
					Text = "Studio-Modus: Fortschritt wird nicht gespeichert (API-Zugriff deaktiviert).",
					Kind = "Warning",
				})
			end
		end)
	end
end

function PlayerDataService:_loadFromStore(player: Player, key: string)
	local jobId = game.JobId
	for attempt = 1, Config.Data.LoadRetries do
		local locked = false
		local ok, result = pcall(function()
			return self.Store:UpdateAsync(key, function(old)
				locked = false
				local data = old
				if type(data) ~= "table" then
					data = buildTemplate()
				end
				local lock = data._Lock
				if
					type(lock) == "table"
					and lock.Job ~= jobId
					and type(lock.Time) == "number"
					and os.time() - lock.Time < Config.Data.LockTimeout
					and attempt < Config.Data.LoadRetries
				then
					locked = true
					return nil -- Update abbrechen, anderer Server hält das Profil
				end
				data._Lock = { Job = jobId, Time = os.time() }
				return data
			end)
		end)
		if ok and not locked and type(result) == "table" then
			result._Lock = nil
			return result
		end
		if not ok then
			warn(string.format("[PlayerDataService] Laden fehlgeschlagen (%s, Versuch %d): %s", player.Name, attempt, tostring(result)))
		end
		if not player.Parent then
			return nil
		end
		task.wait(math.min(2 ^ attempt, 12))
	end
	return nil
end

function PlayerDataService:_save(player: Player, release: boolean)
	local entry = self.Profiles[player]
	if not entry or not entry.Loaded or not entry.Data then
		return
	end
	if not self.Persistent then
		entry.Dirty = false
		return
	end
	if not entry.Dirty and not release then
		-- Nur den Lock auffrischen, wenn nichts geändert wurde, ist nicht nötig:
		-- der Lock gilt Config.Data.LockTimeout Sekunden.
		return
	end
	if entry.Saving then
		-- Laufende Speicherung abwarten, dann ggf. erneut speichern.
		local deadline = os.clock() + 15
		while entry.Saving and os.clock() < deadline do
			task.wait(0.1)
		end
	end
	entry.Saving = true
	entry.Dirty = false
	local data = Util.DeepCopy(entry.Data)
	local jobId = game.JobId
	if release then
		data._Lock = nil
	else
		data._Lock = { Job = jobId, Time = os.time() }
	end

	local success = false
	for attempt = 1, Config.Data.SaveRetries do
		local ok, err = pcall(function()
			self.Store:UpdateAsync(entry.Key, function(old)
				if type(old) == "table" and type(old._Lock) == "table" and old._Lock.Job ~= jobId then
					-- Ein anderer Server hat das Profil übernommen: nicht überschreiben.
					return nil
				end
				return data
			end)
		end)
		if ok then
			success = true
			break
		end
		warn(string.format("[PlayerDataService] Speichern fehlgeschlagen (%s, Versuch %d): %s", player.Name, attempt, tostring(err)))
		task.wait(math.min(2 ^ attempt, 8))
	end
	if not success then
		entry.Dirty = true
	end
	entry.Saving = false
end

--- Speichert und gibt das Profil frei. Wird von Bootstrap beim Verlassen
--- als letzter Schritt aufgerufen (nachdem alle Services aufgeräumt haben).
function PlayerDataService:Release(player: Player)
	local entry = self.Profiles[player]
	if not entry then
		return
	end
	if entry.Loaded then
		self.ProfileReleasing:Fire(player, entry.Data)
		self:_save(player, true)
	end
	self.Profiles[player] = nil
	self.PushQueued[player] = nil
end

local SETTING_RULES = {
	MusicVolume = { Type = "number", Min = 0, Max = 1 },
	SfxVolume = { Type = "number", Min = 0, Max = 1 },
	GamepadSensitivity = { Type = "number", Min = 0.3, Max = 2.5 },
	CameraShake = { Type = "boolean" },
	TouchControls = { Type = "boolean" },
	AutoRequeue = { Type = "boolean" },
	ReducedEffects = { Type = "boolean" },
}

function PlayerDataService:_saveSettings(player: Player, settings)
	local profile = self:GetProfile(player)
	if not profile or type(settings) ~= "table" then
		return
	end
	for key, rule in SETTING_RULES do
		local value = settings[key]
		if type(value) == rule.Type then
			if rule.Type == "number" then
				if value == value then -- NaN ausschließen
					profile.Settings[key] = math.clamp(value, rule.Min, rule.Max)
				end
			else
				profile.Settings[key] = value
			end
		end
	end
	self:MarkDirty(player)
	self:PushProfile(player)
end

return PlayerDataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">PowerUpService</string>
            <string name="Source"><![CDATA[--[[
	PowerUpService  (ModuleScript)
	Pfad: ServerScriptService/Server/Services/PowerUpService

	Item-Boxen, Aufsammeln, Benutzen und Effekte aller Power-ups
	(Definitionen: ReplicatedStorage/Shared/ItemDefinitions).

	Regeln:
		- Ein Spieler hält höchstens ein Item (Player-Attribut "HeldItem").
		- Aufsammeln wird serverseitig per Distanz geprüft (10 Hz).
		- Benutzung: Item wird VOR dem Effekt entfernt (kein Doppelverbrauch),
		  zusätzlich Debounce pro Spieler.
		- Effekte sind Character-Attribute mit Ablaufzeit (Server-Zeit), die der
		  Client für Bewegung und Effekte ausliest.
		- Im Training wirken offensive Items auf niemanden.
		- Rundenende: Items, Fallen und Status werden bereinigt.

	Öffentliche API:
		:RegisterRegion(mapInstance)
		:UnregisterRegion(regionId)
		:ResetRegion(regionId)
		:GiveItem(player, itemId)
		:ClearPlayer(player)
		:Tick(dt)
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)
local ItemDefinitions = require(Shared.ItemDefinitions)

local RateLimiter = require(script.Parent.Parent.Modules.RateLimiter)

local PowerUpService = {}

function PowerUpService:Init(services)
	self.Services = services
	self.Boxes = {} -- { {Part, Region, Active, RespawnAt} }
	self.Traps = {} -- { {Part, Owner, Region, ExpiresAt, ArmedAt} }
	self.LastUse = {}
	self.Rng = Random.new()
	self.Limiter = RateLimiter.ForRemote("UsePowerUp")
	self.RaycastParams = RaycastParams.new()
	self.RaycastParams.FilterType = Enum.RaycastFilterType.Exclude
	self.RaycastParams.CollisionGroup = "Runner"
	pcall(function()
		self.RaycastParams.RespectCanCollide = true
	end)
end

function PowerUpService:Start()
	Remotes.UsePowerUp.OnServerEvent:Connect(function(player)
		if not self.Limiter:Check(player) then
			return
		end
		self:_use(player)
	end)
	Players.PlayerAdded:Connect(function(player)
		player:SetAttribute("HeldItem", "")
	end)
	for _, player in Players:GetPlayers() do
		player:SetAttribute("HeldItem", "")
	end
end

function PowerUpService:OnPlayerRemoving(player: Player)
	self.LastUse[player] = nil
	for i = #self.Traps, 1, -1 do
		if self.Traps[i].Owner == player then
			self.Traps[i].Part:Destroy()
			table.remove(self.Traps, i)
		end
	end
end

------------------------------------------------------------------------
-- Boxen
------------------------------------------------------------------------

local function makeBox(position: Vector3, parent: Instance, accent: Color3): BasePart
	local box = Instance.new("Part")
	box.Name = "ItemBox"
	box.Size = Vector3.new(2.6, 2.6, 2.6)
	box.CFrame = CFrame.new(position) * CFrame.Angles(math.rad(45), 0, math.rad(45))
	box.Anchored = true
	box.CanCollide = false
	box.CanQuery = false
	box.CanTouch = false
	box.CastShadow = false
	box.Material = Enum.Material.Glass
	box.Transparency = 0.3
	box.Color = accent
	box:SetAttribute("Active", true)
	box:SetAttribute("BasePosition", position)

	local core = Instance.new("Part")
	core.Name = "Core"
	core.Size = Vector3.new(1.3, 1.3, 1.3)
	core.CFrame = box.CFrame
	core.Anchored = true
	core.CanCollide = false
	core.CanQuery = false
	core.CanTouch = false
	core.CastShadow = false
	core.Material = Enum.Material.Neon
	core.Color = Color3.fromRGB(255, 255, 255)
	core.Parent = box

	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = UDim2.fromScale(3, 3)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.LightInfluence = 0
	gui.MaxDistance = 120
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBlack
	label.Text = "?"
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0.3
	label.Parent = gui
	gui.Parent = box

	CollectionService:AddTag(box, "PowerUpBox")
	box.Parent = parent
	return box
end

local function setBoxActive(box: BasePart, active: boolean)
	box:SetAttribute("Active", active)
	box.Transparency = if active then 0.3 else 1
	local core = box:FindFirstChild("Core")
	if core then
		core.Transparency = if active then 0 else 1
	end
	local gui = box:FindFirstChild("Label")
	if gui then
		gui.Enabled = active
	end
end

function PowerUpService:RegisterRegion(instance)
	if instance.RegionId == "Lobby" then
		return
	end
	local accent = instance.Definition and instance.Definition.Theme.Accent or Color3.fromRGB(0, 214, 255)
	for _, position in instance.PickupSpawns do
		local part = makeBox(position, instance.PickupFolder, accent)
		table.insert(self.Boxes, { Part = part, Region = instance.RegionId, Active = true, RespawnAt = 0 })
	end
end

function PowerUpService:UnregisterRegion(regionId: string)
	for i = #self.Boxes, 1, -1 do
		if self.Boxes[i].Region == regionId then
			table.remove(self.Boxes, i)
		end
	end
	self:_clearTraps(regionId)
end

function PowerUpService:ResetRegion(regionId: string)
	for _, box in self.Boxes do
		if box.Region == regionId then
			box.Active = true
			setBoxActive(box.Part, true)
		end
	end
	self:_clearTraps(regionId)
end

function PowerUpService:_clearTraps(regionId: string?)
	for i = #self.Traps, 1, -1 do
		local trap = self.Traps[i]
		if regionId == nil or trap.Region == regionId then
			if trap.Part then
				trap.Part:Destroy()
			end
			table.remove(self.Traps, i)
		end
	end
end

------------------------------------------------------------------------
-- Items
------------------------------------------------------------------------

function PowerUpService:GiveItem(player: Player, itemId: string)
	if not ItemDefinitions.Get(itemId) then
		return
	end
	player:SetAttribute("HeldItem", itemId)
end

function PowerUpService:ClearPlayer(player: Player)
	player:SetAttribute("HeldItem", "")
	for i = #self.Traps, 1, -1 do
		if self.Traps[i].Owner == player then
			self.Traps[i].Part:Destroy()
			table.remove(self.Traps, i)
		end
	end
end

--- Darf der Spieler in seiner aktuellen Region Items sammeln/benutzen?
function PowerUpService:_canUseItems(player: Player, region: string): boolean
	local services = self.Services
	if region == "Race" then
		return services.RoundService:IsActiveRacer(player) and services.RoundService:GetPhase() == "Racing"
	end
	return region ~= "Lobby"
end

function PowerUpService:_rollItem(player: Player, region: string): string
	local bucket = "Front"
	if region == "Race" then
		local placement, alive = self.Services.RoundService:GetPlacementInfo(player)
		if placement and alive then
			if placement == 1 then
				bucket = "Leader"
			elseif placement > math.ceil(alive / 2) then
				bucket = "Back"
			end
		end
	end
	return Util.WeightedPick(ItemDefinitions.GetWeightedList(bucket), self.Rng) or "SpeedBoost"
end

function PowerUpService:Tick(_dt: number)
	local services = self.Services
	local now = os.clock()
	local serverNow = workspace:GetServerTimeNow()

	-- Boxen respawnen
	for _, box in self.Boxes do
		if not box.Active and now >= box.RespawnAt then
			box.Active = true
			setBoxActive(box.Part, true)
		end
	end

	-- Aufsammeln
	local radius = Config.PowerUps.PickupRadius
	for _, player in Players:GetPlayers() do
		local root = services.CharacterService:GetRoot(player)
		if root and player:GetAttribute("HeldItem") == "" then
			local region = services.CharacterService:GetRegion(player)
			if self:_canUseItems(player, region) then
				local position = root.Position
				for _, box in self.Boxes do
					if box.Active and box.Region == region and (box.Part.Position - position).Magnitude <= radius then
						box.Active = false
						box.RespawnAt = now + Config.PowerUps.RespawnTime
						setBoxActive(box.Part, false)
						local itemId = self:_rollItem(player, region)
						self:GiveItem(player, itemId)
						Remotes.GameEvent:FireClient(player, "ItemPickup", { ItemId = itemId, Position = box.Part.Position })
						break
					end
				end
			end
		end
	end

	-- Fallen
	for i = #self.Traps, 1, -1 do
		local trap = self.Traps[i]
		if serverNow >= trap.ExpiresAt or not trap.Part.Parent then
			trap.Part:Destroy()
			table.remove(self.Traps, i)
		elseif serverNow >= trap.ArmedAt then
			local triggered = false
			for _, player in Players:GetPlayers() do
				if player ~= trap.Owner and services.CharacterService:GetRegion(player) == trap.Region then
					local root = services.CharacterService:GetRoot(player)
					if root and (root.Position - trap.Part.Position).Magnitude <= ItemDefinitions.Items.Trap.TriggerRadius + 1.5 then
						self:_applyStatus(player, "Stunned", ItemDefinitions.Items.Trap.StunDuration)
						triggered = true
						break
					end
				end
			end
			if triggered then
				trap.Part:Destroy()
				table.remove(self.Traps, i)
			end
		end
	end
end

--- Wendet einen negativen Status an, sofern kein Schild aktiv ist.
function PowerUpService:_applyStatus(player: Player, kind: string, duration: number): boolean
	local character = player.Character
	if not character then
		return false
	end
	local now = workspace:GetServerTimeNow()
	local root = self.Services.CharacterService:GetRoot(player)
	if (character:GetAttribute("ShieldUntil") or 0) > now then
		character:SetAttribute("ShieldUntil", 0)
		Remotes.GameEvent:FireAllClients("ShieldBlocked", {
			UserId = player.UserId,
			Position = if root then root.Position else Vector3.zero,
		})
		return false
	end
	if kind == "Stunned" then
		character:SetAttribute("StunnedUntil", now + duration)
		self.Services.GrappleService:Release(player, true)
	elseif kind == "Slowed" then
		character:SetAttribute("SlowedUntil", now + duration)
	end
	Remotes.GameEvent:FireAllClients("StatusApplied", {
		UserId = player.UserId,
		Kind = kind,
		Duration = duration,
		Position = if root then root.Position else Vector3.zero,
	})
	return true
end

------------------------------------------------------------------------
-- Benutzen
------------------------------------------------------------------------

function PowerUpService:_use(player: Player)
	local itemId = player:GetAttribute("HeldItem")
	if type(itemId) ~= "string" or itemId == "" then
		return
	end
	local item = ItemDefinitions.Get(itemId)
	if not item then
		player:SetAttribute("HeldItem", "")
		return
	end
	local last = self.LastUse[player]
	if last and os.clock() - last < Config.PowerUps.UseDebounce then
		return
	end
	local services = self.Services
	local character = player.Character
	local root = services.CharacterService:GetRoot(player)
	if not character or not root or character:GetAttribute("Frozen") then
		return
	end
	local now = workspace:GetServerTimeNow()
	if (character:GetAttribute("StunnedUntil") or 0) > now then
		return
	end
	local region = services.CharacterService:GetRegion(player)
	if not self:_canUseItems(player, region) then
		return
	end

	self.LastUse[player] = os.clock()
	-- Item zuerst entfernen: schützt vor doppelter Verwendung
	player:SetAttribute("HeldItem", "")

	local handler = self["_item" .. itemId]
	local ok, consumed, extra = pcall(handler, self, player, character, root, region, item, now)
	if not ok then
		warn("[PowerUpService] Fehler bei " .. itemId .. ": " .. tostring(consumed))
		consumed = false
	end
	if consumed == false then
		-- Nicht verbraucht (z.B. kein Teleportziel): Item zurückgeben
		player:SetAttribute("HeldItem", itemId)
		if type(extra) == "string" then
			Remotes.GameEvent:FireClient(player, "Notify", { Text = extra, Kind = "Warning" })
		end
		return
	end
	local payload = { UserId = player.UserId, ItemId = itemId, Position = root.Position }
	if type(extra) == "table" then
		for key, value in extra do
			payload[key] = value
		end
	end
	Remotes.GameEvent:FireAllClients("PowerUpUsed", payload)
	services.RewardService:OnPowerUpUsed(player, region == "Race")
end

function PowerUpService:_itemSpeedBoost(_player, character, _root, _region, item, now)
	character:SetAttribute("BoostUntil", now + item.Duration)
	return true
end

function PowerUpService:_itemShield(_player, character, _root, _region, item, now)
	character:SetAttribute("ShieldUntil", now + item.Duration)
	return true
end

function PowerUpService:_itemGrappleUpgrade(_player, character, _root, _region, item, now)
	character:SetAttribute("GrappleBoostUntil", now + item.Duration)
	return true
end

function PowerUpService:_itemFreezeBurst(player, _character, root, region, item, _now)
	local hit = 0
	if region == "Race" then
		for _, other in Players:GetPlayers() do
			if other ~= player and self.Services.RoundService:IsActiveRacer(other) then
				local otherRoot = self.Services.CharacterService:GetRoot(other)
				if otherRoot and (otherRoot.Position - root.Position).Magnitude <= item.Radius then
					if self:_applyStatus(other, "Slowed", item.Duration) then
						hit += 1
					end
				end
			end
		end
	end
	return true, { Radius = item.Radius, Hits = hit }
end

function PowerUpService:_itemTeleportBeacon(player, _character, root, region, item, _now)
	local instance = self.Services.MapService:GetRegion(region)
	if not instance then
		return false, "Teleport hier nicht möglich."
	end
	local position = root.Position
	local best = nil
	for _, node in instance.TeleportNodes do
		local dx = node.X - position.X
		if dx >= item.MinDistance and dx <= item.Range and math.abs(node.Y - position.Y) <= 40 then
			if not instance.FinishX or node.X < instance.FinishX - 6 then
				if not best or node.X > best.X then
					best = node
				end
			end
		end
	end
	if not best then
		return false, "Kein sicheres Teleportziel in Reichweite."
	end
	local from = position
	self.Services.CharacterService:Teleport(player, CFrame.lookAt(best, best + Vector3.new(1, 0, 0)))
	return true, { From = from, To = best }
end

function PowerUpService:_itemTrap(player, _character, root, region, item, now)
	local instance = self.Services.MapService:GetRegion(region)
	if not instance then
		return false, "Falle hier nicht möglich."
	end
	-- Alte Falle des Spielers entfernen (max. eine pro Spieler)
	for i = #self.Traps, 1, -1 do
		if self.Traps[i].Owner == player then
			self.Traps[i].Part:Destroy()
			table.remove(self.Traps, i)
		end
	end
	self.RaycastParams.FilterDescendantsInstances = { player.Character }
	local result = workspace:Raycast(root.Position, Vector3.new(0, -14, 0), self.RaycastParams)
	local groundY = if result then result.Position.Y else root.Position.Y + Config.Character.FeetOffset
	local position = Vector3.new(root.Position.X, groundY + 0.4, 0)

	local trap = Instance.new("Part")
	trap.Name = "Trap"
	trap.Size = Vector3.new(3.2, 0.8, 3.2)
	trap.CFrame = CFrame.new(position)
	trap.Anchored = true
	trap.CanCollide = false
	trap.CanQuery = false
	trap.CanTouch = false
	trap.Material = Enum.Material.Neon
	trap.Color = item.Color
	trap:SetAttribute("Owner", player.UserId)
	for i = -1, 1 do
		local spike = Instance.new("WedgePart")
		spike.Name = "Spike"
		spike.Size = Vector3.new(0.6, 0.9, 0.6)
		spike.CFrame = CFrame.new(position + Vector3.new(i * 1, 0.85, 0))
		spike.Anchored = true
		spike.CanCollide = false
		spike.CanQuery = false
		spike.CanTouch = false
		spike.Material = Enum.Material.Metal
		spike.Color = Color3.fromRGB(60, 60, 70)
		spike.Parent = trap
	end
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(2.5, 2.5)
	gui.StudsOffset = Vector3.new(0, 2.5, 0)
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBlack
	label.Text = "!"
	label.TextScaled = true
	label.TextColor3 = item.Color
	label.TextStrokeTransparency = 0.2
	label.Parent = gui
	gui.Parent = trap
	trap.Parent = instance.RuntimeFolder

	table.insert(self.Traps, {
		Part = trap,
		Owner = player,
		Region = region,
		ExpiresAt = now + item.Lifetime,
		ArmedAt = now + 0.4,
	})
	return true, { TrapPosition = position }
end

return PowerUpService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">PracticeService</string>
            <string name="Source"><![CDATA[--[[
	PracticeService  (ModuleScript)
	Pfad: ServerScriptService/Server/Services/PracticeService

	Trainingsmodus ohne Wettbewerbsdruck:
		- "Tutorial": Bewegungs-Tutorial mit erklärenden Schildern
		- jede Rennstrecke als eigene Trainingskopie (Abkürzungen testen)
	Kein Gefahrenring, keine Coins/XP, keine Statistiken, keine Bestzeiten.
	Items können getestet werden, offensive Items treffen niemanden.
	Wird ein Match gestartet, verlässt der Spieler das Training automatisch.

	Remote "PracticeRequest": ("Enter", courseId) | ("Leave") | ("Reset")

	Öffentliche API:
		:RegionIdFor(courseId) -> string
		:GetCourse(player) -> courseId?
		:Enter(player, courseId) -> (boolean, string)
		:Leave(player)
		:ForceLeave(player)        (ohne Teleport, z.B. bei Matchstart)
		:Reset(player)
		:GetRespawnCFrame(player) -> CFrame?
		:Tick(dt)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)
local MapDefinitions = require(Shared.MapDefinitions)

local RateLimiter = require(script.Parent.Parent.Modules.RateLimiter)

local PracticeService = {}

function PracticeService:Init(services)
	self.Services = services
	self.Active = {} -- [player] = { Course, Checkpoint, StartedAt, LastPosition, RespawnLock, Finished }
	self.Limiter = RateLimiter.ForRemote("PracticeRequest")
end

function PracticeService:Start()
	Remotes.PracticeRequest.OnServerEvent:Connect(function(player, action, courseId)
		if not self.Limiter:Check(player) then
			return
		end
		if action == "Enter" then
			local ok, message = self:Enter(player, courseId)
			Remotes.GameEvent:FireClient(player, "Notify", { Text = message, Kind = if ok then "Success" else "Warning" })
		elseif action == "Leave" then
			if self.Active[player] then
				self:Leave(player)
			end
		elseif action == "Reset" then
			self:Reset(player)
		end
	end)
	Players.PlayerAdded:Connect(function(player)
		player:SetAttribute("PracticeCourse", "")
	end)
	for _, player in Players:GetPlayers() do
		player:SetAttribute("PracticeCourse", "")
	end
end

function PracticeService:OnPlayerRemoving(player: Player)
	self.Active[player] = nil
end

function PracticeService:RegionIdFor(courseId: string): string
	if courseId == "Tutorial" then
		return "Tutorial"
	end
	return "Practice_" .. courseId
end

function PracticeService:GetCourse(player: Player): string?
	local entry = self.Active[player]
	return entry and entry.Course or nil
end

function PracticeService:Enter(player: Player, courseId: any): (boolean, string)
	if type(courseId) ~= "string" or (courseId ~= "Tutorial" and not MapDefinitions.Get(courseId)) then
		return false, "Unbekannte Trainingsstrecke."
	end
	local services = self.Services
	if services.RoundService:IsInMatch(player) then
		return false, "Während eines Rennens nicht möglich."
	end
	if not player.Character then
		return false, "Spielfigur lädt noch."
	end
	local region = services.MapService:EnsurePracticeRegion(courseId)
	if not region then
		return false, "Strecke konnte nicht geladen werden."
	end
	self.Active[player] = {
		Course = courseId,
		Checkpoint = 1,
		StartedAt = os.clock(),
		LastPosition = nil,
		RespawnLock = false,
		Finished = false,
	}
	player:SetAttribute("PracticeCourse", courseId)
	services.PowerUpService:ClearPlayer(player)
	services.CharacterService:ClearStatus(player)
	services.CharacterService:SetFrozen(player, false)
	services.CharacterService:Teleport(player, region.Spawns[1])
	local definition = MapDefinitions.GetAny(courseId)
	return true, "Training: " .. (definition and definition.Name or courseId)
end

function PracticeService:ForceLeave(player: Player)
	if not self.Active[player] then
		return
	end
	self.Active[player] = nil
	player:SetAttribute("PracticeCourse", "")
	self.Services.PowerUpService:ClearPlayer(player)
	self.Services.CharacterService:ClearStatus(player)
end

function PracticeService:Leave(player: Player)
	self:ForceLeave(player)
	self.Services.CharacterService:SendToLobby(player)
end

function PracticeService:GetRespawnCFrame(player: Player): CFrame?
	local entry = self.Active[player]
	if not entry then
		return nil
	end
	local region = self.Services.MapService:GetRegion(self:RegionIdFor(entry.Course))
	if not region then
		return nil
	end
	local checkpoint = region.Checkpoints[entry.Checkpoint] or region.Checkpoints[1]
	return if checkpoint then checkpoint.CFrame else region.Spawns[1]
end

function PracticeService:Reset(player: Player)
	local entry = self.Active[player]
	if not entry then
		return
	end
	local cframe = self:GetRespawnCFrame(player)
	if cframe then
		if entry.Checkpoint <= 1 then
			entry.StartedAt = os.clock()
		end
		self.Services.CharacterService:Teleport(player, cframe)
		entry.LastPosition = cframe.Position
	end
end

function PracticeService:_respawn(player: Player, entry)
	if entry.RespawnLock then
		return
	end
	entry.RespawnLock = true
	local services = self.Services
	local cframe = self:GetRespawnCFrame(player)
	if cframe then
		Remotes.GameEvent:FireAllClients("RacerRespawn", { UserId = player.UserId, From = entry.LastPosition, To = cframe.Position, Reason = "Practice" })
		services.CharacterService:Teleport(player, cframe)
		services.CharacterService:SetFrozen(player, true)
		entry.LastPosition = cframe.Position
	end
	task.delay(Config.Practice.RespawnFreezeTime, function()
		entry.RespawnLock = false
		if self.Active[player] == entry then
			services.CharacterService:SetFrozen(player, false)
		end
	end)
end

function PracticeService:Tick(_dt: number)
	local services = self.Services
	for player, entry in self.Active do
		local root = services.CharacterService:GetRoot(player)
		local region = services.MapService:GetRegion(self:RegionIdFor(entry.Course))
		if root and region and not entry.Finished then
			local position = root.Position
			local previous = entry.LastPosition
			entry.LastPosition = position
			local index = services.MapService:FindCheckpointIndex(region, position.X)
			if index > entry.Checkpoint then
				entry.Checkpoint = index
			end
			if not entry.RespawnLock then
				local hit = services.MapService:IsInHazard(region, position, previous)
				if hit then
					self:_respawn(player, entry)
				elseif region.FinishX and position.X >= region.FinishX then
					entry.Finished = true
					local elapsed = os.clock() - entry.StartedAt
					Remotes.GameEvent:FireClient(player, "PracticeFinished", { CourseId = entry.Course, Time = elapsed })
					Remotes.GameEvent:FireClient(player, "Notify", {
						Text = "Strecke geschafft in " .. Util.FormatTime(elapsed) .. "! Neustart in 3 Sekunden.",
						Kind = "Success",
					})
					task.delay(3, function()
						if self.Active[player] == entry then
							entry.Finished = false
							entry.Checkpoint = 1
							entry.StartedAt = os.clock()
							services.CharacterService:Teleport(player, region.Spawns[1])
							entry.LastPosition = region.Spawns[1].Position
						end
					end)
				end
			end
		end
	end
end

return PracticeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">RankedService</string>
            <string name="Source"><![CDATA[--[[
	RankedService  (ModuleScript)
	Pfad: ServerScriptService/Server/Services/RankedService

	Rangpunkte (Elo-artig, mehrspielerfähig) für den Ranked-Modus.
	- Berechnung ausschließlich auf dem Server nach Matchende.
	- Jedes Match wird pro Spieler genau einmal gewertet (match.RankedApplied).
	- Leaver werden beim Verlassen sofort als Letzter gewertet.
	- Saisonwechsel: Rating wird weich zurückgesetzt, Saisonstatistik neu.

	Öffentliche API:
		:EnsureSeason(player)
		:ApplyMatch(match, summaries)
		:ApplyLeavePenalty(match, racer, player)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Progression = require(Shared.Progression)

local RankedService = {}

function RankedService:Init(services)
	self.Services = services
end

function RankedService:Start()
	self.Services.PlayerDataService.ProfileLoaded:Connect(function(player)
		self:EnsureSeason(player)
	end)
end

function RankedService:EnsureSeason(player: Player)
	local data = self.Services.PlayerDataService
	local profile = data:GetProfile(player)
	if not profile then
		return
	end
	local ranked = profile.Ranked
	if ranked.Season ~= Config.Ranked.Season then
		ranked.Rating = math.floor((ranked.Rating + Config.Ranked.StartRating) / 2)
		ranked.Season = Config.Ranked.Season
		ranked.Games = 0
		ranked.Wins = 0
		ranked.Peak = ranked.Rating
		data:MarkDirty(player)
	end
end

function RankedService:_entries(match, includeLeaver)
	local entries = {}
	for _, racer in match.RacerList do
		local player = racer.Player or (includeLeaver and racer == includeLeaver.Racer and includeLeaver.Player)
		local rating = racer.RatingAtStart
		if not rating and player then
			local profile = self.Services.PlayerDataService:GetProfile(player)
			rating = profile and profile.Ranked.Rating or Config.Ranked.StartRating
		end
		racer.RatingAtStart = rating or Config.Ranked.StartRating
		table.insert(entries, {
			Key = racer,
			Rating = racer.RatingAtStart,
			Placement = racer.Placement or #match.RacerList,
		})
	end
	return entries
end

function RankedService:_apply(player: Player, racer, delta: number)
	local data = self.Services.PlayerDataService
	local profile = data:GetProfile(player)
	if not profile then
		return nil
	end
	local ranked = profile.Ranked
	local old = ranked.Rating
	ranked.Rating = math.max(Config.Ranked.MinRating, old + delta)
	ranked.Games += 1
	if racer.Placement == 1 then
		ranked.Wins += 1
	end
	ranked.Peak = math.max(ranked.Peak, ranked.Rating)
	data:MarkDirty(player)
	data:PushProfile(player)
	self.Services.EconomyService:UpdateLeaderstats(player)
	return ranked.Rating - old, ranked.Rating
end

--- Wertet ein beendetes Ranked-Match (nur noch nicht gewertete Spieler).
function RankedService:ApplyMatch(match, summaries)
	match.RankedApplied = match.RankedApplied or {}
	local entries = self:_entries(match)
	local deltas = Progression.ComputeRatingDeltas(entries, Config.Ranked.KFactor)
	for _, racer in match.RacerList do
		local player = racer.Player
		if player and player.Parent and not match.RankedApplied[racer.UserId] and racer.Status ~= "Left" then
			match.RankedApplied[racer.UserId] = true
			local change, newRating = self:_apply(player, racer, deltas[racer] or 0)
			local summary = summaries[racer.UserId]
			if summary and change then
				summary.RatingChange = change
				summary.NewRating = newRating
				summary.Tier = Progression.GetTier(newRating).Name
			end
		end
	end
end

--- Sofortige Wertung als Letzter, wenn ein Spieler ein Ranked-Match verlässt.
function RankedService:ApplyLeavePenalty(match, racer, player: Player?)
	if not player then
		return
	end
	match.RankedApplied = match.RankedApplied or {}
	if match.RankedApplied[racer.UserId] then
		return
	end
	match.RankedApplied[racer.UserId] = true
	local entries = self:_entries(match, { Racer = racer, Player = player })
	for _, entry in entries do
		if entry.Key == racer then
			entry.Placement = #match.RacerList + 1
		end
	end
	local deltas = Progression.ComputeRatingDeltas(entries, Config.Ranked.KFactor)
	local delta = math.min(0, deltas[racer] or 0) * Config.Ranked.LeavePenaltyFactor
	self:_apply(player, racer, math.floor(delta))
end

return RankedService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">RewardService</string>
            <string name="Source"><![CDATA[--[[
	RewardService  (ModuleScript)
	Pfad: ServerScriptService/Server/Services/RewardService

	Berechnet und vergibt Belohnungen ausschließlich serverseitig:
		- Match-Belohnungen (Teilnahme, Platzierung, Ziel erreicht)
		- Statistiken (Rennen, Siege, Top 3, Bestzeiten ...)
		- Tägliche Aufgaben und Erfolge

	Schutz vor Mehrfachbelohnung:
		1. match.Rewarded[userId] (pro Match im Speicher)
		2. profile.RecentMatches (Match-IDs der letzten Rennen, gespeichert)
		3. Aufgaben/Erfolge haben ein Done-Flag bzw. stehen in Achievements.

	Öffentliche API:
		:GrantMatchRewards(match) -> { [userId] = summary }
		:OnGrapple(player, inRace)
		:OnPowerUpUsed(player, inRace)
		:EnsureDailyQuests(player)
		:CheckAchievements(player)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)
local QuestDefinitions = require(Shared.QuestDefinitions)

local RewardService = {}

function RewardService:Init(services)
	self.Services = services
end

function RewardService:Start()
	self.Services.PlayerDataService.ProfileLoaded:Connect(function(player)
		self:EnsureDailyQuests(player)
		self:CheckAchievements(player)
	end)
end

------------------------------------------------------------------------
-- Tägliche Aufgaben
------------------------------------------------------------------------

function RewardService:EnsureDailyQuests(player: Player)
	local data = self.Services.PlayerDataService
	local profile = data:GetProfile(player)
	if not profile then
		return
	end
	local day = Util.DayNumber()
	if profile.Quests.Day ~= day then
		local list = {}
		for _, id in QuestDefinitions.RollDaily(player.UserId, day) do
			table.insert(list, { Id = id, Progress = 0, Done = false })
		end
		profile.Quests = { Day = day, List = list }
		data:MarkDirty(player)
		data:PushProfile(player)
	end
end

--- Erhöht den Fortschritt aller Tagesaufgaben mit Statistik `stat`.
function RewardService:_questProgress(player: Player, stat: string, amount: number)
	self:EnsureDailyQuests(player)
	local services = self.Services
	local profile = services.PlayerDataService:GetProfile(player)
	if not profile then
		return {}
	end
	local completed = {}
	for _, entry in profile.Quests.List do
		local quest = QuestDefinitions.DailyLookup[entry.Id]
		if quest and quest.Stat == stat and not entry.Done then
			entry.Progress = math.min(quest.Goal, entry.Progress + amount)
			if entry.Progress >= quest.Goal then
				entry.Done = true
				services.EconomyService:AddCoins(player, quest.Coins, "Quest:" .. quest.Id)
				services.EconomyService:AddXP(player, quest.XP, "Quest:" .. quest.Id)
				Remotes.GameEvent:FireClient(player, "QuestCompleted", { Name = quest.Name, Coins = quest.Coins, XP = quest.XP })
				table.insert(completed, quest.Name)
			end
		end
	end
	services.PlayerDataService:MarkDirty(player)
	return completed
end

------------------------------------------------------------------------
-- Erfolge
------------------------------------------------------------------------

function RewardService:_statValue(player: Player, profile, stat: string): number
	if stat == "Level" then
		return profile.Level
	elseif stat == "Owned" then
		return self.Services.InventoryService:CountOwned(player)
	end
	return profile.Stats[stat] or 0
end

function RewardService:CheckAchievements(player: Player)
	local services = self.Services
	local profile = services.PlayerDataService:GetProfile(player)
	if not profile then
		return {}
	end
	local unlocked = {}
	for _, achievement in QuestDefinitions.Achievements do
		if not profile.Achievements[achievement.Id] and self:_statValue(player, profile, achievement.Stat) >= achievement.Goal then
			profile.Achievements[achievement.Id] = true
			-- Erst markieren, dann belohnen (verhindert Rekursion über Level-Ups)
			services.EconomyService:AddCoins(player, achievement.Coins, "Achievement:" .. achievement.Id)
			Remotes.GameEvent:FireClient(player, "AchievementUnlocked", { Name = achievement.Name, Coins = achievement.Coins })
			table.insert(unlocked, achievement.Name)
		end
	end
	if #unlocked > 0 then
		services.PlayerDataService:MarkDirty(player)
		services.PlayerDataService:PushProfile(player)
	end
	return unlocked
end

------------------------------------------------------------------------
-- Live-Zähler
------------------------------------------------------------------------

function RewardService:OnGrapple(player: Player, inRace: boolean)
	if not inRace then
		return
	end
	local profile = self.Services.PlayerDataService:GetProfile(player)
	if not profile then
		return
	end
	profile.Stats.Grapples += 1
	self:_questProgress(player, "Grapples", 1)
end

function RewardService:OnPowerUpUsed(player: Player, inRace: boolean)
	if not inRace then
		return
	end
	local profile = self.Services.PlayerDataService:GetProfile(player)
	if not profile then
		return
	end
	profile.Stats.PowerUps += 1
	self:_questProgress(player, "PowerUps", 1)
end

------------------------------------------------------------------------
-- Match-Belohnungen
------------------------------------------------------------------------

function RewardService:GrantMatchRewards(match)
	local services = self.Services
	local rewardsConfig = Config.Rewards
	local summaries = {}
	local participants = match.Participants
	local scale = math.clamp(participants / rewardsConfig.FullRewardPlayerCount, 0.4, 1)

	for _, racer in match.RacerList do
		local player = racer.Player
		if player and player.Parent and racer.Status ~= "Left" and not match.Rewarded[racer.UserId] then
			match.Rewarded[racer.UserId] = true
			local profile = services.PlayerDataService:GetProfile(player)
			if profile and not table.find(profile.RecentMatches, match.Id) then
				table.insert(profile.RecentMatches, match.Id)
				while #profile.RecentMatches > rewardsConfig.RecentMatchMemory do
					table.remove(profile.RecentMatches, 1)
				end

				local placement = racer.Placement or participants
				local isWinner = placement == 1 and (participants >= 2 or racer.Status == "Finished")
				local finished = racer.Status == "Finished"

				local coins = rewardsConfig.ParticipationCoins
				local xp = rewardsConfig.ParticipationXP
				if participants >= 2 and rewardsConfig.PlacementCoins[placement] then
					coins += math.floor(rewardsConfig.PlacementCoins[placement] * scale)
					xp += math.floor(rewardsConfig.PlacementXP[placement] * scale)
				end
				if finished then
					coins += rewardsConfig.FinishBonusCoins
					xp += rewardsConfig.FinishBonusXP
				end

				-- Statistiken
				local stats = profile.Stats
				stats.Races += 1
				stats.Distance += math.floor(racer.Distance)
				if racer.Status == "Eliminated" then
					stats.Eliminated += 1
				end
				if isWinner then
					stats.Wins += 1
					if racer.Respawns == 0 then
						stats.FlawlessWins += 1
					end
				end
				if placement <= 3 and participants >= 2 then
					stats.Top3 += 1
				end
				local newBest = false
				if finished and racer.FinishTime then
					stats.Finishes += 1
					local best = stats.BestTimes[match.MapId]
					if not best or racer.FinishTime < best then
						stats.BestTimes[match.MapId] = math.floor(racer.FinishTime * 100) / 100
						newBest = true
					end
				end

				services.EconomyService:AddCoins(player, coins, "Match:" .. match.Id)
				local xpResult = services.EconomyService:AddXP(player, xp, "Match:" .. match.Id)

				-- Aufgaben
				local quests = {}
				local function collect(list)
					for _, name in list do
						table.insert(quests, name)
					end
				end
				collect(self:_questProgress(player, "Races", 1))
				collect(self:_questProgress(player, "Distance", math.floor(racer.Distance)))
				if isWinner then
					collect(self:_questProgress(player, "Wins", 1))
				end
				if placement <= 3 and participants >= 2 then
					collect(self:_questProgress(player, "Top3", 1))
				end
				if finished then
					collect(self:_questProgress(player, "Finishes", 1))
				end

				local achievements = self:CheckAchievements(player)
				services.EconomyService:UpdateLeaderstats(player)
				services.PlayerDataService:MarkDirty(player)
				services.PlayerDataService:PushProfile(player)

				summaries[racer.UserId] = {
					Coins = coins,
					XP = xp,
					LevelsGained = xpResult.LevelsGained,
					NewLevel = xpResult.NewLevel,
					LevelBonusCoins = xpResult.BonusCoins,
					Placement = placement,
					Winner = isWinner,
					NewBestTime = if newBest then racer.FinishTime else nil,
					Quests = quests,
					Achievements = achievements,
				}
			end
		end
	end
	return summaries
end

return RewardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">RoundService</string>
            <string name="Source"><![CDATA[--[[
	RoundService  (ModuleScript)
	Pfad: ServerScriptService/Server/Services/RoundService

	Serverautoritativer Rundenablauf (Quick Play und Ranked):

		Waiting   -> Warteschlange hat < MinPlayers
		Starting  -> genug Spieler; Countdown (verkürzt bei voller Lobby)
		Loading   -> Map wird gebaut, Spieler an Spawnpunkte gesetzt
		Countdown -> 3-2-1-GO, Spieler eingefroren
		Racing    -> Rennen läuft (10 Hz Server-Tick)
		Results   -> Ergebnisse + Belohnungen, danach zurück zur Lobby

	REGELN (eindeutig):
		Sieg:       a) Wer zuerst die Ziellinie überquert, gewinnt sofort.
		            b) Ist nur noch ein Spieler übrig (bei ≥ 2 Startern), gewinnt er.
		            c) Nach MaxRaceTime gewinnt, wer am weitesten vorn ist.
		Ausscheiden: Wer EliminationDelay Sekunden hinter der Gefahrenwand ist.
		            Platzierung = Anzahl der zu diesem Zeitpunkt noch aktiven Spieler.
		Respawn:    Sturz in Gefahr/Abgrund -> letzter Checkpoint, kurz eingefroren.
		            Kein Respawn nach dem Ausscheiden (Zuschauer in der Lobby).
		Verlassen:  Zählt als Ausscheiden ("Left"), keine Belohnung, Ranked-Strafe.
		            Bricht ein Match vor dem Start unter MinPlayers ab, kommen die
		            übrigen Spieler zurück in die Warteschlange.

	Doppelte Rundenenden sind ausgeschlossen: _endMatch prüft match.Ended und
	läuft ohne Yield bis zur Vergabe der Ergebnisse.

	Repliziert über ReplicatedStorage/GameState (Attribute) und
	GameState/Racers/<UserId> (Attribute pro Rennfahrer).

	Öffentliche API:
		:GetPhase() -> string
		:IsActiveRacer(player) -> boolean   (im laufenden Match, nicht ausgeschieden)
		:IsInMatch(player) -> boolean       (Teilnehmer, noch nicht zurück in der Lobby)
		:GetRacer(player) -> racer?
		:GetPlacementInfo(player) -> (placement?, aliveCount?)
		:RespawnRacer(player, reason)
		:GetRespawnCFrame(player) -> CFrame?
		:OnPlayerRemoving(player)
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local RoundService = {}

local function now(): number
	return workspace:GetServerTimeNow()
end

function RoundService:Init(services)
	self.Services = services
	self.Phase = "Waiting"
	self.Match = nil

	local state = ReplicatedStorage:FindFirstChild("GameState")
	if not state then
		state = Instance.new("Folder")
		state.Name = "GameState"
		state.Parent = ReplicatedStorage
	end
	local racers = state:FindFirstChild("Racers")
	if not racers then
		racers = Instance.new("Folder")
		racers.Name = "Racers"
		racers.Parent = state
	end
	self.State = state
	self.RacersFolder = racers

	local defaults = {
		Phase = "Waiting",
		PhaseEndsAt = 0,
		MatchId = "",
		Mode = "",
		MapId = "",
		NextMapId = "",
		QueueQuickPlay = 0,
		QueueRanked = 0,
		RaceStartedAt = 0,
		Alive = 0,
		Participants = 0,
		StartX = 0,
		FinishX = 0,
		CheckpointXs = "",
		MinPlayers = self:_minPlayers(),
		MaxPlayers = Config.Round.MaxPlayers,
		ZoneState = "Inactive",
		ZoneX = -1e6,
		ZoneLength = 0,
		ZoneWarnAt = 0,
		ZoneShrinkAt = 0,
	}
	for key, value in defaults do
		state:SetAttribute(key, value)
	end
end

function RoundService:Start()
	self.Services.CharacterService.CharacterReady:Connect(function(player, character)
		local racer = self:GetRacer(player)
		if racer and self.Match and not self.Match.Ended then
			if self.Phase == "Loading" or self.Phase == "Countdown" or racer.RespawnLock then
				character:SetAttribute("Frozen", true)
			end
		end
	end)
	task.spawn(function()
		self:_runLoop()
	end)
end

function RoundService:_minPlayers(): number
	return if Config.Debug.AllowSoloRace then 1 else Config.Round.MinPlayers
end

function RoundService:_setPhase(phase: string, endsAt: number)
	self.Phase = phase
	self.State:SetAttribute("Phase", phase)
	self.State:SetAttribute("PhaseEndsAt", endsAt)
end

------------------------------------------------------------------------
-- Öffentliche API
------------------------------------------------------------------------

function RoundService:GetPhase(): string
	return self.Phase
end

function RoundService:GetRacer(player: Player)
	local match = self.Match
	return match and match.Racers[player] or nil
end

function RoundService:IsActiveRacer(player: Player): boolean
	local match = self.Match
	if not match or match.Ended then
		return false
	end
	local racer = match.Racers[player]
	return racer ~= nil and racer.Status == "Racing"
end

function RoundService:IsInMatch(player: Player): boolean
	return self:GetRacer(player) ~= nil and player:GetAttribute("InRace") == true
end

function RoundService:GetPlacementInfo(player: Player): (number?, number?)
	local racer = self:GetRacer(player)
	if not racer or not self.Match then
		return nil, nil
	end
	return racer.Placement, self.Match.AliveCount or 0
end

function RoundService:GetRespawnCFrame(player: Player): CFrame?
	if not self:IsActiveRacer(player) then
		return nil
	end
	local racer = self:GetRacer(player)
	local map = self.Match.Map
	if not map then
		return nil
	end
	local checkpoint = map.Checkpoints[racer.Checkpoint] or map.Checkpoints[1]
	if checkpoint then
		return checkpoint.CFrame
	end
	return map.Spawns[1]
end

function RoundService:RespawnRacer(player: Player, reason: string)
	if self.Phase ~= "Racing" then
		return
	end
	local racer = self:GetRacer(player)
	if racer and racer.Status == "Racing" then
		self:_respawnRacer(self.Match, racer, reason)
	end
end

function RoundService:OnPlayerRemoving(player: Player)
	local match = self.Match
	if not match then
		return
	end
	local racer = match.Racers[player]
	if not racer then
		return
	end
	racer.Player = nil
	racer.LeftGame = true
	if match.Ended or racer.Status ~= "Racing" then
		return
	end
	if self.Phase == "Racing" then
		self:_eliminate(match, racer, "Left", player)
	else
		-- Vor dem Start verlassen: zählt als Letzter, Match prüft Abbruch selbst.
		racer.Status = "Left"
		racer.Placement = self:_aliveCount(match) + 1
		if match.Mode == "Ranked" then
			self.Services.RankedService:ApplyLeavePenalty(match, racer, player)
		end
	end
end

------------------------------------------------------------------------
-- Ablauf
------------------------------------------------------------------------

function RoundService:_runLoop()
	while true do
		local ok, err = xpcall(function()
			local mode = self:_waitForQueue()
			if self:_startingCountdown(mode) then
				local players = self.Services.MatchmakingService:TakePlayers(mode, Config.Round.MaxPlayers)
				if #players >= self:_minPlayers() then
					self:_runMatch(mode, players)
				else
					for _, player in players do
						self.Services.MatchmakingService:Join(player, mode)
					end
				end
			end
		end, debug.traceback)
		if not ok then
			warn("[RoundService] Fehler im Rundenablauf:\n" .. tostring(err))
			self:_emergencyCleanup()
		end
		self:_setPhase("Waiting", 0)
		task.wait(0.5)
	end
end

function RoundService:_waitForQueue(): string
	self:_setPhase("Waiting", 0)
	while true do
		local mode = self.Services.MatchmakingService:GetReadyMode(self:_minPlayers())
		if mode then
			return mode
		end
		task.wait(0.5)
	end
end

function RoundService:_startingCountdown(mode: string): boolean
	local matchmaking = self.Services.MatchmakingService
	local endsAt = now() + Config.Round.StartingCountdown
	self.State:SetAttribute("Mode", mode)
	self:_setPhase("Starting", endsAt)
	while true do
		local count = matchmaking:GetCount(mode)
		if count < self:_minPlayers() then
			self.State:SetAttribute("Mode", "")
			return false
		end
		if count >= Config.Round.MaxPlayers then
			local short = now() + Config.Round.FullLobbyCountdown
			if short < endsAt then
				endsAt = short
				self.State:SetAttribute("PhaseEndsAt", endsAt)
			end
		end
		if now() >= endsAt then
			return true
		end
		task.wait(0.25)
	end
end

function RoundService:_aliveCount(match): number
	local alive = 0
	for _, racer in match.RacerList do
		if racer.Status == "Racing" then
			alive += 1
		end
	end
	return alive
end

function RoundService:_runMatch(mode: string, players: { Player })
	local services = self.Services
	local mapId = services.MapService:AdvanceRotation()
	self:_setPhase("Loading", 0)

	local match = {
		Id = HttpService:GenerateGUID(false),
		Mode = mode,
		MapId = mapId,
		Racers = {},
		RacerList = {},
		StartedAt = 0,
		Ended = false,
		Participants = #players,
		AliveCount = #players,
		Rewarded = {},
	}
	self.Match = match

	for index, player in players do
		local racer = {
			Player = player,
			UserId = player.UserId,
			Name = player.DisplayName,
			Status = "Racing",
			Placement = index,
			Checkpoint = 1,
			DangerTime = 0,
			Respawns = 0,
			Distance = 0,
			LastPosition = nil,
			FinishTime = nil,
			RespawnLock = false,
		}
		match.Racers[player] = racer
		table.insert(match.RacerList, racer)
		services.PracticeService:ForceLeave(player)
		player:SetAttribute("InRace", true)
	end

	self.State:SetAttribute("MatchId", match.Id)
	self.State:SetAttribute("Mode", mode)
	self.State:SetAttribute("MapId", mapId)
	self.State:SetAttribute("Participants", #players)

	local map = services.MapService:LoadRaceMap(mapId)
	match.Map = map
	local checkpointXs = {}
	for _, checkpoint in map.Checkpoints do
		table.insert(checkpointXs, tostring(math.floor(checkpoint.X)))
	end
	self.State:SetAttribute("StartX", map.StartX)
	self.State:SetAttribute("FinishX", map.FinishX or 0)
	self.State:SetAttribute("CheckpointXs", table.concat(checkpointXs, ","))

	for _, racer in match.RacerList do
		self:_createRacerFolder(racer)
	end

	if self:_aliveCount(match) < self:_minPlayers() then
		self:_abortMatch(match)
		return
	end

	-- Spieler an Spawnpunkte setzen
	for index, racer in match.RacerList do
		local player = racer.Player
		if player and racer.Status == "Racing" then
			local spawnCFrame = map.Spawns[((index - 1) % #map.Spawns) + 1]
			services.CharacterService:ClearStatus(player)
			services.PowerUpService:ClearPlayer(player)
			services.CharacterService:SetFrozen(player, true)
			if not services.CharacterService:Teleport(player, spawnCFrame) then
				services.CharacterService:Spawn(player)
			end
			racer.LastPosition = spawnCFrame.Position
		end
	end

	-- Countdown
	local countdownEnd = now() + Config.Round.CountdownDuration
	self:_setPhase("Countdown", countdownEnd)
	Remotes.GameEvent:FireAllClients("MatchStarted", { MatchId = match.Id, MapId = mapId, Mode = mode })
	while now() < countdownEnd do
		task.wait(0.1)
		if self:_aliveCount(match) < self:_minPlayers() then
			self:_abortMatch(match)
			return
		end
	end

	-- Start
	match.StartedAt = now()
	self.State:SetAttribute("RaceStartedAt", match.StartedAt)
	for _, racer in match.RacerList do
		if racer.Player and racer.Status == "Racing" then
			services.CharacterService:SetFrozen(racer.Player, false)
		end
	end
	services.HazardRingService:Begin(match)
	self:_setPhase("Racing", match.StartedAt + Config.Round.MaxRaceTime)

	local tick = 1 / Config.Round.TickRate
	while not match.Ended do
		local dt = task.wait(tick)
		local ok, err = xpcall(function()
			self:_raceTick(match, dt)
		end, debug.traceback)
		if not ok then
			warn("[RoundService] Fehler im Renn-Tick:\n" .. tostring(err))
		end
	end

	-- Ergebnisphase (Phase wurde in _endMatch gesetzt)
	task.wait(Config.Round.ReturnToLobbyDelay)
	for _, racer in match.RacerList do
		local player = racer.Player
		if player and player.Parent and player:GetAttribute("InRace") then
			self:_returnToLobby(player)
		end
	end
	while now() < (self.State:GetAttribute("PhaseEndsAt") or 0) do
		task.wait(0.25)
	end
	self:_cleanupMatch(match, true)
end

function RoundService:_returnToLobby(player: Player)
	local services = self.Services
	player:SetAttribute("InRace", false)
	services.GrappleService:Release(player, true)
	services.PowerUpService:ClearPlayer(player)
	services.CharacterService:ClearStatus(player)
	services.CharacterService:SetFrozen(player, false)
	services.CharacterService:SendToLobby(player)
end

function RoundService:_abortMatch(match)
	Remotes.GameEvent:FireAllClients("Notify", {
		Text = "Rennen abgebrochen – zu wenige Spieler. Zurück in die Warteschlange.",
		Kind = "Warning",
	})
	match.Ended = true
	for _, racer in match.RacerList do
		local player = racer.Player
		if player and player.Parent then
			self:_returnToLobby(player)
			if racer.Status == "Racing" then
				self.Services.MatchmakingService:Join(player, match.Mode)
			end
		end
	end
	self:_cleanupMatch(match, false)
end

function RoundService:_cleanupMatch(match, requeue: boolean)
	local services = self.Services
	services.HazardRingService:Reset()
	services.MapService:UnloadRaceMap()
	self.RacersFolder:ClearAllChildren()
	for _, key in { "MatchId", "Mode", "MapId", "CheckpointXs" } do
		self.State:SetAttribute(key, "")
	end
	for _, key in { "RaceStartedAt", "Alive", "Participants", "StartX", "FinishX" } do
		self.State:SetAttribute(key, 0)
	end
	if self.Match == match then
		self.Match = nil
	end
	for _, racer in match.RacerList do
		local player = racer.Player
		if player and player.Parent then
			player:SetAttribute("InRace", false)
			if requeue then
				local profile = services.PlayerDataService:GetProfile(player)
				if profile and profile.Settings.AutoRequeue then
					services.MatchmakingService:Join(player, match.Mode)
				end
			end
		end
	end
end

function RoundService:_emergencyCleanup()
	local match = self.Match
	if not match then
		return
	end
	match.Ended = true
	for _, racer in match.RacerList do
		local player = racer.Player
		if player and player.Parent then
			pcall(function()
				self:_returnToLobby(player)
			end)
		end
	end
	pcall(function()
		self:_cleanupMatch(match, false)
	end)
	self.Match = nil
end

------------------------------------------------------------------------
-- Renn-Tick
------------------------------------------------------------------------

function RoundService:_createRacerFolder(racer)
	local folder = Instance.new("Configuration")
	folder.Name = tostring(racer.UserId)
	folder:SetAttribute("UserId", racer.UserId)
	folder:SetAttribute("Name", racer.Name)
	folder:SetAttribute("Status", racer.Status)
	folder:SetAttribute("Placement", racer.Placement)
	folder:SetAttribute("Progress", 0)
	folder:SetAttribute("DangerTime", 0)
	folder:SetAttribute("Checkpoint", 1)
	folder:SetAttribute("Respawns", 0)
	folder.Parent = self.RacersFolder
	racer.Folder = folder
end

function RoundService:_raceTick(match, dt: number)
	if match.Ended then
		return
	end
	local services = self.Services
	local map = match.Map
	for _, racer in match.RacerList do
		if racer.Status == "Racing" and racer.Player then
			local root = services.CharacterService:GetRoot(racer.Player)
			if root then
				local position = root.Position
				local previous = racer.LastPosition
				racer.LastPosition = position
				if previous then
					racer.Distance += math.max(0, position.X - previous.X)
				end
				local checkpointIndex = services.MapService:FindCheckpointIndex(map, position.X)
				if checkpointIndex > racer.Checkpoint then
					racer.Checkpoint = checkpointIndex
				end
				if not racer.RespawnLock then
					local hit, kind = services.MapService:IsInHazard(map, position, previous)
					if hit then
						self:_respawnRacer(match, racer, kind or "Hazard")
					end
				end
				if map.FinishX and position.X >= map.FinishX and racer.Checkpoint >= #map.Checkpoints and not racer.RespawnLock then
					self:_finish(match, racer)
					return
				end
			end
		end
	end

	for _, racer in services.HazardRingService:Update(match, dt) do
		self:_eliminate(match, racer, "Zone")
		if match.Ended then
			return
		end
	end

	self:_updateStandings(match)

	if now() >= match.StartedAt + Config.Round.MaxRaceTime then
		self:_endMatch(match, "Timeout")
		return
	end
	self:_checkEnd(match)
end

function RoundService:_updateStandings(match)
	local alive = {}
	for _, racer in match.RacerList do
		if racer.Status == "Racing" then
			table.insert(alive, racer)
		end
	end
	table.sort(alive, function(a, b)
		local ax = a.LastPosition and a.LastPosition.X or -math.huge
		local bx = b.LastPosition and b.LastPosition.X or -math.huge
		return ax > bx
	end)
	for index, racer in alive do
		racer.Placement = index
	end
	match.AliveCount = #alive
	self.State:SetAttribute("Alive", #alive)
	local startX = match.Map.StartX
	for _, racer in match.RacerList do
		local folder = racer.Folder
		if folder then
			folder:SetAttribute("Status", racer.Status)
			folder:SetAttribute("Placement", racer.Placement or 0)
			if racer.LastPosition then
				folder:SetAttribute("Progress", math.floor(racer.LastPosition.X - startX))
			end
			folder:SetAttribute("DangerTime", math.floor(racer.DangerTime * 10) / 10)
			folder:SetAttribute("Checkpoint", racer.Checkpoint)
			folder:SetAttribute("Respawns", racer.Respawns)
		end
	end
end

function RoundService:_respawnRacer(match, racer, reason: string)
	if racer.RespawnLock or racer.Status ~= "Racing" or not racer.Player then
		return
	end
	local services = self.Services
	local player = racer.Player
	local map = match.Map
	racer.RespawnLock = true
	racer.Respawns += 1
	local checkpoint = map.Checkpoints[racer.Checkpoint] or map.Checkpoints[1]
	Remotes.GameEvent:FireAllClients("RacerRespawn", {
		UserId = racer.UserId,
		From = racer.LastPosition,
		To = checkpoint.CFrame.Position,
		Reason = reason,
	})
	services.CharacterService:Teleport(player, checkpoint.CFrame)
	services.CharacterService:SetFrozen(player, true)
	racer.LastPosition = checkpoint.CFrame.Position
	task.delay(Config.Round.RespawnFreezeTime, function()
		racer.RespawnLock = false
		if racer.Status == "Racing" and racer.Player and not match.Ended then
			services.CharacterService:SetFrozen(racer.Player, false)
		end
	end)
end

function RoundService:_eliminate(match, racer, reason: string, leavingPlayer: Player?)
	if racer.Status ~= "Racing" or match.Ended then
		return
	end
	local services = self.Services
	racer.Placement = self:_aliveCount(match)
	racer.Status = if reason == "Left" then "Left" else "Eliminated"
	racer.EliminatedAt = now()
	local player = racer.Player or leavingPlayer
	Remotes.GameEvent:FireAllClients("RacerEliminated", {
		UserId = racer.UserId,
		Name = racer.Name,
		Placement = racer.Placement,
		Position = racer.LastPosition,
		Reason = reason,
	})
	if racer.Folder then
		racer.Folder:SetAttribute("Status", racer.Status)
		racer.Folder:SetAttribute("Placement", racer.Placement)
	end
	if reason == "Left" then
		if match.Mode == "Ranked" then
			services.RankedService:ApplyLeavePenalty(match, racer, player)
		end
	elseif player then
		services.GrappleService:Release(player, true)
		services.PowerUpService:ClearPlayer(player)
		services.CharacterService:SetFrozen(player, true)
		task.delay(1.2, function()
			if player.Parent and racer.Player == player and player:GetAttribute("InRace") then
				self:_returnToLobby(player)
			end
		end)
	end
	self:_checkEnd(match)
end

function RoundService:_finish(match, racer)
	if match.Ended or racer.Status ~= "Racing" then
		return
	end
	racer.Status = "Finished"
	racer.FinishTime = now() - match.StartedAt
	Remotes.GameEvent:FireAllClients("RacerFinished", {
		UserId = racer.UserId,
		Name = racer.Name,
		Time = racer.FinishTime,
	})
	self:_endMatch(match, "Finish")
end

function RoundService:_checkEnd(match)
	if match.Ended then
		return
	end
	local alive = {}
	for _, racer in match.RacerList do
		if racer.Status == "Racing" then
			table.insert(alive, racer)
		end
	end
	if #alive == 0 then
		self:_endMatch(match, "NoRacers")
	elseif match.Participants >= 2 and #alive == 1 then
		self:_endMatch(match, "LastStanding")
	end
end

--- Beendet das Match genau einmal: Platzierungen, Belohnungen, Ergebnisse.
function RoundService:_endMatch(match, reason: string)
	if match.Ended then
		return
	end
	match.Ended = true
	match.EndReason = reason
	match.Duration = now() - match.StartedAt
	local services = self.Services
	services.HazardRingService:Reset()

	-- Endplatzierungen der noch nicht ausgeschiedenen Spieler
	local standing = {}
	for _, racer in match.RacerList do
		if racer.Status == "Racing" or racer.Status == "Finished" then
			table.insert(standing, racer)
		end
	end
	table.sort(standing, function(a, b)
		if (a.Status == "Finished") ~= (b.Status == "Finished") then
			return a.Status == "Finished"
		end
		local ax = a.LastPosition and a.LastPosition.X or -math.huge
		local bx = b.LastPosition and b.LastPosition.X or -math.huge
		return ax > bx
	end)
	for index, racer in standing do
		racer.Placement = index
		if racer.Status == "Racing" then
			racer.Status = "Survived"
		end
	end
	local winner = standing[1]
	match.Winner = winner

	-- Belohnungen (serverseitig, einmalig pro Match und Spieler)
	local summaries = {}
	local ok, err = pcall(function()
		summaries = services.RewardService:GrantMatchRewards(match)
	end)
	if not ok then
		warn("[RoundService] Belohnungen fehlgeschlagen: " .. tostring(err))
	end
	if match.Mode == "Ranked" then
		local rankedOk, rankedErr = pcall(function()
			services.RankedService:ApplyMatch(match, summaries)
		end)
		if not rankedOk then
			warn("[RoundService] Ranked-Wertung fehlgeschlagen: " .. tostring(rankedErr))
		end
	end
	pcall(function()
		services.LeaderboardService:OnMatchEnded(match)
	end)

	local results = {}
	for _, racer in match.RacerList do
		local summary = summaries[racer.UserId]
		table.insert(results, {
			UserId = racer.UserId,
			Name = racer.Name,
			Placement = racer.Placement or #match.RacerList,
			Status = racer.Status,
			Time = racer.FinishTime,
			Progress = if racer.LastPosition then math.floor(racer.LastPosition.X - match.Map.StartX) else 0,
			Respawns = racer.Respawns,
			RatingChange = if summary then summary.RatingChange else nil,
		})
	end
	table.sort(results, function(a, b)
		return a.Placement < b.Placement
	end)
	self:_updateStandings(match)

	self:_setPhase("Results", now() + Config.Round.ResultsDuration)

	-- Alle verbleibenden Rennfahrer anhalten, Effekte bereinigen
	for _, racer in match.RacerList do
		local player = racer.Player
		if player and player.Parent and player:GetAttribute("InRace") then
			services.GrappleService:Release(player, true)
			services.PowerUpService:ClearPlayer(player)
			services.CharacterService:SetFrozen(player, true)
		end
	end
	services.MapService:ResetRaceMap()

	-- Siegesanimation
	if winner and winner.Player and winner.Player.Parent then
		local character = winner.Player.Character
		local equipped = services.InventoryService:GetEquipped(winner.Player)
		local victoryId = if equipped.Victory ~= "" then equipped.Victory else "Default"
		if character then
			character:SetAttribute("Victory", victoryId)
			character:SetAttribute("VictoryAt", now())
		end
	end

	for _, player in Players:GetPlayers() do
		Remotes.GameEvent:FireClient(player, "MatchResults", {
			MatchId = match.Id,
			MapId = match.MapId,
			Mode = match.Mode,
			Reason = reason,
			Duration = match.Duration,
			WinnerUserId = if winner then winner.UserId else 0,
			Results = results,
			Rewards = summaries[player.UserId],
		})
	end
end

return RoundService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--[[
	ShopService  (ModuleScript)
	Pfad: ServerScriptService/Server/Services/ShopService

	Verarbeitet Shop-Anfragen (RemoteFunction "ShopRequest"):
		("Buy", category, itemId)     -> kaufen (Coins prüfen, doppelte Käufe verhindern)
		("Equip", category, itemId)   -> ausrüsten (Besitz prüfen)
		("Unequip", category)         -> ablegen

	Rückgabe immer: { Ok = boolean, Message = string }

	Sicherheit:
		- Preis/Level kommen ausschließlich aus CosmeticDefinitions (Server).
		- Kauf läuft ohne Yield zwischen Prüfung und Abbuchung (atomar).
		- Pro Spieler Sperre gegen parallele Anfragen + Rate-Limit.
		- Kein Pay-to-Win: nur Kosmetik, nur Coins aus dem Spiel.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local CosmeticDefinitions = require(Shared.CosmeticDefinitions)
local Remotes = require(Shared.Remotes)

local RateLimiter = require(script.Parent.Parent.Modules.RateLimiter)

local ShopService = {}

function ShopService:Init(services)
	self.Services = services
	self.Busy = {}
	self.Limiter = RateLimiter.ForRemote("ShopRequest")
end

function ShopService:Start()
	Remotes.ShopRequest.OnServerInvoke = function(player, action, category, itemId)
		if not self.Limiter:Check(player) then
			return { Ok = false, Message = "Zu viele Anfragen – bitte kurz warten." }
		end
		if self.Busy[player] then
			return { Ok = false, Message = "Vorherige Anfrage läuft noch." }
		end
		self.Busy[player] = true
		local ok, result = pcall(function()
			return self:_handle(player, action, category, itemId)
		end)
		self.Busy[player] = nil
		if not ok then
			warn("[ShopService] Fehler: " .. tostring(result))
			return { Ok = false, Message = "Interner Fehler. Bitte erneut versuchen." }
		end
		return result
	end
end

function ShopService:OnPlayerRemoving(player: Player)
	self.Busy[player] = nil
end

function ShopService:_handle(player: Player, action: any, category: any, itemId: any)
	if type(action) ~= "string" or not CosmeticDefinitions.IsCategory(category) then
		return { Ok = false, Message = "Ungültige Anfrage." }
	end
	local inventory = self.Services.InventoryService
	if action == "Buy" then
		return self:_buy(player, category, itemId)
	elseif action == "Equip" then
		local ok, message = inventory:Equip(player, category, itemId)
		return { Ok = ok, Message = message or "Ausgerüstet." }
	elseif action == "Unequip" then
		local ok, message = inventory:Unequip(player, category)
		return { Ok = ok, Message = message or "Abgelegt." }
	end
	return { Ok = false, Message = "Unbekannte Aktion." }
end

function ShopService:_buy(player: Player, category: string, itemId: any)
	if type(itemId) ~= "string" then
		return { Ok = false, Message = "Ungültiges Item." }
	end
	local item = CosmeticDefinitions.Get(category, itemId)
	if not item then
		return { Ok = false, Message = "Dieses Item existiert nicht." }
	end
	local services = self.Services
	local profile = services.PlayerDataService:GetProfile(player)
	if not profile then
		return { Ok = false, Message = "Profil wird noch geladen." }
	end
	if services.InventoryService:Owns(player, category, itemId) then
		return { Ok = false, Message = "Du besitzt dieses Item bereits." }
	end
	if item.LevelRequired and profile.Level < item.LevelRequired then
		return { Ok = false, Message = string.format("Benötigt Level %d.", item.LevelRequired) }
	end
	local price = item.Price or 0
	-- Prüfung + Abbuchung + Gutschrift ohne Yield (atomar im Server-Thread)
	local ok, err = services.EconomyService:TrySpend(player, price, "Shop:" .. category .. ":" .. itemId)
	if not ok then
		return { Ok = false, Message = err or "Kauf fehlgeschlagen." }
	end
	services.InventoryService:Grant(player, category, itemId)
	services.RewardService:CheckAchievements(player)
	return { Ok = true, Message = string.format("%s gekauft!", item.Name) }
end

return ShopService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="38">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
    <Item class="Folder" referent="39">
      <Properties>
        <string name="Name">MapTemplates</string>
      </Properties>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">GlacierCircuit</string>
          <string name="Source"><![CDATA[--[[
	GlacierCircuit  (ModuleScript)
	Pfad: ServerStorage/MapTemplates/GlacierCircuit

	Eisige Strecke: Rutschige Eisflächen erhalten Momentum, verlangen aber
	frühes Abbremsen. Eiszapfen-Tunnel sind tödlich, wenn man nicht rutscht.
]]

return function(B)
	B:Start(60)
	B:IceRun(70)
	B:Gap(B:D(14), 0, 30)
	B:IceRun(50)
	B:SlideTunnel(30, { Lethal = true })
	B:PickupRow(3)
	B:Steps(3, 4, 14)
	B:IceRun(60)
	B:GrappleGap(B:D(54), { AnchorHeight = 24 })
	B:Ramp(40, -10)
	B:IceRun(80)
	B:Pit(B:D(36), { Pillars = 2, Landing = 30 })
	B:TimedBarrier(36, { Period = 2.4, OnTime = 1.0 })
	B:Split({
		Length = 260,
		Depth = 28,
		Upper = function(b)
			b:Flat(8)
			b:GrappleGap(58, { Landing = 20 })
			b:IceRun(40)
			b:GrappleGap(62, { Anchors = 2, Landing = 30 })
		end,
		Lower = function(b)
			b:IceRun(50)
			b:SlideTunnel(26, { Lethal = true })
			b:IceRun(30)
			b:Pit(30, { Pillars = 1, Landing = 30 })
			b:Flat(30)
		end,
	})
	B:PickupRow(3)
	B:JumpPadUp(16, 30)
	B:IceRun(50)
	B:GrappleGap(B:D(70), { Anchors = 2, AnchorHeight = 26 })
	B:Drop(12, 30)
	B:BoostStrip(50, 85)
	B:IceRun(60)
	B:Gap(B:D(18), 0, 30)
	B:WallClimb(18, 14)
	B:Flat(30)
	B:Finish(80)
	-- Optik (rein dekorativ): Eistore
	B:Gates(3, B.Theme.Accent, { FrameColor = Color3.fromRGB(196, 228, 250), Material = Enum.Material.Ice })
	B:Decorate()
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">JungleVelocity</string>
          <string name="Source"><![CDATA[--[[
	JungleVelocity  (ModuleScript)
	Pfad: ServerStorage/MapTemplates/JungleVelocity

	Dschungel mit zwei geteilten Abschnitten: Baumkronen-Route (oben, schnell)
	und Waldboden (unten, sicher). Einsteigerfreundlich (Schwierigkeit 1).
]]

return function(B)
	B:Start(60)
	B:Flat(50)
	B:Gap(B:D(12), 0, 30)
	B:Steps(2, 5, 14)
	B:PickupRow(3)
	B:Split({
		Length = 300,
		Depth = 30,
		Upper = function(b)
			b:Flat(10)
			b:GrappleGap(50, { Landing = 20 })
			b:Gap(14, 3, 20)
			b:GrappleGap(56, { Landing = 20 })
			b:Gap(14, -3, 20)
			b:BoostStrip(40, 85)
		end,
		Lower = function(b)
			b:Flat(30)
			b:Pit(30, { Pillars = 1, Landing = 20 })
			b:SlideTunnel(28)
			b:Flat(20)
			b:Steps(2, 4, 12)
			b:Gap(14, -8, 30)
			b:Flat(30)
		end,
	})
	B:TimedBarrier(36, { Period = 2.6, OnTime = 1.1 })
	B:GrappleGap(B:D(54), { AnchorHeight = 24 })
	B:Ramp(36, 8)
	B:PickupRow(2)
	B:Pit(B:D(40), { Pillars = 2, Landing = 30 })
	B:WallClimb(18, 14)
	B:Flat(30)
	B:Drop(18, 30)
	B:Split({
		Length = 240,
		Depth = 26,
		Upper = function(b)
			b:Flat(8)
			b:GrappleGap(60, { Anchors = 2, Landing = 20 })
			b:SlideTunnel(20)
			b:GrappleGap(50, { Landing = 30 })
		end,
		Lower = function(b)
			b:Flat(30)
			b:TimedBarrier(30, { Period = 2.2, OnTime = 0.9 })
			b:Pit(32, { Pillars = 2, Landing = 20 })
			b:Flat(40)
		end,
	})
	B:BoostStrip(60, 90)
	B:Gap(B:D(16), 0, 30)
	B:GrappleGap(B:D(64), { Anchors = 2, AnchorHeight = 24 })
	B:Flat(30)
	B:Finish(80)
	-- Optik (rein dekorativ): Holztore und ein Dschungeltempel am anderen Flussufer
	B:Gates(2, B.Theme.Accent2, { FrameColor = Color3.fromRGB(110, 78, 50), Material = Enum.Material.Wood })
	B:Decorate()
	B:Prop("Temple", (B.MinX + B.MaxX) * 0.6, B.MinY - 33, -205, { Scale = 2.2 })
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">Lobby</string>
          <string name="Source"><![CDATA[--[[
	Lobby  (ModuleScript)
	Pfad: ServerStorage/MapTemplates/Lobby

	"Velocity Hub" – die Lobby ist wie die Strecken eine 2.5D-Bühne. Spieler können
	sich während der Wartezeit bewegen, den Greifhaken ausprobieren und Portale nutzen.
	Portale lösen Aktionen aus (Quick Play, Ranked, Training), wenn man darin stehen
	bleibt. Dieselben Aktionen gibt es im Lobby-Menü.

	Aufbau (lokales x; Spielebene z = 0, Boden y = 0):
		-172 … -160  Endwand links (dahinter ein Torturm)
		-160 …  -36  Portal-Halle: Quick Play (-130), Ranked (-95), Training (-60);
		             Boost-Pad (-40 … -24) am Übergang zum Startplatz
		 -36 …   36  Startplatz: 8 Spawnpunkte (x -12 … 12.5), Brunnen, Anzeigetafel,
		             Siegerpodest mit Pokal
		  36 …  170  Spielplatz: Sprungpad, schwebende Plattformen (y 8 / 15 / 22),
		             2 Greifhaken-Anker, Wall-Jump-Schacht zwischen Wand (120–122) und
		             Block (136–140), Gipfel auf y = 48
		 170 …  182  Endwand rechts (dahinter ein Torturm)

	Optik (rein dekorativ – keine Kollision, keine Abfragen, alles über B:Deco):
		- Spielebene: Bodenbeläge je Bereich, Namensschild "VELOCITY HUB" (unter den
		  Spawns, zwischen den Rippen von Decorate) und Fensterreihe auf der
		  Bodenvorderseite, Leuchtfelder unter den Portalen, Zierleisten an Endwänden,
		  Kletterwand und Block
		- Terrasse hinter der Spur in zwei Stufen (z -5 … -15 auf y = 0, z -15 … -24
		  auf y = 3) mit Brunnen, Podest, Anzeigetafel, Bänken, Pflanzkübeln, Palmen,
		  Laternen, Wimpelkette und Glasgeländer
		- Grünstreifen aus Terrain (z -25 … -35) mit Hügeln und Bäumen, Wolken
		- Decorate(): automatische Bodenverzierung (Lippe, Leuchtkante, Rippen, Stützen)
		  und Hintergrund "Hub" (Türme, Bucht, Holo-Ringe, Lichtsäulen); Requisiten
		  setzt diese Vorlage selbst (B.AutoProps = false)
	Vor z = +5 liegen nur flache Blenden auf Vorderseiten unterhalb der Oberkanten.
]]

local M = Enum.Material
local NEON = M.Neon
local BALL = Enum.PartType.Ball
local CYL = Enum.PartType.Cylinder
local SPHERE = Enum.MeshType.Sphere
local rgb = Color3.fromRGB

local VERTICAL = CFrame.Angles(0, 0, math.rad(90)) -- Zylinderachse (X) senkrecht stellen
local FACING = CFrame.Angles(0, math.rad(90), 0) -- Zylinderachse zur Kamera (Scheibe)
-- Wimpel: Keil mit gerader Oberkante, Spitze nach unten
local PENNANT = CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(math.rad(180), 0, 0)

local FACE_Z = 5 -- Vorderseite der Spur (Config.World.TrackDepth / 2)
local FRONT_Z = FACE_Z + 0.06 -- flache Blenden auf Vorderseiten

-- Terrasse hinter der Spur
local DECK_X1, DECK_X2 = -240, 252
local LOWER_Z = -15 -- Grenze zwischen unterer (y = 0) und oberer Stufe
local BACK_Z = -24 -- Hinterkante mit Geländer
local UPPER_Y = 3 -- Höhe der oberen Stufe

local WHITE = rgb(255, 255, 255)
local GOLD = rgb(255, 200, 40)
local GREEN = rgb(80, 255, 140)
local WARM = rgb(255, 214, 150)
local STEEL = rgb(40, 44, 66)
local STONE = rgb(228, 230, 242)
local WOOD = rgb(156, 112, 76)
local WATER = rgb(90, 196, 255)
local BLOSSOMS = { rgb(255, 120, 170), rgb(255, 222, 80), rgb(255, 255, 255), rgb(190, 120, 255) }

------------------------------------------------------------------------
-- Hilfsfunktionen
------------------------------------------------------------------------

--- Deko-Teil mit Mittelpunkt (x, y, z) und optionaler Drehung.
local function piece(B, size: Vector3, x: number, y: number, z: number, color: Color3, material, extra, rotation: CFrame?)
	local cframe = CFrame.new(B:W(x, y, z))
	if rotation then
		cframe = cframe * rotation
	end
	return B:Deco(size, cframe, color, material, extra)
end

--- Achsparalleler Deko-Quader zwischen zwei Ecken.
local function block(B, x1: number, y1: number, z1: number, x2: number, y2: number, z2: number, color: Color3, material, extra)
	local size = Vector3.new(math.abs(x2 - x1), math.abs(y2 - y1), math.abs(z2 - z1))
	return piece(B, size, (x1 + x2) / 2, (y1 + y2) / 2, (z1 + z2) / 2, color, material, extra)
end

--- Balken von (ax, ay) nach (bx, by) in der Tiefe z (Symbole, Schnüre, Streifen).
local function bar(B, ax: number, ay: number, bx: number, by: number, z: number, thickness: number, color: Color3, material, name: string?)
	local dx, dy = bx - ax, by - ay
	local length = math.sqrt(dx * dx + dy * dy)
	local size = Vector3.new(length + thickness * 0.5, thickness, 0.3)
	return piece(B, size, (ax + bx) / 2, (ay + by) / 2, z, color, material or NEON, { Name = name or "Emblem" }, CFrame.Angles(0, 0, math.atan2(dy, dx)))
end

--- Leichte zufällige Helligkeitsvariation.
local function jitter(B, color: Color3, amount: number): Color3
	local f = 1 + B.Rng:NextNumber(-amount, amount)
	return Color3.new(math.clamp(color.R * f, 0, 1), math.clamp(color.G * f, 0, 1), math.clamp(color.B * f, 0, 1))
end

local function emitter(parent: Instance, props)
	local e = Instance.new("ParticleEmitter")
	for key, value in props do
		e[key] = value
	end
	e.Parent = parent
	return e
end

--- Text auf der Kameraseite (+Z = NormalId.Back) eines Teils.
--- opts: Font, Color, Stroke (Kontur), Gradient (unterer Farbton), Size, Position, PixelsPerStud
local function surfaceText(part: BasePart, text: string, opts)
	opts = opts or {}
	local gui = part:FindFirstChildOfClass("SurfaceGui")
	if not gui then
		gui = Instance.new("SurfaceGui")
		gui.Name = "Label"
		gui.Face = Enum.NormalId.Back
		gui.LightInfluence = 0
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = opts.PixelsPerStud or 30
		gui.Parent = part
	end
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = opts.Size or UDim2.fromScale(1, 1)
	label.Position = opts.Position or UDim2.fromScale(0, 0)
	label.Font = opts.Font or Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = opts.Color or WHITE
	label.Text = text
	if opts.Stroke then
		local stroke = Instance.new("UIStroke")
		stroke.Color = opts.Stroke
		stroke.Thickness = opts.StrokeThickness or 3
		stroke.Parent = label
	end
	if opts.Gradient then
		local gradient = Instance.new("UIGradient")
		gradient.Color = ColorSequence.new(WHITE, opts.Gradient)
		gradient.Rotation = 90
		gradient.Parent = label
	end
	label.Parent = gui
	return label
end

------------------------------------------------------------------------
-- Bausteine der Kulisse
------------------------------------------------------------------------

--- Zweistufige Terrasse hinter der Spur mit Bordstein und Glasgeländer.
local function terrace(B)
	local theme = B.Theme
	local trim = theme.Trim or STONE
	local body = rgb(46, 50, 84)
	-- untere Stufe (Oberkante knapp unter der Spielebene)
	block(B, DECK_X1, -40, LOWER_Z, DECK_X2, -0.4, -5.05, body, M.Concrete, { Name = "Terrace" })
	block(B, DECK_X1, -0.4, LOWER_Z, DECK_X2, -0.04, -5.05, rgb(150, 156, 200), M.Marble, { Name = "TerraceFloor" })
	block(B, DECK_X1, -0.04, -5.5, DECK_X2, 0.14, -5.05, trim, M.Metal, { Name = "Curb" })
	-- obere Stufe mit Holzdeck, heller Kante und Leuchtlinie am Absatz
	block(B, DECK_X1, -40, BACK_Z, DECK_X2, UPPER_Y - 0.35, LOWER_Z, body, M.Concrete, { Name = "Terrace" })
	block(B, DECK_X1, UPPER_Y - 0.35, BACK_Z, DECK_X2, UPPER_Y, LOWER_Z, WOOD, M.WoodPlanks, { Name = "TerraceDeck" })
	block(B, DECK_X1, UPPER_Y - 0.45, LOWER_Z - 0.05, DECK_X2, UPPER_Y + 0.08, LOWER_Z + 0.3, trim, M.Metal, { Name = "StepTrim" })
	block(B, DECK_X1, 0.55, LOWER_Z, DECK_X2, 0.75, LOWER_Z + 0.08, theme.Accent2 or theme.Accent, NEON, { Name = "StepGlow", Transparency = 0.15 })
	-- Glasgeländer an der Hinterkante
	local gz = BACK_Z + 0.5
	block(B, DECK_X1, UPPER_Y, gz - 0.1, DECK_X2, UPPER_Y + 2.6, gz + 0.1, rgb(170, 220, 255), M.Glass, { Name = "Railing", Transparency = 0.6 })
	block(B, DECK_X1, UPPER_Y + 2.6, gz - 0.25, DECK_X2, UPPER_Y + 2.95, gz + 0.25, trim, M.Metal, { Name = "RailingTop" })
	block(B, DECK_X1, UPPER_Y + 0.05, gz + 0.1, DECK_X2, UPPER_Y + 0.22, gz + 0.2, theme.Accent, NEON, { Name = "RailingGlow", Transparency = 0.2 })
	for x = DECK_X1 + 6, DECK_X2 - 6, 24 do
		block(B, x - 0.25, UPPER_Y, gz - 0.3, x + 0.25, UPPER_Y + 2.9, gz + 0.3, STEEL, M.Metal, { Name = "RailingPost" })
	end
end

--- Grünstreifen aus Terrain hinter dem Geländer (z -25 … -35) mit Hügeln und Bäumen.
local function greenBelt(B)
	local rng = B.Rng
	local x = -310
	while x < 320 do
		local w = math.min(316, 320 - x)
		B:TerrainBlock(x + w / 2, -18, -30, Vector3.new(w, 40, 10), M.Rock)
		B:TerrainBlock(x + w / 2, 3, -30, Vector3.new(w, 4, 10), M.LeafyGrass)
		x += w
	end
	x = -300
	local palm = false
	while x < 310 do
		local r = rng:NextNumber(5, 7.5)
		local cy = rng:NextNumber(1, 3)
		B:TerrainBall(x, cy, -25 - r, r, M.LeafyGrass)
		local top = cy + r * 0.8
		if palm then
			B:Tree(x + rng:NextNumber(-3, 3), top - 1, -30, { Kind = "Palm", Scale = rng:NextNumber(1.5, 1.9) })
		else
			B:Tree(x + rng:NextNumber(-3, 3), top - 1, -30, { Kind = "Round", Scale = rng:NextNumber(1.5, 2.1) })
		end
		palm = not palm
		x += rng:NextNumber(26, 38)
	end
end

--- Torturm hinter einer Endwand (Glasfassade, Stockwerksbänder, Leuchtkanten, Krone).
local function gateTower(B, x1: number, x2: number, accent: Color3)
	local rng = B.Rng
	local front, back, top = -5.6, -32, 118
	block(B, x1, -40, back, x2, top, front, rgb(58, 62, 102), M.Concrete, { Name = "GateTower" })
	block(B, x1 + 3, -36, front, x2 - 3, top - 8, front + 0.1, rgb(46, 60, 108), M.Glass, { Name = "TowerGlass" })
	for y = -32, top - 8, 12 do
		block(B, x1 + 2, y - 0.5, front, x2 - 2, y + 0.5, front + 0.35, rgb(92, 98, 140), M.Metal, { Name = "TowerBand" })
		if rng:NextNumber() < 0.6 then
			local w = rng:NextNumber(8, 20)
			local wx = rng:NextNumber(x1 + 4 + w / 2, x2 - 4 - w / 2)
			block(B, wx - w / 2, y + 3, front + 0.1, wx + w / 2, y + 9, front + 0.18, WARM, NEON, { Name = "TowerWindow", Transparency = 0.25 })
		end
	end
	for _, ex in { x1 + 1, x2 - 1 } do
		block(B, ex - 0.4, -36, front, ex + 0.4, top, front + 0.3, accent, NEON, { Name = "TowerEdge" })
	end
	-- Krone mit Antenne
	block(B, x1 + 6, top, back + 6, x2 - 6, top + 8, front - 4, rgb(52, 56, 92), M.Metal, { Name = "TowerCrown" })
	block(B, x1 + 6, top + 6.4, front - 4, x2 - 6, top + 7.2, front - 3.8, accent, NEON, { Name = "TowerCrownGlow" })
	local ax, az = (x1 + x2) / 2, (front + back) / 2
	piece(B, Vector3.new(24, 0.6, 0.6), ax, top + 20, az, rgb(200, 204, 220), M.Metal, { Name = "TowerAntenna", Shape = CYL }, VERTICAL)
	piece(B, Vector3.new(1.6, 1.6, 1.6), ax, top + 32.5, az, rgb(255, 60, 80), NEON, { Name = "TowerBeacon", Shape = BALL })
end

--- Vorderseite einer Endwand: helle Kanten, eingelassenes Riffelblech-Paneel mit
--- Leuchtstreifen und Pfeilmarken (flach auf der Wand, unterhalb der Oberkante).
local function wallFace(B, x1: number, x2: number, y1: number, y2: number, accent: Color3)
	local trim = B.Theme.Trim or STONE
	local cx = (x1 + x2) / 2
	for _, ex in { x1 + 0.35, x2 - 0.35 } do
		block(B, ex - 0.35, y1, FACE_Z, ex + 0.35, y2, FRONT_Z + 0.02, trim, M.Metal, { Name = "WallTrim" })
	end
	block(B, x1 + 1.6, y1 + 1.5, FACE_Z, x2 - 1.6, y2 - 2, FRONT_Z, rgb(42, 46, 76), M.DiamondPlate, { Name = "WallPanel" })
	block(B, cx - 0.3, y1 + 3, FACE_Z, cx + 0.3, y2 - 4, FRONT_Z + 0.04, accent, NEON, { Name = "WallGlow" })
	for y = 18, y2 - 12, 22 do
		block(B, x1 + 2.4, y - 1.6, FACE_Z, x2 - 2.4, y + 1.6, FRONT_Z + 0.03, STEEL, M.Metal, { Name = "WallPlate" })
		block(B, x1 + 2.8, y - 0.25, FACE_Z, x2 - 2.8, y + 0.25, FRONT_Z + 0.07, accent, NEON, { Name = "WallMark", Transparency = 0.2 })
	end
end

--- Fensterreihe auf der Vorderseite des Hauptbodens (zwischen den Rippen von Decorate).
--- Fenster, die das Namensschild (Mitte cx, halbe Breite skip) berühren, entfallen.
--- colorAt(x) liefert die Lichtfarbe; jedes dritte Fenster bleibt dunkel.
local function floorWindows(B, x1: number, x2: number, cx: number, skip: number, colorAt)
	local index = 0
	for wx = x1, x2, 12 do
		if math.abs(wx - cx) - 4.3 >= skip then
			index += 1
			block(B, wx - 4.3, -7.7, FACE_Z, wx + 4.3, -2.3, FRONT_Z, STEEL, M.Metal, { Name = "FaceWindowFrame" })
			if index % 3 ~= 0 then
				block(B, wx - 3.8, -7.2, FACE_Z, wx + 3.8, -2.8, FRONT_Z + 0.04, colorAt(wx), NEON, { Name = "FaceWindow", Transparency = 0.5 })
			else
				block(B, wx - 3.8, -7.2, FACE_Z, wx + 3.8, -2.8, FRONT_Z + 0.04, rgb(54, 66, 110), M.Glass, { Name = "FaceWindow" })
			end
			block(B, wx - 3.8, -5.15, FACE_Z, wx + 3.8, -4.85, FRONT_Z + 0.07, STEEL, M.Metal, { Name = "FaceWindowBar" })
			block(B, wx - 0.15, -7.2, FACE_Z, wx + 0.15, -2.8, FRONT_Z + 0.07, STEEL, M.Metal, { Name = "FaceWindowBar" })
		end
	end
end

--- Leuchtendes Namensschild "VELOCITY HUB" auf der Bodenvorderseite (Mitte cx, halbe Breite).
local function namePlate(B, cx: number, half: number)
	local theme = B.Theme
	local accent, accent2 = theme.Accent, theme.Accent2 or theme.Accent
	-- etwas weiter vorn als die Rippen von Decorate (z ≤ 5.14), damit diese verdeckt sind
	block(B, cx - half, -8, FACE_Z, cx + half, -2, FRONT_Z + 0.1, STEEL, M.Metal, { Name = "NamePlateFrame" })
	local plate = block(B, cx - half + 0.5, -7.5, FACE_Z, cx + half - 0.5, -2.5, FRONT_Z + 0.14, rgb(30, 22, 70), NEON, { Name = "NamePlate" })
	surfaceText(plate, "VELOCITY HUB", {
		Font = Enum.Font.LuckiestGuy,
		Size = UDim2.fromScale(0.9, 0.78),
		Position = UDim2.fromScale(0.05, 0.12),
		Stroke = rgb(12, 8, 34),
		StrokeThickness = 4,
		Gradient = accent,
		PixelsPerStud = 24,
	})
	block(B, cx - half + 0.5, -2.62, FACE_Z, cx + half - 0.5, -2.38, FRONT_Z + 0.18, accent, NEON, { Name = "NamePlateGlow" })
	block(B, cx - half + 0.5, -7.62, FACE_Z, cx + half - 0.5, -7.38, FRONT_Z + 0.18, accent2, NEON, { Name = "NamePlateGlow" })
end

--- Pflanzkübel mit Hecke und Blüten (y = Standfläche).
local function planter(B, x: number, y: number, z: number, width: number)
	local rng = B.Rng
	local leaf = B.Theme.Leaf or rgb(70, 170, 110)
	block(B, x - width / 2, y, z - 1.3, x + width / 2, y + 1.3, z + 1.3, STONE, M.Concrete, { Name = "Planter" })
	block(B, x - width / 2 - 0.1, y + 1.2, z - 1.4, x + width / 2 + 0.1, y + 1.5, z + 1.4, STEEL, M.Metal, { Name = "PlanterRim" })
	local n = math.max(2, math.floor(width / 1.8))
	for i = 1, n do
		local bx = x - width / 2 + width * (i - 0.5) / n
		local d = rng:NextNumber(2, 2.6)
		piece(B, Vector3.new(d, d, d), bx, y + 1.5 + d * 0.22, z, jitter(B, leaf, 0.12), M.Grass, { Name = "PlanterBush", Shape = BALL })
		if i % 2 == 1 then
			piece(B, Vector3.new(0.6, 0.6, 0.6), bx + 0.3, y + 2.3 + d * 0.2, z + 0.9, BLOSSOMS[rng:NextInteger(1, #BLOSSOMS)], M.SmoothPlastic, { Name = "Blossom", Shape = BALL })
		end
	end
end

--- Parkbank (Holz, Metallbeine), Lehne hinten.
local function bench(B, x: number, y: number, z: number)
	block(B, x - 1.8, y + 0.85, z - 0.55, x + 1.8, y + 1.1, z + 0.55, WOOD, M.WoodPlanks, { Name = "BenchSeat" })
	block(B, x - 1.8, y + 1.25, z - 0.75, x + 1.8, y + 2.05, z - 0.55, WOOD, M.WoodPlanks, { Name = "BenchBack" })
	for _, side in { -1, 1 } do
		block(B, x + side * 1.5 - 0.12, y, z - 0.7, x + side * 1.5 + 0.12, y + 0.85, z + 0.5, STEEL, M.Metal, { Name = "BenchLeg" })
	end
end

--- Brunnen mit Wasserspiel (Mitte x, z; steht auf y = 0).
local function fountain(B, x: number, z: number)
	local accent = B.Theme.Accent
	piece(B, Vector3.new(1.4, 10, 10), x, 0.7, z, STONE, M.Marble, { Name = "FountainBasin", Shape = CYL }, VERTICAL)
	piece(B, Vector3.new(0.14, 10.3, 10.3), x, 1.05, z, accent, NEON, { Name = "FountainRim", Shape = CYL }, VERTICAL)
	piece(B, Vector3.new(0.2, 9, 9), x, 1.35, z, WATER, M.Glass, {
		Name = "FountainWater",
		Shape = CYL,
		Transparency = 0.25,
		Light = { Range = 14, Brightness = 1.2, Color = WATER },
	}, VERTICAL)
	piece(B, Vector3.new(4, 1.2, 1.2), x, 3.4, z, STONE, M.Marble, { Name = "FountainColumn", Shape = CYL }, VERTICAL)
	piece(B, Vector3.new(0.6, 4.4, 4.4), x, 5.3, z, STONE, M.Marble, { Name = "FountainBowl", Shape = CYL }, VERTICAL)
	piece(B, Vector3.new(0.16, 3.8, 3.8), x, 5.62, z, WATER, M.Glass, { Name = "FountainWater", Shape = CYL, Transparency = 0.2 }, VERTICAL)
	local spout = piece(B, Vector3.new(0.9, 0.9, 0.9), x, 6.1, z, WATER, M.Glass, { Name = "FountainSpout", Shape = BALL, Transparency = 0.15 })
	emitter(spout, {
		Rate = 26,
		Lifetime = NumberRange.new(0.9, 1.3),
		Speed = NumberRange.new(9, 12),
		SpreadAngle = Vector2.new(14, 14),
		Acceleration = Vector3.new(0, -26, 0),
		EmissionDirection = Enum.NormalId.Top,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0.15) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 0.9) }),
		Color = ColorSequence.new(WHITE, rgb(150, 220, 255)),
		LightEmission = 0.35,
	})
end

--- Pokal (y = Standfläche, s = Größe).
local function trophy(B, x: number, y: number, z: number, s: number)
	local gold = rgb(255, 196, 46)
	piece(B, Vector3.new(2.6 * s, 0.9 * s, 2.6 * s), x, y + 0.45 * s, z, rgb(36, 38, 58), M.Marble, { Name = "TrophyBase" })
	piece(B, Vector3.new(2.7 * s, 0.14 * s, 0.1), x, y + 0.45 * s, z + 1.32 * s, gold, NEON, { Name = "TrophyPlate" })
	piece(B, Vector3.new(1.4 * s, 0.6 * s, 0.6 * s), x, y + 1.6 * s, z, gold, M.Metal, { Name = "TrophyStem", Shape = CYL }, VERTICAL)
	piece(B, Vector3.new(1 * s, 1 * s, 1 * s), x, y + 2.3 * s, z, gold, M.Metal, { Name = "TrophyKnot", Shape = BALL })
	local cup = piece(B, Vector3.new(3.2 * s, 2.8 * s, 3.2 * s), x, y + 3.7 * s, z, gold, M.Metal, {
		Name = "TrophyCup",
		Mesh = SPHERE,
		Light = { Range = 16, Brightness = 1.4, Color = GOLD },
	})
	cup.Reflectance = 0.2
	piece(B, Vector3.new(1.5 * s, 3.2 * s, 3.2 * s), x, y + 4.75 * s, z, gold, M.Metal, { Name = "TrophyCup", Shape = CYL }, VERTICAL)
	piece(B, Vector3.new(0.3 * s, 3.5 * s, 3.5 * s), x, y + 5.5 * s, z, rgb(255, 226, 120), M.Metal, { Name = "TrophyRim", Shape = CYL }, VERTICAL)
	for _, side in { -1, 1 } do
		local hx = x + side * 1.95 * s
		bar(B, x + side * 1.4 * s, y + 5 * s, hx, y + 5 * s, z, 0.4 * s, gold, M.Metal, "TrophyHandle")
		bar(B, hx, y + 5 * s, hx, y + 3.6 * s, z, 0.4 * s, gold, M.Metal, "TrophyHandle")
		bar(B, hx, y + 3.6 * s, x + side * 1.2 * s, y + 3.3 * s, z, 0.4 * s, gold, M.Metal, "TrophyHandle")
	end
	piece(B, Vector3.new(0.75 * s, 0.75 * s, 0.75 * s), x, y + 3.9 * s, z + 1.45 * s, B.Theme.Accent2 or GOLD, NEON, { Name = "TrophyGem", Shape = BALL })
	emitter(cup, {
		Rate = 5,
		Lifetime = NumberRange.new(1, 1.6),
		Speed = NumberRange.new(0.5, 1.5),
		SpreadAngle = Vector2.new(180, 180),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3 * s), NumberSequenceKeypoint.new(1, 0) }),
		Color = ColorSequence.new(rgb(255, 250, 210), GOLD),
		LightEmission = 1,
	})
end

--- Siegerpodest (1 / 2 / 3) mit Pokal auf dem Siegertreppchen.
local function podium(B, x: number, z: number)
	block(B, x - 7.2, 0, z - 2.4, x + 7.2, 0.35, z + 2.4, STEEL, M.Metal, { Name = "PodiumBase" })
	for _, step in { { -4.6, 3, rgb(206, 212, 230), "2" }, { 0, 4.6, GOLD, "1" }, { 4.6, 2, rgb(214, 140, 80), "3" } } do
		local sx, h = x + step[1], step[2]
		local part = block(B, sx - 2.2, 0.35, z - 2, sx + 2.2, h, z + 2, step[3], M.Metal, { Name = "Podium" })
		block(B, sx - 2.25, h - 0.14, z + 1.96, sx + 2.25, h + 0.02, z + 2.06, WHITE, NEON, { Name = "PodiumEdge" })
		surfaceText(part, step[4], { Color = rgb(30, 30, 44), PixelsPerStud = 40 })
	end
	trophy(B, x, 4.6, z, 1.05)
	B:Sign(x, 15, "WERDE CHAMPION!", nil, { Style = "Banner", Width = 17, Height = 3.4, Z = z, Color = GOLD })
end

--- Anzeigetafel mit Spieltitel (auf der oberen Terrassenstufe).
local function titleBoard(B, cx: number, z: number)
	local theme = B.Theme
	local accent, accent2 = theme.Accent, theme.Accent2 or theme.Accent
	local x1, x2, y1, y2 = cx - 25, cx + 25, 14, 31
	for _, side in { -1, 1 } do
		local px = cx + side * 19
		block(B, px - 1, UPPER_Y, z - 1.4, px + 1, y1 - 0.5, z - 0.2, STEEL, M.Metal, { Name = "BoardLeg" })
		block(B, px - 0.15, UPPER_Y + 1, z - 0.2, px + 0.15, y1 - 1.5, z - 0.12, accent, NEON, { Name = "BoardLegGlow" })
	end
	block(B, x1 - 1.2, y1 - 1.2, z - 1.6, x2 + 1.2, y2 + 1.2, z - 0.4, STEEL, M.Metal, { Name = "BoardFrame" })
	-- Bildschirm in drei Tönen (Verlauf), Titel als SurfaceGui
	local h = (y2 - y1) / 3
	block(B, x1, y1 + 2 * h, z - 0.4, x2, y2, z - 0.2, rgb(52, 34, 108), NEON, { Name = "BoardScreen" })
	block(B, x1, y1 + h, z - 0.4, x2, y1 + 2 * h, z - 0.2, rgb(38, 28, 86), NEON, { Name = "BoardScreen" })
	block(B, x1, y1, z - 0.4, x2, y1 + h, z - 0.2, rgb(28, 22, 66), NEON, { Name = "BoardScreen" })
	local face = block(B, x1, y1, z - 0.2, x2, y2, z - 0.16, WHITE, M.SmoothPlastic, {
		Name = "BoardText",
		Transparency = 1,
		Light = { Range = 30, Brightness = 1.2, Color = accent },
	})
	surfaceText(face, "VELOCITY RUSH", {
		Font = Enum.Font.LuckiestGuy,
		Size = UDim2.fromScale(0.92, 0.5),
		Position = UDim2.fromScale(0.04, 0.12),
		Stroke = rgb(14, 10, 40),
		StrokeThickness = 6,
		Gradient = accent,
		PixelsPerStud = 24,
	})
	surfaceText(face, "MULTIPLAYER-SPEEDRACE", {
		Font = Enum.Font.FredokaOne,
		Size = UDim2.fromScale(0.6, 0.16),
		Position = UDim2.fromScale(0.2, 0.68),
		Color = accent2,
		Stroke = rgb(14, 10, 40),
	})
	-- Leuchtrahmen
	block(B, x1 - 0.4, y2, z - 0.25, x2 + 0.4, y2 + 0.4, z - 0.1, accent, NEON, { Name = "BoardGlow" })
	block(B, x1 - 0.4, y1 - 0.4, z - 0.25, x2 + 0.4, y1, z - 0.1, accent2, NEON, { Name = "BoardGlow" })
	for _, ex in { x1 - 0.2, x2 + 0.2 } do
		block(B, ex - 0.2, y1, z - 0.25, ex + 0.2, y2, z - 0.1, accent2, NEON, { Name = "BoardGlow" })
	end
	for _, ex in { x1, x2 } do
		for _, ey in { y1, y2 } do
			block(B, ex - 0.9, ey - 0.9, z - 0.3, ex + 0.9, ey + 0.9, z - 0.05, GOLD, NEON, { Name = "BoardCorner" })
		end
	end
end

--- Wimpelkette zwischen (x1, y) und (x2, y) mit Durchhang `sag`.
local function pennants(B, x1: number, x2: number, y: number, sag: number, z: number)
	local theme = B.Theme
	local colors = { theme.Accent, WHITE, theme.Accent2 or theme.Accent, GOLD }
	local function yAt(t)
		return y - sag * 4 * t * (1 - t)
	end
	local segments = 6
	for i = 0, segments - 1 do
		local ta, tb = i / segments, (i + 1) / segments
		bar(B, x1 + (x2 - x1) * ta, yAt(ta), x1 + (x2 - x1) * tb, yAt(tb), z, 0.12, rgb(230, 230, 240), M.Fabric, "PennantRope")
	end
	local count = math.floor((x2 - x1) / 3.4)
	for i = 1, count do
		local t = (i - 0.5) / count
		piece(B, Vector3.new(0.1, 1.5, 1.4), x1 + (x2 - x1) * t, yAt(t) - 0.8, z, colors[(i - 1) % #colors + 1], M.Fabric, { Name = "Pennant", Wedge = true }, PENNANT)
	end
end

--- Luftballons an Schnüren (x, y = Befestigungspunkt).
local function balloons(B, x: number, y: number, z: number)
	local theme = B.Theme
	local colors = { theme.Accent2 or theme.Accent, GOLD, theme.Accent, rgb(150, 110, 255), WHITE }
	for i, color in colors do
		local bx = x + (i - 3) * 1.25 + B.Rng:NextNumber(-0.3, 0.3)
		local by = y + 6.5 + (i % 2) * 1.3 + B.Rng:NextNumber(-0.3, 0.3)
		piece(B, Vector3.new(1.7, 2.1, 1.7), bx, by, z, color, M.SmoothPlastic, { Name = "Balloon", Mesh = SPHERE })
		bar(B, x, y, bx, by - 1, z, 0.06, WHITE, M.SmoothPlastic, "BalloonString")
	end
end

------------------------------------------------------------------------
-- Portale
------------------------------------------------------------------------

--- Symbol "Blitz" (Quick Play).
local function emblemBolt(B, x: number, y: number, z: number, color: Color3)
	bar(B, x + 1, y + 2.5, x - 0.6, y, z, 0.85, color)
	bar(B, x - 0.6, y, x + 0.6, y, z, 0.85, color)
	bar(B, x + 0.6, y, x - 1, y - 2.5, z, 0.85, color)
end

--- Symbol "Krone" (Ranked).
local function emblemCrown(B, x: number, y: number, z: number, color: Color3)
	local points = { { -2.1, -1.4 }, { -2.1, 1.5 }, { -1, 0.1 }, { 0, 2 }, { 1, 0.1 }, { 2.1, 1.5 }, { 2.1, -1.4 } }
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		bar(B, x + a[1], y + a[2], x + b[1], y + b[2], z, 0.6, color)
	end
	bar(B, x - 2.1, y - 1.4, x + 2.1, y - 1.4, z, 0.9, color)
	for _, tip in { points[2], points[4], points[6] } do
		piece(B, Vector3.new(0.85, 0.85, 0.85), x + tip[1], y + tip[2] + 0.2, z + 0.1, WHITE, NEON, { Name = "Emblem", Shape = BALL })
	end
end

--- Symbol "Zielscheibe" (Training).
local function emblemTarget(B, x: number, y: number, z: number, color: Color3)
	piece(B, Vector3.new(0.1, 5, 5), x, y, z, color, NEON, { Name = "Emblem", Shape = CYL }, FACING)
	piece(B, Vector3.new(0.1, 3.6, 3.6), x, y, z + 0.08, STEEL, M.Metal, { Name = "Emblem", Shape = CYL }, FACING)
	piece(B, Vector3.new(0.1, 2.3, 2.3), x, y, z + 0.16, color, NEON, { Name = "Emblem", Shape = CYL }, FACING)
	piece(B, Vector3.new(0.1, 0.9, 0.9), x, y, z + 0.24, WHITE, NEON, { Name = "Emblem", Shape = CYL }, FACING)
end

--- Portal mit großem Torbogen, Symbol-Medaillon, Leuchtfeld und Fahne.
local function portalGate(B, px: number, action: string, label: string, color: Color3, emblem)
	B:Portal(px, 0, action, label, color)
	B:Arch(px, 0, 19, 20, color, { Z = -8.6, Depth = 2.2, FrameColor = rgb(46, 50, 80) })
	local my, mz = 26.4, -8.4
	block(B, px - 0.7, 22.2, mz - 0.9, px + 0.7, my - 3.2, mz + 0.1, STEEL, M.Metal, { Name = "MedallionStem" })
	piece(B, Vector3.new(0.5, 7.2, 7.2), px, my, mz - 0.3, STEEL, M.Metal, { Name = "Medallion", Shape = CYL }, FACING)
	piece(B, Vector3.new(0.3, 8.2, 8.2), px, my, mz - 0.6, color, NEON, { Name = "MedallionRim", Shape = CYL }, FACING)
	emblem(B, px, my, mz + 0.05, color:Lerp(WHITE, 0.45))
	-- Standfläche: Leuchtfeld auf dem Boden, farbiger Streifen auf der Bodenvorderseite
	block(B, px - 5, 0.01, -4.6, px + 5, 0.07, 4.6, color, NEON, { Name = "PortalPad", Transparency = 0.65 })
	block(B, px - 5, -1.42, FACE_Z, px + 5, -1.02, FRONT_Z + 0.04, color, NEON, { Name = "PortalStrip" })
	B:Banner(px + 12.5, 0, color, { Height = 14, Width = 3.2, Z = -7, Color2 = WHITE })
end

------------------------------------------------------------------------
-- Aufbau
------------------------------------------------------------------------

return function(B)
	local theme = B.Theme
	local accent, accent2 = theme.Accent, theme.Accent2 or theme.Accent
	local wallMaterial = theme.WallMaterial or theme.GroundMaterial
	B.AutoCheckpoints = false
	B.AutoProps = false -- Requisiten werden unten von Hand gesetzt

	-- Boden -160 … 170 in drei Bereichen (gleiche Kollision wie ein durchgehender Boden;
	-- für Decorate ein Lauf: Rippen alle 12 Studs ab x = -154, also bei -10, 2, 14 …)
	B:Ground(-160, -36, 0, { Thickness = 12, TopColor = rgb(92, 98, 150), TopMaterial = M.Marble })
	B:Ground(-36, 36, 0, { Thickness = 12, TopColor = rgb(132, 138, 190), TopMaterial = M.Marble })
	B:Ground(36, 170, 0, { Thickness = 12, TopColor = rgb(70, 92, 140), TopMaterial = M.Pavement })
	B:Box(-172, -12, -160, 95, { Name = "Wall", Color = theme.Wall, Material = wallMaterial })
	B:Box(170, -12, 182, 95, { Name = "Wall", Color = theme.Wall, Material = wallMaterial })

	-- Startplatz
	for i = 0, 7 do
		B:SpawnPoint(-12 + i * 3.5, 0)
	end

	-- Portal-Halle
	portalGate(B, -130, "QuickPlay", "SCHNELLES SPIEL", accent, emblemBolt)
	portalGate(B, -95, "Ranked", "RANKED", GOLD, emblemCrown)
	portalGate(B, -60, "Practice", "TRAINING", GREEN, emblemTarget)
	B:BoostPad(-40, -24, 0, 70)

	-- Parkour-Spielplatz zum Aufwärmen
	B:JumpPad(24, 0, 75)
	B:Ground(34, 52, 8, { Thickness = 2, TopColor = rgb(240, 170, 60), TopMaterial = M.Plastic })
	B:Ground(60, 78, 15, { Thickness = 2, TopColor = rgb(230, 80, 140), TopMaterial = M.Plastic })
	B:Ground(86, 104, 22, { Thickness = 2, TopColor = rgb(40, 180, 230), TopMaterial = M.Plastic })
	B:Anchor(72, 42)
	B:Anchor(112, 46)
	B:Box(120, 9, 122, 60, { Name = "WallJumpWall", Color = theme.Wall, Material = wallMaterial })
	B:Box(136, 0, 140, 48, { Name = "WallJumpBlock", Color = theme.Wall, Material = wallMaterial })
	B:Ground(136, 170, 48, { Thickness = 2, TopColor = rgb(90, 200, 120), TopMaterial = M.Plastic })
	B:Sign(66, 32, "GREIFHAKEN", "E / Maus halten: schwingen · loslassen: abspringen", { Width = 22, Height = 6, Z = -6 })
	B:Sign(108, 34, "WALL-JUMP", "In der Luft gegen die Wand springen", { Width = 18, Height = 6, Z = -6, Color = accent2 })

	------------------------------------------------------------------
	-- Optik (rein dekorativ)
	------------------------------------------------------------------
	terrace(B)
	gateTower(B, -216, -158, accent)
	gateTower(B, 168, 226, accent2)
	wallFace(B, -172, -160, -12, 95, accent)
	wallFace(B, 170, 182, -12, 95, accent2)
	-- Namensschild mittig zwischen den Rippen bei -22 und 26 (deckt -10, 2, 14 ab)
	namePlate(B, 2, 17.6)
	floorWindows(B, -148, 164, 2, 17.6, function(wx)
		if wx < -36 then
			return WARM
		elseif wx < 36 then
			return rgb(150, 230, 255)
		end
		local cycle = { accent2, GOLD, accent }
		return cycle[math.floor((wx - 36) / 12) % #cycle + 1]
	end)

	-- Portal-Halle: zwischen den Torbögen je Laterne, Pflanzkübel, Bank und Palme
	for _, lx in { -145, -112.5, -77.5 } do
		B:Lamp(lx, 0, -6.5)
		planter(B, lx - 4.5, 0, -11, 4)
		B:Tree(lx + 2, UPPER_Y, -19.5, { Kind = "Palm", Scale = 1.5 })
		if lx > -140 then
			bench(B, lx + 4, 0, -11.5)
		end
	end
	B:Arch(-36, 0, 14, 13, accent, { Label = "◀ PORTALE", Z = -7, LabelWidth = 16 })

	-- Startplatz: Brunnen, Anzeigetafel, Podest, Wimpelkette, Palmen
	fountain(B, 0, -10)
	titleBoard(B, 0, -21.4)
	planter(B, -11, UPPER_Y, -17, 7)
	planter(B, 11, UPPER_Y, -17, 7)
	podium(B, -20, -10)
	pennants(B, -29, 31, 13.6, 4, -7.2)
	B:Tree(-31, UPPER_Y, -19.5, { Kind = "Palm", Scale = 1.7 })
	B:Tree(31, UPPER_Y, -19.5, { Kind = "Palm", Scale = 1.7 })
	bench(B, 14, 0, -11.5)
	planter(B, 21, 0, -11, 4)
	B:Arch(38, 0, 14, 13, accent2, { Label = "SPIELPLATZ ▶", Z = -7, LabelWidth = 18 })
	balloons(B, 46.5, 0, -8)

	-- Spielplatz: Klettergerüst, Trampoline, Streifen an Kletterwand und Block, Gipfel
	for _, gx in { 62, 68, 74 } do
		piece(B, Vector3.new(9, 0.6, 0.6), gx, 4.5, -11, accent2, M.Plastic, { Name = "GymPost", Shape = CYL }, VERTICAL)
		piece(B, Vector3.new(0.9, 0.9, 0.9), gx, 9.2, -11, GOLD, M.Plastic, { Name = "GymKnob", Shape = BALL })
	end
	for _, gy in { 3, 6, 9 } do
		piece(B, Vector3.new(12, 0.45, 0.45), 68, gy, -11, accent, M.Plastic, { Name = "GymBar", Shape = CYL })
	end
	for _, tx in { 92, 99.5 } do
		piece(B, Vector3.new(0.5, 5.8, 5.8), tx, 1.2, -11, accent2, M.Plastic, { Name = "TrampolineRim", Shape = CYL }, VERTICAL)
		piece(B, Vector3.new(0.5, 5, 5), tx, 1.3, -11, rgb(30, 32, 44), M.Fabric, { Name = "TrampolineMat", Shape = CYL }, VERTICAL)
		block(B, tx - 2.2, 0, -11.3, tx - 1.8, 1, -10.7, STEEL, M.Metal, { Name = "TrampolineLeg" })
		block(B, tx + 1.8, 0, -11.3, tx + 2.2, 1, -10.7, STEEL, M.Metal, { Name = "TrampolineLeg" })
	end
	B:Lamp(56, 0, -6.5)
	B:Lamp(112, 0, -6.5)
	B:Tree(84, UPPER_Y, -19.5, { Kind = "Palm", Scale = 1.6 })
	B:Tree(128, UPPER_Y, -19.5, { Kind = "Round", Scale = 1.8 })
	planter(B, 106, 0, -11, 5)
	-- Wall-Jump-Wand: Streifen; Block: Klettergriffe; Hohlraum unter dem Gipfel: Wandbild
	for y = 12, 56, 8 do
		block(B, 120.1, y, FACE_Z, 121.9, y + 4, FRONT_Z, accent2, M.SmoothPlastic, { Name = "WallStripe" })
	end
	for i = 0, 11 do
		local hy = 3 + i * 3.7
		local hx = 137 + (i % 3) * 1
		piece(B, Vector3.new(0.12, 0.9, 0.9), hx, hy, FRONT_Z, ({ accent, GOLD, accent2 })[i % 3 + 1], M.Plastic, { Name = "ClimbHold", Shape = CYL }, FACING)
	end
	block(B, 140, 0, -5.6, 170, 46, -5.2, rgb(52, 56, 96), M.Concrete, { Name = "Mural" })
	for i, color in { accent2, GOLD, accent } do
		local ox = 140 + i * 6
		bar(B, ox - 4, 2, ox + 14, 44, -5.15, 2.4, color, M.SmoothPlastic, "MuralStripe")
	end
	B:Banner(162, 48, GOLD, { Height = 11, Width = 3.4, Z = -4.2, Color2 = WHITE })
	trophy(B, 150, 48, -3.6, 0.8)
	B:Sign(150, 58.5, "GIPFEL ERREICHT!", nil, { Style = "Banner", Width = 16, Height = 3.4, Z = -6, Color = GOLD })
	local confetti = block(B, 141, 62, -5, 167, 63, -3, WHITE, nil, { Name = "Confetti", Transparency = 1 })
	emitter(confetti, {
		Rate = 6,
		Lifetime = NumberRange.new(3, 5),
		Speed = NumberRange.new(1, 3),
		EmissionDirection = Enum.NormalId.Bottom,
		Size = NumberSequence.new(0.3),
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, rgb(255, 80, 80)),
			ColorSequenceKeypoint.new(0.25, rgb(255, 220, 60)),
			ColorSequenceKeypoint.new(0.5, rgb(80, 230, 120)),
			ColorSequenceKeypoint.new(0.75, rgb(60, 200, 255)),
			ColorSequenceKeypoint.new(1, rgb(240, 90, 255)),
		}),
		LightEmission = 0.4,
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-180, 180),
		Acceleration = Vector3.new(0, -4, 0),
		SpreadAngle = Vector2.new(35, 35),
	})

	-- Schwebende Lichtpunkte über der Terrasse
	local motes = block(B, -150, 18, -16, 160, 19, -8, WHITE, nil, { Name = "Motes", Transparency = 1 })
	emitter(motes, {
		Rate = 5,
		Lifetime = NumberRange.new(6, 9),
		Speed = NumberRange.new(0.3, 1.2),
		SpreadAngle = Vector2.new(180, 180),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(0.5, 0.35), NumberSequenceKeypoint.new(1, 0) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.3), NumberSequenceKeypoint.new(1, 1) }),
		Color = ColorSequence.new(WARM, accent),
		LightEmission = 1,
	})

	B:Decorate()

	-- Hintergrund vor den Hub-Türmen: Grünstreifen und Abendwolken
	greenBelt(B)
	local rng = B.Rng
	for i = 1, 7 do
		B:Cloud(-300 + i * 75 + rng:NextNumber(-15, 15), rng:NextNumber(85, 118), -rng:NextNumber(230, 260), rng:NextNumber(2.2, 3.4), {
			Color = rgb(255, 214, 236),
			Puffs = 4,
		})
	end
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">MagmaWorks</string>
          <string name="Source"><![CDATA[--[[
	MagmaWorks  (ModuleScript)
	Pfad: ServerStorage/MapTemplates/MagmaWorks

	Industrieanlage über einem Lavasee. Viele Lavagruben mit Säulen,
	Flammenwerfer-Barrieren und Sprungpads. Schwierigste Strecke.
]]

return function(B)
	B:Start(60)
	B:Flat(40)
	B:Pit(B:D(30), { Pillars = 1, Landing = 30 })
	B:Steps(3, 5, 12)
	B:TimedBarrier(40, { Period = 2.6, OnTime = 1.2 })
	B:PickupRow(3)
	B:GrappleGap(B:D(50), { AnchorHeight = 24 })
	B:Drop(10, 30)
	B:Pit(B:D(44), { Pillars = 2, PillarRise = 4, Landing = 30 })
	B:JumpPadUp(18, 40)
	B:SlideTunnel(30, { Lethal = true })
	B:Flat(20)
	B:Split({
		Length = 260,
		Depth = 30,
		Upper = function(b)
			b:Flat(8)
			b:GrappleGap(60, { Landing = 20 })
			b:TimedBarrier(30, { Period = 1.8, OnTime = 0.7 })
			b:GrappleGap(54, { Landing = 24 })
			b:BoostStrip(40, 90)
		end,
		Lower = function(b)
			b:Flat(30)
			b:Pit(34, { Pillars = 2, Landing = 20 })
			b:SlideTunnel(26)
			b:Flat(16)
			b:Pit(30, { Pillars = 1, Landing = 30 })
			b:Flat(30)
		end,
	})
	B:PickupRow(3)
	B:WallClimb(22, 14)
	B:TimedBarrier(36, { Period = 2.2, OnTime = 1.0, Offset = 0.5 })
	B:Gap(B:D(16), 0, 24)
	B:Gap(B:D(16), 3, 24)
	B:GrappleGap(B:D(70), { Anchors = 2, AnchorHeight = 26 })
	B:Ramp(30, -8)
	B:BoostStrip(60, 90)
	B:Pit(B:D(40), { Pillars = 2, Landing = 30 })
	B:TimedBarrier(40, { Period = 2.0, OnTime = 0.9, Offset = 1.3 })
	B:Steps(3, -4, 12)
	B:GrappleGap(B:D(58), { AnchorHeight = 24 })
	B:Flat(30)
	B:Finish(80)
	-- Optik (rein dekorativ): Werkstore in Warnfarbe
	B:Gates(3, B.Theme.Accent2, { FrameColor = Color3.fromRGB(70, 56, 50), Material = Enum.Material.CorrodedMetal })
	B:Decorate()
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">NeonMetropolis</string>
          <string name="Source"><![CDATA[--[[
	NeonMetropolis  (ModuleScript)
	Pfad: ServerStorage/MapTemplates/NeonMetropolis

	Futuristische Stadt bei Nacht. Laserbarrieren, Greifhaken-Lücken zwischen
	Hochhäusern und eine geteilte Route (Dächer oben, Wartungstunnel unten).
]]

return function(B)
	B:Start(60)
	B:Flat(50)
	B:Gap(B:D(12), 0, 36)
	B:Steps(3, 4, 12)
	B:PickupRow(3)
	B:Flat(30)
	B:SlideTunnel(32)
	B:Flat(24)
	B:GrappleGap(B:D(54), { AnchorHeight = 24 })
	B:TimedBarrier(40, { Period = 2.4, OnTime = 1.0 })
	B:BoostStrip(70, 85)
	B:Split({
		Length = 280,
		Depth = 28,
		Upper = function(b)
			b:Flat(10)
			b:GrappleGap(56, { Landing = 24 })
			b:Gap(16, 0, 20)
			b:GrappleGap(64, { Anchors = 2, Landing = 30 })
			b:BoostStrip(40, 90)
		end,
		Lower = function(b)
			b:Flat(40)
			b:SlideTunnel(28)
			b:Flat(20)
			b:Pit(36, { Pillars = 2, Landing = 24 })
			b:TimedBarrier(36, { Period = 2.2, OnTime = 0.9, Offset = 0.7 })
			b:Flat(40)
		end,
	})
	B:PickupRow(3)
	B:WallClimb(20, 14)
	B:Flat(40)
	B:Gap(B:D(16), -4, 30)
	B:GrappleGap(B:D(72), { Anchors = 2, AnchorHeight = 26 })
	B:Ramp(40, 10)
	B:Flat(24)
	B:Drop(14, 30)
	B:SlideTunnel(26, { Lethal = true })
	B:PickupRow(2)
	B:Gap(B:D(18), 0, 30)
	B:TimedBarrier(36, { Period = 2.0, OnTime = 0.9, Offset = 1.1 })
	B:Steps(4, -3, 10)
	B:BoostStrip(60, 90)
	B:GrappleGap(B:D(60), { AnchorHeight = 22 })
	B:Flat(30)
	B:Finish(80)
	-- Optik (rein dekorativ): Neon-Torbögen und ein Wolkenkratzer als Wahrzeichen
	B:Gates(3)
	B:Decorate()
	B:Prop("Tower", (B.MinX + B.MaxX) * 0.55, B.MinY - 60, -112, { Scale = 1.1 })
	B:Prop("Tower", B.MinX + (B.MaxX - B.MinX) * 0.12, B.MinY - 60, -118, { Scale = 0.85 })
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">SkywayRuins</string>
          <string name="Source"><![CDATA[--[[
	SkywayRuins  (ModuleScript)
	Pfad: ServerStorage/MapTemplates/SkywayRuins

	Schwebende Ruinen über den Wolken. Viele Greifhaken-Passagen, Abgründe
	ins Nichts und eine lange Schwung-Route als Abkürzung.
]]

return function(B)
	B:Start(60)
	B:Flat(40)
	B:GrappleGap(B:D(50), { AnchorHeight = 22 })
	B:Gap(B:D(14), 4, 24)
	B:Gap(B:D(14), 4, 24)
	B:PickupRow(3)
	B:GrappleGap(B:D(80), { Anchors = 2, AnchorHeight = 26 })
	B:Drop(16, 30)
	B:SlideTunnel(26)
	B:Flat(20)
	B:TimedBarrier(34, { Period = 2.6, OnTime = 1.0 })
	B:Split({
		Length = 300,
		Depth = 30,
		Upper = function(b)
			b:Flat(8)
			b:GrappleGap(60, { Landing = 16 })
			b:GrappleGap(60, { Landing = 16 })
			b:GrappleGap(70, { Anchors = 2, Landing = 30 })
		end,
		Lower = function(b)
			b:Flat(30)
			b:Gap(14, 0, 20)
			b:Steps(3, 3, 10)
			b:Gap(14, -9, 30)
			b:SlideTunnel(24)
			b:Pit(30, { Pillars = 1, Landing = 30 })
		end,
	})
	B:BoostStrip(60, 85)
	B:WallClimb(18, 14)
	B:PickupRow(2)
	B:GrappleGap(B:D(66), { Anchors = 2, AnchorHeight = 20, Rise = 4 })
	B:Gap(B:D(18), -6, 30)
	B:Ramp(40, 12)
	B:GrappleGap(B:D(56), { AnchorHeight = 24 })
	B:TimedBarrier(34, { Period = 2.2, OnTime = 0.9, Offset = 0.9 })
	B:Steps(4, -4, 10)
	B:Flat(30)
	B:Finish(80)
	-- Optik (rein dekorativ): Säulentore und ein riesiger Ruinenbogen auf einer Insel
	B:Gates(2, B.Theme.Accent, { FrameColor = Color3.fromRGB(236, 230, 216), Material = Enum.Material.Marble })
	B:Decorate()
	local islandX = (B.MinX + B.MaxX) * 0.45
	local top = B:Island(islandX, 30, -150, 40)
	B:Prop("RuinArch", islandX, top - 0.5, -150, { Scale = 2.2 })
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">Tutorial</string>
          <string name="Source"><![CDATA[--[[
	Tutorial  (ModuleScript)
	Pfad: ServerStorage/MapTemplates/Tutorial

	Bewegungs-Tutorial für den Trainingsmodus. Jede Station erklärt eine
	Mechanik per Schild. Kein Wettbewerb, keine Belohnungen.
]]

return function(B)
	B.CheckpointSpacing = 90

	B:Start(60)
	B:Sign(10, B.Y + 13, "WILLKOMMEN!", "A/D oder Pfeiltasten: laufen")
	B:Flat(40)
	B:Sign(B.X - 10, B.Y + 13, "SPRINGEN", "Leertaste / W – länger halten = höher")
	B:Climb(4, 24)
	B:Climb(6, 30)
	B:Gap(10, 0, 30)
	B:Sign(B.X - 15, B.Y + 13, "MOMENTUM", "Anlauf nehmen für weite Sprünge")
	B:Gap(20, 0, 40)
	B:Sign(B.X - 20, B.Y + 13, "SLIDEN", "Shift / S bei Tempo – unter Hindernissen durch")
	B:Flat(30)
	B:SlideTunnel(30)
	B:Flat(20)
	B:Sign(B.X + 10, B.Y + 34, "WALL-JUMP", "In der Luft gegen eine Wand springen")
	B:Flat(20)
	B:WallClimb(18, 14)
	B:Flat(30)
	B:Sign(B.X - 10, B.Y + 15, "GREIFHAKEN", "E / Maus halten zum Schwingen, loslassen zum Abspringen")
	B:Flat(20)
	B:GrappleGap(50, { AnchorHeight = 22 })
	B:GrappleGap(80, { Anchors = 2, AnchorHeight = 24 })
	B:Sign(B.X - 10, B.Y + 13, "AIR-DASH", "In der Luft Shift / S: kurzer Dash nach vorn")
	B:Flat(10)
	B:Gap(24, 0, 30)
	B:Sign(B.X - 10, B.Y + 13, "PADS", "Boost-Pads geben Tempo, Sprungpads bringen dich hoch")
	B:BoostStrip(60, 85)
	B:JumpPadUp(16, 30)
	B:Sign(B.X - 10, B.Y + 13, "POWER-UPS", "Box einsammeln, mit Q / F einsetzen")
	B:PickupRow(3, 30)
	B:Flat(20)
	B:Sign(B.X + 10, B.Y + 22, "TIMING", "Warte, bis die Barriere ausgeschaltet ist")
	B:TimedBarrier(40, { Period = 2.6, OnTime = 1.1 })
	B:Sign(B.X - 10, B.Y + 13, "GEFAHRENZONE", "Im Rennen jagt dich eine Energiewand – bleib vorn!")
	B:Flat(30)
	B:Finish(60)
	-- Optik (rein dekorativ): Trainingstore
	B:Gates(2, B.Theme.Accent2)
	B:Decorate()
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">_Template</string>
          <string name="Source"><![CDATA[--[[
	_Template  (ModuleScript) – Vorlage für neue Maps
	Pfad: ServerStorage/MapTemplates/_Template

	So fügst du eine neue Strecke hinzu:
		1. Dieses Modul duplizieren und umbenennen (z.B. "DesertDash").
		2. In ReplicatedStorage/Shared/MapDefinitions einen Eintrag anlegen:
		      DesertDash = { Id = "DesertDash", Name = "Desert Dash", Template = "DesertDash",
		                     Difficulty = 2, Seed = 6606, Theme = { ... } }
		   und "DesertDash" in MapDefinitions.Order eintragen.
		3. Unten die Strecke mit Bausteinen beschreiben (siehe MapBuilder-Doku).

	Regeln für faire, spielbare Strecken:
		- Normale Sprunglücken ≤ 18 Studs, Stufen ≤ 6 Studs.
		- Greifhaken-Lücken 40–80 Studs, Anker ca. 22–26 Studs über dem Boden.
		- Alle ~140 Studs wird automatisch ein Checkpoint gesetzt.
		- Immer mit B:Start() beginnen und mit B:Finish() enden.
		- Zum Schluss B:Decorate() für Bodenverzierung und Hintergrund aufrufen.
		- Optik ist rein dekorativ: vor B:Decorate() z.B. B:Gates(2) für Torbögen,
		  danach Wahrzeichen wie B:Prop("Tower", x, B.MinY - 60, -110). Weitere
		  Deko- und Terrain-Bausteine stehen in der MapBuilder-Doku.

	Diese Vorlage wird vom Spiel nicht geladen (kein Eintrag in MapDefinitions).
]]

return function(B)
	B:Start(60)
	B:Flat(40)
	B:Gap(B:D(12), 0, 30)
	B:Steps(3, 4, 12)
	B:PickupRow(3)
	B:SlideTunnel(30)
	B:Flat(20)
	B:GrappleGap(B:D(54), { AnchorHeight = 24 })
	B:Split({
		Length = 240,
		Depth = 28,
		Upper = function(b)
			b:Flat(10)
			b:GrappleGap(56, { Landing = 24 })
			b:BoostStrip(40, 85)
		end,
		Lower = function(b)
			b:Flat(40)
			b:Pit(32, { Pillars = 2, Landing = 30 })
			b:Flat(30)
		end,
	})
	B:WallClimb(18, 14)
	B:TimedBarrier(36, { Period = 2.4, OnTime = 1.0 })
	B:Flat(30)
	B:Finish(80)
	-- Optik (rein dekorativ)
	B:Gates(2)
	B:Decorate()
end
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="48">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
  </Item>
  <Item class="StarterGui" referent="49">
    <Properties>
      <string name="Name">StarterGui</string>
      <bool name="ResetPlayerGuiOnSpawn">false</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="50">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="EnableMouseLockOption">false</bool>
      <bool name="LoadCharacterAppearance">false</bool>
    </Properties>
    <Item class="StarterCharacterScripts" referent="51">
      <Properties>
        <string name="Name">StarterCharacterScripts</string>
      </Properties>
      <Item class="LocalScript" referent="52">
        <Properties>
          <string name="Name">Animate</string>
          <string name="Source"><![CDATA[--[[
	Animate  (LocalScript)
	Pfad: StarterPlayer/StarterCharacterScripts/Animate

	Absichtlich leer: Ein Script mit dem Namen "Animate" in
	StarterCharacterScripts ersetzt das Roblox-Standard-Animationsscript.
	Velocity Rush animiert alle Spielfiguren prozedural im
	AnimationController (StarterPlayerScripts/Client/Controllers).
]]
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="53">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="54">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="55">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">AnimationController</string>
              <string name="Source"><![CDATA[--[[
	AnimationController  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/Controllers/AnimationController

	Prozedurale Animationen ohne externe Animations-Assets. Jeder Client
	animiert ALLE Spielfiguren selbst, indem er Motor6D.Transform in
	RunService.PreSimulation setzt (offiziell empfohlener Zeitpunkt).

	Datenquellen:
		Lokale Figur: MovementController (sofort, ohne Latenz)
		Andere Figuren: Character-Attribut "MoveState" (vom Server repliziert)
		                und die (geglättete) replizierte Geschwindigkeit des Root-Parts
	Posen:
		Idle     Atmen, Gewichtsverlagerung, gelegentliches Umschauen
		Run      Laufzyklus mit Gegenbewegung von Armen/Beinen, Kniehub,
		         Vorlage abhängig von Tempo und Beschleunigung, Hüft-/Schulterdrehung,
		         stabilisierter Kopf
		Air      stufenlos zwischen Steigen (angezogene Beine) und Fallen
		         (Beine strecken sich zum Boden, Arme rudern bei hohem Tempo)
		Slide, Wall (Hand und Fuß an der Wand), Grapple (Arm greift Richtung
		Anker, Körper hängt am Seil, Beine pendeln), Dash (Superhelden-Pose),
		Stunned (taumeln), Frozen (Startpose), Emotes und Siegesjubel.
	Zusätzliche Schichten (werden nach dem Überblenden aufaddiert):
		- Landungs-Federung (Einknicken, erkannt über Zustand + Fallgeschwindigkeit,
		  funktioniert damit auch für andere Spieler)
		- Salto nach Wall-Jumps, Greifhaken-Absprüngen und Sprungpads
		- weiche Drehung beim Richtungswechsel (nur lokale Figur)
	Übergänge werden pro Gelenk mit posenabhängiger Schärfe weich überblendet.

	Das Standard-"Animate"-Script wird durch StarterCharacterScripts/Animate
	(leer) ersetzt, damit keine Roblox-Animationen dazwischenfunken.

	API:
		:RegisterPreview(model, getPose)   Vorschau-Rigs (Shop) mitanimieren
		:UnregisterPreview(model)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local RunnerRig = require(Shared.RunnerRig)
local CosmeticDefinitions = require(Shared.CosmeticDefinitions)

local player = Players.LocalPlayer

local TAU = math.pi * 2
local MAX_RUN = Config.Movement.MaxRunSpeed
local ANIMATE_DISTANCE = 320
local FLIP_TIME = 0.46
local TURN_TIME = 0.16

local AnimationController = {}

local function A(x: number, y: number?, z: number?): CFrame
	return CFrame.Angles(x, y or 0, z or 0)
end

local clamp = math.clamp

-- Überblend-Schärfe je Pose (höher = schnellerer Übergang)
local BLEND = {
	Idle = 9,
	Run = 18,
	Air = 11,
	Slide = 22,
	Wall = 16,
	Grapple = 15,
	Dash = 30,
	Stunned = 14,
	Frozen = 10,
	Emote = 12,
	Victory = 12,
}

local AIRBORNE = { Air = true, Grapple = true, Dash = true, Wall = true }
local GROUNDED = { Run = true, Idle = true, Slide = true }

------------------------------------------------------------------------
-- Posen. Jede Pose bekommt einen Kontext c:
--   T (Zeit), Seed (pro Figur), Speed (|vx|), Forward (vx in Blickrichtung),
--   Vy, Phase (Laufzyklus), Accel (Tempoänderung), Reach (Armwinkel zum Anker)
-- Vorzeichen (lokaler Raum der Figur, vorne = -Z):
--   Hüfte/Schulter +X = Glied nach vorn, Knie -X = beugen, Ellbogen +X = beugen,
--   Root -X = Oberkörper nach vorn neigen, Fußgelenk +X = Zehen hoch.
------------------------------------------------------------------------

local POSES = {}

function POSES.Idle(c)
	local t = c.T + c.Seed
	local breath = math.sin(t * 2.1)
	local sway = math.sin(t * 0.8)
	local look = math.noise(t * 0.3, c.Seed) * 1.3
	local nod = math.noise(t * 0.26, c.Seed + 17.3) * 0.5
	return {
		Root = CFrame.new(sway * 0.035, -0.04 + breath * 0.015, 0) * A(0.015 * breath, sway * 0.04, sway * 0.025),
		Waist = A(-0.02 - breath * 0.03, look * 0.12, -sway * 0.03),
		Neck = A(0.03 + nod * 0.25 + breath * 0.015, look * 0.5, 0),
		LeftShoulder = A(0.04 + breath * 0.025, 0, -0.1 - breath * 0.03),
		RightShoulder = A(0.04 + breath * 0.025, 0, 0.1 + breath * 0.03),
		LeftElbow = A(0.2 + breath * 0.04),
		RightElbow = A(0.2 + breath * 0.04),
		LeftWrist = A(0.08),
		RightWrist = A(0.08),
		LeftHip = A(0.03, 0.08, -0.05),
		RightHip = A(-0.03, -0.08, 0.05),
		LeftKnee = A(-0.07),
		RightKnee = A(-0.05),
		LeftAnkle = A(0.04, 0, 0.05),
		RightAnkle = A(0.02, 0, -0.05),
	}
end

function POSES.Run(c)
	local k = clamp(c.Speed / MAX_RUN, 0.25, 1.35)
	local p = c.Phase
	local s, co = math.sin(p), math.cos(p)
	-- Vorlage: wächst mit dem Tempo, beim Beschleunigen mehr, beim Bremsen weniger
	local lean = 0.1 + 0.2 * k + clamp(c.Accel * 0.0016, -0.18, 0.22)
	local hipSwing = 0.5 + 0.42 * k
	local lift = 0.45 + 0.95 * k
	local armSwing = 0.45 + 0.55 * k
	local elbow = 0.55 + 0.75 * k
	-- zwei Schritte pro Zyklus: tief beim Aufsetzen, hoch in der Flugphase
	local bob = (math.abs(co) * 0.24 - 0.12) * k - 0.05 * k
	local hipYaw = -s * 0.1 * k
	local chestYaw = s * 0.22 * k
	-- Kniehub kurz nach dem Abdruck (Bein schwingt nach vorn)
	local kneeL = math.max(0, math.cos(p + 0.5))
	local kneeR = math.max(0, -math.cos(p + 0.5))
	local ankleL = if s > 0 then 0.22 * s * k else 0.4 * s * k
	local ankleR = if s < 0 then -0.22 * s * k else -0.4 * s * k
	return {
		Root = CFrame.new(0, bob, 0) * A(-lean, hipYaw, co * 0.035 * k),
		Waist = A(-0.05 * k + math.abs(co) * 0.04 * k, chestYaw, 0),
		-- Kopf stabilisieren: Neigung und Drehung des Körpers ausgleichen
		Neck = A(lean * 0.8 + 0.04, -(hipYaw + chestYaw) * 0.85, 0),
		LeftHip = A(lean * 0.85 + 0.1 * k + s * hipSwing),
		RightHip = A(lean * 0.85 + 0.1 * k - s * hipSwing),
		LeftKnee = A(-(0.22 * k + lift * kneeL)),
		RightKnee = A(-(0.22 * k + lift * kneeR)),
		LeftAnkle = A(ankleL),
		RightAnkle = A(ankleR),
		LeftShoulder = A(-s * armSwing + lean * 0.25, 0, -0.12 - 0.04 * k),
		RightShoulder = A(s * armSwing + lean * 0.25, 0, 0.12 + 0.04 * k),
		LeftElbow = A(elbow + 0.3 * math.max(0, -s) * k),
		RightElbow = A(elbow + 0.3 * math.max(0, s) * k),
		LeftWrist = A(0.1),
		RightWrist = A(0.1),
	}
end

function POSES.Air(c)
	local rise = clamp(c.Vy / 45, -1, 1)
	local up = math.max(0, rise)
	local down = math.max(0, -rise)
	local fwd = clamp(c.Forward / MAX_RUN, -0.6, 1.4)
	local flail = math.sin(c.T * 10) * down * down
	return {
		Root = A(-0.1 * fwd - 0.08 * up + 0.06 * down),
		Waist = A(-0.1 * up + 0.04 * down),
		Neck = A(0.1 * up - 0.18 * down + 0.08 * fwd),
		LeftHip = A(0.25 + 0.75 * up + 0.15 * down + 0.1 * fwd),
		LeftKnee = A(-(0.3 + 1.1 * up + 0.15 * down)),
		LeftAnkle = A(-0.15 * up + 0.2 * down),
		RightHip = A(-0.05 - 0.3 * up + 0.2 * down),
		RightKnee = A(-(0.35 + 0.55 * up + 0.3 * down)),
		RightAnkle = A(-0.3 * up + 0.15 * down),
		LeftShoulder = A(0.55 * up + 1.35 * down + flail * 0.35, 0, -0.3 - 0.35 * down),
		RightShoulder = A(-0.45 * up + 1.75 * down - flail * 0.35, 0, 0.3 + 0.35 * down),
		LeftElbow = A(0.35 + 0.5 * up + 0.15 * down),
		RightElbow = A(0.35 + 0.4 * up + 0.15 * down),
		LeftWrist = A(0.1),
		RightWrist = A(0.1),
	}
end

function POSES.Slide(c)
	local jitter = math.sin(c.T * 37) * 0.025 * clamp(c.Speed / MAX_RUN, 0, 1)
	return {
		Root = CFrame.new(0, -1.65, 0.3) * A(1.15 + jitter),
		Waist = A(-0.3),
		Neck = A(-0.55 + jitter),
		LeftHip = A(0.18),
		LeftKnee = A(-0.12),
		LeftAnkle = A(0.35),
		RightHip = A(0.7),
		RightKnee = A(-1.5),
		RightAnkle = A(0.2),
		LeftShoulder = A(-0.55, 0, -0.7),
		LeftElbow = A(0.15),
		LeftWrist = A(-0.3),
		RightShoulder = A(0.85, 0, 0.35),
		RightElbow = A(0.95),
	}
end

function POSES.Wall(c)
	local rub = math.sin(c.T * 21) * 0.035
	return {
		-- Rücken von der Wand weg, Blick über die Schulter in Sprungrichtung
		Root = CFrame.new(0, 0, 0.3) * A(0.16 + rub * 0.5),
		Waist = A(0.04, 0.22, 0),
		Neck = A(-0.12, 0.65, 0),
		LeftShoulder = A(1.6 + rub, 0, -0.2),
		LeftElbow = A(0.45),
		RightShoulder = A(1.05 - rub, 0, 0.5),
		RightElbow = A(0.85),
		LeftHip = A(0.8),
		LeftKnee = A(-1.05),
		LeftAnkle = A(0.5),
		RightHip = A(0.3),
		RightKnee = A(-0.55),
		RightAnkle = A(0.2),
	}
end

function POSES.Grapple(c)
	local reach = c.Reach -- Armwinkel um X (pi = senkrecht nach oben)
	local swing = clamp(c.Forward / 60, -1, 1)
	local hang = clamp((reach - math.pi) * 0.3, -0.5, 0.5)
	local rootPitch = hang - 0.12 * swing
	local waistPitch = -0.05
	local dangle = math.sin(c.T * 3) * 0.08
	return {
		Root = A(rootPitch),
		Waist = A(waistPitch, 0.18, 0),
		Neck = A(-0.25 - hang * 0.5, -0.1, 0),
		RightShoulder = A(reach - rootPitch - waistPitch, 0, 0.12),
		RightElbow = A(0.06),
		RightWrist = A(-0.1),
		LeftShoulder = A(0.35 - 0.45 * swing, 0, -0.75),
		LeftElbow = A(0.65),
		LeftHip = A(0.45 - 0.45 * swing + dangle),
		LeftKnee = A(-0.75 - 0.25 * math.max(0, swing)),
		LeftAnkle = A(-0.2),
		RightHip = A(0.1 - 0.6 * swing - dangle),
		RightKnee = A(-0.35 - 0.3 * math.max(0, -swing)),
		RightAnkle = A(-0.25),
	}
end

function POSES.Dash(_c)
	return {
		Root = CFrame.new(0, 0.25, 0) * A(-1.2),
		Waist = A(0.12),
		Neck = A(0.85),
		RightShoulder = A(2.85, 0, 0.12),
		RightElbow = A(0.1),
		LeftShoulder = A(-0.35, 0, -0.3),
		LeftElbow = A(0.3),
		LeftHip = A(0.05),
		LeftKnee = A(-0.15),
		LeftAnkle = A(-0.5),
		RightHip = A(0.3),
		RightKnee = A(-0.9),
		RightAnkle = A(-0.4),
	}
end

function POSES.Stunned(c)
	local t = c.T
	local wob = t * 5.5
	return {
		Root = CFrame.new(math.sin(t * 38) * 0.04, -0.35, 0) * A(0.1 + math.sin(wob) * 0.07, 0, math.cos(wob) * 0.09),
		Waist = A(0.12, 0, math.sin(wob + 1) * 0.1),
		Neck = A(0.22 + math.sin(wob) * 0.18, math.cos(wob) * 0.35, math.sin(wob) * 0.18),
		LeftShoulder = A(-0.1, 0, -0.28 - math.sin(t * 3) * 0.1),
		RightShoulder = A(-0.1, 0, 0.28 + math.sin(t * 3 + 1) * 0.1),
		LeftElbow = A(0.35),
		RightElbow = A(0.35),
		LeftHip = A(0.35, 0, -0.06),
		RightHip = A(0.3, 0, 0.06),
		LeftKnee = A(-0.6),
		RightKnee = A(-0.55),
		LeftAnkle = A(0.25),
		RightAnkle = A(0.25),
	}
end

function POSES.Frozen(c)
	-- Startpose ("auf die Plätze") mit leichtem Atmen
	local breath = math.sin((c.T + c.Seed) * 2.6) * 0.02
	return {
		Root = CFrame.new(0, -0.5 + breath, 0) * A(-0.38 + breath),
		Waist = A(-0.05),
		Neck = A(0.3),
		LeftHip = A(0.75),
		LeftKnee = A(-1.05),
		LeftAnkle = A(0.3),
		RightHip = A(-0.15),
		RightKnee = A(-0.55),
		RightAnkle = A(-0.1),
		LeftShoulder = A(-0.55, 0, -0.1),
		LeftElbow = A(0.75),
		RightShoulder = A(0.7, 0, 0.1),
		RightElbow = A(0.7),
	}
end

local EMOTES = {}

function EMOTES.Wave(t)
	local wave = math.sin(t * 9)
	return {
		Root = A(0, 0, math.sin(t * 2) * 0.03),
		Waist = A(0, -0.15, 0.05),
		Neck = A(-0.05, -0.25, wave * 0.04),
		RightShoulder = A(0.2, 0, 2.6 + wave * 0.3),
		RightElbow = A(0, 0, 0.3 + wave * 0.15),
		LeftShoulder = A(0, 0, -0.12),
		LeftElbow = A(0.2),
	}
end

function EMOTES.Dance(t)
	local s = math.sin(t * 6)
	return {
		Root = CFrame.new(0, math.abs(s) * 0.3, 0) * A(0, math.sin(t * 3) * 0.4, 0),
		Waist = A(0, 0, s * 0.15),
		Neck = A(0, 0, -s * 0.12),
		LeftShoulder = A(0, 0, -(1.2 + s * 0.8)),
		RightShoulder = A(0, 0, 1.2 - s * 0.8),
		LeftElbow = A(0.4),
		RightElbow = A(0.4),
		LeftHip = A(math.max(0, s) * 0.5),
		RightHip = A(math.max(0, -s) * 0.5),
		LeftKnee = A(-math.max(0, s) * 0.8),
		RightKnee = A(-math.max(0, -s) * 0.8),
	}
end

function EMOTES.Flex(t)
	local pump = math.sin(t * 5) * 0.1
	return {
		Root = CFrame.new(0, -0.2, 0),
		Waist = A(-0.05 - pump * 0.3),
		Neck = A(-0.12),
		LeftShoulder = A(0, 0, -1.5 - pump),
		RightShoulder = A(0, 0, 1.5 + pump),
		LeftElbow = A(0, 0, -1.64),
		RightElbow = A(0, 0, 1.64),
		LeftHip = A(0, 0, -0.15),
		RightHip = A(0, 0, 0.15),
		LeftKnee = A(-0.2),
		RightKnee = A(-0.2),
	}
end

function EMOTES.Spin(t)
	return {
		Root = CFrame.new(0, math.abs(math.sin(t * 5)) * 0.2, 0) * A(0, (t * 10) % TAU, 0),
		LeftShoulder = A(0, 0, -1.4),
		RightShoulder = A(0, 0, 1.4),
		LeftHip = A(0, 0, -0.1),
		RightHip = A(0.4, 0, 0.1),
		RightKnee = A(-0.9),
	}
end

function EMOTES.Salute(t)
	return {
		Root = A(0.03),
		RightShoulder = A(2.1, 0, 0.6),
		RightElbow = A(2.0),
		Neck = A(-0.05 + math.sin(t * 2) * 0.02),
		LeftShoulder = A(0, 0, -0.05),
	}
end

local function victoryPose(t)
	local hop = math.abs(math.sin(t * 5))
	local pump = math.sin(t * 10) * 0.22
	return {
		Root = CFrame.new(0, hop * 0.75, 0) * A(-0.05 + hop * 0.05, math.sin(t * 1.6) * 0.35, 0),
		Waist = A(0.08, 0, math.sin(t * 5) * 0.06),
		Neck = A(-0.3),
		LeftShoulder = A(0.15, 0, -2.6 - pump),
		RightShoulder = A(0.15, 0, 2.6 + pump),
		LeftElbow = A(0.25 + pump),
		RightElbow = A(0.25 - pump),
		LeftHip = A(0.45 * hop, 0, -0.08),
		RightHip = A(0.3 * hop, 0, 0.08),
		LeftKnee = A(-0.85 * hop - 0.05),
		RightKnee = A(-0.6 * hop - 0.05),
	}
end

local function emoteDuration(id: string): number
	local def = CosmeticDefinitions.Get("Emotes", id)
	return def and def.Duration or 2.5
end

--- Landungs-Kurve: schnelles Einknicken, danach weiches Abklingen (0..1).
local function dipCurve(age: number): number
	if age < 0.05 then
		return age / 0.05
	end
	return math.exp(-(age - 0.05) * 9)
end

local function easeInOut(t: number): number
	return t * t * (3 - 2 * t)
end

------------------------------------------------------------------------
-- Controller
------------------------------------------------------------------------

function AnimationController:Init(ctx)
	self.Ctx = ctx
	self.Rigs = setmetatable({}, { __mode = "k" })
	self.Previews = {}
end

function AnimationController:Start()
	RunService.PreSimulation:Connect(function(dt)
		local ok, err = pcall(self._step, self, dt)
		if not ok then
			warn("[AnimationController] " .. tostring(err))
		end
	end)
end

function AnimationController:RegisterPreview(model: Model, getPose: () -> string?)
	self.Previews[model] = getPose
end

function AnimationController:UnregisterPreview(model: Model)
	self.Previews[model] = nil
	self.Rigs[model] = nil
end

function AnimationController:_rig(model: Model)
	local rig = self.Rigs[model]
	if rig and rig.Motors.Root and rig.Motors.Root.Parent then
		return rig
	end
	local motors = {}
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("Motor6D") then
			motors[descendant.Name] = descendant
		end
	end
	if not motors.Root then
		return nil
	end
	rig = {
		Motors = motors,
		Current = {},
		Phase = 0,
		Seed = math.random() * 100,
		State = "Idle",
		Velocity = Vector3.zero,
		PrevSpeed = 0,
		Accel = 0,
		MinVy = 0,
		LandAt = -math.huge,
		LandAmount = 0,
		FlipAt = -math.huge,
		TurnAt = -math.huge,
		TurnFrom = 0,
		LookSign = 0,
		Ctx = {},
	}
	self.Rigs[model] = rig
	return rig
end

--- Überblendet zur Zielpose und addiert die Zusatzschichten (Landung, Salto, Drehung).
function AnimationController:_apply(rig, pose, dt: number, rate: number, t: number)
	local alpha = 1 - math.exp(-rate * dt)

	local dip = 0
	local landAge = t - rig.LandAt
	if landAge < 0.6 then
		dip = dipCurve(landAge) * rig.LandAmount
	end
	local flip, tuck = 0, 0
	local flipAge = t - rig.FlipAt
	if flipAge < FLIP_TIME then
		local u = flipAge / FLIP_TIME
		flip = easeInOut(u) * TAU
		tuck = math.sin(u * math.pi)
	end
	local turn = 0
	local turnAge = t - rig.TurnAt
	if turnAge < TURN_TIME then
		local u = turnAge / TURN_TIME
		turn = rig.TurnFrom * (1 - u) * (1 - u)
	end
	local layered = dip > 0.001 or flip > 0 or turn ~= 0

	for _, name in RunnerRig.Joints do
		local motor = rig.Motors[name]
		if motor then
			local target = pose[name] or CFrame.identity
			local current = (rig.Current[name] or CFrame.identity):Lerp(target, alpha)
			rig.Current[name] = current
			if layered then
				if name == "Root" then
					current = CFrame.new(0, -0.55 * dip, 0) * A(-flip, turn, 0) * current * A(-0.2 * dip)
				elseif name == "LeftHip" or name == "RightHip" then
					current *= A(0.45 * dip + 0.9 * tuck)
				elseif name == "LeftKnee" or name == "RightKnee" then
					current *= A(-(0.85 * dip + 1.4 * tuck))
				elseif name == "LeftAnkle" or name == "RightAnkle" then
					current *= A(0.35 * dip)
				elseif name == "LeftShoulder" or name == "RightShoulder" then
					current *= A(0.25 * dip + 0.8 * tuck)
				elseif name == "LeftElbow" or name == "RightElbow" then
					current *= A(0.6 * tuck)
				elseif name == "Neck" then
					current *= A(0.1 * dip)
				end
			end
			motor.Transform = current
		end
	end
end

--- Erkennt Zustandswechsel (Landung, Salto-Auslöser) und Richtungswechsel.
function AnimationController:_track(rig, state: string, velocity: Vector3, root: BasePart, t: number, isLocal: boolean)
	local previous = rig.State
	if AIRBORNE[state] then
		rig.MinVy = math.min(rig.MinVy, velocity.Y)
	end
	if state ~= previous then
		if AIRBORNE[previous] and GROUNDED[state] then
			local impact = -rig.MinVy
			if impact > 12 then
				rig.LandAt = t
				rig.LandAmount = clamp((impact - 10) / 110, 0.15, 1)
			end
		end
		if state == "Air" then
			local vy = velocity.Y
			if
				(previous == "Wall" and vy > 25)
				or (previous == "Grapple" and vy > 30)
				or (GROUNDED[previous] and vy > Config.Movement.JumpVelocity * 1.25)
			then
				rig.FlipAt = t
			end
		elseif rig.FlipAt > t - FLIP_TIME then
			-- Salto abbrechen, sobald die Figur nicht mehr in der Luft ist. Der aktuelle
			-- Drehwinkel wird in die Root-Pose übernommen, damit die Figur sich weich
			-- aufrichtet statt zu springen.
			local flip = easeInOut(math.clamp((t - rig.FlipAt) / FLIP_TIME, 0, 1)) * TAU
			rig.Current.Root = A(-flip) * (rig.Current.Root or CFrame.identity)
			rig.FlipAt = -math.huge
		end
		if not AIRBORNE[state] then
			rig.MinVy = 0
		end
		rig.State = state
	end

	-- Weiche Drehung nur lokal: die eigene Figur wird von AlignOrientation hart gedreht,
	-- andere Figuren interpoliert Roblox bereits selbst.
	if isLocal then
		local lookX = root.CFrame.LookVector.X
		local sign = if lookX >= 0 then 1 else -1
		if rig.LookSign ~= 0 and sign ~= rig.LookSign and math.abs(lookX) > 0.5 then
			rig.TurnAt = t
			rig.TurnFrom = -sign * math.pi
		end
		if math.abs(lookX) > 0.5 then
			rig.LookSign = sign
		end
	end
end

function AnimationController:_reach(character: Model, root: BasePart, isLocal: boolean): number
	local anchor
	if isLocal then
		anchor = self.Ctx.MovementController:GetGrappleAnchor()
	elseif character:GetAttribute("Grappling") then
		anchor = character:GetAttribute("GrappleTarget")
	end
	if typeof(anchor) ~= "Vector3" then
		return 2.7
	end
	local facing = if root.CFrame.LookVector.X >= 0 then 1 else -1
	local d = anchor - (root.Position + Vector3.new(0, 1.5, 0))
	local reach = math.atan2(d.X * facing, -d.Y)
	if reach < 0 then
		reach += TAU
	end
	return reach
end

function AnimationController:_poseFor(character: Model, state: string, velocity: Vector3, rig, t: number, dt: number, facing: number, reach: number)
	local serverNow = workspace:GetServerTimeNow()
	local speed = math.abs(velocity.X)
	if state == "Run" then
		rig.Phase = (rig.Phase + dt * (4 + math.min(speed, 80) * 0.32)) % (TAU * 64)
	end
	local rawAccel = clamp((speed - rig.PrevSpeed) / math.max(dt, 1 / 240), -400, 400)
	rig.Accel += (rawAccel - rig.Accel) * (1 - math.exp(-8 * dt))
	rig.PrevSpeed = speed

	local victory = character:GetAttribute("Victory")
	if type(victory) == "string" and victory ~= "" then
		return victoryPose(t), BLEND.Victory
	end
	local emote = character:GetAttribute("Emote")
	if type(emote) == "string" and emote ~= "" and (state == "Idle" or state == "Frozen") then
		local startedAt = character:GetAttribute("EmoteAt") or 0
		local fn = EMOTES[emote]
		if fn and serverNow - startedAt < emoteDuration(emote) then
			return fn(serverNow - startedAt), BLEND.Emote
		end
	end
	if (character:GetAttribute("StunnedUntil") or 0) > serverNow then
		state = "Stunned"
	end
	if state == "Run" and speed < 2 then
		state = "Idle"
	end
	local fn = POSES[state] or POSES.Idle

	local c = rig.Ctx
	c.T = t
	c.Seed = rig.Seed
	c.Speed = speed
	c.Forward = velocity.X * facing
	c.Vy = velocity.Y
	c.Phase = rig.Phase
	c.Accel = rig.Accel
	c.Reach = reach
	return fn(c), BLEND[state] or 12
end

function AnimationController:_step(dt: number)
	local camera = workspace.CurrentCamera
	local cameraPosition = if camera then camera.CFrame.Position else Vector3.zero
	local t = os.clock()
	local movement = self.Ctx.MovementController

	for _, other in Players:GetPlayers() do
		local character = other.Character
		if character and character.Parent then
			local root = character:FindFirstChild("HumanoidRootPart")
			if root and (root.Position - cameraPosition).Magnitude < ANIMATE_DISTANCE then
				local rig = self:_rig(character)
				if rig then
					local isLocal = other == player
					local state, velocity, facing
					if isLocal then
						state = movement:GetState()
						velocity = movement.Velocity or root.AssemblyLinearVelocity
						facing = movement:GetFacing()
					else
						state = character:GetAttribute("MoveState") or "Idle"
						facing = character:GetAttribute("Facing") or 1
						if character:GetAttribute("Frozen") then
							state = "Frozen"
						end
						-- Replizierte Geschwindigkeit glätten (Netzwerk-Rauschen)
						rig.Velocity = rig.Velocity:Lerp(root.AssemblyLinearVelocity, 1 - math.exp(-14 * dt))
						velocity = rig.Velocity
					end
					self:_track(rig, state, velocity, root, t, isLocal)
					local reach = if state == "Grapple" then self:_reach(character, root, isLocal) else 2.7
					local pose, rate = self:_poseFor(character, state, velocity, rig, t, dt, facing, reach)
					self:_apply(rig, pose, dt, rate, t)
				end
			end
		end
	end

	for model, getPose in self.Previews do
		if model.Parent then
			local rig = self:_rig(model)
			if rig then
				local mode = getPose() or "Idle"
				local pose
				if EMOTES[mode] then
					pose = EMOTES[mode](t)
				elseif mode == "Victory" then
					pose = victoryPose(t)
				else
					local c = rig.Ctx
					c.T = t
					c.Seed = rig.Seed
					c.Speed = 30
					c.Forward = 30
					c.Vy = 0
					c.Phase = t * 12
					c.Accel = 0
					c.Reach = 2.7
					pose = (POSES[mode] or POSES.Idle)(c)
				end
				self:_apply(rig, pose, dt, 12, t)
			end
		else
			self.Previews[model] = nil
		end
	end
end

return AnimationController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">AudioController</string>
              <string name="Source"><![CDATA[--[[
	AudioController  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/Controllers/AudioController

	Spielt Soundeffekte und optionale Musik. Standardmäßig werden nur in Roblox
	eingebaute Sounddateien (rbxasset://sounds/...) genutzt, siehe Config.Audio.
	Fehlt ein Sound, läuft das Spiel normal weiter (rein optional).

	Lautstärken kommen aus den Spieler-Einstellungen (SfxVolume, MusicVolume).

	API:
		:Play(name, options?)   options: { Volume, Pitch, Position }
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local player = Players.LocalPlayer

local AudioController = {}

function AudioController:Init(ctx)
	self.Ctx = ctx
	self.Templates = {}
	self.LastPlayed = {}

	self.SfxGroup = Instance.new("SoundGroup")
	self.SfxGroup.Name = "VR_SFX"
	self.SfxGroup.Parent = SoundService
	self.MusicGroup = Instance.new("SoundGroup")
	self.MusicGroup.Name = "VR_Music"
	self.MusicGroup.Parent = SoundService

	for name, def in Config.Audio.Sounds do
		local sound = Instance.new("Sound")
		sound.Name = "VR_" .. name
		sound.SoundId = def.Id
		sound.Volume = def.Volume or 0.5
		sound.PlaybackSpeed = def.Pitch or 1
		sound.SoundGroup = self.SfxGroup
		sound.Parent = SoundService
		self.Templates[name] = sound
	end

	if Config.Audio.MusicId ~= "" then
		local music = Instance.new("Sound")
		music.Name = "VR_MusicTrack"
		music.SoundId = Config.Audio.MusicId
		music.Looped = true
		music.Volume = 0.4
		music.SoundGroup = self.MusicGroup
		music.Parent = SoundService
		self.Music = music
	end
end

function AudioController:Start()
	local state = self.Ctx.ClientState
	local function applyVolumes(settings)
		self.SfxGroup.Volume = settings.SfxVolume or 0.8
		self.MusicGroup.Volume = settings.MusicVolume or 0.5
	end
	applyVolumes(state:GetSettings())
	state.SettingsChanged:Connect(applyVolumes)
	if self.Music then
		self.Music:Play()
	end

	local movement = self.Ctx.MovementController
	movement.Jumped:Connect(function(kind)
		if kind == "WallJump" then
			self:Play("WallJump")
		elseif kind == "Pad" then
			self:Play("Boost", { Pitch = 1.2 })
		else
			self:Play("Jump")
		end
	end)
	movement.Landed:Connect(function(impact)
		self:Play("Land", { Volume = math.clamp(impact / 120, 0.2, 0.7) })
	end)
	movement.SlideStarted:Connect(function()
		self:Play("Slide")
	end)
	movement.DashStarted:Connect(function()
		self:Play("Dash")
	end)
	movement.GrappleStarted:Connect(function()
		self:Play("Grapple")
	end)
	movement.BoostPad:Connect(function()
		self:Play("Boost")
	end)

	state:On("ItemPickup", function()
		self:Play("Pickup")
	end)
	state:On("PowerUpUsed", function(payload)
		if payload.UserId == player.UserId then
			self:Play("PowerUp")
		end
	end)
	state:On("RacerEliminated", function(payload)
		self:Play("Eliminated", { Volume = if payload.UserId == player.UserId then 0.8 else 0.35 })
	end)
	state:On("RacerRespawn", function(payload)
		if payload.UserId == player.UserId then
			self:Play("Splash", { Pitch = 1.4 })
		end
	end)
	state:On("MatchResults", function(payload)
		if payload.WinnerUserId == player.UserId then
			self:Play("Victory")
		end
	end)
end

function AudioController:Play(name: string, options)
	local template = self.Templates[name]
	if not template then
		return
	end
	-- Gleichen Sound nicht öfter als alle 50 ms starten
	local now = os.clock()
	if self.LastPlayed[name] and now - self.LastPlayed[name] < 0.05 then
		return
	end
	self.LastPlayed[name] = now
	local sound = template:Clone()
	if options then
		if options.Volume then
			sound.Volume = options.Volume
		end
		if options.Pitch then
			sound.PlaybackSpeed = options.Pitch
		end
	end
	sound.Parent = SoundService
	sound:Play()
	sound.Ended:Once(function()
		sound:Destroy()
	end)
	task.delay(6, function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
end

return AudioController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[--[[
	CameraController  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/Controllers/CameraController

	Seitliche 2.5D-Kamera (Scriptable):
		- Blick entlang -Z auf die Spielebene (Z = 0), leicht von oben
		- nah an der Figur (Config.Camera.Distance), damit Läufer gut erkennbar sind
		- kritisch gedämpfte Federn (SmoothDamp) statt hartem Nachziehen:
		  weiche, ruckelfreie Verfolgung ohne Überschwingen
		- Look-Ahead in Bewegungsrichtung (geglättet)
		- vertikale Totzone gegen Ruckeln bei Sprüngen, langsames Zentrieren am
		  Boden, schnelles Nachführen und leichter Blick nach unten beim Fallen
		- Zoom und Sichtfeld wachsen sanft mit der Geschwindigkeit
		- im Rennen leichter Versatz Richtung Führendem, damit er sichtbar bleibt
		- Zuschauermodus (anderen Spieler verfolgen) mit weichem Kameraschwenk
		- Kamerawackeln mit Rauschfunktion (organisch statt Zufallszittern),
		  Kamera-Stöße (Feder, z.B. bei Landungen) und Sichtfeld-Impulse
		  (Dash/Boost) – alles abschaltbar über die Einstellung "CameraShake"

	API:
		:Shake(intensity)
		:Kick(impulse: Vector3)        Stoß in die Kamerafeder (Studs/s)
		:PunchFov(amount)              kurzzeitig größeres Sichtfeld (Grad)
		:SetSpectate(player?)
		:GetSpectate() -> Player?
		:GetFocusDistance() -> number  aktueller Abstand Kamera → Fokuspunkt
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local CAM = Config.Camera
local player = Players.LocalPlayer

local CameraController = {}

--- Kritisch gedämpfte Feder (wie Unity SmoothDamp). Gibt (Wert, Geschwindigkeit) zurück.
local function smoothDamp(current: number, target: number, velocity: number, smoothTime: number, dt: number): (number, number)
	local omega = 2 / math.max(smoothTime, 0.0001)
	local x = omega * dt
	local decay = 1 / (1 + x + 0.48 * x * x + 0.235 * x * x * x)
	local change = current - target
	local temp = (velocity + omega * change) * dt
	return target + (change + temp) * decay, (velocity - omega * temp) * decay
end

local function easeInOut(t: number): number
	return t * t * (3 - 2 * t)
end

function CameraController:Init(ctx)
	self.Ctx = ctx
	self.ShakeAmount = 0
	self.Spectate = nil
	self.Focus = nil
	self.FocusX = 0
	self.FocusXVel = 0
	self.FocusY = 0
	self.FocusYVel = 0
	self.AnchorY = 0
	self.LookAhead = 0
	self.LookAheadVel = 0
	self.LookDown = 0
	self.Distance = CAM.Distance
	self.Fov = CAM.FieldOfView
	self.FovPunch = 0
	self.KickOffset = Vector3.zero
	self.KickVelocity = Vector3.zero
	self.Blend = nil
	self.LastCFrame = nil
end

function CameraController:Start()
	RunService:BindToRenderStep("VR_Camera", Enum.RenderPriority.Camera.Value + 1, function(dt)
		local ok, err = pcall(self._update, self, dt)
		if not ok then
			warn("[CameraController] " .. tostring(err))
		end
	end)
	self.Ctx.ClientState:On("Teleported", function()
		self.Focus = nil
		self.Blend = nil
	end)
end

function CameraController:_motionAllowed(): boolean
	return self.Ctx.ClientState:GetSetting("CameraShake") ~= false
end

function CameraController:Shake(intensity: number)
	if not self:_motionAllowed() then
		return
	end
	self.ShakeAmount = math.max(self.ShakeAmount, intensity)
end

--- Stößt die Kamerafeder an (z.B. nach unten bei einer harten Landung).
function CameraController:Kick(impulse: Vector3)
	if not self:_motionAllowed() then
		return
	end
	self.KickVelocity += impulse
end

--- Kurzer Sichtfeld-Impuls (z.B. Dash, Boost-Pad).
function CameraController:PunchFov(amount: number)
	if not self:_motionAllowed() then
		return
	end
	self.FovPunch = math.clamp(self.FovPunch + amount, -CAM.MaxFovPunch, CAM.MaxFovPunch)
end

function CameraController:SetSpectate(target: Player?)
	if target == player then
		target = nil
	end
	if target == self.Spectate then
		return
	end
	self.Spectate = target
	self.Focus = nil
	-- Weicher Schwenk vom bisherigen Bild zum neuen Ziel
	if self.LastCFrame then
		self.Blend = { From = self.LastCFrame, Start = os.clock() }
	end
end

function CameraController:GetSpectate(): Player?
	return self.Spectate
end

function CameraController:GetFocusDistance(): number
	return math.sqrt(self.Distance * self.Distance + CAM.HeightOffset * CAM.HeightOffset)
end

function CameraController:_targetRoot(): BasePart?
	local target = self.Spectate
	if target and target.Parent and target.Character then
		local root = target.Character:FindFirstChild("HumanoidRootPart")
		if root then
			return root
		end
	end
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") or nil
end

function CameraController:_leaderBias(position: Vector3): number
	local state = self.Ctx.ClientState
	if self.Spectate or not state:IsInRace() or state:GetPhase() ~= "Racing" then
		return 0
	end
	for _, folder in state.Racers:GetChildren() do
		if folder:GetAttribute("Placement") == 1 and folder:GetAttribute("Status") == "Racing" then
			local leader = Players:GetPlayerByUserId(folder:GetAttribute("UserId") or 0)
			if leader and leader ~= player and leader.Character then
				local root = leader.Character:FindFirstChild("HumanoidRootPart")
				if root then
					local ahead = root.Position.X - position.X
					if ahead > 0 and ahead < 90 then
						return math.clamp(ahead * CAM.LeaderBias, 0, CAM.MaxLeaderBias)
					end
				end
			end
			break
		end
	end
	return 0
end

function CameraController:_update(rawDt: number)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	if camera.CameraType ~= Enum.CameraType.Scriptable then
		camera.CameraType = Enum.CameraType.Scriptable
	end
	local root = self:_targetRoot()
	if not root then
		return
	end
	-- Große Bildzeit-Sprünge (Ruckler) nicht in die Federn übernehmen
	local dt = math.min(rawDt, 1 / 20)
	local position = root.Position
	local velocity = root.AssemblyLinearVelocity
	local movement = self.Ctx.MovementController
	if not self.Spectate and movement.Velocity then
		velocity = movement.Velocity
	end

	if
		not self.Focus
		or math.abs(position.X - self.FocusX) > CAM.SnapDistance
		or math.abs(position.Y - self.FocusY) > CAM.SnapDistance
	then
		self.Focus = true
		self.FocusX = position.X
		self.FocusXVel = 0
		self.FocusY = position.Y
		self.FocusYVel = 0
		self.AnchorY = position.Y
		self.LookAhead = 0
		self.LookAheadVel = 0
		self.LookDown = 0
	end

	-- Horizontal: Vorausschau + Führenden-Versatz, beides weich gefedert
	local desiredLook = math.clamp(velocity.X * CAM.LookAheadFactor, -CAM.MaxLookAhead, CAM.MaxLookAhead)
	desiredLook += self:_leaderBias(position)
	self.LookAhead, self.LookAheadVel = smoothDamp(self.LookAhead, desiredLook, self.LookAheadVel, CAM.LookAheadSmoothTime, dt)
	self.FocusX, self.FocusXVel = smoothDamp(self.FocusX, position.X + self.LookAhead, self.FocusXVel, CAM.FollowSmoothTime, dt)

	-- Vertikal: Totzone, am Boden langsam zentrieren, beim Fallen schnell folgen
	local dy = position.Y - self.AnchorY
	if math.abs(dy) > CAM.VerticalDeadZone then
		self.AnchorY = position.Y - Util.Sign(dy) * CAM.VerticalDeadZone
	end
	if math.abs(velocity.Y) < 2 then
		self.AnchorY = Util.Damp(self.AnchorY, position.Y, CAM.GroundRecenter, dt)
	end
	local falling = velocity.Y < -60
	if falling then
		self.AnchorY = position.Y
	end
	local verticalTime = if falling then CAM.FallSmoothTime else CAM.VerticalSmoothTime
	self.FocusY, self.FocusYVel = smoothDamp(self.FocusY, self.AnchorY, self.FocusYVel, verticalTime, dt)
	local lookDown = math.clamp((-velocity.Y - 40) * CAM.FallLookDown, 0, CAM.MaxFallLookDown)
	self.LookDown = Util.Damp(self.LookDown, lookDown, 4, dt)

	-- Tempo: sanfter Zoom und Sichtfeld
	local speed = math.abs(velocity.X)
	local over = math.max(0, speed - Config.Movement.MaxRunSpeed)
	self.Distance = Util.Damp(self.Distance, CAM.Distance + math.min(over * CAM.SpeedZoom, CAM.MaxExtraDistance), CAM.ZoomSharpness, dt)
	self.Fov = Util.Damp(self.Fov, CAM.FieldOfView + math.min(over * CAM.SpeedFov, CAM.MaxExtraFov), CAM.FovSharpness, dt)
	self.FovPunch = Util.Damp(self.FovPunch, 0, 5, dt)

	-- Kamera-Stöße: gedämpfte Feder
	local accel = -self.KickOffset * CAM.KickStiffness - self.KickVelocity * CAM.KickDamping
	self.KickVelocity += accel * dt
	self.KickOffset += self.KickVelocity * dt
	if self.KickOffset.Magnitude > 4 then
		self.KickOffset = self.KickOffset.Unit * 4
	end

	-- Wackeln über Rauschfunktion (weich statt zufälligem Zittern)
	local shake = Vector3.zero
	local roll = 0
	if self.ShakeAmount > 0 then
		self.ShakeAmount = math.max(0, self.ShakeAmount - dt * CAM.ShakeDecay)
		local strength = self.ShakeAmount * self.ShakeAmount * 2.4
		local n = os.clock() * CAM.ShakeFrequency
		shake = Vector3.new(math.noise(n, 0.31), math.noise(n, 7.13), 0) * strength
		roll = math.noise(n, 13.7) * strength * 0.025
	end

	local focus = Vector3.new(self.FocusX, self.FocusY + CAM.FocusHeight - self.LookDown, Config.World.PlaneZ)
	local cameraPosition = focus + Vector3.new(0, CAM.HeightOffset, self.Distance) + shake + self.KickOffset
	local cframe = CFrame.lookAt(cameraPosition, focus + shake * 0.5 + self.KickOffset * 0.7)
	if roll ~= 0 then
		cframe *= CFrame.Angles(0, 0, roll)
	end

	-- Zuschauer-Schwenk
	local blend = self.Blend
	if blend then
		local alpha = (os.clock() - blend.Start) / CAM.SpectateBlendTime
		if alpha >= 1 or (blend.From.Position - cframe.Position).Magnitude > CAM.MaxBlendDistance then
			self.Blend = nil
		else
			cframe = blend.From:Lerp(cframe, easeInOut(math.clamp(alpha, 0, 1)))
		end
	end

	camera.CFrame = cframe
	camera.FieldOfView = math.clamp(self.Fov + self.FovPunch, 30, 100)
	self.LastCFrame = cframe
end

return CameraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">ClientState</string>
              <string name="Source"><![CDATA[--[[
	ClientState  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/Controllers/ClientState

	Zentrale Datenquelle des Clients:
		- Profil-Schnappschuss vom Server (nur lesend; Änderungen nur über Remotes)
		- Zugriff auf ReplicatedStorage/GameState
		- Verteilung der Server-Events (GameEvent) an beliebig viele Listener

	API:
		ClientState.Profile                   (table | nil)
		ClientState.ProfileChanged            (Signal: profile)
		ClientState:On(eventName, fn)         -> Connection
		ClientState:GetPhase() -> string
		ClientState:IsInRace() -> boolean
		ClientState:GetPracticeCourse() -> string
		ClientState:GetRegionDefinition() -> MapDefinition
		ClientState:GetSetting(key) -> any
		ClientState:SaveSettings(changes)
		ClientState.SettingsChanged           (Signal: settings)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared.Signal)
local Remotes = require(Shared.Remotes)
local MapDefinitions = require(Shared.MapDefinitions)

local player = Players.LocalPlayer

local ClientState = {}
ClientState.Profile = nil
ClientState.ProfileChanged = Signal.new()
ClientState.SettingsChanged = Signal.new()
ClientState.GameState = ReplicatedStorage:WaitForChild("GameState")
ClientState.Racers = ClientState.GameState:WaitForChild("Racers")

local events = {}

local DEFAULT_SETTINGS = {
	MusicVolume = 0.5,
	SfxVolume = 0.8,
	CameraShake = true,
	GamepadSensitivity = 1,
	TouchControls = true,
	AutoRequeue = true,
	ReducedEffects = false,
}

function ClientState:Init(_ctx)
	Remotes.GameEvent.OnClientEvent:Connect(function(name, payload)
		local signal = events[name]
		if signal then
			signal:Fire(payload or {})
		end
	end)
	Remotes.ProfileUpdate.OnClientEvent:Connect(function(snapshot)
		self:_setProfile(snapshot)
	end)
	task.spawn(function()
		for _ = 1, 5 do
			local ok, snapshot = pcall(function()
				return Remotes.GetProfile:InvokeServer()
			end)
			if ok and snapshot then
				if not self.Profile then
					self:_setProfile(snapshot)
				end
				return
			end
			task.wait(2)
		end
	end)
end

function ClientState:_setProfile(snapshot)
	if type(snapshot) ~= "table" then
		return
	end
	self.Profile = snapshot
	self.ProfileChanged:Fire(snapshot)
	self.SettingsChanged:Fire(self:GetSettings())
end

--- Registriert einen Listener für ein Server-Event (GameEvent).
function ClientState:On(name: string, fn: (any) -> ())
	local signal = events[name]
	if not signal then
		signal = Signal.new()
		events[name] = signal
	end
	return signal:Connect(fn)
end

function ClientState:GetPhase(): string
	return self.GameState:GetAttribute("Phase") or "Waiting"
end

function ClientState:IsInRace(): boolean
	return player:GetAttribute("InRace") == true
end

function ClientState:GetPracticeCourse(): string
	return player:GetAttribute("PracticeCourse") or ""
end

--- Map-Definition der Region, in der sich der lokale Spieler befindet.
function ClientState:GetRegionDefinition()
	if self:IsInRace() then
		local mapId = self.GameState:GetAttribute("MapId")
		local definition = mapId and MapDefinitions.Get(mapId)
		if definition then
			return definition
		end
	end
	local course = self:GetPracticeCourse()
	if course ~= "" then
		local definition = MapDefinitions.GetAny(course)
		if definition then
			return definition
		end
	end
	return MapDefinitions.Lobby
end

function ClientState:GetSettings()
	local settings = table.clone(DEFAULT_SETTINGS)
	if self.Profile and self.Profile.Settings then
		for key, value in self.Profile.Settings do
			settings[key] = value
		end
	end
	return settings
end

function ClientState:GetSetting(key: string)
	return self:GetSettings()[key]
end

local pendingSave = nil

--- Übernimmt Einstellungen lokal sofort und speichert sie gebündelt auf dem Server.
function ClientState:SaveSettings(changes)
	if self.Profile then
		self.Profile.Settings = self.Profile.Settings or {}
		for key, value in changes do
			self.Profile.Settings[key] = value
		end
	end
	self.SettingsChanged:Fire(self:GetSettings())
	if pendingSave then
		return
	end
	pendingSave = true
	task.delay(1.5, function()
		pendingSave = nil
		Remotes.SaveSettings:FireServer(self:GetSettings())
	end)
end

return ClientState
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">EffectsController</string>
              <string name="Source"><![CDATA[--[[
	EffectsController  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/Controllers/EffectsController

	Alle visuellen Effekte – komplett ohne externe Assets (Parts, Beams, Trails,
	ParticleEmitter mit Standardtextur, PointLight, Highlight, Explosion,
	Lighting-Effekte, Sky mit Standardtexturen, TweenService):

		Beleuchtung je Region (Lobby, Strecke, Training) aus Theme.Lighting:
			Lighting, Atmosphere, Sky (nur Sterne/Sonne/Mond), Bloom,
			ColorCorrection, SunRays, Tiefenunschärfe (nur der Hintergrund wird
			leicht weich, Spielebene und Läufer bleiben scharf). Fehlende Felder
			bekommen Standardwerte (LIGHT_DEFAULTS), Wechsel werden getweent.
			Zusätzlich ein weiches Licht an der verfolgten Figur (v.a. nachts).
		Bewegung:
			Speed-Lines und Rand-Vignette bei hohem Tempo (Bildschirm, gepoolt),
			Laufstaub an den Füßen (Farbe aus dem Theme), Slide-Staub und -Funken,
			Wall-Slide-Funken, Lande-Schockwelle + Staub + Kamerastoß,
			Sprung-/Wall-Jump-/Pad-Effekte, Dash-Nachbilder (gepoolte Geister),
			Boost-Aura (Flammen, Glut, Licht)
		Greifhaken: leuchtendes Seil mit Glow, Ausschuss-Animation und
			Nachschwingen, Funken am Anker; Zielmarkierung (Lock-on-Animation,
			rotierender Ring, Highlight am Anker, Farbe zeigt Abklingzeit)
		Rennen: Checkpoint-Blitz (Lichtsäule, Ring, Bildschirmblitz),
			Gefahrenwand (geschichtete Neon-Ebenen, wandernde Pulse, Glut,
			getönte Zone), Ausscheiden (Explosion, Trümmer, Rauch),
			Respawn-Lichtsäule, Siegesanimationen (Konfetti, Feuerwerk, Blitz,
			Goldregen) mit Siegerlicht
		Sonstiges: rotierende Item-Boxen, blinkende Zeit-Barrieren,
			Status (Schild, Freeze, Betäubung)

	"Reduzierte Effekte" in den Einstellungen schaltet Tiefenunschärfe und
	Sonnenstrahlen ab und verringert Partikelmengen, Speed-Lines und Nachbilder.

	API (auch für andere Module):
		:Burst(position, color, count, options?)
		:Ring(position, color, radius, duration, options?)   options.Flat = am Boden
		:Flash(position, color, size, duration)
		:ScreenFlash(color, strength, duration)
]]

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local ItemDefinitions = require(Shared.ItemDefinitions)
local CosmeticApplier = require(Shared.CosmeticApplier)
local RunnerRig = require(Shared.RunnerRig)

local player = Players.LocalPlayer
local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)
local FEET = Config.Character.FeetOffset
local MAX_RUN = Config.Movement.MaxRunSpeed

local NEAR_DISTANCE = 400
local SPEED_LINES = 14
local SPEED_LINES_REDUCED = 6
local GHOST_SETS = 10
local GHOST_LIFE = 0.32
local ROPE_SHOOT_TIME = 0.09
local DANGER = rgb(255, 40, 70)
local GREY = rgb(150, 150, 160)
local BOOST_PURPLE = rgb(200, 120, 255)

-- Standardwerte für Theme.Lighting. Fehlende oder falsch typisierte Felder
-- einer Map werden hiermit ergänzt.
local LIGHT_DEFAULTS = {
	ClockTime = 14,
	Brightness = 2.2,
	Ambient = rgb(105, 105, 120),
	OutdoorAmbient = rgb(140, 140, 155),
	FogColor = rgb(190, 210, 240),
	FogStart = 400,
	FogEnd = 3000,
	ColorShiftTop = rgb(0, 0, 0),
	ColorShiftBottom = rgb(0, 0, 0),
	GeographicLatitude = 41.7,
	ExposureCompensation = 0.1,
	EnvironmentDiffuseScale = 1,
	EnvironmentSpecularScale = 1,
	ShadowSoftness = 0.2,
	AtmosphereDensity = 0.25,
	AtmosphereOffset = 0.2,
	AtmosphereColor = rgb(200, 220, 255),
	AtmosphereDecay = rgb(130, 160, 220),
	Haze = 0.8,
	Glare = 0.2,
	Tint = rgb(255, 255, 255),
	Saturation = 0.15,
	Contrast = 0.08,
	ColorBrightness = 0.02,
	BloomIntensity = 0.6,
	BloomSize = 24,
	BloomThreshold = 1.1,
	SunRaysIntensity = 0.05,
	SunRaysSpread = 0.5,
	DofFarIntensity = 0.12,
	DofInFocusRadius = 30,
	StarCount = 3000,
	CelestialBodiesShown = true,
	SunAngularSize = 18,
	MoonAngularSize = 11,
	PlayerLight = -1, -- Helligkeit des Figurenlichts (-1 = automatisch nach Uhrzeit)
}

local EffectsController = {}

------------------------------------------------------------------------
-- Hilfen
------------------------------------------------------------------------

local function fxPart(props): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = props.Material or Enum.Material.Neon
	part.Color = props.Color or WHITE
	part.Size = props.Size or Vector3.one
	part.Transparency = props.Transparency or 0
	if props.Shape then
		part.Shape = props.Shape
	end
	part.CFrame = props.CFrame or CFrame.new()
	part.Name = props.Name or "FX"
	part.Parent = props.Parent
	return part
end

local function worldAttachment(name: string): Attachment
	local attachment = Instance.new("Attachment")
	attachment.Name = name
	attachment.Parent = workspace.Terrain
	return attachment
end

local function sequence(...): NumberSequence
	local points = { ... }
	local keypoints = {}
	for i = 1, #points, 2 do
		table.insert(keypoints, NumberSequenceKeypoint.new(points[i], points[i + 1]))
	end
	return NumberSequence.new(keypoints)
end

local function circle(parent: Instance, size: number, color: Color3, transparency: number, zIndex: number): Frame
	local frame = Instance.new("Frame")
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.Size = UDim2.fromScale(size, size)
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = transparency
	frame.BorderSizePixel = 0
	frame.ZIndex = zIndex
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = frame
	frame.Parent = parent
	return frame
end

local function easeOut(t: number): number
	return 1 - (1 - t) * (1 - t)
end

function EffectsController:_reduced(): boolean
	return self.Ctx.ClientState:GetSetting("ReducedEffects") == true
end

function EffectsController:_tween(instance: Instance, info: TweenInfo?, goal)
	if info then
		TweenService:Create(instance, info, goal):Play()
	else
		for key, value in goal do
			(instance :: any)[key] = value
		end
	end
end

------------------------------------------------------------------------
-- Öffentliche Einmal-Effekte
------------------------------------------------------------------------

--- Partikelstoß an einer Weltposition.
--- options: LifeMin, LifeMax, SpeedMin, SpeedMax, Spread (Vector2), Size, SizeEnd,
---          Transparency0, LightEmission, LightInfluence, Acceleration, Drag,
---          Direction (NormalId), Spin (Grad/s)
function EffectsController:Burst(position: Vector3, color, count: number, options)
	options = options or {}
	if self.Reduced then
		count = math.ceil(count * 0.35)
	end
	local attachment = Instance.new("Attachment")
	attachment.Position = position
	attachment.Parent = workspace.Terrain
	local emitter = Instance.new("ParticleEmitter")
	emitter.Enabled = false
	emitter.Lifetime = NumberRange.new(options.LifeMin or 0.4, options.LifeMax or 0.9)
	emitter.Speed = NumberRange.new(options.SpeedMin or 6, options.SpeedMax or 16)
	emitter.SpreadAngle = options.Spread or Vector2.new(180, 180)
	emitter.Size = sequence(0, options.Size or 0.6, 1, options.SizeEnd or 0)
	emitter.Transparency = sequence(0, options.Transparency0 or 0, 1, 1)
	if typeof(color) == "ColorSequence" then
		emitter.Color = color
	else
		emitter.Color = ColorSequence.new(color)
	end
	local lightEmission = options.LightEmission or 0.8
	emitter.LightEmission = lightEmission
	emitter.LightInfluence = options.LightInfluence or (if lightEmission > 0.5 then 0 else 1)
	emitter.Acceleration = options.Acceleration or Vector3.zero
	emitter.Drag = options.Drag or 2
	emitter.EmissionDirection = options.Direction or Enum.NormalId.Top
	if options.Spin then
		emitter.Rotation = NumberRange.new(0, 360)
		emitter.RotSpeed = NumberRange.new(-options.Spin, options.Spin)
	end
	emitter.Parent = attachment
	emitter:Emit(count)
	Debris:AddItem(attachment, (options.LifeMax or 0.9) + 0.5)
end

--- Sich ausdehnender Ring. Standard: Scheibe zur Kamera; options.Flat = flach am Boden.
--- options: Flat, Transparency (Start), Thickness, Material
function EffectsController:Ring(position: Vector3, color: Color3, radius: number, duration: number, options)
	options = options or {}
	local thickness = options.Thickness or (if options.Flat then 0.15 else 0.4)
	local orientation = if options.Flat then CFrame.Angles(0, 0, math.rad(90)) else CFrame.Angles(0, math.rad(90), 0)
	local ring = fxPart({
		Name = "Ring",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(thickness, 2, 2),
		CFrame = CFrame.new(position) * orientation,
		Color = color,
		Material = options.Material,
		Transparency = options.Transparency or 0.2,
		Parent = self.Folder,
	})
	local tween = TweenService:Create(ring, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(thickness, radius * 2, radius * 2),
		Transparency = 1,
	})
	tween:Play()
	Debris:AddItem(ring, duration + 0.1)
end

--- Aufblitzende, wachsende Leuchtkugel.
function EffectsController:Flash(position: Vector3, color: Color3, size: number, duration: number)
	local ball = fxPart({
		Name = "Flash",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * math.max(0.5, size * 0.25),
		CFrame = CFrame.new(position),
		Color = color,
		Transparency = 0.05,
		Parent = self.Folder,
	})
	TweenService:Create(ball, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.one * size,
		Transparency = 1,
	}):Play()
	Debris:AddItem(ball, duration + 0.1)
end

--- Kurzer farbiger Bildschirmblitz (0 < strength <= 1).
function EffectsController:ScreenFlash(color: Color3, strength: number, duration: number)
	local frame = self.FlashFrame
	if not frame then
		return
	end
	if self.Reduced then
		strength *= 0.5
	end
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = 1 - math.clamp(strength, 0, 1)
	TweenService:Create(frame, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		BackgroundTransparency = 1,
	}):Play()
end

------------------------------------------------------------------------
-- Init / Start
------------------------------------------------------------------------

function EffectsController:Init(ctx)
	self.Ctx = ctx
	self.Folder = Instance.new("Folder")
	self.Folder.Name = "VR_ClientFX"
	self.Folder.Parent = workspace
	self.Ropes = {}
	self.Status = {}
	self.ZoneVisualX = nil
	self.ZoneVisible = false
	self.CurrentTheme = nil
	self.Light = LIGHT_DEFAULTS
	self.LightApplied = false
	self.ClockTime = nil
	self.Accent = rgb(0, 214, 255)
	self.DustColor = rgb(225, 220, 210)
	self.ThemeVersion = 0
	self.Reduced = false
	self.SpeedIntensity = 0
	self.LineDirection = 1
	self.LinesActive = 0
	self.GhostPool = {}
	self.GhostCursor = 0
	self.LastAfterimage = 0
	self.DofDistance = 0
	self.MarkerTarget = nil
	self.MarkerLockAt = 0
	self.MarkerColor = nil

	self:_initLighting()
	self:_initMarker()
	self:_initZone()
	self:_initScreen()
end

function EffectsController:_initLighting()
	self.Atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	self.Atmosphere.Parent = Lighting
	-- Himmel: vorhandenen Sky nutzen, sonst einen mit Standardtexturen anlegen
	local sky = Lighting:FindFirstChildOfClass("Sky")
	if not sky then
		sky = Instance.new("Sky")
		sky.Name = "VR_Sky"
		sky.Parent = Lighting
	end
	self.Sky = sky
	self.Bloom = Instance.new("BloomEffect")
	self.Bloom.Name = "VR_Bloom"
	self.Bloom.Parent = Lighting
	self.Color = Instance.new("ColorCorrectionEffect")
	self.Color.Name = "VR_Color"
	self.Color.Parent = Lighting
	self.SunRays = Instance.new("SunRaysEffect")
	self.SunRays.Name = "VR_SunRays"
	self.SunRays.Parent = Lighting
	-- Tiefenunschärfe: nur der weit entfernte Hintergrund wird weich
	self.Dof = Instance.new("DepthOfFieldEffect")
	self.Dof.Name = "VR_DepthOfField"
	self.Dof.NearIntensity = 0
	self.Dof.FocusDistance = 50
	self.Dof.InFocusRadius = 30
	self.Dof.FarIntensity = 0.1
	self.Dof.Parent = Lighting

	-- Weiches Licht an der verfolgten Figur
	self.PlayerLightAttachment = worldAttachment("VR_PlayerLight")
	local light = Instance.new("PointLight")
	light.Range = 16
	light.Brightness = 0.5
	light.Shadows = false
	light.Color = rgb(255, 245, 230)
	light.Parent = self.PlayerLightAttachment
	self.PlayerLight = light
end

function EffectsController:_initMarker()
	local marker = Instance.new("BillboardGui")
	marker.Name = "VR_GrappleTarget"
	marker.Size = UDim2.fromOffset(76, 76)
	marker.AlwaysOnTop = true
	marker.LightInfluence = 0
	marker.ResetOnSpawn = false
	marker.Enabled = false
	local root = Instance.new("Frame")
	root.Name = "Root"
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.Position = UDim2.fromScale(0.5, 0.5)
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundTransparency = 1
	root.Parent = marker
	local scale = Instance.new("UIScale")
	scale.Parent = root

	local glow = circle(root, 0.95, self.Accent, 0.82, 1)
	glow.Name = "Glow"
	local ring = circle(root, 0.6, WHITE, 1, 2)
	ring.Name = "Ring"
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = WHITE
	stroke.Parent = ring
	local gradient = Instance.new("UIGradient")
	gradient.Transparency = sequence(0, 0, 0.5, 0.55, 1, 0)
	gradient.Parent = stroke
	local dot = circle(root, 0.16, WHITE, 0, 3)
	dot.Name = "Dot"

	-- Vier Fadenkreuz-Striche, die sich langsam drehen
	local reticle = Instance.new("Frame")
	reticle.Name = "Reticle"
	reticle.AnchorPoint = Vector2.new(0.5, 0.5)
	reticle.Position = UDim2.fromScale(0.5, 0.5)
	reticle.Size = UDim2.fromScale(1, 1)
	reticle.BackgroundTransparency = 1
	reticle.ZIndex = 4
	reticle.Parent = root
	local ticks = {}
	for _, info in {
		{ UDim2.fromScale(0.5, 0.06), UDim2.fromScale(0.06, 0.2) },
		{ UDim2.fromScale(0.5, 0.94), UDim2.fromScale(0.06, 0.2) },
		{ UDim2.fromScale(0.06, 0.5), UDim2.fromScale(0.2, 0.06) },
		{ UDim2.fromScale(0.94, 0.5), UDim2.fromScale(0.2, 0.06) },
	} do
		local tick = Instance.new("Frame")
		tick.AnchorPoint = Vector2.new(0.5, 0.5)
		tick.Position = info[1]
		tick.Size = info[2]
		tick.BackgroundColor3 = WHITE
		tick.BorderSizePixel = 0
		tick.ZIndex = 4
		tick.Parent = reticle
		table.insert(ticks, tick)
	end

	marker.Parent = player:WaitForChild("PlayerGui")
	self.Marker = marker
	self.MarkerParts = {
		Scale = scale,
		Glow = glow,
		Stroke = stroke,
		Gradient = gradient,
		Dot = dot,
		Reticle = reticle,
		Ticks = ticks,
	}

	local highlight = Instance.new("Highlight")
	highlight.Name = "VR_TargetHighlight"
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.FillTransparency = 0.6
	highlight.OutlineTransparency = 0.1
	highlight.OutlineColor = WHITE
	highlight.Enabled = false
	highlight.Parent = self.Folder
	self.Highlight = highlight
end

function EffectsController:_initZone()
	local zone = { Glows = {}, Pulses = {} }
	-- Seitlich sichtbare Energiewand (YZ-Ebene) – wirkt durch die Perspektive räumlich
	zone.Sheet = fxPart({ Name = "DangerSheet", Size = Vector3.new(0.5, 400, 64), Color = DANGER, Transparency = 1, Parent = self.Folder })
	-- Helle Kante vor der Strecke + weicher Verlauf aus überlagerten Streifen
	zone.Line = fxPart({ Name = "DangerLine", Size = Vector3.new(0.9, 400, 0.2), Color = rgb(255, 175, 190), Transparency = 1, Parent = self.Folder })
	for i, info in { { 2.5, 0.72 }, { 5, 0.8 }, { 9, 0.87 }, { 15, 0.92 } } do
		zone.Glows[i] = {
			Part = fxPart({ Name = "DangerGlow", Size = Vector3.new(info[1], 400, 0.2), Color = DANGER, Transparency = 1, Parent = self.Folder }),
			Width = info[1],
			Base = info[2],
		}
	end
	-- Getönte Zone vorn und hinten (Teile höchstens 2048 Studs groß)
	zone.Tint = fxPart({
		Name = "DangerTint",
		Size = Vector3.new(2000, 400, 0.2),
		Color = rgb(255, 30, 60),
		Material = Enum.Material.SmoothPlastic,
		Transparency = 1,
		Parent = self.Folder,
	})
	zone.Back = fxPart({
		Name = "DangerBack",
		Size = Vector3.new(2000, 400, 0.5),
		Color = rgb(150, 10, 40),
		Material = Enum.Material.SmoothPlastic,
		Transparency = 1,
		Parent = self.Folder,
	})
	-- Wandernde Energiepulse entlang der Kante
	for i = 1, 3 do
		zone.Pulses[i] = fxPart({ Name = "DangerPulse", Size = Vector3.new(1.5, 7, 0.2), Color = WHITE, Transparency = 1, Parent = self.Folder })
	end
	-- Glut, die in die Gefahrenzone treibt
	zone.EmberSource = fxPart({ Name = "DangerEmbers", Size = Vector3.new(1, 70, 4), Transparency = 1, Parent = self.Folder })
	local embers = Instance.new("ParticleEmitter")
	embers.Enabled = false
	embers.Rate = 30
	embers.Lifetime = NumberRange.new(1, 1.8)
	embers.Speed = NumberRange.new(3, 9)
	embers.SpreadAngle = Vector2.new(25, 60)
	embers.EmissionDirection = Enum.NormalId.Left
	embers.Size = sequence(0, 0.45, 1, 0)
	embers.Color = ColorSequence.new(rgb(255, 200, 120), DANGER)
	embers.LightEmission = 1
	embers.LightInfluence = 0
	embers.Acceleration = Vector3.new(0, 6, 0)
	embers.Drag = 0.5
	embers.Parent = zone.EmberSource
	zone.Embers = embers
	self.Zone = zone
end

function EffectsController:_initScreen()
	local gui = Instance.new("ScreenGui")
	gui.Name = "VR_ScreenFX"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 1 -- unter der Spiel-UI
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	-- Rand-Vignette bei hohem Tempo
	self.Vignette = {}
	for _, side in { 0, 1 } do
		local edge = Instance.new("Frame")
		edge.Name = "SpeedVignette"
		edge.AnchorPoint = Vector2.new(side, 0)
		edge.Position = UDim2.fromScale(side, 0)
		edge.Size = UDim2.fromScale(0.24, 1)
		edge.BackgroundColor3 = rgb(10, 12, 28)
		edge.BackgroundTransparency = 1
		edge.BorderSizePixel = 0
		local gradient = Instance.new("UIGradient")
		gradient.Transparency = sequence(0, 0, 1, 1)
		gradient.Rotation = if side == 0 then 0 else 180
		gradient.Parent = edge
		edge.Parent = gui
		table.insert(self.Vignette, edge)
	end

	-- Speed-Lines (gepoolt)
	local lines = Instance.new("Frame")
	lines.Name = "SpeedLines"
	lines.Size = UDim2.fromScale(1, 1)
	lines.BackgroundTransparency = 1
	lines.Visible = false
	lines.Parent = gui
	self.LinesFrame = lines
	self.SpeedLines = {}
	for i = 1, SPEED_LINES do
		local frame = Instance.new("Frame")
		frame.AnchorPoint = Vector2.new(0.5, 0.5)
		frame.BackgroundColor3 = WHITE
		frame.BackgroundTransparency = 1
		frame.BorderSizePixel = 0
		local gradient = Instance.new("UIGradient")
		gradient.Transparency = sequence(0, 1, 0.55, 0.25, 0.85, 0, 1, 1)
		gradient.Parent = frame
		frame.Parent = lines
		local line = { Frame = frame, Gradient = gradient, X = 0, Y = 0, Speed = 1, Alpha = 1 }
		self:_resetLine(line, i / SPEED_LINES)
		self.SpeedLines[i] = line
	end

	-- Bildschirmblitz
	local flash = Instance.new("Frame")
	flash.Name = "Flash"
	flash.Size = UDim2.fromScale(1, 1)
	flash.BackgroundColor3 = WHITE
	flash.BackgroundTransparency = 1
	flash.BorderSizePixel = 0
	flash.ZIndex = 5
	flash.Parent = gui
	self.FlashFrame = flash

	gui.Parent = player:WaitForChild("PlayerGui")
	self.ScreenGui = gui
end

--- Setzt eine Speed-Line an eine neue Startposition (start = 0..1 über den Bildschirm verteilt).
function EffectsController:_resetLine(line, start: number?)
	local band = math.random()
	-- Nur obere und untere Bildbereiche, damit die Mitte frei bleibt
	line.Y = if band < 0.5 then 0.05 + band * 0.62 else 0.95 - (band - 0.5) * 0.62
	local length = 0.07 + math.random() * 0.16
	line.Speed = 1.1 + math.random() * 1.3
	line.Alpha = 0.35 + math.random() * 0.45
	if start then
		line.X = start * 1.4 - 0.2
	else
		line.X = if self.LineDirection > 0 then 1.15 + math.random() * 0.25 else -0.15 - math.random() * 0.25
	end
	line.Frame.Size = UDim2.new(length, 0, 0, if math.random() < 0.3 then 3 else 2)
end

function EffectsController:Start()
	local state = self.Ctx.ClientState
	local movement = self.Ctx.MovementController
	local camera = self.Ctx.CameraController

	-- Beleuchtung je Region
	local function refreshTheme()
		self:_applyTheme(state:GetRegionDefinition())
	end
	player:GetAttributeChangedSignal("InRace"):Connect(refreshTheme)
	player:GetAttributeChangedSignal("PracticeCourse"):Connect(refreshTheme)
	state.GameState:GetAttributeChangedSignal("MapId"):Connect(refreshTheme)
	state.SettingsChanged:Connect(function()
		self:_applyQuality()
	end)
	refreshTheme()
	self:_applyQuality()

	-- Bewegungs-Effekte (lokal)
	movement.Landed:Connect(function(impact, position)
		self:_landFx(impact, position)
	end)
	movement.Jumped:Connect(function(kind)
		self:_jumpFx(kind)
	end)
	movement.SlideStarted:Connect(function()
		local root = self:_localRoot()
		if root then
			local facing = movement:GetFacing()
			self:Burst(root.Position + Vector3.new(facing * 0.8, FEET + 0.3, 0), self.DustColor, 8, {
				SpeedMin = 6,
				SpeedMax = 12,
				Size = 0.9,
				SizeEnd = 2,
				Transparency0 = 0.3,
				LightEmission = 0,
				Spread = Vector2.new(20, 20),
				Direction = if facing > 0 then Enum.NormalId.Right else Enum.NormalId.Left,
				Drag = 5,
				Acceleration = Vector3.new(0, 6, 0),
			})
		end
	end)
	movement.BoostPad:Connect(function(position)
		self:Burst(position, ColorSequence.new(rgb(255, 230, 120), rgb(255, 120, 30)), 14, { SpeedMin = 8, SpeedMax = 20 })
		self:Ring(position + Vector3.new(0, FEET + 0.3, 0), rgb(255, 180, 40), 7, 0.35, { Flat = true, Transparency = 0.15 })
		camera:Shake(0.3)
		camera:PunchFov(5)
	end)
	movement.DashStarted:Connect(function()
		local root = self:_localRoot()
		if root then
			self:Burst(root.Position, rgb(200, 230, 255), 12, { SpeedMin = 8, SpeedMax = 20, Size = 0.5 })
			self:Ring(root.Position, self:_accentOf(player.Character), 4.5, 0.22, { Transparency = 0.35 })
		end
		camera:PunchFov(6)
	end)
	movement.GrappleStarted:Connect(function()
		camera:PunchFov(1.5)
	end)

	-- Server-Events
	state:On("ItemPickup", function(payload)
		local item = ItemDefinitions.Get(payload.ItemId)
		local color = if item then item.Color else WHITE
		self:Burst(payload.Position, ColorSequence.new(WHITE, color), 20, { SpeedMax = 20, Spin = 180 })
		self:Ring(payload.Position, color, 5, 0.3)
		self:Flash(payload.Position, color, 4, 0.25)
	end)
	state:On("PowerUpUsed", function(payload)
		self:_onPowerUp(payload)
	end)
	state:On("ShieldBlocked", function(payload)
		local blue = rgb(120, 210, 255)
		self:Burst(payload.Position, ColorSequence.new(WHITE, blue), 24, { SpeedMin = 10, SpeedMax = 22 })
		self:Ring(payload.Position, blue, 7, 0.35)
		self:Flash(payload.Position, blue, 8, 0.25)
	end)
	state:On("StatusApplied", function(payload)
		local color = if payload.Kind == "Slowed" then rgb(170, 230, 255) else rgb(255, 230, 80)
		self:Burst(payload.Position, color, 14)
		self:Ring(payload.Position, color, 4, 0.3)
		if payload.UserId == player.UserId then
			camera:Shake(0.5)
			self:ScreenFlash(color, 0.25, 0.35)
		end
	end)
	state:On("RacerEliminated", function(payload)
		if payload.Position then
			self:_eliminationFx(payload.Position, payload.UserId == player.UserId)
		end
	end)
	state:On("RacerRespawn", function(payload)
		self:_respawnFx(payload)
	end)
	state:On("MatchResults", function(payload)
		local winner = Players:GetPlayerByUserId(payload.WinnerUserId or 0)
		if winner and winner.Character then
			local root = winner.Character:FindFirstChild("HumanoidRootPart")
			if root then
				self:_victory(winner.Character:GetAttribute("Victory") or "Default", root)
			end
		end
	end)

	self:_watchCheckpoints()

	RunService.RenderStepped:Connect(function(dt)
		local ok, err = pcall(self._update, self, dt)
		if not ok then
			warn("[EffectsController] " .. tostring(err))
		end
	end)
end

function EffectsController:_localRoot(): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") or nil
end

function EffectsController:_accentOf(character: Model?): Color3
	local accent = character and character:GetAttribute("AccentColor")
	if typeof(accent) == "Color3" then
		return accent
	end
	return rgb(230, 240, 255)
end

------------------------------------------------------------------------
-- Beleuchtung
------------------------------------------------------------------------

function EffectsController:_applyTheme(definition)
	if not definition or self.CurrentTheme == definition.Id then
		return
	end
	self.CurrentTheme = definition.Id
	local theme = definition.Theme or {}
	local source = theme.Lighting or {}
	local light = {}
	for key, default in LIGHT_DEFAULTS do
		local value = source[key]
		if value == nil or typeof(value) ~= typeof(default) then
			value = default
		end
		light[key] = value
	end
	self.Light = light
	-- Erster Aufruf ohne Tween, damit das Spiel direkt im richtigen Look startet
	local info = if self.LightApplied then TweenInfo.new(1.2, Enum.EasingStyle.Sine) else nil
	self.LightApplied = true

	-- Uhrzeit: über Mitternacht nicht tweenen (sonst kurz Tageslicht)
	if info and self.ClockTime and math.abs(light.ClockTime - self.ClockTime) <= 12 then
		TweenService:Create(Lighting, info, { ClockTime = light.ClockTime }):Play()
	else
		Lighting.ClockTime = light.ClockTime
	end
	self.ClockTime = light.ClockTime

	self:_tween(Lighting, info, {
		Brightness = light.Brightness,
		Ambient = light.Ambient,
		OutdoorAmbient = light.OutdoorAmbient,
		FogColor = light.FogColor,
		FogStart = light.FogStart,
		FogEnd = light.FogEnd,
		ColorShift_Top = light.ColorShiftTop,
		ColorShift_Bottom = light.ColorShiftBottom,
		GeographicLatitude = light.GeographicLatitude,
		ExposureCompensation = math.clamp(light.ExposureCompensation, -3, 3),
		EnvironmentDiffuseScale = math.clamp(light.EnvironmentDiffuseScale, 0, 1),
		EnvironmentSpecularScale = math.clamp(light.EnvironmentSpecularScale, 0, 1),
		ShadowSoftness = math.clamp(light.ShadowSoftness, 0, 1),
	})
	self:_tween(self.Atmosphere, info, {
		Density = light.AtmosphereDensity,
		Offset = light.AtmosphereOffset,
		Color = light.AtmosphereColor,
		Decay = light.AtmosphereDecay,
		Haze = light.Haze,
		Glare = light.Glare,
	})
	self:_tween(self.Color, info, {
		TintColor = light.Tint,
		Saturation = light.Saturation,
		Contrast = light.Contrast,
		Brightness = light.ColorBrightness,
	})
	self:_tween(self.Bloom, info, {
		Intensity = light.BloomIntensity,
		Size = math.clamp(light.BloomSize, 0, 56),
		Threshold = light.BloomThreshold,
	})
	self:_tween(self.SunRays, info, {
		Intensity = light.SunRaysIntensity,
		Spread = light.SunRaysSpread,
	})
	self:_tween(self.Dof, info, {
		FarIntensity = math.clamp(light.DofFarIntensity, 0, 1),
		InFocusRadius = math.clamp(light.DofInFocusRadius, 0, 50),
	})
	self.Sky.StarCount = math.clamp(math.floor(light.StarCount), 0, 5000)
	self.Sky.CelestialBodiesShown = light.CelestialBodiesShown
	self:_tween(self.Sky, info, {
		SunAngularSize = math.clamp(light.SunAngularSize, 0, 60),
		MoonAngularSize = math.clamp(light.MoonAngularSize, 0, 60),
	})

	-- Figurenlicht: nachts kräftiger, tagsüber nur ein leichter Aufheller
	local night = light.ClockTime < 6.3 or light.ClockTime > 17.7
	local brightness = if light.PlayerLight >= 0 then light.PlayerLight elseif night then 1.4 else 0.45
	self:_tween(self.PlayerLight, info, { Brightness = brightness })

	-- Theme-Farben für Staub und Effekte
	if typeof(theme.Top) == "Color3" then
		self.DustColor = theme.Top:Lerp(rgb(235, 230, 220), 0.55)
	end
	if typeof(theme.Accent) == "Color3" then
		self.Accent = theme.Accent
	end
	self.MarkerColor = nil -- Markerfarben beim nächsten Frame neu setzen
	self.ThemeVersion += 1
	self:_applyQuality()
end

--- Qualitätsabhängige Effekte (Einstellung "Reduzierte Effekte").
function EffectsController:_applyQuality()
	local reduced = self:_reduced()
	self.Reduced = reduced
	local light = self.Light
	self.SunRays.Enabled = not reduced and light.SunRaysIntensity > 0
	self.Dof.Enabled = not reduced and light.DofFarIntensity > 0
end

------------------------------------------------------------------------
-- Bewegung (lokal)
------------------------------------------------------------------------

function EffectsController:_landFx(impact: number, position: Vector3)
	local camera = self.Ctx.CameraController
	local strength = math.clamp((impact - 45) / 80, 0, 1)
	local count = math.floor(5 + strength * 9)
	for _, direction in { Enum.NormalId.Left, Enum.NormalId.Right } do
		self:Burst(position + Vector3.new(0, 0.3, 0), self.DustColor, count, {
			SpeedMin = 6,
			SpeedMax = 10 + strength * 14,
			LifeMin = 0.35,
			LifeMax = 0.75,
			Size = 1 + strength,
			SizeEnd = 2.2,
			Transparency0 = 0.3,
			LightEmission = 0,
			Spread = Vector2.new(12, 12),
			Direction = direction,
			Drag = 5,
			Acceleration = Vector3.new(0, 4, 0),
		})
	end
	self:Ring(position + Vector3.new(0, 0.15, 0), self.DustColor:Lerp(WHITE, 0.5), 4 + strength * 8, 0.35, { Flat = true, Transparency = 0.3 })
	if strength > 0.4 then
		self:Ring(position + Vector3.new(0, 1.2, 0), WHITE, 3 + strength * 5, 0.25, { Transparency = 0.6 })
	end
	camera:Kick(Vector3.new(0, -(4 + strength * 14), 0))
	if impact > 90 then
		camera:Shake(0.6)
	end
end

function EffectsController:_jumpFx(kind: string)
	local root = self:_localRoot()
	if not root then
		return
	end
	local movement = self.Ctx.MovementController
	local position = root.Position
	local feet = position + Vector3.new(0, FEET + 0.3, 0)
	if kind == "Jump" then
		self:Burst(feet, self.DustColor, 5, {
			SpeedMin = 3,
			SpeedMax = 7,
			Size = 0.8,
			SizeEnd = 1.6,
			Transparency0 = 0.35,
			LightEmission = 0,
			Spread = Vector2.new(70, 10),
			Drag = 4,
			LifeMax = 0.6,
		})
	elseif kind == "WallJump" then
		-- Nach dem Wall-Jump schaut die Figur von der Wand weg
		local wallSide = position + Vector3.new(-movement:GetFacing() * 1.1, -0.5, 0)
		self:Burst(wallSide, ColorSequence.new(rgb(255, 240, 170), rgb(255, 140, 40)), 12, {
			SpeedMin = 8,
			SpeedMax = 18,
			Size = 0.35,
			LifeMax = 0.5,
			Acceleration = Vector3.new(0, -60, 0),
			LightEmission = 1,
		})
		self:Burst(wallSide, self.DustColor, 5, { SpeedMin = 2, SpeedMax = 5, Size = 0.9, SizeEnd = 1.8, Transparency0 = 0.35, LightEmission = 0 })
		self:Ring(wallSide, WHITE, 3.5, 0.22, { Transparency = 0.45 })
	elseif kind == "Pad" then
		local green = rgb(80, 255, 140)
		self:Burst(feet, green, 14, { SpeedMax = 16 })
		self:Ring(feet, green, 6, 0.35, { Flat = true, Transparency = 0.15 })
		self.Ctx.CameraController:PunchFov(4)
	elseif kind == "GrappleJump" then
		self:Burst(position, self:_accentOf(player.Character), 10, { SpeedMax = 14, Size = 0.5 })
	end
end

------------------------------------------------------------------------
-- Rennen: Checkpoints, Ausscheiden, Respawn
------------------------------------------------------------------------

function EffectsController:_watchCheckpoints()
	local state = self.Ctx.ClientState
	local function watch(folder: Instance)
		if folder.Name ~= tostring(player.UserId) then
			return
		end
		local last = folder:GetAttribute("Checkpoint") or 1
		folder:GetAttributeChangedSignal("Checkpoint"):Connect(function()
			local index = folder:GetAttribute("Checkpoint") or 1
			if index > last then
				self:_checkpointFx(index)
			end
			last = index
		end)
	end
	for _, folder in state.Racers:GetChildren() do
		watch(folder)
	end
	state.Racers.ChildAdded:Connect(watch)
end

function EffectsController:_checkpointFx(index: number)
	local root = self:_localRoot()
	if not root then
		return
	end
	local position = root.Position
	local x = position.X
	local list = string.split(self.Ctx.ClientState.GameState:GetAttribute("CheckpointXs") or "", ",")
	local checkpointX = tonumber(list[index])
	if checkpointX and math.abs(checkpointX - x) < 80 then
		x = checkpointX
	end
	local color = self.Accent:Lerp(WHITE, 0.15)
	-- Lichtsäule knapp hinter der Strecke
	local pillar = fxPart({ Name = "CheckpointPillar", Size = Vector3.new(2.5, 90, 0.4), CFrame = CFrame.new(x, position.Y + 30, -6.5), Color = color, Transparency = 0.25, Parent = self.Folder })
	TweenService:Create(pillar, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(10, 90, 0.4),
		Transparency = 1,
	}):Play()
	Debris:AddItem(pillar, 0.7)
	local core = fxPart({ Name = "CheckpointCore", Size = Vector3.new(0.8, 90, 0.4), CFrame = CFrame.new(x, position.Y + 30, -6.3), Color = WHITE, Parent = self.Folder })
	TweenService:Create(core, TweenInfo.new(0.45), { Transparency = 1 }):Play()
	Debris:AddItem(core, 0.5)
	self:Ring(position, color, 7, 0.4, { Transparency = 0.35 })
	self:Burst(position + Vector3.new(0, 1, 0), ColorSequence.new(WHITE, color), 22, {
		SpeedMin = 10,
		SpeedMax = 24,
		LifeMax = 0.8,
		Acceleration = Vector3.new(0, -20, 0),
		Size = 0.5,
		Spin = 200,
	})
	self:ScreenFlash(color, 0.2, 0.35)
	self.Ctx.CameraController:PunchFov(2.5)
end

function EffectsController:_eliminationFx(position: Vector3, isLocal: boolean)
	local camera = self.Ctx.CameraController
	local explosion = Instance.new("Explosion")
	explosion.BlastPressure = 0
	explosion.BlastRadius = 6
	explosion.DestroyJointPercent = 0
	explosion.ExplosionType = Enum.ExplosionType.NoCraters
	explosion.Position = position
	explosion.Parent = self.Folder
	self:Flash(position, rgb(255, 230, 200), 11, 0.3)
	self:Ring(position, rgb(255, 70, 90), 14, 0.45, { Transparency = 0.3 })
	self:Burst(position, ColorSequence.new({
		ColorSequenceKeypoint.new(0, rgb(255, 245, 180)),
		ColorSequenceKeypoint.new(0.4, rgb(255, 140, 40)),
		ColorSequenceKeypoint.new(1, rgb(255, 40, 70)),
	}), 36, { SpeedMin = 15, SpeedMax = 40, Size = 0.9, LifeMax = 1, Acceleration = Vector3.new(0, -40, 0), Drag = 1.5 })
	self:Burst(position, rgb(60, 55, 65), 12, {
		SpeedMin = 3,
		SpeedMax = 9,
		LifeMin = 0.8,
		LifeMax = 1.5,
		Size = 2.4,
		SizeEnd = 4.5,
		Transparency0 = 0.35,
		LightEmission = 0,
		Drag = 3,
		Acceleration = Vector3.new(0, 5, 0),
		Spin = 60,
	})
	-- Trümmer: lokale, nicht kollidierende Physik-Teile
	local pieces = if self.Reduced then 3 else 8
	for _ = 1, pieces do
		local size = 0.5 + math.random() * 0.6
		local piece = fxPart({
			Name = "Debris",
			Size = Vector3.one * size,
			CFrame = CFrame.new(position) * CFrame.Angles(math.random() * 6, math.random() * 6, 0),
			Color = if math.random() < 0.5 then rgb(255, 70, 90) else rgb(60, 60, 70),
			Material = if math.random() < 0.4 then Enum.Material.Neon else Enum.Material.SmoothPlastic,
			Parent = self.Folder,
		})
		piece.Anchored = false
		piece.Massless = true
		piece.AssemblyLinearVelocity = Vector3.new((math.random() - 0.5) * 60, 25 + math.random() * 35, (math.random() - 0.5) * 6)
		piece.AssemblyAngularVelocity = Vector3.new(math.random() * 20 - 10, math.random() * 20 - 10, math.random() * 20 - 10)
		TweenService:Create(piece, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Transparency = 1 }):Play()
		Debris:AddItem(piece, 1.2)
	end
	if isLocal then
		camera:Shake(1.2)
		self:ScreenFlash(DANGER, 0.45, 0.6)
	elseif self:_nearCamera(position, 120) then
		camera:Shake(0.35)
	end
end

function EffectsController:_respawnFx(payload)
	if payload.From then
		self:Burst(payload.From, rgb(240, 240, 255), 16, { Size = 1, SizeEnd = 1.8, LightEmission = 0.2, Transparency0 = 0.2 })
		self:Flash(payload.From, WHITE, 5, 0.25)
	end
	if payload.To then
		local cyan = rgb(120, 220, 255)
		local pillar = fxPart({ Name = "RespawnBeam", Size = Vector3.new(3.2, 30, 0.3), CFrame = CFrame.new(payload.To + Vector3.new(0, 11, -2.5)), Color = cyan, Transparency = 0.25, Parent = self.Folder })
		TweenService:Create(pillar, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Size = Vector3.new(0.2, 30, 0.3),
			Transparency = 1,
		}):Play()
		Debris:AddItem(pillar, 0.6)
		self:Ring(payload.To, cyan, 6, 0.35, { Transparency = 0.35 })
		self:Ring(payload.To + Vector3.new(0, FEET + 0.2, 0), cyan, 5, 0.4, { Flat = true })
		self:Burst(payload.To, ColorSequence.new(WHITE, cyan), 16, { Spin = 180 })
		if payload.UserId == player.UserId then
			self:ScreenFlash(WHITE, 0.25, 0.35)
		end
	end
end

function EffectsController:_nearCamera(position: Vector3, distance: number): boolean
	local currentCamera = workspace.CurrentCamera
	return currentCamera ~= nil and (currentCamera.CFrame.Position - position).Magnitude < distance
end

------------------------------------------------------------------------
-- Power-ups und Sieg
------------------------------------------------------------------------

function EffectsController:_onPowerUp(payload)
	local item = ItemDefinitions.Get(payload.ItemId)
	if not item then
		return
	end
	local camera = self.Ctx.CameraController
	local isLocal = payload.UserId == player.UserId
	if payload.ItemId == "FreezeBurst" then
		self:Ring(payload.Position, item.Color, item.Radius, 0.6)
		self:Ring(payload.Position, WHITE, item.Radius * 0.6, 0.4, { Transparency = 0.5 })
		self:Burst(payload.Position, ColorSequence.new(WHITE, item.Color), 30, { SpeedMin = 20, SpeedMax = 40, Spin = 120 })
	elseif payload.ItemId == "TeleportBeacon" then
		if payload.From then
			self:Burst(payload.From, item.Color, 24, { SpeedMax = 20 })
			self:Flash(payload.From, item.Color, 6, 0.3)
		end
		if payload.To then
			self:Burst(payload.To, item.Color, 24, { SpeedMax = 20 })
			self:Ring(payload.To, item.Color, 8, 0.4)
		end
	elseif payload.ItemId == "Trap" and payload.TrapPosition then
		self:Burst(payload.TrapPosition, item.Color, 14)
	else
		self:Burst(payload.Position, item.Color, 20, { SpeedMax = 20 })
		self:Ring(payload.Position, item.Color, 5, 0.3, { Transparency = 0.4 })
	end
	if isLocal then
		camera:Shake(0.35)
	end
end

function EffectsController:_victory(kind: string, root: BasePart)
	local origin = root.Position
	local reduced = self.Reduced
	local gold = rgb(255, 215, 90)

	-- Gemeinsam: Siegerlicht hinter der Figur, Bodenringe, goldene Funken
	local beam = fxPart({
		Name = "VictoryBeam",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(140, 6, 6),
		CFrame = CFrame.new(origin + Vector3.new(0, 60, -5)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = rgb(255, 235, 160),
		Transparency = 0.55,
		Parent = self.Folder,
	})
	TweenService:Create(beam, TweenInfo.new(3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Size = Vector3.new(140, 1.5, 1.5),
		Transparency = 1,
	}):Play()
	Debris:AddItem(beam, 3.1)
	for i = 0, 2 do
		task.delay(i * 0.35, function()
			self:Ring(origin + Vector3.new(0, FEET + 0.2, 0), gold, 9 + i * 3, 0.6, { Flat = true, Transparency = 0.2 })
		end)
	end
	self:Burst(origin, ColorSequence.new(WHITE, gold), 26, { SpeedMin = 10, SpeedMax = 24, Spin = 200, LifeMax = 1.2, Acceleration = Vector3.new(0, -10, 0) })

	if kind == "Fireworks" then
		for i = 1, (if reduced then 3 else 6) do
			task.delay(i * 0.3, function()
				local start = origin + Vector3.new(math.random(-16, 16), 0, -8)
				local color = Color3.fromHSV(math.random(), 0.75, 1)
				local rocket = fxPart({ Name = "Rocket", Shape = Enum.PartType.Ball, Size = Vector3.new(0.9, 0.9, 0.9), CFrame = CFrame.new(start), Color = color, Parent = self.Folder })
				local a0 = Instance.new("Attachment")
				a0.Position = Vector3.new(0, 0.35, 0)
				a0.Parent = rocket
				local a1 = Instance.new("Attachment")
				a1.Position = Vector3.new(0, -0.35, 0)
				a1.Parent = rocket
				local trail = Instance.new("Trail")
				trail.Attachment0 = a0
				trail.Attachment1 = a1
				trail.Color = ColorSequence.new(WHITE, color)
				trail.LightEmission = 1
				trail.Lifetime = 0.35
				trail.FaceCamera = true
				trail.Transparency = sequence(0, 0, 1, 1)
				trail.Parent = rocket
				local peak = start + Vector3.new(math.random(-4, 4), 28 + math.random() * 10, 0)
				local tween = TweenService:Create(rocket, TweenInfo.new(0.65, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = CFrame.new(peak) })
				tween:Play()
				tween.Completed:Once(function()
					local burstAt = rocket.Position
					self:Flash(burstAt, color, 7, 0.3)
					self:Burst(burstAt, ColorSequence.new(WHITE, color), 50, {
						SpeedMin = 16,
						SpeedMax = 32,
						LifeMin = 0.9,
						LifeMax = 1.6,
						Acceleration = Vector3.new(0, -14, 0),
						Drag = 1.5,
						Size = 0.7,
					})
					task.delay(0.18, function()
						self:Burst(burstAt, Color3.fromHSV(math.random(), 0.6, 1), 24, { SpeedMin = 5, SpeedMax = 12, Size = 0.4, LifeMax = 1.2, Spin = 300 })
					end)
					rocket:Destroy()
				end)
			end)
		end
	elseif kind == "Lightning" then
		for bolt = 1, 3 do
			task.delay((bolt - 1) * 0.25, function()
				local top = origin + Vector3.new(math.random(-6, 6), 70, -2)
				local previous = top
				for step = 1, 8 do
					local nextPoint = top:Lerp(origin, step / 8) + Vector3.new(math.random(-30, 30) / 10, 0, 0)
					if step == 8 then
						nextPoint = origin
					end
					local length = (nextPoint - previous).Magnitude
					local cframe = CFrame.lookAt((previous + nextPoint) / 2, nextPoint)
					local segment = fxPart({ Name = "Bolt", Size = Vector3.new(0.35, 0.35, length), CFrame = cframe, Color = rgb(225, 240, 255), Parent = self.Folder })
					local glow = fxPart({ Name = "BoltGlow", Size = Vector3.new(1.4, 1.4, length), CFrame = cframe, Color = rgb(120, 180, 255), Transparency = 0.6, Parent = self.Folder })
					TweenService:Create(segment, TweenInfo.new(0.4), { Transparency = 1 }):Play()
					TweenService:Create(glow, TweenInfo.new(0.3), { Transparency = 1 }):Play()
					Debris:AddItem(segment, 0.5)
					Debris:AddItem(glow, 0.5)
					previous = nextPoint
				end
				self:Flash(origin, rgb(200, 230, 255), 9, 0.3)
				self:Ring(origin + Vector3.new(0, FEET + 0.2, 0), rgb(160, 210, 255), 12, 0.4, { Flat = true })
				self:Burst(origin, rgb(200, 230, 255), 30, { SpeedMin = 16, SpeedMax = 30 })
				if self:_nearCamera(origin, 150) then
					self:ScreenFlash(rgb(220, 235, 255), 0.3, 0.25)
				end
			end)
		end
	elseif kind == "GoldenRain" then
		local holder = fxPart({ Name = "GoldRain", Size = Vector3.new(30, 1, 10), CFrame = CFrame.new(origin + Vector3.new(0, 26, 0)), Transparency = 1, Parent = self.Folder })
		local emitter = Instance.new("ParticleEmitter")
		emitter.Rate = if reduced then 20 else 60
		emitter.Lifetime = NumberRange.new(1.5, 2.2)
		emitter.Speed = NumberRange.new(8, 14)
		emitter.EmissionDirection = Enum.NormalId.Bottom
		emitter.Color = ColorSequence.new(rgb(255, 235, 140), rgb(255, 190, 40))
		emitter.LightEmission = 1
		emitter.Size = sequence(0, 0.6, 1, 0.2)
		emitter.Rotation = NumberRange.new(0, 360)
		emitter.RotSpeed = NumberRange.new(-200, 200)
		emitter.Parent = holder
		task.delay(3, function()
			emitter.Enabled = false
		end)
		Debris:AddItem(holder, 6)
		-- Fallende, sich drehende Münzen
		for i = 1, (if reduced then 6 else 14) do
			task.delay(i * 0.12, function()
				local start = origin + Vector3.new(math.random(-12, 12), 24 + math.random() * 6, -1 - math.random() * 2)
				local coin = fxPart({
					Name = "Coin",
					Shape = Enum.PartType.Cylinder,
					Size = Vector3.new(0.25, 1.4, 1.4),
					CFrame = CFrame.new(start),
					Color = rgb(255, 205, 60),
					Parent = self.Folder,
				})
				TweenService:Create(coin, TweenInfo.new(1.8, Enum.EasingStyle.Linear), {
					Position = start - Vector3.new(0, 26, 0),
					Orientation = Vector3.new(0, 900, 0),
				}):Play()
				task.delay(1.4, function()
					TweenService:Create(coin, TweenInfo.new(0.4), { Transparency = 1 }):Play()
				end)
				Debris:AddItem(coin, 1.9)
			end)
		end
	else
		-- Konfetti (Standard)
		for i = 1, (if reduced then 2 else 5) do
			task.delay(i * 0.22, function()
				self:Burst(origin + Vector3.new(math.random(-8, 8), 12, 0), CosmeticApplier.Rainbow, 40, {
					SpeedMin = 10,
					SpeedMax = 24,
					LifeMin = 1,
					LifeMax = 2,
					Acceleration = Vector3.new(0, -18, 0),
					Size = 0.5,
					Spin = 360,
				})
			end)
		end
		self:Ring(origin, WHITE, 8, 0.4, { Transparency = 0.4 })
	end
end

------------------------------------------------------------------------
-- Pro-Figur-Effekte
------------------------------------------------------------------------

function EffectsController:_rope(character: Model)
	local rope = self.Ropes[character]
	if rope and rope.Beam.Parent and rope.Hand.Parent then
		return rope
	end
	if rope then
		rope.Beam:Destroy()
		rope.Glow:Destroy()
		rope.Anchor:Destroy()
		self.Ropes[character] = nil
	end
	local hand = character:FindFirstChild("RightHand")
	local grip = hand and hand:FindFirstChild("VR_GrappleGrip")
	if not grip then
		return nil
	end
	local anchor = worldAttachment("VR_RopeAnchor")
	local function beam(name: string, width0: number, width1: number, transparency: number): Beam
		local b = Instance.new("Beam")
		b.Name = name
		b.Attachment0 = grip
		b.Attachment1 = anchor
		b.Width0 = width0
		b.Width1 = width1
		b.FaceCamera = true
		b.Segments = 12
		b.LightEmission = 1
		b.LightInfluence = 0
		b.Transparency = NumberSequence.new(transparency)
		b.Enabled = false
		b.Parent = self.Folder
		return b
	end
	rope = {
		Beam = beam("VR_Rope", 0.32, 0.22, 0.05),
		Glow = beam("VR_RopeGlow", 1.1, 0.8, 0.78),
		Anchor = anchor,
		Hand = hand,
		Active = false,
		AttachedAt = 0,
		Boosted = nil,
		Color = nil,
	}
	self.Ropes[character] = rope
	return rope
end

function EffectsController:_updateRope(rope, character: Model, anchorPosition: Vector3?, t: number, serverNow: number)
	if not anchorPosition then
		if rope.Active then
			rope.Active = false
			rope.Beam.Enabled = false
			rope.Glow.Enabled = false
		end
		return
	end
	local boosted = (character:GetAttribute("GrappleBoostUntil") or 0) > serverNow
	local color = if boosted then BOOST_PURPLE else self:_accentOf(character)
	if not rope.Active then
		rope.Active = true
		rope.AttachedAt = t
		rope.Beam.Enabled = true
		rope.Glow.Enabled = true
		-- Funken am Anker, sobald der Haken trifft
		task.delay(ROPE_SHOOT_TIME, function()
			self:Burst(anchorPosition, ColorSequence.new(WHITE, color), 8, { SpeedMin = 6, SpeedMax = 14, Size = 0.35, LifeMax = 0.4 })
			self:Ring(anchorPosition, color, 2.6, 0.22, { Transparency = 0.3 })
		end)
	end
	if rope.Color ~= color or rope.Boosted ~= boosted then
		rope.Color = color
		rope.Boosted = boosted
		rope.Beam.Color = ColorSequence.new(color:Lerp(WHITE, 0.35), color)
		rope.Glow.Color = ColorSequence.new(color)
		rope.Beam.Width0 = if boosted then 0.45 else 0.32
		rope.Glow.Width0 = if boosted then 1.6 else 1.1
	end
	-- Ausschuss: Seilspitze fliegt von der Hand zum Anker
	local age = t - rope.AttachedAt
	local handPosition = rope.Hand.Position
	local tip = handPosition:Lerp(anchorPosition, easeOut(math.clamp(age / ROPE_SHOOT_TIME, 0, 1)))
	local direction = anchorPosition - handPosition
	local length = direction.Magnitude
	local up = if length > 0.01 then direction / length else Vector3.yAxis
	-- X-Achse des Ankers steht senkrecht zum Seil (für das Nachschwingen)
	rope.Anchor.CFrame = CFrame.lookAt(tip, tip - Vector3.zAxis, up)
	local wobble = 0
	if age < 0.55 then
		wobble = math.sin(age * 38) * math.exp(-age * 7) * math.min(length * 0.12, 3)
	end
	rope.Beam.CurveSize1 = wobble
	rope.Glow.CurveSize1 = wobble
end

function EffectsController:_statusFx(character: Model)
	local fx = self.Status[character]
	if fx and fx.Shield.Parent then
		return fx
	end
	local shield = fxPart({ Name = "Shield", Shape = Enum.PartType.Ball, Size = Vector3.new(7.5, 7.5, 7.5), Material = Enum.Material.ForceField, Color = rgb(90, 200, 255), Transparency = 1, Parent = self.Folder })
	local ice = fxPart({ Name = "Ice", Size = Vector3.new(3.4, 6.2, 3), Material = Enum.Material.Glass, Color = rgb(170, 230, 255), Transparency = 1, Parent = self.Folder })
	local stars = {}
	for i = 1, 3 do
		stars[i] = fxPart({ Name = "Star", Shape = Enum.PartType.Ball, Size = Vector3.new(0.5, 0.5, 0.5), Color = rgb(255, 230, 80), Transparency = 1, Parent = self.Folder })
	end

	-- Laufstaub an den Füßen
	local dustAttachment = worldAttachment("VR_Dust")
	local dust = Instance.new("ParticleEmitter")
	dust.Enabled = false
	dust.Rate = 0
	dust.Lifetime = NumberRange.new(0.35, 0.7)
	dust.Speed = NumberRange.new(1.5, 4)
	dust.SpreadAngle = Vector2.new(35, 35)
	dust.Size = sequence(0, 0.5, 1, 1.8)
	dust.Transparency = sequence(0, 0.35, 1, 1)
	dust.LightEmission = 0
	dust.LightInfluence = 1
	dust.Drag = 3
	dust.Rotation = NumberRange.new(0, 360)
	dust.RotSpeed = NumberRange.new(-60, 60)
	dust.Color = ColorSequence.new(self.DustColor)
	dust.Parent = dustAttachment

	-- Funken (Wall-Slide, schneller Slide)
	local sparkAttachment = worldAttachment("VR_Sparks")
	local sparks = Instance.new("ParticleEmitter")
	sparks.Enabled = false
	sparks.Rate = 0
	sparks.Lifetime = NumberRange.new(0.2, 0.45)
	sparks.Speed = NumberRange.new(6, 14)
	sparks.SpreadAngle = Vector2.new(55, 55)
	sparks.Size = sequence(0, 0.32, 1, 0)
	sparks.Color = ColorSequence.new(rgb(255, 240, 170), rgb(255, 140, 40))
	sparks.LightEmission = 1
	sparks.LightInfluence = 0
	sparks.Acceleration = Vector3.new(0, -70, 0)
	sparks.Drag = 1
	sparks.Parent = sparkAttachment

	-- Boost: Flammen nach hinten, Glut-Aura und Licht
	local boostAttachment = worldAttachment("VR_Boost")
	local flames = Instance.new("ParticleEmitter")
	flames.Enabled = false
	flames.Rate = 45
	flames.Lifetime = NumberRange.new(0.2, 0.4)
	flames.Speed = NumberRange.new(5, 9)
	flames.Size = sequence(0, 1, 1, 0)
	flames.Color = ColorSequence.new(rgb(255, 230, 90), rgb(255, 80, 20))
	flames.LightEmission = 1
	flames.LightInfluence = 0
	flames.SpreadAngle = Vector2.new(25, 25)
	flames.Parent = boostAttachment
	local aura = Instance.new("ParticleEmitter")
	aura.Enabled = false
	aura.Rate = 28
	aura.Lifetime = NumberRange.new(0.35, 0.6)
	aura.Speed = NumberRange.new(1, 3)
	aura.SpreadAngle = Vector2.new(180, 180)
	aura.Size = sequence(0, 0.9, 1, 0)
	aura.Transparency = sequence(0, 0.2, 1, 1)
	aura.Color = ColorSequence.new(rgb(255, 240, 150), rgb(255, 120, 30))
	aura.LightEmission = 1
	aura.LightInfluence = 0
	aura.Acceleration = Vector3.new(0, 14, 0)
	aura.Parent = boostAttachment
	local boostLight = Instance.new("PointLight")
	boostLight.Enabled = false
	boostLight.Brightness = 2.2
	boostLight.Range = 12
	boostLight.Color = rgb(255, 170, 60)
	boostLight.Shadows = false
	boostLight.Parent = boostAttachment

	fx = {
		Shield = shield,
		Ice = ice,
		Stars = stars,
		DustAttachment = dustAttachment,
		Dust = dust,
		SparkAttachment = sparkAttachment,
		Sparks = sparks,
		BoostAttachment = boostAttachment,
		Flames = flames,
		Aura = aura,
		BoostLight = boostLight,
		DustRate = 0,
		SparkRate = 0,
		DustFacing = 0,
		DustVersion = -1,
		State = "Idle",
		ShieldOn = false,
		IceOn = false,
		StarsOn = false,
		BoostOn = false,
		BoostFacing = 0,
	}
	self.Status[character] = fx
	return fx
end

function EffectsController:_cleanupCharacters(alive)
	for character, rope in self.Ropes do
		if not alive[character] then
			rope.Beam:Destroy()
			rope.Glow:Destroy()
			rope.Anchor:Destroy()
			self.Ropes[character] = nil
		end
	end
	for character, fx in self.Status do
		if not alive[character] then
			fx.Shield:Destroy()
			fx.Ice:Destroy()
			fx.DustAttachment:Destroy()
			fx.SparkAttachment:Destroy()
			fx.BoostAttachment:Destroy()
			for _, star in fx.Stars do
				star:Destroy()
			end
			self.Status[character] = nil
		end
	end
end

--- Holt einen Satz Geister-Teile aus dem Pool (ältester wird wiederverwendet).
function EffectsController:_ghostSet()
	self.GhostCursor = self.GhostCursor % GHOST_SETS + 1
	local set = self.GhostPool[self.GhostCursor]
	if not set then
		set = {}
		for _, name in RunnerRig.PartNames do
			set[name] = fxPart({ Name = "Ghost", Transparency = 1, Parent = self.Folder })
		end
		self.GhostPool[self.GhostCursor] = set
	end
	return set
end

--- Nachbild der Figur an ihrer aktuellen Pose.
function EffectsController:_spawnGhost(character: Model, color: Color3, startTransparency: number)
	if not character.Parent then
		return
	end
	local set = self:_ghostSet()
	local info = TweenInfo.new(GHOST_LIFE, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	for name, part in set do
		local source = character:FindFirstChild(name)
		if source and source:IsA("BasePart") then
			part.Size = source.Size
			part.CFrame = source.CFrame
			part.Color = color
			part.Transparency = startTransparency
			TweenService:Create(part, info, { Transparency = 1 }):Play()
		else
			part.Transparency = 1
		end
	end
end

function EffectsController:_dashGhosts(character: Model)
	local color = self:_accentOf(character):Lerp(WHITE, 0.3)
	local count = if self.Reduced then 1 else 3
	for i = 0, count - 1 do
		task.delay(i * 0.045, function()
			self:_spawnGhost(character, color, 0.45 + i * 0.1)
		end)
	end
end

------------------------------------------------------------------------
-- Pro-Frame-Aktualisierung
------------------------------------------------------------------------

function EffectsController:_updateCharacter(other: Player, character: Model, root: BasePart, near: boolean, t: number, serverNow: number)
	local movement = self.Ctx.MovementController
	local isLocal = other == player
	local position = root.Position
	local state, velocity, facing
	if isLocal then
		state = movement:GetState()
		velocity = movement.Velocity or root.AssemblyLinearVelocity
		facing = movement:GetFacing()
	else
		state = character:GetAttribute("MoveState") or "Idle"
		velocity = root.AssemblyLinearVelocity
		facing = character:GetAttribute("Facing") or 1
	end
	local speed = math.abs(velocity.X)

	-- Greifhaken-Seil
	local rope = self:_rope(character)
	if rope then
		local anchorPosition = nil
		if near then
			if isLocal then
				anchorPosition = movement:GetGrappleAnchor()
			elseif character:GetAttribute("Grappling") then
				anchorPosition = character:GetAttribute("GrappleTarget")
			end
		end
		self:_updateRope(rope, character, if typeof(anchorPosition) == "Vector3" then anchorPosition else nil, t, serverNow)
	end

	local fx = self:_statusFx(character)

	-- Zustandswechsel: Dash-Nachbilder
	if state ~= fx.State then
		if state == "Dash" and near then
			self:_dashGhosts(character)
		end
		fx.State = state
	end
	-- Nachbilder bei extremem Tempo (nur eigene Figur)
	if isLocal and speed > 95 and t - self.LastAfterimage > (if self.Reduced then 0.3 else 0.11) then
		self.LastAfterimage = t
		self:_spawnGhost(character, self:_accentOf(character):Lerp(WHITE, 0.4), 0.72)
	end

	-- Laufstaub / Slide-Staub
	local dustRate = 0
	if near then
		if state == "Run" and speed > 16 then
			dustRate = 6 + speed * 0.3
		elseif state == "Slide" and speed > 6 then
			dustRate = 26 + speed * 0.4
		end
		if self.Reduced then
			dustRate *= 0.4
		end
		dustRate = math.floor(dustRate)
	end
	if dustRate ~= fx.DustRate then
		fx.DustRate = dustRate
		fx.Dust.Rate = dustRate
		fx.Dust.Enabled = dustRate > 0
	end
	if dustRate > 0 then
		fx.DustAttachment.Position = position + Vector3.new(0, FEET + 0.25, 0)
		if fx.DustFacing ~= facing then
			fx.DustFacing = facing
			fx.Dust.Acceleration = Vector3.new(-facing * 9, 3.5, 0)
		end
		if fx.DustVersion ~= self.ThemeVersion then
			fx.DustVersion = self.ThemeVersion
			fx.Dust.Color = ColorSequence.new(self.DustColor)
		end
	end

	-- Funken: Wand (Wand liegt in Blickrichtung) oder schneller Slide
	local sparkRate = 0
	if near then
		if state == "Wall" then
			sparkRate = 45
		elseif state == "Slide" and speed > 28 then
			sparkRate = 18
		end
		if self.Reduced then
			sparkRate = math.floor(sparkRate * 0.4)
		end
	end
	if sparkRate ~= fx.SparkRate then
		fx.SparkRate = sparkRate
		fx.Sparks.Rate = sparkRate
		fx.Sparks.Enabled = sparkRate > 0
	end
	if sparkRate > 0 then
		if state == "Wall" then
			fx.SparkAttachment.Position = position + Vector3.new(facing * 1.05, -0.4, 0)
		else
			fx.SparkAttachment.Position = position + Vector3.new(facing * 1.3, FEET + 0.2, 0)
		end
	end

	-- Status-Effekte
	local shielded = near and (character:GetAttribute("ShieldUntil") or 0) > serverNow
	local slowed = near and (character:GetAttribute("SlowedUntil") or 0) > serverNow
	local stunned = near and (character:GetAttribute("StunnedUntil") or 0) > serverNow
	local boosted = near and (character:GetAttribute("BoostUntil") or 0) > serverNow
	if shielded then
		local pulse = 7.5 + math.sin(t * 4) * 0.25
		fx.Shield.Size = Vector3.new(pulse, pulse, pulse)
		fx.Shield.CFrame = CFrame.new(position)
		fx.Shield.Transparency = 0.35
		fx.ShieldOn = true
	elseif fx.ShieldOn then
		fx.ShieldOn = false
		fx.Shield.Transparency = 1
	end
	if slowed then
		fx.Ice.CFrame = CFrame.new(position)
		fx.Ice.Transparency = 0.45
		fx.IceOn = true
	elseif fx.IceOn then
		fx.IceOn = false
		fx.Ice.Transparency = 1
	end
	if stunned then
		for i, star in fx.Stars do
			local angle = t * 6 + i * (math.pi * 2 / 3)
			star.Transparency = 0
			star.CFrame = CFrame.new(position + Vector3.new(math.cos(angle) * 1.4, 3.6, math.sin(angle) * 1.4))
		end
		fx.StarsOn = true
	elseif fx.StarsOn then
		fx.StarsOn = false
		for _, star in fx.Stars do
			star.Transparency = 1
		end
	end
	if boosted ~= fx.BoostOn then
		fx.BoostOn = boosted
		fx.Flames.Enabled = boosted
		fx.Aura.Enabled = boosted and not self.Reduced
		fx.BoostLight.Enabled = boosted
	end
	if boosted then
		fx.BoostAttachment.Position = position - Vector3.new(facing * 0.6, 0, 0)
		if fx.BoostFacing ~= facing then
			fx.BoostFacing = facing
			fx.Flames.EmissionDirection = if facing > 0 then Enum.NormalId.Left else Enum.NormalId.Right
		end
	end
end

function EffectsController:_updateMarker(t: number)
	local movement = self.Ctx.MovementController
	local target = movement.Target
	local frozen = player.Character and player.Character:GetAttribute("Frozen")
	if not target or frozen or not target.Parent then
		if self.Marker.Enabled then
			self.Marker.Enabled = false
			self.Highlight.Enabled = false
		end
		self.MarkerTarget = nil
		return
	end
	local parts = self.MarkerParts
	if self.MarkerTarget ~= target then
		self.MarkerTarget = target
		self.MarkerLockAt = t
		self.Marker.Adornee = target
		self.Highlight.Adornee = target
	end
	self.Marker.Enabled = true
	self.Highlight.Enabled = true

	local cooldowns = movement:GetCooldowns()
	local ready = cooldowns.Grapple <= 0
	local character = player.Character
	local boosted = character ~= nil and (character:GetAttribute("GrappleBoostUntil") or 0) > workspace:GetServerTimeNow()
	local base = target.Color
	if typeof(base) ~= "Color3" then
		base = self.Accent
	end
	local color = if not ready then GREY elseif boosted then BOOST_PURPLE else base:Lerp(WHITE, 0.25)
	if self.MarkerColor ~= color then
		self.MarkerColor = color
		parts.Gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, WHITE),
			ColorSequenceKeypoint.new(0.5, color),
			ColorSequenceKeypoint.new(1, WHITE),
		})
		parts.Glow.BackgroundColor3 = color
		parts.Dot.BackgroundColor3 = color:Lerp(WHITE, 0.5)
		for _, tick in parts.Ticks do
			tick.BackgroundColor3 = color
		end
		self.Highlight.FillColor = color
	end

	-- Lock-on: Marker schnappt beim Zielwechsel von groß auf normal
	local lock = math.clamp((t - self.MarkerLockAt) / 0.18, 0, 1)
	local pulse = if ready then math.sin(t * 7) * 0.05 else 0
	parts.Scale.Scale = 1 + (1 - easeOut(lock)) * 0.9 + pulse
	parts.Gradient.Rotation = (t * 240) % 360
	parts.Reticle.Rotation = 45 + (if ready then (t * 70) % 90 else 0)
	parts.Glow.BackgroundTransparency = if ready then 0.8 + math.sin(t * 7) * 0.06 else 0.9
	self.Highlight.FillTransparency = if ready then 0.55 + math.sin(t * 6) * 0.12 else 0.8
end

function EffectsController:_cameraTarget(): (BasePart?, Vector3)
	local spectate = self.Ctx.CameraController:GetSpectate()
	if spectate and spectate.Character then
		local root = spectate.Character:FindFirstChild("HumanoidRootPart")
		if root then
			return root, root.AssemblyLinearVelocity
		end
	end
	local root = self:_localRoot()
	if not root then
		return nil, Vector3.zero
	end
	return root, self.Ctx.MovementController.Velocity or root.AssemblyLinearVelocity
end

function EffectsController:_updateSpeedLines(dt: number, root: BasePart?, velocity: Vector3)
	local target = 0
	if root then
		target = math.clamp((math.abs(velocity.X) - (MAX_RUN + 6)) / 50, 0, 1)
		local spectating = self.Ctx.CameraController:GetSpectate() ~= nil
		if not spectating and self.Ctx.MovementController:GetState() == "Dash" then
			target = math.max(target, 0.85)
		end
		local character = root.Parent
		if character and (character:GetAttribute("BoostUntil") or 0) > workspace:GetServerTimeNow() then
			target = math.max(target, 0.45)
		end
		if math.abs(velocity.X) > 3 then
			self.LineDirection = Util.Sign(velocity.X)
		end
	end
	self.SpeedIntensity = Util.Damp(self.SpeedIntensity, target, if target > self.SpeedIntensity then 10 else 4, dt)
	local intensity = self.SpeedIntensity
	if intensity < 0.02 then
		if self.LinesFrame.Visible then
			self.LinesFrame.Visible = false
			for _, edge in self.Vignette do
				edge.BackgroundTransparency = 1
			end
		end
		return
	end
	self.LinesFrame.Visible = true
	for _, edge in self.Vignette do
		edge.BackgroundTransparency = 1 - intensity * 0.35
	end
	local direction = self.LineDirection
	local active = if self.Reduced then SPEED_LINES_REDUCED else SPEED_LINES
	if active ~= self.LinesActive then
		self.LinesActive = active
		for i, line in self.SpeedLines do
			line.Frame.Visible = i <= active
		end
	end
	local rotation = if direction > 0 then 180 else 0
	for i = 1, active do
		local line = self.SpeedLines[i]
		line.X -= direction * line.Speed * (0.6 + intensity * 1.6) * dt
		if line.X < -0.4 or line.X > 1.4 then
			self:_resetLine(line)
		end
		line.Frame.Position = UDim2.fromScale(line.X, line.Y)
		line.Frame.BackgroundTransparency = 1 - intensity * line.Alpha
		line.Gradient.Rotation = rotation
	end
end

function EffectsController:_update(dt: number)
	local t = os.clock()
	local serverNow = workspace:GetServerTimeNow()
	local currentCamera = workspace.CurrentCamera
	local cameraPosition = if currentCamera then currentCamera.CFrame.Position else Vector3.zero
	local alive = {}

	-- Spielfiguren: Seile, Staub, Funken, Status
	for _, other in Players:GetPlayers() do
		local character = other.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if character and root and character.Parent then
			alive[character] = true
			local near = (root.Position - cameraPosition).Magnitude < NEAR_DISTANCE
			self:_updateCharacter(other, character, root, near, t, serverNow)
		end
	end
	self:_cleanupCharacters(alive)

	self:_updateMarker(t)

	-- Item-Boxen drehen
	for _, box in CollectionService:GetTagged("PowerUpBox") do
		local base = box:GetAttribute("BasePosition")
		if typeof(base) == "Vector3" and (base - cameraPosition).Magnitude < 250 then
			local cframe = CFrame.new(base + Vector3.new(0, math.sin(t * 2 + base.X) * 0.4, 0)) * CFrame.Angles(t * 1.2, t * 1.7, math.rad(45))
			box.CFrame = cframe
			local core = box:FindFirstChild("Core")
			if core then
				core.CFrame = cframe
			end
		end
	end

	-- Zeitgesteuerte Gefahren
	for _, hazard in CollectionService:GetTagged("TimedHazard") do
		if (hazard.Position - cameraPosition).Magnitude < 300 then
			local period = hazard:GetAttribute("HazardPeriod") or 2
			local onTime = hazard:GetAttribute("HazardOnTime") or 1
			local offset = hazard:GetAttribute("HazardOffset") or 0
			local phase = (serverNow + offset) % period
			if phase < onTime then
				hazard.Transparency = 0.1
			elseif period - phase < 0.45 then
				hazard.Transparency = if math.floor(t * 12) % 2 == 0 then 0.35 else 0.85
			else
				hazard.Transparency = 0.9
			end
		end
	end

	self:_updateZone(dt, t)

	-- Kamera-Ziel: Speed-Lines, Figurenlicht, Tiefenunschärfe
	local targetRoot, targetVelocity = self:_cameraTarget()
	self:_updateSpeedLines(dt, targetRoot, targetVelocity)
	if targetRoot then
		self.PlayerLightAttachment.Position = targetRoot.Position + Vector3.new(0, 2.5, 5)
	end
	local focusDistance = self.Ctx.CameraController:GetFocusDistance()
	if math.abs(focusDistance - self.DofDistance) > 0.3 then
		self.DofDistance = focusDistance
		self.Dof.FocusDistance = math.clamp(focusDistance, 0, 200)
	end
end

------------------------------------------------------------------------
-- Gefahrenwand
------------------------------------------------------------------------

function EffectsController:_hideZone()
	local zone = self.Zone
	zone.Sheet.Transparency = 1
	zone.Line.Transparency = 1
	zone.Tint.Transparency = 1
	zone.Back.Transparency = 1
	for _, glow in zone.Glows do
		glow.Part.Transparency = 1
	end
	for _, pulse in zone.Pulses do
		pulse.Transparency = 1
	end
	zone.Embers.Enabled = false
	self.ZoneVisible = false
end

function EffectsController:_updateZone(dt: number, t: number)
	local state = self.Ctx.ClientState
	local gameState = state.GameState
	local zoneState = gameState:GetAttribute("ZoneState") or "Inactive"
	local watching = state:IsInRace() or self.Ctx.CameraController:GetSpectate() ~= nil
	local active = watching and (zoneState == "Shrinking" or zoneState == "Final" or zoneState == "Warning")
	if not active then
		if self.ZoneVisible then
			self:_hideZone()
		end
		self.ZoneVisualX = nil
		return
	end
	local targetX = gameState:GetAttribute("ZoneX") or -1e6
	local warning = zoneState == "Warning"
	if warning then
		targetX = (gameState:GetAttribute("StartX") or 0) - 20
	end
	if not self.ZoneVisualX or math.abs(targetX - self.ZoneVisualX) > 200 then
		self.ZoneVisualX = targetX
	else
		self.ZoneVisualX = Util.Damp(self.ZoneVisualX, targetX, 8, dt)
	end
	local x = self.ZoneVisualX
	local y = if workspace.CurrentCamera then workspace.CurrentCamera.CFrame.Position.Y else 0
	local zone = self.Zone
	local pulse = 0.5 + 0.5 * math.sin(t * 5)
	-- Warnphase: gleiche Wand, nur deutlich schwächer
	local strength = if warning then 0.35 else 1
	local function alpha(base: number): number
		return 1 - (1 - base) * strength
	end

	zone.Sheet.CFrame = CFrame.new(x, y, -24)
	zone.Sheet.Transparency = alpha(0.62 - pulse * 0.1)
	zone.Line.CFrame = CFrame.new(x, y, 8.6)
	-- Kante bleibt durchscheinend, damit Läufer direkt an der Wand sichtbar bleiben
	zone.Line.Transparency = alpha(0.3 + pulse * 0.15)
	for _, glow in zone.Glows do
		glow.Part.CFrame = CFrame.new(x - glow.Width / 2, y, 8.5)
		glow.Part.Transparency = alpha(glow.Base - pulse * 0.05)
	end
	for i, bar in zone.Pulses do
		local cycle = (t * 0.9 + i / 3) % 1
		bar.CFrame = CFrame.new(x, y - 35 + cycle * 70, 8.75)
		bar.Transparency = alpha(0.3 + cycle * 0.68)
	end
	if warning then
		zone.Tint.Transparency = 1
		zone.Back.Transparency = 1
		zone.Embers.Enabled = false
	else
		zone.Tint.CFrame = CFrame.new(x - 1000.5, y, 8.3)
		zone.Tint.Transparency = 0.87
		zone.Back.CFrame = CFrame.new(x - 1000, y, -60)
		zone.Back.Transparency = 0.72
		zone.EmberSource.CFrame = CFrame.new(x - 0.5, y, 2)
		zone.Embers.Enabled = not self.Reduced
	end
	self.ZoneVisible = true
end

return EffectsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source"><![CDATA[--[[
	InputController  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/Controllers/InputController

	Zentrale Verwaltung ALLER Eingaben (Tastatur, Maus, Gamepad, Touch).
	Andere Module fragen nur abstrakte Aktionen ab:

		Left/Right (Achse), Jump, Grapple, Slide, Item, Emote, Respawn, Menu

	Belegung:
		PC:       A/D oder ←/→ bewegen · Leertaste/W/↑ springen
		          E / J / linke Maustaste Greifhaken (halten)
		          Shift / S / ↓ / K Slide (Boden, halten) bzw. Air-Dash (Luft)
		          Q / F / L Power-up · G Emote · R Respawn · M Menü
		Gamepad:  Linker Stick / D-Pad bewegen · A springen · X oder R2 Haken
		          B oder L2 Slide/Dash · Y oder R1 Power-up · L1 Emote · Select Menü
		Touch:    Virtuelle Buttons (UI/Screens/TouchControls)

	API:
		:GetMoveX() -> number (-1..1)
		:IsHeld(action) -> boolean
		:Consume(action) -> boolean     (Druck seit max. 0,25 s, wird verbraucht)
		:SetVirtualAxis(x)              (Touch)
		:SetVirtualButton(action, down) (Touch)
		:GetDevice() -> "Keyboard" | "Gamepad" | "Touch"
		.ActionPressed / .ActionReleased (Signal: action)
		.DeviceChanged (Signal: device)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared.Signal)
local Config = require(Shared.Config)

local InputController = {}
InputController.ActionPressed = Signal.new()
InputController.ActionReleased = Signal.new()
InputController.DeviceChanged = Signal.new()

local K = Enum.KeyCode

local KEYMAP = {
	[K.A] = "Left",
	[K.Left] = "Left",
	[K.D] = "Right",
	[K.Right] = "Right",
	[K.Space] = "Jump",
	[K.W] = "Jump",
	[K.Up] = "Jump",
	[K.E] = "Grapple",
	[K.J] = "Grapple",
	[K.LeftShift] = "Slide",
	[K.S] = "Slide",
	[K.Down] = "Slide",
	[K.K] = "Slide",
	[K.Q] = "Item",
	[K.F] = "Item",
	[K.L] = "Item",
	[K.G] = "Emote",
	[K.R] = "Respawn",
	[K.M] = "Menu",
	-- Gamepad
	[K.ButtonA] = "Jump",
	[K.ButtonX] = "Grapple",
	[K.ButtonR2] = "Grapple",
	[K.ButtonB] = "Slide",
	[K.ButtonL2] = "Slide",
	[K.ButtonY] = "Item",
	[K.ButtonR1] = "Item",
	[K.ButtonL1] = "Emote",
	[K.DPadLeft] = "Left",
	[K.DPadRight] = "Right",
	[K.ButtonSelect] = "Menu",
}

local PRESS_WINDOW = 0.25

function InputController:Init(ctx)
	self.Ctx = ctx
	self.Held = {} -- [action] = { [source] = true }
	self.Pressed = {} -- [action] = os.clock()
	self.Virtual = {}
	self.VirtualAxis = 0
	self.StickX = 0
	self.Device = "Keyboard"
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		self.Device = "Touch"
	end
end

function InputController:_press(action: string, source: any)
	local held = self.Held[action]
	if not held then
		held = {}
		self.Held[action] = held
	end
	local wasHeld = next(held) ~= nil or self.Virtual[action] == true
	held[source] = true
	if not wasHeld then
		self.Pressed[action] = os.clock()
		self.ActionPressed:Fire(action)
	end
end

function InputController:_release(action: string, source: any)
	local held = self.Held[action]
	if not held or not held[source] then
		return
	end
	held[source] = nil
	if next(held) == nil and not self.Virtual[action] then
		self.ActionReleased:Fire(action)
	end
end

function InputController:_setDevice(device: string)
	if self.Device ~= device then
		self.Device = device
		self.DeviceChanged:Fire(device)
	end
end

function InputController:Start()
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end
		local action = KEYMAP[input.KeyCode]
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			action = "Grapple"
		end
		if action then
			self:_press(action, input.KeyCode.Name .. input.UserInputType.Name)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		local action = KEYMAP[input.KeyCode]
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			action = "Grapple"
		end
		if action then
			self:_release(action, input.KeyCode.Name .. input.UserInputType.Name)
		end
		if input.KeyCode == K.Thumbstick1 then
			self.StickX = 0
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input.KeyCode == K.Thumbstick1 then
			self.StickX = input.Position.X
		end
	end)

	UserInputService.LastInputTypeChanged:Connect(function(inputType)
		local name = inputType.Name
		if name:find("Gamepad") then
			self:_setDevice("Gamepad")
		elseif inputType == Enum.UserInputType.Touch then
			self:_setDevice("Touch")
		elseif name:find("Mouse") or inputType == Enum.UserInputType.Keyboard then
			self:_setDevice("Keyboard")
		end
	end)

	-- Fenster verliert den Fokus: alle Tasten loslassen
	UserInputService.WindowFocusReleased:Connect(function()
		for action, held in self.Held do
			for source in held do
				self:_release(action, source)
			end
		end
		self.StickX = 0
	end)
end

function InputController:GetDevice(): string
	return self.Device
end

function InputController:IsHeld(action: string): boolean
	local held = self.Held[action]
	return (held ~= nil and next(held) ~= nil) or self.Virtual[action] == true
end

function InputController:Consume(action: string): boolean
	local pressed = self.Pressed[action]
	if pressed and os.clock() - pressed <= PRESS_WINDOW then
		self.Pressed[action] = nil
		return true
	end
	return false
end

function InputController:GetMoveX(): number
	local keyboard = (if self:IsHeld("Right") then 1 else 0) - (if self:IsHeld("Left") then 1 else 0)
	local deadzone = Config.Input.GamepadDeadzone
	local stick = 0
	if math.abs(self.StickX) > deadzone then
		local sensitivity = Config.Input.DefaultGamepadSensitivity
		local state = self.Ctx and self.Ctx.ClientState
		if state then
			sensitivity = state:GetSetting("GamepadSensitivity") or sensitivity
		end
		local magnitude = (math.abs(self.StickX) - deadzone) / (1 - deadzone)
		stick = math.sign(self.StickX) * math.clamp(magnitude * sensitivity, 0, 1)
	end
	local best = keyboard
	if math.abs(stick) > math.abs(best) then
		best = stick
	end
	if math.abs(self.VirtualAxis) > math.abs(best) then
		best = self.VirtualAxis
	end
	return best
end

function InputController:SetVirtualAxis(x: number)
	self.VirtualAxis = math.clamp(x, -1, 1)
end

function InputController:SetVirtualButton(action: string, down: boolean)
	local wasHeld = self:IsHeld(action)
	self.Virtual[action] = down or nil
	if down and not wasHeld then
		self.Pressed[action] = os.clock()
		self.ActionPressed:Fire(action)
	elseif not down and wasHeld and not self:IsHeld(action) then
		self.ActionReleased:Fire(action)
	end
end

-- Lokaler Spieler wird für zukünftige Erweiterungen bereitgehalten
InputController.Player = Players.LocalPlayer

return InputController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">MovementController</string>
              <string name="Source"><![CDATA[--[[
	MovementController  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/Controllers/MovementController

	Eigene Side-Scrolling-Bewegungslogik (ersetzt die Roblox-Standardsteuerung).

	Architektur:
		- Die Spielfigur ist ein physikalischer Körper; nur der unsichtbare
		  "VR_Collider" kollidiert mit der Welt. Der Humanoid ist deaktiviert
		  (EvaluateStateMachine = false bzw. Zustand Physics).
		- Jeden Physik-Schritt (RunService.PreSimulation) wird die aktuelle
		  Geschwindigkeit gelesen, nach unseren Regeln verändert und
		  zurückgeschrieben. Schwerkraft und Kollisionen löst die Roblox-Engine,
		  dadurch bleiben Wände, Decken und Böden exakt.
		- Bewegung findet nur in der X/Y-Ebene statt; Z wird auf 0 gehalten.
		- Der Client besitzt seine Figur (Network Ownership) -> keine Eingabelatenz.
		  Der Server prüft Plausibilität (AntiExploitService, GrappleService).

	Mechaniken:
		Beschleunigung/Verzögerung, Momentum (Übergeschwindigkeit baut sich nur
		langsam ab), Boden-/Luftreibung, variable Sprunghöhe, Coyote-Time,
		Sprungpuffer, Wall-Slide + Wall-Jump, Slide (mit niedrigerem Kollider und
		Kriechen unter Decken), Air-Dash, Greifhaken mit Seilphysik, Boost- und
		Sprungpads, Eis.

	Signale: Jumped(kind), Landed(impactSpeed, position), SlideStarted,
	         DashStarted(dir), GrappleStarted(anchor), GrappleEnded, BoostPad(position),
	         GrappleFailed, StateChanged(state)
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Signal = require(Shared.Signal)
local Remotes = require(Shared.Remotes)

local M = Config.Movement
local G = Config.Grapple
local C = Config.Character

local player = Players.LocalPlayer

local MovementController = {}
MovementController.Jumped = Signal.new()
MovementController.Landed = Signal.new()
MovementController.SlideStarted = Signal.new()
MovementController.DashStarted = Signal.new()
MovementController.GrappleStarted = Signal.new()
MovementController.GrappleEnded = Signal.new()
MovementController.GrappleFailed = Signal.new()
MovementController.BoostPad = Signal.new()
MovementController.StateChanged = Signal.new()

local DISABLED_STATES = {
	Enum.HumanoidStateType.FallingDown,
	Enum.HumanoidStateType.Ragdoll,
	Enum.HumanoidStateType.GettingUp,
	Enum.HumanoidStateType.Climbing,
	Enum.HumanoidStateType.Swimming,
	Enum.HumanoidStateType.Seated,
	Enum.HumanoidStateType.Jumping,
	Enum.HumanoidStateType.Freefall,
	Enum.HumanoidStateType.Running,
	Enum.HumanoidStateType.Landed,
	Enum.HumanoidStateType.Flying,
}

local function newState()
	return {
		State = "Idle",
		Facing = 1,
		Grounded = false,
		LastGroundTime = -math.huge,
		LastJumpTime = -math.huge,
		JumpBufferUntil = 0,
		JumpCutPending = false,
		MinAirVy = 0,
		Sliding = false,
		SlideStart = 0,
		SlideCooldownUntil = 0,
		DashUntil = 0,
		DashDir = 1,
		DashEntrySpeed = 0,
		DashCooldownUntil = 0,
		WasDashing = false,
		AirDashAvailable = true,
		WallSliding = false,
		WallJumpLockUntil = 0,
		LockedDir = 0,
		Grapple = nil,
		GrappleCooldownUntil = 0,
		LastPadTime = 0,
		PendingImpulse = 0,
		StreamWaitUntil = 0,
		SentState = "",
		SentFacing = 0,
		LastSent = 0,
		AlignFacing = 0,
	}
end

function MovementController:Init(ctx)
	self.Ctx = ctx
	self.Input = ctx.InputController
	self.S = newState()
	self.Velocity = Vector3.zero
	self.Target = nil
	self.Anchors = {}

	local function addAnchor(part)
		if part:IsA("BasePart") then
			self.Anchors[part] = true
		end
	end
	for _, part in CollectionService:GetTagged("GrappleAnchor") do
		addAnchor(part)
	end
	CollectionService:GetInstanceAddedSignal("GrappleAnchor"):Connect(addAnchor)
	CollectionService:GetInstanceRemovedSignal("GrappleAnchor"):Connect(function(part)
		self.Anchors[part] = nil
		local grapple = self.S.Grapple
		if grapple and grapple.Part == part then
			self:_releaseGrapple(false, true, 0, 0)
		end
	end)

	local okStreaming, streaming = pcall(function()
		return workspace.StreamingEnabled
	end)
	self.Streaming = okStreaming and streaming == true

	self.Params = RaycastParams.new()
	self.Params.FilterType = Enum.RaycastFilterType.Exclude
	self.Params.CollisionGroup = "Runner"
	pcall(function()
		self.Params.RespectCanCollide = true
	end)

	local state = ctx.ClientState
	state:On("Teleported", function()
		self:_onTeleported()
	end)
	state:On("GrappleRejected", function()
		self:_releaseGrapple(false, false, 0, 0)
	end)
	state:On("GrappleForceRelease", function()
		self:_releaseGrapple(false, false, 0, 0)
	end)

	player.CharacterAdded:Connect(function(character)
		self:_bind(character)
	end)
	if player.Character then
		task.spawn(function()
			self:_bind(player.Character)
		end)
	end
end

function MovementController:Start()
	RunService.PreSimulation:Connect(function(dt)
		local ok, err = pcall(self._step, self, dt)
		if not ok then
			warn("[MovementController] " .. tostring(err))
		end
	end)
end

------------------------------------------------------------------------
-- Charakter
------------------------------------------------------------------------

function MovementController:_bind(character: Model)
	self.Character = nil
	local root = character:WaitForChild("HumanoidRootPart", 10)
	local humanoid = character:WaitForChild("Humanoid", 10)
	local collider = character:WaitForChild("VR_Collider", 10)
	if not root or not humanoid or not collider or player.Character ~= character then
		return
	end
	self.Root = root
	self.Humanoid = humanoid
	self.Collider = collider
	self.ColliderWeld = collider:FindFirstChild("VR_ColliderWeld")
	self.Align = root:FindFirstChild("VR_Align")
	self.S = newState()
	self.Params.FilterDescendantsInstances = { character }

	pcall(function()
		humanoid.EvaluateStateMachine = false
	end)
	for _, stateType in DISABLED_STATES do
		pcall(function()
			humanoid:SetStateEnabled(stateType, false)
		end)
	end
	pcall(function()
		humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	end)

	character:GetAttributeChangedSignal("BoostUntil"):Connect(function()
		if (character:GetAttribute("BoostUntil") or 0) > workspace:GetServerTimeNow() then
			self.S.PendingImpulse = M.BoostImpulse
		end
	end)

	self:_setSliding(false)
	self.Character = character
end

function MovementController:_onTeleported()
	local S = self.S
	S.StreamWaitUntil = os.clock() + 3
	S.Grapple = nil
	S.DashUntil = 0
	S.JumpBufferUntil = 0
	S.WasDashing = false
	if S.Sliding then
		self:_setSliding(false)
	end
	self.GrappleEnded:Fire()
	if self.Root then
		self.Root.AssemblyLinearVelocity = Vector3.zero
	end
end

------------------------------------------------------------------------
-- Sensoren
------------------------------------------------------------------------

function MovementController:_groundCheck(position: Vector3): RaycastResult?
	local feetY = position.Y + C.FeetOffset
	local origin = feetY + 0.6
	local length = 0.6 + M.GroundCheckDistance
	local half = C.ColliderWidth / 2 - 0.15
	for _, offset in { 0, -half, half } do
		local hit = workspace:Raycast(Vector3.new(position.X + offset, origin, position.Z), Vector3.new(0, -length, 0), self.Params)
		if hit and hit.Normal.Y > 0.55 then
			return hit
		end
	end
	return nil
end

function MovementController:_wallCheck(position: Vector3): number
	local S = self.S
	local half = C.ColliderWidth / 2
	local top = if S.Sliding then C.SlideHeight else C.StandHeight
	local heights = { C.FeetOffset + 0.8, C.FeetOffset + top * 0.5, C.FeetOffset + top - 0.6 }
	for _, dir in { S.Facing, -S.Facing } do
		local hits = 0
		for _, height in heights do
			local hit = workspace:Raycast(position + Vector3.new(0, height, 0), Vector3.new(dir * (half + 0.35), 0, 0), self.Params)
			if hit and math.abs(hit.Normal.X) > 0.7 and not hit.Instance:GetAttribute("NoWallJump") then
				hits += 1
			end
		end
		if hits >= 2 then
			return dir
		end
	end
	return 0
end

function MovementController:_canStand(): boolean
	local root = self.Root
	if not root then
		return true
	end
	local base = root.Position + Vector3.new(0, C.FeetOffset + C.SlideHeight - 0.1, 0)
	local up = C.StandHeight - C.SlideHeight + 0.2
	local half = C.ColliderWidth / 2 - 0.1
	for _, offset in { -half, 0, half } do
		if workspace:Raycast(base + Vector3.new(offset, 0, 0), Vector3.new(0, up, 0), self.Params) then
			return false
		end
	end
	return true
end

------------------------------------------------------------------------
-- Zustände
------------------------------------------------------------------------

function MovementController:_setSliding(on: boolean)
	local S = self.S
	S.Sliding = on
	local collider = self.Collider
	if collider then
		local height = if on then C.SlideHeight else C.StandHeight
		local center = C.FeetOffset + height / 2
		collider.Size = Vector3.new(C.ColliderWidth, height, C.ColliderDepth)
		if self.ColliderWeld then
			self.ColliderWeld.C0 = CFrame.new(0, center, 0)
		end
	end
	if on then
		S.SlideStart = os.clock()
	else
		S.SlideCooldownUntil = os.clock() + M.SlideCooldown
	end
end

function MovementController:_findTarget(position: Vector3, boosted: boolean): BasePart?
	local range = G.Range * (if boosted then G.UpgradeRangeMultiplier else 1)
	local facing = self.S.Facing
	local candidates = {}
	for part in self.Anchors do
		if part.Parent then
			local p = part.Position
			local dx, dy = p.X - position.X, p.Y - position.Y
			if math.abs(dx) <= range and math.abs(dy) <= range and dy >= -G.MaxAnchorBelow then
				local distance = math.sqrt(dx * dx + dy * dy)
				if distance <= range and distance > 3 then
					local ahead = Util.Sign(dx) == facing or math.abs(dx) < 4
					local score = distance - (if ahead then 18 else 0) - math.clamp(dy, 0, 20) * 0.3
					table.insert(candidates, { Part = part, Score = score, Distance = distance })
				end
			end
		end
	end
	table.sort(candidates, function(a, b)
		return a.Score < b.Score
	end)
	for i = 1, math.min(4, #candidates) do
		local candidate = candidates[i]
		local direction = candidate.Part.Position - position
		local hit = workspace:Raycast(position, direction, self.Params)
		if not hit or (hit.Position - position).Magnitude >= candidate.Distance - 1.5 then
			return candidate.Part
		end
	end
	return nil
end

function MovementController:_tryGrapple(position: Vector3, boosted: boolean)
	local target = self.Target or self:_findTarget(position, boosted)
	if not target then
		self.GrappleFailed:Fire()
		return
	end
	local id = target:GetAttribute("AnchorId")
	if type(id) ~= "number" then
		return
	end
	local S = self.S
	local distance = (target.Position - position).Magnitude
	S.Grapple = {
		Part = target,
		Id = id,
		Position = target.Position,
		Length = math.max(G.MinRopeLength, distance),
		StartedAt = os.clock(),
	}
	S.JumpCutPending = false
	if S.Sliding and self:_canStand() then
		self:_setSliding(false)
	end
	Remotes.GrappleRequest:FireServer("Attach", id)
	self.GrappleStarted:Fire(target)
end

--- Löst den Haken. Gibt den Geschwindigkeitsbonus (dvx, dvy) zurück.
function MovementController:_releaseGrapple(byPlayer: boolean, notifyServer: boolean, vx: number, vy: number): (number, number)
	local S = self.S
	if not S.Grapple then
		return 0, 0
	end
	S.Grapple = nil
	local character = self.Character
	local boosted = character ~= nil and (character:GetAttribute("GrappleBoostUntil") or 0) > workspace:GetServerTimeNow()
	S.GrappleCooldownUntil = os.clock() + (if boosted then G.UpgradeCooldown else G.Cooldown)
	if notifyServer then
		Remotes.GrappleRequest:FireServer("Release")
	end
	self.GrappleEnded:Fire()
	if byPlayer then
		local speed = math.sqrt(vx * vx + vy * vy)
		if speed > 5 then
			return vx / speed * G.ReleaseBoost, vy / speed * G.ReleaseBoost
		end
	end
	return 0, 0
end

function MovementController:_setState(name: string)
	local S = self.S
	if S.State ~= name then
		S.State = name
		self.StateChanged:Fire(name)
	end
	local now = os.clock()
	if (S.SentState ~= S.State or S.SentFacing ~= S.Facing) and now - S.LastSent >= M.StateSendInterval then
		S.SentState = S.State
		S.SentFacing = S.Facing
		S.LastSent = now
		Remotes.MoveState:FireServer(S.State, S.Facing)
	end
end

function MovementController:_updateAlign()
	local S = self.S
	if self.Align and S.AlignFacing ~= S.Facing then
		S.AlignFacing = S.Facing
		self.Align.CFrame = CFrame.lookAt(Vector3.zero, Vector3.new(S.Facing, 0, 0))
	end
end

------------------------------------------------------------------------
-- Haupt-Schritt
------------------------------------------------------------------------

function MovementController:_step(rawDt: number)
	local character = self.Character
	local root = self.Root
	if not character or not root or not root.Parent or not self.Collider then
		return
	end
	local dt = math.min(rawDt, 1 / 20)
	local S = self.S
	local input = self.Input
	local now = os.clock()
	local serverNow = workspace:GetServerTimeNow()

	local frozen = character:GetAttribute("Frozen") == true
	local stunned = (character:GetAttribute("StunnedUntil") or 0) > serverNow
	local slowed = (character:GetAttribute("SlowedUntil") or 0) > serverNow
	local boosted = (character:GetAttribute("BoostUntil") or 0) > serverNow
	local grappleBoost = (character:GetAttribute("GrappleBoostUntil") or 0) > serverNow

	local velocity = root.AssemblyLinearVelocity
	local position = root.Position
	local vx, vy = velocity.X, velocity.Y

	-- Eingefroren (Countdown, Respawn, Ergebnis)
	if frozen then
		if S.Grapple then
			self:_releaseGrapple(false, true, 0, 0)
		end
		if S.Sliding and self:_canStand() then
			self:_setSliding(false)
		end
		S.DashUntil = 0
		S.PendingImpulse = 0
		input:Consume("Jump")
		input:Consume("Grapple")
		input:Consume("Slide")
		root.AssemblyLinearVelocity = Vector3.new(0, math.min(vy, 0), 0)
		root.AssemblyAngularVelocity = Vector3.zero
		S.Grounded = self:_groundCheck(position) ~= nil
		self.Velocity = Vector3.zero
		self.Target = nil
		self:_updateAlign()
		self:_setState("Frozen")
		return
	end

	local vz = math.clamp((Config.World.PlaneZ - position.Z) * 10, -40, 40)

	-- Sensoren
	local groundHit = self:_groundCheck(position)

	-- StreamingEnabled: nach Teleports schweben, bis der Boden geladen ist
	if self.Streaming and now < S.StreamWaitUntil and not groundHit then
		if not workspace:Raycast(position, Vector3.new(0, -250, 0), self.Params) then
			root.AssemblyLinearVelocity = Vector3.new(0, 0, vz)
			root.AssemblyAngularVelocity = Vector3.zero
			self.Velocity = Vector3.zero
			return
		end
	end
	local grounded = groundHit ~= nil and (now - S.LastJumpTime) > 0.12
	if grounded then
		if not S.Grounded and S.MinAirVy < -45 then
			self.Landed:Fire(-S.MinAirVy, position + Vector3.new(0, C.FeetOffset, 0))
		end
		S.LastGroundTime = now
		S.AirDashAvailable = true
		S.MinAirVy = 0
	else
		S.MinAirVy = math.min(S.MinAirVy, vy)
	end
	S.Grounded = grounded
	local wallDir = if grounded then 0 else self:_wallCheck(position)

	-- Eingaben
	local moveX = if stunned then 0 else input:GetMoveX()
	if now < S.WallJumpLockUntil and Util.Sign(moveX) == S.LockedDir then
		moveX = 0
	end
	if input:Consume("Jump") then
		S.JumpBufferUntil = now + M.JumpBuffer
	end
	local jumpHeld = input:IsHeld("Jump")
	local slidePressed = input:Consume("Slide")
	local slideHeld = input:IsHeld("Slide")
	local grapplePressed = input:Consume("Grapple")
	local grappleHeld = input:IsHeld("Grapple")
	if input:Consume("Item") and (player:GetAttribute("HeldItem") or "") ~= "" then
		Remotes.UsePowerUp:FireServer()
	end
	if input:Consume("Emote") then
		Remotes.PlayEmote:FireServer()
	end
	if input:Consume("Respawn") then
		Remotes.RequestRespawn:FireServer()
	end

	-- Blickrichtung
	if S.Grapple then
		if math.abs(vx) > 3 then
			S.Facing = Util.Sign(vx)
		end
	elseif math.abs(moveX) > 0.1 then
		S.Facing = Util.Sign(moveX)
	end

	-- Slide / Air-Dash
	if slidePressed and not stunned then
		if grounded and not S.Sliding and now >= S.SlideCooldownUntil and math.abs(vx) >= M.SlideMinSpeed then
			self:_setSliding(true)
			local dir = Util.Sign(vx)
			local speed = math.abs(vx)
			vx = dir * math.max(speed, math.min(speed + M.SlideBoost, M.MaxRunSpeed + M.SlideBoost))
			self.SlideStarted:Fire()
		elseif not grounded and not S.Grapple and S.AirDashAvailable and now >= S.DashCooldownUntil then
			S.AirDashAvailable = false
			S.DashUntil = now + M.DashDuration
			S.DashCooldownUntil = now + M.DashCooldown
			S.DashDir = S.Facing
			S.DashEntrySpeed = math.abs(vx)
			if S.Sliding and self:_canStand() then
				self:_setSliding(false)
			end
			self.DashStarted:Fire(S.DashDir)
		end
	end
	if S.Sliding and self:_canStand() then
		if not slideHeld or (not grounded and now - S.SlideStart > 0.25) then
			self:_setSliding(false)
		end
	end

	-- Greifhaken
	if grapplePressed and not stunned and not S.Grapple and (now >= S.GrappleCooldownUntil or grappleBoost) then
		self:_tryGrapple(position, grappleBoost)
	end
	if S.Grapple and (not grappleHeld or stunned or now - S.Grapple.StartedAt > G.MaxAttachTime) then
		local bx, by = self:_releaseGrapple(true, true, vx, vy)
		vx += bx
		vy += by
	end

	-- Horizontale Bewegung
	local maxSpeed = M.MaxRunSpeed * (if boosted then M.BoostMultiplier else 1) * (if slowed then M.SlowMultiplier else 1)
	local onIce = groundHit ~= nil and groundHit.Instance:GetAttribute("Ice") == true
	if S.PendingImpulse > 0 then
		vx += S.Facing * S.PendingImpulse
		S.PendingImpulse = 0
	end

	if now < S.DashUntil then
		vx = S.DashDir * M.DashSpeed * (if slowed then M.SlowMultiplier else 1)
		vy = 0
		S.WasDashing = true
	else
		if S.WasDashing then
			S.WasDashing = false
			local cap = math.max(S.DashEntrySpeed, maxSpeed + 6)
			if math.abs(vx) > cap then
				vx = Util.Sign(vx) * cap
			end
		end
		if S.Sliding then
			local friction = M.SlideFriction * (if onIce then 0.3 else 1)
			vx = Util.MoveToward(vx, 0, friction * dt)
			if not self:_canStand() then
				-- Kriechen unter niedrigen Decken
				local dir = S.Facing
				if math.abs(moveX) > 0.1 then
					dir = Util.Sign(moveX)
				elseif math.abs(vx) > 0.5 then
					dir = Util.Sign(vx)
				end
				if math.abs(vx) < M.CrawlSpeed then
					vx = dir * M.CrawlSpeed
				end
			elseif math.abs(vx) < M.SlideEndSpeed then
				self:_setSliding(false)
			end
		elseif S.Grapple then
			vx += moveX * G.SwingAcceleration * dt
		elseif grounded then
			local accelMul = if onIce then M.IceAccelerationMultiplier else 1
			local decelMul = if onIce then M.IceDecelerationMultiplier else 1
			if math.abs(moveX) > 0.05 then
				local target = moveX * maxSpeed
				if math.abs(vx) > maxSpeed and Util.Sign(vx) == Util.Sign(moveX) then
					vx = Util.MoveToward(vx, target, M.OverspeedGroundDecay * decelMul * dt)
				elseif math.abs(vx) > 0.5 and Util.Sign(vx) ~= Util.Sign(moveX) then
					vx = Util.MoveToward(vx, target, M.TurnAcceleration * accelMul * dt)
				else
					vx = Util.MoveToward(vx, target, M.GroundAcceleration * accelMul * dt)
				end
			else
				vx = Util.MoveToward(vx, 0, M.GroundDeceleration * decelMul * dt)
			end
		else
			if math.abs(moveX) > 0.05 then
				local target = moveX * maxSpeed
				if math.abs(vx) > maxSpeed and Util.Sign(vx) == Util.Sign(moveX) then
					vx = Util.MoveToward(vx, target, M.OverspeedAirDecay * dt)
				elseif math.abs(vx) > 0.5 and Util.Sign(vx) ~= Util.Sign(moveX) then
					vx = Util.MoveToward(vx, target, M.AirTurnAcceleration * dt)
				else
					vx = Util.MoveToward(vx, target, M.AirAcceleration * dt)
				end
			else
				local drag = if math.abs(vx) > maxSpeed then M.OverspeedAirDecay else M.AirDrag
				vx = Util.MoveToward(vx, 0, drag * dt)
			end
		end
	end

	-- Vertikale Bewegung
	if now >= S.DashUntil and not S.Grapple then
		if vy < 0 then
			vy -= Config.World.Gravity * (M.FallGravityMultiplier - 1) * dt
		end
		if S.JumpCutPending then
			if vy <= 0 then
				S.JumpCutPending = false
			elseif not jumpHeld then
				vy *= M.JumpCutMultiplier
				S.JumpCutPending = false
			end
		end
	end

	S.WallSliding = false
	if not grounded and wallDir ~= 0 and not S.Grapple and moveX * wallDir > 0.1 and vy < -M.WallSlideMaxFall then
		vy = -M.WallSlideMaxFall
		S.WallSliding = true
	end

	if now < S.JumpBufferUntil and not stunned then
		local canGroundJump = grounded or (now - S.LastGroundTime) <= M.CoyoteTime
		if S.Grapple then
			local bx, by = self:_releaseGrapple(true, true, vx, vy)
			vx += bx
			vy = math.max(vy + by, M.JumpVelocity * 0.6)
			S.JumpBufferUntil = 0
			S.LastJumpTime = now
			self.Jumped:Fire("GrappleJump")
		elseif canGroundJump and (not S.Sliding or self:_canStand()) then
			if S.Sliding then
				self:_setSliding(false)
			end
			vy = M.JumpVelocity * (if slowed then 0.8 else 1)
			S.JumpBufferUntil = 0
			S.LastJumpTime = now
			S.LastGroundTime = -math.huge
			S.JumpCutPending = true
			grounded = false
			self.Jumped:Fire("Jump")
		elseif not grounded and wallDir ~= 0 then
			vx = -wallDir * M.WallJumpVelocityX
			vy = M.WallJumpVelocityY
			S.Facing = -wallDir
			S.WallJumpLockUntil = now + M.WallJumpLockTime
			S.LockedDir = wallDir
			S.JumpBufferUntil = 0
			S.LastJumpTime = now
			S.JumpCutPending = true
			S.AirDashAvailable = true
			self.Jumped:Fire("WallJump")
		end
	end
	vy = math.max(vy, -M.MaxFallSpeed)

	-- Boost- und Sprungpads
	if groundHit and grounded then
		local part = groundHit.Instance
		local boost = part:GetAttribute("BoostPad")
		if type(boost) == "number" and now - S.LastPadTime > 0.25 then
			local direction = part:GetAttribute("Direction") or 1
			vx = direction * math.max(vx * direction, boost)
			S.LastPadTime = now
			self.BoostPad:Fire(position)
		end
		local jumpPower = part:GetAttribute("JumpPad")
		if type(jumpPower) == "number" and now - S.LastPadTime > 0.3 then
			if S.Sliding and self:_canStand() then
				self:_setSliding(false)
			end
			vy = jumpPower
			S.LastJumpTime = now
			S.LastGroundTime = -math.huge
			S.LastPadTime = now
			S.JumpCutPending = false
			self.Jumped:Fire("Pad")
		end
	end

	-- Seilphysik: Seil zieht sich bei Durchhang ein, hält bei Spannung die Länge
	local grapple = S.Grapple
	if grapple then
		local anchor = grapple.Position
		local dx, dy = position.X - anchor.X, position.Y - anchor.Y
		local distance = math.sqrt(dx * dx + dy * dy)
		local reel = G.ReelSpeed * (if grappleBoost then G.UpgradeReelMultiplier else 1)
		grapple.Length = math.max(G.MinRopeLength, math.min(grapple.Length, distance) - reel * dt)
		if distance > grapple.Length and distance > 0.01 then
			local nx, ny = dx / distance, dy / distance
			local radial = vx * nx + vy * ny
			if radial > 0 then
				vx -= nx * radial
				vy -= ny * radial
			end
			local correction = math.min((distance - grapple.Length) * G.RopeStiffness, G.MaxCorrectionSpeed)
			vx -= nx * correction
			vy -= ny * correction
		end
	end

	vx = math.clamp(vx, -M.AbsoluteMaxSpeed, M.AbsoluteMaxSpeed)
	root.AssemblyLinearVelocity = Vector3.new(vx, vy, vz)
	root.AssemblyAngularVelocity = Vector3.zero
	self.Velocity = Vector3.new(vx, vy, 0)
	self:_updateAlign()

	local stateName
	if stunned then
		stateName = "Stunned"
	elseif now < S.DashUntil then
		stateName = "Dash"
	elseif S.Grapple then
		stateName = "Grapple"
	elseif S.Sliding then
		stateName = "Slide"
	elseif S.WallSliding then
		stateName = "Wall"
	elseif not grounded then
		stateName = "Air"
	elseif math.abs(vx) > 2 then
		stateName = "Run"
	else
		stateName = "Idle"
	end
	self:_setState(stateName)

	self.Target = if S.Grapple then nil else self:_findTarget(position, grappleBoost)
end

------------------------------------------------------------------------
-- Öffentliche Abfragen (für Animation, Effekte, UI)
------------------------------------------------------------------------

function MovementController:GetState(): string
	return self.S.State
end

function MovementController:GetFacing(): number
	return self.S.Facing
end

function MovementController:GetGrappleAnchor(): Vector3?
	local grapple = self.S.Grapple
	return grapple and grapple.Position or nil
end

--- Restzeiten der Fähigkeiten in Sekunden (0 = bereit).
function MovementController:GetCooldowns()
	local S = self.S
	local now = os.clock()
	return {
		Grapple = math.max(0, S.GrappleCooldownUntil - now),
		GrappleMax = G.Cooldown,
		Dash = math.max(0, S.DashCooldownUntil - now),
		DashMax = M.DashCooldown,
		DashAvailable = S.AirDashAvailable,
		Slide = math.max(0, S.SlideCooldownUntil - now),
		SlideMax = M.SlideCooldown,
		Grappling = S.Grapple ~= nil,
		HasTarget = self.Target ~= nil,
	}
end

return MovementController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="63">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--[[
	Main  (LocalScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/Main

	Einstiegspunkt des Clients. Lädt alle Controller und die UI, ruft
	:Init(ctx) und danach :Start() auf. Deaktiviert die Roblox-Standard-
	steuerung, da Velocity Rush eine eigene Bewegungslogik nutzt.
]]

local Players = game:GetService("Players")

local player = Players.LocalPlayer
local controllers = script.Parent:WaitForChild("Controllers")
local ui = script.Parent:WaitForChild("UI")

-- Standardsteuerung (WASD/Thumbstick/Sprungbutton) abschalten
task.spawn(function()
	local ok, playerModule = pcall(function()
		return require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 20))
	end)
	if ok and playerModule then
		local controls = playerModule:GetControls()
		if controls then
			controls:Disable()
		end
	end
end)

local ORDER = {
	"ClientState",
	"InputController",
	"MovementController",
	"CameraController",
	"AnimationController",
	"EffectsController",
	"AudioController",
}

local ctx = {}
for _, name in ORDER do
	ctx[name] = require(controllers:WaitForChild(name))
end
ctx.UIController = require(ui:WaitForChild("UIController"))

for _, name in ORDER do
	ctx[name]:Init(ctx)
end
ctx.UIController:Init(ctx)

for _, name in ORDER do
	if ctx[name].Start then
		ctx[name]:Start()
	end
end
ctx.UIController:Start()
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="64">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">Components</string>
              <string name="Source"><![CDATA[--[[
	Components  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/UI/Components

	Wiederverwendbare UI-Bausteine im einheitlichen Stil (siehe Theme).
	Alles wird aus Frames, UIGradient, UIStroke, UICorner und Unicode-Symbolen
	gebaut – keine Bild-Assets.

	Grundbausteine (API stabil):
		new(className, props, children)        generischer Instanz-Builder
		Tween(instance, time, props, style?, direction?) -> Tween
		Corner(radius?)                        UICorner (Pixel)
		Stroke(color?, thickness?, transparency?)  Rand-UIStroke (Border)
		Padding(top, right?, bottom?, left?), List(dir?, pad?, hAlign?, vAlign?), Grid(cellSize, pad?)
		Label(props)                           TextLabel; Zusatz-Props: MaxTextSize (mit TextScaled),
		                                       Outline (true|Dicke), OutlineColor, OutlineTransparency,
		                                       TextGradient ({hell, dunkel}, vertikal)
		Panel(props)                           Glas-Panel (Verlauf + heller Rand); Zusatz-Props:
		                                       NoStroke, StrokeColor, StrokeThickness, StrokeTransparency,
		                                       CornerRadius, NoGradient, Shadow (true|Shadow-Props;
		                                       nur wenn der Parent KEIN UIListLayout/UIGridLayout hat)
		Button(props) -> TextButton            Verlaufs-Button mit Hover-/Klick-Animation.
		                                       Props: Text, OnClick, Color, TextColor, TextSize, TextScaled,
		                                       Font, Size, Position, AnchorPoint, LayoutOrder, Name,
		                                       Visible, ZIndex, CornerRadius, StrokeColor, NoStroke, Icon
		                                       (Symbol vor dem Text), Gradient ({hell, dunkel} statt
		                                       des automatischen Verlaufs, z. B. Theme.Gradients.Play)
		                                       Text, TextColor3, TextSize, Font usw. weiterhin direkt am
		                                       Button setzen – sie werden auf das Kind "Label" gespiegelt
		                                       (der eigene Button-Text bleibt unsichtbar, weil ein
		                                       UIGradient sonst auch die Schrift einfärbt). Für Ein-/
		                                       Ausblenden des Textes button.Label.TextTransparency nutzen.
		SetButtonColor(button, color, gradient?)  Grundfarbe wechseln (Verlauf, Rand, Kontur)
		ProgressBar(props) -> frame, set(alpha, tweenTime?), fill
		                                       Zusatz-Props: Gradient (true | {links, rechts}) für einen
		                                       waagrechten Farbverlauf, BackgroundTransparency
		Toggle(props) -> frame, setValue(bool)
		Slider(props) -> frame, setValue(number)
		Tabs(props) -> frame, select(name)
		Modal(props) -> { Root, Window, Content, Title, CloseButton, Open(), Close(), IsOpen(),
		                  OnOpen, OnClose (Callback-Felder) }
		                                       Zusatz-Props: Icon (Symbol vor dem Titel), Accent (Farbe
		                                       der Kopfzeile). Geometrie unverändert: Titel y 16–52,
		                                       Content ab y 68, Schließen-Button oben rechts 44×44.

	Neue Bausteine für alle Screens:
		Gradient(colors, rotation?, transparency?) -> UIGradient
		    colors: Color3 | {c1, c2, …} | ColorSequence; transparency: Zahl | {t1, t2, …} | NumberSequence
		GradientColors(color) -> hell, dunkel   (Verlaufspaar zu einer Farbe, siehe Theme.GradientFor)
		TextStroke(thickness?, color?, transparency?) -> UIStroke (Contextual = Textkontur)
		Shadow(target, props?) -> Frame         weicher Schlagschatten als Geschwister-Frame hinter
		                                        target (folgt Position/Größe/Sichtbarkeit). Props:
		                                        Offset (6), Spread (6), Strength (1), CornerRadius.
		                                        Nicht in Containern mit UIListLayout – dafür Card nutzen.
		Card(props) -> holder, panel            Panel mit Schatten in einem transparenten Halter;
		                                        funktioniert auch in Listen/Grids. Panel-Props +
		                                        ShadowOffset, ShadowSpread, ShadowStrength.
		Heading(props) -> TextLabel             große FredokaOne-Überschrift mit Kontur (Label-Props)
		Icon(props) -> frame, glyphLabel        runde Symbol-Blase. Props: Glyph, Color, Size (Zahl, 40),
		                                        TextSize, Position, AnchorPoint, LayoutOrder, ZIndex, Parent
		SetIconColor(icon, color)               Symbol-Blase umfärben
		IconButton(props) -> TextButton         Kachel-Button: großes Symbol + Beschriftung darunter.
		                                        Props wie Button + Icon, IconSize, IconColor (Symbol in
		                                        farbiger Blase); Kinder "Glyph"/"IconBubble", "Caption"
		Pill(props) -> frame, label             kleine Plakette/Chip. Props: Text, Color, TextColor,
		                                        Size, Position, AnchorPoint, LayoutOrder, TextSize, Parent
		Divider(props) -> Frame                 dünne Verlaufslinie (Props: Size, Position, Colors, Parent)
		CoinIcon(size, props?) -> Frame         Münze aus Kreisen (props: Position, AnchorPoint, Parent)
		Ring(props) -> frame, set(alpha), inner kreisförmige Fortschrittsanzeige. Props: Size (Zahl),
		                                        Thickness, Color, TrackColor, InnerColor, Position,
		                                        AnchorPoint, ZIndex, Parent; Inhalte in `inner` legen.
		Pop(guiObject, amount?, time?)          kurzer „Hüpfer“ (UIScale) – z. B. bei Wertänderungen
		Loop(instance, time, props, style?) -> Tween   endlos hin und her (Pulsieren, Schweben)
		Shine(target, props?) -> Frame          wandernder Glanzstreifen über einem Button/Panel
		                                        (Props: Interval (4.5), CornerRadius, Transparency)

	Callbacks (vom UIController gesetzt): ClickCallback(), HoverCallback()
]]

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Theme = require(script.Parent.Theme)

local Components = {}

-- Wird vom UIController gesetzt, um Klick-/Hover-Sounds abzuspielen.
Components.ClickCallback = nil
Components.HoverCallback = nil

-- Helligkeits-Multiplikator für Buttons (Verlauf × Hintergrundfarbe)
local BUTTON_REST = Color3.fromRGB(232, 232, 236)
local BUTTON_HOVER = Color3.fromRGB(255, 255, 255)
local BUTTON_PRESS = Color3.fromRGB(196, 196, 204)

function Components.new(className: string, props, children)
	local instance = Instance.new(className)
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				instance[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

local new = Components.new

function Components.Tween(instance: Instance, time: number, props, style: Enum.EasingStyle?, direction: Enum.EasingDirection?)
	local tween = TweenService:Create(instance, TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

--- Endlos hin und her laufender Tween (z. B. Pulsieren). Rückgabe: Tween (mit :Cancel() stoppbar).
function Components.Loop(instance: Instance, time: number, props, style: Enum.EasingStyle?)
	local info = TweenInfo.new(time, style or Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
	local tween = TweenService:Create(instance, info, props)
	tween:Play()
	return tween
end

function Components.Corner(radius: number?)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or Theme.Corner) })
end

function Components.Stroke(color: Color3?, thickness: number?, transparency: number?)
	return new("UIStroke", {
		Color = color or Theme.Colors.Stroke,
		Thickness = thickness or 1.5,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

--- Kontur um Text (UIStroke im Contextual-Modus).
function Components.TextStroke(thickness: number?, color: Color3?, transparency: number?)
	return new("UIStroke", {
		Name = "TextStroke",
		Color = color or Theme.Colors.Shadow,
		Thickness = thickness or 2,
		Transparency = transparency or 0.2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		LineJoinMode = Enum.LineJoinMode.Round,
	})
end

local function toColorSequence(colors)
	if typeof(colors) == "ColorSequence" then
		return colors
	elseif typeof(colors) == "Color3" then
		return ColorSequence.new(colors)
	elseif #colors == 1 then
		return ColorSequence.new(colors[1])
	elseif #colors == 2 then
		return ColorSequence.new(colors[1], colors[2])
	end
	local keypoints = {}
	for index, color in colors do
		table.insert(keypoints, ColorSequenceKeypoint.new((index - 1) / (#colors - 1), color))
	end
	return ColorSequence.new(keypoints)
end

local function toNumberSequence(values)
	if typeof(values) == "NumberSequence" then
		return values
	elseif type(values) == "number" then
		return NumberSequence.new(values)
	elseif #values == 1 then
		return NumberSequence.new(values[1])
	end
	local keypoints = {}
	for index, value in values do
		table.insert(keypoints, NumberSequenceKeypoint.new((index - 1) / (#values - 1), value))
	end
	return NumberSequence.new(keypoints)
end

--- UIGradient. colors: Color3 | {Color3, …} | ColorSequence; rotation in Grad (90 = von oben nach unten).
function Components.Gradient(colors, rotation: number?, transparency)
	local gradient = new("UIGradient", {
		Color = toColorSequence(colors),
		Rotation = rotation or 0,
	})
	if transparency ~= nil then
		gradient.Transparency = toNumberSequence(transparency)
	end
	return gradient
end

--- Verlaufspaar (hell, dunkel) zu einer Grundfarbe.
function Components.GradientColors(color: Color3): (Color3, Color3)
	return Theme.GradientFor(color)
end

function Components.Padding(top: number, right: number?, bottom: number?, left: number?)
	return new("UIPadding", {
		PaddingTop = UDim.new(0, top),
		PaddingRight = UDim.new(0, right or top),
		PaddingBottom = UDim.new(0, bottom or top),
		PaddingLeft = UDim.new(0, left or right or top),
	})
end

function Components.List(direction: Enum.FillDirection?, padding: number?, horizontal: Enum.HorizontalAlignment?, vertical: Enum.VerticalAlignment?)
	return new("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 8),
		HorizontalAlignment = horizontal or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vertical or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function Components.Grid(cellSize: UDim2, padding: number?)
	return new("UIGridLayout", {
		CellSize = cellSize,
		CellPadding = UDim2.fromOffset(padding or 10, padding or 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

local LABEL_EXTRA = { MaxTextSize = true, Outline = true, OutlineColor = true, OutlineTransparency = true, TextGradient = true }

--- Textlabel. props werden direkt übernommen; Standard: transparent, Theme-Schrift.
function Components.Label(props)
	local label = new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Bold,
		TextColor3 = Theme.Colors.Text,
		TextSize = Theme.TextSize.Body,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		RichText = true,
		Size = UDim2.new(1, 0, 0, 24),
	})
	for key, value in props do
		if not LABEL_EXTRA[key] then
			label[key] = value
		end
	end
	if props.TextScaled and props.MaxTextSize then
		new("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize, Parent = label })
	end
	if props.Outline then
		Components.TextStroke(if type(props.Outline) == "number" then props.Outline else 2, props.OutlineColor, props.OutlineTransparency).Parent = label
	end
	if props.TextGradient then
		Components.Gradient(props.TextGradient, 90).Parent = label
	end
	return label
end

--- Große Überschrift (FredokaOne, weiß, mit Kontur). Nimmt alle Label-Props.
function Components.Heading(props)
	local merged = {
		Font = Theme.Fonts.Title,
		TextSize = Theme.TextSize.Title,
		TextColor3 = Theme.Colors.White,
		TextWrapped = false,
		Outline = 2,
		Size = UDim2.new(1, 0, 0, 36),
	}
	for key, value in props do
		merged[key] = value
	end
	return Components.Label(merged)
end

-- Schattenschichten (äußere weiche + innere dichtere) in einen Container legen
local function addShadowLayers(parent: Instance, radius: number, offset: number, spread: number, zIndex: number, strength: number)
	for _, layer in { { spread, 0.82 }, { math.max(1, spread * 0.35), 0.62 } } do
		local grow = layer[1]
		local frame = new("Frame", {
			Name = "ShadowLayer",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, offset),
			Size = UDim2.new(1, grow * 2, 1, grow * 2),
			BackgroundColor3 = Theme.Colors.Shadow,
			BackgroundTransparency = 1 - (1 - layer[2]) * strength,
			BorderSizePixel = 0,
			ZIndex = zIndex,
			Parent = parent,
		})
		Components.Corner(radius + grow).Parent = frame
	end
end

--- Weicher Schlagschatten hinter `target` (als Geschwister-Frame im selben Parent).
--- Folgt Position, Größe, AnchorPoint und Sichtbarkeit automatisch (ereignisbasiert).
function Components.Shadow(target: GuiObject, props)
	props = props or {}
	local corner = target:FindFirstChildOfClass("UICorner")
	local radius = props.CornerRadius or (if corner then corner.CornerRadius.Offset else Theme.Corner)
	local zIndex = math.max(0, (target.ZIndex or 1) - 1)
	local holder = new("Frame", {
		Name = (target.Name or "") .. "Shadow",
		BackgroundTransparency = 1,
		ZIndex = zIndex,
	})
	addShadowLayers(holder, radius, props.Offset or 6, props.Spread or 6, zIndex, props.Strength or 1)
	local function sync()
		holder.AnchorPoint = target.AnchorPoint
		holder.Position = target.Position
		holder.Size = target.Size
		holder.Visible = target.Visible
	end
	for _, property in { "AnchorPoint", "Position", "Size", "Visible" } do
		target:GetPropertyChangedSignal(property):Connect(sync)
	end
	target.AncestryChanged:Connect(function()
		if holder.Parent ~= target.Parent then
			holder.Parent = target.Parent
		end
	end)
	target.Destroying:Connect(function()
		holder:Destroy()
	end)
	sync()
	holder.Parent = target.Parent
	return holder
end

local PANEL_EXTRA = {
	NoStroke = true,
	StrokeColor = true,
	StrokeThickness = true,
	StrokeTransparency = true,
	CornerRadius = true,
	NoGradient = true,
	Shadow = true,
}

--- Panel im Glas-Stil: halbtransparenter Hintergrund mit Verlauf (oben heller),
--- runde Ecken und ein Rand, der oben heller „glänzt“.
function Components.Panel(props)
	local frame = new("Frame", {
		BackgroundColor3 = Theme.Colors.Panel,
		BackgroundTransparency = 0.06,
		BorderSizePixel = 0,
	})
	for key, value in props do
		if not PANEL_EXTRA[key] then
			frame[key] = value
		end
	end
	Components.Corner(props.CornerRadius).Parent = frame
	if not props.NoGradient then
		local sheen = Components.Gradient(Theme.Gradients.Sheen, 90)
		sheen.Name = "Sheen"
		sheen.Parent = frame
	end
	if not props.NoStroke then
		local stroke = Components.Stroke(props.StrokeColor, props.StrokeThickness or 1.5, props.StrokeTransparency or 0.1)
		stroke.Name = "Border"
		Components.Gradient({ Theme.Colors.White, Color3.fromRGB(120, 126, 164) }, 90).Parent = stroke
		stroke.Parent = frame
	end
	if props.Shadow and frame.Parent then
		Components.Shadow(frame, if type(props.Shadow) == "table" then props.Shadow else nil)
	end
	return frame
end

local CARD_HOLDER = {
	Name = true,
	Size = true,
	Position = true,
	AnchorPoint = true,
	LayoutOrder = true,
	Visible = true,
	Parent = true,
	ZIndex = true,
	ShadowOffset = true,
	ShadowSpread = true,
	ShadowStrength = true,
	Shadow = true,
}

--- Panel mit Schatten in einem transparenten Halter (auch in Listen/Grids nutzbar).
--- Rückgabe: holder (Position/Größe/LayoutOrder), panel (Inhalte hier hinein)
function Components.Card(props)
	local zIndex = props.ZIndex or 1
	local holder = new("Frame", {
		Name = props.Name or "Card",
		BackgroundTransparency = 1,
		Size = props.Size or UDim2.fromOffset(200, 100),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		Visible = if props.Visible == nil then true else props.Visible,
		ZIndex = zIndex,
	})
	addShadowLayers(holder, props.CornerRadius or Theme.Corner, props.ShadowOffset or 6, props.ShadowSpread or 6, zIndex, props.ShadowStrength or 1)
	local panelProps = {}
	for key, value in props do
		if not CARD_HOLDER[key] then
			panelProps[key] = value
		end
	end
	panelProps.Name = "Panel"
	panelProps.Size = UDim2.fromScale(1, 1)
	panelProps.ZIndex = zIndex + 1
	local panel = Components.Panel(panelProps)
	panel.Parent = holder
	holder.Parent = props.Parent
	return holder, panel
end

local function isLight(color: Color3): boolean
	return color.R * 0.299 + color.G * 0.587 + color.B * 0.114 > 0.55
end

-- Verlauf, Rand und Textkontur eines Buttons an seine Grundfarbe anpassen
-- (gradient = optionales eigenes Verlaufspaar {hell, dunkel})
local function paintButton(button: GuiButton, color: Color3, gradient)
	local top, bottom = Theme.GradientFor(color)
	if gradient then
		top, bottom = gradient[1], gradient[2]
	end
	local fill = button:FindFirstChild("Fill")
	if fill then
		fill.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, top:Lerp(Theme.Colors.White, 0.1)),
			ColorSequenceKeypoint.new(0.45, top),
			ColorSequenceKeypoint.new(1, bottom),
		})
	else
		button.BackgroundColor3 = color
	end
	local border = button:FindFirstChild("Border")
	if border and not button:GetAttribute("CustomStroke") then
		border.Color = bottom:Lerp(Theme.Colors.Black, 0.45)
	end
	local label = button:FindFirstChild("Label")
	if label then
		label.TextStrokeColor3 = bottom:Lerp(Theme.Colors.Black, 0.6)
	end
end

-- Helle Schrift bekommt eine dunkle Kontur, dunkle Schrift keine
local function updateTextStroke(button: GuiButton, label: TextLabel)
	label.TextStrokeTransparency = if isLight(button.TextColor3 or Theme.Colors.White) then 0.55 else 1
end

-- Text-Eigenschaften, die vom Button auf sein Kind "Label" gespiegelt werden.
-- Hintergrund: Ein UIGradient färbt auch den eigenen Text eines TextButtons ein
-- (weiße Schrift auf Cyan-Verlauf würde cyan). Deshalb ist der eigene Text des
-- Buttons unsichtbar (TextTransparency = 1) und ein Kind-Label zeigt ihn an.
local MIRRORED_TEXT = {
	"Text",
	"TextColor3",
	"TextSize",
	"Font",
	"TextScaled",
	"TextWrapped",
	"RichText",
	"TextXAlignment",
	"TextYAlignment",
	"TextTruncate",
}

--- Verlaufs-Button mit Hover-/Klick-Animation.
--- props.OnClick, props.Color, props.TextColor, props.Icon (Symbol vor dem Text) u. a. (siehe Kopf)
function Components.Button(props)
	local color = props.Color or Theme.Colors.PanelLight
	local text = props.Text or ""
	if props.Icon then
		text = props.Icon .. "  " .. text
	end
	local button = new("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = BUTTON_REST,
		BorderSizePixel = 0,
		Font = props.Font or Theme.Fonts.Button,
		Text = text,
		TextColor3 = props.TextColor or Theme.Colors.Text,
		TextSize = props.TextSize or Theme.TextSize.Body,
		Size = props.Size or UDim2.fromOffset(200, 48),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		Name = props.Name or "Button",
		Selectable = true,
		Visible = if props.Visible == nil then true else props.Visible,
		ZIndex = props.ZIndex or 1,
		TextTransparency = 1, -- sichtbarer Text liegt im Kind "Label"
	})
	local label = new("TextLabel", {
		Name = "Label",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = if props.TextScaled then UDim2.new(1, -20, 1, -8) else UDim2.new(1, -12, 1, 0),
		TextStrokeTransparency = 1,
		ZIndex = props.ZIndex or 1,
		Parent = button,
	})
	if props.TextScaled then
		button.TextScaled = true
		new("UITextSizeConstraint", { MaxTextSize = props.TextSize or Theme.TextSize.Body, Parent = label })
	end
	for _, property in MIRRORED_TEXT do
		label[property] = button[property]
		button:GetPropertyChangedSignal(property):Connect(function()
			label[property] = button[property]
			if property == "TextColor3" then
				updateTextStroke(button, label)
			end
		end)
	end
	Components.Corner(props.CornerRadius or Theme.SmallCorner).Parent = button
	local fill = Components.Gradient(Theme.Colors.White, 90)
	fill.Name = "Fill"
	fill.Parent = button
	local stroke = Components.Stroke(props.StrokeColor or Theme.Colors.Black, 2, if props.NoStroke then 1 else 0.05)
	stroke.Name = "Border"
	stroke.Parent = button
	if props.StrokeColor then
		button:SetAttribute("CustomStroke", true)
	end
	local scale = new("UIScale", { Parent = button })

	button:SetAttribute("BaseColor", color)
	paintButton(button, color, props.Gradient)
	updateTextStroke(button, label)

	local hovering = false
	local function rest()
		hovering = false
		Components.Tween(button, 0.12, { BackgroundColor3 = BUTTON_REST })
		Components.Tween(scale, 0.15, { Scale = 1 })
	end
	button.MouseEnter:Connect(function()
		hovering = true
		Components.Tween(button, 0.12, { BackgroundColor3 = BUTTON_HOVER })
		Components.Tween(scale, 0.18, { Scale = 1.05 }, Enum.EasingStyle.Back)
		if Components.HoverCallback then
			Components.HoverCallback()
		end
	end)
	button.MouseLeave:Connect(rest)
	button.MouseButton1Down:Connect(function()
		Components.Tween(button, 0.06, { BackgroundColor3 = BUTTON_PRESS })
		Components.Tween(scale, 0.06, { Scale = 0.94 })
	end)
	button.MouseButton1Up:Connect(function()
		Components.Tween(button, 0.1, { BackgroundColor3 = if hovering then BUTTON_HOVER else BUTTON_REST })
		Components.Tween(scale, 0.22, { Scale = if hovering then 1.05 else 1 }, Enum.EasingStyle.Back)
	end)
	-- Touch: kein MouseLeave – nach dem Loslassen in den Ruhezustand
	button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			rest()
		end
	end)
	button.Activated:Connect(function()
		if Components.ClickCallback then
			Components.ClickCallback()
		end
		if props.OnClick then
			props.OnClick()
		end
	end)
	return button
end

--- Ändert die Grundfarbe eines Buttons (Verlauf, Rand, Textkontur).
--- gradient (optional): eigenes Verlaufspaar {hell, dunkel}, z. B. Theme.Gradients.Play
function Components.SetButtonColor(button: TextButton, color: Color3, gradient)
	button:SetAttribute("BaseColor", color)
	paintButton(button, color, gradient)
end

--- Kachel-Button: großes Symbol oben, Beschriftung darunter.
--- Props wie Button + Icon (Symbol), IconSize, IconColor (Symbol in farbiger Blase).
--- Kinder: "Glyph" (bzw. "IconBubble" mit "Glyph"), "Caption".
function Components.IconButton(props)
	local buttonProps = {}
	for key, value in props do
		if key ~= "Icon" and key ~= "IconSize" and key ~= "IconColor" and key ~= "Text" then
			buttonProps[key] = value
		end
	end
	buttonProps.Text = ""
	buttonProps.Size = props.Size or UDim2.fromOffset(96, 84)
	buttonProps.CornerRadius = props.CornerRadius or Theme.Corner
	local button = Components.Button(buttonProps)
	local iconSize = props.IconSize or 30
	if props.IconColor then
		local bubbleSize = math.floor(iconSize * 1.45)
		local _, bubbleGlyph = Components.Icon({
			Name = "IconBubble",
			Glyph = props.Icon or "",
			Color = props.IconColor,
			Size = bubbleSize,
			TextSize = math.floor(iconSize * 0.8),
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 8),
			ZIndex = button.ZIndex,
			Parent = button,
		})
		bubbleGlyph.TextStrokeTransparency = 1 -- Emoji ohne Kontur
	else
		Components.Label({
			Name = "Glyph",
			Text = props.Icon or "",
			Font = Theme.Fonts.Title,
			TextSize = iconSize,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Center,
			TextWrapped = false,
			RichText = false,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 8),
			Size = UDim2.new(1, -8, 0.55, -6),
			ZIndex = button.ZIndex,
			Parent = button,
		})
	end
	Components.Label({
		Name = "Caption",
		Text = props.Text or "",
		Font = Theme.Fonts.Button,
		TextSize = props.TextSize or 14,
		TextScaled = true,
		MaxTextSize = props.TextSize or 14,
		TextColor3 = props.TextColor or Theme.Colors.Text,
		TextStrokeTransparency = 0.6,
		TextStrokeColor3 = Theme.Colors.Shadow,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -8),
		Size = UDim2.new(1, -10, 0, 18),
		ZIndex = button.ZIndex,
		Parent = button,
	})
	return button
end

--- Runde Symbol-Blase mit Farbverlauf. Rückgabe: frame, glyphLabel
function Components.Icon(props)
	local size = props.Size or 40
	local color = props.Color or Theme.Colors.Accent
	local top, bottom = Theme.GradientFor(color)
	local frame = new("Frame", {
		Name = props.Name or "Icon",
		BackgroundColor3 = Theme.Colors.White,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(size, size),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
	})
	new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = frame })
	Components.Gradient({ top, bottom }, 90).Parent = frame
	Components.Stroke(Theme.Colors.White, 2, 0.55).Parent = frame
	local glyph = Components.Label({
		Name = "Glyph",
		Text = props.Glyph or "",
		Font = Theme.Fonts.Title,
		TextSize = props.TextSize or math.floor(size * 0.55),
		TextColor3 = Theme.Colors.White,
		TextStrokeTransparency = 0.5,
		TextStrokeColor3 = bottom:Lerp(Theme.Colors.Black, 0.6),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextWrapped = false,
		RichText = false,
		Size = UDim2.fromScale(1, 1),
		ZIndex = props.ZIndex or 1,
		Parent = frame,
	})
	frame.Parent = props.Parent
	return frame, glyph
end

--- Färbt eine mit Components.Icon erzeugte Symbol-Blase um.
function Components.SetIconColor(icon: Frame, color: Color3)
	local top, bottom = Theme.GradientFor(color)
	local gradient = icon:FindFirstChildOfClass("UIGradient")
	if gradient then
		gradient.Color = ColorSequence.new(top, bottom)
	end
	local glyph = icon:FindFirstChild("Glyph")
	if glyph then
		glyph.TextStrokeColor3 = bottom:Lerp(Theme.Colors.Black, 0.6)
	end
end

--- Kleine Plakette (Chip). Rückgabe: frame, label
function Components.Pill(props)
	local color = props.Color or Theme.Colors.Accent
	local frame = new("Frame", {
		Name = props.Name or "Pill",
		BackgroundColor3 = color,
		BackgroundTransparency = props.BackgroundTransparency or 0.78,
		BorderSizePixel = 0,
		Size = props.Size or UDim2.fromOffset(96, 24),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
	})
	new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = frame })
	local stroke = Components.Stroke(color, 1.5, 0.2)
	stroke.Name = "Border"
	stroke.Parent = frame
	local label = Components.Label({
		Name = "Label",
		Text = props.Text or "",
		Font = Theme.Fonts.Title,
		TextSize = props.TextSize or 14,
		TextScaled = true,
		MaxTextSize = props.TextSize or 14,
		TextColor3 = props.TextColor or color:Lerp(Theme.Colors.White, 0.35),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -14, 1, -6),
		ZIndex = props.ZIndex or 1,
		Parent = frame,
	})
	frame.Parent = props.Parent
	return frame, label
end

--- Dünne Verlaufslinie (Standard: Akzent -> Akzent 2, an den Enden ausblendend).
function Components.Divider(props)
	props = props or {}
	local line = new("Frame", {
		Name = props.Name or "Divider",
		BackgroundColor3 = Theme.Colors.White,
		BorderSizePixel = 0,
		Size = props.Size or UDim2.new(1, 0, 0, 2),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
	})
	Components.Corner(2).Parent = line
	Components.Gradient(props.Colors or Theme.Gradients.Line, 0, { 0.7, 0, 0, 0.7 }).Parent = line
	line.Parent = props.Parent
	return line
end

--- Münz-Symbol aus Kreisen (ohne Bild-Asset).
function Components.CoinIcon(size: number?, props)
	props = props or {}
	local px = size or 28
	local coin = new("Frame", {
		Name = props.Name or "Coin",
		BackgroundColor3 = Theme.Colors.White,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(px, px),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		ZIndex = props.ZIndex or 1,
	})
	new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = coin })
	Components.Gradient(Theme.Gradients.Gold, 135).Parent = coin
	Components.Stroke(Color3.fromRGB(176, 92, 0), math.max(1, px / 14), 0).Parent = coin
	local inner = new("Frame", {
		Name = "Inner",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.62, 0.62),
		BackgroundColor3 = Theme.Colors.White,
		BorderSizePixel = 0,
		ZIndex = props.ZIndex or 1,
		Parent = coin,
	})
	new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = inner })
	Components.Gradient({ Color3.fromRGB(255, 176, 30), Color3.fromRGB(255, 226, 92) }, 135).Parent = inner
	Components.Stroke(Color3.fromRGB(214, 120, 0), math.max(1, px / 20), 0.25).Parent = inner
	-- Glanzpunkt
	local shine = new("Frame", {
		Name = "Shine",
		Position = UDim2.fromScale(0.2, 0.14),
		Size = UDim2.fromScale(0.26, 0.16),
		Rotation = -35,
		BackgroundColor3 = Theme.Colors.White,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		ZIndex = props.ZIndex or 1,
		Parent = coin,
	})
	new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = shine })
	coin.Parent = props.Parent
	return coin
end

--- Kreisförmige Fortschrittsanzeige aus zwei geclippten Halbkreisen.
--- Rückgabe: frame, set(alpha, tweenTime?), inner (Innenfläche für Inhalte)
function Components.Ring(props)
	local size = props.Size or 64
	local thickness = props.Thickness or 6
	local color = props.Color or Theme.Colors.Accent
	local zIndex = props.ZIndex or 1
	local frame = new("Frame", {
		Name = props.Name or "Ring",
		BackgroundColor3 = props.TrackColor or Theme.Colors.PanelDark,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(size, size),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		ZIndex = zIndex,
	})
	new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = frame })
	local transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.5, 0),
		NumberSequenceKeypoint.new(0.501, 1),
		NumberSequenceKeypoint.new(1, 1),
	})
	-- Jede Hälfte zeigt eine volle Scheibe, deren Verlauf halb deckend/halb
	-- transparent ist; die Drehung des Verlaufs bestimmt den sichtbaren Bogen.
	local gradients = {}
	for index = 1, 2 do
		-- index 1 = rechte Hälfte (0–50 %), index 2 = linke Hälfte (50–100 %)
		local isRight = index == 1
		local clip = new("Frame", {
			Name = if isRight then "RightHalf" else "LeftHalf",
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			Position = UDim2.fromScale(if isRight then 0.5 else 0, 0),
			Size = UDim2.fromScale(0.5, 1),
			ZIndex = zIndex,
			Parent = frame,
		})
		local disc = new("Frame", {
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Position = UDim2.fromScale(if isRight then -1 else 0, 0),
			Size = UDim2.fromScale(2, 1),
			ZIndex = zIndex,
			Parent = clip,
		})
		new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = disc })
		local gradient = new("UIGradient", { Transparency = transparency, Rotation = if isRight then 0 else 180, Parent = disc })
		gradients[index] = gradient
	end
	local inner = new("Frame", {
		Name = "Inner",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -thickness * 2, 1, -thickness * 2),
		BackgroundColor3 = props.InnerColor or Theme.Colors.PanelDark,
		BorderSizePixel = 0,
		ZIndex = zIndex,
		Parent = frame,
	})
	new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = inner })
	local current = 0
	local function apply(alpha: number)
		gradients[1].Rotation = math.clamp(alpha, 0, 0.5) * 360
		gradients[2].Rotation = 180 + math.clamp(alpha - 0.5, 0, 0.5) * 360
	end
	local function set(alpha: number, tweenTime: number?)
		alpha = math.clamp(alpha, 0, 1)
		if tweenTime and tweenTime > 0 then
			local from = current
			local value = new("NumberValue", { Value = 0 })
			value:GetPropertyChangedSignal("Value"):Connect(function()
				apply(from + (alpha - from) * value.Value)
			end)
			local tween = Components.Tween(value, tweenTime, { Value = 1 })
			tween.Completed:Connect(function()
				apply(alpha)
				value:Destroy()
			end)
		else
			apply(alpha)
		end
		current = alpha
	end
	apply(0)
	frame.Parent = props.Parent
	return frame, set, inner
end

--- Kurzer „Hüpfer“ über das (vorhandene oder neue) UIScale des Objekts.
function Components.Pop(guiObject: GuiObject, amount: number?, time: number?)
	local scale = guiObject:FindFirstChildOfClass("UIScale")
	if not scale then
		scale = new("UIScale", { Parent = guiObject })
	end
	scale.Scale = amount or 1.15
	Components.Tween(scale, time or 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
end

--- Wandernder Glanzstreifen (läuft alle paar Sekunden über das Objekt).
function Components.Shine(target: GuiObject, props)
	props = props or {}
	local corner = target:FindFirstChildOfClass("UICorner")
	local shine = new("Frame", {
		Name = "Shine",
		BackgroundColor3 = Theme.Colors.White,
		BackgroundTransparency = props.Transparency or 0.55,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = target.ZIndex,
		Parent = target,
	})
	new("UICorner", { CornerRadius = props.CornerRadius and UDim.new(0, props.CornerRadius) or (if corner then corner.CornerRadius else UDim.new(0, Theme.SmallCorner)), Parent = shine })
	local gradient = new("UIGradient", {
		Rotation = 20,
		Offset = Vector2.new(-1.2, 0),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.42, 1),
			NumberSequenceKeypoint.new(0.5, 0.2),
			NumberSequenceKeypoint.new(0.58, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = shine,
	})
	-- Offset läuft weit über den sichtbaren Bereich hinaus -> kurzer Glanz, dann Pause
	local interval = props.Interval or 4.5
	local info = TweenInfo.new(interval, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1)
	TweenService:Create(gradient, info, { Offset = Vector2.new(1.2 + interval * 0.9, 0) }):Play()
	return shine
end

--- Fortschrittsbalken. Rückgabe: frame, setProgress(alpha, tweenTime?), fill
function Components.ProgressBar(props)
	local frame = new("Frame", {
		BackgroundColor3 = props.BackgroundColor or Theme.Colors.PanelDark,
		BackgroundTransparency = props.BackgroundTransparency or 0,
		BorderSizePixel = 0,
		Size = props.Size or UDim2.fromOffset(200, 10),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		Name = props.Name or "ProgressBar",
		Parent = props.Parent,
	})
	Components.Corner(props.CornerRadius or 6).Parent = frame
	local track = Components.Stroke(Theme.Colors.Black, 1, 0.55)
	track.Name = "Border"
	track.Parent = frame
	local fill = new("Frame", {
		Name = "Fill",
		BackgroundColor3 = props.Color or Theme.Colors.Accent,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		Parent = frame,
	})
	Components.Corner(props.CornerRadius or 6).Parent = fill
	if props.Gradient then
		-- Waagrechter Farbverlauf (Füllfarbe wird dann über den Verlauf bestimmt)
		local pair = if type(props.Gradient) == "table" then props.Gradient else { Theme.GradientFor(props.Color or Theme.Colors.Accent) }
		fill.BackgroundColor3 = Theme.Colors.White
		Components.Gradient(pair, 0).Parent = fill
	else
		-- Glanz: oben hell, unten etwas dunkler (multipliziert mit der Füllfarbe)
		Components.Gradient({ Theme.Colors.White, Color3.fromRGB(255, 255, 255), Color3.fromRGB(178, 182, 200) }, 90).Parent = fill
	end
	local function set(alpha: number, tweenTime: number?)
		local target = UDim2.fromScale(math.clamp(alpha, 0, 1), 1)
		if tweenTime and tweenTime > 0 then
			Components.Tween(fill, tweenTime, { Size = target })
		else
			fill.Size = target
		end
	end
	return frame, set, fill
end

--- Schalter. Rückgabe: frame, setValue(boolean)
function Components.Toggle(props)
	local value = props.Value == true
	local frame = new("Frame", {
		BackgroundTransparency = 1,
		Size = props.Size or UDim2.new(1, 0, 0, 44),
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	Components.Label({ Text = props.Text, Size = UDim2.new(1, -90, 1, 0), Font = Theme.Fonts.Medium, Parent = frame })
	local track = new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(64, 32),
		BackgroundColor3 = Theme.Colors.PanelDark,
		BorderSizePixel = 0,
		Parent = frame,
	})
	new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = track })
	Components.Gradient({ Theme.Colors.White, Color3.fromRGB(190, 196, 220) }, 90).Parent = track
	local trackStroke = Components.Stroke(Theme.Colors.Stroke, 1.5, 0.2)
	trackStroke.Parent = track
	local knob = new("Frame", {
		Size = UDim2.fromOffset(26, 26),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		BackgroundColor3 = Theme.Colors.TextDim,
		BorderSizePixel = 0,
		Parent = track,
	})
	new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = knob })
	Components.Stroke(Theme.Colors.Shadow, 1.5, 0.6).Parent = knob
	local mark = Components.Label({
		Text = Theme.Icons.Check,
		Font = Theme.Fonts.Title,
		TextSize = 14,
		TextColor3 = Theme.Colors.Accent,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		RichText = false,
		Size = UDim2.fromScale(1, 1),
		TextTransparency = 1,
		Parent = knob,
	})
	local function render(animate: boolean)
		local time = if animate then 0.18 else 0
		Components.Tween(knob, time, {
			Position = if value then UDim2.new(1, -29, 0.5, 0) else UDim2.new(0, 3, 0.5, 0),
			BackgroundColor3 = if value then Theme.Colors.White else Theme.Colors.TextDim,
		}, Enum.EasingStyle.Back)
		Components.Tween(mark, time, { TextTransparency = if value then 0 else 1 })
		Components.Tween(track, time, { BackgroundColor3 = if value then Theme.Colors.Accent else Theme.Colors.PanelDark })
		trackStroke.Color = if value then Theme.Colors.Accent:Lerp(Theme.Colors.White, 0.3) else Theme.Colors.Stroke
	end
	track.Activated:Connect(function()
		value = not value
		render(true)
		if Components.ClickCallback then
			Components.ClickCallback()
		end
		if props.OnChanged then
			props.OnChanged(value)
		end
	end)
	render(false)
	return frame, function(newValue: boolean)
		value = newValue
		render(false)
	end
end

--- Schieberegler. Rückgabe: frame, setValue(number)
function Components.Slider(props)
	local min, max = props.Min or 0, props.Max or 1
	local value = props.Value or min
	local frame = new("Frame", {
		BackgroundTransparency = 1,
		Size = props.Size or UDim2.new(1, 0, 0, 54),
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	local label = Components.Label({ Text = props.Text, Size = UDim2.new(1, 0, 0, 22), Font = Theme.Fonts.Medium, Parent = frame })
	local bar = new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		Position = UDim2.new(0, 0, 0, 30),
		Size = UDim2.new(1, -8, 0, 12),
		BackgroundColor3 = Theme.Colors.PanelDark,
		BorderSizePixel = 0,
		Parent = frame,
	})
	Components.Corner(6).Parent = bar
	Components.Stroke(Theme.Colors.Black, 1, 0.55).Parent = bar
	local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Colors.White, BorderSizePixel = 0, Parent = bar })
	Components.Corner(6).Parent = fill
	Components.Gradient(Theme.Gradients.Accent, 0).Parent = fill
	local knob = new("Frame", {
		Size = UDim2.fromOffset(24, 24),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		BackgroundColor3 = Theme.Colors.White,
		BorderSizePixel = 0,
		Parent = bar,
	})
	new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = knob })
	Components.Stroke(Theme.Colors.Accent, 3, 0).Parent = knob

	local function render()
		local alpha = (value - min) / (max - min)
		fill.Size = UDim2.fromScale(alpha, 1)
		knob.Position = UDim2.fromScale(alpha, 0.5)
		label.Text = string.format("%s: <b>%s</b>", props.Text, if props.Format then props.Format(value) else string.format("%d%%", math.floor(alpha * 100 + 0.5)))
	end
	local dragging = false
	local function setFromX(x: number)
		local alpha = math.clamp((x - bar.AbsolutePosition.X) / math.max(1, bar.AbsoluteSize.X), 0, 1)
		local newValue = min + (max - min) * alpha
		if props.Step then
			newValue = math.floor(newValue / props.Step + 0.5) * props.Step
		end
		if newValue ~= value then
			value = newValue
			render()
			if props.OnChanged then
				props.OnChanged(value)
			end
		end
	end
	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	render()
	return frame, function(newValue: number)
		value = math.clamp(newValue, min, max)
		render()
	end
end

--- Tab-Leiste. onSelect(name). Rückgabe: frame, select(name)
function Components.Tabs(props)
	local frame = new("Frame", {
		BackgroundTransparency = 1,
		Size = props.Size or UDim2.new(1, 0, 0, 40),
		Position = props.Position or UDim2.new(),
		Parent = props.Parent,
	}, { Components.List(Enum.FillDirection.Horizontal, 6) })
	local buttons = {}
	local function selectTab(name: string)
		for tabName, button in buttons do
			local active = tabName == name
			Components.SetButtonColor(button, if active then Theme.Colors.Accent else Theme.Colors.PanelLight)
			button.TextColor3 = if active then Theme.Colors.White else Theme.Colors.TextDim
		end
		if props.OnSelect then
			props.OnSelect(name)
		end
	end
	for index, tab in props.Tabs do
		local button = Components.Button({
			Text = tab.Label,
			Size = UDim2.new(0, tab.Width or 130, 1, 0),
			TextSize = Theme.TextSize.Small,
			LayoutOrder = index,
			OnClick = function()
				selectTab(tab.Name)
			end,
		})
		button.Parent = frame
		buttons[tab.Name] = button
	end
	return frame, selectTab
end

--- Modales Fenster mit Kopfzeile, Titel und Schließen-Button.
--- Rückgabe-Objekt: { Root, Window, Content, Title, CloseButton, Open(), Close(), IsOpen(),
---                    OnOpen / OnClose (Callback-Felder) }
function Components.Modal(props)
	local modal = {}
	local accent = props.Accent or Theme.Colors.Accent
	local isOpen = false
	local token = 0
	local root = new("Frame", {
		Name = props.Name or "Modal",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Colors.Shadow,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 20,
		Parent = props.Parent,
	})
	-- Fängt Klicks hinter dem Fenster ab
	new("TextButton", {
		Name = "Blocker",
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 20,
		Parent = root,
	})
	local window = Components.Panel({
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = props.Size or UDim2.fromOffset(900, 560),
		BackgroundColor3 = Theme.Colors.Panel,
		BackgroundTransparency = 0.03,
		StrokeColor = accent:Lerp(Theme.Colors.Stroke, 0.45),
		StrokeThickness = 2,
		CornerRadius = Theme.Corner + 4,
		ZIndex = 22,
		Parent = root,
	})
	local shadow = Components.Shadow(window, { Offset = 10, Spread = 14, Strength = 1.2 })
	local scale = new("UIScale", { Parent = window })
	local shadowScale = new("UIScale", { Parent = shadow })

	-- Kopfzeile: weich auslaufender Akzent-Schimmer + Verlaufslinie
	local header = new("Frame", {
		Name = "Header",
		Position = UDim2.fromOffset(2, 2),
		Size = UDim2.new(1, -4, 0, 62),
		BackgroundColor3 = accent,
		BorderSizePixel = 0,
		ZIndex = 22,
		Parent = window,
	})
	Components.Corner(Theme.Corner + 2).Parent = header
	Components.Gradient(accent, 90, { 0.72, 1 }).Parent = header
	Components.Divider({
		Name = "HeaderLine",
		Position = UDim2.fromOffset(24, 60),
		Size = UDim2.new(1, -48, 0, 3),
		ZIndex = 22,
		Parent = window,
	})

	local titleX = 24
	if props.Icon then
		Components.Icon({ Glyph = props.Icon, Color = accent, Size = 38, Position = UDim2.fromOffset(20, 15), ZIndex = 23, Parent = window })
		titleX = 68
	end
	local title = Components.Heading({
		Text = props.Title or "",
		TextSize = Theme.TextSize.Title,
		Position = UDim2.fromOffset(titleX, 16),
		Size = UDim2.new(1, -76 - titleX, 0, 36),
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 23,
		Parent = window,
	})
	local close = Components.Button({
		Name = "Close",
		Text = Theme.Icons.Close,
		Size = UDim2.fromOffset(44, 44),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 12),
		Color = Theme.Colors.Danger,
		TextColor = Theme.Colors.White,
		TextSize = 22,
		CornerRadius = 22,
		ZIndex = 23,
		OnClick = function()
			modal.Close()
		end,
	})
	close.Parent = window
	local content = new("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(24, 68),
		Size = UDim2.new(1, -48, 1, -88),
		ZIndex = 22,
		Parent = window,
	})

	modal.Root = root
	modal.Window = window
	modal.Content = content
	modal.Title = title
	modal.CloseButton = close
	function modal.IsOpen()
		return isOpen
	end
	function modal.Open()
		if isOpen then
			return
		end
		isOpen = true
		token += 1
		root.Visible = true
		root.BackgroundTransparency = 1
		scale.Scale = 0.86
		shadowScale.Scale = 0.86
		Components.Tween(root, 0.2, { BackgroundTransparency = 0.35 })
		Components.Tween(scale, 0.32, { Scale = 1 }, Enum.EasingStyle.Back)
		Components.Tween(shadowScale, 0.32, { Scale = 1 }, Enum.EasingStyle.Back)
		if modal.OnOpen then
			modal.OnOpen()
		end
	end
	function modal.Close()
		if not isOpen then
			return
		end
		isOpen = false
		token += 1
		local myToken = token
		Components.Tween(root, 0.14, { BackgroundTransparency = 1 })
		Components.Tween(scale, 0.14, { Scale = 0.9 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Components.Tween(shadowScale, 0.14, { Scale = 0.9 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.15, function()
			if token == myToken then
				root.Visible = false
			end
		end)
		if modal.OnClose then
			modal.OnClose()
		end
	end
	return modal
end

return Components
]]></string>
            </Properties>
