        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Config  (ModuleScript)
	Pfad: ReplicatedStorage/Shared/Config

	Zentrale Konfiguration für Velocity Rush. Alle Balancing-Werte für Movement,
	Greifhaken, Gefahrenzone, Runden, Ökonomie, Ranked und Anti-Exploit stehen hier.
	Server und Client lesen dieselben Werte, damit Vorhersage (Client) und
	Validierung (Server) zusammenpassen.

	Einheiten: Studs, Sekunden, Studs/Sekunde.
]]

local RunService = game:GetService("RunService")

local Config = {}

Config.GameName = "Velocity Rush"
Config.Version = "1.0.0"
Config.IsStudio = RunService:IsStudio()

Config.Debug = {
	-- In Roblox Studio darf ein Rennen auch mit nur einem Spieler starten (zum Testen).
	AllowSoloRace = RunService:IsStudio(),
	-- Abgelehnte Remote-Aufrufe im Output protokollieren.
	LogRejections = RunService:IsStudio(),
}

Config.World = {
	Gravity = 200,
	PlaneZ = 0,
	TrackDepth = 10,
	LobbyOrigin = Vector3.new(-3000, 0, 0),
	RaceOrigin = Vector3.new(0, 0, 0),
	TutorialOrigin = Vector3.new(-10000, 0, 0),
	PracticeOriginStart = Vector3.new(-20000, 0, 0),
	PracticeOriginSpacing = 6000,
}

-- Geometrie der Spielfigur (muss zu Shared/RunnerRig passen).
Config.Character = {
	ColliderWidth = 1.8,
	ColliderDepth = 1.4,
	StandHeight = 5.4,
	SlideHeight = 2.2,
	FeetOffset = -2.7, -- Fußsohle relativ zur Mitte des HumanoidRootPart
}

Config.Movement = {
	MaxRunSpeed = 44,
	GroundAcceleration = 150,
	GroundDeceleration = 190,
	TurnAcceleration = 320,
	AirAcceleration = 95,
	AirTurnAcceleration = 150,
	AirDrag = 8,
	OverspeedGroundDecay = 38,
	OverspeedAirDecay = 7,
	AbsoluteMaxSpeed = 140,
	MaxFallSpeed = 130,

	JumpVelocity = 62,
	JumpCutMultiplier = 0.45,
	FallGravityMultiplier = 1.35,
	CoyoteTime = 0.1,
	JumpBuffer = 0.13,

	WallSlideMaxFall = 22,
	WallJumpVelocityX = 42,
	WallJumpVelocityY = 58,
	WallJumpLockTime = 0.16,

	SlideMinSpeed = 14,
	SlideBoost = 9,
	SlideFriction = 17,
	SlideEndSpeed = 9,
	SlideCooldown = 0.45,
	CrawlSpeed = 12,

	DashSpeed = 72,
	DashDuration = 0.16,
	DashCooldown = 1.1,

	IceAccelerationMultiplier = 0.35,
	IceDecelerationMultiplier = 0.18,

	BoostMultiplier = 1.35,
	BoostImpulse = 22,
	SlowMultiplier = 0.4,

	GroundCheckDistance = 0.3,
	StateSendInterval = 0.08,
}

Config.Grapple = {
	Range = 58,
	UpgradeRangeMultiplier = 1.6,
	UpgradeReelMultiplier = 2,
	MinRopeLength = 10,
	ReelSpeed = 8,
	RopeStiffness = 12,
	MaxCorrectionSpeed = 60,
	SwingAcceleration = 55,
	ReleaseBoost = 8,
	Cooldown = 0.3,
	UpgradeCooldown = 0.05,
	MaxAttachTime = 6,
	MaxAnchorBelow = 8, -- Anker dürfen höchstens so weit unter dem Spieler liegen
	ServerRangeTolerance = 14,
	ServerMinInterval = 0.12,
}

-- Gefahrenzone: eine Energiewand, die dem Führenden in festem Abstand folgt.
Config.HazardZone = {
	WarningStart = 10, -- ab Sekunde X nach Rennstart Warnung
	ShrinkStart = 18, -- ab Sekunde X wird die Zone gefährlich und schrumpft
	ShrinkDuration = 55,
	InitialLength = 260, -- Abstand der Wand zum Führenden zu Beginn
	FinalLength = 60, -- minimaler Abstand im Endzustand
	EliminationDelay = 1.6, -- so lange darf man hinter der Wand sein
	RecoveryRate = 2, -- Abbau der Gefahrenzeit pro Sekunde in Sicherheit
}

Config.Round = {
	MinPlayers = 2,
	MaxPlayers = 8,
	StartingCountdown = 10,
	FullLobbyCountdown = 4,
	CountdownDuration = 3.5,
	MaxRaceTime = 240,
	ResultsDuration = 9,
	RespawnFreezeTime = 0.9,
	ReturnToLobbyDelay = 1.5,
	TickRate = 10,
}

Config.Economy = {
	StartingCoins = 300,
	MaxCoins = 100_000_000,
	MaxTransaction = 1_000_000,
}

Config.Rewards = {
	ParticipationCoins = 20,
	ParticipationXP = 35,
	PlacementCoins = { 60, 35, 20 },
	PlacementXP = { 100, 60, 40 },
	FinishBonusCoins = 15,
	FinishBonusXP = 25,
	FullRewardPlayerCount = 4, -- ab so vielen Teilnehmern volle Platzierungsboni
	LevelUpCoinsPerLevel = 25,
	RecentMatchMemory = 25,
}

Config.Ranked = {
	Season = 1,
	StartRating = 1000,
	KFactor = 40,
	MinRating = 0,
	LeavePenaltyFactor = 1, -- Leaver werden wie Letztplatzierte gewertet
}

Config.PowerUps = {
	PickupRadius = 4.5,
	RespawnTime = 9,
	UseDebounce = 0.4,
}

Config.Practice = {
	RespawnFreezeTime = 0.35,
}

Config.Data = {
	StoreName = "VelocityRush_Profiles_v1",
	KeyPrefix = "Player_",
	AutosaveInterval = 90,
	LockTimeout = 360,
	LoadRetries = 5,
	SaveRetries = 4,
}

Config.Leaderboard = {
	WinsStore = "VelocityRush_Wins_v1",
	RatingStorePrefix = "VelocityRush_Rating_S",
	RefreshInterval = 120,
	Size = 25,
}

Config.AntiExploit = {
	SampleInterval = 0.25,
	Window = 1.0,
	MaxSpeed = 230, -- Studs/s über das Messfenster (legitimes Maximum ≈ 195)
	MaxZDrift = 6,
	TeleportGrace = 1.5,
	ViolationDecayPerSecond = 0.05,
	KickEnabled = true,
	KickThreshold = 12,
}

-- Token-Bucket pro Spieler und Remote: { Kapazität, Nachfüllrate pro Sekunde }
Config.RateLimits = {
	QueueRequest = { 6, 1.5 },
	PracticeRequest = { 6, 1.5 },
	MoveState = { 30, 18 },
	GrappleRequest = { 20, 10 },
	UsePowerUp = { 6, 3 },
	PlayEmote = { 3, 0.7 },
	SaveSettings = { 4, 0.5 },
	RequestRespawn = { 3, 0.5 },
	GetProfile = { 6, 1 },
	ShopRequest = { 10, 3 },
	GetLeaderboard = { 4, 0.5 },
}

-- Seitenkamera (CameraController). Glättung über "SmoothTime" (Sekunden bis
-- das Ziel weitgehend erreicht ist; kleiner = straffer).
Config.Camera = {
	Distance = 45, -- Abstand zur Spielebene (näher = größere Figuren)
	HeightOffset = 7, -- Kamera so viel höher als der Fokus (Blick leicht von oben)
	FocusHeight = 2.2, -- Fokuspunkt über der Körpermitte
	FieldOfView = 57,
	LookAheadFactor = 0.3, -- Vorausschau in Laufrichtung pro Stud/s
	MaxLookAhead = 16,
	LookAheadSmoothTime = 0.42,
	FollowSmoothTime = 0.085, -- horizontale Nachführung
	VerticalSmoothTime = 0.2,
	FallSmoothTime = 0.07, -- schnelles Nachführen beim Fallen
	VerticalDeadZone = 2.5,
	GroundRecenter = 1.6, -- Schärfe, mit der die Kamera am Boden wieder mittig wird
	FallLookDown = 0.08, -- Blick nach unten beim schnellen Fallen (pro Stud/s)
	MaxFallLookDown = 6,
	SpeedZoom = 0.18, -- zusätzlicher Abstand pro Stud/s über MaxRunSpeed
	MaxExtraDistance = 13,
	ZoomSharpness = 1.8,
	SpeedFov = 0.11, -- zusätzliches Sichtfeld pro Stud/s über MaxRunSpeed
	MaxExtraFov = 7,
	FovSharpness = 3.5,
	LeaderBias = 0.25,
	MaxLeaderBias = 18,
	SnapDistance = 120,
	SpectateBlendTime = 0.55, -- weicher Schwenk beim Wechsel des Zuschauerziels
	MaxBlendDistance = 700,
	ShakeFrequency = 17,
	ShakeDecay = 2.6,
	KickStiffness = 170, -- Feder für Kamera-Stöße (Landung)
	KickDamping = 15,
	MaxFovPunch = 10,
}

Config.Input = {
	GamepadDeadzone = 0.2,
	DefaultGamepadSensitivity = 1,
}

-- Sounds: Standardmäßig werden ausschließlich in Roblox eingebaute Sounddateien
-- (rbxasset://sounds/...) verwendet. Eigene Sound-IDs können hier eingetragen werden.
Config.Audio = {
	MusicId = "", -- z.B. "rbxassetid://123456" – leer = keine Musik
	Sounds = {
		Jump = { Id = "rbxasset://sounds/action_jump.mp3", Volume = 0.45, Pitch = 1.1 },
		WallJump = { Id = "rbxasset://sounds/action_jump.mp3", Volume = 0.45, Pitch = 1.3 },
		Land = { Id = "rbxasset://sounds/action_jump_land.mp3", Volume = 0.5, Pitch = 1 },
		Slide = { Id = "rbxasset://sounds/action_falling.mp3", Volume = 0.25, Pitch = 2.2 },
		Dash = { Id = "rbxasset://sounds/action_falling.mp3", Volume = 0.35, Pitch = 2.8 },
		Grapple = { Id = "rbxasset://sounds/action_get_up.mp3", Volume = 0.55, Pitch = 1.6 },
		Pickup = { Id = "rbxasset://sounds/action_get_up.mp3", Volume = 0.6, Pitch = 2.2 },
		PowerUp = { Id = "rbxasset://sounds/action_jump.mp3", Volume = 0.6, Pitch = 0.7 },
		Boost = { Id = "rbxasset://sounds/action_falling.mp3", Volume = 0.4, Pitch = 1.8 },
		Eliminated = { Id = "rbxasset://sounds/uuhhh.mp3", Volume = 0.6, Pitch = 1 },
		Countdown = { Id = "rbxasset://sounds/action_jump_land.mp3", Volume = 0.7, Pitch = 2 },
		Go = { Id = "rbxasset://sounds/action_jump.mp3", Volume = 0.8, Pitch = 1.4 },
		Warning = { Id = "rbxasset://sounds/action_jump_land.mp3", Volume = 0.5, Pitch = 2.6 },
		Click = { Id = "rbxasset://sounds/action_jump_land.mp3", Volume = 0.25, Pitch = 3 },
		Victory = { Id = "rbxasset://sounds/action_get_up.mp3", Volume = 0.8, Pitch = 1.2 },
		Splash = { Id = "rbxasset://sounds/impact_water.mp3", Volume = 0.5, Pitch = 1 },
	},
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">CosmeticApplier</string>
          <string name="Source"><![CDATA[--[[
	CosmeticApplier  (ModuleScript)
	Pfad: ReplicatedStorage/Shared/CosmeticApplier

	Wendet ausgerüstete Kosmetik (Skin, Farbvariante, Trail, Partikeleffekt)
	auf ein RunnerRig an. Wird vom Server für echte Spielfiguren und vom Client
	für die Shop-Vorschau verwendet.

	Ablauf von Apply:
		1. Clear: entfernt den Ordner "VR_Cosmetics" und alles mit Attribut
		   VR_Cosmetic – erneutes Anwenden dupliziert also nie etwas.
		2. Knochen (R15-Körperteile) und die Körperhülle aus RunnerRig
		   (Ordner "VR_Body", Attribute VR_Paint/VR_Tag) werden nur umgefärbt,
		   umgestellt (Material, Glanz) und ggf. per HideBase ausgeblendet –
		   die Hülle wird nie neu erzeugt.
		3. Accessoires des Skins werden als geschweißte, rein visuelle Teile in
		   "VR_Cosmetics" gebaut (Block, Kugel, Zylinder, Keil, Ellipsoid per
		   SpecialMesh "Sphere").
		4. Trail (breites Farbband + optionaler heller Kernstreifen) und
		   Partikeleffekt am Oberkörper.

	Farbslots (Accessoires und Hülle):
		Körpergruppen  Head, Torso, Hips, Arms, Hands, Legs, Feet (skin.Colors)
		Primary, Secondary, Dark, Visor   Palette des Skins
		Accent         Akzentfarbe (Farbvariante überschreibt), festes Material
		Glow           Akzentfarbe als Neon
		Trim, Ears, Joint, Collar, Belt, Sole   Zusatzslots mit Fallback
		Color3         feste Farbe

	Alle erzeugten Objekte sind rein visuell:
		Massless = true, CanCollide = false, CanQuery = false, CanTouch = false.

	API:
		CosmeticApplier.Apply(model, equipped)   equipped = { Skins="Rookie", Trails="", ... }
		CosmeticApplier.Clear(model)
		CosmeticApplier.GetAccentColor(equipped) -> Color3
		CosmeticApplier.Rainbow                  (ColorSequence)
]]

local CosmeticDefinitions = require(script.Parent.CosmeticDefinitions)

local CosmeticApplier = {}

local FOLDER_NAME = "VR_Cosmetics"
local BODY_FOLDER = "VR_Body" -- siehe RunnerRig.BodyFolder

local GROUP_BY_PART = {
	Head = "Head",
	UpperTorso = "Torso",
	LowerTorso = "Hips",
	LeftUpperArm = "Arms",
	LeftLowerArm = "Arms",
	RightUpperArm = "Arms",
	RightLowerArm = "Arms",
	LeftHand = "Hands",
	RightHand = "Hands",
	LeftUpperLeg = "Legs",
	LeftLowerLeg = "Legs",
	RightUpperLeg = "Legs",
	RightLowerLeg = "Legs",
	LeftFoot = "Feet",
	RightFoot = "Feet",
}

-- Zusatzslots der Körperhülle fallen auf diese Slots zurück, wenn der Skin sie
-- nicht selbst definiert.
local SLOT_FALLBACK = {
	Trim = "Secondary",
	Ears = "Primary",
	Collar = "Joint",
	Joint = "Dark",
	Belt = "Dark",
	Sole = "Dark",
}

local function getSkin(equipped)
	local id = equipped and equipped.Skins or "Rookie"
	return CosmeticDefinitions.Get("Skins", id) or CosmeticDefinitions.Get("Skins", "Rookie")
end

--- Liefert die effektive Akzentfarbe (Farbvariante überschreibt Skin-Akzent).
function CosmeticApplier.GetAccentColor(equipped): Color3
	local skin = getSkin(equipped)
	if equipped and equipped.Colors and equipped.Colors ~= "" then
		local variant = CosmeticDefinitions.Get("Colors", equipped.Colors)
		if variant then
			return variant.Color
		end
	end
	return skin.Accent
end

local function resolveColor(key, skin, accent: Color3, depth: number?): Color3
	if typeof(key) == "Color3" then
		return key
	elseif key == "Accent" or key == "Glow" then
		return accent
	elseif key == "Visor" then
		return skin.Visor or accent
	elseif type(key) ~= "string" then
		return skin.Primary
	end
	local groupColor = skin.Colors and skin.Colors[key]
	if groupColor then
		return groupColor
	end
	local value = skin[key]
	if typeof(value) == "Color3" then
		return value
	end
	local fallback = SLOT_FALLBACK[key]
	if fallback and (depth or 0) < 4 then
		return resolveColor(fallback, skin, accent, (depth or 0) + 1)
	end
	return skin.Primary
end

local function resolveMaterial(key, skin): Enum.Material
	local materials = skin.Materials
	if type(key) == "string" and materials and materials[key] then
		return materials[key]
	end
	if key == "Glow" or key == "Visor" then
		return Enum.Material.Neon
	end
	if key == "Primary" or (type(key) == "string" and skin.Colors and skin.Colors[key]) then
		return skin.Material or Enum.Material.SmoothPlastic
	end
	if typeof(key) == "Color3" then
		return Enum.Material.SmoothPlastic
	end
	return skin.TrimMaterial or Enum.Material.SmoothPlastic
end

local function makeShape(shape: string): BasePart
	if shape == "Wedge" then
		return Instance.new("WedgePart")
	end
	local part = Instance.new("Part")
	if shape == "Ball" then
		part.Shape = Enum.PartType.Ball
	elseif shape == "Cylinder" then
		part.Shape = Enum.PartType.Cylinder
	else
		part.Shape = Enum.PartType.Block
		if shape == "Ellipsoid" then
			-- Eingebautes Kugel-Mesh skaliert mit der Part-Größe -> Ellipsoid
			local mesh = Instance.new("SpecialMesh")
			mesh.Name = "VR_Mesh"
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Scale = Vector3.one
			mesh.Parent = part
		end
	end
	return part
end

--- Entfernt alle von diesem Modul erzeugten Objekte.
function CosmeticApplier.Clear(model: Model)
	local folder = model:FindFirstChild(FOLDER_NAME)
	if folder then
		folder:Destroy()
	end
	for _, descendant in model:GetDescendants() do
		if descendant:GetAttribute("VR_Cosmetic") then
			descendant:Destroy()
		end
	end
end

local function sequence(...: Color3): ColorSequence
	local colors = { ... }
	if #colors == 1 then
		return ColorSequence.new(colors[1])
	end
	local keypoints = {}
	for index, color in colors do
		table.insert(keypoints, ColorSequenceKeypoint.new((index - 1) / (#colors - 1), color))
	end
	return ColorSequence.new(keypoints)
end

local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 70, 90)),
	ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 190, 50)),
	ColorSequenceKeypoint.new(0.4, Color3.fromRGB(90, 255, 120)),
	ColorSequenceKeypoint.new(0.6, Color3.fromRGB(60, 200, 255)),
	ColorSequenceKeypoint.new(0.8, Color3.fromRGB(130, 90, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 70, 210)),
})
CosmeticApplier.Rainbow = RAINBOW

------------------------------------------------------------------------
-- Körper und Accessoires
------------------------------------------------------------------------

--- Färbt Knochen und Körperhülle passend zum Skin (Hülle bleibt bestehen).
local function paintBody(model: Model, skin, accent: Color3)
	local baseMaterial = skin.Material or Enum.Material.SmoothPlastic
	local materials = skin.Materials or {}
	for partName, group in GROUP_BY_PART do
		local part = model:FindFirstChild(partName)
		if part and part:IsA("BasePart") then
			part.Color = skin.Colors[group] or skin.Primary
			part.Material = materials[group] or baseMaterial
		end
	end

	local body = model:FindFirstChild(BODY_FOLDER)
	if not body then
		return
	end
	local hidden = {}
	for _, tag in skin.HideBase or {} do
		hidden[tag] = true
	end
	local reflectance = skin.Reflectance or 0
	for _, shell in body:GetChildren() do
		if shell:IsA("BasePart") then
			local slot = shell:GetAttribute("VR_Paint")
			if slot then
				shell.Color = resolveColor(slot, skin, accent)
				shell.Material = resolveMaterial(slot, skin)
				-- Glanz nur auf den Körpergruppen, nicht auf Leuchtteilen
				shell.Reflectance = if skin.Colors[slot] then reflectance else 0
			end
			local tag = shell:GetAttribute("VR_Tag")
			shell.Transparency = if tag and hidden[tag] then 1 else 0
		end
	end
end

local function buildAccessories(model: Model, folder: Folder, skin, accent: Color3, created: { Instance })
	for _, presetName in skin.Accessories or {} do
		local preset = CosmeticDefinitions.AccessoryPresets[presetName]
		if preset then
			for index, piece in preset do
				local attachTo = model:FindFirstChild(piece.Attach)
				if attachTo and attachTo:IsA("BasePart") then
					local part = makeShape(piece.Shape)
					part.Name = presetName .. "_" .. index
					part.Size = piece.Size
					part.Color = resolveColor(piece.Color, skin, accent)
					part.Material = piece.Material or resolveMaterial(piece.Color, skin)
					part.Transparency = piece.Transparency or 0
					part.Reflectance = piece.Reflectance or 0
					part.TopSurface = Enum.SurfaceType.Smooth
					part.BottomSurface = Enum.SurfaceType.Smooth
					part.Anchored = false
					part.CanCollide = false
					part.CanQuery = false
					part.CanTouch = false
					part.Massless = true
					part.CastShadow = piece.Shadow == true
					part.CFrame = attachTo.CFrame * piece.Offset
					part.CollisionGroup = attachTo.CollisionGroup

					local weld = Instance.new("Weld")
					weld.Part0 = attachTo
					weld.Part1 = part
					weld.C0 = piece.Offset
					weld.Parent = part

					part.Parent = folder
					table.insert(created, part)
				end
			end
		end
	end
end

------------------------------------------------------------------------
-- Trail und Partikel
------------------------------------------------------------------------

local function cosmeticAttachment(parent: Instance, name: string, position: Vector3): Attachment
	local attachment = Instance.new("Attachment")
	attachment.Name = name
	attachment.Position = position
	attachment:SetAttribute("VR_Cosmetic", true)
	attachment.Parent = parent
	return attachment
end

local function makeTrail(name: string, torso: BasePart, halfHeight: number, options): Trail
	local top = cosmeticAttachment(torso, name .. "Top", Vector3.new(0, halfHeight, 0.3))
	local bottom = cosmeticAttachment(torso, name .. "Bottom", Vector3.new(0, -halfHeight, 0.3))

	local trail = Instance.new("Trail")
	trail.Name = name
	trail.Attachment0 = top
	trail.Attachment1 = bottom
	trail.Lifetime = options.Lifetime
	trail.MinLength = 0.1
	trail.FaceCamera = true
	trail.LightEmission = options.LightEmission
	trail.LightInfluence = options.LightInfluence
	trail.WidthScale = NumberSequence.new({
		NumberSequenceKeypoint.new(0, options.Width),
		NumberSequenceKeypoint.new(1, options.WidthEnd),
	})
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, options.Transparency),
		NumberSequenceKeypoint.new(0.55, options.Transparency + (1 - options.Transparency) * 0.45),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.Color = options.Color
	trail:SetAttribute("VR_Cosmetic", true)
	trail.Parent = torso
	return trail
end

local function applyTrail(model: Model, created: { Instance }, trailDef)
	local torso = model:FindFirstChild("UpperTorso")
	if not torso or not torso:IsA("BasePart") then
		return
	end
	local color
	if trailDef.Rainbow then
		color = RAINBOW
	elseif trailDef.ColorMid then
		color = sequence(trailDef.ColorA, trailDef.ColorMid, trailDef.ColorB)
	else
		color = sequence(trailDef.ColorA, trailDef.ColorB)
	end
	local glowing = (trailDef.LightEmission or 0.5) > 0.3
	local lifetime = trailDef.Lifetime or 0.4

	-- Breites Farbband hinter dem Oberkörper
	table.insert(
		created,
		makeTrail("VR_Trail", torso, 0.55, {
			Lifetime = lifetime,
			LightEmission = trailDef.LightEmission or 0.5,
			LightInfluence = if glowing then 0.2 else 1,
			Width = trailDef.Width or 1,
			WidthEnd = trailDef.WidthEnd or 0,
			Transparency = trailDef.Transparency or 0.15,
			Color = color,
		})
	)

	-- Heller, schmaler Kern für einen Leuchtstreifen-Look
	if trailDef.Core then
		local edge = if trailDef.Rainbow then Color3.fromRGB(255, 255, 255) else trailDef.ColorA
		table.insert(
			created,
			makeTrail("VR_TrailCore", torso, 0.16, {
				Lifetime = lifetime * 0.6,
				LightEmission = 1,
				LightInfluence = 0,
				Width = 1,
				WidthEnd = 0.2,
				Transparency = 0.05,
				Color = sequence(trailDef.Core, edge),
			})
		)
	end
end

local function applyEffect(model: Model, effectDef)
	local torso = model:FindFirstChild("UpperTorso")
	if not torso then
		return
	end
	local attachment = cosmeticAttachment(torso, "VR_EffectAttachment", Vector3.new(0, -0.1, 0))

	local size = effectDef.Size or 0.3
	local speed = effectDef.Speed or 1
	local lifetime = effectDef.Lifetime or 1

	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "VR_Effect"
	emitter.Rate = effectDef.Rate or 10
	emitter.Lifetime = NumberRange.new(lifetime * 0.6, lifetime)
	emitter.Speed = NumberRange.new(speed, speed * 1.5)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.LightEmission = effectDef.LightEmission or 0.5
	emitter.LightInfluence = if (effectDef.LightEmission or 0.5) > 0.5 then 0 else 1
	emitter.Drag = effectDef.Drag or 0
	emitter.ZOffset = 0.5
	if effectDef.Twinkle then
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.15, size),
			NumberSequenceKeypoint.new(0.35, size * 0.35),
			NumberSequenceKeypoint.new(0.55, size * 0.9),
			NumberSequenceKeypoint.new(1, 0),
		})
	else
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, size * 0.4),
			NumberSequenceKeypoint.new(0.2, size),
			NumberSequenceKeypoint.new(1, 0),
		})
	end
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(0.7, 0.3),
		NumberSequenceKeypoint.new(1, 1),
	})
	if effectDef.Rainbow then
		emitter.Color = RAINBOW
	elseif effectDef.Color2 then
		emitter.Color = sequence(effectDef.Color, effectDef.Color2)
	else
		emitter.Color = ColorSequence.new(effectDef.Color)
	end
	if effectDef.Rise then
		emitter.Acceleration = Vector3.new(0, effectDef.Rise, 0)
	end
	if effectDef.Spin then
		emitter.Rotation = NumberRange.new(0, 360)
		emitter.RotSpeed = NumberRange.new(-effectDef.Spin, effectDef.Spin)
	end
	emitter:SetAttribute("VR_Cosmetic", true)
	emitter.Parent = attachment
end

--- Wendet die komplette Kosmetik auf ein Rig an (ersetzt vorherige Kosmetik).
function CosmeticApplier.Apply(model: Model, equipped)
	CosmeticApplier.Clear(model)
	equipped = equipped or CosmeticDefinitions.DefaultEquipped

	local skin = getSkin(equipped)
	local accent = CosmeticApplier.GetAccentColor(equipped)

	paintBody(model, skin, accent)

	local folder = Instance.new("Folder")
	folder.Name = FOLDER_NAME
	local created = {}
	buildAccessories(model, folder, skin, accent, created)
	folder.Parent = model

	if equipped.Trails and equipped.Trails ~= "" then
		local trailDef = CosmeticDefinitions.Get("Trails", equipped.Trails)
		if trailDef then
			applyTrail(model, created, trailDef)
		end
	end

	if equipped.Effects and equipped.Effects ~= "" then
		local effectDef = CosmeticDefinitions.Get("Effects", equipped.Effects)
		if effectDef then
			applyEffect(model, effectDef)
		end
	end

	model:SetAttribute("AccentColor", accent)
	return created
end

return CosmeticApplier
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">CosmeticDefinitions</string>
          <string name="Source"><![CDATA[--[[
	CosmeticDefinitions  (ModuleScript)
	Pfad: ReplicatedStorage/Shared/CosmeticDefinitions

	Katalog aller kosmetischen Gegenstände. Alles wird ausschließlich aus
	Roblox-Standardteilen (Block, Kugel, Zylinder, Keil, SpecialMesh "Sphere"
	als Ellipsoid), Farben, Materialien, Trails und Partikeln gebaut – es
	werden keine externen Assets benötigt.

	WICHTIG: Kosmetik hat KEINEN Einfluss auf Hitbox, Geschwindigkeit oder
	Sprunghöhe. Accessoires sind Massless, CanCollide=false, CanQuery=false.

	Kategorien: Skins, Trails, Effects, Emotes, Victory, Colors

	Skin-Felder (siehe CosmeticApplier):
		Colors        Farben je Körpergruppe (Head, Torso, Hips, Arms, Hands, Legs, Feet)
		Primary, Secondary, Dark, Accent, Visor   Palette (Primary/Secondary/Accent
		              dienen auch als Farbfelder im Shop)
		Trim, Ears, Joint, Collar, Belt, Sole     optionale Zusatzfarben der Körperhülle
		              (Fallback: Trim→Secondary, Ears→Primary, Collar→Joint,
		              Sole/Belt/Joint→Dark)
		Material      Grundmaterial der Körpergruppen und von "Primary"-Teilen
		TrimMaterial  Material für Trim/Dark/Secondary-Teile (Standard SmoothPlastic)
		Materials     Material je Slot/Gruppe, überschreibt alles (z.B. Hands = Neon)
		Reflectance   Glanz der Körpergruppen (z.B. Chrom)
		HideBase      Liste von Hüllen-Tags, die ausgeblendet werden
		              (Ears, Plate, Emblem, Back, Belt, Stripes – siehe RunnerRig)
		Accessories   Liste von AccessoryPresets
]]

local CosmeticDefinitions = {}

local rgb = Color3.fromRGB
local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local rad = math.rad

local NEON = Enum.Material.Neon
local GLASS = Enum.Material.Glass
local METAL = Enum.Material.Metal
local FABRIC = Enum.Material.Fabric
local FOIL = Enum.Material.Foil

local CYL_Y = ANG(0, 0, rad(90)) -- Zylinderachse senkrecht (Y)
local CYL_Z = ANG(0, rad(90), 0) -- Zylinderachse nach vorn (Z)

-- Mitte des Kugelhelms relativ zur Kopfmitte (Radius 0.68, siehe RunnerRig)
local HELMET_Y = 0.02
local BRASS = rgb(204, 168, 96)
local WHITE = rgb(255, 255, 255)

CosmeticDefinitions.Categories = { "Skins", "Trails", "Effects", "Emotes", "Victory", "Colors" }

CosmeticDefinitions.CategoryNames = {
	Skins = "Skins",
	Trails = "Trails",
	Effects = "Effekte",
	Emotes = "Emotes",
	Victory = "Siegesanimationen",
	Colors = "Farbvarianten",
}

CosmeticDefinitions.Rarities = {
	Common = { Name = "Gewöhnlich", Color = rgb(160, 175, 200), Order = 1 },
	Rare = { Name = "Selten", Color = rgb(70, 150, 255), Order = 2 },
	Epic = { Name = "Episch", Color = rgb(180, 90, 255), Order = 3 },
	Legendary = { Name = "Legendär", Color = rgb(255, 190, 40), Order = 4 },
}

------------------------------------------------------------------------
-- Accessoire-Bausteine
------------------------------------------------------------------------
-- Offsets sind relativ zur Mitte des Körperteils (Blickrichtung des Rigs = -Z,
-- Rücken = +Z, rechts = +X). Die Spielkamera sieht die Figur im Profil, der
-- Shop von vorn – Silhouetten (Spitzen, Flossen, Bänder) wirken daher in der
-- YZ-Ebene am stärksten.
-- Shape: "Block" | "Ball" | "Cylinder" (Achse X) | "Wedge" | "Ellipsoid"
-- Color: Farbslot ("Primary", "Secondary", "Dark", "Accent", "Glow" = Akzent
--        leuchtend, "Visor", "Trim", eine Körpergruppe wie "Head") oder Color3
-- Optional: Material, Transparency, Reflectance, Shadow (wirft Schatten)
local A = {}

--- Spitze aus zwei Keilen: im Profil (Blick entlang X) ein gleichschenkliges
--- Dreieck. base = Fußpunkt, die Spitze zeigt entlang +Y von base.
local function spike(list, attach: string, base: CFrame, width: number, height: number, depth: number, color, material: Enum.Material?, transparency: number?)
	local size = V(width, height, depth / 2)
	table.insert(list, {
		Attach = attach,
		Shape = "Wedge",
		Size = size,
		Offset = base * CF(0, height / 2, -depth / 4),
		Color = color,
		Material = material,
		Transparency = transparency,
	})
	table.insert(list, {
		Attach = attach,
		Shape = "Wedge",
		Size = size,
		Offset = base * CF(0, height / 2, depth / 4) * ANG(0, math.pi, 0),
		Color = color,
		Material = material,
		Transparency = transparency,
	})
end

--- Ring aus kurzen Segmenten (Heiligenschein, Orbit). center = Ringmitte inkl. Neigung.
local function ring(list, attach: string, center: CFrame, radius: number, count: number, thickness: number, height: number, color, transparency: number?)
	local length = 2 * math.pi * radius / count * 1.08
	for i = 0, count - 1 do
		table.insert(list, {
			Attach = attach,
			Shape = "Block",
			Size = V(thickness, height, length),
			Offset = center * ANG(0, i / count * 2 * math.pi, 0) * CF(radius, 0, 0),
			Color = color,
			Transparency = transparency,
		})
	end
end

--- Punkt auf/unter der Helmoberfläche in Richtung des Winkels (0° = oben, + = nach hinten),
--- ausgerichtet entlang dieser Richtung (für Kämme, Flammen, Eisspitzen).
local function onHelmet(angle: number, radius: number, extraTilt: number?): CFrame
	local r = rad(angle)
	return CF(0, HELMET_Y + radius * math.cos(r), radius * math.sin(r)) * ANG(r + rad(extraTilt or 0), 0, 0)
end

local SIDES = { { Name = "Left", Sign = -1 }, { Name = "Right", Sign = 1 } }

-- Visiere -------------------------------------------------------------

-- Gewölbte Linse mit dunklem Rahmen vorn am Helm. Die Linse ist breiter als der
-- Rahmen, damit sie auch im Profil sichtbar ist; der Rahmen zeigt sich oben/unten.
A.Visor = {
	{ Attach = "Head", Shape = "Ellipsoid", Size = V(1.3, 0.62, 0.74), Offset = CF(0, 0.1, -0.34), Color = "Dark" },
	{ Attach = "Head", Shape = "Ellipsoid", Size = V(1.34, 0.5, 0.84), Offset = CF(0, 0.1, -0.36), Color = "Visor" },
}
-- Breites Band, das bis über die Ohrkapseln reicht (im Profil gut sichtbar)
A.VisorWide = {
	{ Attach = "Head", Shape = "Ellipsoid", Size = V(1.5, 0.6, 1.3), Offset = CF(0, 0.12, -0.1), Color = "Dark" },
	{ Attach = "Head", Shape = "Ellipsoid", Size = V(1.54, 0.46, 1.36), Offset = CF(0, 0.12, -0.14), Color = "Visor" },
}
-- Dunkle Gesichtsplatte mit schmalem Leuchtschlitz (breiter als die Platte -> auch im Profil sichtbar)
A.VisorSlit = {
	{ Attach = "Head", Shape = "Ellipsoid", Size = V(1.2, 0.74, 0.76), Offset = CF(0, 0.02, -0.36), Color = "Dark" },
	{ Attach = "Head", Shape = "Ellipsoid", Size = V(1.26, 0.13, 0.84), Offset = CF(0, 0.1, -0.38), Color = "Visor" },
}
-- Fliegerbrille: Kopfband, Messingfassungen, Glaslinsen
A.Goggles = {
	{ Attach = "Head", Shape = "Cylinder", Size = V(0.2, 1.42, 1.42), Offset = CF(0, 0.3, 0.08) * CYL_Y, Color = "Dark" },
	{ Attach = "Head", Shape = "Cylinder", Size = V(0.12, 0.5, 0.5), Offset = CF(-0.25, 0.3, -0.6) * CYL_Z, Color = BRASS, Material = METAL },
	{ Attach = "Head", Shape = "Cylinder", Size = V(0.12, 0.5, 0.5), Offset = CF(0.25, 0.3, -0.6) * CYL_Z, Color = BRASS, Material = METAL },
	{ Attach = "Head", Shape = "Cylinder", Size = V(0.1, 0.4, 0.4), Offset = CF(-0.25, 0.3, -0.65) * CYL_Z, Color = "Visor", Material = GLASS },
	{ Attach = "Head", Shape = "Cylinder", Size = V(0.1, 0.4, 0.4), Offset = CF(0.25, 0.3, -0.65) * CYL_Z, Color = "Visor", Material = GLASS },
}

-- Kopfschmuck ----------------------------------------------------------

-- Rennstreifen über den Helm (von vorn/oben sichtbar)
A.HeadStripe = {
	{ Attach = "Head", Shape = "Cylinder", Size = V(0.24, 1.4, 1.4), Offset = CF(0, HELMET_Y, 0), Color = "Primary" },
}

-- Irokesen aus Leuchtspitzen
do
	local list = {}
	local heights = { 0.5, 0.62, 0.58, 0.46 }
	for i, angle in { -25, 5, 35, 65 } do
		spike(list, "Head", onHelmet(angle, 0.6), 0.12, heights[i], 0.36, "Glow")
	end
	A.PunkSpikes = list
end

-- Nach hinten gewehte Flammenzungen
do
	local list = {}
	local heights = { 0.62, 0.8, 0.72, 0.5 }
	for i, angle in { -5, 25, 55, 85 } do
		local color = if i % 2 == 1 then "Glow" else rgb(255, 110, 20)
		spike(list, "Head", onHelmet(angle, 0.58, 22), 0.14, heights[i], 0.42, color, NEON)
	end
	A.FlameCrest = list
end

-- Eine Antenne mit Leuchtkugel, leicht nach hinten/außen geneigt
do
	local base = CF(0.3, 0.6, 0.1)
	local tilt = base * ANG(rad(15), 0, rad(-10))
	A.Antenna = {
		{ Attach = "Head", Shape = "Cylinder", Size = V(0.14, 0.26, 0.26), Offset = base * CYL_Y, Color = "Trim" },
		{ Attach = "Head", Shape = "Cylinder", Size = V(0.8, 0.08, 0.08), Offset = tilt * CF(0, 0.4, 0) * CYL_Y, Color = "Dark" },
		{ Attach = "Head", Shape = "Ball", Size = V(0.26, 0.26, 0.26), Offset = tilt * CF(0, 0.84, 0), Color = "Glow" },
	}
end

-- Gebogene Hörner: dunkler Ansatz, glühende Spitze
do
	local list = {}
	for _, side in SIDES do
		local s = side.Sign
		local base = CF(s * 0.4, 0.5, 0) * ANG(rad(18), 0, rad(-s * 28))
		table.insert(list, { Attach = "Head", Shape = "Ellipsoid", Size = V(0.34, 0.8, 0.34), Offset = base * CF(0, 0.3, 0), Color = "Dark" })
		spike(list, "Head", base * CF(0, 0.55, 0) * ANG(rad(-35), 0, 0), 0.2, 0.5, 0.26, "Glow")
	end
	A.Horns = list
end

-- Krone: Reif, sechs Zacken (Rauten), drei Edelsteine
do
	local list = {
		{ Attach = "Head", Shape = "Cylinder", Size = V(0.28, 1.26, 1.26), Offset = CF(0, 0.5, 0) * CYL_Y, Color = "Primary" },
	}
	for i = 0, 5 do
		table.insert(list, {
			Attach = "Head",
			Shape = "Block",
			Size = V(0.3, 0.3, 0.07),
			Offset = ANG(0, rad(i * 60), 0) * CF(0, 0.64, -0.62) * ANG(0, 0, rad(45)),
			Color = "Primary",
		})
	end
	table.insert(list, { Attach = "Head", Shape = "Ball", Size = V(0.2, 0.2, 0.2), Offset = CF(0, 0.5, -0.64), Color = rgb(235, 30, 80), Material = NEON })
	table.insert(list, { Attach = "Head", Shape = "Ball", Size = V(0.17, 0.17, 0.17), Offset = CF(-0.64, 0.5, 0), Color = "Visor" })
	table.insert(list, { Attach = "Head", Shape = "Ball", Size = V(0.17, 0.17, 0.17), Offset = CF(0.64, 0.5, 0), Color = "Visor" })
	A.Crown = list
end

-- Schwebender Heiligenschein, leicht nach hinten gekippt
do
	local list = {}
	ring(list, "Head", CF(0, 1.0, 0.08) * ANG(rad(16), 0, 0), 0.52, 10, 0.1, 0.07, "Glow", 0.05)
	A.Halo = list
end

-- Planetenring um den Kopf mit zwei Monden
do
	local list = {}
	local center = CF(0, HELMET_Y, 0) * ANG(rad(22), 0, rad(-18))
	ring(list, "Head", center, 0.98, 12, 0.12, 0.05, "Glow", 0.1)
	table.insert(list, { Attach = "Head", Shape = "Ball", Size = V(0.2, 0.2, 0.2), Offset = center * ANG(0, rad(40), 0) * CF(0.98, 0, 0), Color = WHITE, Material = NEON })
	table.insert(list, { Attach = "Head", Shape = "Ball", Size = V(0.16, 0.16, 0.16), Offset = center * ANG(0, rad(220), 0) * CF(0.98, 0, 0), Color = "Visor" })
	A.OrbitRing = list
end

-- Tropenhelm-Krempe mit Hutband (Kuppel = Helm in Kopffarbe)
A.SafariBrim = {
	{ Attach = "Head", Shape = "Ellipsoid", Size = V(1.96, 0.12, 1.96), Offset = CF(0, 0.36, 0.02), Color = "Head", Shadow = true },
	{ Attach = "Head", Shape = "Cylinder", Size = V(0.14, 1.18, 1.18), Offset = CF(0, 0.49, 0.02) * CYL_Y, Color = "Dark" },
}

-- Blätter im Hutband
do
	local list = {}
	for _, side in SIDES do
		local s = side.Sign
		table.insert(list, { Attach = "Head", Shape = "Ellipsoid", Size = V(0.1, 0.55, 0.28), Offset = CF(s * 0.56, 0.58, 0.1) * ANG(rad(-15), 0, rad(-s * 40)), Color = "Accent" })
		table.insert(list, { Attach = "Head", Shape = "Ellipsoid", Size = V(0.1, 0.45, 0.24), Offset = CF(s * 0.58, 0.52, -0.12) * ANG(rad(20), 0, rad(-s * 62)), Color = "Primary" })
	end
	table.insert(list, { Attach = "Head", Shape = "Ellipsoid", Size = V(0.1, 0.5, 0.26), Offset = CF(0.1, 0.62, 0.5) * ANG(rad(50), 0, 0), Color = "Accent" })
	A.Leaves = list
end

-- Propellermütze mit Schirm
do
	local hub = CF(0, 1.04, 0.06) * ANG(0, rad(25), 0)
	A.PropellerCap = {
		{ Attach = "Head", Shape = "Ellipsoid", Size = V(1.44, 1.0, 1.44), Offset = CF(0, 0.34, 0.06), Color = "Primary", Shadow = true },
		{ Attach = "Head", Shape = "Ellipsoid", Size = V(0.95, 0.1, 0.8), Offset = CF(0, 0.36, -0.66), Color = "Secondary" },
		{ Attach = "Head", Shape = "Cylinder", Size = V(0.24, 0.07, 0.07), Offset = CF(0, 0.92, 0.06) * CYL_Y, Color = "Dark" },
		{ Attach = "Head", Shape = "Block", Size = V(0.62, 0.04, 0.18), Offset = hub * CF(0.31, 0, 0), Color = "Accent" },
		{ Attach = "Head", Shape = "Block", Size = V(0.62, 0.04, 0.18), Offset = hub * CF(-0.31, 0, 0), Color = "Secondary" },
		{ Attach = "Head", Shape = "Ball", Size = V(0.14, 0.14, 0.14), Offset = CF(0, 1.06, 0.06), Color = "Accent" },
	}
end

-- Stirnband mit Knoten und zwei flatternden Bändern
A.Headband = {
	{ Attach = "Head", Shape = "Cylinder", Size = V(0.18, 1.36, 1.36), Offset = CF(0, 0.34, 0) * CYL_Y, Color = "Accent" },
	{ Attach = "Head", Shape = "Ball", Size = V(0.22, 0.22, 0.22), Offset = CF(0, 0.34, 0.68), Color = "Accent" },
	{ Attach = "Head", Shape = "Block", Size = V(0.05, 0.2, 0.95), Offset = CF(0.06, 0.32, 0.7) * ANG(rad(18), rad(6), 0) * CF(0, 0, 0.47), Color = "Accent" },
	{ Attach = "Head", Shape = "Block", Size = V(0.05, 0.17, 0.75), Offset = CF(-0.06, 0.3, 0.7) * ANG(rad(34), rad(-8), 0) * CF(0, 0, 0.37), Color = "Accent" },
}

-- Eiskristalle auf Schultern und Kopf
do
	local list = {}
	for _, side in SIDES do
		local s = side.Sign
		local attach = side.Name .. "UpperArm"
		spike(list, attach, CF(s * 0.12, 0.5, -0.05) * ANG(rad(-12), 0, rad(-s * 28)), 0.16, 0.8, 0.38, "Visor", GLASS, 0.1)
		spike(list, attach, CF(s * 0.06, 0.45, 0.22) * ANG(rad(30), 0, rad(-s * 16)), 0.14, 0.58, 0.3, "Glow")
	end
	local heights = { 0.55, 0.72, 0.58 }
	for i, angle in { -20, 15, 50 } do
		spike(list, "Head", onHelmet(angle, 0.58, 8), 0.14, heights[i], 0.34, "Glow")
	end
	A.IceSpikes = list
end

-- Schultern ------------------------------------------------------------

-- Runde Schulterpanzer mit Leuchtkante
do
	local list = {}
	for _, side in SIDES do
		local s = side.Sign
		local attach = side.Name .. "UpperArm"
		table.insert(list, { Attach = attach, Shape = "Ellipsoid", Size = V(1.02, 0.6, 1.0), Offset = CF(s * 0.06, 0.44, 0) * ANG(0, 0, rad(-s * 14)), Color = "Trim", Shadow = true })
		table.insert(list, { Attach = attach, Shape = "Ellipsoid", Size = V(1.08, 0.24, 1.06), Offset = CF(s * 0.08, 0.3, 0) * ANG(0, 0, rad(-s * 14)), Color = "Glow" })
	end
	A.Pauldrons = list
end

-- Geschichtete Panzerplatten (Ninja)
do
	local list = {}
	for _, side in SIDES do
		local s = side.Sign
		local attach = side.Name .. "UpperArm"
		table.insert(list, { Attach = attach, Shape = "Block", Size = V(0.95, 0.14, 0.92), Offset = CF(s * 0.14, 0.62, 0) * ANG(0, 0, rad(-s * 22)), Color = "Secondary" })
		table.insert(list, { Attach = attach, Shape = "Block", Size = V(0.8, 0.13, 0.86), Offset = CF(s * 0.32, 0.42, 0) * ANG(0, 0, rad(-s * 40)), Color = "Secondary" })
	end
	A.ShoulderPlates = list
end

-- Rücken ---------------------------------------------------------------

-- Flacher Neon-Rucksack mit seitlichen Lichtern
A.Backpack = {
	{ Attach = "UpperTorso", Shape = "Block", Size = V(1.16, 1.0, 0.36), Offset = CF(0, 0.02, 0.78), Color = "Secondary", Shadow = true },
	{ Attach = "UpperTorso", Shape = "Cylinder", Size = V(1.16, 0.36, 0.36), Offset = CF(0, 0.52, 0.78), Color = "Secondary" },
	{ Attach = "UpperTorso", Shape = "Block", Size = V(0.08, 0.84, 0.06), Offset = CF(-0.32, 0.02, 0.97), Color = "Glow" },
	{ Attach = "UpperTorso", Shape = "Block", Size = V(0.08, 0.84, 0.06), Offset = CF(0.32, 0.02, 0.97), Color = "Glow" },
	{ Attach = "UpperTorso", Shape = "Cylinder", Size = V(1.2, 0.22, 0.22), Offset = CF(0, 0.12, 0.78), Color = "Visor" },
}

-- Jetpack: Gehäuse, zwei Tanks mit Kuppeln, Düsen und Flammen
do
	local list = {
		{ Attach = "UpperTorso", Shape = "Block", Size = V(0.9, 0.95, 0.4), Offset = CF(0, 0.05, 0.78), Color = "Secondary", Shadow = true },
	}
	for _, side in SIDES do
		local x = side.Sign * 0.38
		table.insert(list, { Attach = "UpperTorso", Shape = "Cylinder", Size = V(1.05, 0.44, 0.44), Offset = CF(x, 0, 0.98) * CYL_Y, Color = "Trim", Shadow = true })
		table.insert(list, { Attach = "UpperTorso", Shape = "Ball", Size = V(0.44, 0.44, 0.44), Offset = CF(x, 0.52, 0.98), Color = "Trim" })
		table.insert(list, { Attach = "UpperTorso", Shape = "Cylinder", Size = V(0.2, 0.34, 0.34), Offset = CF(x, -0.6, 0.98) * CYL_Y, Color = "Dark" })
		table.insert(list, { Attach = "UpperTorso", Shape = "Ellipsoid", Size = V(0.26, 0.6, 0.26), Offset = CF(x, -0.98, 0.98), Color = "Glow", Transparency = 0.15 })
	end
	A.Jetpack = list
end

-- Umhang: Spange über den Schultern, oben ein Keil (im Profil ein Dreieck),
-- unten ein nach hinten wehendes Stück
