          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Config  (ModuleScript)
	Pfad: ReplicatedStorage/Shared/Config

	Zentrale Konfiguration für Velocity Rush. Alle Balancing-Werte für Movement,
	Greifhaken, Gefahrenzone, Runden, Ökonomie, Ranked und Anti-Exploit stehen hier.
	Server und Client lesen dieselben Werte, damit Vorhersage (Client) und
	Validierung (Server) zusammenpassen.

	Einheiten: Studs, Sekunden, Studs/Sekunde.
]]

local RunService = game:GetService("RunService")

local Config = {}

Config.GameName = "Velocity Rush"
Config.Version = "1.0.0"
Config.IsStudio = RunService:IsStudio()

Config.Debug = {
	-- In Roblox Studio darf ein Rennen auch mit nur einem Spieler starten (zum Testen).
	AllowSoloRace = RunService:IsStudio(),
	-- Abgelehnte Remote-Aufrufe im Output protokollieren.
	LogRejections = RunService:IsStudio(),
}

Config.World = {
	Gravity = 200,
	PlaneZ = 0,
	TrackDepth = 10,
	LobbyOrigin = Vector3.new(-3000, 0, 0),
	RaceOrigin = Vector3.new(0, 0, 0),
	TutorialOrigin = Vector3.new(-10000, 0, 0),
	PracticeOriginStart = Vector3.new(-20000, 0, 0),
	PracticeOriginSpacing = 6000,
}

-- Geometrie der Spielfigur (muss zu Shared/RunnerRig passen).
Config.Character = {
	ColliderWidth = 1.8,
	ColliderDepth = 1.4,
	StandHeight = 5.4,
	SlideHeight = 2.2,
	FeetOffset = -2.7, -- Fußsohle relativ zur Mitte des HumanoidRootPart
}

Config.Movement = {
	MaxRunSpeed = 44,
	GroundAcceleration = 150,
	GroundDeceleration = 190,
	TurnAcceleration = 320,
	AirAcceleration = 95,
	AirTurnAcceleration = 150,
	AirDrag = 8,
	OverspeedGroundDecay = 38,
	OverspeedAirDecay = 7,
	AbsoluteMaxSpeed = 140,
	MaxFallSpeed = 130,

	JumpVelocity = 62,
	JumpCutMultiplier = 0.45,
	FallGravityMultiplier = 1.35,
	CoyoteTime = 0.1,
	JumpBuffer = 0.13,

	WallSlideMaxFall = 22,
	WallJumpVelocityX = 42,
	WallJumpVelocityY = 58,
	WallJumpLockTime = 0.16,

	SlideMinSpeed = 14,
	SlideBoost = 9,
	SlideFriction = 17,
	SlideEndSpeed = 9,
	SlideCooldown = 0.45,
	CrawlSpeed = 12,

	DashSpeed = 72,
	DashDuration = 0.16,
	DashCooldown = 1.1,

	IceAccelerationMultiplier = 0.35,
	IceDecelerationMultiplier = 0.18,

	BoostMultiplier = 1.35,
	BoostImpulse = 22,
	SlowMultiplier = 0.4,

	GroundCheckDistance = 0.3,
	StateSendInterval = 0.08,
}

Config.Grapple = {
	Range = 58,
	UpgradeRangeMultiplier = 1.6,
	UpgradeReelMultiplier = 2,
	MinRopeLength = 10,
	ReelSpeed = 8,
	RopeStiffness = 12,
	MaxCorrectionSpeed = 60,
	SwingAcceleration = 55,
	ReleaseBoost = 8,
	Cooldown = 0.3,
	UpgradeCooldown = 0.05,
	MaxAttachTime = 6,
	MaxAnchorBelow = 8, -- Anker dürfen höchstens so weit unter dem Spieler liegen
	ServerRangeTolerance = 14,
	ServerMinInterval = 0.12,
}

-- Gefahrenzone: eine Energiewand, die dem Führenden in festem Abstand folgt.
Config.HazardZone = {
	WarningStart = 10, -- ab Sekunde X nach Rennstart Warnung
	ShrinkStart = 18, -- ab Sekunde X wird die Zone gefährlich und schrumpft
	ShrinkDuration = 55,
	InitialLength = 260, -- Abstand der Wand zum Führenden zu Beginn
	FinalLength = 60, -- minimaler Abstand im Endzustand
	EliminationDelay = 1.6, -- so lange darf man hinter der Wand sein
	RecoveryRate = 2, -- Abbau der Gefahrenzeit pro Sekunde in Sicherheit
}

Config.Round = {
	MinPlayers = 2,
	MaxPlayers = 8,
	StartingCountdown = 10,
	FullLobbyCountdown = 4,
	CountdownDuration = 3.5,
	MaxRaceTime = 240,
	ResultsDuration = 9,
	RespawnFreezeTime = 0.9,
	ReturnToLobbyDelay = 1.5,
	TickRate = 10,
}

Config.Economy = {
	StartingCoins = 300,
	MaxCoins = 100_000_000,
	MaxTransaction = 1_000_000,
}

Config.Rewards = {
	ParticipationCoins = 20,
	ParticipationXP = 35,
	PlacementCoins = { 60, 35, 20 },
	PlacementXP = { 100, 60, 40 },
	FinishBonusCoins = 15,
	FinishBonusXP = 25,
	FullRewardPlayerCount = 4, -- ab so vielen Teilnehmern volle Platzierungsboni
	LevelUpCoinsPerLevel = 25,
	RecentMatchMemory = 25,
}

Config.Ranked = {
	Season = 1,
	StartRating = 1000,
	KFactor = 40,
	MinRating = 0,
	LeavePenaltyFactor = 1, -- Leaver werden wie Letztplatzierte gewertet
}

Config.PowerUps = {
	PickupRadius = 4.5,
	RespawnTime = 9,
	UseDebounce = 0.4,
}

Config.Practice = {
	RespawnFreezeTime = 0.35,
}

Config.Data = {
	StoreName = "VelocityRush_Profiles_v1",
	KeyPrefix = "Player_",
	AutosaveInterval = 90,
	LockTimeout = 360,
	LoadRetries = 5,
	SaveRetries = 4,
}

Config.Leaderboard = {
	WinsStore = "VelocityRush_Wins_v1",
	RatingStorePrefix = "VelocityRush_Rating_S",
	RefreshInterval = 120,
	Size = 25,
}

Config.AntiExploit = {
	SampleInterval = 0.25,
	Window = 1.0,
	MaxSpeed = 230, -- Studs/s über das Messfenster (legitimes Maximum ≈ 195)
	MaxZDrift = 6,
	TeleportGrace = 1.5,
	ViolationDecayPerSecond = 0.05,
	KickEnabled = true,
	KickThreshold = 12,
}

-- Token-Bucket pro Spieler und Remote: { Kapazität, Nachfüllrate pro Sekunde }
Config.RateLimits = {
	QueueRequest = { 6, 1.5 },
	PracticeRequest = { 6, 1.5 },
	MoveState = { 30, 18 },
	GrappleRequest = { 20, 10 },
	UsePowerUp = { 6, 3 },
	PlayEmote = { 3, 0.7 },
	SaveSettings = { 4, 0.5 },
	RequestRespawn = { 3, 0.5 },
	GetProfile = { 6, 1 },
	ShopRequest = { 10, 3 },
	GetLeaderboard = { 4, 0.5 },
}

Config.Camera = {
	Distance = 58,
	HeightOffset = 5,
	FocusHeight = 3,
	FieldOfView = 60,
	LookAheadFactor = 0.32,
	MaxLookAhead = 18,
	FollowSharpness = 9,
	VerticalSharpness = 5,
	VerticalDeadZone = 3,
	SpeedZoom = 0.22,
	MaxExtraDistance = 22,
	LeaderBias = 0.25,
	MaxLeaderBias = 22,
	SnapDistance = 120,
}

Config.Input = {
	GamepadDeadzone = 0.2,
	DefaultGamepadSensitivity = 1,
}

-- Sounds: Standardmäßig werden ausschließlich in Roblox eingebaute Sounddateien
-- (rbxasset://sounds/...) verwendet. Eigene Sound-IDs können hier eingetragen werden.
Config.Audio = {
	MusicId = "", -- z.B. "rbxassetid://123456" – leer = keine Musik
	Sounds = {
		Jump = { Id = "rbxasset://sounds/action_jump.mp3", Volume = 0.45, Pitch = 1.1 },
		WallJump = { Id = "rbxasset://sounds/action_jump.mp3", Volume = 0.45, Pitch = 1.3 },
		Land = { Id = "rbxasset://sounds/action_jump_land.mp3", Volume = 0.5, Pitch = 1 },
		Slide = { Id = "rbxasset://sounds/action_falling.mp3", Volume = 0.25, Pitch = 2.2 },
		Dash = { Id = "rbxasset://sounds/action_falling.mp3", Volume = 0.35, Pitch = 2.8 },
		Grapple = { Id = "rbxasset://sounds/action_get_up.mp3", Volume = 0.55, Pitch = 1.6 },
		Pickup = { Id = "rbxasset://sounds/action_get_up.mp3", Volume = 0.6, Pitch = 2.2 },
		PowerUp = { Id = "rbxasset://sounds/action_jump.mp3", Volume = 0.6, Pitch = 0.7 },
		Boost = { Id = "rbxasset://sounds/action_falling.mp3", Volume = 0.4, Pitch = 1.8 },
		Eliminated = { Id = "rbxasset://sounds/uuhhh.mp3", Volume = 0.6, Pitch = 1 },
		Countdown = { Id = "rbxasset://sounds/action_jump_land.mp3", Volume = 0.7, Pitch = 2 },
		Go = { Id = "rbxasset://sounds/action_jump.mp3", Volume = 0.8, Pitch = 1.4 },
		Warning = { Id = "rbxasset://sounds/action_jump_land.mp3", Volume = 0.5, Pitch = 2.6 },
		Click = { Id = "rbxasset://sounds/action_jump_land.mp3", Volume = 0.25, Pitch = 3 },
		Victory = { Id = "rbxasset://sounds/action_get_up.mp3", Volume = 0.8, Pitch = 1.2 },
		Splash = { Id = "rbxasset://sounds/impact_water.mp3", Volume = 0.5, Pitch = 1 },
	},
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">CosmeticApplier</string>
          <string name="Source"><![CDATA[--[[
	CosmeticApplier  (ModuleScript)
	Pfad: ReplicatedStorage/Shared/CosmeticApplier

	Wendet ausgerüstete Kosmetik (Skin, Farbvariante, Trail, Partikeleffekt)
	auf ein RunnerRig an. Wird vom Server für echte Spielfiguren und vom Client
	für die Shop-Vorschau verwendet.

	Alle erzeugten Objekte sind rein visuell:
		Massless = true, CanCollide = false, CanQuery = false, CanTouch = false.

	API:
		CosmeticApplier.Apply(model, equipped)   equipped = { Skins="Rookie", Trails="", ... }
		CosmeticApplier.Clear(model)
		CosmeticApplier.GetAccentColor(equipped) -> Color3
]]

local CosmeticDefinitions = require(script.Parent.CosmeticDefinitions)

local CosmeticApplier = {}

local FOLDER_NAME = "VR_Cosmetics"

local GROUP_BY_PART = {
	Head = "Head",
	UpperTorso = "Torso",
	LowerTorso = "Hips",
	LeftUpperArm = "Arms",
	LeftLowerArm = "Arms",
	RightUpperArm = "Arms",
	RightLowerArm = "Arms",
	LeftHand = "Hands",
	RightHand = "Hands",
	LeftUpperLeg = "Legs",
	LeftLowerLeg = "Legs",
	RightUpperLeg = "Legs",
	RightLowerLeg = "Legs",
	LeftFoot = "Feet",
	RightFoot = "Feet",
}

local function getSkin(equipped)
	local id = equipped and equipped.Skins or "Rookie"
	return CosmeticDefinitions.Get("Skins", id) or CosmeticDefinitions.Get("Skins", "Rookie")
end

--- Liefert die effektive Akzentfarbe (Farbvariante überschreibt Skin-Akzent).
function CosmeticApplier.GetAccentColor(equipped): Color3
	local skin = getSkin(equipped)
	if equipped and equipped.Colors and equipped.Colors ~= "" then
		local variant = CosmeticDefinitions.Get("Colors", equipped.Colors)
		if variant then
			return variant.Color
		end
	end
	return skin.Accent
end

local function resolveColor(key, skin, accent): Color3
	if typeof(key) == "Color3" then
		return key
	elseif key == "Accent" then
		return accent
	elseif key == "Visor" then
		return skin.Visor or accent
	elseif key == "Primary" then
		return skin.Primary
	elseif key == "Secondary" then
		return skin.Secondary
	elseif key == "Dark" then
		return skin.Dark
	end
	return skin.Primary
end

local function makeShape(shape: string): BasePart
	if shape == "Wedge" then
		return Instance.new("WedgePart")
	end
	local part = Instance.new("Part")
	if shape == "Ball" then
		part.Shape = Enum.PartType.Ball
	elseif shape == "Cylinder" then
		part.Shape = Enum.PartType.Cylinder
	else
		part.Shape = Enum.PartType.Block
	end
	return part
end

--- Entfernt alle von diesem Modul erzeugten Objekte.
function CosmeticApplier.Clear(model: Model)
	local folder = model:FindFirstChild(FOLDER_NAME)
	if folder then
		folder:Destroy()
	end
	for _, descendant in model:GetDescendants() do
		if descendant:GetAttribute("VR_Cosmetic") then
			descendant:Destroy()
		end
	end
end

local function sequenceFromColors(a: Color3, b: Color3): ColorSequence
	return ColorSequence.new({ ColorSequenceKeypoint.new(0, a), ColorSequenceKeypoint.new(1, b) })
end

local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 60)),
	ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 200, 40)),
	ColorSequenceKeypoint.new(0.4, Color3.fromRGB(80, 255, 80)),
	ColorSequenceKeypoint.new(0.6, Color3.fromRGB(60, 200, 255)),
	ColorSequenceKeypoint.new(0.8, Color3.fromRGB(120, 80, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 60, 200)),
})
CosmeticApplier.Rainbow = RAINBOW

local function applyTrail(model: Model, folderParts: { Instance }, trailDef)
	local torso = model:FindFirstChild("UpperTorso")
	if not torso then
		return
	end
	local top = Instance.new("Attachment")
	top.Name = "VR_TrailTop"
	top.Position = Vector3.new(0, 0.55, 0.3)
	top:SetAttribute("VR_Cosmetic", true)
	top.Parent = torso
	local bottom = Instance.new("Attachment")
	bottom.Name = "VR_TrailBottom"
	bottom.Position = Vector3.new(0, -0.55, 0.3)
	bottom:SetAttribute("VR_Cosmetic", true)
	bottom.Parent = torso

	local trail = Instance.new("Trail")
	trail.Name = "VR_Trail"
	trail.Attachment0 = top
	trail.Attachment1 = bottom
	trail.Lifetime = trailDef.Lifetime or 0.4
	trail.MinLength = 0.1
	trail.FaceCamera = true
	trail.LightEmission = trailDef.LightEmission or 0.5
	trail.WidthScale = NumberSequence.new({
		NumberSequenceKeypoint.new(0, trailDef.Width or 1),
		NumberSequenceKeypoint.new(1, 0),
	})
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(1, 1),
	})
	if trailDef.Rainbow then
		trail.Color = RAINBOW
	else
		trail.Color = sequenceFromColors(trailDef.ColorA, trailDef.ColorB)
	end
	trail:SetAttribute("VR_Cosmetic", true)
	trail.Parent = torso
	table.insert(folderParts, trail)
end

local function applyEffect(model: Model, effectDef)
	local torso = model:FindFirstChild("UpperTorso")
	if not torso then
		return
	end
	local attachment = Instance.new("Attachment")
	attachment.Name = "VR_EffectAttachment"
	attachment:SetAttribute("VR_Cosmetic", true)
	attachment.Parent = torso

	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "VR_Effect"
	emitter.Rate = effectDef.Rate or 10
	emitter.Lifetime = NumberRange.new(0.6, 1.2)
	emitter.Speed = NumberRange.new(effectDef.Speed or 1, (effectDef.Speed or 1) * 1.5)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.LightEmission = effectDef.LightEmission or 0.5
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, effectDef.Size or 0.3),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	if effectDef.Rainbow then
		emitter.Color = RAINBOW
	else
		emitter.Color = ColorSequence.new(effectDef.Color)
	end
	if effectDef.Rise then
		emitter.Acceleration = Vector3.new(0, effectDef.Rise, 0)
	end
	emitter:SetAttribute("VR_Cosmetic", true)
	emitter.Parent = attachment
end

--- Wendet die komplette Kosmetik auf ein Rig an (ersetzt vorherige Kosmetik).
function CosmeticApplier.Apply(model: Model, equipped)
	CosmeticApplier.Clear(model)
	equipped = equipped or CosmeticDefinitions.DefaultEquipped

	local skin = getSkin(equipped)
	local accent = CosmeticApplier.GetAccentColor(equipped)
	local baseMaterial = skin.Material or Enum.Material.SmoothPlastic
	local materials = skin.Materials or {}

	for partName, group in GROUP_BY_PART do
		local part = model:FindFirstChild(partName)
		if part and part:IsA("BasePart") then
			part.Color = skin.Colors[group] or skin.Primary
			part.Material = materials[group] or baseMaterial
		end
	end

	local folder = Instance.new("Folder")
	folder.Name = FOLDER_NAME
	local created = {}

	for _, presetName in skin.Accessories or {} do
		local preset = CosmeticDefinitions.AccessoryPresets[presetName]
		if preset then
			for index, piece in preset do
				local attachTo = model:FindFirstChild(piece.Attach)
				if attachTo and attachTo:IsA("BasePart") then
					local part = makeShape(piece.Shape)
					part.Name = presetName .. "_" .. index
					part.Size = piece.Size
					part.Color = resolveColor(piece.Color, skin, accent)
					part.Material = piece.Material or baseMaterial
					part.Transparency = piece.Transparency or 0
					part.TopSurface = Enum.SurfaceType.Smooth
					part.BottomSurface = Enum.SurfaceType.Smooth
					part.Anchored = false
					part.CanCollide = false
					part.CanQuery = false
					part.CanTouch = false
					part.Massless = true
					part.CastShadow = false
					part.CFrame = attachTo.CFrame * piece.Offset
					part.CollisionGroup = attachTo.CollisionGroup

					local weld = Instance.new("Weld")
					weld.Part0 = attachTo
					weld.Part1 = part
					weld.C0 = piece.Offset
					weld.Parent = part

					part.Parent = folder
					table.insert(created, part)
				end
			end
		end
	end

	folder.Parent = model

	if equipped.Trails and equipped.Trails ~= "" then
		local trailDef = CosmeticDefinitions.Get("Trails", equipped.Trails)
		if trailDef then
			applyTrail(model, created, trailDef)
		end
	end

	if equipped.Effects and equipped.Effects ~= "" then
		local effectDef = CosmeticDefinitions.Get("Effects", equipped.Effects)
		if effectDef then
			applyEffect(model, effectDef)
		end
	end

	model:SetAttribute("AccentColor", accent)
	return created
end

return CosmeticApplier
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">CosmeticDefinitions</string>
          <string name="Source"><![CDATA[--[[
	CosmeticDefinitions  (ModuleScript)
	Pfad: ReplicatedStorage/Shared/CosmeticDefinitions

	Katalog aller kosmetischen Gegenstände. Alles wird ausschließlich aus
	Roblox-Standardteilen, Farben, Materialien, Trails und Partikeln gebaut –
	es werden keine externen Assets benötigt.

	WICHTIG: Kosmetik hat KEINEN Einfluss auf Hitbox, Geschwindigkeit oder
	Sprunghöhe. Accessoires sind Massless, CanCollide=false, CanQuery=false.

	Kategorien: Skins, Trails, Effects, Emotes, Victory, Colors
]]

local CosmeticDefinitions = {}

local rgb = Color3.fromRGB

CosmeticDefinitions.Categories = { "Skins", "Trails", "Effects", "Emotes", "Victory", "Colors" }

CosmeticDefinitions.CategoryNames = {
	Skins = "Skins",
	Trails = "Trails",
	Effects = "Effekte",
	Emotes = "Emotes",
	Victory = "Siegesanimationen",
	Colors = "Farbvarianten",
}

CosmeticDefinitions.Rarities = {
	Common = { Name = "Gewöhnlich", Color = rgb(160, 175, 200), Order = 1 },
	Rare = { Name = "Selten", Color = rgb(70, 150, 255), Order = 2 },
	Epic = { Name = "Episch", Color = rgb(180, 90, 255), Order = 3 },
	Legendary = { Name = "Legendär", Color = rgb(255, 190, 40), Order = 4 },
}

-- Wiederverwendbare Accessoire-Bausteine. Offsets sind relativ zum Mittelpunkt
-- des Körperteils (Blickrichtung des Rigs = -Z, Rücken = +Z).
-- Farbe: "Accent" | "Visor" | "Primary" | "Secondary" | "Dark" | Color3
local A = {}

A.Visor = {
	{ Attach = "Head", Shape = "Block", Size = Vector3.new(1.0, 0.38, 0.12), Offset = CFrame.new(0, 0.12, -0.66), Color = "Visor", Material = Enum.Material.Neon },
}
A.VisorWide = {
	{ Attach = "Head", Shape = "Block", Size = Vector3.new(1.18, 0.45, 0.12), Offset = CFrame.new(0, 0.1, -0.66), Color = "Visor", Material = Enum.Material.Neon },
}
A.Helmet = {
	{ Attach = "Head", Shape = "Block", Size = Vector3.new(1.38, 0.45, 1.38), Offset = CFrame.new(0, 0.5, 0), Color = "Primary" },
}
A.HelmetFin = {
	{ Attach = "Head", Shape = "Wedge", Size = Vector3.new(0.18, 0.55, 1.0), Offset = CFrame.new(0, 0.98, 0.1), Color = "Accent", Material = Enum.Material.Neon },
}
A.Antenna = {
	{ Attach = "Head", Shape = "Cylinder", Size = Vector3.new(1.1, 0.12, 0.12), Offset = CFrame.new(0.4, 1.15, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = "Dark" },
	{ Attach = "Head", Shape = "Ball", Size = Vector3.new(0.32, 0.32, 0.32), Offset = CFrame.new(0.4, 1.75, 0), Color = "Accent", Material = Enum.Material.Neon },
}
A.Goggles = {
	{ Attach = "Head", Shape = "Block", Size = Vector3.new(1.32, 0.16, 1.32), Offset = CFrame.new(0, 0.38, 0), Color = "Dark" },
	{ Attach = "Head", Shape = "Cylinder", Size = Vector3.new(0.2, 0.44, 0.44), Offset = CFrame.new(-0.28, 0.38, -0.66) * CFrame.Angles(0, math.rad(90), 0), Color = "Visor", Material = Enum.Material.Glass },
	{ Attach = "Head", Shape = "Cylinder", Size = Vector3.new(0.2, 0.44, 0.44), Offset = CFrame.new(0.28, 0.38, -0.66) * CFrame.Angles(0, math.rad(90), 0), Color = "Visor", Material = Enum.Material.Glass },
}
A.Mask = {
	{ Attach = "Head", Shape = "Block", Size = Vector3.new(1.05, 0.5, 0.12), Offset = CFrame.new(0, -0.3, -0.66), Color = "Dark" },
}
A.Horns = {
	{ Attach = "Head", Shape = "Wedge", Size = Vector3.new(0.22, 0.75, 0.4), Offset = CFrame.new(-0.48, 0.85, 0.05) * CFrame.Angles(0, 0, math.rad(18)), Color = "Accent", Material = Enum.Material.Neon },
	{ Attach = "Head", Shape = "Wedge", Size = Vector3.new(0.22, 0.75, 0.4), Offset = CFrame.new(0.48, 0.85, 0.05) * CFrame.Angles(0, 0, math.rad(-18)), Color = "Accent", Material = Enum.Material.Neon },
}
