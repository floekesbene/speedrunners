]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">Tutorial</string>
          <string name="Source"><![CDATA[--[[
	Tutorial  (ModuleScript)
	Pfad: ServerStorage/MapTemplates/Tutorial

	Bewegungs-Tutorial für den Trainingsmodus. Jede Station erklärt eine
	Mechanik per Schild. Kein Wettbewerb, keine Belohnungen.
]]

return function(B)
	B.CheckpointSpacing = 90

	B:Start(60)
	B:Sign(10, B.Y + 13, "WILLKOMMEN!", "A/D oder Pfeiltasten: laufen")
	B:Flat(40)
	B:Sign(B.X - 10, B.Y + 13, "SPRINGEN", "Leertaste / W – länger halten = höher")
	B:Climb(4, 24)
	B:Climb(6, 30)
	B:Gap(10, 0, 30)
	B:Sign(B.X - 15, B.Y + 13, "MOMENTUM", "Anlauf nehmen für weite Sprünge")
	B:Gap(20, 0, 40)
	B:Sign(B.X - 20, B.Y + 13, "SLIDEN", "Shift / S bei Tempo – unter Hindernissen durch")
	B:Flat(30)
	B:SlideTunnel(30)
	B:Flat(20)
	B:Sign(B.X + 10, B.Y + 34, "WALL-JUMP", "In der Luft gegen eine Wand springen")
	B:Flat(20)
	B:WallClimb(18, 14)
	B:Flat(30)
	B:Sign(B.X - 10, B.Y + 15, "GREIFHAKEN", "E / Maus halten zum Schwingen, loslassen zum Abspringen")
	B:Flat(20)
	B:GrappleGap(50, { AnchorHeight = 22 })
	B:GrappleGap(80, { Anchors = 2, AnchorHeight = 24 })
	B:Sign(B.X - 10, B.Y + 13, "AIR-DASH", "In der Luft Shift / S: kurzer Dash nach vorn")
	B:Flat(10)
	B:Gap(24, 0, 30)
	B:Sign(B.X - 10, B.Y + 13, "PADS", "Boost-Pads geben Tempo, Sprungpads bringen dich hoch")
	B:BoostStrip(60, 85)
	B:JumpPadUp(16, 30)
	B:Sign(B.X - 10, B.Y + 13, "POWER-UPS", "Box einsammeln, mit Q / F einsetzen")
	B:PickupRow(3, 30)
	B:Flat(20)
	B:Sign(B.X + 10, B.Y + 22, "TIMING", "Warte, bis die Barriere ausgeschaltet ist")
	B:TimedBarrier(40, { Period = 2.6, OnTime = 1.1 })
	B:Sign(B.X - 10, B.Y + 13, "GEFAHRENZONE", "Im Rennen jagt dich eine Energiewand – bleib vorn!")
	B:Flat(30)
	B:Finish(60)
	B:Decorate()
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">_Template</string>
          <string name="Source"><![CDATA[--[[
	_Template  (ModuleScript) – Vorlage für neue Maps
	Pfad: ServerStorage/MapTemplates/_Template

	So fügst du eine neue Strecke hinzu:
		1. Dieses Modul duplizieren und umbenennen (z.B. "DesertDash").
		2. In ReplicatedStorage/Shared/MapDefinitions einen Eintrag anlegen:
		      DesertDash = { Id = "DesertDash", Name = "Desert Dash", Template = "DesertDash",
		                     Difficulty = 2, Seed = 6606, Theme = { ... } }
		   und "DesertDash" in MapDefinitions.Order eintragen.
		3. Unten die Strecke mit Bausteinen beschreiben (siehe MapBuilder-Doku).

	Regeln für faire, spielbare Strecken:
		- Normale Sprunglücken ≤ 18 Studs, Stufen ≤ 6 Studs.
		- Greifhaken-Lücken 40–80 Studs, Anker ca. 22–26 Studs über dem Boden.
		- Alle ~140 Studs wird automatisch ein Checkpoint gesetzt.
		- Immer mit B:Start() beginnen und mit B:Finish() enden.
		- Zum Schluss B:Decorate() für den Hintergrund aufrufen.

	Diese Vorlage wird vom Spiel nicht geladen (kein Eintrag in MapDefinitions).
]]

return function(B)
	B:Start(60)
	B:Flat(40)
	B:Gap(B:D(12), 0, 30)
	B:Steps(3, 4, 12)
	B:PickupRow(3)
	B:SlideTunnel(30)
	B:Flat(20)
	B:GrappleGap(B:D(54), { AnchorHeight = 24 })
	B:Split({
		Length = 240,
		Depth = 28,
		Upper = function(b)
			b:Flat(10)
			b:GrappleGap(56, { Landing = 24 })
			b:BoostStrip(40, 85)
		end,
		Lower = function(b)
			b:Flat(40)
			b:Pit(32, { Pillars = 2, Landing = 30 })
			b:Flat(30)
		end,
	})
	B:WallClimb(18, 14)
	B:TimedBarrier(36, { Period = 2.4, OnTime = 1.0 })
	B:Flat(30)
	B:Finish(80)
	B:Decorate()
end
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="48">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
  </Item>
  <Item class="StarterGui" referent="49">
    <Properties>
      <string name="Name">StarterGui</string>
      <bool name="ResetPlayerGuiOnSpawn">false</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="50">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="EnableMouseLockOption">false</bool>
      <bool name="LoadCharacterAppearance">false</bool>
    </Properties>
    <Item class="StarterCharacterScripts" referent="51">
      <Properties>
        <string name="Name">StarterCharacterScripts</string>
      </Properties>
      <Item class="LocalScript" referent="52">
        <Properties>
          <string name="Name">Animate</string>
          <string name="Source"><![CDATA[--[[
	Animate  (LocalScript)
	Pfad: StarterPlayer/StarterCharacterScripts/Animate

	Absichtlich leer: Ein Script mit dem Namen "Animate" in
	StarterCharacterScripts ersetzt das Roblox-Standard-Animationsscript.
	Velocity Rush animiert alle Spielfiguren prozedural im
	AnimationController (StarterPlayerScripts/Client/Controllers).
]]
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="53">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="54">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="55">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">AnimationController</string>
              <string name="Source"><![CDATA[--[[
	AnimationController  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/Controllers/AnimationController

	Prozedurale Animationen ohne externe Animations-Assets. Jeder Client
	animiert ALLE Spielfiguren selbst, indem er Motor6D.Transform in
	RunService.PreSimulation setzt (offiziell empfohlener Zeitpunkt).

	Datenquellen:
		Lokale Figur: MovementController (sofort, ohne Latenz)
		Andere Figuren: Character-Attribut "MoveState" (vom Server repliziert)
		                und die replizierte Geschwindigkeit des Root-Parts
	Posen: Idle, Run, Air, Slide, Wall, Grapple, Dash, Stunned, Frozen (Startpose),
	       Emotes (Wave, Dance, Flex, Spin, Salute) und Siegesjubel.
	Übergänge werden pro Gelenk weich überblendet.

	Das Standard-"Animate"-Script wird durch StarterCharacterScripts/Animate
	(leer) ersetzt, damit keine Roblox-Animationen dazwischenfunken.

	API:
		:RegisterPreview(model, getPose)   Vorschau-Rigs (Shop) mitanimieren
		:UnregisterPreview(model)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local RunnerRig = require(Shared.RunnerRig)
local CosmeticDefinitions = require(Shared.CosmeticDefinitions)

local player = Players.LocalPlayer

local AnimationController = {}

local function A(x: number, y: number?, z: number?): CFrame
	return CFrame.Angles(x, y or 0, z or 0)
end

local POSES = {}

function POSES.Idle(t, _speed, _vy)
	local b = math.sin(t * 2.2) * 0.03
	return {
		Root = CFrame.new(0, b * 0.5, 0),
		Waist = A(b),
		LeftShoulder = A(0, 0, -0.08),
		RightShoulder = A(0, 0, 0.08),
		LeftElbow = A(0.15),
		RightElbow = A(0.15),
	}
end

function POSES.Run(_t, speed, _vy, phase)
	local k = math.clamp(speed / 44, 0.25, 1.3)
	local s, c = math.sin(phase), math.cos(phase)
	return {
		Root = CFrame.new(0, math.abs(c) * 0.18 * k - 0.05, 0) * A(-0.22 * k),
		Waist = A(-0.05 * k, s * 0.12 * k, 0),
		Neck = A(0.15 * k),
		LeftHip = A(s * 0.95 * k),
		RightHip = A(-s * 0.95 * k),
		LeftKnee = A(-(0.25 + 0.9 * math.max(0, c)) * k),
		RightKnee = A(-(0.25 + 0.9 * math.max(0, -c)) * k),
		LeftAnkle = A(0.2 * s * k),
		RightAnkle = A(-0.2 * s * k),
		LeftShoulder = A(-s * 0.9 * k, 0, -0.1),
		RightShoulder = A(s * 0.9 * k, 0, 0.1),
		LeftElbow = A(0.5 + 0.4 * k),
		RightElbow = A(0.5 + 0.4 * k),
	}
end

function POSES.Air(_t, _speed, vy)
	local rising = vy > 0
	return {
		Root = A(if rising then -0.12 else 0.06),
		LeftHip = A(0.7),
		LeftKnee = A(-1.0),
		RightHip = A(-0.35),
		RightKnee = A(-0.5),
		LeftShoulder = A(0.4, 0, -0.5),
		RightShoulder = A(-0.3, 0, 0.6),
		LeftElbow = A(0.6),
		RightElbow = A(0.5),
	}
end

function POSES.Slide()
	return {
		Root = CFrame.new(0, -1.65, 0.3) * A(1.15),
		Waist = A(-0.25),
		Neck = A(-0.55),
		LeftHip = A(0.15),
		LeftKnee = A(-0.2),
		RightHip = A(0.55),
		RightKnee = A(-1.3),
		LeftShoulder = A(-0.6, 0, -0.5),
		RightShoulder = A(-0.9, 0, 0.4),
		LeftElbow = A(0.4),
		RightElbow = A(0.3),
	}
end

function POSES.Wall()
	return {
		Root = A(0.1),
		LeftShoulder = A(1.6, 0, -0.2),
		RightShoulder = A(1.3, 0, 0.2),
		LeftElbow = A(0.3),
		RightElbow = A(0.5),
		LeftHip = A(0.5),
		LeftKnee = A(-0.8),
		RightHip = A(0.1),
		RightKnee = A(-0.4),
	}
end

function POSES.Grapple(_t, speed, _vy, _phase, signedSpeed)
	local tilt = math.clamp((signedSpeed or speed) / 80, -0.4, 0.6)
	return {
		Root = A(-tilt),
		RightShoulder = A(2.7, 0, 0.15),
		RightElbow = A(0.1),
		LeftShoulder = A(0.2, 0, -0.5),
		LeftElbow = A(0.6),
		LeftHip = A(0.45),
		LeftKnee = A(-0.7),
		RightHip = A(0.2),
		RightKnee = A(-0.4),
	}
end

function POSES.Dash()
	return {
		Root = A(-0.65),
		LeftShoulder = A(-1.0, 0, -0.3),
		RightShoulder = A(-1.0, 0, 0.3),
		LeftHip = A(-0.3),
		RightHip = A(0.4),
		RightKnee = A(-0.9),
	}
end

function POSES.Stunned(t)
	local shake = math.sin(t * 40) * 0.06
	return {
		Root = CFrame.new(shake, -0.2, 0) * A(0.15),
		Neck = A(0.3, math.sin(t * 6) * 0.4, 0),
		LeftShoulder = A(0, 0, -0.4),
		RightShoulder = A(0, 0, 0.4),
		LeftKnee = A(-0.4),
		RightKnee = A(-0.4),
	}
end

function POSES.Frozen()
	-- Startpose ("auf die Plätze")
	return {
		Root = CFrame.new(0, -0.45, 0) * A(-0.35),
		LeftHip = A(0.7),
		LeftKnee = A(-1.0),
		RightHip = A(-0.2),
		RightKnee = A(-0.5),
		LeftShoulder = A(-0.5, 0, -0.1),
		RightShoulder = A(0.6, 0, 0.1),
		LeftElbow = A(0.6),
		RightElbow = A(0.6),
	}
end

local EMOTES = {}

function EMOTES.Wave(t)
	return {
		RightShoulder = A(0.2, 0, 2.6 + math.sin(t * 9) * 0.3),
		RightElbow = A(0, 0, 0.3),
		LeftShoulder = A(0, 0, -0.1),
	}
end

function EMOTES.Dance(t)
	local s = math.sin(t * 6)
	return {
		Root = CFrame.new(0, math.abs(s) * 0.3, 0) * A(0, math.sin(t * 3) * 0.4, 0),
		Waist = A(0, 0, s * 0.15),
		LeftShoulder = A(0, 0, -(1.2 + s * 0.8)),
		RightShoulder = A(0, 0, 1.2 - s * 0.8),
		LeftElbow = A(0.4),
		RightElbow = A(0.4),
		LeftHip = A(math.max(0, s) * 0.5),
		RightHip = A(math.max(0, -s) * 0.5),
		LeftKnee = A(-math.max(0, s) * 0.8),
		RightKnee = A(-math.max(0, -s) * 0.8),
	}
end

function EMOTES.Flex(t)
	local pump = math.sin(t * 5) * 0.1
	return {
		Root = CFrame.new(0, -0.2, 0),
		LeftShoulder = A(0, 0, -1.5 - pump),
		RightShoulder = A(0, 0, 1.5 + pump),
		LeftElbow = A(0, 0, -1.64),
		RightElbow = A(0, 0, 1.64),
		LeftHip = A(0, 0, -0.15),
		RightHip = A(0, 0, 0.15),
	}
end

function EMOTES.Spin(t)
	return {
		Root = A(0, (t * 10) % (math.pi * 2), 0),
		LeftShoulder = A(0, 0, -1.4),
		RightShoulder = A(0, 0, 1.4),
	}
end

function EMOTES.Salute()
	return {
		RightShoulder = A(2.1, 0, 0.6),
		RightElbow = A(2.0),
		Neck = A(-0.05),
	}
end

local function victoryPose(t)
	return {
		Root = CFrame.new(0, math.abs(math.sin(t * 5)) * 0.6, 0),
		LeftShoulder = A(0, 0, -2.8),
		RightShoulder = A(0, 0, 2.8),
		LeftElbow = A(0.3),
		RightElbow = A(0.3),
		Neck = A(-0.25),
	}
end

local function emoteDuration(id: string): number
	local def = CosmeticDefinitions.Get("Emotes", id)
	return def and def.Duration or 2.5
end

function AnimationController:Init(ctx)
	self.Ctx = ctx
	self.Rigs = setmetatable({}, { __mode = "k" })
	self.Previews = {}
end

function AnimationController:Start()
	RunService.PreSimulation:Connect(function(dt)
		local ok, err = pcall(self._step, self, dt)
		if not ok then
			warn("[AnimationController] " .. tostring(err))
		end
	end)
end

function AnimationController:RegisterPreview(model: Model, getPose: () -> string?)
	self.Previews[model] = getPose
end

function AnimationController:UnregisterPreview(model: Model)
	self.Previews[model] = nil
	self.Rigs[model] = nil
end

function AnimationController:_rig(model: Model)
	local rig = self.Rigs[model]
	if rig and rig.Motors.Root and rig.Motors.Root.Parent then
		return rig
	end
	local motors = {}
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("Motor6D") then
			motors[descendant.Name] = descendant
		end
	end
	if not motors.Root then
		return nil
	end
	rig = { Motors = motors, Current = {}, Phase = 0 }
	self.Rigs[model] = rig
	return rig
end

function AnimationController:_apply(rig, pose, dt: number)
	local alpha = 1 - math.exp(-16 * dt)
	for _, name in RunnerRig.Joints do
		local motor = rig.Motors[name]
		if motor then
			local target = pose[name] or CFrame.identity
			local current = (rig.Current[name] or CFrame.identity):Lerp(target, alpha)
			rig.Current[name] = current
			motor.Transform = current
		end
	end
end

function AnimationController:_poseFor(character: Model, state: string, velocity: Vector3, rig, t: number, dt: number, facing: number)
	local serverNow = workspace:GetServerTimeNow()
	local speed = math.abs(velocity.X)
	rig.Phase += dt * (2 + speed * 0.38)

	local victory = character:GetAttribute("Victory")
	if type(victory) == "string" and victory ~= "" then
		return victoryPose(t)
	end
	local emote = character:GetAttribute("Emote")
	if type(emote) == "string" and emote ~= "" and (state == "Idle" or state == "Frozen") then
		local startedAt = character:GetAttribute("EmoteAt") or 0
		local fn = EMOTES[emote]
		if fn and serverNow - startedAt < emoteDuration(emote) then
			return fn(serverNow - startedAt)
		end
	end
	if (character:GetAttribute("StunnedUntil") or 0) > serverNow then
		return POSES.Stunned(t)
	end
	local fn = POSES[state] or POSES.Idle
	if state == "Run" and speed < 2 then
		fn = POSES.Idle
	end
	return fn(t, speed, velocity.Y, rig.Phase, velocity.X * facing)
end

function AnimationController:_step(dt: number)
	local camera = workspace.CurrentCamera
	local cameraPosition = if camera then camera.CFrame.Position else Vector3.zero
	local t = os.clock()
	local movement = self.Ctx.MovementController

	for _, other in Players:GetPlayers() do
		local character = other.Character
		if character and character.Parent then
			local root = character:FindFirstChild("HumanoidRootPart")
			if root and (root.Position - cameraPosition).Magnitude < 320 then
				local rig = self:_rig(character)
				if rig then
					local state, velocity, facing
					if other == player then
						state = movement:GetState()
						velocity = movement.Velocity or root.AssemblyLinearVelocity
						facing = movement:GetFacing()
					else
						state = character:GetAttribute("MoveState") or "Idle"
						velocity = root.AssemblyLinearVelocity
						facing = character:GetAttribute("Facing") or 1
						if character:GetAttribute("Frozen") then
							state = "Frozen"
						end
					end
					self:_apply(rig, self:_poseFor(character, state, velocity, rig, t, dt, facing), dt)
				end
			end
		end
	end

	for model, getPose in self.Previews do
		if model.Parent then
			local rig = self:_rig(model)
			if rig then
				local mode = getPose() or "Idle"
				local pose
				if EMOTES[mode] then
					pose = EMOTES[mode](t)
				elseif mode == "Victory" then
					pose = victoryPose(t)
				else
					pose = (POSES[mode] or POSES.Idle)(t, 30, 0, t * 12, 30)
				end
				self:_apply(rig, pose, dt)
			end
		else
			self.Previews[model] = nil
		end
	end
end

return AnimationController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">AudioController</string>
              <string name="Source"><![CDATA[--[[
	AudioController  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/Controllers/AudioController

	Spielt Soundeffekte und optionale Musik. Standardmäßig werden nur in Roblox
	eingebaute Sounddateien (rbxasset://sounds/...) genutzt, siehe Config.Audio.
	Fehlt ein Sound, läuft das Spiel normal weiter (rein optional).

	Lautstärken kommen aus den Spieler-Einstellungen (SfxVolume, MusicVolume).

	API:
		:Play(name, options?)   options: { Volume, Pitch, Position }
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local player = Players.LocalPlayer

local AudioController = {}

function AudioController:Init(ctx)
	self.Ctx = ctx
	self.Templates = {}
	self.LastPlayed = {}

	self.SfxGroup = Instance.new("SoundGroup")
	self.SfxGroup.Name = "VR_SFX"
	self.SfxGroup.Parent = SoundService
	self.MusicGroup = Instance.new("SoundGroup")
	self.MusicGroup.Name = "VR_Music"
	self.MusicGroup.Parent = SoundService

	for name, def in Config.Audio.Sounds do
		local sound = Instance.new("Sound")
		sound.Name = "VR_" .. name
		sound.SoundId = def.Id
		sound.Volume = def.Volume or 0.5
		sound.PlaybackSpeed = def.Pitch or 1
		sound.SoundGroup = self.SfxGroup
		sound.Parent = SoundService
		self.Templates[name] = sound
	end

	if Config.Audio.MusicId ~= "" then
		local music = Instance.new("Sound")
		music.Name = "VR_MusicTrack"
		music.SoundId = Config.Audio.MusicId
		music.Looped = true
		music.Volume = 0.4
		music.SoundGroup = self.MusicGroup
		music.Parent = SoundService
		self.Music = music
	end
end

function AudioController:Start()
	local state = self.Ctx.ClientState
	local function applyVolumes(settings)
		self.SfxGroup.Volume = settings.SfxVolume or 0.8
		self.MusicGroup.Volume = settings.MusicVolume or 0.5
	end
	applyVolumes(state:GetSettings())
	state.SettingsChanged:Connect(applyVolumes)
	if self.Music then
		self.Music:Play()
	end

	local movement = self.Ctx.MovementController
	movement.Jumped:Connect(function(kind)
		if kind == "WallJump" then
			self:Play("WallJump")
		elseif kind == "Pad" then
			self:Play("Boost", { Pitch = 1.2 })
		else
			self:Play("Jump")
		end
	end)
	movement.Landed:Connect(function(impact)
		self:Play("Land", { Volume = math.clamp(impact / 120, 0.2, 0.7) })
	end)
	movement.SlideStarted:Connect(function()
		self:Play("Slide")
	end)
	movement.DashStarted:Connect(function()
		self:Play("Dash")
	end)
	movement.GrappleStarted:Connect(function()
		self:Play("Grapple")
	end)
	movement.BoostPad:Connect(function()
		self:Play("Boost")
	end)

	state:On("ItemPickup", function()
		self:Play("Pickup")
	end)
	state:On("PowerUpUsed", function(payload)
		if payload.UserId == player.UserId then
			self:Play("PowerUp")
		end
	end)
	state:On("RacerEliminated", function(payload)
		self:Play("Eliminated", { Volume = if payload.UserId == player.UserId then 0.8 else 0.35 })
	end)
	state:On("RacerRespawn", function(payload)
		if payload.UserId == player.UserId then
			self:Play("Splash", { Pitch = 1.4 })
		end
	end)
	state:On("MatchResults", function(payload)
		if payload.WinnerUserId == player.UserId then
			self:Play("Victory")
		end
	end)
end

function AudioController:Play(name: string, options)
	local template = self.Templates[name]
	if not template then
		return
	end
	-- Gleichen Sound nicht öfter als alle 50 ms starten
	local now = os.clock()
	if self.LastPlayed[name] and now - self.LastPlayed[name] < 0.05 then
		return
	end
	self.LastPlayed[name] = now
	local sound = template:Clone()
	if options then
		if options.Volume then
			sound.Volume = options.Volume
		end
		if options.Pitch then
			sound.PlaybackSpeed = options.Pitch
		end
	end
	sound.Parent = SoundService
	sound:Play()
	sound.Ended:Once(function()
		sound:Destroy()
	end)
	task.delay(6, function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
end

return AudioController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[--[[
	CameraController  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/Controllers/CameraController

	Seitliche 2.5D-Kamera (Scriptable):
		- Blick entlang -Z auf die Spielebene (Z = 0), leicht von oben
		- Look-Ahead in Bewegungsrichtung (geglättet)
		- vertikale Totzone gegen Ruckeln bei Sprüngen, schnelles Nachführen beim Fallen
		- Zoom und Sichtfeld wachsen mit der Geschwindigkeit
		- im Rennen leichter Versatz Richtung Führendem, damit er sichtbar bleibt
		- Zuschauermodus (anderen Spieler verfolgen)
		- Kamerawackeln (abschaltbar in den Einstellungen)

	API:
		:Shake(intensity)
		:SetSpectate(player?)
		:GetSpectate() -> Player?
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local CAM = Config.Camera
local player = Players.LocalPlayer

local CameraController = {}

function CameraController:Init(ctx)
	self.Ctx = ctx
	self.ShakeAmount = 0
	self.Spectate = nil
	self.Focus = nil
	self.FocusY = 0
	self.LookAhead = 0
	self.Distance = CAM.Distance
end

function CameraController:Start()
	RunService:BindToRenderStep("VR_Camera", Enum.RenderPriority.Camera.Value + 1, function(dt)
		self:_update(dt)
	end)
	self.Ctx.ClientState:On("Teleported", function()
		self.Focus = nil
	end)
end

function CameraController:Shake(intensity: number)
	if self.Ctx.ClientState:GetSetting("CameraShake") == false then
		return
	end
	self.ShakeAmount = math.max(self.ShakeAmount, intensity)
end

function CameraController:SetSpectate(target: Player?)
	if target == player then
		target = nil
	end
	self.Spectate = target
	self.Focus = nil
end

function CameraController:GetSpectate(): Player?
	return self.Spectate
end

function CameraController:_targetRoot(): BasePart?
	local target = self.Spectate
	if target and target.Parent and target.Character then
		local root = target.Character:FindFirstChild("HumanoidRootPart")
		if root then
			return root
		end
	end
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") or nil
end

function CameraController:_leaderBias(position: Vector3): number
	local state = self.Ctx.ClientState
	if self.Spectate or not state:IsInRace() or state:GetPhase() ~= "Racing" then
		return 0
	end
	for _, folder in state.Racers:GetChildren() do
		if folder:GetAttribute("Placement") == 1 and folder:GetAttribute("Status") == "Racing" then
			local leader = Players:GetPlayerByUserId(folder:GetAttribute("UserId") or 0)
			if leader and leader ~= player and leader.Character then
				local root = leader.Character:FindFirstChild("HumanoidRootPart")
				if root then
					local ahead = root.Position.X - position.X
					if ahead > 0 and ahead < 90 then
						return math.clamp(ahead * CAM.LeaderBias, 0, CAM.MaxLeaderBias)
					end
				end
			end
			break
		end
	end
	return 0
end

function CameraController:_update(dt: number)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	if camera.CameraType ~= Enum.CameraType.Scriptable then
		camera.CameraType = Enum.CameraType.Scriptable
	end
	local root = self:_targetRoot()
	if not root then
		return
	end
	local position = root.Position
	local velocity = root.AssemblyLinearVelocity
	local movement = self.Ctx.MovementController
	if not self.Spectate and movement.Velocity then
		velocity = movement.Velocity
	end

	if not self.Focus or math.abs(position.X - self.Focus.X) > CAM.SnapDistance or math.abs(position.Y - self.FocusY) > CAM.SnapDistance then
		self.FocusY = position.Y
		self.LookAhead = 0
		self.Focus = Vector3.new(position.X, position.Y + CAM.FocusHeight, 0)
	end

	local desiredLook = math.clamp(velocity.X * CAM.LookAheadFactor, -CAM.MaxLookAhead, CAM.MaxLookAhead)
	desiredLook += self:_leaderBias(position)
	self.LookAhead = Util.Damp(self.LookAhead, desiredLook, 3, dt)

	local dy = position.Y - self.FocusY
	if math.abs(dy) > CAM.VerticalDeadZone then
		self.FocusY = Util.Damp(self.FocusY, position.Y - Util.Sign(dy) * CAM.VerticalDeadZone, CAM.VerticalSharpness, dt)
	end
	if velocity.Y < -60 then
		self.FocusY = Util.Damp(self.FocusY, position.Y, 10, dt)
	end

	local focusX = Util.Damp(self.Focus.X, position.X + self.LookAhead, CAM.FollowSharpness, dt)
	local focus = Vector3.new(focusX, self.FocusY + CAM.FocusHeight, Config.World.PlaneZ)
	self.Focus = focus

	local speed = math.abs(velocity.X)
	local extra = math.clamp((speed - Config.Movement.MaxRunSpeed) * CAM.SpeedZoom, 0, CAM.MaxExtraDistance)
	self.Distance = Util.Damp(self.Distance, CAM.Distance + extra, 2, dt)

	local shake = Vector3.zero
	if self.ShakeAmount > 0 then
		self.ShakeAmount = math.max(0, self.ShakeAmount - dt * 2.5)
		local strength = self.ShakeAmount * self.ShakeAmount * 1.4
		shake = Vector3.new((math.random() - 0.5) * strength, (math.random() - 0.5) * strength, 0)
	end

	local cameraPosition = focus + Vector3.new(0, CAM.HeightOffset, self.Distance) + shake
	camera.CFrame = CFrame.lookAt(cameraPosition, focus + shake * 0.5)
	local targetFov = CAM.FieldOfView + math.clamp((speed - Config.Movement.MaxRunSpeed) * 0.12, 0, 10)
	camera.FieldOfView = Util.Damp(camera.FieldOfView, targetFov, 4, dt)
end

return CameraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">ClientState</string>
              <string name="Source"><![CDATA[--[[
	ClientState  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/Controllers/ClientState

	Zentrale Datenquelle des Clients:
		- Profil-Schnappschuss vom Server (nur lesend; Änderungen nur über Remotes)
		- Zugriff auf ReplicatedStorage/GameState
		- Verteilung der Server-Events (GameEvent) an beliebig viele Listener

	API:
		ClientState.Profile                   (table | nil)
		ClientState.ProfileChanged            (Signal: profile)
		ClientState:On(eventName, fn)         -> Connection
		ClientState:GetPhase() -> string
		ClientState:IsInRace() -> boolean
		ClientState:GetPracticeCourse() -> string
		ClientState:GetRegionDefinition() -> MapDefinition
		ClientState:GetSetting(key) -> any
		ClientState:SaveSettings(changes)
		ClientState.SettingsChanged           (Signal: settings)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared.Signal)
local Remotes = require(Shared.Remotes)
local MapDefinitions = require(Shared.MapDefinitions)

local player = Players.LocalPlayer

local ClientState = {}
ClientState.Profile = nil
ClientState.ProfileChanged = Signal.new()
ClientState.SettingsChanged = Signal.new()
ClientState.GameState = ReplicatedStorage:WaitForChild("GameState")
ClientState.Racers = ClientState.GameState:WaitForChild("Racers")

local events = {}

local DEFAULT_SETTINGS = {
	MusicVolume = 0.5,
	SfxVolume = 0.8,
	CameraShake = true,
	GamepadSensitivity = 1,
	TouchControls = true,
	AutoRequeue = true,
	ReducedEffects = false,
}

function ClientState:Init(_ctx)
	Remotes.GameEvent.OnClientEvent:Connect(function(name, payload)
		local signal = events[name]
		if signal then
			signal:Fire(payload or {})
		end
	end)
	Remotes.ProfileUpdate.OnClientEvent:Connect(function(snapshot)
		self:_setProfile(snapshot)
	end)
	task.spawn(function()
		for _ = 1, 5 do
			local ok, snapshot = pcall(function()
				return Remotes.GetProfile:InvokeServer()
			end)
			if ok and snapshot then
				if not self.Profile then
					self:_setProfile(snapshot)
				end
				return
			end
			task.wait(2)
		end
	end)
end

function ClientState:_setProfile(snapshot)
	if type(snapshot) ~= "table" then
		return
	end
	self.Profile = snapshot
	self.ProfileChanged:Fire(snapshot)
	self.SettingsChanged:Fire(self:GetSettings())
end

--- Registriert einen Listener für ein Server-Event (GameEvent).
function ClientState:On(name: string, fn: (any) -> ())
	local signal = events[name]
	if not signal then
		signal = Signal.new()
		events[name] = signal
	end
	return signal:Connect(fn)
end

function ClientState:GetPhase(): string
	return self.GameState:GetAttribute("Phase") or "Waiting"
end

function ClientState:IsInRace(): boolean
	return player:GetAttribute("InRace") == true
end

function ClientState:GetPracticeCourse(): string
	return player:GetAttribute("PracticeCourse") or ""
end

--- Map-Definition der Region, in der sich der lokale Spieler befindet.
function ClientState:GetRegionDefinition()
	if self:IsInRace() then
		local mapId = self.GameState:GetAttribute("MapId")
		local definition = mapId and MapDefinitions.Get(mapId)
		if definition then
			return definition
		end
	end
	local course = self:GetPracticeCourse()
	if course ~= "" then
		local definition = MapDefinitions.GetAny(course)
		if definition then
			return definition
		end
	end
	return MapDefinitions.Lobby
end

function ClientState:GetSettings()
	local settings = table.clone(DEFAULT_SETTINGS)
	if self.Profile and self.Profile.Settings then
		for key, value in self.Profile.Settings do
			settings[key] = value
		end
	end
	return settings
end

function ClientState:GetSetting(key: string)
	return self:GetSettings()[key]
end

local pendingSave = nil

--- Übernimmt Einstellungen lokal sofort und speichert sie gebündelt auf dem Server.
function ClientState:SaveSettings(changes)
	if self.Profile then
		self.Profile.Settings = self.Profile.Settings or {}
		for key, value in changes do
			self.Profile.Settings[key] = value
		end
	end
	self.SettingsChanged:Fire(self:GetSettings())
	if pendingSave then
		return
	end
	pendingSave = true
	task.delay(1.5, function()
		pendingSave = nil
		Remotes.SaveSettings:FireServer(self:GetSettings())
	end)
end

return ClientState
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">EffectsController</string>
              <string name="Source"><![CDATA[--[[
	EffectsController  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/Controllers/EffectsController

	Alle visuellen Effekte – komplett ohne externe Assets (Parts, Beams,
	ParticleEmitter mit Standardtextur, Explosion, TweenService):

		- Beleuchtung/Atmosphäre je Region (Lobby, Strecke, Training)
		- Greifhaken-Seile aller Spieler + Zielmarkierung für den eigenen Haken
		- Gefahrenwand (Gefahrenring) mit Tönung der Gefahrenzone
		- rotierende Item-Boxen, blinkende Zeit-Barrieren
		- Status: Schild, Freeze, Betäubung, Boost
		- Einmal-Effekte: Landen, Pads, Pickup, Power-ups, Ausscheiden,
		  Respawn, Siegesanimationen (Konfetti, Feuerwerk, Blitz, Goldregen)

	"Reduzierte Effekte" in den Einstellungen verringert Partikelmengen.
]]

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local ItemDefinitions = require(Shared.ItemDefinitions)
local CosmeticApplier = require(Shared.CosmeticApplier)

local player = Players.LocalPlayer
local rgb = Color3.fromRGB

local EffectsController = {}

------------------------------------------------------------------------
-- Hilfen
------------------------------------------------------------------------

local function fxPart(props): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = props.Material or Enum.Material.Neon
	part.Color = props.Color or Color3.new(1, 1, 1)
	part.Size = props.Size or Vector3.one
	part.Transparency = props.Transparency or 0
	if props.Shape then
		part.Shape = props.Shape
	end
	part.CFrame = props.CFrame or CFrame.new()
	part.Name = props.Name or "FX"
	part.Parent = props.Parent
	return part
end

function EffectsController:_reduced(): boolean
	return self.Ctx.ClientState:GetSetting("ReducedEffects") == true
end

--- Partikelstoß an einer Weltposition.
function EffectsController:Burst(position: Vector3, color, count: number, options)
	options = options or {}
	if self:_reduced() then
		count = math.ceil(count * 0.35)
	end
	local attachment = Instance.new("Attachment")
	attachment.Position = position
	attachment.Parent = workspace.Terrain
	local emitter = Instance.new("ParticleEmitter")
	emitter.Enabled = false
	emitter.Lifetime = NumberRange.new(options.LifeMin or 0.4, options.LifeMax or 0.9)
	emitter.Speed = NumberRange.new(options.SpeedMin or 6, options.SpeedMax or 16)
	emitter.SpreadAngle = options.Spread or Vector2.new(180, 180)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, options.Size or 0.6),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(1, 1),
	})
	if typeof(color) == "ColorSequence" then
		emitter.Color = color
	else
		emitter.Color = ColorSequence.new(color)
	end
	emitter.LightEmission = options.LightEmission or 0.8
	emitter.Acceleration = options.Acceleration or Vector3.zero
	emitter.Drag = options.Drag or 2
	emitter.EmissionDirection = options.Direction or Enum.NormalId.Top
	emitter.Parent = attachment
	emitter:Emit(count)
	Debris:AddItem(attachment, (options.LifeMax or 0.9) + 0.5)
end

--- Sich ausdehnender Ring (z.B. Freeze Burst).
function EffectsController:Ring(position: Vector3, color: Color3, radius: number, duration: number)
	local ring = fxPart({
		Name = "Ring",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 2, 2),
		CFrame = CFrame.new(position) * CFrame.Angles(0, math.rad(90), 0),
		Color = color,
		Transparency = 0.2,
		Parent = self.Folder,
	})
	local tween = TweenService:Create(ring, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.4, radius * 2, radius * 2),
		Transparency = 1,
	})
	tween:Play()
	Debris:AddItem(ring, duration + 0.1)
end

------------------------------------------------------------------------
-- Init / Start
------------------------------------------------------------------------

function EffectsController:Init(ctx)
	self.Ctx = ctx
	self.Folder = Instance.new("Folder")
	self.Folder.Name = "VR_ClientFX"
	self.Folder.Parent = workspace
	self.Ropes = {}
	self.Status = {}
	self.ZoneVisualX = nil
	self.CurrentTheme = nil

	self.Atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	self.Atmosphere.Parent = Lighting
	self.Bloom = Instance.new("BloomEffect")
	self.Bloom.Name = "VR_Bloom"
	self.Bloom.Parent = Lighting
	self.Color = Instance.new("ColorCorrectionEffect")
	self.Color.Name = "VR_Color"
	self.Color.Parent = Lighting

	-- Zielmarkierung für den Greifhaken
	local marker = Instance.new("BillboardGui")
	marker.Name = "VR_GrappleTarget"
	marker.Size = UDim2.fromOffset(46, 46)
	marker.AlwaysOnTop = true
	marker.LightInfluence = 0
	marker.Enabled = false
	local ring = Instance.new("Frame")
	ring.AnchorPoint = Vector2.new(0.5, 0.5)
	ring.Position = UDim2.fromScale(0.5, 0.5)
	ring.Size = UDim2.fromScale(1, 1)
	ring.BackgroundTransparency = 1
	ring.Parent = marker
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = ring
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = rgb(255, 255, 255)
	stroke.Parent = ring
	marker.Parent = player:WaitForChild("PlayerGui")
	self.Marker = marker
	self.MarkerRing = ring

	-- Gefahrenwand
	self.ZoneWall = fxPart({
		Name = "DangerWall",
		Size = Vector3.new(3, 1400, 180),
		Color = rgb(255, 40, 70),
		Transparency = 1,
		Parent = self.Folder,
	})
	self.ZoneTint = fxPart({
		Name = "DangerTint",
		Size = Vector3.new(4000, 1400, 0.2),
		Color = rgb(255, 30, 60),
		Material = Enum.Material.SmoothPlastic,
		Transparency = 1,
		Parent = self.Folder,
	})
end

function EffectsController:Start()
	local state = self.Ctx.ClientState
	local movement = self.Ctx.MovementController
	local camera = self.Ctx.CameraController

	-- Beleuchtung je Region
	local function refreshTheme()
		self:_applyTheme(state:GetRegionDefinition())
	end
	player:GetAttributeChangedSignal("InRace"):Connect(refreshTheme)
	player:GetAttributeChangedSignal("PracticeCourse"):Connect(refreshTheme)
	state.GameState:GetAttributeChangedSignal("MapId"):Connect(refreshTheme)
	refreshTheme()

	-- Bewegungs-Effekte (lokal)
	movement.Landed:Connect(function(impact, position)
		self:Burst(position, rgb(210, 210, 220), math.clamp(math.floor(impact / 8), 4, 16), {
			SpeedMin = 4,
			SpeedMax = 10,
			Size = 0.8,
			LightEmission = 0,
			Spread = Vector2.new(70, 10),
		})
		if impact > 90 then
			camera:Shake(0.6)
		end
	end)
	movement.Jumped:Connect(function(kind)
		local root = self:_localRoot()
		if root and (kind == "WallJump" or kind == "Pad") then
			self:Burst(root.Position, if kind == "Pad" then rgb(80, 255, 140) else rgb(230, 230, 255), 10, { SpeedMax = 12 })
		end
	end)
	movement.BoostPad:Connect(function(position)
		self:Burst(position, rgb(255, 180, 40), 8, { SpeedMax = 14 })
		camera:Shake(0.3)
	end)
	movement.DashStarted:Connect(function()
		local root = self:_localRoot()
		if root then
			self:Burst(root.Position, rgb(200, 230, 255), 10, { SpeedMax = 18, Size = 0.5 })
		end
	end)

	-- Server-Events
	state:On("ItemPickup", function(payload)
		local item = ItemDefinitions.Get(payload.ItemId)
		self:Burst(payload.Position, if item then item.Color else rgb(255, 255, 255), 18, { SpeedMax = 18 })
	end)
	state:On("PowerUpUsed", function(payload)
		self:_onPowerUp(payload)
	end)
	state:On("ShieldBlocked", function(payload)
		self:Burst(payload.Position, rgb(120, 210, 255), 24, { SpeedMin = 10, SpeedMax = 22 })
	end)
	state:On("StatusApplied", function(payload)
		local color = if payload.Kind == "Slowed" then rgb(170, 230, 255) else rgb(255, 230, 80)
		self:Burst(payload.Position, color, 14)
		if payload.UserId == player.UserId then
			camera:Shake(0.5)
		end
	end)
	state:On("RacerEliminated", function(payload)
		if payload.Position then
			local explosion = Instance.new("Explosion")
			explosion.BlastPressure = 0
			explosion.BlastRadius = 6
			explosion.DestroyJointPercent = 0
			explosion.ExplosionType = Enum.ExplosionType.NoCraters
			explosion.Position = payload.Position
			explosion.Parent = self.Folder
			self:Burst(payload.Position, rgb(255, 60, 80), 30, { SpeedMin = 12, SpeedMax = 30, Size = 0.9 })
			if payload.UserId == player.UserId then
				camera:Shake(1.2)
			end
		end
	end)
	state:On("RacerRespawn", function(payload)
		if payload.From then
			self:Burst(payload.From, rgb(240, 240, 255), 16, { Size = 1, LightEmission = 0.2 })
		end
		if payload.To then
			self:Burst(payload.To, rgb(120, 220, 255), 12)
		end
	end)
	state:On("MatchResults", function(payload)
		local winner = Players:GetPlayerByUserId(payload.WinnerUserId or 0)
		if winner and winner.Character then
			local root = winner.Character:FindFirstChild("HumanoidRootPart")
			if root then
				self:_victory(winner.Character:GetAttribute("Victory") or "Default", root)
			end
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		local ok, err = pcall(self._update, self, dt)
		if not ok then
			warn("[EffectsController] " .. tostring(err))
		end
	end)
end

function EffectsController:_localRoot(): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") or nil
end

------------------------------------------------------------------------
-- Beleuchtung
------------------------------------------------------------------------

function EffectsController:_applyTheme(definition)
	if not definition or self.CurrentTheme == definition.Id then
		return
	end
	self.CurrentTheme = definition.Id
	local light = definition.Theme.Lighting
	local info = TweenInfo.new(1.2, Enum.EasingStyle.Sine)
	TweenService:Create(Lighting, info, {
		ClockTime = light.ClockTime,
		Brightness = light.Brightness,
		Ambient = light.Ambient,
		OutdoorAmbient = light.OutdoorAmbient,
		FogColor = light.FogColor,
		FogStart = light.FogStart,
		FogEnd = light.FogEnd,
	}):Play()
	TweenService:Create(self.Atmosphere, info, {
		Density = light.AtmosphereDensity,
		Color = light.AtmosphereColor,
		Decay = light.AtmosphereDecay,
		Haze = light.Haze,
		Glare = light.Glare,
	}):Play()
	TweenService:Create(self.Color, info, {
		TintColor = light.Tint,
		Saturation = light.Saturation,
		Contrast = light.Contrast,
	}):Play()
	TweenService:Create(self.Bloom, info, {
		Intensity = light.BloomIntensity,
		Size = light.BloomSize,
		Threshold = light.BloomThreshold,
	}):Play()
end

------------------------------------------------------------------------
-- Power-ups und Sieg
------------------------------------------------------------------------

function EffectsController:_onPowerUp(payload)
	local item = ItemDefinitions.Get(payload.ItemId)
	if not item then
		return
	end
	local camera = self.Ctx.CameraController
	local isLocal = payload.UserId == player.UserId
	if payload.ItemId == "FreezeBurst" then
		self:Ring(payload.Position, item.Color, item.Radius, 0.6)
		self:Burst(payload.Position, item.Color, 30, { SpeedMin = 20, SpeedMax = 40 })
	elseif payload.ItemId == "TeleportBeacon" then
		if payload.From then
			self:Burst(payload.From, item.Color, 24, { SpeedMax = 20 })
		end
		if payload.To then
			self:Burst(payload.To, item.Color, 24, { SpeedMax = 20 })
			self:Ring(payload.To, item.Color, 8, 0.4)
		end
	elseif payload.ItemId == "Trap" and payload.TrapPosition then
		self:Burst(payload.TrapPosition, item.Color, 14)
	else
		self:Burst(payload.Position, item.Color, 20, { SpeedMax = 20 })
	end
	if isLocal then
		camera:Shake(0.35)
	end
end

function EffectsController:_victory(kind: string, root: BasePart)
	local origin = root.Position
	if kind == "Fireworks" then
		for i = 1, 5 do
			task.delay(i * 0.35, function()
				local start = origin + Vector3.new(math.random(-14, 14), 0, -6)
				local color = Color3.fromHSV(math.random(), 0.8, 1)
				local rocket = fxPart({ Name = "Rocket", Shape = Enum.PartType.Ball, Size = Vector3.new(0.8, 0.8, 0.8), CFrame = CFrame.new(start), Color = color, Parent = self.Folder })
				local tween = TweenService:Create(rocket, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = CFrame.new(start + Vector3.new(0, 30, 0)) })
				tween:Play()
				tween.Completed:Once(function()
					self:Burst(rocket.Position, color, 40, { SpeedMin = 14, SpeedMax = 28, LifeMax = 1.4, Acceleration = Vector3.new(0, -12, 0) })
					rocket:Destroy()
				end)
			end)
		end
	elseif kind == "Lightning" then
		for bolt = 1, 2 do
			task.delay((bolt - 1) * 0.3, function()
				local top = origin + Vector3.new(math.random(-4, 4), 70, -2)
				local previous = top
				for step = 1, 7 do
					local nextPoint = top:Lerp(origin, step / 7) + Vector3.new(math.random(-3, 3), 0, 0)
					if step == 7 then
						nextPoint = origin
					end
					local length = (nextPoint - previous).Magnitude
					local segment = fxPart({
						Name = "Bolt",
						Size = Vector3.new(0.5, 0.5, length),
						CFrame = CFrame.lookAt((previous + nextPoint) / 2, nextPoint),
						Color = rgb(200, 230, 255),
						Parent = self.Folder,
					})
					TweenService:Create(segment, TweenInfo.new(0.45), { Transparency = 1 }):Play()
					Debris:AddItem(segment, 0.5)
					previous = nextPoint
				end
				self:Burst(origin, rgb(200, 230, 255), 30, { SpeedMin = 16, SpeedMax = 30 })
			end)
		end
	elseif kind == "GoldenRain" then
		local holder = fxPart({ Name = "GoldRain", Size = Vector3.new(30, 1, 10), CFrame = CFrame.new(origin + Vector3.new(0, 26, 0)), Transparency = 1, Parent = self.Folder })
		local emitter = Instance.new("ParticleEmitter")
		emitter.Rate = if self:_reduced() then 20 else 60
		emitter.Lifetime = NumberRange.new(1.5, 2.2)
		emitter.Speed = NumberRange.new(8, 14)
		emitter.EmissionDirection = Enum.NormalId.Bottom
		emitter.Color = ColorSequence.new(rgb(255, 210, 60))
		emitter.LightEmission = 1
		emitter.Size = NumberSequence.new(0.5)
		emitter.Parent = holder
		task.delay(3, function()
			emitter.Enabled = false
		end)
		Debris:AddItem(holder, 6)
	else
		-- Konfetti (Standard)
		for i = 1, 4 do
			task.delay(i * 0.25, function()
				self:Burst(origin + Vector3.new(math.random(-8, 8), 12, 0), CosmeticApplier.Rainbow, 40, {
					SpeedMin = 10,
					SpeedMax = 24,
					LifeMin = 1,
					LifeMax = 2,
					Acceleration = Vector3.new(0, -18, 0),
					Size = 0.5,
				})
			end)
		end
	end
end

------------------------------------------------------------------------
-- Pro-Frame-Aktualisierung
------------------------------------------------------------------------

function EffectsController:_rope(character: Model)
	local rope = self.Ropes[character]
	if rope and rope.Beam.Parent then
		return rope
	end
	local hand = character:FindFirstChild("RightHand")
	local grip = hand and hand:FindFirstChild("VR_GrappleGrip")
	if not grip then
		return nil
	end
	local anchor = Instance.new("Attachment")
	anchor.Name = "VR_RopeAnchor"
	anchor.Parent = workspace.Terrain
	local beam = Instance.new("Beam")
	beam.Name = "VR_Rope"
	beam.Attachment0 = grip
	beam.Attachment1 = anchor
	beam.Width0 = 0.3
	beam.Width1 = 0.2
	beam.FaceCamera = true
	beam.Segments = 1
	beam.LightEmission = 0.6
	beam.Enabled = false
	beam.Parent = self.Folder
	rope = { Beam = beam, Anchor = anchor }
	self.Ropes[character] = rope
	return rope
end

function EffectsController:_statusFx(character: Model)
	local fx = self.Status[character]
	if fx and fx.Shield.Parent then
		return fx
	end
	local shield = fxPart({ Name = "Shield", Shape = Enum.PartType.Ball, Size = Vector3.new(7.5, 7.5, 7.5), Material = Enum.Material.ForceField, Color = rgb(90, 200, 255), Transparency = 1, Parent = self.Folder })
	local ice = fxPart({ Name = "Ice", Size = Vector3.new(3.4, 6.2, 3), Material = Enum.Material.Glass, Color = rgb(170, 230, 255), Transparency = 1, Parent = self.Folder })
	local stars = {}
	for i = 1, 3 do
		stars[i] = fxPart({ Name = "Star", Shape = Enum.PartType.Ball, Size = Vector3.new(0.5, 0.5, 0.5), Color = rgb(255, 230, 80), Transparency = 1, Parent = self.Folder })
	end
	local boostHolder = fxPart({ Name = "Boost", Size = Vector3.new(1, 1, 1), Transparency = 1, Parent = self.Folder })
	local boost = Instance.new("ParticleEmitter")
	boost.Enabled = false
	boost.Rate = 40
	boost.Lifetime = NumberRange.new(0.2, 0.4)
	boost.Speed = NumberRange.new(4, 8)
	boost.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0) })
	boost.Color = ColorSequence.new(rgb(255, 220, 80), rgb(255, 80, 20))
	boost.LightEmission = 1
	boost.SpreadAngle = Vector2.new(25, 25)
	boost.Parent = boostHolder
	fx = { Shield = shield, Ice = ice, Stars = stars, BoostHolder = boostHolder, Boost = boost }
	self.Status[character] = fx
	return fx
end

function EffectsController:_cleanupCharacters(alive)
	for character, rope in self.Ropes do
		if not alive[character] then
			rope.Beam:Destroy()
			rope.Anchor:Destroy()
			self.Ropes[character] = nil
		end
	end
	for character, fx in self.Status do
		if not alive[character] then
			fx.Shield:Destroy()
			fx.Ice:Destroy()
			fx.BoostHolder:Destroy()
			for _, star in fx.Stars do
				star:Destroy()
			end
			self.Status[character] = nil
		end
	end
end

function EffectsController:_update(dt: number)
	local t = os.clock()
	local serverNow = workspace:GetServerTimeNow()
	local movement = self.Ctx.MovementController
	local currentCamera = workspace.CurrentCamera
	local cameraPosition = if currentCamera then currentCamera.CFrame.Position else Vector3.zero
	local alive = {}

	-- Spielfiguren: Seile und Status
	for _, other in Players:GetPlayers() do
		local character = other.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if character and root and character.Parent then
			alive[character] = true
			local near = (root.Position - cameraPosition).Magnitude < 400

			local rope = self:_rope(character)
			if rope then
				local anchorPosition = nil
				if other == player then
					anchorPosition = movement:GetGrappleAnchor()
				elseif character:GetAttribute("Grappling") then
					anchorPosition = character:GetAttribute("GrappleTarget")
				end
				if anchorPosition and near then
					rope.Anchor.Position = anchorPosition
					local boosted = (character:GetAttribute("GrappleBoostUntil") or 0) > serverNow
					local color = if boosted then rgb(200, 120, 255) else (character:GetAttribute("AccentColor") or rgb(230, 240, 255))
					rope.Beam.Color = ColorSequence.new(color)
					rope.Beam.Width0 = if boosted then 0.45 else 0.3
					rope.Beam.Enabled = true
				else
					rope.Beam.Enabled = false
				end
			end

			local fx = self:_statusFx(character)
			local position = root.Position
			local shielded = (character:GetAttribute("ShieldUntil") or 0) > serverNow
			local slowed = (character:GetAttribute("SlowedUntil") or 0) > serverNow
			local stunned = (character:GetAttribute("StunnedUntil") or 0) > serverNow
			local boosted = (character:GetAttribute("BoostUntil") or 0) > serverNow
			fx.Shield.Transparency = if shielded and near then 0.35 else 1
			fx.Shield.CFrame = CFrame.new(position)
			fx.Ice.Transparency = if slowed and near then 0.45 else 1
			fx.Ice.CFrame = CFrame.new(position)
			for i, star in fx.Stars do
				local angle = t * 6 + i * (math.pi * 2 / 3)
				star.Transparency = if stunned and near then 0 else 1
				star.CFrame = CFrame.new(position + Vector3.new(math.cos(angle) * 1.4, 3.6, math.sin(angle) * 1.4))
			end
			local facing = character:GetAttribute("Facing") or 1
			if other == player then
				facing = movement:GetFacing()
			end
			fx.BoostHolder.CFrame = CFrame.new(position - Vector3.new(facing * 1.2, 0, 0))
			fx.Boost.EmissionDirection = if facing > 0 then Enum.NormalId.Left else Enum.NormalId.Right
			fx.Boost.Enabled = boosted and near
		end
	end
	self:_cleanupCharacters(alive)

	-- Zielmarkierung
	local target = movement.Target
	local frozen = player.Character and player.Character:GetAttribute("Frozen")
	if target and not frozen then
		self.Marker.Adornee = target
		self.Marker.Enabled = true
		local pulse = 1 + math.sin(t * 8) * 0.12
		self.MarkerRing.Size = UDim2.fromScale(pulse, pulse)
		local cooldowns = movement:GetCooldowns()
		self.MarkerRing.UIStroke.Color = if cooldowns.Grapple > 0 then rgb(150, 150, 160) else rgb(255, 255, 255)
	else
		self.Marker.Enabled = false
	end

	-- Item-Boxen drehen
	for _, box in CollectionService:GetTagged("PowerUpBox") do
		local base = box:GetAttribute("BasePosition")
		if typeof(base) == "Vector3" and (base - cameraPosition).Magnitude < 250 then
			local cframe = CFrame.new(base + Vector3.new(0, math.sin(t * 2 + base.X) * 0.4, 0)) * CFrame.Angles(t * 1.2, t * 1.7, math.rad(45))
			box.CFrame = cframe
			local core = box:FindFirstChild("Core")
			if core then
				core.CFrame = cframe
			end
		end
	end

	-- Zeitgesteuerte Gefahren
	for _, hazard in CollectionService:GetTagged("TimedHazard") do
		if (hazard.Position - cameraPosition).Magnitude < 300 then
			local period = hazard:GetAttribute("HazardPeriod") or 2
			local onTime = hazard:GetAttribute("HazardOnTime") or 1
			local offset = hazard:GetAttribute("HazardOffset") or 0
			local phase = (serverNow + offset) % period
			if phase < onTime then
				hazard.Transparency = 0.1
			elseif period - phase < 0.45 then
				hazard.Transparency = if math.floor(t * 12) % 2 == 0 then 0.35 else 0.85
			else
				hazard.Transparency = 0.9
			end
		end
	end

	self:_updateZone(dt)
end

function EffectsController:_updateZone(dt: number)
	local state = self.Ctx.ClientState
	local gameState = state.GameState
	local zoneState = gameState:GetAttribute("ZoneState") or "Inactive"
	local watching = state:IsInRace() or self.Ctx.CameraController:GetSpectate() ~= nil
	local active = watching and (zoneState == "Shrinking" or zoneState == "Final" or zoneState == "Warning")
	if not active then
		self.ZoneWall.Transparency = 1
		self.ZoneTint.Transparency = 1
		self.ZoneVisualX = nil
		return
	end
	local targetX = gameState:GetAttribute("ZoneX") or -1e6
	if zoneState == "Warning" then
		targetX = (gameState:GetAttribute("StartX") or 0) - 20
	end
	if not self.ZoneVisualX or math.abs(targetX - self.ZoneVisualX) > 200 then
		self.ZoneVisualX = targetX
	else
		self.ZoneVisualX = Util.Damp(self.ZoneVisualX, targetX, 8, dt)
	end
	local x = self.ZoneVisualX
	local cameraY = if workspace.CurrentCamera then workspace.CurrentCamera.CFrame.Position.Y else 0
	local pulse = 0.5 + math.sin(os.clock() * 6) * 0.1
	self.ZoneWall.CFrame = CFrame.new(x, cameraY, -40)
	self.ZoneWall.Transparency = if zoneState == "Warning" then 0.75 else pulse
	self.ZoneTint.CFrame = CFrame.new(x - 2002, cameraY, Config.World.TrackDepth / 2 + 3)
	self.ZoneTint.Transparency = if zoneState == "Warning" then 1 else 0.86
end

return EffectsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source"><![CDATA[--[[
	InputController  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/Controllers/InputController

	Zentrale Verwaltung ALLER Eingaben (Tastatur, Maus, Gamepad, Touch).
	Andere Module fragen nur abstrakte Aktionen ab:

		Left/Right (Achse), Jump, Grapple, Slide, Item, Emote, Respawn, Menu

	Belegung:
		PC:       A/D oder ←/→ bewegen · Leertaste/W/↑ springen
		          E / J / linke Maustaste Greifhaken (halten)
		          Shift / S / ↓ / K Slide (Boden, halten) bzw. Air-Dash (Luft)
		          Q / F / L Power-up · G Emote · R Respawn · M Menü
		Gamepad:  Linker Stick / D-Pad bewegen · A springen · X oder R2 Haken
		          B oder L2 Slide/Dash · Y oder R1 Power-up · L1 Emote · Select Menü
		Touch:    Virtuelle Buttons (UI/Screens/TouchControls)

	API:
		:GetMoveX() -> number (-1..1)
		:IsHeld(action) -> boolean
		:Consume(action) -> boolean     (Druck seit max. 0,25 s, wird verbraucht)
		:SetVirtualAxis(x)              (Touch)
		:SetVirtualButton(action, down) (Touch)
		:GetDevice() -> "Keyboard" | "Gamepad" | "Touch"
		.ActionPressed / .ActionReleased (Signal: action)
		.DeviceChanged (Signal: device)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared.Signal)
local Config = require(Shared.Config)

local InputController = {}
InputController.ActionPressed = Signal.new()
InputController.ActionReleased = Signal.new()
InputController.DeviceChanged = Signal.new()

local K = Enum.KeyCode

local KEYMAP = {
	[K.A] = "Left",
	[K.Left] = "Left",
	[K.D] = "Right",
	[K.Right] = "Right",
	[K.Space] = "Jump",
	[K.W] = "Jump",
	[K.Up] = "Jump",
	[K.E] = "Grapple",
	[K.J] = "Grapple",
	[K.LeftShift] = "Slide",
	[K.S] = "Slide",
	[K.Down] = "Slide",
	[K.K] = "Slide",
	[K.Q] = "Item",
	[K.F] = "Item",
	[K.L] = "Item",
	[K.G] = "Emote",
	[K.R] = "Respawn",
	[K.M] = "Menu",
	-- Gamepad
	[K.ButtonA] = "Jump",
	[K.ButtonX] = "Grapple",
	[K.ButtonR2] = "Grapple",
	[K.ButtonB] = "Slide",
	[K.ButtonL2] = "Slide",
	[K.ButtonY] = "Item",
	[K.ButtonR1] = "Item",
	[K.ButtonL1] = "Emote",
	[K.DPadLeft] = "Left",
	[K.DPadRight] = "Right",
	[K.ButtonSelect] = "Menu",
}

local PRESS_WINDOW = 0.25

function InputController:Init(ctx)
	self.Ctx = ctx
	self.Held = {} -- [action] = { [source] = true }
	self.Pressed = {} -- [action] = os.clock()
	self.Virtual = {}
	self.VirtualAxis = 0
	self.StickX = 0
	self.Device = "Keyboard"
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		self.Device = "Touch"
	end
end

function InputController:_press(action: string, source: any)
	local held = self.Held[action]
	if not held then
		held = {}
		self.Held[action] = held
	end
	local wasHeld = next(held) ~= nil or self.Virtual[action] == true
	held[source] = true
	if not wasHeld then
		self.Pressed[action] = os.clock()
		self.ActionPressed:Fire(action)
	end
end

function InputController:_release(action: string, source: any)
	local held = self.Held[action]
	if not held or not held[source] then
		return
	end
	held[source] = nil
	if next(held) == nil and not self.Virtual[action] then
		self.ActionReleased:Fire(action)
	end
end

function InputController:_setDevice(device: string)
	if self.Device ~= device then
		self.Device = device
		self.DeviceChanged:Fire(device)
	end
end

function InputController:Start()
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end
		local action = KEYMAP[input.KeyCode]
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			action = "Grapple"
		end
		if action then
			self:_press(action, input.KeyCode.Name .. input.UserInputType.Name)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		local action = KEYMAP[input.KeyCode]
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			action = "Grapple"
		end
		if action then
			self:_release(action, input.KeyCode.Name .. input.UserInputType.Name)
		end
		if input.KeyCode == K.Thumbstick1 then
			self.StickX = 0
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input.KeyCode == K.Thumbstick1 then
			self.StickX = input.Position.X
		end
	end)

	UserInputService.LastInputTypeChanged:Connect(function(inputType)
		local name = inputType.Name
		if name:find("Gamepad") then
			self:_setDevice("Gamepad")
		elseif inputType == Enum.UserInputType.Touch then
			self:_setDevice("Touch")
		elseif name:find("Mouse") or inputType == Enum.UserInputType.Keyboard then
			self:_setDevice("Keyboard")
		end
	end)

	-- Fenster verliert den Fokus: alle Tasten loslassen
	UserInputService.WindowFocusReleased:Connect(function()
		for action, held in self.Held do
			for source in held do
				self:_release(action, source)
			end
		end
		self.StickX = 0
	end)
end

function InputController:GetDevice(): string
	return self.Device
end

function InputController:IsHeld(action: string): boolean
	local held = self.Held[action]
	return (held ~= nil and next(held) ~= nil) or self.Virtual[action] == true
end

function InputController:Consume(action: string): boolean
	local pressed = self.Pressed[action]
	if pressed and os.clock() - pressed <= PRESS_WINDOW then
		self.Pressed[action] = nil
		return true
	end
	return false
end

function InputController:GetMoveX(): number
	local keyboard = (if self:IsHeld("Right") then 1 else 0) - (if self:IsHeld("Left") then 1 else 0)
	local deadzone = Config.Input.GamepadDeadzone
	local stick = 0
	if math.abs(self.StickX) > deadzone then
		local sensitivity = Config.Input.DefaultGamepadSensitivity
		local state = self.Ctx and self.Ctx.ClientState
		if state then
			sensitivity = state:GetSetting("GamepadSensitivity") or sensitivity
		end
		local magnitude = (math.abs(self.StickX) - deadzone) / (1 - deadzone)
		stick = math.sign(self.StickX) * math.clamp(magnitude * sensitivity, 0, 1)
	end
	local best = keyboard
	if math.abs(stick) > math.abs(best) then
		best = stick
	end
	if math.abs(self.VirtualAxis) > math.abs(best) then
		best = self.VirtualAxis
	end
	return best
end

function InputController:SetVirtualAxis(x: number)
	self.VirtualAxis = math.clamp(x, -1, 1)
end

function InputController:SetVirtualButton(action: string, down: boolean)
	local wasHeld = self:IsHeld(action)
	self.Virtual[action] = down or nil
	if down and not wasHeld then
		self.Pressed[action] = os.clock()
		self.ActionPressed:Fire(action)
	elseif not down and wasHeld and not self:IsHeld(action) then
		self.ActionReleased:Fire(action)
	end
end

-- Lokaler Spieler wird für zukünftige Erweiterungen bereitgehalten
InputController.Player = Players.LocalPlayer

return InputController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">MovementController</string>
              <string name="Source"><![CDATA[--[[
	MovementController  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/Controllers/MovementController

	Eigene Side-Scrolling-Bewegungslogik (ersetzt die Roblox-Standardsteuerung).

	Architektur:
		- Die Spielfigur ist ein physikalischer Körper; nur der unsichtbare
		  "VR_Collider" kollidiert mit der Welt. Der Humanoid ist deaktiviert
		  (EvaluateStateMachine = false bzw. Zustand Physics).
		- Jeden Physik-Schritt (RunService.PreSimulation) wird die aktuelle
		  Geschwindigkeit gelesen, nach unseren Regeln verändert und
		  zurückgeschrieben. Schwerkraft und Kollisionen löst die Roblox-Engine,
		  dadurch bleiben Wände, Decken und Böden exakt.
		- Bewegung findet nur in der X/Y-Ebene statt; Z wird auf 0 gehalten.
		- Der Client besitzt seine Figur (Network Ownership) -> keine Eingabelatenz.
		  Der Server prüft Plausibilität (AntiExploitService, GrappleService).

	Mechaniken:
		Beschleunigung/Verzögerung, Momentum (Übergeschwindigkeit baut sich nur
		langsam ab), Boden-/Luftreibung, variable Sprunghöhe, Coyote-Time,
		Sprungpuffer, Wall-Slide + Wall-Jump, Slide (mit niedrigerem Kollider und
		Kriechen unter Decken), Air-Dash, Greifhaken mit Seilphysik, Boost- und
		Sprungpads, Eis.

	Signale: Jumped(kind), Landed(impactSpeed, position), SlideStarted,
	         DashStarted(dir), GrappleStarted(anchor), GrappleEnded, BoostPad(position),
	         GrappleFailed, StateChanged(state)
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Signal = require(Shared.Signal)
local Remotes = require(Shared.Remotes)

local M = Config.Movement
local G = Config.Grapple
local C = Config.Character

local player = Players.LocalPlayer

local MovementController = {}
MovementController.Jumped = Signal.new()
MovementController.Landed = Signal.new()
MovementController.SlideStarted = Signal.new()
MovementController.DashStarted = Signal.new()
MovementController.GrappleStarted = Signal.new()
MovementController.GrappleEnded = Signal.new()
MovementController.GrappleFailed = Signal.new()
MovementController.BoostPad = Signal.new()
MovementController.StateChanged = Signal.new()

local DISABLED_STATES = {
	Enum.HumanoidStateType.FallingDown,
	Enum.HumanoidStateType.Ragdoll,
	Enum.HumanoidStateType.GettingUp,
	Enum.HumanoidStateType.Climbing,
	Enum.HumanoidStateType.Swimming,
	Enum.HumanoidStateType.Seated,
	Enum.HumanoidStateType.Jumping,
	Enum.HumanoidStateType.Freefall,
	Enum.HumanoidStateType.Running,
	Enum.HumanoidStateType.Landed,
	Enum.HumanoidStateType.Flying,
}

local function newState()
	return {
		State = "Idle",
		Facing = 1,
		Grounded = false,
		LastGroundTime = -math.huge,
		LastJumpTime = -math.huge,
		JumpBufferUntil = 0,
		JumpCutPending = false,
		MinAirVy = 0,
		Sliding = false,
		SlideStart = 0,
		SlideCooldownUntil = 0,
		DashUntil = 0,
		DashDir = 1,
		DashEntrySpeed = 0,
		DashCooldownUntil = 0,
		WasDashing = false,
		AirDashAvailable = true,
		WallSliding = false,
		WallJumpLockUntil = 0,
		LockedDir = 0,
		Grapple = nil,
		GrappleCooldownUntil = 0,
		LastPadTime = 0,
		PendingImpulse = 0,
		StreamWaitUntil = 0,
		SentState = "",
		SentFacing = 0,
		LastSent = 0,
		AlignFacing = 0,
	}
end

function MovementController:Init(ctx)
	self.Ctx = ctx
	self.Input = ctx.InputController
	self.S = newState()
	self.Velocity = Vector3.zero
	self.Target = nil
	self.Anchors = {}

	local function addAnchor(part)
		if part:IsA("BasePart") then
			self.Anchors[part] = true
		end
	end
	for _, part in CollectionService:GetTagged("GrappleAnchor") do
		addAnchor(part)
	end
	CollectionService:GetInstanceAddedSignal("GrappleAnchor"):Connect(addAnchor)
	CollectionService:GetInstanceRemovedSignal("GrappleAnchor"):Connect(function(part)
		self.Anchors[part] = nil
		local grapple = self.S.Grapple
		if grapple and grapple.Part == part then
			self:_releaseGrapple(false, true, 0, 0)
		end
	end)

	local okStreaming, streaming = pcall(function()
		return workspace.StreamingEnabled
	end)
	self.Streaming = okStreaming and streaming == true

	self.Params = RaycastParams.new()
	self.Params.FilterType = Enum.RaycastFilterType.Exclude
	self.Params.CollisionGroup = "Runner"
	pcall(function()
		self.Params.RespectCanCollide = true
	end)

	local state = ctx.ClientState
	state:On("Teleported", function()
		self:_onTeleported()
	end)
	state:On("GrappleRejected", function()
		self:_releaseGrapple(false, false, 0, 0)
	end)
	state:On("GrappleForceRelease", function()
		self:_releaseGrapple(false, false, 0, 0)
	end)

	player.CharacterAdded:Connect(function(character)
		self:_bind(character)
	end)
	if player.Character then
		task.spawn(function()
			self:_bind(player.Character)
		end)
	end
end

function MovementController:Start()
	RunService.PreSimulation:Connect(function(dt)
		local ok, err = pcall(self._step, self, dt)
		if not ok then
			warn("[MovementController] " .. tostring(err))
		end
	end)
end

------------------------------------------------------------------------
-- Charakter
------------------------------------------------------------------------

function MovementController:_bind(character: Model)
	self.Character = nil
	local root = character:WaitForChild("HumanoidRootPart", 10)
	local humanoid = character:WaitForChild("Humanoid", 10)
	local collider = character:WaitForChild("VR_Collider", 10)
	if not root or not humanoid or not collider or player.Character ~= character then
		return
	end
	self.Root = root
	self.Humanoid = humanoid
	self.Collider = collider
	self.ColliderWeld = collider:FindFirstChild("VR_ColliderWeld")
	self.Align = root:FindFirstChild("VR_Align")
	self.S = newState()
	self.Params.FilterDescendantsInstances = { character }

	pcall(function()
		humanoid.EvaluateStateMachine = false
	end)
	for _, stateType in DISABLED_STATES do
		pcall(function()
			humanoid:SetStateEnabled(stateType, false)
		end)
	end
	pcall(function()
		humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	end)

	character:GetAttributeChangedSignal("BoostUntil"):Connect(function()
		if (character:GetAttribute("BoostUntil") or 0) > workspace:GetServerTimeNow() then
			self.S.PendingImpulse = M.BoostImpulse
		end
	end)

	self:_setSliding(false)
	self.Character = character
end

function MovementController:_onTeleported()
	local S = self.S
	S.StreamWaitUntil = os.clock() + 3
	S.Grapple = nil
	S.DashUntil = 0
	S.JumpBufferUntil = 0
	S.WasDashing = false
	if S.Sliding then
		self:_setSliding(false)
	end
	self.GrappleEnded:Fire()
	if self.Root then
		self.Root.AssemblyLinearVelocity = Vector3.zero
	end
end

------------------------------------------------------------------------
-- Sensoren
------------------------------------------------------------------------

function MovementController:_groundCheck(position: Vector3): RaycastResult?
	local feetY = position.Y + C.FeetOffset
	local origin = feetY + 0.6
	local length = 0.6 + M.GroundCheckDistance
	local half = C.ColliderWidth / 2 - 0.15
	for _, offset in { 0, -half, half } do
		local hit = workspace:Raycast(Vector3.new(position.X + offset, origin, position.Z), Vector3.new(0, -length, 0), self.Params)
		if hit and hit.Normal.Y > 0.55 then
			return hit
		end
	end
	return nil
end

function MovementController:_wallCheck(position: Vector3): number
	local S = self.S
	local half = C.ColliderWidth / 2
	local top = if S.Sliding then C.SlideHeight else C.StandHeight
	local heights = { C.FeetOffset + 0.8, C.FeetOffset + top * 0.5, C.FeetOffset + top - 0.6 }
	for _, dir in { S.Facing, -S.Facing } do
		local hits = 0
		for _, height in heights do
			local hit = workspace:Raycast(position + Vector3.new(0, height, 0), Vector3.new(dir * (half + 0.35), 0, 0), self.Params)
			if hit and math.abs(hit.Normal.X) > 0.7 and not hit.Instance:GetAttribute("NoWallJump") then
				hits += 1
			end
		end
		if hits >= 2 then
			return dir
		end
	end
	return 0
end

function MovementController:_canStand(): boolean
	local root = self.Root
	if not root then
		return true
	end
	local base = root.Position + Vector3.new(0, C.FeetOffset + C.SlideHeight - 0.1, 0)
	local up = C.StandHeight - C.SlideHeight + 0.2
	local half = C.ColliderWidth / 2 - 0.1
	for _, offset in { -half, 0, half } do
		if workspace:Raycast(base + Vector3.new(offset, 0, 0), Vector3.new(0, up, 0), self.Params) then
			return false
		end
	end
	return true
end

------------------------------------------------------------------------
-- Zustände
------------------------------------------------------------------------

function MovementController:_setSliding(on: boolean)
	local S = self.S
	S.Sliding = on
	local collider = self.Collider
	if collider then
		local height = if on then C.SlideHeight else C.StandHeight
		local center = C.FeetOffset + height / 2
		collider.Size = Vector3.new(C.ColliderWidth, height, C.ColliderDepth)
		if self.ColliderWeld then
			self.ColliderWeld.C0 = CFrame.new(0, center, 0)
		end
	end
	if on then
		S.SlideStart = os.clock()
	else
		S.SlideCooldownUntil = os.clock() + M.SlideCooldown
	end
end

function MovementController:_findTarget(position: Vector3, boosted: boolean): BasePart?
	local range = G.Range * (if boosted then G.UpgradeRangeMultiplier else 1)
	local facing = self.S.Facing
	local candidates = {}
	for part in self.Anchors do
		if part.Parent then
			local p = part.Position
			local dx, dy = p.X - position.X, p.Y - position.Y
			if math.abs(dx) <= range and math.abs(dy) <= range and dy >= -G.MaxAnchorBelow then
				local distance = math.sqrt(dx * dx + dy * dy)
				if distance <= range and distance > 3 then
					local ahead = Util.Sign(dx) == facing or math.abs(dx) < 4
					local score = distance - (if ahead then 18 else 0) - math.clamp(dy, 0, 20) * 0.3
					table.insert(candidates, { Part = part, Score = score, Distance = distance })
				end
			end
		end
	end
	table.sort(candidates, function(a, b)
		return a.Score < b.Score
	end)
	for i = 1, math.min(4, #candidates) do
		local candidate = candidates[i]
		local direction = candidate.Part.Position - position
		local hit = workspace:Raycast(position, direction, self.Params)
		if not hit or (hit.Position - position).Magnitude >= candidate.Distance - 1.5 then
			return candidate.Part
		end
	end
	return nil
end

function MovementController:_tryGrapple(position: Vector3, boosted: boolean)
	local target = self.Target or self:_findTarget(position, boosted)
	if not target then
		self.GrappleFailed:Fire()
		return
	end
	local id = target:GetAttribute("AnchorId")
	if type(id) ~= "number" then
		return
	end
	local S = self.S
	local distance = (target.Position - position).Magnitude
	S.Grapple = {
		Part = target,
		Id = id,
		Position = target.Position,
		Length = math.max(G.MinRopeLength, distance),
		StartedAt = os.clock(),
	}
	S.JumpCutPending = false
	if S.Sliding and self:_canStand() then
		self:_setSliding(false)
	end
	Remotes.GrappleRequest:FireServer("Attach", id)
	self.GrappleStarted:Fire(target)
end

--- Löst den Haken. Gibt den Geschwindigkeitsbonus (dvx, dvy) zurück.
function MovementController:_releaseGrapple(byPlayer: boolean, notifyServer: boolean, vx: number, vy: number): (number, number)
	local S = self.S
	if not S.Grapple then
		return 0, 0
	end
	S.Grapple = nil
	local character = self.Character
	local boosted = character ~= nil and (character:GetAttribute("GrappleBoostUntil") or 0) > workspace:GetServerTimeNow()
	S.GrappleCooldownUntil = os.clock() + (if boosted then G.UpgradeCooldown else G.Cooldown)
	if notifyServer then
		Remotes.GrappleRequest:FireServer("Release")
	end
	self.GrappleEnded:Fire()
	if byPlayer then
		local speed = math.sqrt(vx * vx + vy * vy)
		if speed > 5 then
			return vx / speed * G.ReleaseBoost, vy / speed * G.ReleaseBoost
		end
	end
	return 0, 0
end

function MovementController:_setState(name: string)
	local S = self.S
	if S.State ~= name then
		S.State = name
		self.StateChanged:Fire(name)
	end
	local now = os.clock()
	if (S.SentState ~= S.State or S.SentFacing ~= S.Facing) and now - S.LastSent >= M.StateSendInterval then
		S.SentState = S.State
		S.SentFacing = S.Facing
		S.LastSent = now
		Remotes.MoveState:FireServer(S.State, S.Facing)
	end
end

function MovementController:_updateAlign()
	local S = self.S
	if self.Align and S.AlignFacing ~= S.Facing then
		S.AlignFacing = S.Facing
		self.Align.CFrame = CFrame.lookAt(Vector3.zero, Vector3.new(S.Facing, 0, 0))
	end
end

------------------------------------------------------------------------
-- Haupt-Schritt
------------------------------------------------------------------------

function MovementController:_step(rawDt: number)
	local character = self.Character
	local root = self.Root
	if not character or not root or not root.Parent or not self.Collider then
		return
	end
	local dt = math.min(rawDt, 1 / 20)
	local S = self.S
	local input = self.Input
	local now = os.clock()
	local serverNow = workspace:GetServerTimeNow()

	local frozen = character:GetAttribute("Frozen") == true
	local stunned = (character:GetAttribute("StunnedUntil") or 0) > serverNow
	local slowed = (character:GetAttribute("SlowedUntil") or 0) > serverNow
	local boosted = (character:GetAttribute("BoostUntil") or 0) > serverNow
	local grappleBoost = (character:GetAttribute("GrappleBoostUntil") or 0) > serverNow

	local velocity = root.AssemblyLinearVelocity
	local position = root.Position
	local vx, vy = velocity.X, velocity.Y

	-- Eingefroren (Countdown, Respawn, Ergebnis)
	if frozen then
		if S.Grapple then
			self:_releaseGrapple(false, true, 0, 0)
		end
		if S.Sliding and self:_canStand() then
			self:_setSliding(false)
		end
		S.DashUntil = 0
		S.PendingImpulse = 0
		input:Consume("Jump")
		input:Consume("Grapple")
		input:Consume("Slide")
		root.AssemblyLinearVelocity = Vector3.new(0, math.min(vy, 0), 0)
		root.AssemblyAngularVelocity = Vector3.zero
		S.Grounded = self:_groundCheck(position) ~= nil
		self.Velocity = Vector3.zero
		self.Target = nil
		self:_updateAlign()
		self:_setState("Frozen")
		return
	end

	local vz = math.clamp((Config.World.PlaneZ - position.Z) * 10, -40, 40)

	-- Sensoren
	local groundHit = self:_groundCheck(position)

	-- StreamingEnabled: nach Teleports schweben, bis der Boden geladen ist
	if self.Streaming and now < S.StreamWaitUntil and not groundHit then
		if not workspace:Raycast(position, Vector3.new(0, -250, 0), self.Params) then
			root.AssemblyLinearVelocity = Vector3.new(0, 0, vz)
			root.AssemblyAngularVelocity = Vector3.zero
			self.Velocity = Vector3.zero
			return
		end
	end
	local grounded = groundHit ~= nil and (now - S.LastJumpTime) > 0.12
	if grounded then
		if not S.Grounded and S.MinAirVy < -45 then
			self.Landed:Fire(-S.MinAirVy, position + Vector3.new(0, C.FeetOffset, 0))
		end
		S.LastGroundTime = now
		S.AirDashAvailable = true
		S.MinAirVy = 0
	else
		S.MinAirVy = math.min(S.MinAirVy, vy)
	end
	S.Grounded = grounded
	local wallDir = if grounded then 0 else self:_wallCheck(position)

	-- Eingaben
	local moveX = if stunned then 0 else input:GetMoveX()
	if now < S.WallJumpLockUntil and Util.Sign(moveX) == S.LockedDir then
		moveX = 0
	end
	if input:Consume("Jump") then
		S.JumpBufferUntil = now + M.JumpBuffer
	end
	local jumpHeld = input:IsHeld("Jump")
	local slidePressed = input:Consume("Slide")
	local slideHeld = input:IsHeld("Slide")
	local grapplePressed = input:Consume("Grapple")
	local grappleHeld = input:IsHeld("Grapple")
	if input:Consume("Item") and (player:GetAttribute("HeldItem") or "") ~= "" then
		Remotes.UsePowerUp:FireServer()
	end
	if input:Consume("Emote") then
		Remotes.PlayEmote:FireServer()
	end
	if input:Consume("Respawn") then
		Remotes.RequestRespawn:FireServer()
	end

	-- Blickrichtung
	if S.Grapple then
		if math.abs(vx) > 3 then
			S.Facing = Util.Sign(vx)
		end
	elseif math.abs(moveX) > 0.1 then
		S.Facing = Util.Sign(moveX)
	end

	-- Slide / Air-Dash
	if slidePressed and not stunned then
		if grounded and not S.Sliding and now >= S.SlideCooldownUntil and math.abs(vx) >= M.SlideMinSpeed then
			self:_setSliding(true)
			local dir = Util.Sign(vx)
			local speed = math.abs(vx)
			vx = dir * math.max(speed, math.min(speed + M.SlideBoost, M.MaxRunSpeed + M.SlideBoost))
			self.SlideStarted:Fire()
		elseif not grounded and not S.Grapple and S.AirDashAvailable and now >= S.DashCooldownUntil then
			S.AirDashAvailable = false
			S.DashUntil = now + M.DashDuration
			S.DashCooldownUntil = now + M.DashCooldown
			S.DashDir = S.Facing
			S.DashEntrySpeed = math.abs(vx)
			if S.Sliding and self:_canStand() then
				self:_setSliding(false)
			end
			self.DashStarted:Fire(S.DashDir)
		end
	end
	if S.Sliding and self:_canStand() then
		if not slideHeld or (not grounded and now - S.SlideStart > 0.25) then
			self:_setSliding(false)
		end
	end

	-- Greifhaken
	if grapplePressed and not stunned and not S.Grapple and (now >= S.GrappleCooldownUntil or grappleBoost) then
		self:_tryGrapple(position, grappleBoost)
	end
	if S.Grapple and (not grappleHeld or stunned or now - S.Grapple.StartedAt > G.MaxAttachTime) then
		local bx, by = self:_releaseGrapple(true, true, vx, vy)
		vx += bx
		vy += by
	end

	-- Horizontale Bewegung
	local maxSpeed = M.MaxRunSpeed * (if boosted then M.BoostMultiplier else 1) * (if slowed then M.SlowMultiplier else 1)
	local onIce = groundHit ~= nil and groundHit.Instance:GetAttribute("Ice") == true
	if S.PendingImpulse > 0 then
		vx += S.Facing * S.PendingImpulse
		S.PendingImpulse = 0
	end

	if now < S.DashUntil then
		vx = S.DashDir * M.DashSpeed * (if slowed then M.SlowMultiplier else 1)
		vy = 0
		S.WasDashing = true
	else
		if S.WasDashing then
			S.WasDashing = false
			local cap = math.max(S.DashEntrySpeed, maxSpeed + 6)
			if math.abs(vx) > cap then
				vx = Util.Sign(vx) * cap
			end
		end
		if S.Sliding then
			local friction = M.SlideFriction * (if onIce then 0.3 else 1)
			vx = Util.MoveToward(vx, 0, friction * dt)
			if not self:_canStand() then
				-- Kriechen unter niedrigen Decken
				local dir = S.Facing
				if math.abs(moveX) > 0.1 then
					dir = Util.Sign(moveX)
				elseif math.abs(vx) > 0.5 then
					dir = Util.Sign(vx)
				end
				if math.abs(vx) < M.CrawlSpeed then
					vx = dir * M.CrawlSpeed
				end
			elseif math.abs(vx) < M.SlideEndSpeed then
				self:_setSliding(false)
			end
		elseif S.Grapple then
			vx += moveX * G.SwingAcceleration * dt
		elseif grounded then
			local accelMul = if onIce then M.IceAccelerationMultiplier else 1
			local decelMul = if onIce then M.IceDecelerationMultiplier else 1
			if math.abs(moveX) > 0.05 then
				local target = moveX * maxSpeed
				if math.abs(vx) > maxSpeed and Util.Sign(vx) == Util.Sign(moveX) then
					vx = Util.MoveToward(vx, target, M.OverspeedGroundDecay * decelMul * dt)
				elseif math.abs(vx) > 0.5 and Util.Sign(vx) ~= Util.Sign(moveX) then
					vx = Util.MoveToward(vx, target, M.TurnAcceleration * accelMul * dt)
				else
					vx = Util.MoveToward(vx, target, M.GroundAcceleration * accelMul * dt)
				end
			else
				vx = Util.MoveToward(vx, 0, M.GroundDeceleration * decelMul * dt)
			end
		else
			if math.abs(moveX) > 0.05 then
				local target = moveX * maxSpeed
				if math.abs(vx) > maxSpeed and Util.Sign(vx) == Util.Sign(moveX) then
					vx = Util.MoveToward(vx, target, M.OverspeedAirDecay * dt)
				elseif math.abs(vx) > 0.5 and Util.Sign(vx) ~= Util.Sign(moveX) then
					vx = Util.MoveToward(vx, target, M.AirTurnAcceleration * dt)
				else
					vx = Util.MoveToward(vx, target, M.AirAcceleration * dt)
				end
			else
				local drag = if math.abs(vx) > maxSpeed then M.OverspeedAirDecay else M.AirDrag
				vx = Util.MoveToward(vx, 0, drag * dt)
			end
		end
	end

	-- Vertikale Bewegung
	if now >= S.DashUntil and not S.Grapple then
		if vy < 0 then
			vy -= Config.World.Gravity * (M.FallGravityMultiplier - 1) * dt
		end
		if S.JumpCutPending then
			if vy <= 0 then
				S.JumpCutPending = false
			elseif not jumpHeld then
				vy *= M.JumpCutMultiplier
				S.JumpCutPending = false
			end
		end
	end

	S.WallSliding = false
	if not grounded and wallDir ~= 0 and not S.Grapple and moveX * wallDir > 0.1 and vy < -M.WallSlideMaxFall then
		vy = -M.WallSlideMaxFall
		S.WallSliding = true
	end

	if now < S.JumpBufferUntil and not stunned then
		local canGroundJump = grounded or (now - S.LastGroundTime) <= M.CoyoteTime
		if S.Grapple then
			local bx, by = self:_releaseGrapple(true, true, vx, vy)
			vx += bx
			vy = math.max(vy + by, M.JumpVelocity * 0.6)
			S.JumpBufferUntil = 0
			S.LastJumpTime = now
			self.Jumped:Fire("GrappleJump")
		elseif canGroundJump and (not S.Sliding or self:_canStand()) then
			if S.Sliding then
				self:_setSliding(false)
			end
			vy = M.JumpVelocity * (if slowed then 0.8 else 1)
			S.JumpBufferUntil = 0
			S.LastJumpTime = now
			S.LastGroundTime = -math.huge
			S.JumpCutPending = true
			grounded = false
			self.Jumped:Fire("Jump")
		elseif not grounded and wallDir ~= 0 then
			vx = -wallDir * M.WallJumpVelocityX
			vy = M.WallJumpVelocityY
			S.Facing = -wallDir
			S.WallJumpLockUntil = now + M.WallJumpLockTime
			S.LockedDir = wallDir
			S.JumpBufferUntil = 0
			S.LastJumpTime = now
			S.JumpCutPending = true
			S.AirDashAvailable = true
			self.Jumped:Fire("WallJump")
		end
	end
	vy = math.max(vy, -M.MaxFallSpeed)

	-- Boost- und Sprungpads
	if groundHit and grounded then
		local part = groundHit.Instance
		local boost = part:GetAttribute("BoostPad")
		if type(boost) == "number" and now - S.LastPadTime > 0.25 then
			local direction = part:GetAttribute("Direction") or 1
			vx = direction * math.max(vx * direction, boost)
			S.LastPadTime = now
			self.BoostPad:Fire(position)
		end
		local jumpPower = part:GetAttribute("JumpPad")
		if type(jumpPower) == "number" and now - S.LastPadTime > 0.3 then
			if S.Sliding and self:_canStand() then
				self:_setSliding(false)
			end
			vy = jumpPower
			S.LastJumpTime = now
			S.LastGroundTime = -math.huge
			S.LastPadTime = now
			S.JumpCutPending = false
			self.Jumped:Fire("Pad")
		end
	end

	-- Seilphysik: Seil zieht sich bei Durchhang ein, hält bei Spannung die Länge
	local grapple = S.Grapple
	if grapple then
		local anchor = grapple.Position
		local dx, dy = position.X - anchor.X, position.Y - anchor.Y
		local distance = math.sqrt(dx * dx + dy * dy)
		local reel = G.ReelSpeed * (if grappleBoost then G.UpgradeReelMultiplier else 1)
		grapple.Length = math.max(G.MinRopeLength, math.min(grapple.Length, distance) - reel * dt)
		if distance > grapple.Length and distance > 0.01 then
			local nx, ny = dx / distance, dy / distance
			local radial = vx * nx + vy * ny
			if radial > 0 then
				vx -= nx * radial
				vy -= ny * radial
			end
			local correction = math.min((distance - grapple.Length) * G.RopeStiffness, G.MaxCorrectionSpeed)
			vx -= nx * correction
			vy -= ny * correction
		end
	end

	vx = math.clamp(vx, -M.AbsoluteMaxSpeed, M.AbsoluteMaxSpeed)
	root.AssemblyLinearVelocity = Vector3.new(vx, vy, vz)
	root.AssemblyAngularVelocity = Vector3.zero
	self.Velocity = Vector3.new(vx, vy, 0)
	self:_updateAlign()

	local stateName
	if stunned then
		stateName = "Stunned"
	elseif now < S.DashUntil then
		stateName = "Dash"
	elseif S.Grapple then
		stateName = "Grapple"
	elseif S.Sliding then
		stateName = "Slide"
	elseif S.WallSliding then
		stateName = "Wall"
	elseif not grounded then
		stateName = "Air"
	elseif math.abs(vx) > 2 then
		stateName = "Run"
	else
		stateName = "Idle"
	end
	self:_setState(stateName)

	self.Target = if S.Grapple then nil else self:_findTarget(position, grappleBoost)
end

------------------------------------------------------------------------
-- Öffentliche Abfragen (für Animation, Effekte, UI)
------------------------------------------------------------------------

function MovementController:GetState(): string
	return self.S.State
end

function MovementController:GetFacing(): number
	return self.S.Facing
end

function MovementController:GetGrappleAnchor(): Vector3?
	local grapple = self.S.Grapple
	return grapple and grapple.Position or nil
end

--- Restzeiten der Fähigkeiten in Sekunden (0 = bereit).
function MovementController:GetCooldowns()
	local S = self.S
	local now = os.clock()
	return {
		Grapple = math.max(0, S.GrappleCooldownUntil - now),
		GrappleMax = G.Cooldown,
		Dash = math.max(0, S.DashCooldownUntil - now),
		DashMax = M.DashCooldown,
		DashAvailable = S.AirDashAvailable,
		Slide = math.max(0, S.SlideCooldownUntil - now),
		SlideMax = M.SlideCooldown,
		Grappling = S.Grapple ~= nil,
		HasTarget = self.Target ~= nil,
	}
end

return MovementController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="63">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--[[
	Main  (LocalScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/Main

	Einstiegspunkt des Clients. Lädt alle Controller und die UI, ruft
	:Init(ctx) und danach :Start() auf. Deaktiviert die Roblox-Standard-
	steuerung, da Velocity Rush eine eigene Bewegungslogik nutzt.
]]

local Players = game:GetService("Players")

local player = Players.LocalPlayer
local controllers = script.Parent:WaitForChild("Controllers")
local ui = script.Parent:WaitForChild("UI")

-- Standardsteuerung (WASD/Thumbstick/Sprungbutton) abschalten
task.spawn(function()
	local ok, playerModule = pcall(function()
		return require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 20))
	end)
	if ok and playerModule then
		local controls = playerModule:GetControls()
		if controls then
			controls:Disable()
		end
	end
end)

local ORDER = {
	"ClientState",
	"InputController",
	"MovementController",
	"CameraController",
	"AnimationController",
	"EffectsController",
	"AudioController",
}

local ctx = {}
for _, name in ORDER do
	ctx[name] = require(controllers:WaitForChild(name))
end
ctx.UIController = require(ui:WaitForChild("UIController"))

for _, name in ORDER do
	ctx[name]:Init(ctx)
end
ctx.UIController:Init(ctx)

for _, name in ORDER do
	if ctx[name].Start then
		ctx[name]:Start()
	end
end
ctx.UIController:Start()
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="64">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">Components</string>
              <string name="Source"><![CDATA[--[[
	Components  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/UI/Components

	Wiederverwendbare UI-Bausteine im einheitlichen Stil (siehe Theme):
		new(className, props, children)  generischer Instanz-Builder
		Corner, Stroke, Padding, List, Grid
		Label, Button, Panel, ProgressBar, Toggle, Slider, Tabs, Modal
		Tween(instance, time, props)
]]

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Theme = require(script.Parent.Theme)

local Components = {}

-- Wird vom UIController gesetzt, um Klick-Sounds abzuspielen.
Components.ClickCallback = nil

function Components.new(className: string, props, children)
	local instance = Instance.new(className)
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				instance[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

local new = Components.new

function Components.Tween(instance: Instance, time: number, props, style: Enum.EasingStyle?, direction: Enum.EasingDirection?)
	local tween = TweenService:Create(instance, TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

function Components.Corner(radius: number?)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or Theme.Corner) })
end

function Components.Stroke(color: Color3?, thickness: number?, transparency: number?)
	return new("UIStroke", {
		Color = color or Theme.Colors.Stroke,
		Thickness = thickness or 1.5,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Components.Padding(top: number, right: number?, bottom: number?, left: number?)
	return new("UIPadding", {
		PaddingTop = UDim.new(0, top),
		PaddingRight = UDim.new(0, right or top),
		PaddingBottom = UDim.new(0, bottom or top),
		PaddingLeft = UDim.new(0, left or right or top),
	})
end

function Components.List(direction: Enum.FillDirection?, padding: number?, horizontal: Enum.HorizontalAlignment?, vertical: Enum.VerticalAlignment?)
	return new("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 8),
		HorizontalAlignment = horizontal or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vertical or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function Components.Grid(cellSize: UDim2, padding: number?)
	return new("UIGridLayout", {
		CellSize = cellSize,
		CellPadding = UDim2.fromOffset(padding or 10, padding or 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

--- Textlabel. props werden direkt übernommen; Standard: transparent, Theme-Schrift.
function Components.Label(props)
	local label = new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Bold,
		TextColor3 = Theme.Colors.Text,
		TextSize = Theme.TextSize.Body,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		RichText = true,
		Size = UDim2.new(1, 0, 0, 24),
	})
	for key, value in props do
		if key ~= "MaxTextSize" then
			label[key] = value
		end
	end
	if props.TextScaled and props.MaxTextSize then
		new("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize, Parent = label })
	end
	return label
end

--- Panel (Frame mit Ecken und Rand).
function Components.Panel(props)
	local frame = new("Frame", {
		BackgroundColor3 = Theme.Colors.Panel,
		BackgroundTransparency = 0.05,
		BorderSizePixel = 0,
	})
	for key, value in props do
		if key ~= "NoStroke" and key ~= "StrokeColor" and key ~= "CornerRadius" then
			frame[key] = value
		end
	end
	Components.Corner(props.CornerRadius).Parent = frame
	if not props.NoStroke then
		Components.Stroke(props.StrokeColor).Parent = frame
	end
	return frame
end

--- Button mit Hover-/Klick-Animation. props.OnClick, props.Color, props.TextColor, props.Icon
function Components.Button(props)
	local color = props.Color or Theme.Colors.PanelLight
	local button = new("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Font = props.Font or Theme.Fonts.Bold,
		Text = props.Text or "",
		TextColor3 = props.TextColor or Theme.Colors.Text,
		TextSize = props.TextSize or Theme.TextSize.Body,
		Size = props.Size or UDim2.fromOffset(200, 48),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		Name = props.Name or "Button",
		Selectable = true,
		Visible = if props.Visible == nil then true else props.Visible,
		ZIndex = props.ZIndex or 1,
	})
	if props.TextScaled then
		button.TextScaled = true
		new("UITextSizeConstraint", { MaxTextSize = props.TextSize or Theme.TextSize.Body, Parent = button })
		Components.Padding(4, 10).Parent = button
	end
	Components.Corner(props.CornerRadius or Theme.SmallCorner).Parent = button
	local stroke = Components.Stroke(props.StrokeColor or Theme.Colors.Stroke, 1.5, if props.NoStroke then 1 else 0)
	stroke.Parent = button
	local scale = new("UIScale", { Parent = button })

	local base = color
	button:SetAttribute("BaseColor", base)
	local function baseColor()
		return button:GetAttribute("BaseColor") or base
	end
	button.MouseEnter:Connect(function()
		local c = baseColor()
		Components.Tween(button, 0.12, { BackgroundColor3 = c:Lerp(Color3.new(1, 1, 1), 0.12) })
		Components.Tween(scale, 0.12, { Scale = 1.03 })
	end)
	button.MouseLeave:Connect(function()
		Components.Tween(button, 0.12, { BackgroundColor3 = baseColor() })
		Components.Tween(scale, 0.12, { Scale = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		Components.Tween(scale, 0.06, { Scale = 0.96 })
	end)
	button.MouseButton1Up:Connect(function()
		Components.Tween(scale, 0.1, { Scale = 1 })
	end)
	button.Activated:Connect(function()
		if Components.ClickCallback then
			Components.ClickCallback()
		end
		if props.OnClick then
			props.OnClick()
		end
	end)
	return button
end

--- Ändert die Grundfarbe eines Buttons (inkl. Hover-Basis).
function Components.SetButtonColor(button: TextButton, color: Color3)
	button:SetAttribute("BaseColor", color)
	button.BackgroundColor3 = color
end

--- Fortschrittsbalken. Rückgabe: frame, setProgress(alpha, tweenTime?)
function Components.ProgressBar(props)
	local frame = new("Frame", {
		BackgroundColor3 = props.BackgroundColor or Theme.Colors.PanelDark,
		BorderSizePixel = 0,
		Size = props.Size or UDim2.fromOffset(200, 10),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		Name = props.Name or "ProgressBar",
		Parent = props.Parent,
	})
	Components.Corner(props.CornerRadius or 6).Parent = frame
	local fill = new("Frame", {
		Name = "Fill",
		BackgroundColor3 = props.Color or Theme.Colors.Accent,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		Parent = frame,
	})
	Components.Corner(props.CornerRadius or 6).Parent = fill
	local function set(alpha: number, tweenTime: number?)
		local target = UDim2.fromScale(math.clamp(alpha, 0, 1), 1)
		if tweenTime and tweenTime > 0 then
			Components.Tween(fill, tweenTime, { Size = target })
		else
			fill.Size = target
		end
	end
	return frame, set, fill
end

--- Schalter. Rückgabe: frame, setValue(boolean)
function Components.Toggle(props)
	local value = props.Value == true
	local frame = new("Frame", {
		BackgroundTransparency = 1,
		Size = props.Size or UDim2.new(1, 0, 0, 44),
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	Components.Label({ Text = props.Text, Size = UDim2.new(1, -90, 1, 0), Font = Theme.Fonts.Medium, Parent = frame })
	local track = new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(64, 30),
		BackgroundColor3 = Theme.Colors.PanelDark,
		BorderSizePixel = 0,
		Parent = frame,
	})
	Components.Corner(15).Parent = track
	Components.Stroke().Parent = track
	local knob = new("Frame", {
		Size = UDim2.fromOffset(24, 24),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		BackgroundColor3 = Theme.Colors.TextDim,
		BorderSizePixel = 0,
		Parent = track,
	})
	Components.Corner(12).Parent = knob
	local function render(animate: boolean)
		local time = if animate then 0.15 else 0
		Components.Tween(knob, time, {
			Position = if value then UDim2.new(1, -27, 0.5, 0) else UDim2.new(0, 3, 0.5, 0),
			BackgroundColor3 = if value then Theme.Colors.White else Theme.Colors.TextDim,
		})
		Components.Tween(track, time, { BackgroundColor3 = if value then Theme.Colors.Accent else Theme.Colors.PanelDark })
	end
	track.Activated:Connect(function()
		value = not value
		render(true)
		if Components.ClickCallback then
			Components.ClickCallback()
		end
		if props.OnChanged then
			props.OnChanged(value)
		end
	end)
	render(false)
	return frame, function(newValue: boolean)
		value = newValue
		render(false)
	end
end

--- Schieberegler. Rückgabe: frame, setValue(number)
function Components.Slider(props)
	local min, max = props.Min or 0, props.Max or 1
	local value = props.Value or min
	local frame = new("Frame", {
		BackgroundTransparency = 1,
		Size = props.Size or UDim2.new(1, 0, 0, 54),
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	local label = Components.Label({ Text = props.Text, Size = UDim2.new(1, 0, 0, 22), Font = Theme.Fonts.Medium, Parent = frame })
	local bar = new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		Position = UDim2.new(0, 0, 0, 30),
		Size = UDim2.new(1, -8, 0, 12),
		BackgroundColor3 = Theme.Colors.PanelDark,
		BorderSizePixel = 0,
		Parent = frame,
	})
	Components.Corner(6).Parent = bar
	local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Colors.Accent, BorderSizePixel = 0, Parent = bar })
	Components.Corner(6).Parent = fill
	local knob = new("Frame", {
		Size = UDim2.fromOffset(22, 22),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		BackgroundColor3 = Theme.Colors.White,
		BorderSizePixel = 0,
		Parent = bar,
	})
	Components.Corner(11).Parent = knob

	local function render()
		local alpha = (value - min) / (max - min)
		fill.Size = UDim2.fromScale(alpha, 1)
		knob.Position = UDim2.fromScale(alpha, 0.5)
		label.Text = string.format("%s: <b>%s</b>", props.Text, if props.Format then props.Format(value) else string.format("%d%%", math.floor(alpha * 100 + 0.5)))
	end
	local dragging = false
	local function setFromX(x: number)
		local alpha = math.clamp((x - bar.AbsolutePosition.X) / math.max(1, bar.AbsoluteSize.X), 0, 1)
		local newValue = min + (max - min) * alpha
		if props.Step then
			newValue = math.floor(newValue / props.Step + 0.5) * props.Step
		end
		if newValue ~= value then
			value = newValue
			render()
			if props.OnChanged then
				props.OnChanged(value)
			end
		end
	end
	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	render()
	return frame, function(newValue: number)
		value = math.clamp(newValue, min, max)
		render()
	end
end

--- Tab-Leiste. onSelect(name). Rückgabe: frame, select(name)
function Components.Tabs(props)
	local frame = new("Frame", {
		BackgroundTransparency = 1,
		Size = props.Size or UDim2.new(1, 0, 0, 40),
		Position = props.Position or UDim2.new(),
		Parent = props.Parent,
	}, { Components.List(Enum.FillDirection.Horizontal, 6) })
	local buttons = {}
	local function selectTab(name: string)
		for tabName, button in buttons do
			local active = tabName == name
			Components.SetButtonColor(button, if active then Theme.Colors.Accent else Theme.Colors.PanelLight)
			button.TextColor3 = if active then Theme.Colors.Background else Theme.Colors.Text
		end
		if props.OnSelect then
			props.OnSelect(name)
		end
	end
	for index, tab in props.Tabs do
		local button = Components.Button({
			Text = tab.Label,
			Size = UDim2.new(0, tab.Width or 130, 1, 0),
			TextSize = Theme.TextSize.Small,
			LayoutOrder = index,
			OnClick = function()
				selectTab(tab.Name)
			end,
		})
		button.Parent = frame
		buttons[tab.Name] = button
	end
	return frame, selectTab
end

--- Modales Fenster mit Titel und Schließen-Button.
--- Rückgabe-Objekt: { Root, Window, Content, Title, Open(), Close(), IsOpen(), OnClose (Callback-Feld) }
function Components.Modal(props)
	local modal = {}
	local root = new("Frame", {
		Name = props.Name or "Modal",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Colors.Black,
		BackgroundTransparency = 0.45,
		Visible = false,
		ZIndex = 20,
		Parent = props.Parent,
	})
	-- Fängt Klicks hinter dem Fenster ab
	new("TextButton", {
		Text = "",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 20,
		Parent = root,
	})
	local window = Components.Panel({
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = props.Size or UDim2.fromOffset(900, 560),
		BackgroundColor3 = Theme.Colors.Panel,
		ZIndex = 21,
		Parent = root,
	})
	local scale = new("UIScale", { Parent = window })
	local title = Components.Label({
		Text = props.Title or "",
		Font = Theme.Fonts.Title,
		TextSize = Theme.TextSize.Title,
		Position = UDim2.fromOffset(24, 16),
		Size = UDim2.new(1, -100, 0, 36),
		ZIndex = 22,
		Parent = window,
	})
	local close = Components.Button({
		Text = "✕",
		Size = UDim2.fromOffset(44, 44),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 12),
		Color = Theme.Colors.PanelLight,
		TextSize = 20,
		ZIndex = 22,
		OnClick = function()
			modal.Close()
		end,
	})
	close.Parent = window
	local content = new("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(24, 68),
		Size = UDim2.new(1, -48, 1, -88),
		ZIndex = 21,
		Parent = window,
	})

	modal.Root = root
	modal.Window = window
	modal.Content = content
	modal.Title = title
	modal.CloseButton = close
	function modal.IsOpen()
		return root.Visible
	end
	function modal.Open()
		if root.Visible then
			return
		end
		root.Visible = true
		scale.Scale = 0.9
		window.BackgroundTransparency = 0.3
		Components.Tween(scale, 0.18, { Scale = 1 }, Enum.EasingStyle.Back)
		Components.Tween(window, 0.18, { BackgroundTransparency = 0.05 })
		if modal.OnOpen then
			modal.OnOpen()
		end
	end
	function modal.Close()
		if not root.Visible then
			return
		end
		root.Visible = false
		if modal.OnClose then
			modal.OnClose()
		end
	end
	return modal
end

return Components
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="66">
            <Properties>
              <string name="Name">Screens</string>
            </Properties>
            <Item class="ModuleScript" referent="67">
              <Properties>
                <string name="Name">Catalog</string>
                <string name="Source"><![CDATA[--[[
	Catalog  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/UI/Screens/Catalog

	Shop und Inventar in einem Fenster (zwei Modi):
		Shop:      alle Items, Kaufen (Preis, Seltenheit, Levelvoraussetzung)
		Inventar:  nur eigene Items, Ausrüsten/Ablegen
	Links: 3D-Vorschau (ViewportFrame mit RunnerRig + Kosmetik, Emote-/Sieges-
	posen werden animiert), Beschreibung, Aktionen, Fehlermeldungen.
	Rechts: Raster aller Items der gewählten Kategorie.

	Alle Aktionen gehen über die RemoteFunction "ShopRequest" – der Server
	prüft Guthaben, Besitz und Doppelkäufe.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)
local RunnerRig = require(Shared.RunnerRig)
local CosmeticApplier = require(Shared.CosmeticApplier)
local CosmeticDefinitions = require(Shared.CosmeticDefinitions)

local UI = script.Parent.Parent
local Components = require(UI.Components)
local Theme = require(UI.Theme)

local new = Components.new

local Catalog = {}
Catalog.__index = Catalog

function Catalog.new(ui)
	local self = setmetatable({}, Catalog)
	self.UI = ui
	self.Mode = "Shop"
	self.Category = "Skins"
	self.Selected = nil
	self.Busy = false

	local modal = Components.Modal({ Name = "Catalog", Title = "SHOP", Size = UDim2.fromOffset(1060, 620), Parent = ui.Root })
	self.Modal = modal
	ui:RegisterModal("Catalog", modal)
	local content = modal.Content

	self.CoinLabel = Components.Label({
		Text = "",
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.Gold,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -70, 0, 22),
		Size = UDim2.fromOffset(260, 28),
		Parent = modal.Window,
	})

	local tabs = {}
	for _, category in CosmeticDefinitions.Categories do
		table.insert(tabs, { Name = category, Label = string.upper(CosmeticDefinitions.CategoryNames[category]), Width = if category == "Victory" then 200 else 130 })
	end
	local _, selectTab = Components.Tabs({
		Tabs = tabs,
		Size = UDim2.new(1, 0, 0, 38),
		Parent = content,
		OnSelect = function(name)
			self.Category = name
			self.Selected = nil
			self:_render()
		end,
	})
	self.SelectTab = selectTab

	-- Vorschau
	local previewPanel = Components.Panel({
		Position = UDim2.fromOffset(0, 50),
		Size = UDim2.new(0, 330, 1, -50),
		BackgroundColor3 = Theme.Colors.PanelDark,
		Parent = content,
	})
	local viewport = new("ViewportFrame", {
		Size = UDim2.new(1, -20, 0, 250),
		Position = UDim2.fromOffset(10, 10),
		BackgroundColor3 = Theme.Colors.Background,
		BackgroundTransparency = 0.3,
		Ambient = Color3.fromRGB(170, 170, 190),
		LightColor = Color3.fromRGB(255, 255, 255),
		LightDirection = Vector3.new(-1, -1, -1),
		Parent = previewPanel,
	})
	Components.Corner(10).Parent = viewport
	local worldModel = new("WorldModel", { Parent = viewport })
	local camera = new("Camera", { FieldOfView = 40, Parent = viewport })
	camera.CFrame = CFrame.lookAt(Vector3.new(0, 1.2, -10.5), Vector3.new(0, 0.2, 0))
	viewport.CurrentCamera = camera
	self.Viewport = viewport
	self.WorldModel = worldModel

	self.ItemName = Components.Label({
		Text = "",
		Font = Theme.Fonts.Title,
		TextSize = 24,
		Position = UDim2.fromOffset(14, 268),
		Size = UDim2.new(1, -28, 0, 28),
		Parent = previewPanel,
	})
	self.ItemRarity = Components.Label({
		Text = "",
		Font = Theme.Fonts.Bold,
		TextSize = Theme.TextSize.Small,
		Position = UDim2.fromOffset(14, 298),
		Size = UDim2.new(1, -28, 0, 18),
		Parent = previewPanel,
	})
	self.ItemDescription = Components.Label({
		Text = "",
		Font = Theme.Fonts.Medium,
		TextSize = Theme.TextSize.Small,
		TextColor3 = Theme.Colors.TextDim,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(14, 322),
		Size = UDim2.new(1, -28, 0, 60),
		Parent = previewPanel,
	})
	self.ActionButton = Components.Button({
		Text = "",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -40),
		Size = UDim2.new(1, -28, 0, 50),
		Color = Theme.Colors.Accent,
		TextColor = Theme.Colors.Background,
		Font = Theme.Fonts.Title,
		OnClick = function()
			self:_action()
		end,
	})
	self.ActionButton.Parent = previewPanel
	self.Message = Components.Label({
		Text = "",
		Font = Theme.Fonts.Bold,
		TextSize = Theme.TextSize.Small,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.new(1, -20, 0, 24),
		Parent = previewPanel,
	})

	-- Raster
	local grid = new("ScrollingFrame", {
		Position = UDim2.fromOffset(346, 50),
		Size = UDim2.new(1, -346, 1, -50),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = content,
	})
	Components.Grid(UDim2.fromOffset(152, 150), 12).Parent = grid
	Components.Padding(4).Parent = grid
	self.Grid = grid
	self.EmptyLabel = Components.Label({
		Text = "Noch keine Items in dieser Kategorie. Schau im Shop vorbei!",
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = Theme.Colors.TextDim,
		Position = UDim2.fromOffset(346, 120),
		Size = UDim2.new(1, -346, 0, 40),
		Visible = false,
		Parent = content,
	})

	modal.OnClose = function()
		self:_destroyPreview()
	end
	return self
end

function Catalog:Start()
	local state = self.UI.Ctx.ClientState
	state.ProfileChanged:Connect(function()
		if self.Modal.IsOpen() then
			self:_render()
		end
	end)
	RunService.RenderStepped:Connect(function()
		if self.Preview and self.Preview.Parent then
			self.Preview:PivotTo(CFrame.Angles(0, math.sin(os.clock() * 0.6) * 0.9, 0))
		end
	end)
end

--- Öffnet das Fenster im Modus "Shop" oder "Inventory".
function Catalog:Open(mode: string)
	self.Mode = mode
	self.Modal.Title.Text = if mode == "Shop" then "SHOP" else "INVENTAR"
	self.Selected = nil
	self.Message.Text = ""
	self.UI:OpenModal("Catalog")
	self.SelectTab(self.Category)
end

function Catalog:_profile()
	return self.UI.Ctx.ClientState.Profile
end

function Catalog:_owns(category: string, id: string): boolean
	local profile = self:_profile()
	return profile ~= nil and profile.Owned[category] ~= nil and profile.Owned[category][id] == true
end

function Catalog:_equipped(category: string): string
	local profile = self:_profile()
	return profile and profile.Equipped[category] or ""
end

function Catalog:_items()
	local list = {}
	for _, item in CosmeticDefinitions.Items[self.Category] do
		if self.Mode == "Shop" or self:_owns(self.Category, item.Id) then
			table.insert(list, item)
		end
	end
	table.sort(list, function(a, b)
		local ra = CosmeticDefinitions.Rarities[a.Rarity].Order
		local rb = CosmeticDefinitions.Rarities[b.Rarity].Order
		if ra ~= rb then
			return ra < rb
		end
		return a.Price < b.Price
	end)
	return list
end

local function swatchColors(item): { Color3 }
	if item.Category == "Skins" then
		return { item.Primary, item.Secondary, item.Accent }
	elseif item.Category == "Trails" then
		if item.Rainbow then
			return { Color3.fromRGB(255, 60, 60), Color3.fromRGB(80, 255, 80), Color3.fromRGB(60, 160, 255) }
		end
		return { item.ColorA, item.ColorB }
	elseif item.Category == "Effects" or item.Category == "Colors" then
		return { item.Color }
	end
	return { CosmeticDefinitions.Rarities[item.Rarity].Color }
end

function Catalog:_render()
	local profile = self:_profile()
	self.CoinLabel.Text = if profile then Util.FormatNumber(profile.Coins) .. " Coins" else ""
	for _, child in self.Grid:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local items = self:_items()
	self.EmptyLabel.Visible = #items == 0
	if not self.Selected or self.Selected.Category ~= self.Category then
		self.Selected = nil
		local equippedId = self:_equipped(self.Category)
		for _, item in items do
			if item.Id == equippedId then
				self.Selected = item
			end
		end
		self.Selected = self.Selected or items[1]
	end

	for index, item in items do
		local rarity = CosmeticDefinitions.Rarities[item.Rarity]
		local owned = self:_owns(item.Category, item.Id)
		local equipped = self:_equipped(item.Category) == item.Id
		local selected = self.Selected == item
		local card = Components.Button({
			Text = "",
			Size = UDim2.fromOffset(152, 150),
			Color = if selected then Theme.Colors.PanelLight else Theme.Colors.PanelDark,
			StrokeColor = if selected then Theme.Colors.Accent else rarity.Color,
			LayoutOrder = index,
			OnClick = function()
				self.Selected = item
				self.Message.Text = ""
				self:_render()
			end,
		})
		card.Parent = self.Grid
		local stripe = new("Frame", { Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = rarity.Color, BorderSizePixel = 0, Parent = card })
		Components.Corner(3).Parent = stripe
		local swatches = new("Frame", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, 18),
			Size = UDim2.new(1, -24, 0, 50),
			Parent = card,
		}, { Components.List(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center) })
		for i, color in swatchColors(item) do
			local swatch = new("Frame", { Size = UDim2.fromOffset(40, 40), BackgroundColor3 = color, BorderSizePixel = 0, LayoutOrder = i, Parent = swatches })
			Components.Corner(20).Parent = swatch
			Components.Stroke(Theme.Colors.White, 1, 0.6).Parent = swatch
		end
		Components.Label({
			Text = item.Name,
			Font = Theme.Fonts.Bold,
			TextSize = Theme.TextSize.Small,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(6, 74),
			Size = UDim2.new(1, -12, 0, 36),
			Parent = card,
		})
		local status
		local statusColor = Theme.Colors.TextDim
		if equipped then
			status = "AUSGERÜSTET"
			statusColor = Theme.Colors.Success
		elseif owned then
			status = "IM BESITZ"
			statusColor = Theme.Colors.Accent
		elseif item.LevelRequired and profile and profile.Level < item.LevelRequired then
			status = "AB LEVEL " .. item.LevelRequired
			statusColor = Theme.Colors.Danger
		else
			status = if item.Price == 0 then "GRATIS" else Util.FormatNumber(item.Price) .. " C"
			statusColor = Theme.Colors.Gold
		end
		Components.Label({
			Text = status,
			Font = Theme.Fonts.Title,
			TextSize = Theme.TextSize.Small,
			TextColor3 = statusColor,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.new(0, 6, 1, -30),
			Size = UDim2.new(1, -12, 0, 22),
			Parent = card,
		})
	end
	self:_renderDetail()
end

function Catalog:_renderDetail()
	local item = self.Selected
	if not item then
		self.ItemName.Text = ""
		self.ItemRarity.Text = ""
		self.ItemDescription.Text = ""
		self.ActionButton.Visible = false
		self:_destroyPreview()
		return
	end
	local rarity = CosmeticDefinitions.Rarities[item.Rarity]
	self.ItemName.Text = item.Name
	self.ItemRarity.Text = string.upper(rarity.Name) .. " · " .. string.upper(CosmeticDefinitions.CategoryNames[item.Category])
	self.ItemRarity.TextColor3 = rarity.Color
	local description = item.Description or ""
	if item.Category == "Trails" or item.Category == "Effects" then
		description ..= "\n(Trails und Partikel sind im Spiel sichtbar, nicht in der Vorschau.)"
	end
	self.ItemDescription.Text = description

	local owned = self:_owns(item.Category, item.Id)
	local equipped = self:_equipped(item.Category) == item.Id
	self.ActionButton.Visible = true
	if equipped then
		if CosmeticDefinitions.Unequippable[item.Category] then
			self.ActionButton.Text = "ABLEGEN"
			Components.SetButtonColor(self.ActionButton, Theme.Colors.PanelLight)
			self.ActionButton.TextColor3 = Theme.Colors.Text
		else
			self.ActionButton.Text = "AUSGERÜSTET"
			Components.SetButtonColor(self.ActionButton, Theme.Colors.Success)
			self.ActionButton.TextColor3 = Theme.Colors.Background
		end
	elseif owned then
		self.ActionButton.Text = "AUSRÜSTEN"
		Components.SetButtonColor(self.ActionButton, Theme.Colors.Accent)
		self.ActionButton.TextColor3 = Theme.Colors.Background
	else
		self.ActionButton.Text = if item.Price == 0 then "GRATIS HOLEN" else "KAUFEN · " .. Util.FormatNumber(item.Price) .. " C"
		Components.SetButtonColor(self.ActionButton, Theme.Colors.Gold)
		self.ActionButton.TextColor3 = Theme.Colors.Background
	end
	self:_updatePreview(item)
end

function Catalog:_destroyPreview()
	if self.Preview then
		self.UI.Ctx.AnimationController:UnregisterPreview(self.Preview)
		self.Preview:Destroy()
		self.Preview = nil
	end
end

function Catalog:_updatePreview(item)
	local profile = self:_profile()
	local equipped = if profile then table.clone(profile.Equipped) else table.clone(CosmeticDefinitions.DefaultEquipped)
	equipped[item.Category] = item.Id
	if not self.Preview then
		local rig = RunnerRig.Build({ ForCharacter = false })
		for _, part in rig:GetDescendants() do
			if part:IsA("BasePart") then
				part.Anchored = part.Name == "HumanoidRootPart"
			end
		end
		rig.Parent = self.WorldModel
		self.Preview = rig
		self.UI.Ctx.AnimationController:RegisterPreview(rig, function()
			return self.PreviewPose
		end)
	end
	CosmeticApplier.Apply(self.Preview, equipped)
	if item.Category == "Emotes" then
		self.PreviewPose = item.Id
	elseif item.Category == "Victory" then
		self.PreviewPose = "Victory"
	else
		self.PreviewPose = "Idle"
	end
end

function Catalog:_action()
	local item = self.Selected
	if not item or self.Busy then
		return
	end
	local owned = self:_owns(item.Category, item.Id)
	local equipped = self:_equipped(item.Category) == item.Id
	local action
	if equipped then
		if not CosmeticDefinitions.Unequippable[item.Category] then
			return
		end
		action = "Unequip"
	elseif owned then
		action = "Equip"
	else
		action = "Buy"
	end
	self.Busy = true
	self.Message.Text = "..."
	self.Message.TextColor3 = Theme.Colors.TextDim
	local ok, result = pcall(function()
		return Remotes.ShopRequest:InvokeServer(action, item.Category, item.Id)
	end)
	self.Busy = false
	if not ok or type(result) ~= "table" then
		self.Message.Text = "Verbindungsfehler – bitte erneut versuchen."
		self.Message.TextColor3 = Theme.Colors.Danger
		return
	end
	self.Message.Text = result.Message or ""
	self.Message.TextColor3 = if result.Ok then Theme.Colors.Success else Theme.Colors.Danger
	if result.Ok and action == "Buy" then
		-- Direkt nach dem Kauf ausrüsten (bequemer)
		pcall(function()
			Remotes.ShopRequest:InvokeServer("Equip", item.Category, item.Id)
		end)
	end
end

return Catalog
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="68">
              <Properties>
                <string name="Name">Leaderboard</string>
                <string name="Source"><![CDATA[--[[
	Leaderboard  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/UI/Screens/Leaderboard

	Bestenlisten: Siege (global), Rating der Saison (global) und dieser Server.
	Daten kommen gecacht vom Server (RemoteFunction "GetLeaderboard").
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local UI = script.Parent.Parent
local Components = require(UI.Components)
local Theme = require(UI.Theme)

local player = Players.LocalPlayer
local new = Components.new

local Leaderboard = {}
Leaderboard.__index = Leaderboard

function Leaderboard.new(ui)
	local self = setmetatable({}, Leaderboard)
	self.UI = ui
	self.Tab = "Server"
	self.Data = nil
	local modal = Components.Modal({ Name = "Leaderboard", Title = "BESTENLISTE", Size = UDim2.fromOffset(760, 600), Parent = ui.Root })
	self.Modal = modal
	ui:RegisterModal("Leaderboard", modal)

	local _, select = Components.Tabs({
		Tabs = {
			{ Name = "Server", Label = "DIESER SERVER", Width = 200 },
			{ Name = "Wins", Label = "SIEGE (GLOBAL)", Width = 200 },
			{ Name = "Rating", Label = "RATING (SAISON)", Width = 200 },
		},
		Parent = modal.Content,
		OnSelect = function(name)
			self.Tab = name
			self:_render()
		end,
	})
	self.Select = select
	self.Status = Components.Label({
		Text = "",
		TextColor3 = Theme.Colors.TextDim,
		Font = Theme.Fonts.Medium,
		Position = UDim2.fromOffset(0, 48),
		Size = UDim2.new(1, 0, 0, 22),
		Parent = modal.Content,
	})
	self.List = new("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 76),
		Size = UDim2.new(1, 0, 1, -76),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = modal.Content,
	}, { Components.List(Enum.FillDirection.Vertical, 6) })

	modal.OnOpen = function()
		self:_fetch()
		self.Select(self.Tab)
	end
	return self
end

function Leaderboard:Start() end

function Leaderboard:_fetch()
	self.Status.Text = "Lädt …"
	task.spawn(function()
		local ok, data = pcall(function()
			return Remotes.GetLeaderboard:InvokeServer()
		end)
		if ok and type(data) == "table" then
			self.Data = data
		end
		if self.Modal.IsOpen() then
			self:_render()
		end
	end)
end

function Leaderboard:_render()
	for _, child in self.List:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local data = self.Data
	if not data then
		self.Status.Text = "Bestenliste wird geladen …"
		return
	end
	local entries = data[self.Tab] or {}
	if self.Tab ~= "Server" and not data.Available then
		self.Status.Text = "Globale Bestenlisten benötigen DataStore-Zugriff (in Studio: API-Zugriff aktivieren)."
	elseif #entries == 0 then
		self.Status.Text = "Noch keine Einträge."
	else
		self.Status.Text = if self.Tab == "Server" then "Spieler auf diesem Server (nach Siegen)" else "Top " .. #entries
	end
	for index, entry in entries do
		local isMe = entry.UserId == player.UserId
		local row = Components.Panel({
			Size = UDim2.new(1, -10, 0, 44),
			BackgroundColor3 = if isMe then Theme.Colors.PanelLight else Theme.Colors.PanelDark,
			StrokeColor = if entry.Rank == 1 then Theme.Colors.Gold elseif entry.Rank <= 3 then Theme.Colors.Accent else Theme.Colors.Stroke,
			LayoutOrder = index,
			Parent = self.List,
		})
		Components.Label({
			Text = "#" .. tostring(entry.Rank),
			Font = Theme.Fonts.Title,
			TextColor3 = if entry.Rank == 1 then Theme.Colors.Gold else Theme.Colors.Text,
			Position = UDim2.fromOffset(14, 0),
			Size = UDim2.new(0, 70, 1, 0),
			Parent = row,
		})
		Components.Label({
			Text = entry.Name or "?",
			Font = Theme.Fonts.Bold,
			TextColor3 = if isMe then Theme.Colors.Accent else Theme.Colors.Text,
			Position = UDim2.fromOffset(84, 0),
			Size = UDim2.new(1, -300, 1, 0),
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextWrapped = false,
			Parent = row,
		})
		local valueText
		if self.Tab == "Server" then
			valueText = string.format("%d Siege · Lv. %d · %d RP", entry.Wins or 0, entry.Level or 1, entry.Rating or 0)
		elseif self.Tab == "Wins" then
			valueText = Util.FormatNumber(entry.Value or 0) .. " Siege"
		else
			valueText = Util.FormatNumber(entry.Value or 0) .. " RP"
		end
		Components.Label({
			Text = valueText,
			Font = Theme.Fonts.Bold,
			TextXAlignment = Enum.TextXAlignment.Right,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -14, 0, 0),
			Size = UDim2.fromOffset(240, 44),
			Parent = row,
		})
	end
end

return Leaderboard
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="69">
              <Properties>
                <string name="Name">LobbyMenu</string>
                <string name="Source"><![CDATA[--[[
	LobbyMenu  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/UI/Screens/LobbyMenu

	Hauptmenü in der Lobby (links) und Status-Karte (unten mittig):
		- Schnelles Spiel / Ranked beitreten bzw. verlassen
		- Training, Shop, Inventar, Statistik, Bestenliste, Einstellungen
		- Warteschlangenstatus mit Countdown und nächster Map
		- laufendes Rennen anzeigen + Zuschauen
		- Trainingsleiste (Checkpoint, Verlassen)
	Mit M (Gamepad: Select) einklappbar.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local MapDefinitions = require(Shared.MapDefinitions)

local UI = script.Parent.Parent
local Components = require(UI.Components)
local Theme = require(UI.Theme)

local player = Players.LocalPlayer

local LobbyMenu = {}
LobbyMenu.__index = LobbyMenu

local function mapName(id: string?): string
	local definition = id and MapDefinitions.GetAny(id)
	return if definition then definition.Name else "—"
end

function LobbyMenu.new(ui)
	local self = setmetatable({}, LobbyMenu)
	self.UI = ui
	self.Collapsed = false

	local menu = Components.new("Frame", {
		Name = "LobbyMenu",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(16, 160),
		Size = UDim2.fromOffset(260, 520),
		Parent = ui.Root,
	}, { Components.List(Enum.FillDirection.Vertical, 8) })
	self.Menu = menu

	local function menuButton(order: number, text: string, color: Color3?, textColor: Color3?, onClick)
		local button = Components.Button({
			Text = text,
			Size = UDim2.fromOffset(260, if order <= 2 then 58 else 46),
			Color = color or Theme.Colors.PanelLight,
			TextColor = textColor,
			TextSize = if order <= 2 then Theme.TextSize.Large else Theme.TextSize.Body,
			Font = if order <= 2 then Theme.Fonts.Title else Theme.Fonts.Bold,
			LayoutOrder = order,
			OnClick = onClick,
		})
		button.Parent = menu
		return button
	end

	self.QuickButton = menuButton(1, "SCHNELLES SPIEL", Theme.Colors.Accent, Theme.Colors.Background, function()
		self:_toggleQueue("QuickPlay")
	end)
	self.RankedButton = menuButton(2, "RANKED", Theme.Colors.Gold, Theme.Colors.Background, function()
		self:_toggleQueue("Ranked")
	end)
	menuButton(3, "TRAINING", nil, nil, function()
		ui:OpenModal("Practice")
	end)
	menuButton(4, "SHOP", nil, nil, function()
		ui.Screens.Catalog:Open("Shop")
	end)
	menuButton(5, "INVENTAR", nil, nil, function()
		ui.Screens.Catalog:Open("Inventory")
	end)
	menuButton(6, "STATISTIK & AUFGABEN", nil, nil, function()
		ui:OpenModal("Stats")
	end)
	menuButton(7, "BESTENLISTE", nil, nil, function()
		ui:OpenModal("Leaderboard")
	end)
	menuButton(8, "EINSTELLUNGEN", nil, nil, function()
		ui:OpenModal("Settings")
	end)
	Components.Label({
		Text = "M: Menü ein/aus · G: Emote",
		TextSize = Theme.TextSize.Tiny,
		Font = Theme.Fonts.Medium,
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.fromOffset(260, 18),
		LayoutOrder = 9,
		Parent = menu,
	})

	-- Menü-Schalter (wichtig für Touch-Geräte ohne M-Taste)
	self.ToggleButton = Components.Button({
		Text = "MENÜ",
		Position = UDim2.fromOffset(466, 74),
		Size = UDim2.fromOffset(100, 46),
		OnClick = function()
			self:ToggleCollapsed()
		end,
	})
	self.ToggleButton.Parent = ui.Root

	-- Status-Karte
	local card = Components.Panel({
		Name = "StatusCard",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -22),
		Size = UDim2.fromOffset(560, 104),
		BackgroundColor3 = Theme.Colors.PanelDark,
		BackgroundTransparency = 0.1,
		Parent = ui.Root,
	})
	self.Card = card
	self.CardTitle = Components.Label({
		Text = "",
		Font = Theme.Fonts.Title,
		TextSize = Theme.TextSize.Large,
		Position = UDim2.fromOffset(18, 12),
		Size = UDim2.new(1, -200, 0, 28),
		TextColor3 = Theme.Colors.Accent,
		Parent = card,
	})
	self.CardLine1 = Components.Label({
		Text = "",
		Font = Theme.Fonts.Medium,
		TextSize = Theme.TextSize.Body,
		Position = UDim2.fromOffset(18, 44),
		Size = UDim2.new(1, -200, 0, 22),
		Parent = card,
	})
	self.CardLine2 = Components.Label({
		Text = "",
		Font = Theme.Fonts.Medium,
		TextSize = Theme.TextSize.Small,
		TextColor3 = Theme.Colors.TextDim,
		Position = UDim2.fromOffset(18, 70),
		Size = UDim2.new(1, -200, 0, 20),
		Parent = card,
	})
	self.CardButton = Components.Button({
		Text = "",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.5, 0),
		Size = UDim2.fromOffset(164, 54),
		Color = Theme.Colors.Accent,
		TextColor = Theme.Colors.Background,
		Font = Theme.Fonts.Title,
		OnClick = function()
			if self.CardAction then
				self.CardAction()
			end
		end,
	})
	self.CardButton.Parent = card
	self.CardButton2 = Components.Button({
		Text = "",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 10),
		Size = UDim2.fromOffset(164, 38),
		Visible = false,
		OnClick = function()
			if self.CardAction2 then
				self.CardAction2()
			end
		end,
	})
	self.CardButton2.Parent = card
	return self
end

function LobbyMenu:Start()
	-- Auf reinen Touch-Geräten startet das Menü eingeklappt (Platz für die Steuerung)
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		self:ToggleCollapsed()
	end
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator >= 0.15 then
			accumulator = 0
			self:_refresh()
		end
	end)
	self:_refresh()
end

--- True, wenn das Menü gerade sichtbar und ausgeklappt ist.
function LobbyMenu:IsOpen(): boolean
	return self.Menu.Visible and not self.Collapsed
end

function LobbyMenu:ToggleCollapsed()
	self.Collapsed = not self.Collapsed
	self.ToggleButton.Text = if self.Collapsed then "MENÜ" else "SCHLIESSEN"
	Components.Tween(self.Menu, 0.25, {
		Position = if self.Collapsed then UDim2.fromOffset(-300, 160) else UDim2.fromOffset(16, 160),
	})
end

function LobbyMenu:_toggleQueue(mode: string)
	local queued = player:GetAttribute("Queue") or ""
	if queued == mode then
		Remotes.QueueRequest:FireServer("Leave", mode)
	else
		Remotes.QueueRequest:FireServer("Join", mode)
	end
end

function LobbyMenu:_setCard(title: string, line1: string, line2: string, buttonText: string?, action, color: Color3?)
	self.CardTitle.Text = title
	self.CardLine1.Text = line1
	self.CardLine2.Text = line2
	self.CardButton.Visible = buttonText ~= nil
	self.CardButton.Text = buttonText or ""
	Components.SetButtonColor(self.CardButton, color or Theme.Colors.Accent)
	self.CardAction = action
end

function LobbyMenu:_setSecond(text: string?, action)
	self.CardButton2.Visible = text ~= nil
	self.CardButton2.Text = text or ""
	self.CardAction2 = action
	if text then
		self.CardButton.Position = UDim2.new(1, -16, 1, -10)
		self.CardButton.AnchorPoint = Vector2.new(1, 1)
		self.CardButton.Size = UDim2.fromOffset(164, 40)
	else
		self.CardButton.Position = UDim2.new(1, -16, 0.5, 0)
		self.CardButton.AnchorPoint = Vector2.new(1, 0.5)
		self.CardButton.Size = UDim2.fromOffset(164, 54)
	end
end

function LobbyMenu:_refresh()
	local ctx = self.UI.Ctx
	local state = ctx.ClientState
	local gameState = state.GameState
	local spectating = ctx.CameraController:GetSpectate() ~= nil
	local inRace = state:IsInRace()
	local visible = not inRace and not spectating
	self.Menu.Visible = visible
	self.Card.Visible = visible
	self.ToggleButton.Visible = visible
	if not visible then
		return
	end

	local queue = player:GetAttribute("Queue") or ""
	local course = state:GetPracticeCourse()
	local phase = gameState:GetAttribute("Phase") or "Waiting"
	local nextMap = mapName(gameState:GetAttribute("NextMapId"))
	local minPlayers = gameState:GetAttribute("MinPlayers") or 2
	local maxPlayers = gameState:GetAttribute("MaxPlayers") or 8

	self.QuickButton.Text = if queue == "QuickPlay" then "QUEUE VERLASSEN" else "SCHNELLES SPIEL"
	self.RankedButton.Text = if queue == "Ranked" then "RANKED VERLASSEN" else "RANKED"

	self:_setSecond(nil)
	if course ~= "" then
		local queueInfo = if queue ~= "" then "  ·  In Warteschlange" else ""
		self:_setCard(
			"TRAINING: " .. string.upper(mapName(course)),
			"Keine Wertung, keine Belohnungen – übe in Ruhe." .. queueInfo,
			"R = zum Checkpoint  ·  Das Rennen holt dich automatisch ab.",
			"VERLASSEN",
			function()
				Remotes.PracticeRequest:FireServer("Leave")
			end,
			Theme.Colors.Danger
		)
		self:_setSecond("CHECKPOINT", function()
			Remotes.PracticeRequest:FireServer("Reset")
		end)
	elseif queue ~= "" then
		local count = gameState:GetAttribute(if queue == "Ranked" then "QueueRanked" else "QueueQuickPlay") or 0
		local modeName = if queue == "Ranked" then "RANKED" else "SCHNELLES SPIEL"
		local line2 = "Nächste Map: " .. nextMap
		if phase == "Starting" and gameState:GetAttribute("Mode") == queue then
			local remaining = math.max(0, math.ceil((gameState:GetAttribute("PhaseEndsAt") or 0) - workspace:GetServerTimeNow()))
			line2 = string.format("Rennen startet in %d s  ·  Map: %s", remaining, nextMap)
		elseif phase ~= "Waiting" and phase ~= "Starting" then
			line2 = "Ein Rennen läuft – du bist in der nächsten Runde dabei."
		end
		self:_setCard(
			"WARTESCHLANGE · " .. modeName,
			string.format("%d / %d Spieler (mindestens %d)", count, maxPlayers, minPlayers),
			line2,
			"VERLASSEN",
			function()
				Remotes.QueueRequest:FireServer("Leave", queue)
			end,
			Theme.Colors.Danger
		)
	elseif (phase == "Countdown" or phase == "Racing" or phase == "Loading") and (gameState:GetAttribute("MapId") or "") ~= "" then
		self:_setCard(
			"RENNEN LÄUFT · " .. string.upper(mapName(gameState:GetAttribute("MapId"))),
			string.format("%d von %d Spielern noch im Rennen", gameState:GetAttribute("Alive") or 0, gameState:GetAttribute("Participants") or 0),
			"Stell dich an, um in der nächsten Runde dabei zu sein.",
			"ZUSCHAUEN",
			function()
				self.UI.Screens.RaceHud:StartSpectating()
			end
		)
		self:_setSecond("ANSTELLEN", function()
			Remotes.QueueRequest:FireServer("Join", "QuickPlay")
		end)
	else
		self:_setCard(
			"BEREIT FÜR DAS NÄCHSTE RENNEN?",
			"Nächste Map: " .. nextMap,
			string.format("Mindestens %d Spieler · bis zu %d pro Rennen", minPlayers, maxPlayers),
			"SPIELEN",
			function()
				Remotes.QueueRequest:FireServer("Join", "QuickPlay")
			end
		)
	end
end

return LobbyMenu
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="70">
              <Properties>
                <string name="Name">Notifications</string>
                <string name="Source"><![CDATA[--[[
	Notifications  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/UI/Screens/Notifications

	Kurze Hinweise oben in der Bildschirmmitte (Info, Erfolg, Warnung, Fehler)
	sowie Meldungen zu Aufgaben, Erfolgen und Level-Ups.
]]

local UI = script.Parent.Parent
local Components = require(UI.Components)
local Theme = require(UI.Theme)

local Notifications = {}
Notifications.__index = Notifications

local KIND_COLORS = {
	Info = Theme.Colors.Accent,
	Success = Theme.Colors.Success,
	Warning = Theme.Colors.Warning,
	Error = Theme.Colors.Danger,
	Reward = Theme.Colors.Gold,
}

function Notifications.new(ui)
	local self = setmetatable({}, Notifications)
	self.UI = ui
	self.Container = Components.new("Frame", {
		Name = "Notifications",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 176),
		Size = UDim2.fromOffset(560, 300),
		ZIndex = 50,
		Parent = ui.Root,
	}, { Components.List(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center) })
	self.Count = 0
	return self
end

function Notifications:Start()
	local state = self.UI.Ctx.ClientState
	state:On("Notify", function(payload)
		self:Push(payload.Text or "", payload.Kind)
	end)
	state:On("QuestCompleted", function(payload)
		self:Push(string.format("Aufgabe erledigt: %s  (+%d Coins, +%d XP)", payload.Name, payload.Coins, payload.XP), "Reward")
	end)
	state:On("AchievementUnlocked", function(payload)
		self:Push(string.format("Erfolg freigeschaltet: %s  (+%d Coins)", payload.Name, payload.Coins), "Reward")
	end)
	state:On("LevelUp", function(payload)
		self:Push(string.format("LEVEL UP! Du bist jetzt Level %d  (+%d Coins)", payload.Level, payload.Coins), "Reward")
	end)
end

function Notifications:Push(text: string, kind: string?)
	if text == "" then
		return
	end
	local color = KIND_COLORS[kind or "Info"] or Theme.Colors.Accent
	self.Count += 1
	local toast = Components.Panel({
		Name = "Toast",
		Size = UDim2.fromOffset(540, 46),
		BackgroundColor3 = Theme.Colors.PanelDark,
		BackgroundTransparency = 1,
		StrokeColor = color,
		LayoutOrder = self.Count,
		ZIndex = 50,
		Parent = self.Container,
	})
	local bar = Components.new("Frame", {
		Size = UDim2.new(0, 6, 1, -12),
		Position = UDim2.fromOffset(8, 6),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		ZIndex = 51,
		Parent = toast,
	})
	Components.Corner(3).Parent = bar
	local label = Components.Label({
		Text = text,
		Position = UDim2.fromOffset(24, 0),
		Size = UDim2.new(1, -36, 1, 0),
		TextScaled = true,
		MaxTextSize = Theme.TextSize.Body,
		TextTransparency = 1,
		ZIndex = 51,
		Parent = toast,
	})
	Components.Tween(toast, 0.2, { BackgroundTransparency = 0.08 })
	Components.Tween(label, 0.2, { TextTransparency = 0 })

	local toasts = {}
	for _, child in self.Container:GetChildren() do
		if child.Name == "Toast" then
			table.insert(toasts, child)
		end
	end
	if #toasts > 4 then
		table.sort(toasts, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		toasts[1]:Destroy()
	end

	task.delay(3.6, function()
		if toast.Parent then
			Components.Tween(toast, 0.3, { BackgroundTransparency = 1 })
			Components.Tween(label, 0.3, { TextTransparency = 1 })
			task.wait(0.32)
			toast:Destroy()
		end
	end)
end

return Notifications
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="71">
              <Properties>
                <string name="Name">Practice</string>
                <string name="Source"><![CDATA[--[[
	Practice  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/UI/Screens/Practice

	Auswahl des Trainingsmodus: Bewegungs-Tutorial oder freies Training auf
	einer der Rennstrecken (ohne Gefahrenzone, ohne Belohnungen).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local MapDefinitions = require(Shared.MapDefinitions)

local UI = script.Parent.Parent
local Components = require(UI.Components)
local Theme = require(UI.Theme)

local new = Components.new

local Practice = {}
Practice.__index = Practice

function Practice.new(ui)
	local self = setmetatable({}, Practice)
	self.UI = ui
	local modal = Components.Modal({ Name = "Practice", Title = "TRAINING", Size = UDim2.fromOffset(900, 580), Parent = ui.Root })
	self.Modal = modal
	ui:RegisterModal("Practice", modal)

	Components.Label({
		Text = "Übe Bewegung, Greifhaken und Abkürzungen ohne Druck. Im Training gibt es keine Gefahrenzone, keine Coins, keine XP und keine Statistiken. Startet ein Rennen, wirst du automatisch abgeholt.",
		Font = Theme.Fonts.Medium,
		TextSize = Theme.TextSize.Small,
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, 0, 0, 40),
		Parent = modal.Content,
	})
	local list = new("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 50),
		Size = UDim2.new(1, 0, 1, -50),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = modal.Content,
	}, { Components.List(Enum.FillDirection.Vertical, 8) })

	local courses = { MapDefinitions.Tutorial }
	for _, id in MapDefinitions.Order do
		table.insert(courses, MapDefinitions.Maps[id])
	end
	for index, definition in courses do
		local row = Components.Panel({
			Size = UDim2.new(1, -10, 0, 74),
			BackgroundColor3 = Theme.Colors.PanelDark,
			StrokeColor = definition.Theme.Accent,
			LayoutOrder = index,
			Parent = list,
		})
		local swatch = new("Frame", { Position = UDim2.fromOffset(12, 12), Size = UDim2.fromOffset(50, 50), BackgroundColor3 = definition.Theme.Accent, BorderSizePixel = 0, Parent = row })
		Components.Corner(10).Parent = swatch
		Components.Label({
			Text = definition.Name .. "  " .. string.rep("★", definition.Difficulty or 1) .. string.rep("☆", 3 - (definition.Difficulty or 1)),
			Font = Theme.Fonts.Title,
			Position = UDim2.fromOffset(76, 10),
			Size = UDim2.new(1, -260, 0, 26),
			Parent = row,
		})
		Components.Label({
			Text = definition.Description or "",
			Font = Theme.Fonts.Medium,
			TextSize = Theme.TextSize.Small,
			TextColor3 = Theme.Colors.TextDim,
			Position = UDim2.fromOffset(76, 38),
			Size = UDim2.new(1, -260, 0, 30),
			Parent = row,
		})
		local button = Components.Button({
			Text = "STARTEN",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -14, 0.5, 0),
			Size = UDim2.fromOffset(160, 46),
			Color = Theme.Colors.Success,
			TextColor = Theme.Colors.Background,
			Font = Theme.Fonts.Title,
			OnClick = function()
				Remotes.PracticeRequest:FireServer("Enter", definition.Id)
				modal.Close()
			end,
		})
		button.Parent = row
	end
	return self
end

function Practice:Start()
	self.UI.Ctx.ClientState:On("OpenScreen", function(payload)
		if payload.Screen == "Practice" then
			self.UI:OpenModal("Practice")
		end
	end)
end

return Practice
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="72">
              <Properties>
                <string name="Name">RaceHud</string>
                <string name="Source"><![CDATA[--[[
	RaceHud  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/UI/Screens/RaceHud

	Renn-Oberfläche:
		- Countdown (3-2-1-LOS!), Renn-Timer, Map/Modus
		- Streckenfortschritt mit allen Spielern, Checkpoints und Gefahrenzone
		- Live-Platzierungen
		- Gefahrenring-Warnung (Banner, roter Bildschirmrand, Restzeit)
		- Power-up-Slot und Cooldown-Anzeigen (Haken, Dash, Slide)
		- Ereignis-Feed, Ausgeschieden-Panel, Zuschauermodus
		- Pfeile für Spieler außerhalb des Bildschirms
	Im Training werden nur Item-Slot und Cooldowns angezeigt.

	API:
		:StartSpectating()
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local MapDefinitions = require(Shared.MapDefinitions)
local ItemDefinitions = require(Shared.ItemDefinitions)

local UI = script.Parent.Parent
local Components = require(UI.Components)
local Theme = require(UI.Theme)

local player = Players.LocalPlayer
local new = Components.new

local RaceHud = {}
RaceHud.__index = RaceHud

local KEY_HINTS = {
	Keyboard = { Grapple = "E", Dash = "SHIFT", Slide = "SHIFT", Item = "Q" },
	Gamepad = { Grapple = "X", Dash = "B", Slide = "B", Item = "Y" },
	Touch = { Grapple = "", Dash = "", Slide = "", Item = "" },
}

local STATUS_TEXT = {
	Racing = "",
	Eliminated = "RAUS",
	Left = "WEG",
	Finished = "ZIEL",
	Survived = "",
}

local REASON_TEXT = {
	Zone = "von der Gefahrenzone erwischt",
	Left = "hat das Spiel verlassen",
}

function RaceHud.new(ui)
	local self = setmetatable({}, RaceHud)
	self.UI = ui
	self.Ctx = ui.Ctx
	self.LastCountdown = nil
	self.LastZoneState = "Inactive"
	self.BannerUntil = 0
	self.FinalTime = nil
	self.Rows = {}
	self.Dots = {}

	local root = new("Frame", { Name = "RaceHud", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = ui.Root })
	self.Root = root

	-- Gefahren-Vignette (vier Ränder mit Farbverlauf)
	self.Vignette = {}
	local edges = {
		{ Size = UDim2.new(0, 220, 1, 0), Position = UDim2.fromScale(0, 0), Rotation = 0 },
		{ Size = UDim2.new(0, 220, 1, 0), Position = UDim2.new(1, -220, 0, 0), Rotation = 180 },
		{ Size = UDim2.new(1, 0, 0, 160), Position = UDim2.fromScale(0, 0), Rotation = 90 },
		{ Size = UDim2.new(1, 0, 0, 160), Position = UDim2.new(0, 0, 1, -160), Rotation = 270 },
	}
	for _, edge in edges do
		local frame = new("Frame", {
			Size = edge.Size,
			Position = edge.Position,
			BackgroundColor3 = Theme.Colors.Danger,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Parent = root,
		})
		new("UIGradient", {
			Rotation = edge.Rotation,
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
			Parent = frame,
		})
		table.insert(self.Vignette, frame)
	end

	-- Kopfbereich: Map, Timer, Fortschritt
	local top = new("Frame", {
		Name = "Top",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(660, 110),
		Parent = root,
	})
	self.Top = top
	self.MapLabel = Components.Label({
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = Theme.TextSize.Small,
		Font = Theme.Fonts.Bold,
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, 0, 0, 18),
		Parent = top,
	})
	self.TimerLabel = Components.Label({
		Text = "0:00.00",
		TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = 40,
		Font = Theme.Fonts.Title,
		Position = UDim2.fromOffset(0, 18),
		Size = UDim2.new(1, 0, 0, 44),
		TextStrokeTransparency = 0.6,
		Parent = top,
	})
	local track = new("Frame", {
		Name = "Track",
		Position = UDim2.new(0, 30, 0, 74),
		Size = UDim2.new(1, -60, 0, 14),
		BackgroundColor3 = Theme.Colors.PanelDark,
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
		Parent = top,
	})
	Components.Corner(7).Parent = track
	Components.Stroke(Theme.Colors.Stroke, 1.5).Parent = track
	self.Track = track
	self.ZoneFill = new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Colors.Danger,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = track,
	})
	Components.Corner(7).Parent = self.ZoneFill
	Components.Label({
		Text = "ZIEL",
		Font = Theme.Fonts.Title,
		TextSize = 12,
		TextColor3 = Theme.Colors.Gold,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(1, 6, 0.5, 0),
		Size = UDim2.fromOffset(40, 14),
		Parent = track,
	})
	self.TickHolder = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 3, Parent = track })
	self.DotHolder = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 4, Parent = track })

	self.Banner = Components.Label({
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Theme.Fonts.Title,
		TextSize = 30,
		TextColor3 = Theme.Colors.Danger,
		TextStrokeTransparency = 0.4,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 128),
		Size = UDim2.fromOffset(700, 40),
		Visible = false,
		Parent = root,
	})

	self.Countdown = Components.Label({
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Theme.Fonts.Title,
		TextSize = 140,
		TextStrokeTransparency = 0.3,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.4),
		Size = UDim2.fromOffset(600, 170),
		Visible = false,
		Parent = root,
	})
	self.CountdownScale = new("UIScale", { Parent = self.Countdown })

	self.DangerLabel = Components.Label({
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Theme.Fonts.Title,
		TextSize = 34,
		TextColor3 = Theme.Colors.White,
		TextStrokeColor3 = Theme.Colors.Danger,
		TextStrokeTransparency = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 96),
		Size = UDim2.fromOffset(700, 44),
		Visible = false,
		Parent = root,
	})

	-- Platzierungen
	self.Standings = Components.Panel({
		Name = "Standings",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 140),
		Size = UDim2.fromOffset(250, 40),
		BackgroundColor3 = Theme.Colors.PanelDark,
		BackgroundTransparency = 0.2,
		Parent = root,
	})
	Components.Padding(8).Parent = self.Standings
	Components.List(Enum.FillDirection.Vertical, 4).Parent = self.Standings

	-- Item-Slot
	local slot = Components.Panel({
		Name = "ItemSlot",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -24, 1, -24),
		Size = UDim2.fromOffset(124, 124),
		BackgroundColor3 = Theme.Colors.PanelDark,
		BackgroundTransparency = 0.1,
		CornerRadius = 18,
		Parent = root,
	})
	self.Slot = slot
	self.SlotScale = new("UIScale", { Parent = slot })
	if UserInputService.TouchEnabled then
		-- Auf Touch-Geräten liegt unten rechts der Sprungbutton
		slot.AnchorPoint = Vector2.new(1, 0)
		slot.Position = UDim2.new(1, -16, 0, 410)
		slot.Size = UDim2.fromOffset(110, 110)
	end
	self.SlotIcon = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 14),
		Size = UDim2.fromOffset(56, 56),
		BackgroundColor3 = Theme.Colors.PanelLight,
		BorderSizePixel = 0,
		Rotation = 45,
		Parent = slot,
	})
	Components.Corner(10).Parent = self.SlotIcon
	self.SlotName = Components.Label({
		Text = "KEIN ITEM",
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Theme.Fonts.Title,
		TextSize = 15,
		Position = UDim2.new(0, 4, 1, -44),
		Size = UDim2.new(1, -8, 0, 20),
		Parent = slot,
	})
	self.SlotKey = Components.Label({
		Text = "Q",
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Theme.Fonts.Bold,
		TextSize = 13,
		TextColor3 = Theme.Colors.TextDim,
		Position = UDim2.new(0, 4, 1, -22),
		Size = UDim2.new(1, -8, 0, 16),
		Parent = slot,
	})

	-- Fähigkeiten
	local abilities = new("Frame", {
		Name = "Abilities",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.fromOffset(300, 66),
		Parent = root,
	}, { Components.List(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center) })
	self.Abilities = abilities
	self.AbilityBoxes = {}
	for index, info in { { "Grapple", "HAKEN" }, { "Dash", "DASH" }, { "Slide", "SLIDE" } } do
		local box = Components.Panel({
			Size = UDim2.fromOffset(90, 62),
			BackgroundColor3 = Theme.Colors.PanelDark,
			BackgroundTransparency = 0.15,
			LayoutOrder = index,
			ClipsDescendants = true,
			Parent = abilities,
		})
		local fill = new("Frame", {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.fromScale(1, 0),
			BackgroundColor3 = Theme.Colors.Black,
			BackgroundTransparency = 0.4,
			BorderSizePixel = 0,
			ZIndex = 3,
			Parent = box,
		})
		local name = Components.Label({
			Text = info[2],
			TextXAlignment = Enum.TextXAlignment.Center,
			Font = Theme.Fonts.Title,
			TextSize = 16,
			Position = UDim2.fromOffset(0, 10),
			Size = UDim2.new(1, 0, 0, 20),
			ZIndex = 2,
			Parent = box,
		})
		local key = Components.Label({
			Text = "",
			TextXAlignment = Enum.TextXAlignment.Center,
			Font = Theme.Fonts.Bold,
			TextSize = 12,
			TextColor3 = Theme.Colors.TextDim,
			Position = UDim2.fromOffset(0, 34),
			Size = UDim2.new(1, 0, 0, 16),
			ZIndex = 2,
			Parent = box,
		})
		self.AbilityBoxes[info[1]] = { Box = box, Fill = fill, Name = name, Key = key, Stroke = box:FindFirstChildOfClass("UIStroke") }
	end

	-- Ereignis-Feed
	self.Feed = new("Frame", {
		Name = "Feed",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 16, 0.62, 0),
		Size = UDim2.fromOffset(400, 200),
		Parent = root,
	}, { Components.List(Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Bottom) })
	self.FeedCount = 0

	-- Ausgeschieden
	local eliminated = Components.Panel({
		Name = "Eliminated",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.36),
		Size = UDim2.fromOffset(480, 170),
		BackgroundColor3 = Theme.Colors.PanelDark,
		StrokeColor = Theme.Colors.Danger,
		Visible = false,
		Parent = root,
	})
	self.EliminatedPanel = eliminated
	Components.Label({
		Text = "AUSGESCHIEDEN",
		Font = Theme.Fonts.Title,
		TextSize = 38,
		TextColor3 = Theme.Colors.Danger,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 14),
		Size = UDim2.new(1, 0, 0, 44),
		Parent = eliminated,
	})
	self.EliminatedInfo = Components.Label({
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Theme.Fonts.Medium,
		Position = UDim2.fromOffset(0, 60),
		Size = UDim2.new(1, 0, 0, 24),
		Parent = eliminated,
	})
	local spectateButton = Components.Button({
		Text = "ZUSCHAUEN",
		Position = UDim2.new(0.5, -210, 1, -64),
		Size = UDim2.fromOffset(200, 48),
		Color = Theme.Colors.Accent,
		TextColor = Theme.Colors.Background,
		OnClick = function()
			self.EliminatedPanel.Visible = false
			self:StartSpectating()
		end,
	})
	spectateButton.Parent = eliminated
	local lobbyButton = Components.Button({
		Text = "ZUR LOBBY",
		Position = UDim2.new(0.5, 10, 1, -64),
		Size = UDim2.fromOffset(200, 48),
		OnClick = function()
			self.EliminatedPanel.Visible = false
		end,
	})
	lobbyButton.Parent = eliminated

	-- Zuschauermodus
	local spectate = Components.Panel({
		Name = "Spectate",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -100),
		Size = UDim2.fromOffset(520, 60),
		BackgroundColor3 = Theme.Colors.PanelDark,
		Visible = false,
		Parent = root,
	})
	self.SpectatePanel = spectate
	self.SpectateLabel = Components.Label({
		Text = "",
		Font = Theme.Fonts.Bold,
		Position = UDim2.fromOffset(16, 0),
		Size = UDim2.new(1, -300, 1, 0),
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextWrapped = false,
		Parent = spectate,
	})
	local prev = Components.Button({
		Text = "◀",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -212, 0.5, 0),
		Size = UDim2.fromOffset(48, 42),
		OnClick = function()
			self:_cycleSpectate(-1)
		end,
	})
	prev.Parent = spectate
	local nextButton = Components.Button({
		Text = "▶",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -158, 0.5, 0),
		Size = UDim2.fromOffset(48, 42),
		OnClick = function()
			self:_cycleSpectate(1)
		end,
	})
	nextButton.Parent = spectate
	local stop = Components.Button({
		Text = "BEENDEN",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(140, 42),
		Color = Theme.Colors.Danger,
		OnClick = function()
			self.Ctx.CameraController:SetSpectate(nil)
		end,
	})
	stop.Parent = spectate

	-- Pfeile für Spieler außerhalb des Bildes
	self.Indicators = {}
	for i = 1, 7 do
		local indicator = new("Frame", {
			Name = "Offscreen" .. i,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(120, 40),
			BackgroundTransparency = 1,
			Visible = false,
			Parent = root,
		})
		local arrow = Components.Label({
			Name = "Arrow",
			Text = "▶",
			Font = Theme.Fonts.Title,
			TextSize = 22,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromOffset(24, 24),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.3),
			TextStrokeTransparency = 0.3,
			Parent = indicator,
		})
		local label = Components.Label({
			Name = "Name",
			Text = "",
			TextSize = 12,
			Font = Theme.Fonts.Bold,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromScale(0, 0.55),
			Size = UDim2.new(1, 0, 0, 16),
			TextStrokeTransparency = 0.3,
			TextWrapped = false,
			Parent = indicator,
		})
		self.Indicators[i] = { Frame = indicator, Arrow = arrow, Label = label }
	end
	return self
end

------------------------------------------------------------------------
-- Ereignisse
------------------------------------------------------------------------

function RaceHud:Start()
	local state = self.Ctx.ClientState
	state:On("RacerEliminated", function(payload)
		if payload.UserId == player.UserId then
			if payload.Reason ~= "Left" then
				self.EliminatedInfo.Text = string.format("Platz %d · %s", payload.Placement or 0, REASON_TEXT[payload.Reason] or "")
				self.EliminatedPanel.Visible = true
			end
		else
			self:_feed(string.format("<b>%s</b> ist raus (Platz %d) – %s", payload.Name or "?", payload.Placement or 0, REASON_TEXT[payload.Reason] or "ausgeschieden"), Theme.Colors.Danger)
		end
	end)
	state:On("RacerFinished", function(payload)
		self:_feed(string.format("<b>%s</b> hat das Ziel erreicht! (%s)", payload.Name or "?", Util.FormatTime(payload.Time or 0)), Theme.Colors.Gold)
	end)
	state:On("PowerUpUsed", function(payload)
		local item = ItemDefinitions.Get(payload.ItemId)
		local who = Players:GetPlayerByUserId(payload.UserId)
		if item and who and who ~= player and item.Offensive then
			self:_feed(string.format("<b>%s</b> setzt %s ein", who.DisplayName, item.Name), item.Color)
		end
	end)
	state:On("StatusApplied", function(payload)
		if payload.UserId == player.UserId then
			self:_feed(if payload.Kind == "Slowed" then "Du wurdest eingefroren!" else "Du bist in eine Falle getappt!", Theme.Colors.Warning)
		end
	end)
	state:On("ShieldBlocked", function(payload)
		if payload.UserId == player.UserId then
			self:_feed("Dein Schild hat einen Angriff geblockt!", Theme.Colors.Accent)
		end
	end)
	state:On("ItemPickup", function()
		self.SlotScale.Scale = 1.25
		Components.Tween(self.SlotScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
	state:On("MatchStarted", function()
		self.EliminatedPanel.Visible = false
		self.FinalTime = nil
		self:_clearFeed()
		self:_buildTicks()
	end)
	state:On("MatchResults", function(payload)
		self.EliminatedPanel.Visible = false
		self.FinalTime = payload.Duration
	end)

	RunService.RenderStepped:Connect(function(dt)
		local ok, err = pcall(self._update, self, dt)
		if not ok then
			warn("[RaceHud] " .. tostring(err))
		end
	end)
end

function RaceHud:_feed(text: string, color: Color3)
	self.FeedCount += 1
	local entry = Components.Label({
		Text = text,
		TextSize = Theme.TextSize.Small,
		Font = Theme.Fonts.Medium,
		TextColor3 = color,
		TextStrokeTransparency = 0.5,
		Size = UDim2.new(1, 0, 0, 20),
		LayoutOrder = self.FeedCount,
		Parent = self.Feed,
	})
	local entries = {}
	for _, child in self.Feed:GetChildren() do
		if child:IsA("TextLabel") then
			table.insert(entries, child)
		end
	end
	if #entries > 6 then
		table.sort(entries, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		entries[1]:Destroy()
	end
	task.delay(6, function()
		if entry.Parent then
			Components.Tween(entry, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
			task.wait(0.45)
			entry:Destroy()
		end
	end)
end

function RaceHud:_clearFeed()
	for _, child in self.Feed:GetChildren() do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
end

function RaceHud:_buildTicks()
	self.TickHolder:ClearAllChildren()
	local gameState = self.Ctx.ClientState.GameState
	local startX = gameState:GetAttribute("StartX") or 0
	local finishX = gameState:GetAttribute("FinishX") or 0
	local list = gameState:GetAttribute("CheckpointXs") or ""
	if finishX <= startX then
		return
	end
	for value in string.gmatch(list, "[^,]+") do
		local x = tonumber(value)
		if x then
			local alpha = math.clamp((x - startX) / (finishX - startX), 0, 1)
			new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(alpha, 0.5),
				Size = UDim2.fromOffset(2, 10),
				BackgroundColor3 = Theme.Colors.TextDim,
				BorderSizePixel = 0,
				Parent = self.TickHolder,
			})
		end
	end
end

------------------------------------------------------------------------
-- Zuschauen
------------------------------------------------------------------------

function RaceHud:_aliveRacers()
	local list = {}
	for _, folder in self.Ctx.ClientState.Racers:GetChildren() do
		if folder:GetAttribute("Status") == "Racing" then
			local other = Players:GetPlayerByUserId(folder:GetAttribute("UserId") or 0)
			if other and other ~= player then
				table.insert(list, { Player = other, Placement = folder:GetAttribute("Placement") or 99 })
			end
		end
	end
	table.sort(list, function(a, b)
		return a.Placement < b.Placement
	end)
	return list
end

function RaceHud:StartSpectating()
	local alive = self:_aliveRacers()
	if #alive > 0 then
		self.Ctx.CameraController:SetSpectate(alive[1].Player)
	else
		self.UI:Notify("Gerade gibt es niemanden zum Zuschauen.", "Info")
	end
end

function RaceHud:_cycleSpectate(direction: number)
	local alive = self:_aliveRacers()
	if #alive == 0 then
		return
	end
	local current = self.Ctx.CameraController:GetSpectate()
	local index = 0
	for i, entry in alive do
		if entry.Player == current then
			index = i
		end
	end
	index = ((index - 1 + direction) % #alive) + 1
	self.Ctx.CameraController:SetSpectate(alive[index].Player)
end

------------------------------------------------------------------------
-- Pro Frame
------------------------------------------------------------------------

function RaceHud:_rowFor(folder)
	local row = self.Rows[folder]
	if row and row.Frame.Parent then
		return row
	end
	local frame = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 26), Parent = self.Standings })
	local placement = Components.Label({ Text = "", Font = Theme.Fonts.Title, TextSize = 18, Size = UDim2.fromOffset(30, 26), Parent = frame })
	local name = Components.Label({
		Text = "",
		Font = Theme.Fonts.Bold,
		TextSize = 16,
		Position = UDim2.fromOffset(32, 0),
		Size = UDim2.new(1, -92, 1, 0),
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextWrapped = false,
		Parent = frame,
	})
	local status = Components.Label({
		Text = "",
		Font = Theme.Fonts.Bold,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(58, 26),
		Parent = frame,
	})
	row = { Frame = frame, Placement = placement, Name = name, Status = status }
	self.Rows[folder] = row
	return row
end

function RaceHud:_dotFor(folder)
	local dot = self.Dots[folder]
	if dot and dot.Parent then
		return dot
	end
	local isLocal = folder:GetAttribute("UserId") == player.UserId
	local size = if isLocal then 18 else 12
	dot = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = if isLocal then Theme.Colors.Accent else Theme.Colors.White,
		BorderSizePixel = 0,
		ZIndex = if isLocal then 6 else 5,
		Parent = self.DotHolder,
	})
	Components.Corner(size // 2).Parent = dot
	if isLocal then
		Components.Stroke(Theme.Colors.White, 2).Parent = dot
	end
	self.Dots[folder] = dot
	return dot
end

function RaceHud:_update(_dt: number)
	local ctx = self.Ctx
	local state = ctx.ClientState
	local gameState = state.GameState
	local serverNow = workspace:GetServerTimeNow()
	local phase = gameState:GetAttribute("Phase") or "Waiting"
	local inRace = state:IsInRace()
	local spectateTarget = ctx.CameraController:GetSpectate()
	local practice = state:GetPracticeCourse() ~= ""
	local matchActive = phase == "Countdown" or phase == "Racing" or phase == "Results"

	-- Zuschauen beenden, wenn das Rennen vorbei ist oder das Ziel weg ist
	if spectateTarget and (not matchActive or not spectateTarget.Parent or inRace) then
		ctx.CameraController:SetSpectate(nil)
		spectateTarget = nil
	end
	local watching = (inRace or spectateTarget ~= nil) and matchActive

	self.Top.Visible = watching
	self.Standings.Visible = watching
	self.SpectatePanel.Visible = spectateTarget ~= nil
	if spectateTarget then
		self.SpectateLabel.Text = "ZUSCHAUEN: " .. spectateTarget.DisplayName
	end
	if not matchActive then
		self.EliminatedPanel.Visible = false
	end

	-- Kopfbereich
	if watching then
		local definition = MapDefinitions.Get(gameState:GetAttribute("MapId") or "")
		local mode = if gameState:GetAttribute("Mode") == "Ranked" then "RANKED" else "SCHNELLES SPIEL"
		self.MapLabel.Text = string.format("%s · %s", if definition then string.upper(definition.Name) else "", mode)
		local startedAt = gameState:GetAttribute("RaceStartedAt") or 0
		if phase == "Racing" and startedAt > 0 then
			self.TimerLabel.Text = Util.FormatTime(serverNow - startedAt)
		elseif phase == "Results" and self.FinalTime then
			self.TimerLabel.Text = Util.FormatTime(self.FinalTime)
		elseif phase == "Countdown" then
			self.TimerLabel.Text = "0:00.00"
		end
		self:_updateTrack(gameState)
		self:_updateStandings()
	end

	-- Countdown
	self:_updateCountdown(phase, gameState, serverNow, watching)

	-- Gefahrenzone
	self:_updateZone(gameState, serverNow, inRace and phase == "Racing", watching)

	-- Item und Fähigkeiten
	local showControls = (inRace and phase ~= "Results") or practice
	self.Slot.Visible = showControls
	self.Abilities.Visible = showControls
	if showControls then
		self:_updateControls()
	end

	self:_updateIndicators(watching)
end

function RaceHud:_updateTrack(gameState)
	local startX = gameState:GetAttribute("StartX") or 0
	local finishX = gameState:GetAttribute("FinishX") or 0
	local length = math.max(1, finishX - startX)
	if #self.TickHolder:GetChildren() == 0 and (gameState:GetAttribute("CheckpointXs") or "") ~= "" then
		self:_buildTicks()
	end
	local zoneState = gameState:GetAttribute("ZoneState") or "Inactive"
	local zoneX = gameState:GetAttribute("ZoneX") or -1e6
	local zoneAlpha = if zoneState == "Shrinking" or zoneState == "Final" then math.clamp((zoneX - startX) / length, 0, 1) else 0
	self.ZoneFill.Size = UDim2.fromScale(zoneAlpha, 1)

	local seen = {}
	for _, folder in self.Ctx.ClientState.Racers:GetChildren() do
		seen[folder] = true
		local dot = self:_dotFor(folder)
		local progress = folder:GetAttribute("Progress") or 0
		local status = folder:GetAttribute("Status")
		dot.Position = UDim2.fromScale(math.clamp(progress / length, 0, 1), 0.5)
		dot.Visible = status == "Racing" or status == "Finished" or status == "Survived"
	end
	for folder, dot in self.Dots do
		if not seen[folder] then
			dot:Destroy()
			self.Dots[folder] = nil
		end
	end
end

function RaceHud:_updateStandings()
	local folders = self.Ctx.ClientState.Racers:GetChildren()
	table.sort(folders, function(a, b)
		return (a:GetAttribute("Placement") or 99) < (b:GetAttribute("Placement") or 99)
	end)
	local seen = {}
	for index, folder in folders do
		seen[folder] = true
		local row = self:_rowFor(folder)
		row.Frame.LayoutOrder = index
		local status = folder:GetAttribute("Status") or "Racing"
		local isLocal = folder:GetAttribute("UserId") == player.UserId
		row.Placement.Text = tostring(folder:GetAttribute("Placement") or index)
		row.Name.Text = folder:GetAttribute("Name") or "?"
		row.Status.Text = STATUS_TEXT[status] or ""
		local active = status == "Racing" or status == "Finished" or status == "Survived"
		local color = if isLocal then Theme.Colors.Accent else Theme.Colors.Text
		if not active then
			color = Theme.Colors.TextDim
		end
		row.Name.TextColor3 = color
		row.Placement.TextColor3 = if folder:GetAttribute("Placement") == 1 and active then Theme.Colors.Gold else color
		row.Status.TextColor3 = if status == "Finished" then Theme.Colors.Gold else Theme.Colors.Danger
		local danger = folder:GetAttribute("DangerTime") or 0
		if danger > 0 and status == "Racing" then
			row.Status.Text = "GEFAHR"
		end
	end
	for folder, row in self.Rows do
		if not seen[folder] then
			row.Frame:Destroy()
			self.Rows[folder] = nil
		end
	end
	self.Standings.Size = UDim2.fromOffset(250, 16 + #folders * 30)
end

function RaceHud:_updateCountdown(phase: string, gameState, serverNow: number, watching: boolean)
	local audio = self.Ctx.AudioController
	if phase == "Countdown" and watching then
		local remaining = (gameState:GetAttribute("PhaseEndsAt") or 0) - serverNow
		local number = math.ceil(remaining)
		if number >= 1 and number <= 3 then
			self.Countdown.Visible = true
			if self.LastCountdown ~= number then
				self.LastCountdown = number
				self.Countdown.Text = tostring(number)
				self.Countdown.TextColor3 = Theme.Colors.White
				self.CountdownScale.Scale = 1.6
				Components.Tween(self.CountdownScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
				audio:Play("Countdown")
			end
		else
			self.Countdown.Visible = number > 3
			self.Countdown.Text = "BEREIT?"
			self.Countdown.TextColor3 = Theme.Colors.Accent
		end
		return
	end
	if phase == "Racing" and watching then
		local startedAt = gameState:GetAttribute("RaceStartedAt") or 0
		if serverNow - startedAt < 0.9 then
			if self.LastCountdown ~= 0 then
				self.LastCountdown = 0
				self.Countdown.Text = "LOS!"
				self.Countdown.TextColor3 = Theme.Colors.Success
				self.CountdownScale.Scale = 1.8
				Components.Tween(self.CountdownScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
				audio:Play("Go")
			end
			self.Countdown.Visible = true
			return
		end
	end
	self.Countdown.Visible = false
	if phase ~= "Countdown" and phase ~= "Racing" then
		self.LastCountdown = nil
	end
end

function RaceHud:_updateZone(gameState, serverNow: number, localRacing: boolean, watching: boolean)
	local zoneState = gameState:GetAttribute("ZoneState") or "Inactive"
	if zoneState ~= self.LastZoneState then
		if zoneState == "Shrinking" then
			self.BannerText = "DIE GEFAHRENZONE SCHRUMPFT!"
			self.BannerUntil = os.clock() + 2.5
			self.Ctx.AudioController:Play("Warning")
		elseif zoneState == "Final" then
			self.BannerText = "FINALE ZONE – NUR DIE SCHNELLSTEN ÜBERLEBEN!"
			self.BannerUntil = os.clock() + 2.5
			self.Ctx.AudioController:Play("Warning")
		end
		self.LastZoneState = zoneState
	end
	if watching and zoneState == "Warning" then
		local remaining = math.max(0, math.ceil((gameState:GetAttribute("ZoneShrinkAt") or 0) - serverNow))
		self.Banner.Text = string.format("GEFAHRENZONE AKTIV IN %d", remaining)
		self.Banner.TextColor3 = Theme.Colors.Warning
		self.Banner.Visible = true
	elseif watching and os.clock() < self.BannerUntil then
		self.Banner.Text = self.BannerText or ""
		self.Banner.TextColor3 = Theme.Colors.Danger
		self.Banner.Visible = true
	else
		self.Banner.Visible = false
	end

	-- Eigene Gefahr
	local intensity = 0
	local dangerText = nil
	if localRacing then
		local folder = self.Ctx.ClientState.Racers:FindFirstChild(tostring(player.UserId))
		local danger = folder and folder:GetAttribute("DangerTime") or 0
		local delay = Config.HazardZone.EliminationDelay
		if danger > 0 then
			intensity = 0.45 + 0.5 * math.clamp(danger / delay, 0, 1)
			dangerText = string.format("ZURÜCK NACH VORNE!  %.1f s", math.max(0, delay - danger))
		elseif zoneState == "Shrinking" or zoneState == "Final" then
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root then
				local gap = root.Position.X - (gameState:GetAttribute("ZoneX") or -1e6)
				if gap < 30 then
					intensity = 0.35 * (1 - math.clamp(gap / 30, 0, 1))
				end
			end
		end
	end
	local pulse = if intensity > 0.4 then (0.85 + math.sin(os.clock() * 10) * 0.15) else 1
	for _, frame in self.Vignette do
		frame.BackgroundTransparency = 1 - intensity * pulse
	end
	self.DangerLabel.Visible = dangerText ~= nil
	if dangerText then
		self.DangerLabel.Text = dangerText
	end
end

function RaceHud:_updateControls()
	local ctx = self.Ctx
	local device = ctx.InputController:GetDevice()
	local hints = KEY_HINTS[device] or KEY_HINTS.Keyboard
	local itemId = player:GetAttribute("HeldItem") or ""
	local item = ItemDefinitions.Get(itemId)
	if item then
		self.SlotIcon.BackgroundColor3 = item.Color
		self.SlotName.Text = item.Short
		self.SlotName.TextColor3 = item.Color
		self.SlotKey.Text = if hints.Item ~= "" then "[" .. hints.Item .. "] EINSETZEN" else "EINSETZEN"
	else
		self.SlotIcon.BackgroundColor3 = Theme.Colors.PanelLight
		self.SlotName.Text = "KEIN ITEM"
		self.SlotName.TextColor3 = Theme.Colors.TextDim
		self.SlotKey.Text = "Box einsammeln"
	end

	local cooldowns = ctx.MovementController:GetCooldowns()
	local function render(key: string, remaining: number, max: number, active: boolean, ready: boolean)
		local entry = self.AbilityBoxes[key]
		entry.Fill.Size = UDim2.fromScale(1, if max > 0 then math.clamp(remaining / max, 0, 1) else 0)
		entry.Key.Text = if active then "AKTIV" else (if hints[key] ~= "" then "[" .. hints[key] .. "]" else "")
		if entry.Stroke then
			entry.Stroke.Color = if active then Theme.Colors.Accent elseif ready then Theme.Colors.Stroke else Theme.Colors.PanelDark
		end
		entry.Name.TextColor3 = if ready or active then Theme.Colors.Text else Theme.Colors.TextDim
	end
	render("Grapple", cooldowns.Grapple, cooldowns.GrappleMax, cooldowns.Grappling, cooldowns.Grapple <= 0 and cooldowns.HasTarget)
	render("Dash", cooldowns.Dash, cooldowns.DashMax, false, cooldowns.Dash <= 0 and cooldowns.DashAvailable)
	render("Slide", cooldowns.Slide, cooldowns.SlideMax, ctx.MovementController:GetState() == "Slide", cooldowns.Slide <= 0)
end

function RaceHud:_updateIndicators(watching: boolean)
	local camera = workspace.CurrentCamera
	local index = 0
	if watching and camera then
		local viewport = camera.ViewportSize
		local focusPlayer = self.Ctx.CameraController:GetSpectate() or player
		for _, folder in self.Ctx.ClientState.Racers:GetChildren() do
			if folder:GetAttribute("Status") == "Racing" then
				local other = Players:GetPlayerByUserId(folder:GetAttribute("UserId") or 0)
				local character = other and other ~= focusPlayer and other.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				if root and index < #self.Indicators then
					local screen, onScreen = camera:WorldToViewportPoint(root.Position)
					local inside = onScreen and screen.X > 0 and screen.X < viewport.X and screen.Y > 0 and screen.Y < viewport.Y
					if not inside then
						index += 1
						local indicator = self.Indicators[index]
						local margin = 70
						local x = math.clamp(screen.X, margin, viewport.X - margin)
						local y = math.clamp(screen.Y, margin, viewport.Y - margin)
						if not onScreen then
							-- Hinter der Kamera: horizontal spiegeln
							x = viewport.X - x
						end
						local logical = self.UI:ToLogical(Vector2.new(x, y))
						indicator.Frame.Position = UDim2.fromOffset(logical.X, logical.Y)
						indicator.Frame.Visible = true
						local center = viewport / 2
						local direction = Vector2.new(screen.X, screen.Y) - center
						indicator.Arrow.Rotation = math.deg(math.atan2(direction.Y, direction.X))
						local focusCharacter = focusPlayer.Character
						local focusRoot = focusCharacter and focusCharacter:FindFirstChild("HumanoidRootPart")
						local distance = if focusRoot then math.floor(math.abs(root.Position.X - focusRoot.Position.X)) else 0
						indicator.Label.Text = string.format("%s · %dm", other.DisplayName, distance)
					end
				end
			end
		end
	end
	for i = index + 1, #self.Indicators do
		self.Indicators[i].Frame.Visible = false
	end
end

return RaceHud
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="73">
              <Properties>
                <string name="Name">Results</string>
                <string name="Source"><![CDATA[--[[
	Results  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/UI/Screens/Results

	Ergebnisbildschirm nach jedem Rennen:
		- Sieger / eigene Platzierung, Grund des Rennendes
		- Tabelle aller Teilnehmer (Platz, Name, Status, Zeit/Strecke, Rating)
		- eigene Belohnungen: Coins, XP, Level-Up, Rating, Aufgaben, Erfolge, Bestzeit
		- Option "Automatisch erneut anstellen"
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local MapDefinitions = require(Shared.MapDefinitions)

local UI = script.Parent.Parent
local Components = require(UI.Components)
local Theme = require(UI.Theme)

local player = Players.LocalPlayer
local new = Components.new

local Results = {}
Results.__index = Results

local REASONS = {
	Finish = "Ziellinie überquert",
	LastStanding = "Letzter Überlebender",
	Timeout = "Zeit abgelaufen – der Führende gewinnt",
	NoRacers = "Keine Teilnehmer mehr im Rennen",
}

local STATUS = {
	Finished = "Im Ziel",
	Survived = "Überlebt",
	Eliminated = "Ausgeschieden",
	Left = "Verlassen",
	Racing = "Im Rennen",
}

function Results.new(ui)
	local self = setmetatable({}, Results)
	self.UI = ui
	local modal = Components.Modal({ Name = "Results", Title = "ERGEBNIS", Size = UDim2.fromOffset(960, 580), Parent = ui.Root })
	self.Modal = modal
	ui:RegisterModal("Results", modal)
	local content = modal.Content

	self.Headline = Components.Label({
		Text = "",
		Font = Theme.Fonts.Title,
		TextSize = 44,
		Size = UDim2.new(1, 0, 0, 50),
		Parent = content,
	})
	self.Subline = Components.Label({
		Text = "",
		Font = Theme.Fonts.Medium,
		TextColor3 = Theme.Colors.TextDim,
		Position = UDim2.fromOffset(0, 52),
		Size = UDim2.new(1, 0, 0, 22),
		Parent = content,
	})

	local list = new("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 86),
		Size = UDim2.new(0.6, -10, 1, -150),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = content,
	}, { Components.List(Enum.FillDirection.Vertical, 6) })
	self.List = list

	local rewards = Components.Panel({
		Position = UDim2.new(0.6, 10, 0, 86),
		Size = UDim2.new(0.4, -10, 1, -150),
		BackgroundColor3 = Theme.Colors.PanelDark,
		Parent = content,
	})
	Components.Padding(14).Parent = rewards
	Components.List(Enum.FillDirection.Vertical, 6).Parent = rewards
	self.Rewards = rewards

	local footer = new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 52),
		Parent = content,
	})
	local _, setToggle = Components.Toggle({
		Text = "Automatisch erneut anstellen",
		Size = UDim2.new(0.5, 0, 1, 0),
		Parent = footer,
		OnChanged = function(value)
			ui.Ctx.ClientState:SaveSettings({ AutoRequeue = value })
		end,
	})
	self.SetAutoRequeue = setToggle
	local continueButton = Components.Button({
		Text = "WEITER",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(200, 50),
		Color = Theme.Colors.Accent,
		TextColor = Theme.Colors.Background,
		Font = Theme.Fonts.Title,
		OnClick = function()
			modal.Close()
		end,
	})
	continueButton.Parent = footer
	return self
end

function Results:Start()
	local state = self.UI.Ctx.ClientState
	state:On("MatchResults", function(payload)
		self:Show(payload)
	end)
end

function Results:_rewardLine(text: string, color: Color3?)
	Components.Label({
		Text = text,
		Font = Theme.Fonts.Bold,
		TextSize = Theme.TextSize.Body,
		TextColor3 = color or Theme.Colors.Text,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = self.Rewards,
	})
end

function Results:Show(payload)
	local participated = false
	local myResult = nil
	for _, entry in payload.Results or {} do
		if entry.UserId == player.UserId then
			participated = true
			myResult = entry
		end
	end

	local definition = MapDefinitions.Get(payload.MapId or "")
	local mapName = if definition then definition.Name else ""
	local winnerName = "—"
	for _, entry in payload.Results or {} do
		if entry.Placement == 1 then
			winnerName = entry.Name
		end
	end

	if payload.WinnerUserId == player.UserId then
		self.Headline.Text = "SIEG!"
		self.Headline.TextColor3 = Theme.Colors.Gold
	elseif myResult then
		self.Headline.Text = string.format("PLATZ %d", myResult.Placement)
		self.Headline.TextColor3 = if myResult.Placement <= 3 then Theme.Colors.Accent else Theme.Colors.Text
	else
		self.Headline.Text = winnerName .. " GEWINNT"
		self.Headline.TextColor3 = Theme.Colors.Text
	end
	self.Subline.Text = string.format("%s · %s · %s · Dauer %s", mapName, if payload.Mode == "Ranked" then "Ranked" else "Schnelles Spiel", REASONS[payload.Reason] or "", Util.FormatTime(payload.Duration or 0))

	for _, child in self.List:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	for index, entry in payload.Results or {} do
		local isMe = entry.UserId == player.UserId
		local row = Components.Panel({
			Size = UDim2.new(1, -10, 0, 42),
			BackgroundColor3 = if isMe then Theme.Colors.PanelLight else Theme.Colors.PanelDark,
			StrokeColor = if entry.Placement == 1 then Theme.Colors.Gold else Theme.Colors.Stroke,
			LayoutOrder = index,
			Parent = self.List,
		})
		Components.Label({
			Text = tostring(entry.Placement),
			Font = Theme.Fonts.Title,
			TextSize = 22,
			TextColor3 = if entry.Placement == 1 then Theme.Colors.Gold else Theme.Colors.Text,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.new(0, 44, 1, 0),
			Parent = row,
		})
		Components.Label({
			Text = entry.Name,
			Font = Theme.Fonts.Bold,
			TextColor3 = if isMe then Theme.Colors.Accent else Theme.Colors.Text,
			Position = UDim2.fromOffset(48, 0),
			Size = UDim2.new(0.42, -48, 1, 0),
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextWrapped = false,
			Parent = row,
		})
		local detail = STATUS[entry.Status] or entry.Status
		if entry.Time then
			detail = "Ziel " .. Util.FormatTime(entry.Time)
		elseif entry.Progress then
			detail = string.format("%s · %d m", detail, math.max(0, entry.Progress))
		end
		Components.Label({
			Text = detail,
			Font = Theme.Fonts.Medium,
			TextSize = Theme.TextSize.Small,
			TextColor3 = Theme.Colors.TextDim,
			Position = UDim2.new(0.42, 0, 0, 0),
			Size = UDim2.new(0.4, 0, 1, 0),
			Parent = row,
		})
		if entry.RatingChange then
			Components.Label({
				Text = string.format("%+d", entry.RatingChange),
				Font = Theme.Fonts.Title,
				TextSize = Theme.TextSize.Body,
				TextColor3 = if entry.RatingChange >= 0 then Theme.Colors.Success else Theme.Colors.Danger,
				TextXAlignment = Enum.TextXAlignment.Right,
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -12, 0, 0),
				Size = UDim2.new(0.16, 0, 1, 0),
				Parent = row,
			})
		end
	end

	for _, child in self.Rewards:GetChildren() do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	local rewards = payload.Rewards
	if rewards then
		self:_rewardLine("BELOHNUNGEN", Theme.Colors.TextDim)
		self:_rewardLine(string.format("+%s Coins", Util.FormatNumber(rewards.Coins or 0)), Theme.Colors.Gold)
		self:_rewardLine(string.format("+%s XP", Util.FormatNumber(rewards.XP or 0)), Theme.Colors.XP)
		if (rewards.LevelsGained or 0) > 0 then
			self:_rewardLine(string.format("LEVEL UP! Level %d (+%s Coins)", rewards.NewLevel, Util.FormatNumber(rewards.LevelBonusCoins or 0)), Theme.Colors.Success)
		end
		if rewards.RatingChange then
			self:_rewardLine(string.format("Rating %+d → %d (%s)", rewards.RatingChange, rewards.NewRating or 0, rewards.Tier or ""), if rewards.RatingChange >= 0 then Theme.Colors.Success else Theme.Colors.Danger)
		end
		if rewards.NewBestTime then
			self:_rewardLine("Neue Bestzeit: " .. Util.FormatTime(rewards.NewBestTime), Theme.Colors.Accent)
		end
		for _, quest in rewards.Quests or {} do
			self:_rewardLine("Aufgabe erledigt: " .. quest, Theme.Colors.Success)
		end
		for _, achievement in rewards.Achievements or {} do
			self:_rewardLine("Erfolg: " .. achievement, Theme.Colors.Gold)
		end
	elseif participated then
		self:_rewardLine("Keine Belohnung (Rennen verlassen).", Theme.Colors.TextDim)
	else
		self:_rewardLine("Du hast zugeschaut.", Theme.Colors.TextDim)
		self:_rewardLine("Tritt der Warteschlange bei, um in der nächsten Runde mitzufahren!", Theme.Colors.TextDim)
	end

	self.SetAutoRequeue(self.UI.Ctx.ClientState:GetSetting("AutoRequeue") ~= false)

	-- Nur Teilnehmer und Zuschauer bekommen das Fenster automatisch
	local spectating = self.UI.Ctx.CameraController:GetSpectate() ~= nil
	if participated or spectating then
		task.delay(Config.Round.ReturnToLobbyDelay * 0.6, function()
			self.UI:OpenModal("Results")
		end)
		local token = {}
		self.Token = token
		task.delay(Config.Round.ResultsDuration + 4, function()
			if self.Token == token then
				self.Modal.Close()
			end
		end)
	end
end

return Results
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="74">
              <Properties>
                <string name="Name">Settings</string>
                <string name="Source"><![CDATA[--[[
	Settings  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/UI/Screens/Settings

	Einstellungen (werden im Profil gespeichert):
		Audio: Musik, Soundeffekte
		Steuerung: Gamepad-Empfindlichkeit, Touch-Buttons anzeigen
		Grafik: Kamerawackeln, reduzierte Effekte
		Spiel: Automatisch erneut anstellen
	Dazu eine Übersicht aller Tastenbelegungen.
]]

local UI = script.Parent.Parent
local Components = require(UI.Components)
local Theme = require(UI.Theme)

local new = Components.new

local Settings = {}
Settings.__index = Settings

local CONTROLS_TEXT = table.concat({
	"<b>PC</b>",
	"A / D oder ← / →: laufen",
	"Leertaste / W / ↑: springen (halten = höher)",
	"E / J / linke Maustaste: Greifhaken (halten)",
	"Shift / S / ↓: Slide (Boden) · Air-Dash (Luft)",
	"Q / F: Power-up · G: Emote · R: Respawn · M: Menü",
	"",
	"<b>Gamepad</b>",
	"Linker Stick / D-Pad: laufen · A: springen",
	"X oder R2: Greifhaken · B oder L2: Slide/Dash",
	"Y oder R1: Power-up · L1: Emote · Select: Menü",
	"",
	"<b>Touch</b>",
	"◀ ▶ links: laufen · rechts: SPRUNG, HAKEN, SLIDE, ITEM",
}, "\n")

function Settings.new(ui)
	local self = setmetatable({}, Settings)
	self.UI = ui
	local modal = Components.Modal({ Name = "Settings", Title = "EINSTELLUNGEN", Size = UDim2.fromOffset(900, 580), Parent = ui.Root })
	self.Modal = modal
	ui:RegisterModal("Settings", modal)

	local left = new("ScrollingFrame", {
		Size = UDim2.new(0.5, -10, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = modal.Content,
	}, { Components.List(Enum.FillDirection.Vertical, 10) })
	Components.Padding(4, 12, 4, 4).Parent = left

	local state = ui.Ctx.ClientState
	local function save(key, value)
		state:SaveSettings({ [key] = value })
	end
	local function header(order, text)
		Components.Label({ Text = text, Font = Theme.Fonts.Title, TextColor3 = Theme.Colors.Accent, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = order, Parent = left })
	end

	self.Setters = {}
	header(1, "AUDIO")
	local _, setMusic = Components.Slider({ Text = "Musik", LayoutOrder = 2, Parent = left, OnChanged = function(v)
		save("MusicVolume", v)
	end })
	local _, setSfx = Components.Slider({ Text = "Soundeffekte", LayoutOrder = 3, Parent = left, OnChanged = function(v)
		save("SfxVolume", v)
	end })
	header(4, "STEUERUNG")
	local _, setSensitivity = Components.Slider({
		Text = "Gamepad-Empfindlichkeit",
		Min = 0.3,
		Max = 2.5,
		Step = 0.1,
		Value = 1,
		Format = function(v)
			return string.format("%.1f×", v)
		end,
		LayoutOrder = 5,
		Parent = left,
		OnChanged = function(v)
			save("GamepadSensitivity", v)
		end,
	})
	local _, setTouch = Components.Toggle({ Text = "Touch-Buttons anzeigen", LayoutOrder = 6, Parent = left, OnChanged = function(v)
		save("TouchControls", v)
	end })
	header(7, "GRAFIK & KOMFORT")
	local _, setShake = Components.Toggle({ Text = "Kamerawackeln", LayoutOrder = 8, Parent = left, OnChanged = function(v)
		save("CameraShake", v)
	end })
	local _, setReduced = Components.Toggle({ Text = "Reduzierte Effekte (bessere Leistung)", LayoutOrder = 9, Parent = left, OnChanged = function(v)
		save("ReducedEffects", v)
	end })
	header(10, "SPIEL")
	local _, setRequeue = Components.Toggle({ Text = "Nach dem Rennen automatisch erneut anstellen", LayoutOrder = 11, Parent = left, OnChanged = function(v)
		save("AutoRequeue", v)
	end })

	self.Apply = function(settings)
		setMusic(settings.MusicVolume or 0.5)
		setSfx(settings.SfxVolume or 0.8)
		setSensitivity(settings.GamepadSensitivity or 1)
		setTouch(settings.TouchControls ~= false)
		setShake(settings.CameraShake ~= false)
		setReduced(settings.ReducedEffects == true)
		setRequeue(settings.AutoRequeue ~= false)
	end

	local right = Components.Panel({
		Position = UDim2.new(0.5, 10, 0, 0),
		Size = UDim2.new(0.5, -10, 1, 0),
		BackgroundColor3 = Theme.Colors.PanelDark,
		Parent = modal.Content,
	})
	Components.Label({ Text = "STEUERUNG", Font = Theme.Fonts.Title, TextColor3 = Theme.Colors.Accent, Position = UDim2.fromOffset(16, 12), Size = UDim2.new(1, -32, 0, 24), Parent = right })
	Components.Label({
		Text = CONTROLS_TEXT,
		Font = Theme.Fonts.Medium,
		TextSize = Theme.TextSize.Small,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(16, 44),
		Size = UDim2.new(1, -32, 1, -56),
		Parent = right,
	})

	modal.OnOpen = function()
		self.Apply(state:GetSettings())
	end
	return self
end

function Settings:Start()
	self.Apply(self.UI.Ctx.ClientState:GetSettings())
end

return Settings
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="75">
              <Properties>
                <string name="Name">Stats</string>
                <string name="Source"><![CDATA[--[[
	Stats  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/UI/Screens/Stats

	Spielerstatistiken, Ranked-Saison, tägliche Aufgaben und Erfolge.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Progression = require(Shared.Progression)
local MapDefinitions = require(Shared.MapDefinitions)
local QuestDefinitions = require(Shared.QuestDefinitions)

local UI = script.Parent.Parent
local Components = require(UI.Components)
local Theme = require(UI.Theme)

local new = Components.new

local Stats = {}
Stats.__index = Stats

function Stats.new(ui)
	local self = setmetatable({}, Stats)
	self.UI = ui
	local modal = Components.Modal({ Name = "Stats", Title = "STATISTIK & AUFGABEN", Size = UDim2.fromOffset(1000, 600), Parent = ui.Root })
	self.Modal = modal
	ui:RegisterModal("Stats", modal)

	local function column(x: number, width: number, title: string)
		local panel = Components.Panel({
			Position = UDim2.new(x, if x > 0 then 8 else 0, 0, 0),
			Size = UDim2.new(width, -8, 1, 0),
			BackgroundColor3 = Theme.Colors.PanelDark,
			Parent = modal.Content,
		})
		Components.Label({ Text = title, Font = Theme.Fonts.Title, TextColor3 = Theme.Colors.Accent, Position = UDim2.fromOffset(14, 10), Size = UDim2.new(1, -28, 0, 24), Parent = panel })
		local scroll = new("ScrollingFrame", {
			Position = UDim2.fromOffset(10, 42),
			Size = UDim2.new(1, -20, 1, -52),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 5,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			Parent = panel,
		}, { Components.List(Enum.FillDirection.Vertical, 6) })
		return scroll
	end
	self.StatsList = column(0, 0.33, "STATISTIK")
	self.QuestList = column(0.33, 0.34, "TÄGLICHE AUFGABEN")
	self.AchievementList = column(0.67, 0.33, "ERFOLGE")

	modal.OnOpen = function()
		self:_render()
	end
	return self
end

function Stats:Start()
	self.UI.Ctx.ClientState.ProfileChanged:Connect(function()
		if self.Modal.IsOpen() then
			self:_render()
		end
	end)
end

local function clear(container: Instance)
	for _, child in container:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

function Stats:_statRow(order: number, label: string, value: string, color: Color3?)
	local row = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = order, Parent = self.StatsList })
	Components.Label({ Text = label, Font = Theme.Fonts.Medium, TextColor3 = Theme.Colors.TextDim, TextSize = Theme.TextSize.Small, Size = UDim2.new(0.62, 0, 1, 0), Parent = row })
	Components.Label({
		Text = value,
		Font = Theme.Fonts.Bold,
		TextSize = Theme.TextSize.Small,
		TextColor3 = color or Theme.Colors.Text,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.fromScale(0.62, 0),
		Size = UDim2.new(0.38, 0, 1, 0),
		Parent = row,
	})
end

function Stats:_render()
	local profile = self.UI.Ctx.ClientState.Profile
	if not profile then
		return
	end
	clear(self.StatsList)
	clear(self.QuestList)
	clear(self.AchievementList)

	local s = profile.Stats
	local order = 0
	local function add(label, value, color)
		order += 1
		self:_statRow(order, label, value, color)
	end
	add("Level", tostring(profile.Level), Theme.Colors.Accent)
	add("Gesamt-XP", Util.FormatNumber(profile.TotalXP))
	add("Coins", Util.FormatNumber(profile.Coins), Theme.Colors.Gold)
	add("Rennen", Util.FormatNumber(s.Races))
	add("Siege", Util.FormatNumber(s.Wins), Theme.Colors.Gold)
	add("Siegquote", if s.Races > 0 then string.format("%d%%", math.floor(s.Wins / s.Races * 100 + 0.5)) else "–")
	add("Top 3", Util.FormatNumber(s.Top3))
	add("Ziel erreicht", Util.FormatNumber(s.Finishes))
	add("Ausgeschieden", Util.FormatNumber(s.Eliminated))
	add("Greifhaken (Rennen)", Util.FormatNumber(s.Grapples))
	add("Power-ups (Rennen)", Util.FormatNumber(s.PowerUps))
	add("Strecke gesamt", Util.FormatNumber(s.Distance) .. " m")
	local ranked = profile.Ranked
	local tier = Progression.GetTier(ranked.Rating)
	add("—— RANKED SAISON " .. tostring(ranked.Season or Config.Ranked.Season), "", Theme.Colors.TextDim)
	add("Rang", tier.Name, tier.Color)
	add("Rating", tostring(ranked.Rating), tier.Color)
	add("Höchstwert", tostring(ranked.Peak))
	add("Ranked-Spiele / Siege", string.format("%d / %d", ranked.Games, ranked.Wins))
	add("—— BESTZEITEN", "", Theme.Colors.TextDim)
	for _, mapId in MapDefinitions.Order do
		local best = s.BestTimes and s.BestTimes[mapId]
		add(MapDefinitions.Maps[mapId].Name, if best then Util.FormatTime(best) else "–")
	end
	if profile.Persistent == false then
		add("Speichern", "Studio: aus", Theme.Colors.Warning)
	end

	-- Aufgaben
	for index, entry in profile.Quests and profile.Quests.List or {} do
		local quest = QuestDefinitions.DailyLookup[entry.Id]
		if quest then
			local card = Components.Panel({
				Size = UDim2.new(1, -6, 0, 86),
				BackgroundColor3 = Theme.Colors.Panel,
				StrokeColor = if entry.Done then Theme.Colors.Success else Theme.Colors.Stroke,
				LayoutOrder = index,
				Parent = self.QuestList,
			})
			Components.Label({ Text = quest.Name, Font = Theme.Fonts.Bold, TextSize = Theme.TextSize.Small, Position = UDim2.fromOffset(10, 8), Size = UDim2.new(1, -20, 0, 20), Parent = card })
			Components.Label({
				Text = string.format("Belohnung: %d Coins · %d XP", quest.Coins, quest.XP),
				Font = Theme.Fonts.Medium,
				TextSize = Theme.TextSize.Tiny,
				TextColor3 = Theme.Colors.Gold,
				Position = UDim2.fromOffset(10, 30),
				Size = UDim2.new(1, -20, 0, 16),
				Parent = card,
			})
			local _, set = Components.ProgressBar({
				Position = UDim2.fromOffset(10, 56),
				Size = UDim2.new(1, -110, 0, 12),
				Color = if entry.Done then Theme.Colors.Success else Theme.Colors.Accent,
				Parent = card,
			})
			set(entry.Progress / quest.Goal)
			Components.Label({
				Text = if entry.Done then "ERLEDIGT" else string.format("%s / %s", Util.FormatNumber(entry.Progress), Util.FormatNumber(quest.Goal)),
				Font = Theme.Fonts.Bold,
				TextSize = Theme.TextSize.Tiny,
				TextXAlignment = Enum.TextXAlignment.Right,
				TextColor3 = if entry.Done then Theme.Colors.Success else Theme.Colors.Text,
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -10, 0, 52),
				Size = UDim2.fromOffset(90, 20),
				Parent = card,
			})
		end
	end
	Components.Label({
		Text = "Neue Aufgaben gibt es jeden Tag (UTC). Belohnungen werden automatisch gutgeschrieben.",
		Font = Theme.Fonts.Medium,
		TextSize = Theme.TextSize.Tiny,
		TextColor3 = Theme.Colors.TextDim,
		Size = UDim2.new(1, -6, 0, 34),
		LayoutOrder = 99,
		Parent = self.QuestList,
	})

	-- Erfolge
	for index, achievement in QuestDefinitions.Achievements do
		local unlocked = profile.Achievements and profile.Achievements[achievement.Id] == true
		local card = Components.Panel({
			Size = UDim2.new(1, -6, 0, 58),
			BackgroundColor3 = if unlocked then Theme.Colors.PanelLight else Theme.Colors.Panel,
			StrokeColor = if unlocked then Theme.Colors.Gold else Theme.Colors.Stroke,
			LayoutOrder = index,
			Parent = self.AchievementList,
		})
		Components.Label({
			Text = (if unlocked then "★ " else "☆ ") .. achievement.Name,
			Font = Theme.Fonts.Bold,
			TextSize = Theme.TextSize.Small,
			TextColor3 = if unlocked then Theme.Colors.Gold else Theme.Colors.Text,
			Position = UDim2.fromOffset(10, 6),
			Size = UDim2.new(1, -20, 0, 20),
			Parent = card,
		})
		Components.Label({
			Text = string.format("%s (+%d Coins)", achievement.Description, achievement.Coins),
			Font = Theme.Fonts.Medium,
			TextSize = Theme.TextSize.Tiny,
			TextColor3 = Theme.Colors.TextDim,
			Position = UDim2.fromOffset(10, 28),
			Size = UDim2.new(1, -20, 0, 24),
			Parent = card,
		})
	end
end

return Stats
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="76">
              <Properties>
                <string name="Name">TopBar</string>
                <string name="Source"><![CDATA[--[[
	TopBar  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/UI/Screens/TopBar

	Immer sichtbare Statusleiste oben links: Level, XP-Fortschritt,
	Coins (mit animierter Änderung) und Ranked-Stufe.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Progression = require(Shared.Progression)
local Util = require(Shared.Util)

local UI = script.Parent.Parent
local Components = require(UI.Components)
local Theme = require(UI.Theme)

local player = Players.LocalPlayer

local TopBar = {}
TopBar.__index = TopBar

function TopBar.new(ui)
	local self = setmetatable({}, TopBar)
	self.UI = ui
	self.DisplayedCoins = nil

	local frame = Components.Panel({
		Name = "TopBar",
		Position = UDim2.fromOffset(16, 64),
		Size = UDim2.fromOffset(440, 66),
		BackgroundColor3 = Theme.Colors.PanelDark,
		BackgroundTransparency = 0.12,
		Parent = ui.Root,
	})
	self.Frame = frame

	local badge = Components.new("Frame", {
		Position = UDim2.fromOffset(8, 7),
		Size = UDim2.fromOffset(52, 52),
		BackgroundColor3 = Theme.Colors.Accent,
		BorderSizePixel = 0,
		Parent = frame,
	})
	Components.Corner(26).Parent = badge
	Components.Label({ Text = "LV", Font = Theme.Fonts.Bold, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Theme.Colors.Background, Size = UDim2.new(1, 0, 0, 14), Position = UDim2.fromOffset(0, 6), Parent = badge })
	self.LevelLabel = Components.Label({
		Text = "1",
		Font = Theme.Fonts.Title,
		TextSize = 24,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = Theme.Colors.Background,
		Size = UDim2.new(1, 0, 0, 28),
		Position = UDim2.fromOffset(0, 18),
		Parent = badge,
	})

	self.NameLabel = Components.Label({
		Text = player.DisplayName,
		Position = UDim2.fromOffset(70, 8),
		Size = UDim2.fromOffset(210, 22),
		TextSize = Theme.TextSize.Body,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextWrapped = false,
		Parent = frame,
	})
	local _, setXP = Components.ProgressBar({
		Position = UDim2.fromOffset(70, 36),
		Size = UDim2.fromOffset(210, 10),
		Color = Theme.Colors.XP,
		Parent = frame,
	})
	self.SetXP = setXP
	self.XPLabel = Components.Label({
		Text = "0 / 100 XP",
		Position = UDim2.fromOffset(70, 47),
		Size = UDim2.fromOffset(210, 14),
		TextSize = Theme.TextSize.Tiny,
		Font = Theme.Fonts.Medium,
		TextColor3 = Theme.Colors.TextDim,
		Parent = frame,
	})

	local coins = Components.Panel({
		Position = UDim2.fromOffset(292, 11),
		Size = UDim2.fromOffset(138, 44),
		BackgroundColor3 = Theme.Colors.Panel,
		StrokeColor = Theme.Colors.Gold,
		CornerRadius = 22,
		Parent = frame,
	})
	local coinIcon = Components.new("Frame", {
		Position = UDim2.fromOffset(8, 10),
		Size = UDim2.fromOffset(24, 24),
		BackgroundColor3 = Theme.Colors.Gold,
		BorderSizePixel = 0,
		Parent = coins,
	})
	Components.Corner(12).Parent = coinIcon
	Components.Label({ Text = "C", Font = Theme.Fonts.Title, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Theme.Colors.Background, Size = UDim2.fromScale(1, 1), Parent = coinIcon })
	self.CoinLabel = Components.Label({
		Text = "0",
		Position = UDim2.fromOffset(38, 0),
		Size = UDim2.new(1, -44, 1, 0),
		TextSize = Theme.TextSize.Large,
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.Gold,
		Parent = coins,
	})
	self.CoinPanel = coins

	self.TierLabel = Components.Label({
		Text = "",
		Position = UDim2.fromOffset(16, 134),
		Size = UDim2.fromOffset(440, 18),
		TextSize = Theme.TextSize.Small,
		Font = Theme.Fonts.Bold,
		Parent = ui.Root,
	})
	return self
end

function TopBar:Start()
	local state = self.UI.Ctx.ClientState
	state.ProfileChanged:Connect(function(profile)
		self:_render(profile)
	end)
	if state.Profile then
		self:_render(state.Profile)
	end
	RunService.Heartbeat:Connect(function()
		-- Im Rennen ausblenden: dort gehört der Platz Timer und Fortschrittsbalken
		local inRace = state:IsInRace() or self.UI.Ctx.CameraController:GetSpectate() ~= nil
		self.Frame.Visible = not inRace
		self.TierLabel.Visible = not inRace
	end)
end

function TopBar:_floatText(text: string, color: Color3)
	local label = Components.Label({
		Text = text,
		Font = Theme.Fonts.Title,
		TextSize = 20,
		TextColor3 = color,
		Position = UDim2.new(0, 40, 1, 2),
		Size = UDim2.fromOffset(120, 24),
		Parent = self.CoinPanel,
	})
	Components.Tween(label, 1.2, { Position = UDim2.new(0, 40, 1, 32), TextTransparency = 1 })
	task.delay(1.3, function()
		label:Destroy()
	end)
end

function TopBar:_render(profile)
	local level, into, needed = Progression.FromTotalXP(profile.TotalXP or 0)
	self.LevelLabel.Text = tostring(level)
	if needed > 0 then
		self.SetXP(into / needed, 0.4)
		self.XPLabel.Text = string.format("%s / %s XP", Util.FormatNumber(into), Util.FormatNumber(needed))
	else
		self.SetXP(1, 0.4)
		self.XPLabel.Text = "Maximales Level"
	end
	local coins = profile.Coins or 0
	if self.DisplayedCoins and coins ~= self.DisplayedCoins then
		local diff = coins - self.DisplayedCoins
		self:_floatText((if diff > 0 then "+" else "") .. Util.FormatNumber(diff), if diff > 0 then Theme.Colors.Gold else Theme.Colors.Danger)
	end
	self.DisplayedCoins = coins
	self.CoinLabel.Text = Util.FormatNumber(coins)
	local rating = profile.Ranked and profile.Ranked.Rating or 1000
	local tier = Progression.GetTier(rating)
	self.TierLabel.Text = string.format("RANG: %s · %d Punkte", string.upper(tier.Name), rating)
	self.TierLabel.TextColor3 = tier.Color
end

return TopBar
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="77">
              <Properties>
                <string name="Name">TouchControls</string>
                <string name="Source"><![CDATA[--[[
	TouchControls  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/UI/Screens/TouchControls

	Virtuelle Steuerung für Smartphones und Tablets (Multi-Touch):
		links:  ◀  ▶   (Bewegung)
		rechts: SPRUNG (groß), HAKEN, SLIDE, ITEM
	Die Buttons speisen den zentralen InputController (SetVirtualAxis /
	SetVirtualButton). Abschaltbar in den Einstellungen.
]]

local UserInputService = game:GetService("UserInputService")

local UI = script.Parent.Parent
local Components = require(UI.Components)
local Theme = require(UI.Theme)

local new = Components.new

local TouchControls = {}
TouchControls.__index = TouchControls

function TouchControls.new(ui)
	local self = setmetatable({}, TouchControls)
	self.UI = ui
	self.Active = {} -- [InputObject] = action
	self.AxisState = { Left = false, Right = false }

	local root = new("Frame", {
		Name = "TouchControls",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		Parent = ui.Root,
	})
	self.Root = root

	local function touchButton(action: string, text: string, size: number, position: UDim2, color: Color3)
		local button = new("TextButton", {
			Name = action,
			Text = text,
			Font = Theme.Fonts.Title,
			TextSize = if size > 120 then 22 else 16,
			TextColor3 = Theme.Colors.White,
			AutoButtonColor = false,
			BackgroundColor3 = color,
			BackgroundTransparency = 0.45,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = position,
			Size = UDim2.fromOffset(size, size),
			Parent = root,
		})
		Components.Corner(size // 2).Parent = button
		Components.Stroke(Theme.Colors.White, 2, 0.5).Parent = button
		button.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				self.Active[input] = action
				button.BackgroundTransparency = 0.15
				self:_apply()
			end
		end)
		return button
	end

	self.Buttons = {
		touchButton("Left", "◀", 120, UDim2.new(0, 110, 1, -130), Theme.Colors.PanelLight),
		touchButton("Right", "▶", 120, UDim2.new(0, 250, 1, -130), Theme.Colors.PanelLight),
		touchButton("Jump", "SPRUNG", 150, UDim2.new(1, -130, 1, -130), Theme.Colors.Accent),
		touchButton("Grapple", "HAKEN", 110, UDim2.new(1, -290, 1, -110), Theme.Colors.Accent2),
		touchButton("Slide", "SLIDE", 100, UDim2.new(1, -120, 1, -300), Theme.Colors.PanelLight),
		touchButton("Item", "ITEM", 96, UDim2.new(1, -270, 1, -260), Theme.Colors.Gold),
	}
	return self
end

function TouchControls:_apply()
	local input = self.UI.Ctx.InputController
	local held = {}
	for _, action in self.Active do
		held[action] = true
	end
	local axis = (if held.Right then 1 else 0) - (if held.Left then 1 else 0)
	input:SetVirtualAxis(axis)
	for _, action in { "Jump", "Grapple", "Slide", "Item" } do
		input:SetVirtualButton(action, held[action] == true)
	end
	for _, button in self.Buttons do
		button.BackgroundTransparency = if held[button.Name] then 0.15 else 0.45
	end
end

function TouchControls:Start()
	UserInputService.InputEnded:Connect(function(input)
		if self.Active[input] then
			self.Active[input] = nil
			self:_apply()
		end
	end)
	local state = self.UI.Ctx.ClientState
	local function refresh()
		local enabled = UserInputService.TouchEnabled and state:GetSetting("TouchControls") ~= false
		local lobbyMenu = self.UI.Screens.LobbyMenu
		local menuOpen = lobbyMenu ~= nil and lobbyMenu:IsOpen()
		self.Root.Visible = enabled and not menuOpen and not self.UI:AnyModalOpen()
		if not self.Root.Visible and next(self.Active) then
			table.clear(self.Active)
			self:_apply()
		end
	end
	state.SettingsChanged:Connect(refresh)
	game:GetService("RunService").Heartbeat:Connect(refresh)
	refresh()
end

return TouchControls
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="78">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--[[
	Theme  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/UI/Theme

	Designsystem der Benutzeroberfläche: Farben, Schriften, Abstände.
	Alle Screens verwenden ausschließlich diese Werte.

	Layout-Prinzip: Die gesamte UI ist für eine Referenzauflösung von
	1280 × 720 entworfen und wird über ein UIScale am Wurzel-Frame auf jede
	Bildschirmgröße (PC, Tablet, Smartphone) skaliert.
]]

local rgb = Color3.fromRGB

local Theme = {}

Theme.ReferenceSize = Vector2.new(1280, 720)

Theme.Colors = {
	Background = rgb(10, 12, 22),
	Panel = rgb(20, 24, 42),
	PanelLight = rgb(32, 38, 64),
	PanelDark = rgb(14, 17, 30),
	Stroke = rgb(62, 72, 115),
	Accent = rgb(0, 214, 255),
	Accent2 = rgb(255, 64, 129),
	Success = rgb(60, 220, 120),
	Warning = rgb(255, 196, 0),
	Danger = rgb(255, 70, 90),
	Text = rgb(240, 244, 255),
	TextDim = rgb(150, 160, 195),
	Gold = rgb(255, 200, 60),
	XP = rgb(130, 100, 255),
	Black = rgb(0, 0, 0),
	White = rgb(255, 255, 255),
}

Theme.Fonts = {
	Title = Enum.Font.GothamBlack,
	Bold = Enum.Font.GothamBold,
	Medium = Enum.Font.GothamMedium,
	Body = Enum.Font.Gotham,
}

Theme.Corner = 12
Theme.SmallCorner = 8
Theme.Padding = 12

Theme.TextSize = {
	Huge = 64,
	Title = 30,
	Large = 22,
	Body = 18,
	Small = 15,
	Tiny = 13,
}

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">UIController</string>
              <string name="Source"><![CDATA[--[[
	UIController  (ModuleScript)
	Pfad: StarterPlayer/StarterPlayerScripts/Client/UI/UIController

	Erstellt die komplette Benutzeroberfläche per Script (keine manuell
	angelegten GUI-Instanzen nötig) und verwaltet Screens und Modale.

	Struktur (zur Laufzeit in PlayerGui):
		VelocityRushUI (ScreenGui)
		└── Root (Frame, UIScale auf Referenz 1280×720)
		    ├── TopBar          Level, XP, Coins, Rang
		    ├── LobbyMenu       Hauptmenü / Lobby / Warteschlange / Training-Leiste
		    ├── RaceHud         Countdown, Timer, Platzierungen, Gefahr, Items, Cooldowns
		    ├── TouchControls   Mobile Buttons
		    ├── Notifications   Hinweise
		    └── Modale: Results, Shop/Inventar (Catalog), Stats, Leaderboard,
		                Settings, Practice

	API:
		:RegisterModal(name, modal)
		:OpenModal(name) / :CloseModals() / :AnyModalOpen()
		:Notify(text, kind)
		.Root, .Gui, .Ctx, .Screens
]]

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")

local Components = require(script.Parent.Components)
local Theme = require(script.Parent.Theme)

local player = Players.LocalPlayer

local UIController = {}

local SCREEN_ORDER = {
	"Notifications",
	"TopBar",
	"LobbyMenu",
	"RaceHud",
	"TouchControls",
	"Results",
	"Catalog",
	"Stats",
	"Leaderboard",
	"Settings",
	"Practice",
}

function UIController:Init(ctx)
	self.Ctx = ctx
	self.Modals = {}
	self.Screens = {}

	local playerGui = player:WaitForChild("PlayerGui")
	self.Gui = Components.new("ScreenGui", {
		Name = "VelocityRushUI",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 5,
		Parent = playerGui,
	})
	self.Root = Components.new("Frame", {
		Name = "Root",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = self.Gui,
	})
	self.Scale = Components.new("UIScale", { Parent = self.Root })
	self:_rescale()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
		self:_rescale()
	end)

	Components.ClickCallback = function()
		local audio = ctx.AudioController
		if audio then
			audio:Play("Click")
		end
	end

	local screensFolder = script.Parent:WaitForChild("Screens")
	for _, name in SCREEN_ORDER do
		local module = require(screensFolder:WaitForChild(name))
		self.Screens[name] = module.new(self)
	end
end

function UIController:Start()
	for _, name in SCREEN_ORDER do
		local screen = self.Screens[name]
		if screen.Start then
			local ok, err = pcall(screen.Start, screen)
			if not ok then
				warn("[UIController] " .. name .. ":Start fehlgeschlagen: " .. tostring(err))
			end
		end
	end

	self.Ctx.InputController.ActionPressed:Connect(function(action)
		if action == "Menu" then
			if self:AnyModalOpen() then
				self:CloseModals()
			else
				self.Screens.LobbyMenu:ToggleCollapsed()
			end
		end
	end)

	-- Standard-Rucksack ausblenden und Reset-Button auf unseren Respawn umleiten
	task.spawn(function()
		local resetEvent = Instance.new("BindableEvent")
		resetEvent.Event:Connect(function()
			local Remotes = require(game:GetService("ReplicatedStorage").Shared.Remotes)
			Remotes.RequestRespawn:FireServer()
		end)
		for _ = 1, 20 do
			local ok = pcall(function()
				StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
				StarterGui:SetCore("ResetButtonCallback", resetEvent)
			end)
			if ok then
				break
			end
			task.wait(0.5)
		end
	end)
end

function UIController:_rescale()
	local viewport = workspace.CurrentCamera.ViewportSize
	local reference = Theme.ReferenceSize
	local scale = math.clamp(math.min(viewport.X / reference.X, viewport.Y / reference.Y), 0.45, 1.6)
	self.ScaleValue = scale
	self.Scale.Scale = scale
	self.Root.Size = UDim2.fromScale(1 / scale, 1 / scale)
end

--- Umrechnung Bildschirmpixel -> logische UI-Koordinaten.
function UIController:ToLogical(pixels: Vector2): Vector2
	return pixels / (self.ScaleValue or 1)
end

function UIController:RegisterModal(name: string, modal)
	self.Modals[name] = modal
end

function UIController:OpenModal(name: string)
	for otherName, modal in self.Modals do
		if otherName ~= name then
			modal.Close()
		end
	end
	local modal = self.Modals[name]
	if modal then
		modal.Open()
	end
end

function UIController:CloseModals()
	for _, modal in self.Modals do
		modal.Close()
	end
end

function UIController:AnyModalOpen(): boolean
	for _, modal in self.Modals do
		if modal.IsOpen() then
			return true
		end
	end
	return false
end

function UIController:Notify(text: string, kind: string?)
	local notifications = self.Screens.Notifications
	if notifications then
		notifications:Push(text, kind)
	end
end

return UIController
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
