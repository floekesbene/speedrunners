			Description = "Leise rieselnder Schnee.",
			Color = rgb(245, 252, 255), Color2 = rgb(170, 220, 255),
			Rate = 12, Size = 0.32, Speed = 1, Lifetime = 1.4, LightEmission = 0.4, Rise = -2.5, Spin = 60,
		},
		{
			Id = "Electric", Name = "Electric", Rarity = "Epic", Price = 1800,
			Description = "Knisternde Energie.",
			Color = rgb(255, 255, 255), Color2 = rgb(90, 190, 255),
			Rate = 24, Size = 0.26, Speed = 7, Lifetime = 0.35, LightEmission = 1, Drag = 6,
		},
		{
			Id = "Stardust", Name = "Stardust", Rarity = "Legendary", Price = 3500,
			Description = "Kosmischer Sternenstaub.",
			Color = rgb(200, 140, 255),
			Rate = 16, Size = 0.45, Speed = 1.8, Lifetime = 1.3, LightEmission = 1, Rainbow = true, Spin = 90, Twinkle = true,
		},
	},
	Emotes = {
		{ Id = "Wave", Name = "Winken", Rarity = "Common", Price = 0, Default = true, Description = "Ein freundliches Hallo.", Duration = 2.5 },
		{ Id = "Dance", Name = "Tanz", Rarity = "Rare", Price = 400, Description = "Zeig deine Moves.", Duration = 4 },
		{ Id = "Flex", Name = "Flex", Rarity = "Common", Price = 500, Description = "Muskeln zeigen.", Duration = 2.5 },
		{ Id = "Spin", Name = "Pirouette", Rarity = "Epic", Price = 600, Description = "Eine schnelle Drehung.", Duration = 2 },
		{ Id = "Salute", Name = "Salut", Rarity = "Common", Price = 400, Description = "Respekt an die Konkurrenz.", Duration = 2.5 },
	},
	Victory = {
		{ Id = "Confetti", Name = "Konfetti", Rarity = "Common", Price = 600, Description = "Bunter Konfettiregen beim Sieg.", Effect = "Confetti" },
		{ Id = "Fireworks", Name = "Feuerwerk", Rarity = "Rare", Price = 1200, Description = "Raketen am Himmel.", Effect = "Fireworks" },
		{ Id = "Lightning", Name = "Blitzschlag", Rarity = "Epic", Price = 2000, Description = "Ein Blitz trifft den Champion.", Effect = "Lightning" },
		{ Id = "GoldenRain", Name = "Goldregen", Rarity = "Legendary", Price = 3500, Description = "Es regnet Gold.", Effect = "GoldenRain" },
	},
	Colors = {
		{ Id = "Crimson", Name = "Crimson", Rarity = "Common", Price = 200, Description = "Ersetzt die Akzentfarbe durch Rot.", Color = rgb(255, 50, 70) },
		{ Id = "Azure", Name = "Azure", Rarity = "Common", Price = 200, Description = "Ersetzt die Akzentfarbe durch Blau.", Color = rgb(50, 140, 255) },
		{ Id = "Lime", Name = "Lime", Rarity = "Common", Price = 200, Description = "Ersetzt die Akzentfarbe durch Grün.", Color = rgb(130, 255, 60) },
		{ Id = "Violet", Name = "Violet", Rarity = "Rare", Price = 350, Description = "Ersetzt die Akzentfarbe durch Violett.", Color = rgb(170, 80, 255) },
		{ Id = "Sunset", Name = "Sunset", Rarity = "Rare", Price = 350, Description = "Ersetzt die Akzentfarbe durch Orange.", Color = rgb(255, 140, 40) },
		{ Id = "Mint", Name = "Mint", Rarity = "Rare", Price = 350, Description = "Ersetzt die Akzentfarbe durch Mint.", Color = rgb(80, 255, 200) },
	},
}

-- Schneller Zugriff: Lookup[category][id] = item
CosmeticDefinitions.Lookup = {}
for category, list in CosmeticDefinitions.Items do
	local map = {}
	for index, item in list do
		item.Category = category
		item.Index = index
		map[item.Id] = item
	end
	CosmeticDefinitions.Lookup[category] = map
end

--- Liefert die Definition eines Items oder nil.
function CosmeticDefinitions.Get(category: string, id: string)
	local map = CosmeticDefinitions.Lookup[category]
	return map and map[id] or nil
end

--- True, wenn eine Kategorie existiert.
function CosmeticDefinitions.IsCategory(category: any): boolean
	return type(category) == "string" and CosmeticDefinitions.Lookup[category] ~= nil
end

--- Kategorien, in denen man nichts ausrüsten "muss" (Ablegen erlaubt).
CosmeticDefinitions.Unequippable = {
	Skins = false,
	Trails = true,
	Effects = true,
	Emotes = false,
	Victory = true,
	Colors = true,
}

CosmeticDefinitions.DefaultEquipped = {
	Skins = "Rookie",
	Trails = "",
	Effects = "",
	Emotes = "Wave",
	Victory = "",
	Colors = "",
}

return CosmeticDefinitions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">ItemDefinitions</string>
          <string name="Source"><![CDATA[--[[
	ItemDefinitions  (ModuleScript)
	Pfad: ReplicatedStorage/Shared/ItemDefinitions

	Zentrale Definition aller Power-ups. Der Server (PowerUpService) nutzt die
	Werte für Effekte und Validierung, der Client für Anzeige und Effekte.

	Spawnregeln:
		Power-ups liegen in Item-Boxen an festen Spawnpunkten jeder Map.
		Eine Box respawnt nach Config.PowerUps.RespawnTime Sekunden.
		Jeder Spieler kann genau ein Item halten. Die Auswahl ist gewichtet nach
		Rennposition (Führende bekommen seltener starke Items -> Aufholmechanik).
	Verbrauch:
		Jedes Item wird bei Benutzung sofort verbraucht (Schutz vor Doppelnutzung).
		Ausnahme: Teleport Beacon ohne gültiges Ziel wird nicht verbraucht.
]]

local ItemDefinitions = {}

ItemDefinitions.Items = {
	SpeedBoost = {
		Id = "SpeedBoost",
		Name = "Speed Boost",
		Short = "BOOST",
		Description = "Kurzer Schub: höhere Maximalgeschwindigkeit für 3 Sekunden.",
		Color = Color3.fromRGB(255, 170, 0),
		Duration = 3,
		Offensive = false,
		Weights = { Leader = 30, Front = 25, Back = 22 },
	},
	Shield = {
		Id = "Shield",
		Name = "Shield",
		Short = "SCHILD",
		Description = "Blockt den nächsten gegnerischen Effekt (Freeze, Falle) für 6 Sekunden.",
		Color = Color3.fromRGB(80, 200, 255),
		Duration = 6,
		Offensive = false,
		Weights = { Leader = 30, Front = 20, Back = 12 },
	},
	FreezeBurst = {
		Id = "FreezeBurst",
		Name = "Freeze Burst",
		Short = "FREEZE",
		Description = "Verlangsamt alle Gegner im Umkreis von 45 Studs für 1,8 Sekunden.",
		Color = Color3.fromRGB(150, 230, 255),
		Radius = 45,
		Duration = 1.8,
		Offensive = true,
		Weights = { Leader = 8, Front = 18, Back = 22 },
	},
	GrappleUpgrade = {
		Id = "GrappleUpgrade",
		Name = "Grapple Upgrade",
		Short = "HAKEN+",
		Description = "8 Sekunden lang: größere Reichweite, schnelleres Einholen, kein Cooldown.",
		Color = Color3.fromRGB(190, 110, 255),
		Duration = 8,
		Offensive = false,
		Weights = { Leader = 18, Front = 20, Back = 18 },
	},
	TeleportBeacon = {
		Id = "TeleportBeacon",
		Name = "Teleport Beacon",
		Short = "TELEPORT",
		Description = "Teleportiert dich zum nächsten sicheren Punkt bis zu 48 Studs voraus.",
		Color = Color3.fromRGB(60, 255, 170),
		Range = 48,
		MinDistance = 10,
		Offensive = false,
		Weights = { Leader = 2, Front = 10, Back = 18 },
	},
	Trap = {
		Id = "Trap",
		Name = "Trap",
		Short = "FALLE",
		Description = "Platziert eine sichtbare Falle (15 s). Gegner werden 1,2 s betäubt.",
		Color = Color3.fromRGB(255, 70, 70),
		Lifetime = 15,
		StunDuration = 1.2,
		TriggerRadius = 3.4,
		Offensive = true,
		Weights = { Leader = 12, Front = 7, Back = 8 },
	},
}

ItemDefinitions.Order = { "SpeedBoost", "Shield", "FreezeBurst", "GrappleUpgrade", "TeleportBeacon", "Trap" }

function ItemDefinitions.Get(id: string)
	return ItemDefinitions.Items[id]
end

--- Liefert die Gewichtungsliste für eine Positionskategorie ("Leader"|"Front"|"Back").
function ItemDefinitions.GetWeightedList(bucket: string)
	local list = {}
	for _, id in ItemDefinitions.Order do
		local item = ItemDefinitions.Items[id]
		table.insert(list, { Value = id, Weight = item.Weights[bucket] or 10 })
	end
	return list
end

return ItemDefinitions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">MapDefinitions</string>
          <string name="Source"><![CDATA[--[[
	MapDefinitions  (ModuleScript)
	Pfad: ReplicatedStorage/Shared/MapDefinitions

	Metadaten und visuelle Themes aller Maps. Die eigentliche Geometrie wird
	serverseitig von ServerStorage/MapTemplates/<Template> über den MapBuilder
	erzeugt. Der Client nutzt diese Daten für UI (Name, Beschreibung) und
	Beleuchtung.

	Neue Map hinzufügen:
		1. ServerStorage/MapTemplates/_Template kopieren und umbenennen.
		2. Hier einen Eintrag mit Id, Template-Name und Theme anlegen.
		3. Die Id in MapDefinitions.Order eintragen.

	Theme-Felder (alle Farben Color3, Materialien Enum.Material):
		Strecke (kollidierbare Teile – nur Farbe/Material):
			Ground, GroundMaterial      Unterbau der Plattformen
			Top, TopMaterial            Lauffläche (oberste 1 Stud)
			Wall, WallMaterial          Wände, Tunneldecken, Startwand/Endwand
		Zierteile (MapBuilder, nur Dekoration):
			Trim, TrimMaterial          Vorderkanten-Lippe und Eckleisten
			Detail, DetailMaterial      Rippen, Bänder, Paneele an der Vorderseite
			Support, SupportMaterial    Stützen unter den Plattformen
			RibStyle                    "Panel" | "Joint" | "Root" | "Pipe" | "Strata"
			SupportStyle                "Girder" | "Pillar" | "Hanging" | "Ice" | "Stilt"
			Props, PropSpacing          automatisch verteilte Requisiten (MapBuilder:Prop-Arten)
			Leaf                        Grundfarbe für Laub (Büsche, Bäume)
			Backdrop                    { Near, Mid, Far, Lights = { … } } Farben der Hintergrund-Ebenen
			Terrain                     { Ground, Cliff, Top, Liquid, Peak } Terrain-Materialien des Hintergrunds
		Spiel-Optik:
			Accent, Accent2, Hazard, Anchor, EdgeGlow
			HazardKind                  Art der zeitgesteuerten Gefahren
			PitKind                     Art der Gefahren in Gruben
			Decor                       Hintergrund-Stil ("City", "Industrial", "Sky", "Glacier",
			                            "Jungle", "Hub", "Academy")
		Lighting (vom Client angewendet; optionale Felder haben dort Standardwerte):
			ClockTime, Brightness, Ambient, OutdoorAmbient, FogColor, FogStart, FogEnd,
			AtmosphereDensity, AtmosphereColor, AtmosphereDecay, Haze, Glare,
			Tint, Saturation, Contrast, BloomIntensity, BloomSize, BloomThreshold,
			ExposureCompensation, EnvironmentDiffuseScale (0–1), EnvironmentSpecularScale (0–1),
			ShadowSoftness (0–1), SunRaysIntensity (0–1), SunRaysSpread (0–1),
			DofFarIntensity (0–1), DofInFocusRadius (Studs), StarCount, CelestialBodiesShown,
			SunAngularSize
]]

