{
  "name": "VelocityRush",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/ReplicatedStorage/Shared"
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/ServerScriptService/Server"
      }
    },

    "ServerStorage": {
      "$className": "ServerStorage",
      "MapTemplates": {
        "$path": "src/ServerStorage/MapTemplates"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "LoadCharacterAppearance": false,
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/Client"
        }
      },
      "StarterCharacterScripts": {
        "$className": "StarterCharacterScripts",
        "Animate": {
          "$path": "src/StarterPlayer/StarterCharacterScripts/Animate.client.luau"
        }
      }
    },

    "StarterGui": {
      "$className": "StarterGui",
      "$properties": {
        "ResetPlayerGuiOnSpawn": false
      }
    },

    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": false
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "Gravity": 200,
        "StreamingEnabled": false
      }
    },

    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "ClockTime": 20.5,
        "Brightness": 1.4,
        "GlobalShadows": true
      }
    },

    "SoundService": {
      "$className": "SoundService"
    }
  }
}
